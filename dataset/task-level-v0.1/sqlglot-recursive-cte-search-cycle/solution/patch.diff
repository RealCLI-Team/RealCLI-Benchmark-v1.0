+    def test_recursive_cte_ast(self):
+        expression = self.parse_one(
+            'WITH RECURSIVE sg(id, link) AS (SELECT g.id, g.link FROM graph g UNION ALL SELECT g.id, g.link FROM graph g JOIN sg ON g.id = sg.link)\nSEARCH DEPTH FIRST BY id DESC, link ASC SET ordercol CYCLE id, link SET is_cycle TO 1 DEFAULT 0 USING path SELECT * FROM sg'
+        )
+        with_ = expression.args["with_"]
+        self.assertTrue(with_.recursive)
+
+        search = with_.args["search"]
+        self.assertIsInstance(search, exp.RecursiveWithSearch)
+        self.assertEqual(search.args["kind"], "DEPTH")
+        self.assertEqual(len(search.expressions), 2)
+        first, second = search.expressions
+        self.assertIsInstance(first, exp.Ordered)
+        self.assertTrue(first.args["desc"])
+        self.assertEqual(first.this.name, "id")
+        self.assertIsInstance(second, exp.Ordered)
+        self.assertEqual(second.args["desc"], False)
+        self.assertEqual(second.this.name, "link")
+        self.assertEqual(search.expression.name, "ordercol")
+
+        cycle = with_.args["cycle"]
+        self.assertIsInstance(cycle, exp.RecursiveWithCycle)
+        self.assertEqual([c.name for c in cycle.expressions], ["id", "link"])
+        self.assertEqual(cycle.expression.name, "is_cycle")
+        self.assertEqual(cycle.args["to"].this, "1")
+        self.assertEqual(cycle.args["default"].this, "0")
+        self.assertEqual(cycle.args["using"].name, "path")
+
+        # 复制与相等性
+        self.assertEqual(expression, expression.copy())
+        self.assertEqual(expression.copy().sql("postgres"), expression.sql("postgres"))
+
+        # serde 往返
+        from sqlglot.serde import dump, load
+        self.assertEqual(load(dump(expression)), expression)
+
