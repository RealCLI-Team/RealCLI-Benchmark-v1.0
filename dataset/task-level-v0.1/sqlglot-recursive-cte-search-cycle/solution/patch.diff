+    def test_recursive_cte_ast(self):
+        expression = self.parse_one(
+            'WITH sg(id, link) AS (SELECT g.id, g.link FROM graph g UNION ALL SELECT g.id, g.link FROM graph g JOIN sg ON g.id = sg.link)\nSEARCH BREADTH FIRST BY id, link DESC SET seq CYCLE id SET is_cycle TO 1 DEFAULT 0 SELECT * FROM sg'
+        )
+        with_ = expression.args["with_"]
+        search = with_.args["search"]
+        self.assertIsInstance(search, exp.RecursiveWithSearch)
+        self.assertEqual(search.args["kind"], "BREADTH")
+        self.assertEqual(len(search.expressions), 2)
+        self.assertEqual(search.expression.name, "seq")
+        cycle = with_.args["cycle"]
+        self.assertIsInstance(cycle, exp.RecursiveWithCycle)
