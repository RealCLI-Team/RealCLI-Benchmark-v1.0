+def test_ModuleElement_mod():
+    T = Poly(cyclotomic_poly(5, x))
+    A = PowerBasis(T)
+    e = A(to_col([1, 15, 8, 0]), denom=2)
+    assert e % 7 == A(to_col([1, 1, 8, 0]), denom=2)
+    raises(TypeError, lambda: e % QQ(1, 2))
