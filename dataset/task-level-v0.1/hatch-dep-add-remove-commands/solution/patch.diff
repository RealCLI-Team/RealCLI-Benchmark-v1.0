+
+
+def match_dependency_indices(app: Any, array: Any, canonical: str) -> list[int]:
+    """Return the indices of ``array`` entries with the given canonical name.
+
+    ``app`` is threaded through so that a malformed entry can be
+    reported via ``app.abort`` rather than raising a bare exception
+    from the middle of a CLI invocation. ``canonical`` must already be
+    the PEP 503 canonical form – callers are expected to have run the
+    argument through :func:`canonical_requirement_name` or the
+    ``normalize_project_name`` helper.
+    """
+    from hatch.dep.core import Dependency, InvalidDependencyError
+
+    indices: list[int] = []
+    for index, raw in iter_string_entries(array):
+        try:
+            requirement = Dependency(raw)
+        except InvalidDependencyError as e:
+            app.abort(f"Invalid requirement `{raw}`: {e}")
+
+        if canonical_requirement_name(requirement) == canonical:
+            indices.append(index)
+
+    return indices
