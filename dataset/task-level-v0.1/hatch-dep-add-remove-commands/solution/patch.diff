+    document = load_document(project_file)
+
+    targets = resolve_remove_targets(
+        app,
+        document,
+        features=features,
+        groups=groups,
+        env_name=env_name,
+        extra=extra,
+    )
+    scoped = bool(features or groups or env_name is not None)
+    removals = plan_removals(app, targets, names, scoped=scoped)
+
+    if dry_run:
+        app.display(diff_document(old_text, document), markup=False, highlight=False)
+        return
+
+    save_document(project_file, document)
+    for name, field in removals:
+        app.display_success(f"Removed `{name}` from field `{field}`")
