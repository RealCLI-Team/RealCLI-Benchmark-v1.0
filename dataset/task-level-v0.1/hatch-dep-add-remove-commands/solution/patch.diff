+def write_project(path, body):
+    path.mkdir(parents=True, exist_ok=True)
+    (path / "pyproject.toml").write_text(body, encoding="utf-8")
+
+
+def read_project(path):
+    return (path / "pyproject.toml").read_text(encoding="utf-8")
+
