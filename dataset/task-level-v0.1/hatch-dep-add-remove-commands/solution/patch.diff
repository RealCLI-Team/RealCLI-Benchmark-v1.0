index 0000000..3f9e3e9
--- /dev/null
+++ b/src/hatch/dep/edit.py
@@ -0,0 +1,723 @@
+"""In-place editors for the dependency-carrying arrays of ``pyproject.toml``.
+
+The two public entry points are :func:`add_dependencies` and
+:func:`remove_dependencies`, which back the ``hatch dep add`` and
+``hatch dep remove`` CLI commands respectively.
+
+The module has a hard atomicity guarantee: every user-facing failure must
+raise before any bytes are written to disk, so a partially-applied edit is
+never observable. To honour that guarantee both commands share the same
+skeleton:
+
+1. Load ``pyproject.toml`` into a :mod:`tomlkit` document (round-trip
+   friendly parser).
+2. Resolve every editing *target* – i.e. every array of dependency strings
+   that this invocation will touch. If a target cannot be resolved (feature
+   is missing, environment is not declared, field is ``dynamic``) the
+   command aborts immediately.
+3. Validate every requested change against every target *before* touching
+   the document. For ``dep add`` that means parsing each requirement and
+   checking for name conflicts. For ``dep remove`` that means confirming
+   every requested name matches at least one entry across the selected
+   scope.
+4. Apply the edits to the in-memory document.
+5. Either save the document atomically or, in ``--dry-run`` mode, print a
+   unified diff against the original bytes.
+
+The module deliberately stays free of ``click`` imports: control flow is
+routed through :class:`hatch.cli.application.Application` (``app.abort``,
+``app.display_success``, ``app.display``) so that error messages, exit
+codes and output channels match the rest of the CLI.
+"""
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, NamedTuple
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+    import tomlkit
+    from tomlkit.items import Array
+
+    from hatch.cli.application import Application
+    from hatch.project.core import Project
+    from hatch.utils.fs import Path
+
+
+# ---------------------------------------------------------------------------
+# Data structures
+# ---------------------------------------------------------------------------
+
+
+class EditTarget(NamedTuple):
+    """A single dependency array in ``pyproject.toml`` that the command edits.
+
+    Attributes:
+        field: Dotted path of the field, used in success and error messages
+            (e.g. ``project.dependencies``,
+            ``project.optional-dependencies.docs``,
+            ``dependency-groups.lint`` or
+            ``tool.hatch.envs.default.dependencies``).
+        array: The underlying :class:`tomlkit.items.Array` instance whose
+            entries the command manipulates.
+    """
+
+    field: str
+    array: "Array"
+
+
+# ---------------------------------------------------------------------------
+# I/O helpers
+# ---------------------------------------------------------------------------
+
+
+def get_project_file(project: Project) -> Path:
+    """Return the path of the ``pyproject.toml`` file of ``project``.
+
+    The routine mirrors the guard used by ``hatch version`` and other
+    project-scoped commands: if no project could be located we abort with
+    the same ``No project detected`` message the rest of the CLI uses, so
+    the two commands do not invent a private failure vocabulary.
+    """
+    if project.root is None:
+        if project.chosen_name is None:
+            project.app.abort("No project detected")
+        else:
+            project.app.abort(f"Project {project.chosen_name} (not a project)")
+
+    return project.location / "pyproject.toml"
+
+
+def load_document(project_file: Path) -> tomlkit.TOMLDocument:
+    """Parse ``pyproject.toml`` while preserving formatting and comments."""
+    import tomlkit
+
+    return tomlkit.parse(project_file.read_text("utf-8"))
+
+
+def save_document(project_file: Path, document: tomlkit.TOMLDocument) -> None:
+    """Serialize ``document`` back to ``project_file`` atomically.
+
+    The atomic write reuses :meth:`hatch.utils.fs.Path.write_atomic`, which
+    goes through ``tempfile.mkstemp`` + ``os.replace`` so that a crash
+    between the last valid state and the next one is impossible – either
+    the previous ``pyproject.toml`` bytes are observed or the new bytes
+    are.
+    """
+    import tomlkit
+
+    text = tomlkit.dumps(document)
+    # tomlkit sometimes strips the trailing newline. Every file we've ever
+    # written ends with ``\n`` so keep the invariant.
+    if not text.endswith("\n"):
+        text += "\n"
+
+    project_file.write_atomic(text, "w", encoding="utf-8")
+
+
+def diff_document(old_text: str, document: tomlkit.TOMLDocument) -> str:
+    """Return a unified diff between the on-disk bytes and ``document``.
+
+    The diff uses ``a/pyproject.toml`` and ``b/pyproject.toml`` as the file
+    labels so that its output can be piped straight into ``patch -p1`` or
+    ``git apply``.
+    """
+    from difflib import unified_diff
+
+    import tomlkit
+
+    new_text = tomlkit.dumps(document)
+    if not new_text.endswith("\n"):
+        new_text += "\n"
+
+    return "".join(
+        unified_diff(
+            old_text.splitlines(keepends=True),
+            new_text.splitlines(keepends=True),
+            fromfile="a/pyproject.toml",
+            tofile="b/pyproject.toml",
+        )
+    )
+
+
+# ---------------------------------------------------------------------------
+# Name normalization helpers
+# ---------------------------------------------------------------------------
+
+
+def canonical_name(requirement: Any) -> str:
+    """Return the PEP 503 canonical form of ``requirement.name``.
+
+    Two requirements refer to the same distribution iff their canonical
+    names are equal. This is *independent* of extras, version specifiers,
+    markers and URLs – the same rule PyPI uses for URL routing.
+    """
+    from hatchling.metadata.utils import normalize_project_name
+
+    return normalize_project_name(requirement.name)
+
+
+def parse_requirement(app: Application, raw: str) -> Any:
+    """Parse a PEP 508 requirement, aborting on failure with a consistent message."""
+    from hatch.dep.core import Dependency, InvalidDependencyError
+
+    try:
+        return Dependency(raw)
+    except InvalidDependencyError as e:
+        app.abort(f"Invalid requirement `{raw}`: {e}")
+
+
+def normalize_requirement_text(raw: str) -> str:
+    """Return the requirement string as it should be stored in ``pyproject.toml``.
+
+    Two normalizations happen:
+
+    * Leading/trailing whitespace is trimmed so ``"  requests>=2 "`` and
+      ``"requests>=2"`` compare equal.
+    * Marker double quotes are lowered to single quotes. PEP 508 markers
+      require quoted string operands and by convention example code uses
+      double quotes; but the TOML string that wraps the requirement is
+      itself delimited by double quotes, so keeping the inner double
+      quotes would force TOML escaping (``\\\"``) that most human readers
+      find ugly. Since PEP 508 accepts either quote character we swap
+      the inner ones to single quotes.
+    """
+    from hatch.utils.dep import normalize_marker_quoting
+
+    return normalize_marker_quoting(raw.strip())
+
+
+def validate_dependency_name(app: Application, raw: str) -> str:
+    """Validate and canonicalize a bare distribution name for ``dep remove``.
+
+    Anything other than a PEP 508 project name (no extras, no specifiers,
+    no markers, no URLs) is rejected. The message tells the user precisely
+    what form is expected, so a common mistake like
+    ``hatch dep remove "requests>=2"`` produces a helpful hint instead of
+    a cryptic parse error.
+    """
+    from hatchling.metadata.utils import is_valid_project_name, normalize_project_name
+
+    name = raw.strip()
+    if not name or not is_valid_project_name(name):
+        app.abort(
+            f"Invalid dependency name `{raw}`; pass a distribution name like `requests`, "
+            "not a requirement with extras, version specifiers, markers or URLs"
+        )
+
+    return normalize_project_name(name)
+
+
+def validate_feature_name(app: Application, raw: str) -> str:
+    from hatchling.metadata.utils import is_valid_project_name, normalize_project_name
+
+    name = raw.strip()
+    if not name or not is_valid_project_name(name):
+        app.abort(f"Invalid feature name: {raw}")
+
+    return normalize_project_name(name)
+
+
+def validate_group_name(app: Application, raw: str) -> str:
+    """Validate and canonicalize a PEP 735 dependency group name.
+
+    Per PEP 735 the name grammar is inherited from PEP 508 and the
+    normalization rule is PEP 503. That keeps ``dev`` and ``Dev`` from
+    silently referring to different groups.
+    """
+    from hatchling.metadata.utils import is_valid_project_name, normalize_project_name
+
+    name = raw.strip()
+    if not name or not is_valid_project_name(name):
+        app.abort(f"Invalid dependency group name: {raw}")
+
+    return normalize_project_name(name)
+
+
+# ---------------------------------------------------------------------------
+# Structural helpers
+# ---------------------------------------------------------------------------
+
+
+def _require_array(app: Application, value: Any, field: str) -> Array:
+    """Return ``value`` if it is a tomlkit Array or an empty one when absent.
+
+    Errors on anything else so misconfigured pyproject.toml files fail
+    loudly instead of getting silently coerced.
+    """
+    import tomlkit
+
+    if value is None:
+        return tomlkit.array()
+
+    if not isinstance(value, tomlkit.items.Array):
+        app.abort(f"Field `{field}` must be an array")
+
+    return value
+
+
+def _project_table(app: Application, document: tomlkit.TOMLDocument, field: str) -> Any:
+    """Return the ``[project]`` table or abort with a project-shaped error."""
+    project = document.get("project")
+    if project is None:
+        app.abort(f"Cannot edit `{field}` because the project does not define a `project` table")
+
+    return project
+
+
+def _check_not_dynamic(app: Application, project: Any, *fields: str) -> None:
+    """Refuse to edit fields declared dynamic in ``project.dynamic``.
+
+    PEP 621 defines dynamic fields as ones the build backend fills in at
+    build time; editing the static table would either be ignored (best
+    case) or contradict the resolved metadata (worst case). Either way we
+    refuse and tell the user why.
+    """
+    dynamic = project.get("dynamic", [])
+    for field in fields:
+        if field in dynamic:
+            app.abort(f"Field `project.{field}` is declared dynamic and cannot be edited")
+
+
+# ---------------------------------------------------------------------------
+# Target resolution
+# ---------------------------------------------------------------------------
+
+
+def resolve_env_target(
+    app: Application,
+    document: tomlkit.TOMLDocument,
+    *,
+    env_name: str,
+    extra: bool,
+    create: bool,
+) -> EditTarget:
+    """Resolve the ``dependencies`` (or ``extra-dependencies``) of an environment.
+
+    The ``default`` environment is created on demand because the Hatch
+    documentation treats it as always conceptually present – users often
+    interact with a project that has no ``[tool.hatch.envs.default]`` table
+    at all. Every other environment must be declared explicitly in the
+    file first; asking to write to ``--env qa`` on a project that has
+    never mentioned ``qa`` is a typo, and refusing early gives a much
+    better error than silently creating a phantom table.
+
+    ``create`` distinguishes the two commands: ``dep add`` may create the
+    default environment table, ``dep remove`` never does (the missing
+    array can't hold the name anyway).
+    """
+    import tomlkit
+
+    key = "extra-dependencies" if extra else "dependencies"
+    field = f"tool.hatch.envs.{env_name}.{key}"
+
+    tool = document.get("tool")
+    hatch_config = tool.get("hatch") if tool is not None else None
+    envs = hatch_config.get("envs") if hatch_config is not None else None
+    env_config = envs.get(env_name) if envs is not None else None
+
+    if env_config is None:
+        if env_name != "default":
+            app.abort(f"Environment `{env_name}` is not defined in `tool.hatch.envs`")
+
+        if not create:
+            app.abort(f"Field `{field}` is not defined")
+
+        if tool is None:
+            tool = document["tool"] = tomlkit.table()
+        if hatch_config is None:
+            hatch_config = tool["hatch"] = tomlkit.table()
+        if envs is None:
+            envs = hatch_config["envs"] = tomlkit.table()
+        env_config = envs[env_name] = tomlkit.table()
+
+    array = _require_array(app, env_config.get(key), field)
+    if key not in env_config:
+        env_config[key] = array
+
+    return EditTarget(field, array)
+
+
+def resolve_add_targets(
+    app: Application,
+    document: tomlkit.TOMLDocument,
+    *,
+    features: tuple[str, ...],
+    groups: tuple[str, ...],
+    env_name: str | None,
+    extra: bool,
+) -> list[EditTarget]:
+    """Resolve the set of arrays ``dep add`` will write to.
+
+    Every option combination has its own resolution path:
+
+    * ``--env`` (with optional ``--extra``) targets exactly one
+      environment array. ``--optional`` and ``--group`` are rejected in
