+def add_dependencies(
+    app: Application,
+    requirements: tuple[str, ...],
+    *,
+    features: tuple[str, ...],
+    groups: tuple[str, ...],
+    env_name: str | None,
+    extra: bool,
+    force: bool,
+    dry_run: bool,
