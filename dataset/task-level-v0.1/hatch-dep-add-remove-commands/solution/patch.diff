+"""TOML parsing helpers used across Hatch.
+
+Two parsers coexist because they serve different use cases:
+
+* :func:`load_toml_data` and :func:`load_toml_file` use the standard
+  library's ``tomllib`` (or the ``tomli`` backport on Python 3.10) to
+  parse into plain ``dict``. This is the fast path for read-only
+  consumers that only need to inspect the parsed data.
+* :func:`load_pyproject_document` and :func:`dump_pyproject_document`
+  go through :mod:`tomlkit`, whose parse tree preserves formatting,
+  comments and array layout. This is what the ``hatch dep add`` /
+  ``hatch dep remove`` commands use so that edits round-trip
+  losslessly.
+"""
 from __future__ import annotations
 
 import sys
-from typing import Any
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from hatch.utils.fs import Path
 
 if sys.version_info >= (3, 11):
     import tomllib
@@ -9,10 +26,73 @@ else:
     import tomli as tomllib
 
 
+# ---------------------------------------------------------------------------
+# Plain-dict parsers (fast, read-only)
+# ---------------------------------------------------------------------------
+
+
 def load_toml_data(data: str) -> dict[str, Any]:
+    """Parse ``data`` as TOML using the standard library backend.
+
+    The result is a plain ``dict``; comments and formatting are
+    discarded. Prefer this over the tomlkit-backed parsers when the
+    caller only needs to read a value out.
+    """
     return tomllib.loads(data)
 
 
 def load_toml_file(path: str) -> dict[str, Any]:
+    """Read ``path`` and parse its contents as TOML.
+
+    Same guarantees as :func:`load_toml_data`. The file is read with an
+    explicit UTF-8 encoding so that behaviour does not depend on the
+    system locale.
+    """
     with open(path, encoding="utf-8") as f:
         return tomllib.loads(f.read())
+
+
+# ---------------------------------------------------------------------------
+# Round-trip parsers (formatting-preserving)
+# ---------------------------------------------------------------------------
+
+
+def load_pyproject_document(path: Path):
+    """Parse ``path`` with :mod:`tomlkit`, preserving formatting.
+
+    Returns a :class:`tomlkit.TOMLDocument` instance that behaves like
+    an ordered ``dict`` but also remembers comment placement, string
+    quoting style and array layout (inline vs multiline).
+    """
+    import tomlkit
+
+    return tomlkit.parse(path.read_text("utf-8"))
+
+
+def dump_pyproject_document(document) -> str:
+    """Serialize a :class:`tomlkit.TOMLDocument` back to a TOML string.
+
+    A trailing newline is always appended so the resulting text obeys
+    the POSIX convention that text files end with ``\\n``. Every
+    reader we ship handles both variants but tools such as ``git diff``
+    render the missing-newline case with a distracting warning that we
+    would rather avoid.
+    """
+    import tomlkit
+
+    text = tomlkit.dumps(document)
+    if not text.endswith("\n"):
+        text += "\n"
+
+    return text
+
+
+def save_pyproject_document(document, path: Path) -> None:
+    """Write ``document`` to ``path`` atomically.
+
+    Uses :meth:`hatch.utils.fs.Path.write_atomic` (``mkstemp`` +
+    ``os.replace``) so that a crash between the last valid state and
+    the next one is impossible – the reader on the other side sees
+    either the previous bytes or the new ones.
+    """
+    path.write_atomic(dump_pyproject_document(document), "w", encoding="utf-8")
