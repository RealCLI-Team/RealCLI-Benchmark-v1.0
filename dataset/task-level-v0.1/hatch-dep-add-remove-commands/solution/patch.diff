+@click.option(
+    "--extra",
+    is_flag=True,
+    help="With --env, add to the environment's `extra-dependencies` instead of `dependencies`",
+)
+@click.option(
+    "--force",
+    "-f",
+    is_flag=True,
+    help="Replace an existing entry with the same distribution name instead of failing",
+)
+@click.option(
+    "--dry-run",
+    is_flag=True,
+    help="Show the change that would be applied to `pyproject.toml` without writing it",
+)
+@click.pass_obj
+def add(app, requirements, features, groups, env_name, extra, force, dry_run):
+    """Add dependencies to the project, a feature, a dependency group, or an environment.
+
+    Every edit preserves the existing formatting and comments of
+    `pyproject.toml`. If any of the requested changes cannot be applied,
+    the command exits with a non-zero status and does not touch the file.
+    """
+    from hatch.dep.edit import add_dependencies
+
+    add_dependencies(
+        app,
+        requirements,
+        features=features,
+        groups=groups,
+        env_name=env_name,
+        extra=extra,
+        force=force,
+        dry_run=dry_run,
+    )
+
+
+@dep.command(
+    "remove",
+    short_help="Remove dependencies from the project, a feature, a dependency group, or an environment",
+)
+@click.argument("names", nargs=-1, required=True)
+@click.option(
+    "--optional",
+    "-o",
+    "features",
+    multiple=True,
+    metavar="FEATURE",
+    help="Only remove from the given feature of `project.optional-dependencies` (may be used multiple times)",
+)
+@click.option(
+    "--group",
+    "-g",
+    "groups",
+    multiple=True,
+    metavar="GROUP",
+    help="Only remove from the given PEP 735 dependency group (may be used multiple times)",
+)
+@click.option(
+    "--env",
+    "env_name",
+    metavar="ENV",
+    help="Only remove from the dependencies of the named environment in `tool.hatch.envs`",
+)
+@click.option(
+    "--extra",
+    is_flag=True,
+    help="With --env, remove from the environment's `extra-dependencies` instead of `dependencies`",
+)
+@click.option(
+    "--dry-run",
+    is_flag=True,
+    help="Show the change that would be applied to `pyproject.toml` without writing it",
+)
+@click.pass_obj
+def remove(app, names, features, groups, env_name, extra, dry_run):
+    """Remove dependencies from the project, a feature, a dependency group, or an environment.
+
+    The argument is a bare distribution name, matched case-insensitively
+    after PEP 503 normalization. Requirement strings (with extras, version
+    specifiers, markers or URLs) are rejected.
+    """
+    from hatch.dep.edit import remove_dependencies
+
+    remove_dependencies(
+        app,
+        names,
+        features=features,
+        groups=groups,
+        env_name=env_name,
+        extra=extra,
+        dry_run=dry_run,
+    )
