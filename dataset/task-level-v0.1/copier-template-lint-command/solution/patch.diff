+# --------------------------------------------------------------------------- #
+# Static template validation (shared by the `copier lint` subcommand and the  #
+# runtime template loader below). Every rule emitted by the linter has an     #
+# exact counterpart in the runtime loader: whenever the runtime refuses a     #
+# template, the linter must surface the same condition with the rule code     #
+# named here. Keeping the two paths in the same module keeps the mapping      #
+# obvious.                                                                    #
+# --------------------------------------------------------------------------- #
+
+CONFIG_FILENAMES: tuple[str, ...] = ("copier.yml", "copier.yaml")
+"""Configuration file names accepted at the root of a template."""
+
+_JINJA_DELIMITER = re.compile(r"\{\{|\{%|\{#")
+"""Pattern that detects Jinja delimiters inside a string."""
+
+VCS_DIRECTORY_NAMES: frozenset[str] = frozenset({".git", ".hg", ".svn"})
+"""Directory names skipped when walking a template."""
+
+# Underscore-prefixed template settings and the shapes each may take.
+STR_SETTINGS: frozenset[str] = frozenset(
+    {
+        "answers_file",
+        "message_after_copy",
+        "message_after_update",
+        "message_before_copy",
+        "message_before_update",
+        "subdirectory",
+        "templates_suffix",
+    }
+)
+STR_LIST_SETTINGS: frozenset[str] = frozenset(
+    {"exclude", "jinja_extensions", "secret_questions", "skip_if_exists"}
+)
+MAPPING_SETTINGS: frozenset[str] = frozenset(
+    {"envops", "external_data", "metadata"}
+)
+BOOL_SETTINGS: frozenset[str] = frozenset({"preserve_symlinks"})
+KNOWN_TEMPLATE_SETTINGS: frozenset[str] = (
+    STR_SETTINGS
+    | STR_LIST_SETTINGS
+    | MAPPING_SETTINGS
+    | BOOL_SETTINGS
+    | frozenset({"migrations", "min_copier_version", "tasks"})
+)
+"""Every underscore setting Copier's loader recognises."""
+
+# Known keys of a question definition given in the complex/mapping form.
+KNOWN_QUESTION_KEYS: frozenset[str] = frozenset(
+    {
+        "choices",
+        "default",
+        "help",
+        "multiline",
+        "multiselect",
+        "placeholder",
+        "qmark",
+        "secret",
+        "type",
+        "validator",
+        "when",
+    }
+)
+
+# Known keys of the ``_envops`` mapping.
+KNOWN_ENVOPS_KEYS: frozenset[str] = frozenset(
+    {
+        "auto_reload",
+        "autoescape",
+        "block_end_string",
+        "block_start_string",
+        "cache_size",
+        "comment_end_string",
+        "comment_start_string",
+        "enable_async",
+        "finalize",
+        "keep_trailing_newline",
+        "line_comment_prefix",
+        "line_statement_prefix",
+        "lstrip_blocks",
+        "newline_sequence",
+        "optimized",
+        "trim_blocks",
+        "undefined",
+        "variable_end_string",
+        "variable_start_string",
+    }
+)
+ALLOWED_ENVOPS_UNDEFINED: frozenset[str] = frozenset(
+    {"jinja2.Undefined", "jinja2.StrictUndefined"}
+)
+
+
+LintSeverity = Literal["error", "warning"]
+
+
+@std_dataclass(frozen=True)
+class LintFinding:
+    """A single problem spotted by the static template validator.
+
+    Attributes:
+        severity: One of ``"error"`` or ``"warning"``.
+        code: Stable kebab-case identifier of the rule that produced this
+            finding, such as ``"invalid-question-type"``.
+        message: Human-readable description of the problem.
+        file: Path of the offending file, relative to the template root and
+            in POSIX style; ``None`` when the finding is not tied to a file.
+        line: 1-based line number inside ``file``, when known.
+    """
+
+    severity: LintSeverity
+    code: str
+    message: str
+    file: str | None = None
+    line: int | None = None
+
+    def sort_key(self) -> tuple[bool, str, int, str, str]:
+        """Deterministic ordering key: findings without a file come last."""
+        return (
+            self.file is None,
+            self.file or "",
+            self.line or 0,
+            self.code,
+            self.message,
+        )
+
+    def as_dict(self) -> dict[str, Any]:
+        """Return a JSON-serialisable representation of this finding."""
+        return {
+            "severity": self.severity,
+            "code": self.code,
+            "file": self.file,
+            "line": self.line,
+            "message": self.message,
+        }
+
+
+def is_templated_value(value: Any) -> bool:
+    """Return ``True`` when ``value`` is a string containing Jinja markers."""
+    return isinstance(value, str) and bool(_JINJA_DELIMITER.search(value))
+
+
+def is_str_list(value: Any) -> bool:
+    """Return ``True`` when ``value`` is a list of strings."""
+    return isinstance(value, list) and all(isinstance(item, str) for item in value)
+
+
+def is_command_like(value: Any) -> bool:
+    """Return ``True`` for values that look like a task command.
+
+    A command is either a plain string, or a list of strings when the caller
+    intends to feed it to ``subprocess`` without a shell.
+    """
+    return isinstance(value, str) or is_str_list(value)
+
+
+def literal_choice_values(choices: Any) -> list[Any] | None:
+    """Extract the raw values from a literal ``choices`` definition.
+
+    Returns ``None`` when the choices are templated or malformed, meaning no
+    static check can be performed on them.
+
+    Args:
+        choices: The raw ``choices`` value.
+
+    Returns:
+        A list of the values referenced by the choices, or ``None`` if the
+        definition is templated or malformed.
+    """
+    if is_templated_value(choices):
+        return None
+    if isinstance(choices, dict):
+        items: list[Any] = list(choices.items())
+    elif isinstance(choices, list):
+        items = list(choices)
+    else:
+        return None
+    values: list[Any] = []
+    for item in items:
+        if isinstance(item, (list, tuple)) and len(item) == 2:
+            _, value = item
+        else:
+            value = item
+        if isinstance(value, dict):
+            if "value" not in value:
+                return None
+            value = value["value"]
+        if is_templated_value(value):
+            return None
+        values.append(value)
+    return values
+
+
+def build_lint_jinja_env(
+    raw_config: Mapping[str, Any] | None,
+) -> SandboxedEnvironment:
+    """Return a Jinja environment configured like the one Copier uses.
+
+    The environment applies the template's ``_envops`` overrides and loads
+    Copier's built-in extensions plus any external ones from
+    ``_jinja_extensions`` that can be imported. Extensions that fail to
+    import are silently skipped — the linter emits a warning for those
+    through a separate rule.
+
+    Args:
+        raw_config: The parsed configuration mapping, or ``None`` when no
+            configuration data is available yet.
+
+    Returns:
+        A ready-to-use sandboxed Jinja environment.
+    """
+    envops: dict[str, Any] = {}
+    extensions: list[Any] = [
+        "jinja2_ansible_filters.AnsibleCoreFiltersExtension",
+        YieldExtension,
+    ]
+    if isinstance(raw_config, Mapping):
+        raw_envops = raw_config.get("_envops")
+        if isinstance(raw_envops, Mapping):
+            for key, value in raw_envops.items():
+                if key not in KNOWN_ENVOPS_KEYS:
+                    continue
+                if key == "undefined":
+                    if value in ALLOWED_ENVOPS_UNDEFINED:
+                        try:
+                            envops["undefined"] = import_string(value)
+                        except (ImportError, AttributeError, ValueError):
+                            continue
+                    continue
+                envops[key] = value
+        raw_extensions = raw_config.get("_jinja_extensions", [])
+        if is_str_list(raw_extensions):
+            for extension in raw_extensions:
+                if is_templated_value(extension):
+                    continue
+                try:
+                    extensions.append(import_string(extension))
+                except (ImportError, AttributeError, ValueError):
+                    continue
+    try:
+        return SandboxedEnvironment(extensions=extensions, **envops)
+    except Exception:  # noqa: BLE001
+        return SandboxedEnvironment(
+            extensions=[
+                "jinja2_ansible_filters.AnsibleCoreFiltersExtension",
+                YieldExtension,
+            ]
+        )
+
+
+def discover_config_files(template_root: Path) -> list[Path]:
+    """Return all Copier configuration files inside a template directory.
+
+    The listing is deterministic (sorted by file name) so that lint output
+    stays stable across filesystems.
+    """
+    return sorted(
+        (
+            path
+            for path in template_root.glob("copier.*")
+            if path.is_file() and re.match(r"\.ya?ml", path.suffix, re.IGNORECASE)
+        ),
+        key=lambda p: p.name,
+    )
+
+
+def _parse_yaml_documents_static(
+    conf_path: Path, conf_name: str
+) -> tuple[list[dict[str, Any]] | None, list[LintFinding]]:
+    """Parse a Copier YAML config into a list of documents for static use.
+
+    This is a linter-friendly counterpart to :func:`load_template_config`:
+    it collects error findings instead of raising, and never resolves any
+    ``!include`` tags because those cannot be inspected statically.
+
+    Args:
+        conf_path: The configuration file path.
+        conf_name: The file name to report on findings.
+
+    Returns:
+        A pair ``(documents, findings)``. ``documents`` is ``None`` when
+        parsing failed hard enough that no further checks are meaningful.
+    """
+    findings: list[LintFinding] = []
+    try:
+        documents = list(yaml.load_all(conf_path.read_bytes(), Loader=yaml.SafeLoader))
+    except yaml.constructor.ConstructorError:
+        # Constructor errors come from unknown tags (``!include``). Falling
+        # back to the Copier loader lets us surface any syntactic error but
+        # still tolerates includes we cannot inspect statically.
+        try:
+            merged = load_template_config(conf_path, quiet=True)
+        except InvalidConfigFileError as error:
+            cause = error.__cause__
+            line = None
+            problem = "cannot parse configuration file"
+            if isinstance(cause, yaml.MarkedYAMLError):
+                problem = cause.problem or str(cause)
+                if cause.problem_mark is not None:
+                    line = cause.problem_mark.line + 1
+            elif cause is not None:
+                problem = str(cause)
+            findings.append(
+                LintFinding(
+                    severity="error",
+                    code="config-invalid-yaml",
+                    message=f"invalid YAML: {problem}",
+                    file=conf_name,
+                    line=line,
+                )
+            )
+            return None, findings
+        except Exception as error:  # noqa: BLE001
+            findings.append(
+                LintFinding(
+                    severity="error",
+                    code="config-invalid-yaml",
+                    message=f"cannot load configuration: {error}",
+                    file=conf_name,
+                )
+            )
+            return None, findings
+        if not isinstance(merged, dict):
+            findings.append(
+                LintFinding(
+                    severity="error",
+                    code="config-not-mapping",
+                    message=(
+                        "configuration must be a mapping of questions and "
+                        "settings"
+                    ),
+                    file=conf_name,
+                )
+            )
+            return None, findings
+        return [merged], findings
+    except yaml.MarkedYAMLError as error:
+        line = None
+        problem = error.problem or str(error)
+        if error.problem_mark is not None:
+            line = error.problem_mark.line + 1
+        findings.append(
+            LintFinding(
+                severity="error",
+                code="config-invalid-yaml",
+                message=f"invalid YAML: {problem}",
+                file=conf_name,
+                line=line,
+            )
+        )
+        return None, findings
+    except yaml.YAMLError as error:
+        findings.append(
+            LintFinding(
+                severity="error",
+                code="config-invalid-yaml",
+                message=f"invalid YAML: {error}",
+                file=conf_name,
+            )
+        )
+        return None, findings
+    except OSError as error:
+        findings.append(
+            LintFinding(
+                severity="error",
+                code="config-invalid-yaml",
+                message=f"cannot read configuration: {error}",
+                file=conf_name,
+            )
+        )
+        return None, findings
+
+    kept: list[dict[str, Any]] = []
+    for document in documents:
+        if document is None:
+            continue
+        if not isinstance(document, dict):
+            findings.append(
+                LintFinding(
+                    severity="error",
+                    code="config-not-mapping",
+                    message=(
+                        "configuration must be a mapping of questions and "
+                        "settings"
+                    ),
+                    file=conf_name,
+                )
+            )
+            return None, findings
+        kept.append(document)
+    return kept, findings
+
+
+def merge_config_documents(documents: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    """Merge multiple YAML documents like Copier's runtime loader.
+
+    Later documents override earlier ones for scalar values; list settings
+    from the ``_exclude`` family are concatenated across every document.
+    """
+    merged: dict[str, Any] = {}
+    for document in documents:
+        merged.update(document)
+    for option in ("_exclude", "_jinja_extensions", "_secret_questions", "_skip_if_exists"):
+        collected: list[Any] = []
+        for document in documents:
+            value = document.get(option)
+            if isinstance(value, list):
+                collected.extend(value)
+        if collected:
+            merged[option] = collected
+    return merged
+
+
+class TemplateStaticValidator:
+    """Run the static validation rules on a template directory.
+
+    The validator has no state beyond the root path and its accumulated
+    findings, which lets callers reuse it for several templates or wrap it
+    into higher-level orchestration.
+
+    Attributes:
+        root: Absolute path to the template directory being inspected.
+        findings: Findings collected so far, in insertion order.
+    """
+
+    root: Path
+    findings: list[LintFinding]
+    _config: dict[str, Any] | None
+    _env: SandboxedEnvironment | None
+
+    def __init__(self, template_root: Path) -> None:
+        self.root = template_root.resolve()
+        self.findings = []
+        self._config = None
+        self._env = None
+
+    # -- reporting helpers --------------------------------------------------
+
+    def add(
+        self,
+        severity: LintSeverity,
+        code: str,
+        message: str,
+        file: str | None = None,
+        line: int | None = None,
+    ) -> None:
+        """Append a finding to the report."""
+        self.findings.append(LintFinding(severity, code, message, file, line))
+
+    def extend(self, findings: Iterable[LintFinding]) -> None:
+        """Append a batch of findings to the report."""
+        self.findings.extend(findings)
+
+    def config_name(self) -> str:
