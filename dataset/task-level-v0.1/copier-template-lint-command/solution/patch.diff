+    def _validate_settings(self, config_data: dict[str, Any]) -> None:
+        """Emit findings about ``_xxx``-prefixed settings."""
+        conf_name = self.config_name()
+        for key, value in config_data.items():
+            if key not in KNOWN_TEMPLATE_SETTINGS:
+                self.add(
+                    "warning",
+                    "unknown-setting",
+                    f"unknown setting `_{key}`",
+                    file=conf_name,
+                )
+                continue
+            self._validate_setting_value(key, value, conf_name)
+
+    def _validate_setting_value(self, key: str, value: Any, conf_name: str) -> None:
+        """Emit findings about a single ``_xxx`` setting's shape and value."""
+        if key in STR_SETTINGS:
+            if not isinstance(value, str):
+                self.add(
+                    "error",
+                    "invalid-setting",
+                    f"setting `_{key}` must be a string",
+                    file=conf_name,
+                )
+        elif key in STR_LIST_SETTINGS:
+            if not is_str_list(value):
+                self.add(
+                    "error",
+                    "invalid-setting",
+                    f"setting `_{key}` must be a list of strings",
+                    file=conf_name,
+                )
+        elif key in MAPPING_SETTINGS:
+            if not isinstance(value, dict):
+                self.add(
+                    "error",
+                    "invalid-setting",
+                    f"setting `_{key}` must be a mapping",
+                    file=conf_name,
+                )
+        elif key in BOOL_SETTINGS:
+            if not isinstance(value, bool):
+                self.add(
+                    "error",
+                    "invalid-setting",
+                    f"setting `_{key}` must be a boolean",
+                    file=conf_name,
+                )
