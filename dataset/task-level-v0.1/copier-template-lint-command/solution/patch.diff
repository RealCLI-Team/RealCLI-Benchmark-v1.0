+"""Tests for the `copier lint` subcommand and its static validation engine.
+
+The tests exercise both the low-level :func:`copier._lint.lint_template`
+helper and the ``copier lint`` command-line entry point. Templates are
+built on the fly with :func:`build_file_tree`, matching the convention
+followed elsewhere in the test suite.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from copier._cli import CopierApp
+from copier._lint import LintReport, lint_template
+from copier._template import (
+    ALLOWED_ENVOPS_UNDEFINED,
+    CONFIG_FILENAMES,
+    KNOWN_ENVOPS_KEYS,
+    KNOWN_QUESTION_KEYS,
+    KNOWN_TEMPLATE_SETTINGS,
+    LintFinding,
+    TemplateStaticValidator,
+    build_lint_jinja_env,
+    is_command_like,
+    is_str_list,
+    is_templated_value,
+    literal_choice_values,
+)
+from copier._user_data import validate_question_static
+
+from .helpers import build_file_tree
+
+ANSWERS_FILE_TEMPLATE = """\
+# Changes here will be overwritten by Copier
+{{ _copier_answers|to_nice_yaml }}
+"""
+
+
+def make_template(root: Path, config: str, files: dict[str, str] | None = None) -> Path:
+    """Create a minimal template with the given `copier.yml` contents."""
+    tree: dict[Path, str] = {root / "copier.yml": config}
+    for relpath, content in (files or {}).items():
+        tree[root / relpath] = content
+    build_file_tree(tree)
+    return root
+
+
+def make_valid_template(tmp_path: Path) -> Path:
+    """Create a template without any lint findings."""
+    return make_template(
+        tmp_path / "valid",
+        """\
+        project_name:
+            type: str
+            help: Your project name
+            default: my-project
+
+        version:
+            type: str
+            default: 1.0.0
+
+        license:
+            type: str
+            default: MIT
+            choices:
+                - MIT
+                - Apache-2.0
+
+        use_docker:
+            type: bool
+            default: false
+            when: "{{ license == 'MIT' }}"
+
+        _exclude:
+            - "*.egg-info"
+        """,
+        {
+            "{{ _copier_conf.answers_file }}.jinja": ANSWERS_FILE_TEMPLATE,
+            "README.md.jinja": "# {{ project_name }}\n\nVersion {{ version }}\n",
+            "{{ project_name }}/__init__.py.jinja": '"""{{ project_name }}."""\n',
+        },
+    )
+
+
+def run_lint_cli(*args: str) -> tuple[str, int]:
+    """Run ``copier lint`` in-process and return ``(output, exit_code)``.
+
+    Runs the CLI through :class:`plumbum.cli.Application.run` so the
+    behaviour matches the actual subprocess invocation while keeping the
+    call cheap in the test loop.
+    """
+    import io
+    from contextlib import redirect_stderr, redirect_stdout
+
+    out = io.StringIO()
+    err = io.StringIO()
+    with redirect_stdout(out), redirect_stderr(err):
+        _, status = CopierApp.run(["copier", "lint", *args], exit=False)
+    return out.getvalue() + err.getvalue(), status
+
+
+def codes_by_severity(report: LintReport, severity: str) -> list[str]:
+    """Return sorted finding codes of one severity from a lint report."""
+    return sorted(
+        finding.code
+        for finding in report.findings
+        if finding.severity == severity
+    )
+
+
+class TestCleanTemplate:
+    """A well-formed template produces no findings at all."""
+
+    def test_no_findings(self, tmp_path: Path) -> None:
+        template = make_valid_template(tmp_path)
+        report = lint_template(template)
+        assert report.errors == 0
+        assert report.warnings == 0
+        assert report.findings == []
+
+    def test_cli_exit_zero(self, tmp_path: Path) -> None:
+        template = make_valid_template(tmp_path)
+        output, status = run_lint_cli(str(template))
+        assert status == 0
+        assert "0 error(s) and 0 warning(s) found" in output
+
+    def test_cli_defaults_to_cwd(
+        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        template = make_valid_template(tmp_path)
+        monkeypatch.chdir(template)
+        _, status = run_lint_cli()
+        assert status == 0
+
+
+class TestUsageErrors:
+    """Wrong invocation exits with code 2 and never produces a report."""
+
+    def test_missing_path(self, tmp_path: Path) -> None:
+        output, status = run_lint_cli(str(tmp_path / "does-not-exist"))
+        assert status == 2
+        assert "does not exist" in output
+
+    def test_regular_file(self, tmp_path: Path) -> None:
+        file_path = tmp_path / "hello.txt"
+        file_path.write_text("hello", encoding="utf-8")
+        output, status = run_lint_cli(str(file_path))
+        assert status == 2
+        assert "template" in output.lower()
+
+    def test_gh_prefix(self) -> None:
+        _, status = run_lint_cli("gh:copier-org/example")
+        assert status == 2
+
+    def test_https_url(self) -> None:
+        _, status = run_lint_cli("https://github.com/copier-org/example.git")
+        assert status == 2
+
+    def test_ssh_url(self) -> None:
+        _, status = run_lint_cli("git@github.com:copier-org/example.git")
+        assert status == 2
+
+
+class TestConfigFileFindings:
+    """Findings about the configuration file itself."""
+
+    def test_config_not_found(self, tmp_path: Path) -> None:
+        (tmp_path / "empty").mkdir()
+        report = lint_template(tmp_path / "empty")
+        assert codes_by_severity(report, "error") == ["config-not-found"]
+
+    def test_multiple_configs(self, tmp_path: Path) -> None:
+        template = tmp_path / "multi"
+        build_file_tree(
+            {
+                template / "copier.yml": "foo: bar\n",
+                template / "copier.yaml": "foo: bar\n",
+            }
+        )
+        report = lint_template(template)
+        assert codes_by_severity(report, "error") == ["multiple-config-files"]
+
+    def test_invalid_yaml_line_number(self, tmp_path: Path) -> None:
+        template = make_template(tmp_path / "bad-yaml", "foo: bar\n  baz: [\n")
+        report = lint_template(template)
+        (finding,) = report.findings
+        assert finding.code == "config-invalid-yaml"
+        assert finding.file == "copier.yml"
+        assert finding.line == 2
+
+    def test_config_not_mapping(self, tmp_path: Path) -> None:
+        template = make_template(tmp_path / "list", "- one\n- two\n- three\n")
+        report = lint_template(template)
+        assert codes_by_severity(report, "error") == ["config-not-mapping"]
+
+    def test_config_include_tag_supported(self, tmp_path: Path) -> None:
+        template = tmp_path / "with-include"
+        build_file_tree(
+            {
+                template / "copier.yml": "!include included.yml\n",
+                template / "included.yml": "name:\n    type: str\n    default: x\n",
+                template / "{{ _copier_conf.answers_file }}.jinja": (
+                    ANSWERS_FILE_TEMPLATE
+                ),
+            }
+        )
+        report = lint_template(template)
+        assert report.errors == 0
+
+
+class TestQuestionRules:
+    """Rules applied to individual question definitions."""
+
+    def test_reserved_names(self, tmp_path: Path) -> None:
+        template = make_template(tmp_path / "reserved", "now: today\n")
+        report = lint_template(template)
+        assert any(
+            f.code == "reserved-question-name" for f in report.findings
+        )
+
+    def test_make_secret_reserved(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "reserved-secret",
+            "make_secret: hello\n",
+        )
+        report = lint_template(template)
+        matches = [
+            f for f in report.findings if f.code == "reserved-question-name"
+        ]
+        assert matches
+        assert "make_secret" in matches[0].message
+
+    def test_unsupported_type(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "bad-type",
+            "level:\n    type: uuid\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-question-type" for f in report.findings)
+
+    def test_type_inference_from_default(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "infer",
+            "flag:\n    default: true\n",
+            {"{{ _copier_conf.answers_file }}.jinja": ANSWERS_FILE_TEMPLATE},
+        )
+        report = lint_template(template)
+        assert report.errors == 0
+
+    def test_invalid_default_cast(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "bad-default",
+            "count:\n    type: int\n    default: not-a-number\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-default" for f in report.findings)
+
+    def test_null_default_for_scalar_type_is_error(self, tmp_path: Path) -> None:
+        for type_name in ("str", "int", "float", "bool", "path"):
+            template = make_template(
+                tmp_path / f"null-{type_name}",
+                f"value:\n    type: {type_name}\n    default: null\n",
+            )
+            report = lint_template(template)
+            assert any(f.code == "invalid-default" for f in report.findings), type_name
+
+    def test_null_default_for_document_types_is_ok(self, tmp_path: Path) -> None:
+        for type_name in ("yaml", "json"):
+            template = make_template(
+                tmp_path / f"null-doc-{type_name}",
+                f"data:\n    type: {type_name}\n    default: null\n",
+                {"{{ _copier_conf.answers_file }}.jinja": ANSWERS_FILE_TEMPLATE},
+            )
+            report = lint_template(template)
+            assert not any(
+                f.code == "invalid-default" for f in report.findings
+            ), type_name
+
+    def test_choices_must_be_list_or_mapping(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "bad-choices",
+            "level:\n    type: str\n    choices: not-a-list\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-choices" for f in report.findings)
+
+    def test_default_not_in_choices(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "default-not-in",
+            "level:\n"
+            "    type: str\n"
+            "    default: gamma\n"
+            "    choices: [alpha, beta]\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "default-not-in-choices" for f in report.findings)
+
+    def test_multiselect_needs_choices(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "multi",
+            "flavors:\n    type: str\n    multiselect: true\n",
+        )
+        report = lint_template(template)
+        assert any(
+            f.code == "multiselect-without-choices" for f in report.findings
+        )
+
+    def test_multiselect_default_list_subset(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "multi-ok",
+            "flavors:\n"
+            "    type: str\n"
+            "    multiselect: true\n"
+            "    choices: [a, b, c]\n"
+            "    default: [a, c]\n",
+            {"{{ _copier_conf.answers_file }}.jinja": ANSWERS_FILE_TEMPLATE},
+        )
+        report = lint_template(template)
+        assert not any(
+            f.code == "default-not-in-choices" for f in report.findings
+        )
+
+    def test_multiselect_default_element_not_in_choices(
+        self, tmp_path: Path
+    ) -> None:
+        template = make_template(
+            tmp_path / "multi-bad",
+            "flavors:\n"
+            "    type: str\n"
+            "    multiselect: true\n"
+            "    choices: [a, b]\n"
+            "    default: [a, z]\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "default-not-in-choices" for f in report.findings)
+
+    def test_secret_without_default(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "secret",
+            "token:\n    type: str\n    secret: true\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "secret-without-default" for f in report.findings)
+
+    def test_when_must_be_bool_or_string(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "bad-when",
+            "value:\n    when: 42\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-when" for f in report.findings)
+
+    def test_when_jinja_syntax_error(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "when-jinja",
+            "value:\n    when: '{{ unclosed'\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-when" for f in report.findings)
+
+    def test_validator_must_be_string(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "bad-validator",
+            "value:\n    validator: true\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-validator" for f in report.findings)
+
+    def test_help_and_placeholder_wrong_shape_are_warnings(
+        self, tmp_path: Path
+    ) -> None:
+        template = make_template(
+            tmp_path / "help",
+            "value:\n"
+            "    type: str\n"
+            "    help: [oops]\n"
+            "    placeholder: [oops]\n",
+        )
+        report = lint_template(template)
+        codes = {f.code for f in report.findings if f.severity == "warning"}
+        assert "invalid-help" in codes
+        assert "invalid-placeholder" in codes
+
+    def test_unknown_question_key_warning(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "unknown-key",
+            "value:\n    type: str\n    unknwon: oops\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "unknown-question-key" for f in report.findings)
+
+    def test_extended_choice_missing_value(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "extended",
+            "level:\n"
+            "    type: str\n"
+            "    choices:\n"
+            "      - - Beginner\n"
+            "        - description: bar\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-choices" for f in report.findings)
+
+    def test_extended_choice_validator_type(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "extended-validator",
+            "level:\n"
+            "    type: str\n"
+            "    choices:\n"
+            "      - - Beginner\n"
+            "        - value: b\n"
+            "          validator: 42\n",
+        )
+        report = lint_template(template)
+        assert any(f.code == "invalid-choices" for f in report.findings)
+
+
+class TestSettingRules:
+    """Rules applied to underscore-prefixed template settings."""
+
+    def test_exclude_must_be_list(self, tmp_path: Path) -> None:
+        template = make_template(
+            tmp_path / "bad-exclude",
+            "value: answer\n_exclude: not-a-list\n",
