+
+        Args:
+            template_path: Path to a local directory that contains the
+                template to validate. Remote URLs are not supported; the
+                current working directory is used when the argument is
+                omitted.
+
+        Returns:
+            ``0`` when no error was found (warnings are allowed), ``1`` on
+            error findings, or ``2`` on usage errors.
+        """
+        from ._lint import lint_template
+
+        if _looks_like_remote_template(template_path):
+            print(
+                f"Cannot lint {template_path!r}: only local template "
+                "directories are supported (remote URLs are not).",
+                file=sys.stderr,
+            )
+            return 2
+        path = Path(template_path)
+        if not path.exists():
+            print(
+                f"Cannot lint {template_path!r}: path does not exist.",
+                file=sys.stderr,
+            )
+            return 2
+        if not path.is_dir():
+            print(
+                f"Cannot lint {template_path!r}: not a local template "
+                "directory.",
+                file=sys.stderr,
+            )
+            return 2
+        try:
+            report = lint_template(path)
+        except NotADirectoryError as error:
+            print(
+                f"Cannot lint {template_path!r}: {error}",
+                file=sys.stderr,
+            )
+            return 2
+        if self.output_format == "json":
+            print(report.render_json())
+        else:
+            print(report.render_plain())
+        return 1 if report.errors else 0
