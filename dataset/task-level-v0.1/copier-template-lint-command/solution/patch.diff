+"""Public entry points for the ``copier lint`` subcommand.
+
+Most of the linting logic lives in :mod:`copier._template` (walker, config
+loader, per-setting rules) and :mod:`copier._user_data` (per-question
+rules); both modules are shared with the runtime template loader so that
+findings and runtime errors stay in lockstep. This module wires them into
+a :class:`LintReport` and renders it in the two output formats the CLI
+exposes.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from ._template import LintFinding, TemplateStaticValidator
+
+__all__ = ["Finding", "LintReport", "lint_template"]
+
+# Re-exported for callers that prefer a public alias.
+Finding = LintFinding
+
+
+@dataclass
+class LintReport:
+    """The outcome of linting a template directory.
+
+    Attributes:
+        findings: All findings collected during the run.
+    """
+
+    findings: list[LintFinding] = field(default_factory=list)
+
+    @property
+    def errors(self) -> int:
+        """Number of findings whose severity is ``"error"``."""
+        return sum(1 for finding in self.findings if finding.severity == "error")
+
+    @property
+    def warnings(self) -> int:
+        """Number of findings whose severity is ``"warning"``."""
+        return sum(1 for finding in self.findings if finding.severity == "warning")
+
+    def sorted_findings(self) -> list[LintFinding]:
+        """Return the findings in the documented output order.
+
+        Findings are ordered first by file, then by line, then by rule code;
+        findings not tied to a file come last so the caller can render them
+        below every file-specific line.
+        """
+        return sorted(self.findings, key=LintFinding.sort_key)
+
+    def render_plain(self) -> str:
+        """Render the report using the default human-readable format.
+
+        Every finding produces one line, followed by a summary line of the
+        form ``<N> error(s) and <M> warning(s) found``. The summary is
+        always present, even when the report is empty.
+        """
+        lines: list[str] = []
+        for finding in self.sorted_findings():
+            head = finding.severity
+            if finding.file is not None:
+                location = finding.file
+                if finding.line is not None:
+                    location = f"{location}:{finding.line}"
+                head = f"{location}: {head}"
+            lines.append(f"{head} [{finding.code}] {finding.message}")
+        lines.append(f"{self.errors} error(s) and {self.warnings} warning(s) found")
+        return "\n".join(lines)
+
+    def render_json(self) -> str:
+        """Render the report as a JSON document with two indentation levels.
+
+        The ordering matches :meth:`render_plain` exactly so that CI tools
+        can consume either format without further sorting.
+        """
+        payload: dict[str, Any] = {
+            "findings": [finding.as_dict() for finding in self.sorted_findings()],
+            "errors": self.errors,
+            "warnings": self.warnings,
+        }
+        return json.dumps(payload, indent=2)
+
+
+def lint_template(template_path: str | Path) -> LintReport:
+    """Lint a local template directory and return the collected report.
+
+    This function is the single, stable entry point for both the CLI and
+    any programmatic caller that wants to inspect templates without
+    rendering them. It never prompts, never touches the network and never
+    modifies the template directory.
+
+    Args:
+        template_path: Path to a local directory containing a Copier
+            template.
+
+    Returns:
+        A :class:`LintReport` describing every finding, ready to be
+        rendered in plain or JSON form.
+
+    Raises:
+        NotADirectoryError: When ``template_path`` does not point at a
+            directory. Higher-level callers (the CLI) turn this into a
+            usage error with exit code ``2``.
+    """
+    root = Path(template_path)
+    if not root.is_dir():
+        raise NotADirectoryError(str(template_path))
+    validator = TemplateStaticValidator(root)
+    findings = validator.validate()
+    return LintReport(findings=list(findings))
