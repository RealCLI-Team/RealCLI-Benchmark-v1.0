+                    cast_choices.append(cast)
+                if choice_ok and cast_choices:
+                    candidates = default if is_list_default else [default]
+                    for candidate in candidates:
+                        if _has_jinja_delimiters(candidate):
+                            continue
+                        if isinstance(candidate, (dict, list)):
+                            continue
+                        ok, cast_candidate = _cast_or_fail(known_type, candidate)
+                        if not ok:
+                            continue
+                        if cast_candidate not in cast_choices:
+                            emit(
+                                "error",
+                                "default-not-in-choices",
+                                f"default of question {name!r} is not one of "
+                                "its choices",
+                            )
+                            break
+
+    # --- Jinja-bearing string keys ---------------------------------------
+    when = question.get("when", True)
+    if not isinstance(when, (str, bool)):
+        emit(
+            "error",
+            "invalid-when",
+            f"`when` of question {name!r} must be a boolean or a string",
+        )
+    elif isinstance(when, str) and _has_jinja_delimiters(when):
+        try:
+            jinja_env.parse(when)
+        except Exception as error:  # noqa: BLE001
+            emit(
+                "error",
+                "invalid-when",
+                f"invalid Jinja in `when` of question {name!r}: {error}",
+            )
+    validator = question.get("validator", "")
+    if not isinstance(validator, str):
+        emit(
+            "error",
+            "invalid-validator",
+            f"`validator` of question {name!r} must be a string",
+        )
+    elif validator and _has_jinja_delimiters(validator):
+        try:
+            jinja_env.parse(validator)
+        except Exception as error:  # noqa: BLE001
+            emit(
+                "error",
+                "invalid-validator",
+                f"invalid Jinja in `validator` of question {name!r}: {error}",
+            )
+
+    for key, code in (("help", "invalid-help"), ("placeholder", "invalid-placeholder")):
+        value = question.get(key)
+        if value is not None and not isinstance(value, str):
+            emit(
+                "warning",
+                code,
+                f"`{key}` of question {name!r} must be a string",
+            )
+
+    return findings
