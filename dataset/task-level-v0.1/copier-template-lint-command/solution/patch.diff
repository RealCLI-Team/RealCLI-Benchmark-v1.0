+class TestParityWithRuntime:
+    """Templates the runtime accepts must not be flagged; and vice-versa."""
+
+    def _run_copy(
+        self, template: Path, destination: Path
+    ) -> subprocess.CompletedProcess[str]:
+        return subprocess.run(
+            [
+                sys.executable,
+                "-m",
+                "copier",
+                "copy",
+                "--defaults",
+                "--quiet",
+                str(template),
+                str(destination),
+            ],
+            capture_output=True,
+            text=True,
+            stdin=subprocess.DEVNULL,
+            timeout=120,
+        )
+
+    def test_clean_template_still_renders(self, tmp_path: Path) -> None:
+        template = make_valid_template(tmp_path)
+        destination = tmp_path / "out"
+        proc = self._run_copy(template, destination)
+        assert proc.returncode == 0, proc.stderr
+
+    def test_multi_config_errors_both(self, tmp_path: Path) -> None:
+        template = tmp_path / "both"
+        build_file_tree(
+            {
+                template / "copier.yml": "value: answer\n",
+                template / "copier.yaml": "value: answer\n",
+            }
+        )
+        destination = tmp_path / "out"
+        proc = self._run_copy(template, destination)
+        assert proc.returncode != 0
+        report = lint_template(template)
+        assert any(
+            f.code == "multiple-config-files" for f in report.findings
+        )
