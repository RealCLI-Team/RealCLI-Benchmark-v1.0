+def test_encodings_do_not_depend_on_row_order_fit():
+    X = np.array([["a"], ["b"], ["a"], ["b"], ["a"], ["b"]], dtype=object)
+    y = np.array([1.0, 4.0, 2.0, 5.0, 3.0, 6.0])
+    enc1 = TargetEncoder(smooth=1.0, target_type="continuous").fit(X, y)
+
+    perm = [2, 5, 0, 3, 1, 4]
+    X2 = X[perm]
+    y2 = y[perm]
+    enc2 = TargetEncoder(smooth=1.0, target_type="continuous").fit(X2, y2)
+    assert_allclose(enc1.encodings_[0], enc2.encodings_[0], rtol=1e-10, atol=1e-12)
+    assert enc1.target_mean_ == pytest.approx(enc2.target_mean_)
