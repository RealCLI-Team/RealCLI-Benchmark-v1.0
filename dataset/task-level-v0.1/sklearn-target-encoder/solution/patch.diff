+    enc = TargetEncoder(smooth=0.0, target_type="continuous").fit(X, y)
+    cats = list(enc.categories_[0])
+    assert cats == [1.5, 2.5]
+    assert enc.encodings_[0][0] == pytest.approx((1.0 + 1.2 + 0.8) / 3)
+    assert enc.encodings_[0][1] == pytest.approx((2.0 + 2.2) / 2)
