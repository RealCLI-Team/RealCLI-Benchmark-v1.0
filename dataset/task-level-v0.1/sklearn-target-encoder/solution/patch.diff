+@pytest.mark.parametrize("smooth", [0.0, 1.0, 5.0])
+def test_single_feature_single_row(smooth):
+    X = np.array([["only"]], dtype=object)
+    y = np.array([4.5])
+    enc = TargetEncoder(smooth=smooth, target_type="continuous").fit(X, y)
+    out = enc.transform(X)
+    assert out.shape == (1, 1)
+    # a single observed sample: encoding stays between conditional mean and
+    # global mean, which are the same value here
+    assert out[0, 0] == pytest.approx(4.5)
+
+
+def test_auto_smooth_single_sample_per_category():
+    # one sample per category: within-category variance is zero while the
+    # global variance is positive, so lambda is 1 and the encoding equals
+    # the conditional mean (the sample's own target value)
+    X = np.array([["a"], ["b"], ["c"], ["d"]], dtype=object)
+    y = np.array([1.0, 2.0, 3.0, 4.0])
+    enc = TargetEncoder(smooth="auto", target_type="continuous").fit(X, y)
+    cats = list(enc.categories_[0])
+    expected = dict(zip(["a", "b", "c", "d"], y))
+    for cat, value in zip(cats, enc.encodings_[0]):
+        assert value == pytest.approx(expected[cat])
+
+
+def test_transform_new_unseen_combinations():
+    rng = np.random.RandomState(0)
+    X, y = _make_toy_data(rng, n_samples=80, n_features=2)
+    enc = TargetEncoder(smooth=1.5).fit(X, y)
+    # reuse observed categories in new rows
+    cats0, cats1 = enc.categories_[0], enc.categories_[1]
+    X_new = np.array(
+        [[cats0[0], cats1[-1]], [cats0[-1], cats1[0]]], dtype=object
+    )
+    out = enc.transform(X_new)
+    X_ord = _reference_ordinal(X_new, enc.categories_)
+    ref = _reference_transform(X_ord, enc.encodings_, enc.target_mean_)
+    assert_allclose(out, ref, rtol=1e-10, atol=1e-12)
