+@pytest.mark.parametrize("seed", [10, 11, 12, 13, 14])
+@pytest.mark.parametrize("smooth", ["auto", 0.3, 4.0])
+@pytest.mark.parametrize("with_nan", [False, True])
+def test_randomized_fit_transform_sweep(seed, smooth, with_nan):
+    rng = np.random.RandomState(seed)
+    X, y = _make_toy_data(rng, n_samples=150, n_features=3, with_nan=with_nan)
+    enc = TargetEncoder(smooth=smooth, cv=4, random_state=seed)
+    out = enc.fit_transform(X, y)
+    assert out.shape == (150, 3)
+    assert np.all(np.isfinite(out))
+
+    # refit on full data for the reference cross-check of transform
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+    X_ord = _reference_ordinal(X, enc.categories_)
+    if smooth == "auto":
+        ref = _reference_fit_encodings_auto(
+            X_ord, y, n_categories, np.mean(y), np.var(y)
+        )
+    else:
+        ref = _reference_fit_encodings(X_ord, y, n_categories, smooth, np.mean(y))
+    for f_idx in range(3):
+        assert_allclose(enc.encodings_[f_idx], ref[f_idx], rtol=1e-8, atol=1e-10)
+    assert_allclose(
+        enc.transform(X),
+        _reference_transform(X_ord, ref, np.mean(y)),
+        rtol=1e-8,
+        atol=1e-10,
+    )
+
