+"""Reference cross-checks for TargetEncoder.
+
+This module validates the TargetEncoder implementation against an independent,
+pure NumPy reference implementation of the Micci-Barreca shrinkage estimator.
+"""
+
+import numpy as np
+import pytest
+from numpy.testing import assert_allclose, assert_array_equal
+
+from sklearn.preprocessing import TargetEncoder
+from sklearn.preprocessing import LabelEncoder
+from sklearn.model_selection import KFold, StratifiedKFold
+
+
+# ---------------------------------------------------------------------------
+# Independent reference implementation
+# ---------------------------------------------------------------------------
+
+
+def _reference_fit_encodings(X_ord, y, n_categories, smooth, y_mean):
+    """Reference encoding with an explicit smoothing strength.
+
+    encoding[c] = (sum of y in c + smooth * y_mean) / (count of c + smooth)
+    Categories with zero observed count are mapped to ``y_mean``.
+    """
+    encodings = []
+    for f_idx in range(X_ord.shape[1]):
+        n_cats = n_categories[f_idx]
+        sums = np.full(n_cats, smooth * y_mean, dtype=np.float64)
+        counts = np.full(n_cats, float(smooth), dtype=np.float64)
+        for i in range(X_ord.shape[0]):
+            cat = X_ord[i, f_idx]
+            if cat == -1:
+                continue
+            sums[cat] += y[i]
+            counts[cat] += 1.0
+        enc = np.empty(n_cats, dtype=np.float64)
+        for c in range(n_cats):
+            if counts[c] == 0.0:
+                enc[c] = y_mean
+            else:
+                enc[c] = sums[c] / counts[c]
+        encodings.append(enc)
+    return encodings
+
+
+def _reference_fit_encodings_auto(X_ord, y, n_categories, y_mean, y_variance):
+    """Reference encoding with empirical Bayes ("auto") smoothing."""
+    encodings = []
+    for f_idx in range(X_ord.shape[1]):
+        n_cats = n_categories[f_idx]
+        counts = np.zeros(n_cats, dtype=np.int64)
+        means = np.zeros(n_cats, dtype=np.float64)
+        for i in range(X_ord.shape[0]):
+            cat = X_ord[i, f_idx]
+            if cat == -1:
+                continue
+            counts[cat] += 1
+            means[cat] += y[i]
+        means = means / counts
+        ssd = np.zeros(n_cats, dtype=np.float64)
+        for i in range(X_ord.shape[0]):
+            cat = X_ord[i, f_idx]
+            if cat == -1:
+                continue
+            diff = y[i] - means[cat]
+            ssd[cat] += diff * diff
+        enc = np.empty(n_cats, dtype=np.float64)
+        for c in range(n_cats):
+            denom = y_variance * counts[c] + ssd[c] / counts[c]
+            lambda_ = y_variance * counts[c] / denom
+            if np.isnan(lambda_):
+                enc[c] = y_mean
+            else:
+                enc[c] = lambda_ * means[c] + (1 - lambda_) * y_mean
+        encodings.append(enc)
+    return encodings
+
+
+def _reference_ordinal(X, categories_list):
+    """Map raw values to ordinal codes using fitted category lists.
+
+    Unknown values are mapped to -1. NaN/None are treated as regular
+    categories when they appear in the fitted categories.
+    """
+    n_samples, n_features = X.shape
+    X_ord = np.empty((n_samples, n_features), dtype=np.int64)
+    for f_idx in range(n_features):
+        cats = categories_list[f_idx]
+        for i in range(n_samples):
+            val = X[i, f_idx]
+            code = -1
+            for c_idx, cat in enumerate(cats):
+                if _same_value(val, cat):
+                    code = c_idx
+                    break
+            X_ord[i, f_idx] = code
+    return X_ord
+
+
+def _same_value(a, b):
+    if isinstance(a, float) and np.isnan(a):
+        return isinstance(b, float) and np.isnan(b)
+    if a is None or b is None:
+        return a is None and b is None
+    try:
+        return bool(a == b)
+    except Exception:
+        return False
+
+
+def _reference_transform(X_ord, encodings, y_mean):
+    n_samples, n_features = X_ord.shape
+    out = np.empty((n_samples, n_features), dtype=np.float64)
+    for f_idx in range(n_features):
+        for i in range(n_samples):
+            cat = X_ord[i, f_idx]
+            if cat == -1:
+                out[i, f_idx] = y_mean
+            else:
+                out[i, f_idx] = encodings[f_idx][cat]
+    return out
+
+
+def _make_toy_data(rng, n_samples=60, n_features=2, with_nan=False):
+    """Build a toy categorical design matrix and continuous target."""
+    alphabets = [
+        np.array(["a", "b", "c", "d"], dtype=object),
+        np.array(["x", "y", "z"], dtype=object),
+        np.array(["u", "v", "w", "t", "s"], dtype=object),
+    ]
+    cols = []
+    for f_idx in range(n_features):
+        letters = alphabets[f_idx % len(alphabets)]
+        col = letters[rng.randint(0, len(letters), size=n_samples)].astype(object)
+        if with_nan:
+            mask = rng.rand(n_samples) < 0.1
+            col[mask] = np.nan
+        cols.append(col)
+    X = np.column_stack(cols)
+    coef = rng.normal(size=n_features * 5)
+    y = np.zeros(n_samples)
+    for f_idx in range(n_features):
+        for i in range(n_samples):
+            v = X[i, f_idx]
+            if isinstance(v, float) and np.isnan(v):
+                y[i] += coef[f_idx * 5 + 4]
+            else:
+                y[i] += coef[f_idx * 5 + (hash(v) % 4)]
+    y += rng.normal(scale=0.5, size=n_samples)
+    return X, y
+
+
+# ---------------------------------------------------------------------------
+# fit / transform cross-checks with explicit smoothing
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("smooth", [0.0, 0.5, 1.0, 3.7, 25.0, 1000.0])
+@pytest.mark.parametrize("seed", [0, 1, 2])
+def test_encodings_match_reference_fixed_smooth(smooth, seed):
+    rng = np.random.RandomState(seed)
+    X, y = _make_toy_data(rng, n_samples=80, n_features=2)
+    enc = TargetEncoder(smooth=smooth)
+    enc.fit(X, y)
+
+    assert enc.target_type_ == "continuous"
+    assert_allclose(enc.target_mean_, np.mean(y))
+
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+    X_ord = _reference_ordinal(X, enc.categories_)
+    ref = _reference_fit_encodings(
+        X_ord, y, n_categories, smooth, np.mean(y)
+    )
+    assert len(enc.encodings_) == 2
+    for f_idx in range(2):
+        assert_allclose(enc.encodings_[f_idx], ref[f_idx], rtol=1e-10, atol=1e-12)
+
+    X_out = enc.transform(X)
+    ref_out = _reference_transform(X_ord, ref, np.mean(y))
+    assert X_out.dtype == np.float64
+    assert_allclose(X_out, ref_out, rtol=1e-10, atol=1e-12)
+
+
+@pytest.mark.parametrize("smooth", [0.0, 1.0, 10.0])
+def test_encodings_match_reference_fixed_smooth_three_features(smooth):
+    rng = np.random.RandomState(42)
+    X, y = _make_toy_data(rng, n_samples=120, n_features=3)
+    enc = TargetEncoder(smooth=smooth).fit(X, y)
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+    X_ord = _reference_ordinal(X, enc.categories_)
+    ref = _reference_fit_encodings(X_ord, y, n_categories, smooth, np.mean(y))
+    for f_idx in range(3):
+        assert_allclose(enc.encodings_[f_idx], ref[f_idx], rtol=1e-10, atol=1e-12)
+    assert_allclose(
+        enc.transform(X),
+        _reference_transform(X_ord, ref, np.mean(y)),
+        rtol=1e-10,
+        atol=1e-12,
+    )
+
+
+def test_zero_smooth_is_plain_conditional_mean():
+    X = np.array([["a"], ["a"], ["b"], ["b"], ["b"], ["c"]], dtype=object)
+    y = np.array([1.0, 3.0, 2.0, 4.0, 6.0, 10.0])
+    enc = TargetEncoder(smooth=0.0, target_type="continuous").fit(X, y)
+    cats = list(enc.categories_[0])
+    expected = {"a": 2.0, "b": 4.0, "c": 10.0}
+    for cat, value in zip(cats, enc.encodings_[0]):
+        assert value == pytest.approx(expected[cat])
+
+
+def test_huge_smooth_is_global_mean():
+    X = np.array([["a"], ["a"], ["b"], ["b"], ["c"]], dtype=object)
+    y = np.array([1.0, 3.0, 5.0, 7.0, 9.0])
+    enc = TargetEncoder(smooth=1e12, target_type="continuous").fit(X, y)
+    for value in enc.encodings_[0]:
+        assert value == pytest.approx(np.mean(y), rel=1e-6)
+
+
+# ---------------------------------------------------------------------------
+# fit / transform cross-checks with auto smoothing
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("seed", [0, 1, 2, 3])
+@pytest.mark.parametrize("n_features", [1, 2, 3])
+def test_encodings_match_reference_auto_smooth(seed, n_features):
+    rng = np.random.RandomState(seed)
+    X, y = _make_toy_data(rng, n_samples=90, n_features=n_features)
+    enc = TargetEncoder(smooth="auto").fit(X, y)
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+    X_ord = _reference_ordinal(X, enc.categories_)
+    ref = _reference_fit_encodings_auto(
+        X_ord, y, n_categories, np.mean(y), np.var(y)
+    )
+    for f_idx in range(n_features):
+        assert_allclose(enc.encodings_[f_idx], ref[f_idx], rtol=1e-10, atol=1e-12)
+
+
+def test_auto_smooth_constant_target_gives_mean():
+    rng = np.random.RandomState(0)
+    X, _ = _make_toy_data(rng, n_samples=50, n_features=2)
+    y = np.full(50, 7.5)
+    enc = TargetEncoder(smooth="auto").fit(X, y)
+    assert_allclose(enc.target_mean_, 7.5)
+    for f_idx in range(2):
+        assert_allclose(enc.encodings_[f_idx], 7.5)
+
+
+def test_auto_smooth_docstring_example():
+    # Example from the estimator docstring: high smooth stays close to the
+    # global mean, low smooth stays close to the conditional mean.
+    X = np.array([["dog"] * 20 + ["cat"] * 30 + ["snake"] * 38], dtype=object).T
+    y = [90.3] * 5 + [80.1] * 15 + [20.4] * 5 + [20.1] * 25 + [21.2] * 8 + [49] * 30
+    y = np.asarray(y, dtype=np.float64)
+
+    enc_high = TargetEncoder(smooth=5000.0).fit(X, y)
+    global_mean = np.mean(y)
+    assert enc_high.target_mean_ == pytest.approx(global_mean)
+    for value in enc_high.encodings_[0]:
+        assert abs(value - global_mean) < 1.0
+
+    enc_low = TargetEncoder(smooth=1.0).fit(X, y)
+    cats = list(enc_low.categories_[0])
+    cond_mean = {
+        "dog": (5 * 90.3 + 15 * 80.1) / 20,
+        "cat": (5 * 20.4 + 25 * 20.1) / 30,
+        "snake": (8 * 21.2 + 30 * 49.0) / 38,
+    }
+    for cat, value in zip(cats, enc_low.encodings_[0]):
+        assert abs(value - cond_mean[cat]) < 5.0
+
+    enc_auto = TargetEncoder(smooth="auto").fit(X, y)
+    assert enc_auto.encodings_[0].shape == (3,)
+
+
+# ---------------------------------------------------------------------------
+# Binary targets
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("labels", [(0, 1), ("no", "yes"), ("b", "a"), (-1, 1)])
+def test_binary_target_encoded_as_probability(labels):
+    rng = np.random.RandomState(0)
+    n = 100
+    X = np.array([["p"] * 50 + ["q"] * 50], dtype=object).T
+    y_raw = rng.randint(0, 2, size=n)
+    y = np.array([labels[v] for v in y_raw])
+
+    enc = TargetEncoder(smooth=2.0)
+    enc.fit(X, y)
+    assert enc.target_type_ == "binary"
+
+    y_bin = LabelEncoder().fit_transform(y)
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+    X_ord = _reference_ordinal(X, enc.categories_)
+    ref = _reference_fit_encodings(
+        X_ord, y_bin.astype(np.float64), n_categories, 2.0, np.mean(y_bin)
+    )
+    assert_allclose(enc.encodings_[0], ref[0], rtol=1e-10, atol=1e-12)
+    assert np.all(enc.encodings_[0] >= 0.0)
+    assert np.all(enc.encodings_[0] <= 1.0)
