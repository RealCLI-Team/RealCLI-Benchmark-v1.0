+    assert np.all(np.isfinite(out))
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+    X_ord = _reference_ordinal(X, enc.categories_)
+    ref = _reference_fit_encodings(X_ord, y, n_categories, 5.0, np.mean(y))
