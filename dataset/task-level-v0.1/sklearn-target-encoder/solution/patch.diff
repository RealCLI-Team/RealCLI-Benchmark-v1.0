+def test_fit_then_transform_uses_all_data_encoding():
+    # fit(X, y).transform(X) encodes with the encoding learned from all
+    # samples (including each row itself), unlike fit_transform
+    X = np.array([["a"], ["a"], ["b"], ["b"]], dtype=object)
+    y = np.array([1.0, 3.0, 10.0, 20.0])
+    enc = TargetEncoder(smooth=0.0, target_type="continuous")
+    out = enc.fit(X, y).transform(X)
+    assert_allclose(out[:, 0], [2.0, 2.0, 15.0, 15.0])
