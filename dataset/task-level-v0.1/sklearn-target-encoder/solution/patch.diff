+@pytest.mark.parametrize("seed", [0, 7, 123])
+def test_fit_transform_random_state_changes_output(seed):
+    rng = np.random.RandomState(0)
+    X, y = _make_toy_data(rng, n_samples=100, n_features=1)
+    out_a = TargetEncoder(smooth=1.0, cv=3, random_state=seed).fit_transform(X, y)
+    out_b = TargetEncoder(smooth=1.0, cv=3, random_state=seed + 1).fit_transform(X, y)
+    assert not np.allclose(out_a, out_b)
+    out_c = TargetEncoder(smooth=1.0, cv=3, random_state=seed).fit_transform(X, y)
+    assert_array_equal(out_a, out_c)
