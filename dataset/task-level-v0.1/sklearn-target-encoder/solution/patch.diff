+def test_binary_fit_transform_stratified():
+    # StratifiedKFold keeps class ratios: with a balanced target each fold
+    # mean stays 0.5, so unseen categories map to 0.5
+    n = 60
+    X = np.array([["u"] * n + ["v"] * n], dtype=object).T
+    y = np.array([0, 1] * n)
+    enc = TargetEncoder(smooth=1.0, cv=3, random_state=0)
+    out = enc.fit_transform(X, y)
+    assert out.shape == (2 * n, 1)
+    assert np.all(out >= 0.0)
+    assert np.all(out <= 1.0)
+
