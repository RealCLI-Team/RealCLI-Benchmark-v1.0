+# ---------------------------------------------------------------------------
+# fit_transform with internal cross-validation
+# ---------------------------------------------------------------------------
+
+
+def _reference_fit_transform(enc, X, y, target_type):
+    """Reference fit_transform replicating the internal CV scheme."""
+    X_ord = _reference_ordinal(X, enc.categories_)
+    n_categories = np.array([len(c) for c in enc.categories_], dtype=np.int64)
+
+    if target_type == "continuous":
+        splitter = KFold(
+            enc.cv, shuffle=enc.shuffle, random_state=enc.random_state
+        )
+    else:
+        splitter = StratifiedKFold(
+            enc.cv, shuffle=enc.shuffle, random_state=enc.random_state
+        )
+
+    out = np.empty(X_ord.shape, dtype=np.float64)
+    for train_idx, test_idx in splitter.split(X, y):
+        X_tr = X_ord[train_idx]
+        y_tr = y[train_idx]
+        y_mean = np.mean(y_tr)
+        if enc.smooth == "auto":
+            fold_enc = _reference_fit_encodings_auto(
+                X_tr, y_tr, n_categories, y_mean, np.var(y_tr)
+            )
+        else:
+            fold_enc = _reference_fit_encodings(
+                X_tr, y_tr, n_categories, enc.smooth, y_mean
+            )
+        for f_idx in range(X_ord.shape[1]):
+            for i in test_idx:
+                cat = X_ord[i, f_idx]
+                if cat == -1:
+                    out[i, f_idx] = y_mean
+                else:
+                    out[i, f_idx] = fold_enc[f_idx][cat]
+    return out
+
