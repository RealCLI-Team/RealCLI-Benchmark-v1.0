+
+"""Disk-usage analyzer built on top of dupeGuru's ``core``.
+
+A scriptable, offline "where did my disk space go" toolkit. It layers on
+:mod:`core.fs` (the file model and its staged hashing) and
+:mod:`core.directories` (tree walking with normal / reference / excluded folder
+states) to turn a set of directories into:
+
+* a **usage tree** with per-directory apparent and allocated (block) sizes,
+* **hotspots** (the heaviest directories) and the **largest files**,
+* **breakdowns** by extension and by age bucket,
+* a **cruft** classification (empty / temp / cache / log / backup files),
+* a **duplicate-waste** estimate (byte-identical copies), and
+* configurable **threshold** checks that turn the numbers into pass/warn/fail.
+
+Everything after the initial scan is pure computation over a flat list of
+:class:`FileEntry`, so a report can be serialised, compared and re-sliced with
+no further disk access.
+"""
+
+from .errors import (
+    DiskScanError,
+    DiskScanConfigError,
+    InvalidScanRootError,
+    UnknownBucketError,
+    ScanInterruptedError,
+)
+from .units import (
+    STAT_BLOCK_SIZE,
+    allocated_size_of,
+    blocks_to_bytes,
+    format_size,
+    format_count,
+    percent_of,
+    SECONDS_PER_DAY,
+    SECONDS_PER_WEEK,
+    SECONDS_PER_MONTH,
+    SECONDS_PER_YEAR,
+)
+from .entry import FileEntry
+from .ages import AgeBucket, AgeLadder, default_age_ladder, DEFAULT_AGE_CUTOFFS
+from .tree import UsageNode, UsageTree
+from .breakdown import (
+    BreakdownRow,
+    Breakdown,
+    breakdown_by_extension,
+    breakdown_by_age,
+    breakdown_by_top_directory,
+)
+from .cruft import (
+    CruftRule,
+    CruftTag,
+    CruftReport,
+    CruftClassifier,
+    default_rules,
+    CATEGORY_EMPTY,
+    CATEGORY_TEMP,
+    CATEGORY_CACHE,
+    CATEGORY_LOG,
+    CATEGORY_BACKUP,
+    ALL_CATEGORIES,
+)
+from .duplicates import (
+    DuplicateSet,
+    DuplicateReport,
+    find_duplicate_sets,
+    DEFAULT_BIG_FILE_SIZE,
+)
+from .thresholds import (
+    ThresholdRule,
+    ThresholdBreach,
+    ThresholdResult,
+    ThresholdSet,
+    default_thresholds,
+    severity_rank,
+    SEVERITY_INFO,
+    SEVERITY_WARNING,
+    SEVERITY_CRITICAL,
+    SEVERITIES,
+)
+from .scanner import ScanSpec, ScanResult, DiskScanner
+from .report import AnalysisReport, build_report
+from .session import DiskScanSession
+from .loader import (
+    merge_documents,
+    load_settings,
+    load_session,
+    load_thresholds,
+    DEFAULT_SETTINGS,
+)
+
+__all__ = [
+    # errors
+    "DiskScanError",
+    "DiskScanConfigError",
+    "InvalidScanRootError",
+    "UnknownBucketError",
+    "ScanInterruptedError",
+    # units
