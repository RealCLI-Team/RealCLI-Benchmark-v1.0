+++ b/core/diskscan/errors.py
@@ -0,0 +1,35 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Exceptions for the disk-usage analyzer.
+
+Like the rest of the disk tooling, configuration problems (a bad scan root, an
+unknown breakdown key) are kept distinct from runtime problems, so a caller can
+validate a request up-front and be confident nothing was walked yet.
+"""
+
+
+class DiskScanError(Exception):
+    """Root of every error raised by :mod:`core.diskscan`."""
+
+
+class DiskScanConfigError(DiskScanError):
+    """The analysis was misconfigured (bad root, unknown option, ...).
+
+    Detectable before walking anything.
+    """
+
+
+class InvalidScanRootError(DiskScanConfigError):
+    """A path handed to the scanner is missing or is not a directory."""
+
+
+class UnknownBucketError(DiskScanConfigError):
+    """A breakdown was requested by a dimension name we don't recognise."""
+
+
+class ScanInterruptedError(DiskScanError):
+    """The walk was cancelled through the job-progress hook."""
diff --git a/core/diskscan/loader.py b/core/diskscan/loader.py
new file mode 100644
index 00000000..996c9aaa
--- /dev/null
+++ b/core/diskscan/loader.py
@@ -0,0 +1,149 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Layered configuration for disk-usage analyses.
+
+A real audit config is layered: a shared base (the roots and rules everyone
+agrees on), plus per-machine or per-user overlays. This module deep-merges a
+list of such documents into one settings dict, following the same rules the
+reclaim loader uses so the two tools' configs behave identically:
+
+* later documents override earlier ones for **scalar** values;
+* **list** fields (``roots``, ``include_ext`` ...) are **appended**, not
+  replaced, so overlays extend rather than clobber;
+* a key explicitly set to ``None`` **deletes** whatever earlier layers set.
+
+It then materialises a ready-to-run :class:`~core.diskscan.session.DiskScanSession`,
+including any threshold rules declared in a ``thresholds`` block.
+"""
+
+from __future__ import annotations
+
+import copy
+
+from .ages import AgeLadder, default_age_ladder
+from .errors import DiskScanConfigError
+from .scanner import ScanSpec
+from .session import DiskScanSession
+from .thresholds import default_thresholds
+
+__all__ = ["merge_documents", "load_settings", "load_session", "load_thresholds", "DEFAULT_SETTINGS"]
+
+_APPEND_LIST_KEYS = {
+    "roots",
+    "paths",
+    "reference_roots",
+    "references",
+    "excluded_roots",
+    "excludes",
+    "include_ext",
+    "exclude_ext",
+    "include_globs",
+    "exclude_globs",
+}
+
+DEFAULT_SETTINGS = {
+    "detect_duplicates": True,
+    "duplicate_min_size": 1,
+}
+
+
+def _merge_into(base, overlay):
+    for key, value in overlay.items():
+        if value is None:
+            base.pop(key, None)
+            continue
+        if key in _APPEND_LIST_KEYS and isinstance(value, list):
+            existing = base.get(key)
+            if isinstance(existing, list):
+                merged = list(existing)
+                for item in value:
+                    if item not in merged:
+                        merged.append(item)
+                base[key] = merged
+            else:
+                base[key] = list(value)
+            continue
+        if isinstance(value, dict) and isinstance(base.get(key), dict):
+            _merge_into(base[key], value)
+            continue
+        base[key] = copy.deepcopy(value)
+
+
+def merge_documents(documents):
+    """Deep-merge a sequence of config dicts into one settings dict."""
+    result = {}
+    for doc in documents:
+        if doc is None:
+            continue
+        if not isinstance(doc, dict):
+            raise DiskScanConfigError(f"config document must be a dict, got {type(doc).__name__}")
+        _merge_into(result, doc)
+    return result
+
+
+def load_settings(documents):
+    """Merge ``documents`` on top of the defaults; return the settings dict."""
+    return merge_documents([DEFAULT_SETTINGS] + list(documents))
+
+
+def _ladder_from_settings(settings):
+    """Build a custom age ladder from an ``age_buckets`` block, if present.
+
+    The block is a list of ``[label, max_age_seconds]`` pairs (last one's
+    max_age ``None``); absent, we use the default ladder.
+    """
+    spec = settings.get("age_buckets")
+    if not spec:
+        return None
+    try:
+        cutoffs = [(label, upper) for label, upper in spec]
+    except (TypeError, ValueError):
+        raise DiskScanConfigError("age_buckets must be a list of [label, max_age] pairs")
+    return AgeLadder(cutoffs)
+
+
+def load_thresholds(settings):
+    """Build a :class:`ThresholdSet` from a ``thresholds`` block, if present."""
+    block = settings.get("thresholds")
+    if not block:
+        return None
+    if not isinstance(block, dict):
+        raise DiskScanConfigError("thresholds must be a mapping of limit -> value")
+    known = {
+        "max_total_allocated",
+        "max_hotspot_allocated",
+        "max_cruft_fraction",
+        "max_duplicate_fraction",
+        "max_empty_files",
+    }
+    unknown = set(block) - known
+    if unknown:
+        raise DiskScanConfigError(f"unknown threshold keys: {sorted(unknown)}")
+    return default_thresholds(**block)
+
+
+def load_session(documents):
+    """Build a :class:`DiskScanSession` from layered config documents."""
+    settings = load_settings(documents)
+    if not settings.get("roots") and not settings.get("paths"):
+        raise DiskScanConfigError("config must declare at least one scan root")
+    spec = ScanSpec.from_dict(settings)
+    ladder = _ladder_from_settings(settings)
+
+    kwargs = {}
+    if "detect_duplicates" in settings:
+        kwargs["detect_duplicates"] = bool(settings["detect_duplicates"])
+    if "duplicate_min_size" in settings:
+        kwargs["duplicate_min_size"] = settings["duplicate_min_size"]
+    if "duplicate_big_file_size" in settings:
+        kwargs["duplicate_big_file_size"] = settings["duplicate_big_file_size"]
+    if "include_reference_cruft" in settings:
+        kwargs["include_reference_cruft"] = bool(settings["include_reference_cruft"])
+    if ladder is not None:
+        kwargs["age_ladder"] = ladder
+
+    return DiskScanSession(spec, **kwargs)
diff --git a/core/diskscan/report.py b/core/diskscan/report.py
new file mode 100644
index 00000000..51f60ccd
--- /dev/null
+++ b/core/diskscan/report.py
@@ -0,0 +1,231 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The assembled analysis report.
+
+:class:`AnalysisReport` is the single object that ties every facet of a scan
+together -- the usage tree, the extension and age breakdowns, the cruft scan and
+the duplicate-waste estimate -- and knows how to render itself as a dict, as
+JSON, and as a compact human-readable text summary. It holds *no* live disk
+handles: it's built entirely from the flat :class:`FileEntry` list a scan
+produced, so it can be serialised, compared, and re-sliced freely.
+
+The report is pure data + presentation. The orchestration that produces it
+lives in :mod:`core.diskscan.session`.
+"""
+
+from __future__ import annotations
+
+import json
+
+from .breakdown import breakdown_by_age, breakdown_by_extension, breakdown_by_top_directory
+from .cruft import CruftClassifier
+from .duplicates import find_duplicate_sets
+from .tree import UsageTree
+from .units import format_count, format_size, percent_of
+
+
+class AnalysisReport:
+    """A complete, serialisable view of one disk-usage analysis."""
+
+    def __init__(
+        self,
+        tree,
+        extension_breakdown,
+        age_breakdown,
+        cruft,
+        duplicates,
+        ref_time,
+        root,
+    ):
+        self.tree = tree
+        self.extension_breakdown = extension_breakdown
+        self.age_breakdown = age_breakdown
+        self.cruft = cruft
+        self.duplicates = duplicates
+        self.ref_time = ref_time
+        self.root = root
+
+    # --- Convenience pass-throughs -------------------------------------------
+    @property
+    def entries(self):
+        return self.tree.entries
+
+    @property
+    def total_allocated(self):
+        return self.tree.total_allocated
+
+    @property
+    def total_apparent(self):
+        return self.tree.total_apparent
+
+    @property
+    def total_files(self):
+        return self.tree.total_files
+
+    @property
+    def total_dirs(self):
+        return self.tree.total_dirs
+
+    @property
+    def slack_bytes(self):
+        """Total bytes lost to block rounding across every file."""
+        return sum(e.slack_bytes for e in self.entries)
+
+    def hotspots(self, limit=10, min_fraction=0.0):
+        return self.tree.hotspots(limit=limit, min_fraction=min_fraction)
+
+    def largest_files(self, limit=10):
+        return self.tree.largest_files(limit=limit)
+
+    # --- Serialisation --------------------------------------------------------
+    def as_dict(self, tree_depth=2, tree_min_fraction=0.0, top=10):
+        whole = self.total_allocated
+        return {
+            "root": str(self.root),
+            "totals": {
+                "allocated": self.total_allocated,
+                "apparent": self.total_apparent,
+                "files": self.total_files,
+                "dirs": self.total_dirs,
+                "slack": self.slack_bytes,
+            },
+            "tree": self.tree.root.as_dict(
+                max_depth=tree_depth,
+                min_fraction=tree_min_fraction,
+                whole_allocated=whole,
+            ),
+            "hotspots": [
+                {
+                    "path": str(n.path),
+                    "allocated": n.total_allocated,
+                    "apparent": n.total_apparent,
+                    "files": n.total_files,
+                    "fraction": percent_of(n.total_allocated, whole),
+                }
+                for n in self.hotspots(limit=top)
+            ],
+            "largest_files": [
+                {
+                    "path": str(e.path),
+                    "allocated": e.allocated_size,
+                    "apparent": e.apparent_size,
+                }
+                for e in self.largest_files(limit=top)
+            ],
+            "by_extension": self.extension_breakdown.top(top).as_dict(),
+            "by_age": self.age_breakdown.as_dict(),
+            "cruft": self.cruft.as_dict(whole_allocated=whole),
+            "duplicates": self.duplicates.as_dict(),
+        }
+
+    def as_json(self, indent=2, **kwargs):
+        return json.dumps(self.as_dict(**kwargs), indent=indent, ensure_ascii=False, sort_keys=True)
+
+    def render_text(self, top=10):
+        """Return a compact multi-line summary suitable for a terminal."""
+        whole = self.total_allocated
+        lines = []
+        lines.append(f"Disk usage report for {self.root}")
+        lines.append(
+            "  total: {} allocated ({} apparent) across {} files in {} dirs".format(
+                format_size(self.total_allocated),
+                format_size(self.total_apparent),
+                format_count(self.total_files),
+                format_count(self.total_dirs),
+            )
+        )
+        lines.append(f"  slack (block rounding): {format_size(self.slack_bytes)}")
+        lines.append("")
+        lines.append(f"Top {top} directories:")
+        for node in self.hotspots(limit=top):
+            lines.append(
+                "  {:>10}  {:>5.1f}%  {}".format(
+                    format_size(node.total_allocated),
+                    percent_of(node.total_allocated, whole),
+                    node.path,
+                )
+            )
+        lines.append("")
+        lines.append("By extension:")
+        for row in self.extension_breakdown.top(top):
+            lines.append(
+                "  {:>10}  {:>5.1f}%  {} ({} files)".format(
+                    format_size(row.allocated),
+                    percent_of(row.allocated, whole),
+                    row.key,
+                    format_count(row.count),
+                )
+            )
+        lines.append("")
+        lines.append("By age:")
+        for row in self.age_breakdown:
+            lines.append(
+                "  {:>10}  {:>5.1f}%  {} ({} files)".format(
+                    format_size(row.allocated),
+                    percent_of(row.allocated, whole),
+                    row.key,
+                    format_count(row.count),
+                )
+            )
+        lines.append("")
+        lines.append(
+            "Cruft: {} in {} files ({:.1f}% of tree)".format(
+                format_size(self.cruft.total_allocated),
+                format_count(self.cruft.count),
+                percent_of(self.cruft.total_allocated, whole),
+            )
+        )
+        lines.append(
+            "Duplicates: {} wasted across {} groups ({:.1f}% of tree)".format(
+                format_size(self.duplicates.wasted_allocated),
+                format_count(self.duplicates.group_count),
+                percent_of(self.duplicates.wasted_allocated, whole),
+            )
+        )
+        return "\n".join(lines)
+
+
+def build_report(
+    entries,
+    root,
+    ref_time,
+    age_ladder=None,
+    cruft_rules=None,
+    include_reference_cruft=False,
+    duplicate_min_size=1,
+    duplicate_big_file_size=None,
+    detect_duplicates=True,
+    dirs=None,
+):
+    """Assemble an :class:`AnalysisReport` from a flat entry list.
+
+    This is the pure aggregation step: it builds the tree, both breakdowns, the
+    cruft scan and (optionally) the duplicate estimate, all from ``entries``
+    without touching the disk again -- except duplicate detection, which must
+    read file contents to hash them and is therefore opt-out for a fast run.
+    """
+    tree = UsageTree.from_entries(root, entries, dirs=dirs)
+    extension_breakdown = breakdown_by_extension(entries)
+    age_breakdown = breakdown_by_age(entries, ref_time=ref_time, ladder=age_ladder)
+    classifier = CruftClassifier(rules=cruft_rules, include_reference=include_reference_cruft)
+    cruft = classifier.classify(entries)
+    if detect_duplicates:
+        kwargs = {"min_size": duplicate_min_size}
+        if duplicate_big_file_size is not None:
+            kwargs["big_file_size"] = duplicate_big_file_size
+        duplicates = find_duplicate_sets(entries, **kwargs)
+    else:
+        duplicates = find_duplicate_sets([], min_size=duplicate_min_size)
+    return AnalysisReport(
+        tree=tree,
+        extension_breakdown=extension_breakdown,
+        age_breakdown=age_breakdown,
+        cruft=cruft,
+        duplicates=duplicates,
+        ref_time=ref_time,
+        root=root,
+    )
diff --git a/core/diskscan/scanner.py b/core/diskscan/scanner.py
new file mode 100644
index 00000000..5138b6a2
--- /dev/null
+++ b/core/diskscan/scanner.py
@@ -0,0 +1,268 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Walking directories into a flat list of :class:`FileEntry`.
+
+Like the reclaim scanner, this layers on :class:`core.directories.Directories`
+rather than re-implementing tree walking. It honours the same folder-state
+vocabulary -- *normal*, *reference*, *excluded* -- so a "master" tree can be
+counted toward usage while being flagged (its entries carry ``is_reference``,
+which the cruft scanner and any downstream reclaim step respect).
+
+The scanner is where the disk is actually touched; everything after it works off
+the returned :class:`FileEntry` list. It captures one **reference time** at the
+start of the walk so the entire analysis shares a single clock for age
+computations.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import os
+from pathlib import Path
+
+from hscommon.jobprogress import job
+
+from core import fs
+from core.directories import Directories, DirectoryState, InvalidPathError
+
+from .entry import FileEntry
+from .errors import InvalidScanRootError
+
+__all__ = ["ScanSpec", "DiskScanner"]
+
+
+class ScanSpec:
+    """Declarative description of *what* to scan.
+
+    Mirrors the reclaim scanner's spec vocabulary so config files can be shared
+    between the two tools, but the disk analyzer keeps *everything* by default
+    (no ``min_size`` gate) because tiny files are exactly what the cruft and
+    empty-file detection want to see.
+    """
+
+    __slots__ = (
+        "roots",
+        "reference_roots",
+        "excluded_roots",
+        "include_ext",
+        "exclude_ext",
+        "include_globs",
+        "exclude_globs",
+        "min_size",
+        "max_size",
+        "follow_symlinks",
+    )
+
+    def __init__(
+        self,
+        roots,
+        reference_roots=None,
+        excluded_roots=None,
+        include_ext=None,
+        exclude_ext=None,
+        include_globs=None,
+        exclude_globs=None,
+        min_size=0,
+        max_size=0,
+        follow_symlinks=False,
+    ):
+        self.roots = [Path(p) for p in roots]
+        self.reference_roots = [Path(p) for p in (reference_roots or [])]
+        self.excluded_roots = [Path(p) for p in (excluded_roots or [])]
+        self.include_ext = {e.lower().lstrip(".") for e in (include_ext or [])}
+        self.exclude_ext = {e.lower().lstrip(".") for e in (exclude_ext or [])}
+        self.include_globs = list(include_globs or [])
+        self.exclude_globs = list(exclude_globs or [])
+        self.min_size = min_size
+        self.max_size = max_size
+        self.follow_symlinks = follow_symlinks
+
+    @classmethod
+    def from_dict(cls, data):
+        return cls(
+            roots=data.get("roots", data.get("paths", [])),
+            reference_roots=data.get("reference_roots", data.get("references", [])),
+            excluded_roots=data.get("excluded_roots", data.get("excludes", [])),
+            include_ext=data.get("include_ext"),
+            exclude_ext=data.get("exclude_ext"),
+            include_globs=data.get("include_globs"),
+            exclude_globs=data.get("exclude_globs"),
+            min_size=data.get("min_size", 0),
+            max_size=data.get("max_size", 0),
+            follow_symlinks=data.get("follow_symlinks", False),
+        )
+
+    @property
+    def primary_root(self):
+        """The root the usage tree is anchored at.
+
+        Every scanned file -- including files in reference roots that sit
+        outside the normal roots -- must live under the anchor, or the tree
+        would silently drop them. So the anchor is the common ancestor of *all*
+        roots the scan touches (normal + reference); for the common single-root
+        case it's just that root.
+        """
+        if not self.roots:
+            raise InvalidScanRootError("a scan needs at least one root")
+        all_roots = list(self.roots) + list(self.reference_roots)
+        if len(all_roots) == 1:
+            return all_roots[0]
+        # Common ancestor of all roots.
+        parts = [p.resolve().parts for p in all_roots]
+        common = []
+        for group in zip(*parts):
+            if all(g == group[0] for g in group):
+                common.append(group[0])
+            else:
+                break
+        if not common:
+            return Path(all_roots[0].anchor or "/")
+        return Path(*common)
+
+    def _name_allowed(self, name):
+        ext = Path(name).suffix.lower().lstrip(".")
+        if self.include_ext and ext not in self.include_ext:
+            return False
+        if self.exclude_ext and ext in self.exclude_ext:
+            return False
+        if self.include_globs and not any(fnmatch.fnmatch(name, g) for g in self.include_globs):
+            return False
+        if self.exclude_globs and any(fnmatch.fnmatch(name, g) for g in self.exclude_globs):
+            return False
+        return True
+
+    def _size_allowed(self, size):
+        if self.min_size and size < self.min_size:
+            return False
+        if self.max_size and size > self.max_size:
+            return False
+        return True
+
+
+class ScanResult:
+    """The raw output of a scan: entries plus the clock and root they share.
+
+    ``dirs`` is the set of directory paths visited during the walk (including
+    ones that held no files), so downstream tree-building can materialise empty
+    directories that a file-only view would miss.
+    """
+
+    def __init__(self, entries, ref_time, root, dirs=None):
+        self.entries = entries
+        self.ref_time = ref_time
+        self.root = Path(root)
+        self.dirs = list(dirs or [])
+
+    def __iter__(self):
+        return iter(self.entries)
+
+    def __len__(self):
+        return len(self.entries)
+
+    @property
+    def total_apparent(self):
+        return sum(e.apparent_size for e in self.entries)
+
+    @property
+    def total_allocated(self):
+        return sum(e.allocated_size for e in self.entries)
+
+
+class DiskScanner:
+    """Collects :class:`FileEntry` for a :class:`ScanSpec`."""
+
+    def __init__(self, spec, ref_time=None):
+        self.spec = spec
+        # Anchor time for age math. Supplied by the caller (the session captures
+        # ``time.time()`` once) so scans are reproducible in tests that pass a
+        # fixed clock.
+        self._ref_time = ref_time
+
+    def _build_directories(self):
+        dirs = Directories()
+        for root in self.spec.roots:
+            if not root.exists() or not root.is_dir():
+                raise InvalidScanRootError(f"scan root does not exist or is not a directory: {root}")
+            try:
+                dirs.add_path(root)
+            except InvalidPathError:
+                raise InvalidScanRootError(f"invalid scan root: {root}")
+        for ref in self.spec.reference_roots:
+            if not ref.exists() or not ref.is_dir():
+                raise InvalidScanRootError(f"reference root does not exist: {ref}")
+            if ref not in dirs:
+                try:
+                    dirs.add_path(ref)
+                except InvalidPathError:
+                    raise InvalidScanRootError(f"invalid reference root: {ref}")
+            dirs.set_state(ref, DirectoryState.REFERENCE)
+        for exc in self.spec.excluded_roots:
+            dirs.set_state(Path(exc), DirectoryState.EXCLUDED)
+        return dirs
+
+    def scan(self, ref_time=None, j=job.nulljob):
+        """Walk the spec's roots and return a :class:`ScanResult`.
+
+        ``ref_time`` overrides the scanner's construction-time clock for this
+        one call; if neither is set the entries are left un-anchored and any
+        age query on them must supply its own reference time.
+        """
+        anchor = ref_time if ref_time is not None else self._ref_time
+        dirs = self._build_directories()
+        entries = []
+        for file in dirs.get_files(fileclasses=[fs.File], j=j):
+            name = file.path.name
+            if not self.spec._name_allowed(name):
+                continue
+            if not self.spec._size_allowed(file.size):
+                continue
+            entry = FileEntry.from_file(
+                file,
+                ref_time=anchor,
+                is_reference=getattr(file, "is_ref", False),
+            )
+            entries.append(entry)
+        # Deterministic order regardless of directory iteration order.
+        entries.sort(key=lambda e: str(e.path))
+        visited_dirs = self._collect_dirs(dirs)
+        return ScanResult(
+            entries=entries,
+            ref_time=anchor,
+            root=self.spec.primary_root,
+            dirs=visited_dirs,
+        )
+
+    def _collect_dirs(self, dirs):
+        """Return every non-excluded directory under the scan roots.
+
+        We reuse the same ``Directories`` state map so an excluded subtree is
+        skipped here too, keeping the directory census consistent with the file
+        walk. Directories that held no files still show up -- which is exactly
+        what empty-directory detection needs.
+        """
+        found = []
+        seen = set()
+        for root in self.spec.roots:
+            for dirpath, dirnames, _filenames in os.walk(root):
+                current = Path(dirpath)
+                # Honour excluded state and dot-folder skipping the same way the
+                # file walk does: prune excluded / dot subdirectories in place.
+                kept = []
+                for name in dirnames:
+                    child = current / name
+                    if name.startswith("."):
+                        continue
+                    if dirs.get_state(child) == DirectoryState.EXCLUDED:
+                        continue
+                    kept.append(name)
+                dirnames[:] = kept
+                if dirs.get_state(current) == DirectoryState.EXCLUDED:
+                    continue
+                if current not in seen:
+                    seen.add(current)
+                    found.append(current)
+        return found
diff --git a/core/diskscan/session.py b/core/diskscan/session.py
new file mode 100644
index 00000000..9fb8a3b8
--- /dev/null
+++ b/core/diskscan/session.py
@@ -0,0 +1,110 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The high-level entry point tying scanning to reporting.
+
+:class:`DiskScanSession` is the thing most callers actually use: hand it a
+:class:`~core.diskscan.scanner.ScanSpec` (and optional knobs), call
+:meth:`analyze`, and get back a fully-assembled
+:class:`~core.diskscan.report.AnalysisReport`. It captures a single reference
+time at scan start (so every age in the report shares one clock), caches the
+result, and exposes :meth:`evaluate` to run a threshold set against the analysis.
+
+The session performs no file mutation of any kind -- it only reads. That keeps
+the disk analyzer squarely a *measurement* tool; anything that deletes lives in
+the reclaim / sweep packages.
+"""
+
+from __future__ import annotations
+
+import time
+
+from hscommon.jobprogress import job
+
+from .report import build_report
+from .scanner import DiskScanner, ScanSpec
+from .thresholds import ThresholdSet
+
+
+class DiskScanSession:
+    """Orchestrates scan -> report and holds the cached result."""
+
+    def __init__(
+        self,
+        spec,
+        age_ladder=None,
+        cruft_rules=None,
+        include_reference_cruft=False,
+        detect_duplicates=True,
+        duplicate_min_size=1,
+        duplicate_big_file_size=None,
+        clock=None,
+    ):
+        self.spec = spec
+        self.age_ladder = age_ladder
+        self.cruft_rules = cruft_rules
+        self.include_reference_cruft = include_reference_cruft
+        self.detect_duplicates = detect_duplicates
+        self.duplicate_min_size = duplicate_min_size
+        self.duplicate_big_file_size = duplicate_big_file_size
+        # Injectable clock keeps age math testable with a fixed "now".
+        self._clock = clock or time.time
+        self._report = None
+        self._scan_result = None
+
+    # --- Analysis -------------------------------------------------------------
+    def analyze(self, force=False, ref_time=None, j=job.nulljob):
+        """Scan the spec's roots and build the report, caching the result.
+
+        Pass ``force=True`` to re-scan (e.g. after files changed). ``ref_time``
+        overrides the session clock for this analysis, which is what tests use
+        to make ages deterministic.
+        """
+        if self._report is not None and not force:
+            return self._report
+        anchor = ref_time if ref_time is not None else float(self._clock())
+        scanner = DiskScanner(self.spec, ref_time=anchor)
+        scan_result = scanner.scan(ref_time=anchor, j=j)
+        report = build_report(
+            entries=scan_result.entries,
+            root=scan_result.root,
+            ref_time=anchor,
+            age_ladder=self.age_ladder,
+            cruft_rules=self.cruft_rules,
+            include_reference_cruft=self.include_reference_cruft,
+            duplicate_min_size=self.duplicate_min_size,
+            duplicate_big_file_size=self.duplicate_big_file_size,
+            detect_duplicates=self.detect_duplicates,
+            dirs=scan_result.dirs,
+        )
+        self._scan_result = scan_result
+        self._report = report
+        return report
+
+    @property
+    def report(self):
+        """The cached report, running :meth:`analyze` on first access."""
+        if self._report is None:
+            return self.analyze()
+        return self._report
+
+    def evaluate(self, thresholds, force=False):
+        """Run a :class:`~core.diskscan.thresholds.ThresholdSet` against the report.
+
+        Accepts either a ready :class:`ThresholdSet` or a bare iterable of
+        rules. Analyses first if needed so a caller can go straight from spec to
+        verdict.
+        """
+        report = self.analyze(force=force)
+        if not isinstance(thresholds, ThresholdSet):
+            thresholds = ThresholdSet(list(thresholds))
+        return thresholds.evaluate(report)
+
+    # --- Constructors ---------------------------------------------------------
+    @classmethod
+    def from_spec_dict(cls, data, **kwargs):
+        """Build a session from a plain dict describing the scan spec."""
+        return cls(ScanSpec.from_dict(data), **kwargs)
diff --git a/core/diskscan/thresholds.py b/core/diskscan/thresholds.py
new file mode 100644
index 00000000..a1fc0143
--- /dev/null
+++ b/core/diskscan/thresholds.py
@@ -0,0 +1,268 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Threshold rules: turning a scan into pass / warn / fail signals.
+
+A usage report is often consumed by something that wants a *decision*: "alert me
+if any single directory is over 10 GiB", "fail the check if reclaimable cruft
+exceeds 20% of the tree", "warn when there are more than 1000 empty files". This
+module lets a caller declare those rules and evaluate them against an
+:class:`~core.diskscan.report.AnalysisReport`, producing an ordered list of
+:class:`ThresholdBreach` with a severity.
+
+Rules are pure predicates over the analysis; they never mutate anything. The
+severity vocabulary is deliberately tiny (``info`` < ``warning`` < ``critical``)
+so the overall verdict is just "the worst breach that fired".
+"""
+
+from __future__ import annotations
+
+from .errors import DiskScanConfigError
+from .units import format_size, percent_of
+
+# Severity ladder, least to most severe.
+SEVERITY_INFO = "info"
+SEVERITY_WARNING = "warning"
+SEVERITY_CRITICAL = "critical"
+
+_SEVERITY_ORDER = {
+    SEVERITY_INFO: 10,
+    SEVERITY_WARNING: 20,
+    SEVERITY_CRITICAL: 30,
+}
+
+SEVERITIES = (SEVERITY_INFO, SEVERITY_WARNING, SEVERITY_CRITICAL)
+
+
+def severity_rank(severity):
+    if severity not in _SEVERITY_ORDER:
+        raise DiskScanConfigError(f"unknown severity: {severity!r}")
+    return _SEVERITY_ORDER[severity]
+
+
+class ThresholdBreach:
+    """A single fired rule: what tripped, by how much, how bad."""
+
+    __slots__ = ("name", "severity", "message", "observed", "limit")
+
+    def __init__(self, name, severity, message, observed, limit):
+        self.name = name
+        self.severity = severity
+        self.message = message
+        self.observed = observed
+        self.limit = limit
+
+    @property
+    def rank(self):
+        return severity_rank(self.severity)
+
+    def as_dict(self):
+        return {
+            "name": self.name,
+            "severity": self.severity,
+            "message": self.message,
+            "observed": self.observed,
+            "limit": self.limit,
+        }
+
+    def __repr__(self):
+        return f"<ThresholdBreach {self.severity} {self.name}>"
+
+
+class ThresholdRule:
+    """A named predicate over an analysis report.
+
+    ``metric`` is a callable ``(report) -> number`` extracting the observed
+    value; the rule fires when that value crosses ``limit`` in the configured
+    ``direction`` (``"above"`` or ``"below"``). ``format_value`` renders the
+    number for the message (bytes vs. count vs. percent).
+    """
+
+    __slots__ = ("name", "metric", "limit", "severity", "direction", "format_value", "description")
+
+    def __init__(
+        self,
+        name,
+        metric,
+        limit,
+        severity=SEVERITY_WARNING,
+        direction="above",
+        format_value=None,
+        description="",
+    ):
+        if direction not in ("above", "below"):
+            raise DiskScanConfigError(f"threshold direction must be 'above' or 'below', got {direction!r}")
+        severity_rank(severity)  # validate
+        self.name = name
+        self.metric = metric
+        self.limit = limit
+        self.severity = severity
+        self.direction = direction
+        self.format_value = format_value or (lambda v: str(v))
+        self.description = description
+
+    def _fires(self, observed):
+        if self.direction == "above":
+            return observed > self.limit
+        return observed < self.limit
+
+    def evaluate(self, report):
+        """Return a :class:`ThresholdBreach` if the rule fires, else ``None``."""
+        observed = self.metric(report)
+        if not self._fires(observed):
+            return None
+        rendered = self.format_value(observed)
+        rendered_limit = self.format_value(self.limit)
+        arrow = "exceeds" if self.direction == "above" else "is below"
+        message = self.description or f"{self.name}: {rendered} {arrow} {rendered_limit}"
+        return ThresholdBreach(
+            name=self.name,
+            severity=self.severity,
+            message=message,
+            observed=observed,
+            limit=self.limit,
+        )
+
+
+class ThresholdResult:
+    """The outcome of evaluating a rule set against a report."""
+
+    def __init__(self, breaches):
+        # Most severe first, then by name for stability.
+        self.breaches = sorted(breaches, key=lambda b: (-b.rank, b.name))
+
+    def __iter__(self):
+        return iter(self.breaches)
+
+    def __len__(self):
+        return len(self.breaches)
+
+    @property
+    def passed(self):
+        """True when nothing at ``warning`` or worse fired."""
+        return not any(b.rank >= _SEVERITY_ORDER[SEVERITY_WARNING] for b in self.breaches)
+
+    @property
+    def worst_severity(self):
+        """The highest severity that fired, or ``None`` when clean."""
+        if not self.breaches:
+            return None
+        return self.breaches[0].severity
+
+    def of_severity(self, severity):
+        return [b for b in self.breaches if b.severity == severity]
+
+    def as_dict(self):
+        return {
+            "passed": self.passed,
+            "worst_severity": self.worst_severity,
+            "breaches": [b.as_dict() for b in self.breaches],
+        }
+
+
+# --- Convenience metric builders ---------------------------------------------
+# These make the common rules read declaratively at call sites.
+def largest_hotspot_allocated(report):
+    hotspots = report.hotspots
+    return hotspots[0].total_allocated if hotspots else 0
+
+
+def cruft_fraction(report):
+    return percent_of(report.cruft.total_allocated, report.total_allocated)
+
+
+def duplicate_fraction(report):
+    return percent_of(report.duplicates.wasted_allocated, report.total_allocated)
+
+
+def empty_file_count(report):
+    return sum(1 for e in report.entries if e.is_empty)
+
+
+class ThresholdSet:
+    """A named, ordered collection of :class:`ThresholdRule`."""
+
+    def __init__(self, rules=None):
+        self.rules = list(rules or [])
+
+    def add(self, rule):
+        self.rules.append(rule)
+        return self
+
+    def evaluate(self, report):
+        breaches = []
+        for rule in self.rules:
+            breach = rule.evaluate(report)
+            if breach is not None:
+                breaches.append(breach)
+        return ThresholdResult(breaches)
+
+
+def default_thresholds(
+    max_total_allocated=None,
+    max_hotspot_allocated=None,
+    max_cruft_fraction=None,
+    max_duplicate_fraction=None,
+    max_empty_files=None,
+):
+    """Assemble a :class:`ThresholdSet` from a few common limits.
+
+    Only the limits you pass become rules, so a caller can enable just the
+    checks they care about. All are "above" checks at ``warning`` severity by
+    default; wrap or extend the set for finer control.
+    """
+    rules = []
+    if max_total_allocated is not None:
+        rules.append(
+            ThresholdRule(
+                "total-allocated",
+                metric=lambda r: r.total_allocated,
+                limit=max_total_allocated,
+                severity=SEVERITY_WARNING,
+                format_value=format_size,
+            )
+        )
+    if max_hotspot_allocated is not None:
+        rules.append(
+            ThresholdRule(
+                "hotspot-allocated",
+                metric=largest_hotspot_allocated,
+                limit=max_hotspot_allocated,
+                severity=SEVERITY_WARNING,
+                format_value=format_size,
+            )
+        )
+    if max_cruft_fraction is not None:
+        rules.append(
+            ThresholdRule(
+                "cruft-fraction",
+                metric=cruft_fraction,
+                limit=max_cruft_fraction,
+                severity=SEVERITY_WARNING,
+                format_value=lambda v: f"{v:.1f}%",
+            )
+        )
+    if max_duplicate_fraction is not None:
+        rules.append(
+            ThresholdRule(
+                "duplicate-fraction",
+                metric=duplicate_fraction,
+                limit=max_duplicate_fraction,
+                severity=SEVERITY_WARNING,
+                format_value=lambda v: f"{v:.1f}%",
+            )
+        )
+    if max_empty_files is not None:
+        rules.append(
+            ThresholdRule(
+                "empty-files",
+                metric=empty_file_count,
+                limit=max_empty_files,
+                severity=SEVERITY_INFO,
+                format_value=str,
+            )
+        )
+    return ThresholdSet(rules)
