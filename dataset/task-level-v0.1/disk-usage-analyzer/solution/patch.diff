index 00000000..6264f657
--- /dev/null
+++ b/core/diskscan/duplicates.py
@@ -0,0 +1,187 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Estimating the space wasted by byte-identical duplicates.
+
+A usage report is more actionable if it can say "of your 40 GiB, 6 GiB is
+literally the same bytes stored more than once". This module answers that by
+grouping the scanned entries by content -- reusing dupeGuru's staged digests
+from :mod:`core.fs` exactly the way its own content scan does (bucket by size,
+then cheap partial digest, then full/sampled digest) -- and reporting, per
+group, how many bytes could be reclaimed by keeping a single copy.
+
+This deliberately does *not* decide which copy to keep or delete anything: that
+is the reclaim planner's job. Here we only quantify "wasted" space so the disk
+report can surface it as a headline number.
+"""
+
+from __future__ import annotations
+
+from core import fs
+
+# Above this size we compare via sampled digests rather than a full read, which
+# matches dupeGuru's own big-file handling and keeps the scan affordable.
+DEFAULT_BIG_FILE_SIZE = 100 * 1024 * 1024  # 100 MiB
+
+
+class DuplicateSet:
+    """A set of entries whose contents are byte-identical.
+
+    ``wasted`` is the reclaimable space: every copy but one. Which copy is
+    "kept" is irrelevant to the figure -- they're the same size -- so we simply
+    charge ``(count - 1) * size``.
+    """
+
+    __slots__ = ("entries", "size", "allocated_each")
+
+    def __init__(self, entries):
+        # Sort for a stable representative and deterministic reporting.
+        self.entries = sorted(entries, key=lambda e: str(e.path))
+        self.size = self.entries[0].apparent_size
+        self.allocated_each = self.entries[0].allocated_size
+
+    @property
+    def count(self):
+        return len(self.entries)
+
+    @property
+    def representative(self):
+        return self.entries[0]
+
+    @property
+    def wasted_apparent(self):
+        return (self.count - 1) * self.size
+
+    @property
+    def wasted_allocated(self):
+        return (self.count - 1) * self.allocated_each
+
+    @property
+    def paths(self):
+        return [e.path for e in self.entries]
+
+    def as_dict(self):
+        return {
+            "size": self.size,
+            "count": self.count,
+            "wasted_apparent": self.wasted_apparent,
+            "wasted_allocated": self.wasted_allocated,
+            "paths": [str(p) for p in self.paths],
+        }
+
+    def __repr__(self):
+        return f"<DuplicateSet n={self.count} size={self.size} wasted={self.wasted_allocated}>"
+
+
+class DuplicateReport:
+    """All duplicate sets found in a scan, plus the headline waste figure."""
+
+    def __init__(self, sets):
+        # Heaviest waste first, size then representative path as tie-breaks.
+        self.sets = sorted(
+            sets,
+            key=lambda s: (-s.wasted_allocated, -s.size, str(s.representative.path)),
+        )
+
+    def __iter__(self):
+        return iter(self.sets)
+
+    def __len__(self):
+        return len(self.sets)
+
+    @property
+    def group_count(self):
+        return len(self.sets)
+
+    @property
+    def duplicate_count(self):
+        """Total number of redundant copies (excludes the one kept per set)."""
+        return sum(s.count - 1 for s in self.sets)
+
+    @property
+    def wasted_allocated(self):
+        return sum(s.wasted_allocated for s in self.sets)
+
+    @property
+    def wasted_apparent(self):
+        return sum(s.wasted_apparent for s in self.sets)
+
+    def as_dict(self):
+        return {
+            "group_count": self.group_count,
+            "duplicate_count": self.duplicate_count,
+            "wasted_allocated": self.wasted_allocated,
+            "wasted_apparent": self.wasted_apparent,
+            "sets": [s.as_dict() for s in self.sets],
+        }
+
+
+def _digest_for(entry, big_file_size):
+    """Full-content digest for an entry, sampled above ``big_file_size``.
+
+    Reuses the ``core.fs.File`` digest machinery so we share dupeGuru's cache
+    and its exact hashing; we never re-implement the read loop.
+    """
+    file = fs.get_file(entry.path)
+    if file is None:
+        return None
+    if big_file_size and entry.apparent_size > big_file_size:
+        return ("s", file.digest_samples)
+    return ("f", file.digest)
+
+
+def _partial_for(entry):
+    file = fs.get_file(entry.path)
+    if file is None:
+        return None
+    return file.digest_partial
+
+
+def find_duplicate_sets(entries, min_size=1, big_file_size=DEFAULT_BIG_FILE_SIZE):
+    """Group ``entries`` by identical content and return a :class:`DuplicateReport`.
+
+    Staged to minimise I/O, exactly like dupeGuru's own content scan:
+
+    1. bucket by apparent size (different size => can't be equal, no read);
+    2. within a size bucket, subdivide by the cheap **partial** digest;
+    3. within a partial bucket, subdivide by the full (or sampled) digest.
+
+    Entries smaller than ``min_size`` are ignored (a duplicated empty file
+    reclaims nothing and tiny files collide readily). Zero-size files are never
+    grouped regardless of ``min_size`` because "empty" isn't "duplicate data".
+    """
+    # Stage 1: size buckets.
+    by_size = {}
+    for entry in entries:
+        size = entry.apparent_size
+        if size < max(1, min_size):
+            continue
+        by_size.setdefault(size, []).append(entry)
+
+    sets = []
+    for size, bucket in by_size.items():
+        if len(bucket) < 2:
+            continue
+        # Stage 2: partial-digest sub-buckets.
+        by_partial = {}
+        for entry in bucket:
+            key = _partial_for(entry)
+            by_partial.setdefault(key, []).append(entry)
+        for partial_key, sub in by_partial.items():
+            if len(sub) < 2:
+                continue
+            # Stage 3: full/sampled-digest sub-buckets.
+            by_full = {}
+            for entry in sub:
+                key = _digest_for(entry, big_file_size)
+                by_full.setdefault(key, []).append(entry)
+            for full_key, group in by_full.items():
+                if full_key is None:
+                    continue
+                if len(group) < 2:
+                    continue
+                sets.append(DuplicateSet(group))
+    return DuplicateReport(sets)
diff --git a/core/diskscan/entry.py b/core/diskscan/entry.py
new file mode 100644
index 00000000..06529830
--- /dev/null
+++ b/core/diskscan/entry.py
@@ -0,0 +1,248 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The per-file record the analyzer works with.
+
+A :class:`FileEntry` is the atom of the whole analysis: one leaf file, with the
+few facts we care about (both size notions, its timestamps, its classification
+inputs) snapshotted at scan time. Everything downstream -- aggregation into a
+tree, breakdowns by extension / age, cruft detection, threshold checks -- reads
+these records and never touches the disk again. That separation is what makes
+the analysis reproducible and cheap to re-slice.
+
+Entries are built from :class:`core.fs.File` (reusing dupeGuru's file model and
+its lazy ``size`` / ``mtime`` reading) rather than from raw ``os.stat`` calls,
+so the analyzer stays layered on top of the existing ``core`` machinery. The
+one thing ``core.fs.File`` does *not* surface is the allocated (block) size, so
+we take a single ``stat`` for that and cache it on the entry.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from core import fs
+
+from .units import allocated_size_of
+
+
+class FileEntry:
+    """A single scanned file with its size / age facts snapshotted.
+
+    The entry is deliberately immutable-ish: all the disk-derived numbers are
+    read once at construction and then just read back. ``age_seconds`` and the
+    age-bucket assignment are computed relative to a *reference time* supplied
+    by the caller (usually "now" captured once at the start of a scan), so an
+    entire analysis shares one consistent clock instead of each file racing to
+    call ``time.time()`` at slightly different moments.
+    """
+
+    __slots__ = (
+        "path",
+        "apparent_size",
+        "allocated_size",
+        "mtime",
+        "atime",
+        "_ref_time",
+        "is_reference",
+    )
+
+    def __init__(
+        self,
+        path,
+        apparent_size,
+        allocated_size,
+        mtime,
+        atime=None,
+        ref_time=None,
+        is_reference=False,
+    ):
+        self.path = Path(path)
+        self.apparent_size = int(apparent_size)
+        self.allocated_size = int(allocated_size)
+        self.mtime = float(mtime)
+        self.atime = float(atime) if atime is not None else float(mtime)
+        # ``ref_time`` anchors every age computation. It may legitimately be
+        # None while an entry is being staged; consumers that need an age must
+        # supply it (see :meth:`with_ref_time`).
+        self._ref_time = float(ref_time) if ref_time is not None else None
+        self.is_reference = bool(is_reference)
+
+    # --- Construction helpers -------------------------------------------------
+    @classmethod
+    def from_file(cls, file, ref_time=None, is_reference=False):
+        """Build an entry from a :class:`core.fs.File`.
+
+        We lean on ``core.fs`` for the apparent size and mtime (it already reads
+        and caches them lazily), and take exactly one extra ``stat`` for the
+        allocated size and atime, which the file model doesn't expose.
+        """
+        path = Path(file.path)
+        apparent = int(file.size)
+        mtime = float(file.mtime)
+        atime = mtime
+        allocated = apparent
+        try:
+            st = path.stat()
+            allocated = allocated_size_of(st)
+            atime = float(st.st_atime)
+            # Prefer the freshly-stat'd figures; they and ``file.size`` agree in
+            # practice, but the direct stat is the authoritative allocated read.
+            apparent = int(st.st_size)
+            mtime = float(st.st_mtime)
+        except OSError:
+            # A file that vanished between the directory walk and now: keep the
+            # figures the file model already gave us rather than exploding.
+            pass
+        return cls(
+            path=path,
+            apparent_size=apparent,
+            allocated_size=allocated,
+            mtime=mtime,
+            atime=atime,
+            ref_time=ref_time,
+            is_reference=is_reference,
+        )
+
+    @classmethod
+    def from_path(cls, path, ref_time=None, is_reference=False):
+        """Build an entry straight from a filesystem path.
+
+        A thin convenience around :meth:`from_file` that wraps the path in the
+        ``core.fs`` file model first, so the same layered code path is used.
+        """
+        path = Path(path)
+        file = fs.get_file(path)
+        if file is None:
+            # Not a plain file (symlink, socket, ...). Still produce an entry so
+            # the caller can decide -- but based on a raw stat, no file model.
+            st = path.stat()
+            return cls(
+                path=path,
+                apparent_size=int(st.st_size),
+                allocated_size=allocated_size_of(st),
+                mtime=float(st.st_mtime),
+                atime=float(st.st_atime),
+                ref_time=ref_time,
+                is_reference=is_reference,
+            )
+        return cls.from_file(file, ref_time=ref_time, is_reference=is_reference)
+
+    def with_ref_time(self, ref_time):
+        """Return a copy of this entry anchored to a new reference time.
+
+        Entries are cheap; rather than mutate the shared clock in place we hand
+        back a fresh entry, which keeps aggregation code free of aliasing
+        surprises.
+        """
+        return FileEntry(
+            path=self.path,
+            apparent_size=self.apparent_size,
+            allocated_size=self.allocated_size,
+            mtime=self.mtime,
+            atime=self.atime,
+            ref_time=ref_time,
+            is_reference=self.is_reference,
+        )
+
+    # --- Derived facts --------------------------------------------------------
+    @property
+    def name(self):
+        return self.path.name
+
+    @property
+    def stem(self):
+        return self.path.stem
+
+    @property
+    def extension(self):
+        """Lower-cased extension without the leading dot (``""`` if none).
+
+        Mirrors the spelling used elsewhere in the disk tooling so per-extension
+        breakdowns line up regardless of how the file was cased on disk.
+        """
+        suffix = self.path.suffix
+        if not suffix:
+            return ""
+        return suffix.lower().lstrip(".")
+
+    @property
+    def parent(self):
+        return self.path.parent
+
+    @property
+    def slack_bytes(self):
+        """Bytes the file occupies on disk beyond its logical length.
+
+        Positive for the common case (a small file rounded up to a block),
+        clamped at zero for sparse files whose allocation is *smaller* than
+        their apparent size -- "slack" is never negative in the report.
+        """
+        return max(0, self.allocated_size - self.apparent_size)
+
+    @property
+    def is_sparse(self):
+        """True when the file is allocated fewer bytes than it logically spans."""
+        return self.allocated_size < self.apparent_size
+
+    @property
+    def is_empty(self):
+        """True for a zero-length file."""
+        return self.apparent_size == 0
+
+    @property
+    def ref_time(self):
+        return self._ref_time
+
+    def age_seconds(self, ref_time=None):
+        """Seconds since the file was last modified.
+
+        Uses the explicit ``ref_time`` argument if given, else the entry's own
+        anchored reference time. Raises if neither is available -- an age with
+        no clock is a programming error, not a silent zero.
+        """
+        anchor = ref_time if ref_time is not None else self._ref_time
+        if anchor is None:
+            raise ValueError("age_seconds requires a reference time")
+        return max(0.0, float(anchor) - self.mtime)
+
+    def idle_seconds(self, ref_time=None):
+        """Seconds since the file was last *accessed* (read or written)."""
+        anchor = ref_time if ref_time is not None else self._ref_time
+        if anchor is None:
+            raise ValueError("idle_seconds requires a reference time")
+        return max(0.0, float(anchor) - self.atime)
+
+    # --- Dict / equality ------------------------------------------------------
+    def as_dict(self):
+        d = {
+            "path": str(self.path),
+            "name": self.name,
+            "extension": self.extension,
+            "apparent_size": self.apparent_size,
+            "allocated_size": self.allocated_size,
+            "slack_bytes": self.slack_bytes,
+            "mtime": self.mtime,
+            "atime": self.atime,
+            "is_reference": self.is_reference,
+            "is_empty": self.is_empty,
+            "is_sparse": self.is_sparse,
+        }
+        if self._ref_time is not None:
+            d["age_seconds"] = self.age_seconds()
+        return d
+
+    def __eq__(self, other):
+        if not isinstance(other, FileEntry):
+            return NotImplemented
+        return self.path == other.path
+
+    def __hash__(self):
+        return hash(self.path)
+
+    def __repr__(self):
+        return f"<FileEntry {str(self.path)} {self.allocated_size}b>"
