index 00000000..8aab5575
--- /dev/null
+++ b/core/diskscan/tree.py
@@ -0,0 +1,357 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The directory-usage tree.
+
+The heart of the analyzer is a tree of :class:`UsageNode` objects mirroring the
+directory hierarchy under a scan root. Each node knows:
+
+* its **own** contribution (files directly inside that directory), and
+* its **subtree** totals (itself plus everything beneath it),
+
+for both size notions (apparent and allocated), plus file / directory counts.
+Totals roll up from the leaves so a parent's subtree size is exactly the sum of
+its children's subtree sizes plus its own direct files -- which is what makes
+"which directory is eating my disk" answerable at a glance.
+
+The tree is built by :meth:`UsageTree.from_entries` from a flat list of
+:class:`core.diskscan.entry.FileEntry`, so the same walk output can feed the
+tree, the extension breakdown, the cruft scan, etc. without re-touching disk.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from .units import percent_of
+
+
+class UsageNode:
+    """A directory in the usage tree.
+
+    ``direct_*`` figures cover files sitting immediately in this directory;
+    ``total_*`` figures (properties) cover the whole subtree rooted here. Empty
+    directories are represented too -- an interior node with no direct files and
+    no children is exactly a leaf empty directory, which the cruft scan cares
+    about.
+    """
+
+    __slots__ = (
+        "path",
+        "name",
+        "_children",
+        "direct_files",
+        "direct_apparent",
+        "direct_allocated",
+        "_total_apparent",
+        "_total_allocated",
+        "_total_files",
+        "_total_dirs",
+        "_totals_valid",
+    )
+
+    def __init__(self, path):
+        self.path = Path(path)
+        self.name = self.path.name or str(self.path)
+        self._children = {}  # name -> UsageNode
+        self.direct_files = []  # FileEntry directly in this dir
+        self.direct_apparent = 0
+        self.direct_allocated = 0
+        # Cached subtree totals; invalidated whenever the subtree changes.
+        self._total_apparent = 0
+        self._total_allocated = 0
+        self._total_files = 0
+        self._total_dirs = 0
+        self._totals_valid = False
+
+    # --- Mutation (build time) ------------------------------------------------
+    def child(self, name):
+        """Return the child node named ``name``, creating it if needed."""
+        node = self._children.get(name)
+        if node is None:
+            node = UsageNode(self.path / name)
+            self._children[name] = node
+            self._totals_valid = False
+        return node
+
+    def add_direct_file(self, entry):
+        """Attach a file that lives directly in this directory."""
+        self.direct_files.append(entry)
+        self.direct_apparent += entry.apparent_size
+        self.direct_allocated += entry.allocated_size
+        self._invalidate_up_to_root_hint()
+
+    def _invalidate_up_to_root_hint(self):
+        # We don't hold a parent pointer (keeps the node cheap and avoids
+        # cycles); instead the whole-tree recompute is driven from the root
+        # after building. This just marks the local cache dirty.
+        self._totals_valid = False
+
+    # --- Totals ---------------------------------------------------------------
+    def recompute(self):
+        """Recompute subtree totals bottom-up and return this node's totals.
+
+        Called once on the root after the tree is fully built. It's a plain
+        post-order fold: a node's totals are its direct files plus the sum of
+        its recomputed children.
+        """
+        total_apparent = self.direct_apparent
+        total_allocated = self.direct_allocated
+        total_files = len(self.direct_files)
+        total_dirs = 0
+        for child in self._children.values():
+            child.recompute()
+            total_apparent += child._total_apparent
+            total_allocated += child._total_allocated
+            total_files += child._total_files
+            # each child is itself a directory, plus whatever dirs it contains
+            total_dirs += 1 + child._total_dirs
+        self._total_apparent = total_apparent
+        self._total_allocated = total_allocated
+        self._total_files = total_files
+        self._total_dirs = total_dirs
+        self._totals_valid = True
+        return self
+
+    def _ensure_totals(self):
+        if not self._totals_valid:
+            self.recompute()
+
+    @property
+    def children(self):
+        """Child nodes sorted by descending subtree allocated size (stable).
+
+        The dominant consumer wants "biggest first"; ties break on name so the
+        order is deterministic regardless of insertion order.
+        """
+        self._ensure_totals()
+        return sorted(
+            self._children.values(),
+            key=lambda n: (-n.total_allocated, n.name),
+        )
+
+    @property
+    def children_by_name(self):
+        return dict(self._children)
+
+    @property
+    def total_apparent(self):
+        self._ensure_totals()
+        return self._total_apparent
+
+    @property
+    def total_allocated(self):
+        self._ensure_totals()
+        return self._total_allocated
+
+    @property
+    def total_files(self):
+        self._ensure_totals()
+        return self._total_files
+
+    @property
+    def total_dirs(self):
+        self._ensure_totals()
+        return self._total_dirs
+
+    @property
+    def is_leaf(self):
+        return not self._children
+
+    @property
+    def is_empty_dir(self):
+        """True when this directory holds no files anywhere in its subtree."""
+        return self.total_files == 0
+
+    def fraction_of(self, whole_allocated):
+        """This subtree's allocated size as a percentage of ``whole_allocated``."""
+        return percent_of(self.total_allocated, whole_allocated)
+
+    # --- Traversal ------------------------------------------------------------
+    def walk(self):
+        """Yield this node then every descendant (pre-order, biggest first)."""
+        yield self
+        for child in self.children:
+            yield from child.walk()
+
+    def iter_files(self):
+        """Yield every :class:`FileEntry` in this subtree."""
+        for entry in self.direct_files:
+            yield entry
+        for child in self._children.values():
+            yield from child.iter_files()
+
+    def find(self, path):
+        """Return the node at ``path`` within this subtree, or ``None``.
+
+        ``path`` must be at or below this node's path.
+        """
+        path = Path(path)
+        if path == self.path:
+            return self
+        try:
+            rel = path.relative_to(self.path)
+        except ValueError:
+            return None
+        node = self
+        for part in rel.parts:
+            node = node._children.get(part)
+            if node is None:
+                return None
+        return node
+
+    def as_dict(self, max_depth=None, min_fraction=0.0, whole_allocated=None):
+        """Serialise the subtree to nested dicts.
+
+        ``max_depth`` prunes below a certain depth (the pruned node still
+        reports its totals, just not its children). ``min_fraction`` drops
+        children whose share of ``whole_allocated`` is below the threshold, so a
+        report can hide the long tail of tiny directories.
+        """
+        self._ensure_totals()
+        if whole_allocated is None:
+            whole_allocated = self._total_allocated
+        node = {
+            "path": str(self.path),
+            "name": self.name,
+            "total_apparent": self._total_apparent,
+            "total_allocated": self._total_allocated,
+            "direct_apparent": self.direct_apparent,
+            "direct_allocated": self.direct_allocated,
+            "total_files": self._total_files,
+            "total_dirs": self._total_dirs,
+            "fraction": percent_of(self._total_allocated, whole_allocated),
+        }
+        if max_depth is not None and max_depth <= 0:
+            return node
+        children = []
+        for child in self.children:
+            if percent_of(child.total_allocated, whole_allocated) < min_fraction:
+                continue
+            children.append(
+                child.as_dict(
+                    max_depth=None if max_depth is None else max_depth - 1,
+                    min_fraction=min_fraction,
+                    whole_allocated=whole_allocated,
+                )
+            )
+        if children:
+            node["children"] = children
+        return node
+
+    def __repr__(self):
+        return f"<UsageNode {str(self.path)} files={len(self.direct_files)}>"
+
+
+class UsageTree:
+    """A rooted directory-usage tree plus the flat entry list it was built from.
+
+    Keeping the flat ``entries`` alongside the ``root`` node means downstream
+    slicing (by extension, by age, cruft, duplicates) can iterate the flat list
+    without re-walking the tree, while size-by-directory questions use the tree.
+    """
+
+    def __init__(self, root, entries):
+        self.root = root
+        self.entries = entries
+
+    @classmethod
+    def from_entries(cls, root_path, entries, dirs=None):
+        """Build a tree rooted at ``root_path`` from a flat entry list.
+
+        Every entry must live at or below ``root_path``. Intermediate
+        directories are materialised on demand, so a file three levels down
+        creates the two directories above it even if they held nothing else.
+
+        ``dirs`` is an optional iterable of directory paths visited during the
+        scan; materialising them lets the tree represent directories that held
+        no files at all (empty-directory detection depends on this -- a
+        file-only build can't know an empty directory exists).
+        """
+        root_path = Path(root_path)
+        root = UsageNode(root_path)
+        entries = list(entries)
+        for entry in entries:
+            try:
+                rel = entry.path.parent.relative_to(root_path)
+            except ValueError:
+                # Entry outside the root: skip rather than corrupt the tree.
+                continue
+            node = root
+            for part in rel.parts:
+                node = node.child(part)
+            node.add_direct_file(entry)
+        for dirpath in dirs or []:
+            dirpath = Path(dirpath)
+            if dirpath == root_path:
+                continue
+            try:
+                rel = dirpath.relative_to(root_path)
+            except ValueError:
+                continue
+            node = root
+            for part in rel.parts:
+                node = node.child(part)
+        root.recompute()
+        return cls(root=root, entries=entries)
+
+    @property
+    def total_allocated(self):
+        return self.root.total_allocated
+
+    @property
+    def total_apparent(self):
+        return self.root.total_apparent
+
+    @property
+    def total_files(self):
+        return self.root.total_files
+
+    @property
+    def total_dirs(self):
+        return self.root.total_dirs
+
+    def node_at(self, path):
+        return self.root.find(path)
+
+    def hotspots(self, limit=10, min_fraction=0.0):
+        """Return the ``limit`` heaviest directories, biggest allocated first.
+
+        A "hotspot" is any directory node (excluding the root itself) whose
+        subtree accounts for at least ``min_fraction`` percent of the total.
+        The list is sorted by descending allocated size with name as the
+        tie-breaker, so it's stable across runs.
+        """
+        whole = self.total_allocated
+        candidates = []
+        for node in self.root.walk():
+            if node is self.root:
+                continue
+            if percent_of(node.total_allocated, whole) < min_fraction:
+                continue
+            candidates.append(node)
+        candidates.sort(key=lambda n: (-n.total_allocated, str(n.path)))
+        if limit is not None:
+            candidates = candidates[:limit]
+        return candidates
+
+    def largest_files(self, limit=10):
+        """Return the ``limit`` largest individual files by allocated size."""
+        entries = sorted(
+            self.entries,
+            key=lambda e: (-e.allocated_size, str(e.path)),
+        )
+        if limit is not None:
+            entries = entries[:limit]
+        return entries
+
+    def empty_dirs(self):
+        """Return every directory node whose entire subtree holds no files.
+
+        The root is included when the whole tree is empty. ``walk`` already
+        yields nodes in a deterministic order, so no extra sorting is needed.
+        """
+        return [node for node in self.root.walk() if node.is_empty_dir]
diff --git a/core/diskscan/units.py b/core/diskscan/units.py
new file mode 100644
index 00000000..fbf81ea6
--- /dev/null
+++ b/core/diskscan/units.py
@@ -0,0 +1,105 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Small value helpers shared across the disk-usage analyzer.
+
+The analyzer speaks in two different notions of "how big is this":
+
+* **apparent size** -- the logical length of a file, i.e. ``st_size``. This is
+  the number you get from ``ls -l`` and what most people mean by "file size".
+* **allocated size** -- the number of bytes the file actually occupies on the
+  block device, i.e. ``st_blocks * 512``. A one-byte file still consumes a full
+  filesystem block, and sparse files occupy *less* than their apparent size.
+  When you want to know how much space you'd get *back* by deleting something,
+  this is the honest number.
+
+This module also owns the age-bucketing vocabulary (how we slice files by "how
+long since they were last touched") and a couple of tiny formatting helpers so
+the textual report doesn't have to reinvent them.
+"""
+
+from __future__ import annotations
+
+# A filesystem block, for the purpose of turning ``st_blocks`` into bytes, is
+# always 512 bytes regardless of the actual block size of the device -- this is
+# a POSIX contract, not the ``st_blksize`` value.
+STAT_BLOCK_SIZE = 512
+
+# Binary size unit ladder, smallest first.
+_SIZE_UNITS = ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
+
+# Seconds in the calendar spans we care about. We deliberately use fixed-length
+# approximations (30-day months, 365-day years); the analyzer is about
+# ball-parking where the space went, not about calendar precision.
+SECONDS_PER_MINUTE = 60
+SECONDS_PER_HOUR = 60 * SECONDS_PER_MINUTE
+SECONDS_PER_DAY = 24 * SECONDS_PER_HOUR
+SECONDS_PER_WEEK = 7 * SECONDS_PER_DAY
+SECONDS_PER_MONTH = 30 * SECONDS_PER_DAY
+SECONDS_PER_YEAR = 365 * SECONDS_PER_DAY
+
+
+def blocks_to_bytes(st_blocks: int) -> int:
+    """Turn a ``stat`` ``st_blocks`` count into a byte figure.
+
+    ``st_blocks`` counts 512-byte units by POSIX definition, so this is just a
+    multiply -- but giving it a name keeps the intent legible at call sites and
+    guards the one place the magic constant lives.
+    """
+    if st_blocks is None or st_blocks < 0:
+        return 0
+    return int(st_blocks) * STAT_BLOCK_SIZE
+
+
+def allocated_size_of(stat_result) -> int:
+    """Best-effort allocated size for an ``os.stat_result``.
+
+    On platforms that expose ``st_blocks`` (every POSIX system) we use it. On
+    the odd platform that doesn't, we fall back to the apparent size so callers
+    always get *some* sensible figure rather than a crash.
+    """
+    st_blocks = getattr(stat_result, "st_blocks", None)
+    if st_blocks is None:
+        return int(getattr(stat_result, "st_size", 0) or 0)
+    return blocks_to_bytes(st_blocks)
+
+
+def format_size(size: int, binary: bool = True, precision: int = 1) -> str:
+    """Render a byte count as a short human string, e.g. ``"1.5 MiB"``.
+
+    This is intentionally independent of ``hscommon.util.format_size`` because
+    we want the binary (1024) ladder and a stable, dependency-free spelling in
+    the report. ``size`` is clamped at zero -- negative sizes are meaningless
+    here and only ever arise from bad callers.
+    """
+    if size is None:
+        size = 0
+    size = max(0, int(size))
+    if size < 1024:
+        return f"{size} B"
+    value = float(size)
+    step = 1024.0 if binary else 1000.0
+    unit_index = 0
+    while value >= step and unit_index < len(_SIZE_UNITS) - 1:
+        value /= step
+        unit_index += 1
+    return f"{value:.{precision}f} {_SIZE_UNITS[unit_index]}"
+
+
+def format_count(count: int) -> str:
+    """Render an integer with thousands separators (``"12,345"``)."""
+    return f"{int(count):,}"
+
+
+def percent_of(part: int, whole: int, precision: int = 1) -> float:
+    """Return ``part`` as a percentage of ``whole``.
+
+    Guards against a zero (or negative) denominator by returning ``0.0`` -- a
+    breakdown of an empty tree is legitimately "0% of nothing".
+    """
+    if not whole or whole <= 0:
+        return 0.0
+    return round(part * 100.0 / whole, precision)
