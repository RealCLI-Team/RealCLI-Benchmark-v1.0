diff --git a/core/diskscan/ages.py b/core/diskscan/ages.py
new file mode 100644
index 00000000..9723974d
--- /dev/null
+++ b/core/diskscan/ages.py
@@ -0,0 +1,138 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Age bucketing: slicing files by "how long since they were touched".
+
+A big part of "where did my space go" is *when* it went there: 40 GiB of files
+nobody has modified in over a year is a very different story from 40 GiB written
+this week. This module turns a continuous age (in seconds) into a small, ordered
+set of named buckets so the report can say things like "31% of your space is in
+files older than a year".
+
+The default ladder is deliberately coarse and human-legible. Callers who want a
+different granularity build their own :class:`AgeLadder` from a list of
+(label, max_age_seconds) cut-offs; the last bucket always catches "everything
+older", so the ladder is total -- every age lands in exactly one bucket.
+"""
+
+from __future__ import annotations
+
+from .units import (
+    SECONDS_PER_DAY,
+    SECONDS_PER_MONTH,
+    SECONDS_PER_WEEK,
+    SECONDS_PER_YEAR,
+)
+
+
+class AgeBucket:
+    """One named age range ``[lower, upper)`` in seconds.
+
+    ``upper`` may be ``None`` to mean "and everything older" -- the open-ended
+    final bucket. Buckets don't hold files themselves; they're just the labelled
+    ranges. The aggregation code (see :mod:`core.diskscan.breakdown`) tallies
+    entries into them.
+    """
+
+    __slots__ = ("label", "lower", "upper")
+
+    def __init__(self, label, lower, upper):
+        self.label = label
+        self.lower = float(lower)
+        self.upper = float(upper) if upper is not None else None
+
+    def contains(self, age_seconds):
+        """True if ``age_seconds`` falls in ``[lower, upper)``."""
+        if age_seconds < self.lower:
+            return False
+        if self.upper is None:
+            return True
+        return age_seconds < self.upper
+
+    def __repr__(self):
+        upper = "inf" if self.upper is None else f"{self.upper:g}"
+        return f"<AgeBucket {self.label} [{self.lower:g},{upper})>"
+
+    def __eq__(self, other):
+        if not isinstance(other, AgeBucket):
+            return NotImplemented
+        return (self.label, self.lower, self.upper) == (other.label, other.lower, other.upper)
+
+    def __hash__(self):
+        return hash((self.label, self.lower, self.upper))
+
+
+class AgeLadder:
+    """An ordered, total set of :class:`AgeBucket` ranges.
+
+    Built from a list of ``(label, max_age_seconds)`` cut-offs sorted youngest
+    first; the final cut-off's ``max_age_seconds`` must be ``None`` (the
+    catch-all). ``bucket_for(age)`` returns the single bucket an age lands in,
+    and it's guaranteed to always find one.
+    """
+
+    def __init__(self, cutoffs):
+        cutoffs = list(cutoffs)
+        if not cutoffs:
+            raise ValueError("an age ladder needs at least one bucket")
+        buckets = []
+        lower = 0.0
+        for index, (label, upper) in enumerate(cutoffs):
+            is_last = index == len(cutoffs) - 1
+            if upper is None and not is_last:
+                raise ValueError("only the final age bucket may be open-ended")
+            if upper is not None and not is_last:
+                if upper <= lower:
+                    raise ValueError("age ladder cut-offs must strictly increase")
+            buckets.append(AgeBucket(label, lower, upper))
+            lower = upper if upper is not None else lower
+        if buckets[-1].upper is not None:
+            raise ValueError("the final age bucket must be open-ended (max_age=None)")
+        self.buckets = buckets
+
+    def __iter__(self):
+        return iter(self.buckets)
+
+    def __len__(self):
+        return len(self.buckets)
+
+    @property
+    def labels(self):
+        return [b.label for b in self.buckets]
+
+    def bucket_for(self, age_seconds):
+        """Return the bucket ``age_seconds`` lands in.
+
+        Ages are clamped at zero first (a file mtime in the future -- clock
+        skew, a bad archive -- reads as "brand new" rather than negative).
+        """
+        age = max(0.0, float(age_seconds))
+        for bucket in self.buckets:
+            if bucket.contains(age):
+                return bucket
+        # The ladder is total, so this is unreachable; return the oldest bucket
+        # defensively rather than None.
+        return self.buckets[-1]
+
+    def label_for(self, age_seconds):
+        return self.bucket_for(age_seconds).label
+
+
+# The default ladder used when a scan doesn't ask for a custom one. Youngest
+# first, ending in the open-ended "older than a year" catch-all.
+DEFAULT_AGE_CUTOFFS = [
+    ("day", SECONDS_PER_DAY),
+    ("week", SECONDS_PER_WEEK),
+    ("month", SECONDS_PER_MONTH),
+    ("quarter", 3 * SECONDS_PER_MONTH),
+    ("year", SECONDS_PER_YEAR),
+    ("older", None),
+]
+
+
+def default_age_ladder():
+    """Return a fresh copy of the default age ladder."""
+    return AgeLadder(DEFAULT_AGE_CUTOFFS)
diff --git a/core/diskscan/breakdown.py b/core/diskscan/breakdown.py
new file mode 100644
index 00000000..cf2f25de
--- /dev/null
+++ b/core/diskscan/breakdown.py
@@ -0,0 +1,201 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Cross-cutting breakdowns of a scan: by extension and by age.
+
+Where :mod:`core.diskscan.tree` answers "*which directory* holds the space",
+these breakdowns answer "*what kind* of thing holds the space" and "*how old* is
+the thing holding the space". Both are simple tallies over the flat entry list,
+producing an ordered table of :class:`BreakdownRow` where each row carries a
+count and both size notions, sorted heaviest-first for the report.
+"""
+
+from __future__ import annotations
+
+from .ages import default_age_ladder
+from .units import percent_of
+
+
+class BreakdownRow:
+    """One line of a breakdown table: a key plus its tallied totals."""
+
+    __slots__ = ("key", "count", "apparent", "allocated")
+
+    def __init__(self, key, count=0, apparent=0, allocated=0):
+        self.key = key
+        self.count = count
+        self.apparent = apparent
+        self.allocated = allocated
+
+    def add(self, entry):
+        self.count += 1
+        self.apparent += entry.apparent_size
+        self.allocated += entry.allocated_size
+
+    def as_dict(self, whole_allocated=None):
+        d = {
+            "key": self.key,
+            "count": self.count,
+            "apparent": self.apparent,
+            "allocated": self.allocated,
+        }
+        if whole_allocated is not None:
+            d["fraction"] = percent_of(self.allocated, whole_allocated)
+        return d
+
+    def __repr__(self):
+        return f"<BreakdownRow {self.key!r} n={self.count} alloc={self.allocated}>"
+
+    def __eq__(self, other):
+        if not isinstance(other, BreakdownRow):
+            return NotImplemented
+        return (self.key, self.count, self.apparent, self.allocated) == (
+            other.key,
+            other.count,
+            other.apparent,
+            other.allocated,
+        )
+
+    def __hash__(self):
+        return hash((self.key, self.count, self.apparent, self.allocated))
+
+
+class Breakdown:
+    """An ordered collection of :class:`BreakdownRow` with lookup helpers."""
+
+    def __init__(self, dimension, rows):
+        self.dimension = dimension
+        self.rows = list(rows)
+
+    def __iter__(self):
+        return iter(self.rows)
+
+    def __len__(self):
+        return len(self.rows)
+
+    def __getitem__(self, index):
+        return self.rows[index]
+
+    @property
+    def total_allocated(self):
+        return sum(r.allocated for r in self.rows)
+
+    @property
+    def total_apparent(self):
+        return sum(r.apparent for r in self.rows)
+
+    @property
+    def total_count(self):
+        return sum(r.count for r in self.rows)
+
+    def row_for(self, key):
+        """Return the row with the given key, or ``None``."""
+        for row in self.rows:
+            if row.key == key:
+                return row
+        return None
+
+    def top(self, limit):
+        """Return a new breakdown holding only the ``limit`` heaviest rows.
+
+        Any rows beyond the cut are folded into a single trailing
+        ``"(other)"`` row so the totals still add up -- silent truncation would
+        make the percentages lie.
+        """
+        if limit is None or limit >= len(self.rows):
+            return Breakdown(self.dimension, list(self.rows))
+        kept = self.rows[:limit]
+        rest = self.rows[limit:]
+        if rest:
+            other = BreakdownRow("(other)")
+            for row in rest:
+                other.count += row.count
+                other.apparent += row.apparent
+                other.allocated += row.allocated
+            kept = kept + [other]
+        return Breakdown(self.dimension, kept)
+
+    def as_dict(self):
+        whole = self.total_allocated
+        return {
+            "dimension": self.dimension,
+            "total_allocated": whole,
+            "total_apparent": self.total_apparent,
+            "total_count": self.total_count,
+            "rows": [r.as_dict(whole_allocated=whole) for r in self.rows],
+        }
+
+
+def _sorted_rows(row_map):
+    """Order rows heaviest allocated first, key as the stable tie-break."""
+    return sorted(row_map.values(), key=lambda r: (-r.allocated, str(r.key)))
+
+
+def breakdown_by_extension(entries, empty_key="(none)"):
+    """Tally entries by file extension.
+
+    Files with no extension collapse into a single ``empty_key`` row so they
+    don't scatter. Rows come back heaviest-first.
+    """
+    rows = {}
+    for entry in entries:
+        key = entry.extension or empty_key
+        row = rows.get(key)
+        if row is None:
+            row = BreakdownRow(key)
+            rows[key] = row
+        row.add(entry)
+    return Breakdown("extension", _sorted_rows(rows))
+
+
+def breakdown_by_age(entries, ref_time, ladder=None):
+    """Tally entries into age buckets.
+
+    ``ref_time`` anchors the age computation (one clock for the whole table).
+    Buckets are emitted in ladder order (youngest first) *not* size order,
+    because an age table reads naturally as a timeline; callers who want it
+    sorted by size can re-sort the rows.
+    """
+    if ladder is None:
+        ladder = default_age_ladder()
+    # Preserve ladder order and guarantee every bucket appears even if empty.
+    rows = {bucket.label: BreakdownRow(bucket.label) for bucket in ladder}
+    for entry in entries:
+        age = entry.age_seconds(ref_time)
+        label = ladder.label_for(age)
+        rows[label].add(entry)
+    ordered = [rows[bucket.label] for bucket in ladder]
+    return Breakdown("age", ordered)
+
+
+def breakdown_by_top_directory(tree, depth=1):
+    """Tally allocated usage by the directory ``depth`` levels below the root.
+
+    Handy for a "which top-level folder" summary. ``depth=1`` groups by the
+    immediate children of the root. Files sitting above ``depth`` (directly in
+    the root) collapse into a ``"(root)"`` row.
+    """
+    root = tree.root
+    rows = {}
+
+    def key_for(entry):
+        try:
+            rel = entry.path.parent.relative_to(root.path)
+        except ValueError:
+            return "(root)"
+        parts = rel.parts[:depth]
+        if not parts:
+            return "(root)"
+        return "/".join(parts)
+
+    for entry in tree.entries:
+        key = key_for(entry)
+        row = rows.get(key)
+        if row is None:
+            row = BreakdownRow(key)
+            rows[key] = row
+        row.add(entry)
+    return Breakdown("top_directory", _sorted_rows(rows))
diff --git a/core/diskscan/cruft.py b/core/diskscan/cruft.py
new file mode 100644
index 00000000..d7ededf3
--- /dev/null
+++ b/core/diskscan/cruft.py
@@ -0,0 +1,303 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Cruft classification: flagging files that are *probably* reclaimable.
+
+"Cruft" here means files that, by name / size / location, look like waste rather
+than data you meant to keep: zero-byte files, editor and OS junk
+(``.DS_Store``, ``Thumbs.db``, ``*.tmp``, ``*~``), build / cache artefacts
+(``__pycache__``, ``node_modules``, ``.o`` / ``.pyc``), and log files. This is a
+*heuristic* -- it never deletes anything, it only labels -- so the analyzer can
+say "here's 3.2 GiB of stuff that's very likely safe to clear" and let a human
+(or the retention sweeper) decide.
+
+Classification is rule-based and pluggable. Each :class:`CruftRule` matches an
+entry and, if it fires, tags it with a category and a human reason. An entry can
+match several rules; the classifier keeps the highest-confidence tag but records
+all categories, so a ``.pyc`` inside ``__pycache__`` is both "cache" and, well,
+"cache" -- consistently one tag.
+"""
+
+from __future__ import annotations
+
+import re
+
+from .units import percent_of
+
+# --- Categories ---------------------------------------------------------------
+CATEGORY_EMPTY = "empty"          # zero-byte files
+CATEGORY_TEMP = "temp"            # editor / OS temp & junk
+CATEGORY_CACHE = "cache"          # build / dependency caches
+CATEGORY_LOG = "log"             # log files
+CATEGORY_BACKUP = "backup"        # editor / tool backup copies
+
+# Rough confidence ranking so that when several rules fire we report the most
+# specific (highest) one as the entry's primary category.
+_CONFIDENCE = {
+    CATEGORY_EMPTY: 60,
+    CATEGORY_CACHE: 50,
+    CATEGORY_TEMP: 40,
+    CATEGORY_BACKUP: 30,
+    CATEGORY_LOG: 20,
+}
+
+ALL_CATEGORIES = (
+    CATEGORY_EMPTY,
+    CATEGORY_TEMP,
+    CATEGORY_CACHE,
+    CATEGORY_LOG,
+    CATEGORY_BACKUP,
+)
+
+
+class CruftTag:
+    """The verdict for one entry that matched at least one cruft rule."""
+
+    __slots__ = ("entry", "primary", "categories", "reasons")
+
+    def __init__(self, entry, primary, categories, reasons):
+        self.entry = entry
+        self.primary = primary
+        self.categories = tuple(categories)
+        self.reasons = tuple(reasons)
+
+    @property
+    def path(self):
+        return self.entry.path
+
+    @property
+    def allocated(self):
+        return self.entry.allocated_size
+
+    @property
+    def apparent(self):
+        return self.entry.apparent_size
+
+    def as_dict(self):
+        return {
+            "path": str(self.entry.path),
+            "primary": self.primary,
+            "categories": list(self.categories),
+            "reasons": list(self.reasons),
+            "allocated": self.entry.allocated_size,
+            "apparent": self.entry.apparent_size,
+        }
+
+    def __repr__(self):
+        return f"<CruftTag {self.primary} {str(self.entry.path)}>"
+
+
+class CruftRule:
+    """A single classification rule.
+
+    ``matcher`` is a callable ``(entry) -> bool``; when it returns True the rule
+    contributes its ``category`` and a ``reason`` string. Rules are pure and
+    stateless so the rule set is safe to share across scans.
+    """
+
+    __slots__ = ("name", "category", "matcher", "reason")
+
+    def __init__(self, name, category, matcher, reason):
+        self.name = name
+        self.category = category
+        self.matcher = matcher
+        self.reason = reason
+
+    def matches(self, entry):
+        try:
+            return bool(self.matcher(entry))
+        except Exception:
+            # A defensive rule should never take down the whole scan.
+            return False
+
+
+# --- Default rule set ---------------------------------------------------------
+# Directory-name markers whose *contents* are almost always regenerable.
+_CACHE_DIR_NAMES = frozenset(
+    {
+        "__pycache__",
+        "node_modules",
+        ".cache",
+        ".mypy_cache",
+        ".pytest_cache",
+        ".gradle",
+        ".tox",
+        "build",
+        "dist",
+        ".ipynb_checkpoints",
+    }
+)
+
+# Exact junk file names.
+_TEMP_NAMES = frozenset(
+    {
+        ".ds_store",
+        "thumbs.db",
+        "desktop.ini",
+        ".localized",
+    }
+)
+
+# Extension-based markers (lower-cased, no dot).
+_CACHE_EXTS = frozenset({"pyc", "pyo", "o", "class", "obj"})
+_TEMP_EXTS = frozenset({"tmp", "temp", "swp", "swo", "part", "crdownload"})
+_LOG_EXTS = frozenset({"log"})
+_BACKUP_EXTS = frozenset({"bak", "old", "orig"})
+
+_TILDE_BACKUP = re.compile(r".+~$")
+
+
+def _in_cache_dir(entry):
+    return any(part in _CACHE_DIR_NAMES for part in entry.path.parts)
+
+
+def default_rules():
+    """Return the built-in ordered list of cruft rules."""
+    return [
+        CruftRule(
+            "empty-file",
+            CATEGORY_EMPTY,
+            lambda e: e.apparent_size == 0,
+            "zero-byte file",
+        ),
+        CruftRule(
+            "cache-dir",
+            CATEGORY_CACHE,
+            _in_cache_dir,
+            "inside a build/dependency cache directory",
+        ),
+        CruftRule(
+            "cache-ext",
+            CATEGORY_CACHE,
+            lambda e: e.extension in _CACHE_EXTS,
+            "compiled/cache artefact by extension",
+        ),
+        CruftRule(
+            "temp-name",
+            CATEGORY_TEMP,
+            lambda e: e.name.lower() in _TEMP_NAMES,
+            "OS/editor junk file",
+        ),
+        CruftRule(
+            "temp-ext",
+            CATEGORY_TEMP,
+            lambda e: e.extension in _TEMP_EXTS,
+            "temporary file by extension",
+        ),
+        CruftRule(
+            "tilde-backup",
+            CATEGORY_BACKUP,
+            lambda e: bool(_TILDE_BACKUP.match(e.name)),
+            "editor tilde backup",
+        ),
+        CruftRule(
+            "backup-ext",
+            CATEGORY_BACKUP,
+            lambda e: e.extension in _BACKUP_EXTS,
+            "backup copy by extension",
+        ),
+        CruftRule(
+            "log-ext",
+            CATEGORY_LOG,
+            lambda e: e.extension in _LOG_EXTS,
+            "log file",
+        ),
+    ]
+
+
+class CruftReport:
+    """The result of classifying a scan's entries as cruft or not."""
+
+    def __init__(self, tags):
+        self.tags = list(tags)
+
+    def __iter__(self):
+        return iter(self.tags)
+
+    def __len__(self):
+        return len(self.tags)
+
+    @property
+    def total_allocated(self):
+        return sum(t.entry.allocated_size for t in self.tags)
+
+    @property
+    def total_apparent(self):
+        return sum(t.entry.apparent_size for t in self.tags)
+
+    @property
+    def count(self):
+        return len(self.tags)
+
+    def of_category(self, category):
+        """Return the tags whose *primary* category is ``category``."""
+        return [t for t in self.tags if t.primary == category]
+
+    def category_totals(self):
+        """Return ``{category: (count, allocated)}`` over primary categories."""
+        totals = {}
+        for tag in self.tags:
+            count, allocated = totals.get(tag.primary, (0, 0))
+            totals[tag.primary] = (count + 1, allocated + tag.entry.allocated_size)
+        return totals
+
+    def paths(self):
+        return [t.entry.path for t in self.tags]
+
+    def as_dict(self, whole_allocated=None):
+        cats = {}
+        for category, (count, allocated) in self.category_totals().items():
+            entry = {"count": count, "allocated": allocated}
+            if whole_allocated is not None:
+                entry["fraction"] = percent_of(allocated, whole_allocated)
+            cats[category] = entry
+        return {
+            "count": self.count,
+            "total_allocated": self.total_allocated,
+            "total_apparent": self.total_apparent,
+            "categories": cats,
+            "tags": [t.as_dict() for t in self.tags],
+        }
+
+
+class CruftClassifier:
+    """Applies a rule set to entries and produces a :class:`CruftReport`.
+
+    Reference (protected) entries are *never* classified as cruft -- if a user
+    declared a directory as their master copy, its junk-looking files are still
+    theirs to keep. That mirrors the reference semantics elsewhere in the disk
+    tooling.
+    """
+
+    def __init__(self, rules=None, include_reference=False):
+        self.rules = list(rules) if rules is not None else default_rules()
+        self.include_reference = include_reference
+
+    def classify_entry(self, entry):
+        """Return a :class:`CruftTag` for ``entry`` or ``None`` if it's clean."""
+        if entry.is_reference and not self.include_reference:
+            return None
+        fired = [rule for rule in self.rules if rule.matches(entry)]
+        if not fired:
+            return None
+        categories = []
+        reasons = []
+        for rule in fired:
+            if rule.category not in categories:
+                categories.append(rule.category)
+            reasons.append(rule.reason)
+        primary = max(categories, key=lambda c: _CONFIDENCE.get(c, 0))
+        return CruftTag(entry, primary=primary, categories=categories, reasons=reasons)
+
+    def classify(self, entries):
+        tags = []
+        for entry in entries:
+            tag = self.classify_entry(entry)
+            if tag is not None:
+                tags.append(tag)
+        # Deterministic order: biggest reclaimable first, path as tie-break.
+        tags.sort(key=lambda t: (-t.entry.allocated_size, str(t.entry.path)))
+        return CruftReport(tags)
diff --git a/core/diskscan/duplicates.py b/core/diskscan/duplicates.py
