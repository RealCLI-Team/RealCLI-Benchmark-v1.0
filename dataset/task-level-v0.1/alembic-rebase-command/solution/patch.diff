+def rebase(config: Config, revision: str, target: str) -> None:
+    """Rebase a revision script onto a new parent revision.
+
+    Rewrites the ``down_revision`` assignment of the given revision script
+    file in place, so that the revision and every revision that descends
+    from it are moved onto a new location within the revision tree,
+    without generating a new merge revision.  This is an alternative to
+    :ref:`alembic merge <branches>` for moving a branch onto an updated
+    mainline.
+
+    The previous ``down_revision`` value is appended to a ``Rebased
+    from:`` line in the script's docstring header, so that the history of
+    where the revision was previously attached is preserved and can be
+    inspected via :func:`.show` and :func:`.history`.
+
+    :param config: a :class:`.Config` instance.
+
+    :param revision: identifier of the revision script to move.  Supports
+     partial revision identifiers as well as symbolic names such as
+     ``"head"`` or ``<branchname>@head``.
+
+    :param target: identifier of the revision the script should be moved
+     onto; may be ``"base"`` to detach the script from any parent so that
+     it becomes a new base of the tree.
+
+    The command fails if the revision and the target resolve to the same
+    revision, if the revision is already based on the target, if the
+    revision is a merge point with multiple down_revisions, or if the
+    target is a descendant of the revision being moved, which would
+    produce a cycle.
+
+    .. versionadded:: 1.17
+
+    .. seealso::
+
+        :ref:`branches`
+
+    """
+
+    script = ScriptDirectory.from_config(config)
+    # look up the current down_revision before it is rewritten so that
+    # the printed message shows both the previous and the new parent
+    with script._catch_revision_errors():
+        preflight_script = script.get_revision(revision)
+    if preflight_script is None:
+        raise util.CommandError(
+            "Can't locate revision identified by '%s'" % revision
+        )
+    previous_down_revision = preflight_script.down_revision
+
+    rebased = script.rebase(revision, target)
+    onto = "base" if rebased.down_revision is None else rebased.down_revision
+    previously = (
+        "base" if previous_down_revision is None else previous_down_revision
+    )
+    config.print_stdout(
+        "Rebased %s; down_revision is now %s (previously %s)",
+        rebased.revision,
+        onto,
+        previously,
+    )
+
+
 def upgrade(
     config: Config,
     revision: str,
