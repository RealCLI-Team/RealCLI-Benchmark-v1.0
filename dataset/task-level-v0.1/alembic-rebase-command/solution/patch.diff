+        if self.sourceless:
+            raise util.CommandError(
+                "The rebase operation requires revision scripts to be "
+                "present as Python source files; this script directory "
+                "is configured as sourceless."
+            )
+
+        with self._catch_revision_errors():
+            rev_script = self.get_revision(revision_id)
+            if rev_script is None:
+                raise util.CommandError(
+                    "Can't locate revision identified by '%s'" % revision_id
+                )
+            if target == "base":
+                target_script = None
+            else:
+                target_script = self.get_revision(target)
+                if target_script is None:
+                    raise util.CommandError(
+                        "Can't locate revision identified by '%s'" % target
+                    )
+
+        if target_script is None:
+            new_down_revision: Optional[str] = None
+        else:
+            new_down_revision = target_script.revision
+            if new_down_revision == rev_script.revision:
+                raise util.CommandError(
+                    "Cannot rebase revision %s onto itself"
+                    % rev_script.revision
+                )
+
+        if rev_script.down_revision == new_down_revision:
+            raise util.CommandError(
+                "Revision %s is already based on %s"
+                % (rev_script.revision, new_down_revision or "base")
+            )
+
+        if rev_script.is_merge_point:
+            raise util.CommandError(
+                "Revision %s is a merge point with multiple down_revisions "
+                "(%s); only revisions with at most one down_revision can "
+                "be rebased"
+                % (
+                    rev_script.revision,
+                    util.format_as_comma(rev_script._all_down_revisions),
+                )
+            )
+
+        if target_script is not None:
+            descendants = {
+                rev.revision
+                for rev in self.revision_map._get_descendant_nodes(
+                    (rev_script,), check=True
+                )
+            }
+            if new_down_revision in descendants:
+                raise util.CommandError(
+                    "Cannot rebase revision %s onto %s: the target is a "
+                    "descendant of the revision being moved, so this would "
+                    "produce a cycle in the revision graph"
+                    % (rev_script.revision, new_down_revision)
+                )
+
+        if not rev_script.path.endswith(".py") or not os.access(
+            rev_script.path, os.F_OK
+        ):
+            raise util.CommandError(
+                "Revision %s is not present as a Python source file at %r; "
+                "cannot rewrite it" % (rev_script.revision, rev_script.path)
+            )
