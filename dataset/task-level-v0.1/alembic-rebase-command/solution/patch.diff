+"""Tests for the ``alembic rebase`` command and the underlying
+:meth:`.ScriptDirectory.rebase` operation.
+
+The rebase operation rewrites the ``down_revision`` assignment of a
+revision script file in place, relocating the revision (and every
+revision that descends from it) onto a new parent within the revision
+tree, without generating a new merge revision.  It also appends the
+previous ``down_revision`` value to a ``Rebased from:`` audit trail
+line in the script's docstring header.
+
+"""
+
+from io import StringIO
+import os
+
+import pytest
+
+from alembic import command
+from alembic import util
+from alembic.config import CommandLine
+from alembic.script import ScriptDirectory
+from alembic.testing import assert_raises
+from alembic.testing import assert_raises_message
+from alembic.testing import eq_
+from alembic.testing import is_false
+from alembic.testing import is_true
+from alembic.testing.env import _no_sql_testing_config
+from alembic.testing.env import _sqlite_testing_config
+from alembic.testing.env import clear_staging_env
+from alembic.testing.env import env_file_fixture
+from alembic.testing.env import staging_env
+from alembic.testing.fixtures import capture_context_buffer
+from alembic.testing.fixtures import TestBase
+
+A = "aaaa00000001"
+B = "bbbb00000002"
+C = "cccc00000003"
+D = "dddd00000004"
+E = "eeee00000005"
+F = "ffff00000006"
+M = "mmmm00000007"
+G = "999900000008"
+
+
+def _render_revision(
+    rev,
+    down,
+    message,
+    *,
+    annotated=False,
+    branch_labels=None,
+    depends_on=None,
+    upgrade_body="pass",
+    downgrade_body="pass",
+    include_revises_header=True,
+    trailing_comment=False,
+    include_down_revision=True,
+    prebaked_audit=None,
+):
+    """Render the source code of a revision script."""
+
+    if isinstance(down, tuple):
+        down_rendered = "(%s)" % ", ".join(repr(elem) for elem in down)
+        revises = ", ".join(down)
+    elif down is None:
+        down_rendered = "None"
+        revises = ""
+    else:
+        down_rendered = repr(down)
+        revises = down
+
+    if annotated:
+        down_assignment = "down_revision: Union[str, None] = %s" % (
+            down_rendered,
+        )
+        typing_imports = "from typing import Union\n\n"
+    else:
+        down_assignment = "down_revision = %s" % (down_rendered,)
+        typing_imports = ""
+
+    if trailing_comment:
+        down_assignment += "  # original parent marker"
+
+    if not include_down_revision:
+        down_assignment = "down_revision = %s\n%s" % (
+            down_rendered,
+            down_assignment,
+        )
+
+    labels_rendered = (
+        "None" if branch_labels is None else repr(branch_labels)
+    )
+    depends_rendered = "None" if depends_on is None else repr(depends_on)
+
+    revises_line = (
+        "Revises: %s\n" % revises if include_revises_header else ""
+    )
+    audit_line = (
+        "Rebased from: %s\n" % ", ".join(prebaked_audit)
+        if prebaked_audit
+        else ""
+    )
+
+    return '''\
+"""%(message)s
+
+Revision ID: %(rev)s
+%(revises_line)s%(audit_line)sCreate Date: 2025-08-01 12:00:00.000000
+
+"""
+from alembic import op
+%(typing_imports)s
+revision = %(rev)r
+%(down_assignment)s
+branch_labels = %(labels_rendered)s
+depends_on = %(depends_rendered)s
+
+
+def upgrade():
+    %(upgrade_body)s
+
+
+def downgrade():
+    %(downgrade_body)s
+''' % {
+        "message": message,
+        "rev": rev,
+        "revises_line": revises_line,
+        "audit_line": audit_line,
+        "typing_imports": typing_imports,
+        "down_assignment": down_assignment,
+        "labels_rendered": labels_rendered,
+        "depends_rendered": depends_rendered,
+        "upgrade_body": upgrade_body,
+        "downgrade_body": downgrade_body,
+    }
+
+
+def _write_rev(scriptdir, rev, down, message, **kw):
+    """Write a revision script file into the versions directory."""
+
+    path = os.path.join(scriptdir.versions, "%s.py" % rev)
+    with open(path, "w", encoding="utf-8") as file_:
+        file_.write(_render_revision(rev, down, message, **kw))
+    pyc_path = util.pyc_file_from_path(path)
+    if pyc_path and os.access(pyc_path, os.F_OK):
+        os.unlink(pyc_path)
+    return path
+
+
+def _read(path):
+    with open(path, encoding="utf-8") as file_:
+        return file_.read()
+
