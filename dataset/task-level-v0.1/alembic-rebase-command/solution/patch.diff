+_down_revision_assignment_re = re.compile(
+    r"^(down_revision(?:\s*:\s*[^=\n]+)?\s*=\s*)([^\n]*?)(\s*(?:#[^\n]*)?)$",
+    re.MULTILINE,
+)
+"""Matches a module level ``down_revision`` assignment, with or without a
+type annotation, capturing the leading portion through the equals sign,
+the right hand side, and a possible trailing comment.
+"""
+
+_revises_docstring_re = re.compile(r"^Revises:[^\n]*$", re.MULTILINE)
+"""Matches the ``Revises:`` line of a revision script's docstring header."""
+
+_rebased_from_line_re = re.compile(r"^Rebased from:[ \t]*([^\n]*)$", re.MULTILINE)
+"""Matches the audit-trail line inserted by :meth:`.ScriptDirectory.rebase`,
+capturing the comma-separated list of previous ``down_revision`` values.
+"""
+
+
+def _parse_rebased_from(text: Optional[str]) -> Tuple[str, ...]:
+    """Extract the ordered list of previous ``down_revision`` values from
+    a revision script's docstring header.
+
+    Returns an empty tuple when the docstring is missing, when the line
+    is absent, or when the line is present but its payload is empty.
+    Multiple ``Rebased from:`` lines are conservatively rejected by
+    returning an empty tuple - the on-disk rewrite path treats that as
+    a malformed audit trail.
+
+    """
+
+    if not text:
+        return ()
+    matches = _rebased_from_line_re.findall(text)
+    if len(matches) != 1:
+        return ()
+    payload = matches[0].strip()
+    if not payload:
+        return ()
+    parts = [chunk.strip() for chunk in payload.split(",")]
+    return tuple(part for part in parts if part)
+
+
+def _rewrite_down_revision(
+    path: Union[str, os.PathLike[str]],
+    new_down_revision: Optional[str],
+    *,
+    previous_down_revision: Optional[str],
+) -> str:
+    """Rewrite the ``down_revision`` assignment of a revision script file.
+
+    The right hand side of the module level ``down_revision`` assignment
+    is replaced by the given revision id, or ``None``.  Any type
+    annotation present on the assignment (e.g.
+    ``down_revision: Union[str, None] = 'abc123'``) is preserved, as is a
+    trailing comment.
+
+    If the file's docstring header contains exactly one ``Revises:``
+    line, that line is updated as well so that the displayed header stays
+    consistent with the assignment.
+
+    A ``Rebased from:`` line is inserted or extended in the docstring
+    header, immediately after the ``Revises:`` line, recording the
+    previous ``down_revision`` value.  ``base`` is used as the sentinel
+    when the previous ``down_revision`` was ``None``.
+
+    :param path: filesystem path of the revision script.
+
+    :param new_down_revision: the revision id to assign, or ``None`` to
+     make the script a base revision.
+
+    :param previous_down_revision: the revision id the script was
+     previously based on, or ``None`` when it was previously a base.
+
+    :return: the original content of the file, so that callers may
+     restore it if the rewritten file turns out to be invalid.
+
+    """
+
+    # note the file is opened with newline="" so that the original line
+    # endings (e.g. CRLF) are preserved byte for byte
+    with open(path, encoding="utf-8", newline="") as file_:
+        original_text = file_.read()
+
+    assignments = _down_revision_assignment_re.findall(original_text)
+    if len(assignments) != 1:
+        raise util.CommandError(
+            "Could not locate exactly one module-level down_revision "
+            "assignment in %r; refusing to rewrite the file" % (path,)
+        )
+
+    rendered = "None" if new_down_revision is None else repr(new_down_revision)
+
+    def _replace_assignment(match: "re.Match[str]") -> str:
+        prefix, _old_rhs, suffix = match.groups()
+        return "%s%s%s" % (prefix, rendered, suffix)
+
+    new_text, count = _down_revision_assignment_re.subn(
+        _replace_assignment, original_text, count=1
+    )
+    assert count == 1
+
+    revises_matches = _revises_docstring_re.findall(original_text)
+    has_revises_line = len(revises_matches) == 1
+
+    if has_revises_line:
+        revises_line = (
+            "Revises:"
+            if new_down_revision is None
+            else "Revises: %s" % new_down_revision
+        )
+        new_text = _revises_docstring_re.sub(revises_line, new_text, count=1)
+
+    previous_entry = (
+        "base" if previous_down_revision is None else previous_down_revision
+    )
+    existing_audit = _parse_rebased_from(new_text)
+    updated_audit = existing_audit + (previous_entry,)
+    audit_line = "Rebased from: %s" % ", ".join(updated_audit)
+
+    if existing_audit:
+        new_text = _rebased_from_line_re.sub(audit_line, new_text, count=1)
+    elif has_revises_line:
+        # place the audit line immediately after the Revises: line so
+        # that both header entries are visually adjacent.  The Revises:
+        # line has just been rewritten so we anchor on the updated text.
+        anchor = revises_line
+        idx = new_text.find(anchor)
+        assert idx != -1, "expected Revises: line to be present"
+        newline_pos = new_text.find("\n", idx)
+        if newline_pos == -1:
+            new_text = new_text + "\n" + audit_line
+        else:
+            new_text = (
+                new_text[: newline_pos + 1]
+                + audit_line
+                + "\n"
+                + new_text[newline_pos + 1 :]
+            )
+    # otherwise: the file has no Revises: header line to anchor on
+    # (non-standard docstring layout, e.g. single-line quoted).  The
+    # down_revision assignment has been rewritten; the audit trail is
+    # not inserted for such files, since there is no unambiguous
+    # anchor for it and appending arbitrary lines might not produce a
+    # valid Python module.
+
+    with open(path, "w", encoding="utf-8", newline="") as file_:
+        file_.write(new_text)
+
+    # remove any stale bytecode cache for the file; since the rewrite may
+    # produce content of identical size within the same second, the
+    # timestamp/size based .pyc validation alone is not reliable here
+    pyc_path = util.pyc_file_from_path(path)
+    if pyc_path and os.access(pyc_path, os.F_OK):
+        os.unlink(pyc_path)
+
+    return original_text
+
+
