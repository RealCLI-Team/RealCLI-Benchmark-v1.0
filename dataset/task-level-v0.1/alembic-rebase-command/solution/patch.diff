+        try:
+            reloaded = self.get_revision(rev_script.revision)
+        except Exception as err:
+            # defensive: if the rewritten file does not parse or produced
+            # an invalid graph, restore the original content
+            with open(rev_script.path, "w", encoding="utf-8") as file_:
+                file_.write(original_text)
+            pyc_path = util.pyc_file_from_path(rev_script.path)
+            if pyc_path and os.access(pyc_path, os.F_OK):
+                os.unlink(pyc_path)
+            self.revision_map = revision.RevisionMap(self._load_revisions)
+            if isinstance(err, util.CommandError):
+                raise
