+                # skip no-op rebases that the guards refuse
+                continue
+        self.cfg.stdout = buf = StringIO()
+        command.show(self.cfg, D)
+        output = buf.getvalue()
+        is_true("Rebased from:" in output)
+        # the audit trail may contain the base sentinel
+        audit_line = next(
+            line for line in output.splitlines()
+            if line.startswith("Rebased from:")
+        )
+        # audit entries are the actual previous parents in order
+        parts = [
+            chunk.strip()
+            for chunk in audit_line[len("Rebased from:"):].split(",")
