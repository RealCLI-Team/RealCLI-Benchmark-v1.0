+    def rebase(self, revision_id: str, target: str) -> Script:
+        """Move a revision script onto a new parent revision.
+
+        Rewrites the ``down_revision`` assignment inside the given revision
+        script file so that the revision, along with every revision that
+        descends from it, is relocated onto ``target`` within the revision
+        tree.  The revision's own identifier, message, branch labels and
+        dependencies are left untouched.
