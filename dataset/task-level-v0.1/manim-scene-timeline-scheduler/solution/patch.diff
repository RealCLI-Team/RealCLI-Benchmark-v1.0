+"""Tests for the :class:`~.Timeline` animation scheduling model.
+
+These tests double as regression tests for the introspection hooks
+(:meth:`~.Animation.iter_leaves`, :meth:`~.Animation.affected_family`
+and their :class:`~.AnimationGroup` overrides) and for the
+:class:`~.Scene.play` -> :class:`~.Timeline` integration path added on
+top of the regular playback pipeline.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from manim import (
+    AnimationGroup,
+    Circle,
+    Dot,
+    FadeIn,
+    FadeOut,
+    Group,
+    Indicate,
+    LaggedStart,
+    Line,
+    Mobject,
+    Scene,
+    Square,
+    Succession,
+    VGroup,
+    Wait,
+    Write,
+    tempconfig,
+)
+from manim.animation.animation import Animation
+from manim.scene.timeline import (
+    ScheduledAnimation,
+    Timeline,
+    TimelineConflictError,
+    affected_mobjects,
+    affected_type_names,
+)
+
+
+def make_square_animation(**kwargs):
+    return FadeIn(Square(), **kwargs)
+
+
+class TestScheduledAnimationInterface:
+    def test_attributes_are_exposed(self):
+        timeline = Timeline()
+        animation = FadeIn(Square(), run_time=2.0)
+        entry = timeline.schedule(animation, at=1.0, delay=0.25)
+        assert entry.animation is animation
+        assert entry.start == 1.25
+        assert entry.delay == 0.25
+        assert entry.dependencies == ()
+        assert entry.index == 0
+
+    def test_run_time_and_end_properties(self):
+        timeline = Timeline()
+        animation = FadeIn(Square(), run_time=2.0)
+        entry = timeline.schedule(animation, at=1.0)
+        assert entry.run_time == 2.0
+        assert entry.end == 3.0
+
+    def test_end_tracks_run_time_changes(self):
+        timeline = Timeline()
+        animation = FadeIn(Square(), run_time=2.0)
+        entry = timeline.schedule(animation, at=1.0)
+        animation.set_run_time(5.0)
+        assert entry.run_time == 5.0
+        assert entry.end == 6.0
+
+    def test_repr_mentions_animation_type(self):
+        timeline = Timeline()
+        entry = timeline.schedule(FadeIn(Square()), at=0.0)
+        assert "FadeIn" in repr(entry)
+
+    def test_entries_are_returned_in_insertion_order(self):
+        timeline = Timeline()
+        square, circle, dot = Square(), Circle(), Dot()
+        entry0 = timeline.schedule(FadeIn(square), at=3.0)
+        entry1 = timeline.schedule(FadeIn(circle), at=0.0)
+        entry2 = timeline.schedule(FadeIn(dot), at=1.5)
+        assert timeline.entries == (entry0, entry1, entry2)
+        assert [entry.index for entry in timeline.entries] == [0, 1, 2]
+
+    def test_entries_returns_an_immutable_tuple(self):
+        timeline = Timeline()
+        timeline.schedule(FadeIn(Square()), at=0.0)
+        entries = timeline.entries
+        assert isinstance(entries, tuple)
+        with pytest.raises(AttributeError):
+            entries.append("nope")
+
+    def test_overlaps_helper_matches_active_semantics(self):
+        timeline = Timeline()
+        first = timeline.schedule(FadeIn(Square()), at=0.0)
+        second = timeline.schedule(FadeIn(Circle()), at=0.5)
+        third = timeline.schedule(FadeIn(Dot()), at=1.0)
+        assert first.overlaps(second)
+        assert second.overlaps(first)
+        assert not first.overlaps(third)
+        assert not third.overlaps(first)
+
+
+class TestScheduleResolution:
+    def test_explicit_at(self):
+        timeline = Timeline()
+        entry = timeline.schedule(FadeIn(Square()), at=2.0)
+        assert entry.start == 2.0
+        assert entry.end == 3.0
+
+    def test_explicit_at_with_delay(self):
+        timeline = Timeline()
+        entry = timeline.schedule(FadeIn(Square()), at=2.0, delay=0.5)
+        assert entry.start == 2.5
+
