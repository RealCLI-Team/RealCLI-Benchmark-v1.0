+"""Small demo scenes that exercise the :class:`~.Timeline` API.
+
+These are meant to be readable rather than exhaustive; the regression
+suite under ``tests/module/scene/test_timeline.py`` covers the API
+surface in detail.
+"""
+
+from __future__ import annotations
+
+from manim import (
+    Circle,
+    Dot,
+    FadeIn,
+    FadeOut,
+    Indicate,
+    Scene,
+    Square,
+    Timeline,
+    Write,
+)
+
+
+class DeclarativeTimeline(Scene):
+    """Build a small timeline declaratively and play it in one shot.
+
+    The intent of the timeline API is that you first *describe* what
+    you want to happen, then hand the whole description off to the
+    renderer.  Nothing is rendered while the timeline is being built.
+    """
+
+    def construct(self) -> None:
+        title = Square()
+        formula = Circle()
+        graph = Dot()
+
+        timeline = Timeline()
+        intro = timeline.schedule(FadeIn(title), at=0.0)
+        derivation = timeline.schedule(
+            Write(formula, run_time=2.0), after=intro, delay=0.5
+        )
+        timeline.schedule(Indicate(formula), after=derivation)
+        timeline.schedule(FadeIn(graph), at=derivation.start)
+        timeline.schedule(FadeOut(title), after=intro, delay=6.5)
+
+        # Inspect the layout before committing to it -- this is the
+        # main advantage of the declarative model.
+        print("timeline duration:", timeline.duration)
+        for row in timeline.report():
+            print(row)
+
+        # `Scene.play` accepts Timelines directly.
+        self.play(timeline)
+
+
+class TimelineRescaled(Scene):
+    """Show that a timeline can be rescaled in one step to change tempo."""
+
+    def construct(self) -> None:
+        timeline = Timeline()
+        square = Square()
+        circle = Circle()
+        first = timeline.schedule(FadeIn(square), at=0.0)
+        timeline.schedule(FadeIn(circle), after=first, delay=0.5)
+
+        # Play the timeline at half speed.
+        self.play(timeline.rescale(0.5))
+
+
+class TimelineTracks(Scene):
+    """Illustrate the "track" view of a timeline.
+
+    Two parallel voices are scheduled at the same time and end up on
+    separate tracks; a follow-up entry appended after both fits back on
+    the first track.
+    """
+
+    def construct(self) -> None:
+        left = Square()
+        right = Circle()
+        follow = Dot()
+
+        timeline = Timeline()
+        a = timeline.schedule(FadeIn(left), at=0.0)
+        b = timeline.schedule(FadeIn(right), at=0.0)
+        timeline.schedule(FadeIn(follow), after=[a, b], delay=0.25)
+
+        for i, track in enumerate(timeline.tracks()):
+            print(f"track {i}: {[entry.index for entry in track]}")
+
+        self.play(timeline)
+
+
+class TimelineMerged(Scene):
+    """Compose two smaller timelines into a larger one via merge/+."""
+
+    def construct(self) -> None:
+        intro = Timeline()
+        intro.schedule(FadeIn(Square()), at=0.0)
+
+        outro = Timeline()
+        outro.schedule(FadeIn(Circle()), at=0.0)
+
+        combined = intro + outro
+        self.play(combined)
