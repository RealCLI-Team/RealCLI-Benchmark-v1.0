+class TestScheduleEquivalenceWithManualComposition:
+    """A timeline built from sequential appends must be equivalent to the
+    manually chained version of the same composition."""
+
+    def test_appending_matches_manual_chaining(self):
+        chained = Timeline()
+        first = chained.schedule(FadeIn(Square()), at=0.0)
+        second = chained.schedule(FadeIn(Circle()), after=first)
+        chained.schedule(FadeIn(Dot()), after=second)
+
+        appended = Timeline()
+        appended.schedule(FadeIn(Square()), at=0.0)
+        appended.schedule(FadeIn(Circle()))
+        appended.schedule(FadeIn(Dot()))
+
+        assert [e.start for e in appended.entries] == [
+            e.start for e in chained.entries
+        ]
+        assert [e.end for e in appended.entries] == [
+            e.end for e in chained.entries
+        ]
+        assert appended.duration == chained.duration == 3.0
+
+    def test_built_compositions_match(self):
+        chained = Timeline()
+        first = chained.schedule(FadeIn(Square()), at=0.0)
+        chained.schedule(FadeIn(Circle()), after=first)
+
+        appended = Timeline()
+        appended.schedule(FadeIn(Square()), at=0.0)
+        appended.schedule(FadeIn(Circle()))
+
+        assert chained.build().run_time == appended.build().run_time
