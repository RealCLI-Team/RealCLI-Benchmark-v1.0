--- a/manim/scene/timeline.py	1970-01-01 08:00:00.000000000 +0800
+++ b/manim/scene/timeline.py	2026-08-26 18:32:32.494176000 +0800
@@ -0,0 +1,837 @@
+"""Declarative, non-linear scheduling of animations on a timeline.
+
+This module provides a small "video editor" style model on top of the
+regular :class:`~.Scene` playback machinery.  Instead of chaining
+:meth:`~.Scene.play` calls (which always append to the current end of
+the scene), a :class:`Timeline` lets you place animations at explicit
+absolute start times, relative to other already scheduled animations,
+or appended after everything scheduled so far.
+
+A timeline is a purely logical construct: building one does not render
+anything.  Once the layout of the animations has been decided, the
+timeline can be turned into a single composite animation via
+:meth:`Timeline.build`, which can then be played like any other
+animation -- most conveniently through :meth:`.Scene.play` (which
+accepts :class:`Timeline` instances directly) or the equivalent
+back-compat wrapper :meth:`.Scene.play_timeline`.
+
+Examples
+--------
+
+A typical use looks like this::
+
+    timeline = Timeline()
+    intro = timeline.schedule(FadeIn(title), at=0.0)
+    timeline.schedule(Write(formula), after=intro, delay=0.5)
+    timeline.schedule(Circumscribe(formula), at=4.0)
+
+    print(timeline.duration)   # total length of the composition
+    print(timeline.report())   # machine readable schedule overview
+
+    # inside a Scene.construct method:
+    self.play(timeline)
+
+Two scheduled animations may overlap in time only if the sets of
+mobjects they act upon are disjoint; otherwise a
+:class:`TimelineConflictError` is raised at schedule time.  The set of
+"affected" mobjects for a scheduled animation is computed via the
+:meth:`~.Animation.affected_family` and :meth:`~.Animation.iter_leaves`
+hooks that :class:`~.Animation` and :class:`~.AnimationGroup` expose,
+so composite animations and family-of-a-group entries participate in
+conflict detection correctly.
+
+Start times are resolved from three independent pieces of information:
+an explicit absolute time (``at``), one or more dependencies on
+previously scheduled entries (``after``), and an additional
+non-negative ``delay``.  When neither ``at`` nor ``after`` is given,
+the animation is appended directly after everything scheduled so far,
+which makes the following two snippets equivalent::
+
+    # explicit chaining
+    first = timeline.schedule(FadeIn(a), at=0.0)
+    timeline.schedule(FadeIn(b), after=first)
+
+    # implicit appending
+    timeline.schedule(FadeIn(a), at=0.0)
+    timeline.schedule(FadeIn(b))
+
+Because a timeline never renders anything by itself, it is cheap to
+inspect and rearrange a composition before committing to it.  The
+:meth:`Timeline.active_at`, :meth:`Timeline.entries_between`,
+:meth:`Timeline.gaps`, :meth:`Timeline.tracks` and
+:meth:`Timeline.report` methods provide different views on the same
+schedule, and :meth:`Timeline.rescale`, :meth:`Timeline.shift`,
+:meth:`Timeline.slice` and :meth:`Timeline.merge` produce transformed
+copies of the whole composition in one step.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Iterator
+from typing import Any
+
+from manim.animation.animation import Animation, Wait
+from manim.animation.composition import AnimationGroup, Succession
+from manim.mobject.mobject import Mobject
+
+__all__ = [
+    "Timeline",
+    "ScheduledAnimation",
+    "TimelineConflictError",
+]
+
+
+class TimelineConflictError(Exception):
+    """Raised when two animations scheduled on a :class:`Timeline` overlap in
+    time while acting on the same mobject (or on members of the same mobject
+    family).
+
+    This is a scheduling error, not a rendering error: it is raised by
+    :meth:`Timeline.schedule` at the moment the conflicting entry would be
+    added, and the timeline is left completely unchanged (its length, its
+    entry count and its running index counter are all preserved).
+    """
+
+
+def _iter_leaf_animations(animation: Animation) -> Iterator[Animation]:
+    """Yield the leaves of ``animation`` via :meth:`~.Animation.iter_leaves`.
+
+    Kept as a module-level helper so downstream code can iterate leaves
+    without having to know whether the argument is a plain
+    :class:`~.Animation` or a composite :class:`~.AnimationGroup`.
+    """
+    yield from animation.iter_leaves()
+
+
+def affected_mobjects(animation: Animation) -> list[Mobject]:
+    """Return the list of mobjects that ``animation`` acts upon.
+
+    This is a thin, tolerant list-shaped wrapper around
+    :meth:`~.Animation.affected_family` (which already handles the
+    recursion into composite animations and the deduplication).
+
+    Parameters
+    ----------
+    animation
+        The animation whose affected mobjects should be computed.
+
+    Returns
+    -------
+    list of :class:`~.Mobject`
+        The mobjects influenced by the animation, in family-traversal
+        order and deduplicated by identity.
+    """
+    return list(animation.affected_family())
+
+
+def affected_type_names(animation: Animation) -> list[str]:
+    """Return the sorted, de-duplicated class names of the mobjects
+    that ``animation`` acts upon.
+
+    This is the same set of mobjects as computed by
+    :func:`affected_mobjects`, reduced to their type names.
+    """
+    return sorted({type(mobject).__name__ for mobject in affected_mobjects(animation)})
+
+
+def _intervals_overlap(start0: float, end0: float, start1: float, end1: float) -> bool:
+    """Return whether the half-open intervals ``[start0, end0)`` and
+    ``[start1, end1)`` have a non-empty intersection.
+
+    Intervals that merely touch (the end of one equals the start of the
+    other) do *not* count as overlapping, and an empty interval
+    (``start == end``) never overlaps anything.
+    """
+    if end0 <= start0 or end1 <= start1:
+        return False
+    return start0 < end1 and start1 < end0
+
+
+class ScheduledAnimation:
+    """A single entry of a :class:`Timeline`.
+
+    Instances are created by :meth:`Timeline.schedule` and should not be
+    constructed directly.
+
+    Attributes
+    ----------
+    animation
+        The scheduled :class:`~.Animation`.
+    start
+        The resolved absolute start time of the animation, in seconds.
+    delay
+        The delay that was applied on top of the resolved base time when
+        the entry was scheduled.
+    dependencies
+        The tuple of other :class:`ScheduledAnimation` entries this entry
+        was scheduled after (possibly empty).
+    index
+        The insertion index of this entry in its timeline, starting at 0.
+    """
+
+    def __init__(
+        self,
+        animation: Animation,
+        start: float,
+        delay: float,
+        dependencies: tuple[ScheduledAnimation, ...],
+        index: int,
+    ) -> None:
+        self.animation: Animation = animation
+        self.start: float = start
+        self.delay: float = delay
+        self.dependencies: tuple[ScheduledAnimation, ...] = dependencies
+        self.index: int = index
+
+    @property
+    def run_time(self) -> float:
+        """The current run time of the scheduled animation, in seconds."""
+        return self.animation.run_time
+
+    @property
+    def end(self) -> float:
+        """The absolute end time of this entry, ``start + run_time``."""
+        return self.start + self.run_time
+
+    def overlaps(self, other: ScheduledAnimation) -> bool:
+        """Return whether this entry's time window overlaps ``other``'s.
+
+        Uses the same half-open semantics as
+        :meth:`Timeline.active_at` and :meth:`Timeline.entries_between`:
+        two entries whose windows merely touch (one entry's end equals
+        the other entry's start) do not count as overlapping, and a
+        zero-length window never overlaps anything.
+        """
+        return _intervals_overlap(self.start, self.end, other.start, other.end)
+
+    def __repr__(self) -> str:
+        return (
+            f"{type(self).__name__}({type(self.animation).__name__}, "
+            f"start={self.start}, end={self.end})"
+        )
+
+
+class Timeline:
+    """A declarative, non-linear schedule of animations.
+
+    A timeline keeps an ordered collection of :class:`ScheduledAnimation`
+    entries.  New animations are added with :meth:`schedule`; their start
+    time is resolved from the ``at``, ``after`` and ``delay`` arguments
+    (see :meth:`schedule` for the exact resolution rules).
+
+    Timelines do not render anything by themselves.  Use :meth:`build` to
+    convert a timeline into a single composite :class:`~.AnimationGroup`,
+    or :meth:`.Scene.play` / :meth:`.Scene.play_timeline` to build and
+    play it in one step.
+    """
+
+    def __init__(self) -> None:
+        self._entries: list[ScheduledAnimation] = []
+
+    @property
+    def entries(self) -> tuple[ScheduledAnimation, ...]:
+        """The scheduled entries, in insertion order."""
+        return tuple(self._entries)
+
+    def __len__(self) -> int:
+        return len(self._entries)
+
+    def __iter__(self) -> Iterator[ScheduledAnimation]:
+        return iter(self._entries)
+
+    def __contains__(self, item: object) -> bool:
+        return any(item is entry for entry in self._entries)
+
+    def __repr__(self) -> str:
+        return (
+            f"{type(self).__name__}(entries={len(self)}, "
+            f"duration={self.duration})"
+        )
+
+    @property
+    def duration(self) -> float:
+        """The total duration of the timeline in seconds.
+
+        This is the maximum end time over all scheduled entries, or
+        ``0.0`` if the timeline is empty.
+        """
+        return max((entry.end for entry in self._entries), default=0.0)
+
+    def clear(self) -> None:
+        """Remove all scheduled entries from the timeline."""
+        self._entries.clear()
+
+    def _resolve_dependencies(
+        self, after: ScheduledAnimation | Animation | Iterable[Any] | None
+    ) -> list[ScheduledAnimation]:
+        """Normalize the ``after`` argument of :meth:`schedule` into a list
+        of :class:`ScheduledAnimation` entries.
+
+        Accepts a single :class:`ScheduledAnimation`, a single
+        :class:`~.Animation` (resolved to the first entry, in insertion
+        order, that schedules exactly that animation object), or an
+        iterable mixing both.  Anything that cannot be resolved to an
+        entry of *this* timeline raises a :class:`ValueError`.
+        """
+        if after is None:
+            return []
+        if isinstance(after, (ScheduledAnimation, Animation)):
+            candidates: list[Any] = [after]
+        else:
+            candidates = list(after)
+
+        resolved: list[ScheduledAnimation] = []
+        for candidate in candidates:
+            if isinstance(candidate, ScheduledAnimation):
+                if not any(candidate is entry for entry in self._entries):
+                    raise ValueError(
+                        "The given ScheduledAnimation does not belong to this "
+                        "Timeline; dependencies must refer to entries that "
+                        "have already been scheduled on this timeline."
+                    )
+                entry = candidate
+            elif isinstance(candidate, Animation):
+                entry = next(
+                    (e for e in self._entries if e.animation is candidate),
+                    None,
+                )
+                if entry is None:
+                    raise ValueError(
+                        "The given animation has not been scheduled on this "
+                        "Timeline yet; schedule it first or pass the "
+                        "ScheduledAnimation returned by Timeline.schedule."
+                    )
+            else:
+                raise TypeError(
+                    "Dependencies must be ScheduledAnimation or Animation "
+                    f"instances, got {type(candidate).__name__}."
+                )
+            if all(entry is not existing for existing in resolved):
+                resolved.append(entry)
+        return resolved
+
+    def _check_conflicts(self, new_entry: ScheduledAnimation) -> None:
+        """Raise :class:`TimelineConflictError` if ``new_entry`` overlaps
+        in time with an already scheduled entry while both act on at
+        least one common mobject.
+        """
+        new_mobjects = {id(m) for m in affected_mobjects(new_entry.animation)}
+        if not new_mobjects:
+            return
+        for other in self._entries:
+            if not _intervals_overlap(
+                new_entry.start, new_entry.end, other.start, other.end
+            ):
+                continue
+            other_mobjects = {id(m) for m in affected_mobjects(other.animation)}
+            if new_mobjects & other_mobjects:
+                raise TimelineConflictError(
+                    f"Cannot schedule {type(new_entry.animation).__name__} "
+                    f"at [{new_entry.start}, {new_entry.end}): it overlaps "
+                    f"with {type(other.animation).__name__} at "
+                    f"[{other.start}, {other.end}) and both animations act "
+                    f"on the same mobject."
+                )
+
+    def schedule(
+        self,
+        animation: Animation,
+        *,
+        at: float | None = None,
+        after: ScheduledAnimation | Animation | Iterable[Any] | None = None,
+        delay: float = 0.0,
+    ) -> ScheduledAnimation:
+        """Schedule an animation on the timeline.
+
+        The start time of the new entry is resolved as follows:
+
+        - If neither ``at`` nor ``after`` is given, the animation is
+          appended after all currently scheduled content: its base time is
+          the current :attr:`duration` of the timeline.
+        - If only ``at`` is given, the base time is ``at``.
+        - If only ``after`` is given, the base time is the maximum end
+          time of the referenced entries.
+        - If both are given, the base time is the later of ``at`` and the
+          maximum end time of the referenced entries.
+
+        The (non-negative) ``delay`` is always added on top of the
+        resolved base time.
+
+        After resolution, the new entry is checked against all existing
+        entries: if its time window ``[start, end)`` overlaps the window
+        of another entry and both animations act on a common mobject (in
+        the sense of :meth:`~.Animation.affected_family`), a
+        :class:`TimelineConflictError` is raised and the timeline is left
+        unchanged.
+
+        Parameters
+        ----------
+        animation
+            The :class:`~.Animation` to schedule.
+        at
+            An explicit absolute start time in seconds.  Must not be
+            negative.
+        after
+            One or more dependencies: :class:`ScheduledAnimation` entries
+            of this timeline, or :class:`~.Animation` objects that have
+            already been scheduled on this timeline.  Dependencies must
+            already exist; scheduling an entry before its dependencies is
+            not possible.
+        delay
+            An additional non-negative delay in seconds, added after the
+            base time has been resolved.
+
+        Returns
+        -------
+        ScheduledAnimation
+            The created timeline entry.
+
+        Raises
+        ------
+        TypeError
+            If ``animation`` is not an :class:`~.Animation`.
+        ValueError
+            If ``at`` or ``delay`` is negative, or if a dependency cannot
+            be resolved to an entry of this timeline.
+        TimelineConflictError
+            If the new entry would overlap in time with an existing entry
+            acting on the same mobject.
+        """
+        if not isinstance(animation, Animation):
+            raise TypeError(
+                "Only Animation instances can be scheduled on a Timeline, "
+                f"got {type(animation).__name__}."
+            )
+        if at is not None and at < 0:
+            raise ValueError(f"The start time `at` must not be negative, got {at}.")
+        if delay < 0:
+            raise ValueError(f"The delay must not be negative, got {delay}.")
+
+        dependencies = self._resolve_dependencies(after)
+        if at is None and not dependencies:
+            base = self.duration
+        elif at is None:
+            base = max(entry.end for entry in dependencies)
+        elif not dependencies:
+            base = at
+        else:
+            base = max(at, max(entry.end for entry in dependencies))
+        start = float(base + delay)
+
+        entry = ScheduledAnimation(
+            animation=animation,
+            start=start,
+            delay=float(delay),
+            dependencies=tuple(dependencies),
+            index=len(self._entries),
+        )
+        self._check_conflicts(entry)
+        self._entries.append(entry)
+        return entry
+
+    def active_at(self, time: float) -> tuple[ScheduledAnimation, ...]:
+        """Return the entries whose animations are playing at ``time``.
+
+        An entry is active during the half-open interval
+        ``[start, end)``: it is active at its exact start time and no
+        longer active at its exact end time.  Entries are returned in
+        insertion order.
+
+        Parameters
+        ----------
+        time
+            The absolute time in seconds.  Must not be negative.
+        """
+        if time < 0:
+            raise ValueError(f"The time must not be negative, got {time}.")
+        return tuple(
+            entry for entry in self._entries if entry.start <= time < entry.end
+        )
+
+    def entries_between(
+        self, start: float, end: float
+    ) -> tuple[ScheduledAnimation, ...]:
+        """Return the entries whose time window overlaps ``[start, end)``.
+
+        Windows that merely touch the given interval do not count as
+        overlapping; an empty interval (``start == end``) never overlaps
+        anything.  Entries are returned in insertion order.
+
+        Parameters
+        ----------
+        start
+            The start of the query interval in seconds.  Must not be
+            negative.
+        end
+            The end of the query interval in seconds.  Must not be smaller
+            than ``start``.
+        """
+        if start < 0:
+            raise ValueError(f"The start must not be negative, got {start}.")
+        if end < start:
+            raise ValueError(
+                f"The end ({end}) must not be smaller than the start ({start})."
+            )
+        if end == start:
+            return ()
+        return tuple(
+            entry
+            for entry in self._entries
+            if _intervals_overlap(entry.start, entry.end, start, end)
+        )
+
+    def report(self) -> list[dict[str, Any]]:
+        """Return a machine-readable overview of the schedule.
+
+        The result is a list with one dictionary per scheduled entry,
+        sorted by ``(start, index)``.  Each dictionary has exactly the
+        following keys:
+
+        - ``"index"``: the insertion index of the entry.
+        - ``"animation"``: the class name of the scheduled animation.
+        - ``"start"``: the resolved absolute start time.
+        - ``"end"``: the absolute end time (``start + run_time``).
+        - ``"run_time"``: the current run time of the animation.
+        - ``"targets"``: the sorted, de-duplicated class names of all
+          mobjects the animation acts upon (see
+          :func:`affected_type_names`).  For a :class:`~.Wait`, whose
+          :meth:`~.Animation.affected_family` is empty, this is the
+          empty list.
+        """
+        return [
+            {
+                "index": entry.index,
+                "animation": type(entry.animation).__name__,
+                "start": entry.start,
+                "end": entry.end,
+                "run_time": entry.run_time,
+                "targets": affected_type_names(entry.animation),
+            }
+            for entry in sorted(self._entries, key=lambda e: (e.start, e.index))
+        ]
+
+    def build(self) -> AnimationGroup:
+        """Build a single composite animation from the timeline.
+
+        Every scheduled entry is wrapped in a
+        ``Succession(Wait(entry.start), entry.animation)`` so that it
+        begins at its resolved start time, and all wrapped entries are
+        combined into one :class:`~.AnimationGroup` (in insertion order)
+        whose run time is the :attr:`duration` of the timeline.
+
+        Returns
+        -------
+        :class:`~.AnimationGroup`
+            The composite animation representing the whole timeline.
+
+        Raises
+        ------
+        ValueError
+            If the timeline is empty.
+        """
+        if not self._entries:
+            raise ValueError(
+                "Cannot build an animation from an empty Timeline; "
+                "schedule at least one animation first."
+            )
+        return AnimationGroup(
+            *(
+                Succession(Wait(entry.start), entry.animation)
+                for entry in self._entries
+            ),
+            run_time=self.duration,
+        )
+
+    def gaps(self) -> tuple[tuple[float, float], ...]:
+        """Return the idle intervals of the timeline.
+
+        A gap is a maximal time interval within ``[0, duration)`` during
+        which no scheduled entry is playing.  Overlapping or touching
+        entry windows are merged before the complement is computed, so
+        the returned intervals never have zero length and are sorted by
+        start time.  There is never a trailing gap after the last entry,
+        since the timeline ends at its :attr:`duration`.
+
+        Returns
+        -------
+        tuple of (float, float)
+            The ``(start, end)`` pairs of the idle intervals.  An empty
+            tuple is returned for an empty timeline and for a timeline
+            without idle time.
+        """
+        if not self._entries:
+            return ()
+        merged: list[list[float]] = []
+        for start, end in sorted((e.start, e.end) for e in self._entries):
+            if merged and start <= merged[-1][1]:
+                merged[-1][1] = max(merged[-1][1], end)
+            else:
+                merged.append([start, end])
+        idle: list[tuple[float, float]] = []
+        cursor = 0.0
+        for start, end in merged:
+            if start > cursor:
+                idle.append((cursor, start))
+            cursor = max(cursor, end)
+        return tuple(idle)
+
+    def rescale(self, factor: float) -> Timeline:
+        """Return a new timeline with all times scaled by ``factor``.
+
+        The new timeline contains, for every entry of this timeline (in
+        insertion order), a *copy* of the scheduled animation whose run
+        time is scaled by ``factor``; start times, delays and dependency
+        relations are scaled and preserved accordingly.  This timeline
+        and its animations are left untouched.
+
+        Parameters
+        ----------
+        factor
+            The scaling factor.  Must be strictly positive.
+
+        Returns
+        -------
+        Timeline
+            The rescaled timeline.
+        """
+        if factor <= 0:
+            raise ValueError(f"The rescale factor must be positive, got {factor}.")
+        scaled = Timeline()
+        mapping: dict[int, ScheduledAnimation] = {}
+        for entry in self._entries:
+            animation_copy = entry.animation.copy()
+            animation_copy.set_run_time(entry.run_time * factor)
+            base = entry.start - entry.delay
+            new_entry = scaled.schedule(
+                animation_copy,
+                at=base * factor,
+                after=[mapping[dep.index] for dep in entry.dependencies] or None,
+                delay=entry.delay * factor,
+            )
+            mapping[entry.index] = new_entry
+        return scaled
+
+    def shift(self, offset: float) -> Timeline:
+        """Return a new timeline where every start time is offset by ``offset``.
+
+        The animations themselves are deep-copied (as for
+        :meth:`rescale`) so the original timeline stays untouched.
+        Dependencies are rewired to point at the copies inside the new
+        timeline.  Shifting by a strictly negative offset is allowed as
+        long as no entry would end up with a negative start time.
+
+        Parameters
+        ----------
+        offset
+            The offset in seconds to add to every entry's start time.
+
+        Returns
+        -------
+        Timeline
+            The shifted timeline.
+
+        Raises
+        ------
+        ValueError
+            If the shift would produce a negative start time for any
+            entry.
+        """
+        if self._entries and min(entry.start for entry in self._entries) + offset < 0:
+            raise ValueError(
+                "Shifting by this offset would move at least one entry "
+                "before time zero, which is not allowed."
+            )
+        shifted = Timeline()
+        mapping: dict[int, ScheduledAnimation] = {}
+        for entry in self._entries:
+            animation_copy = entry.animation.copy()
+            animation_copy.set_run_time(entry.run_time)
+            base = entry.start + offset - entry.delay
+            new_entry = shifted.schedule(
+                animation_copy,
+                at=base,
+                after=[mapping[dep.index] for dep in entry.dependencies] or None,
+                delay=entry.delay,
+            )
+            mapping[entry.index] = new_entry
+        return shifted
+
+    def slice(self, start: float, end: float) -> Timeline:
+        """Return a new timeline containing only entries strictly inside
+        ``[start, end)``.
+
+        An entry is included when its full time window is contained in
+        ``[start, end)`` -- entries that would be cut in half are
+        dropped rather than clipped.  Start times of the surviving
+        entries are re-anchored so that the surviving window begins at
+        time zero in the new timeline, and dependencies among surviving
+        entries are preserved.
+
+        Parameters
+        ----------
+        start
+            The (non-negative) start of the slice window.
+        end
+            The end of the slice window; must not be smaller than
+            ``start``.
+
+        Returns
+        -------
+        Timeline
+            The sliced timeline (possibly empty).
+
+        Raises
+        ------
+        ValueError
+            If ``start`` is negative or ``end < start``.
+        """
+        if start < 0:
+            raise ValueError(f"The slice start must not be negative, got {start}.")
+        if end < start:
+            raise ValueError(
+                f"The slice end ({end}) must not be smaller than the start ({start})."
+            )
+        sliced = Timeline()
+        if end == start:
+            return sliced
+        mapping: dict[int, ScheduledAnimation] = {}
+        for entry in self._entries:
+            if entry.start < start or entry.end > end:
+                continue
+            animation_copy = entry.animation.copy()
+            animation_copy.set_run_time(entry.run_time)
+            base = entry.start - start - entry.delay
+            surviving_deps = [
+                mapping[dep.index] for dep in entry.dependencies if dep.index in mapping
+            ]
+            new_entry = sliced.schedule(
+                animation_copy,
+                at=base,
+                after=surviving_deps or None,
+                delay=entry.delay,
+            )
+            mapping[entry.index] = new_entry
+        return sliced
+
+    def merge(self, other: Timeline, *, offset: float | None = None) -> Timeline:
+        """Return a new timeline that plays ``self`` and ``other`` together.
+
+        Every entry of ``self`` is copied first (indices ``0 .. len(self)``),
+        followed by every entry of ``other`` shifted forward by
+        ``offset``.  When ``offset`` is :data:`None` (the default), the
+        two timelines are concatenated end-to-end using
+        ``self.duration`` as the offset, which is what you want when you
+        want ``other`` to play strictly after ``self`` finishes.
+
+        Both timelines are left untouched; all animations are deep
+        copies.  Dependencies stay local: an entry originally coming
+        from ``self`` never depends on an entry from ``other`` and vice
+        versa, so the two halves stay independent in the merged result.
+
+        Parameters
+        ----------
+        other
+            The timeline to merge into a copy of ``self``.
+        offset
+            Absolute offset added to every start time of ``other``.  If
+            :data:`None`, defaults to ``self.duration``.  Must be
+            non-negative when provided explicitly.
+
+        Returns
+        -------
+        Timeline
+            The merged timeline.
+
+        Raises
+        ------
+        TypeError
+            If ``other`` is not a :class:`Timeline`.
+        ValueError
+            If ``offset`` is explicitly given and is negative.
+        """
+        if not isinstance(other, Timeline):
+            raise TypeError(
+                "Timeline.merge requires another Timeline, got "
+                f"{type(other).__name__}."
+            )
+        if offset is None:
+            offset = self.duration
+        elif offset < 0:
+            raise ValueError(
+                f"The merge offset must not be negative, got {offset}."
+            )
+        merged = Timeline()
+        mapping_self: dict[int, ScheduledAnimation] = {}
+        for entry in self._entries:
+            animation_copy = entry.animation.copy()
+            animation_copy.set_run_time(entry.run_time)
+            base = entry.start - entry.delay
+            new_entry = merged.schedule(
+                animation_copy,
+                at=base,
+                after=[mapping_self[dep.index] for dep in entry.dependencies]
+                or None,
+                delay=entry.delay,
+            )
+            mapping_self[entry.index] = new_entry
+        mapping_other: dict[int, ScheduledAnimation] = {}
+        for entry in other._entries:
+            animation_copy = entry.animation.copy()
+            animation_copy.set_run_time(entry.run_time)
+            base = entry.start + offset - entry.delay
+            new_entry = merged.schedule(
+                animation_copy,
+                at=base,
+                after=[mapping_other[dep.index] for dep in entry.dependencies]
+                or None,
+                delay=entry.delay,
+            )
+            mapping_other[entry.index] = new_entry
+        return merged
+
+    def __add__(self, other: Timeline) -> Timeline:
+        """Concatenate two timelines end-to-end.
+
+        ``self + other`` is exactly ``self.merge(other)`` with the
+        default offset of ``self.duration``, so the second timeline
+        plays immediately after the first one finishes.
+        """
+        if not isinstance(other, Timeline):
+            return NotImplemented
+        return self.merge(other)
+
+    def tracks(self) -> tuple[tuple[ScheduledAnimation, ...], ...]:
+        """Assign every entry to a "track" using greedy interval scheduling.
+
+        Entries are considered in ``(start, index)`` order and placed on
+        the lowest-numbered track that has no time overlap with the
+        entry being placed.  This produces a valid layered layout where
+        each individual track holds entries whose time windows are
+        pairwise non-overlapping (touching windows are allowed on the
+        same track, since only strict overlap is prohibited).
+
+        The greedy assignment does not consider mobject conflicts: it
+        purely partitions entries by their time window, which is what a
+        typical timeline UI wants for a visual "row per parallel voice"
+        layout.  The number of tracks equals the maximum number of
+        simultaneously active entries.
+
+        Returns
+        -------
+        tuple of tuple of :class:`ScheduledAnimation`
+            One tuple per track, in the order tracks were created; each
+            inner tuple is sorted by start time.
+        """
+        tracks: list[list[ScheduledAnimation]] = []
+        entries_by_start = sorted(self._entries, key=lambda e: (e.start, e.index))
+        for entry in entries_by_start:
+            placed = False
+            for track in tracks:
+                last = track[-1]
+                if last.end <= entry.start:
+                    track.append(entry)
+                    placed = True
+                    break
+            if not placed:
+                tracks.append([entry])
+        return tuple(tuple(track) for track in tracks)
