+# coding: utf-8
+"""`OverlayFS` opener definition.
+"""
+
+from __future__ import absolute_import, print_function, unicode_literals
+
+import typing
+
+from .base import Opener
+from .errors import OpenerError
+from .registry import registry
+
+if typing.TYPE_CHECKING:
+    from typing import Text
+
+    from ..overlayfs import OverlayFS  # noqa: F401
+    from .parse import ParseResult
+
+
+@registry.install
+class OverlayOpener(Opener):
+    """`OverlayFS` opener.
+
+    Opens a copy-on-write overlay.  The URL resource names the *lower*
+    (read-only) filesystem as a nested FS URL; the upper (writable) layer
+    is always a fresh in-memory scratch layer.  A bare ``overlay://``
+    yields an empty scratch overlay.
+
+    Examples:
+        ``overlay://``                  -- empty scratch overlay
+        ``overlay://mem://``            -- overlay over an empty memory FS
+        ``overlay://osfs:///data``      -- writable scratch over /data
+    """
+
+    protocols = ["overlay"]
+
+    def open_fs(
+        self,
+        fs_url,  # type: Text
+        parse_result,  # type: ParseResult
+        writeable,  # type: bool
+        create,  # type: bool
+        cwd,  # type: Text
+    ):
+        # type: (...) -> OverlayFS
+        from ..memoryfs import MemoryFS
+        from ..overlayfs import OverlayFS
+
+        lower_url = parse_result.resource
+        if lower_url:
+            try:
+                lower_fs = registry.open_fs(lower_url, writeable=False, cwd=cwd)
+            except Exception as error:
+                raise OpenerError(
+                    "failed to open lower filesystem {!r}: {}".format(lower_url, error)
+                )
+        else:
+            lower_fs = MemoryFS()
+        return OverlayFS(lower_fs, MemoryFS())
