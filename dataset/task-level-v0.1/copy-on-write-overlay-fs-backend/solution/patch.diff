+# coding: utf-8
+"""Tests for the copy-on-write OverlayFS backend."""
+
+from __future__ import unicode_literals
+
+import unittest
+
+from fs.memoryfs import MemoryFS
+from fs.overlayfs import OverlayFS
+from fs.test import FSTestCases
+
+
+class TestOverlayFSConformance(FSTestCases, unittest.TestCase):
+    """Full conformance: an empty upper over an empty lower must behave
+    exactly like a plain writable filesystem."""
+
+    def make_fs(self):
+        return OverlayFS(MemoryFS(), MemoryFS())
+
+
+class TestOverlayCOW(unittest.TestCase):
+    """Targeted copy-on-write / whiteout behaviour."""
+
+    def setUp(self):
+        self.lower = MemoryFS()
+        self.lower.writetext("keep.txt", "base")
+        self.lower.makedirs("docs/sub")
+        self.lower.writetext("docs/readme.txt", "hello")
+        self.lower.writetext("docs/sub/note.txt", "note")
+        self.upper = MemoryFS()
+        self.fs = OverlayFS(self.lower, self.upper)
+
+    def test_reads_fall_through(self):
+        self.assertEqual(self.fs.readtext("keep.txt"), "base")
+        self.assertEqual(self.fs.readtext("docs/readme.txt"), "hello")
+        self.assertTrue(self.fs.isdir("docs/sub"))
+
+    def test_write_does_not_touch_lower(self):
+        self.fs.writetext("docs/readme.txt", "changed")
+        self.assertEqual(self.fs.readtext("docs/readme.txt"), "changed")
+        # Lower layer stays pristine.
+        self.assertEqual(self.lower.readtext("docs/readme.txt"), "hello")
+        # The change was materialised in the upper layer (copy-up).
+        self.assertTrue(self.upper.isfile("docs/readme.txt"))
+
+    def test_append_copies_up_content(self):
+        with self.fs.open("keep.txt", "a") as f:
+            f.write("+more")
+        self.assertEqual(self.fs.readtext("keep.txt"), "base+more")
+        self.assertEqual(self.lower.readtext("keep.txt"), "base")
+
+    def test_delete_lower_file_via_whiteout(self):
+        self.fs.remove("keep.txt")
+        self.assertFalse(self.fs.exists("keep.txt"))
+        # Lower still has it, but it is hidden.
+        self.assertTrue(self.lower.exists("keep.txt"))
+        self.assertNotIn("keep.txt", self.fs.listdir("/"))
+
+    def test_delete_then_recreate(self):
+        self.fs.remove("keep.txt")
+        self.assertFalse(self.fs.exists("keep.txt"))
+        self.fs.writetext("keep.txt", "fresh")
+        self.assertEqual(self.fs.readtext("keep.txt"), "fresh")
+        self.assertEqual(self.lower.readtext("keep.txt"), "base")
+
+    def test_removedir_lower_hidden(self):
+        self.fs.removetree("docs")
+        self.assertFalse(self.fs.exists("docs"))
+        self.assertTrue(self.lower.isdir("docs"))
+        self.assertNotIn("docs", self.fs.listdir("/"))
+
+    def test_recreated_dir_is_opaque(self):
+        # Delete a populated lower directory then recreate it: the stale
+        # lower children must not reappear.
+        self.fs.removetree("docs")
+        self.fs.makedir("docs")
+        self.assertEqual(self.fs.listdir("docs"), [])
+        self.fs.writetext("docs/new.txt", "n")
+        self.assertEqual(sorted(self.fs.listdir("docs")), ["new.txt"])
+
+    def test_listdir_merges_layers(self):
+        self.fs.writetext("upper_only.txt", "u")
+        self.assertEqual(
+            sorted(self.fs.listdir("/")), ["docs", "keep.txt", "upper_only.txt"]
+        )
+
+    def test_whiteout_marker_not_visible(self):
+        self.fs.remove("keep.txt")
+        for name in self.fs.listdir("/"):
+            self.assertFalse(name.startswith(".wh."))
+
+    def test_setinfo_copies_up(self):
+        import time
+
+        self.fs.setinfo("keep.txt", {"details": {"modified": time.time()}})
+        self.assertTrue(self.upper.isfile("keep.txt"))
+        self.assertEqual(self.lower.readtext("keep.txt"), "base")
+
+    def test_is_modified(self):
+        self.assertFalse(self.fs.is_modified("keep.txt"))
+        self.fs.writetext("keep.txt", "changed")
+        self.assertTrue(self.fs.is_modified("keep.txt"))
+
+    def test_changes_added_removed_modified(self):
+        self.fs.writetext("new.txt", "n")            # added
+        self.fs.writetext("docs/readme.txt", "chg")  # modified (copy-up)
+        self.fs.remove("keep.txt")                   # removed
+        changes = self.fs.changes()
+        self.assertIn("/new.txt", changes["added"])
+        self.assertIn("/docs/readme.txt", changes["modified"])
+        self.assertIn("/keep.txt", changes["removed"])
+        # Reserved markers never leak into the change set.
+        for group in changes.values():
+            for p in group:
+                self.assertNotIn(".wh.", p)
+
+    def test_flatten_to_collapses_layers(self):
+        self.fs.writetext("docs/readme.txt", "chg")
+        self.fs.remove("keep.txt")
+        self.fs.writetext("added.txt", "a")
+        flat = MemoryFS()
+        self.fs.flatten_to(flat)
+        self.assertEqual(flat.readtext("docs/readme.txt"), "chg")
+        self.assertEqual(flat.readtext("added.txt"), "a")
+        self.assertFalse(flat.exists("keep.txt"))
+        # No reserved markers leaked.
+        for path in flat.walk.files():
+            self.assertNotIn(".wh.", path)
+
+
+if __name__ == "__main__":
+    unittest.main()
