index 00000000..ed1f577e
--- /dev/null
+++ b/docker/orchestration/plan.py
@@ -0,0 +1,128 @@
+"""The immutable description of *what would change* -- a deployment plan.
+
+A plan is produced by :meth:`StackDeployer.plan` without touching the Docker
+Engine at all: it is a pure function of the desired stack spec and the observed
+current state.  Keeping it as plain, comparable data (rather than, say, a list
+of callbacks) is what makes the orchestrator testable and its behaviour
+predictable -- you can look at exactly what it intends to do before it does
+anything, and two runs over the same inputs produce identical plans.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+
+
+class ActionKind(str, Enum):
+    CREATE = "create"
+    RECREATE = "recreate"
+    REMOVE = "remove"
+    NOOP = "noop"
+    START = "start"
+    STOP = "stop"
+
+
+class ResourceType(str, Enum):
+    CONTAINER = "container"
+    NETWORK = "network"
+    VOLUME = "volume"
+
+
+@dataclass(frozen=True)
+class Action:
+    """A single intended change to one resource."""
+
+    kind: ActionKind
+    resource_type: ResourceType
+    resource_name: str
+    reason: str = ""
+    # Free-form data the applier needs (e.g. the service name, index, the
+    # container id to remove).  Not part of equality-relevant identity below
+    # beyond what the fields already capture, but handy for the applier.
+    detail: dict = field(default_factory=dict, compare=False)
+
+    def describe(self):
+        return "{} {} {}{}".format(
+            self.kind.value,
+            self.resource_type.value,
+            self.resource_name,
+            " ({})".format(self.reason) if self.reason else "",
+        )
+
+
+@dataclass
+class Plan:
+    """An ordered list of actions plus convenience queries over them."""
+
+    actions: list = field(default_factory=list)
+
+    @property
+    def is_noop(self):
+        """True when the plan would not change anything.
+
+        A plan consisting only of NOOP actions (or no actions at all) leaves
+        the world untouched; this is the property the idempotency guarantee is
+        expressed in terms of.
+        """
+        return all(a.kind == ActionKind.NOOP for a in self.actions)
+
+    def of_kind(self, kind):
+        return [a for a in self.actions if a.kind == kind]
+
+    def of_type(self, resource_type):
+        return [a for a in self.actions if a.resource_type == resource_type]
+
+    def changes(self):
+        """Every action that is not a NOOP."""
+        return [a for a in self.actions if a.kind != ActionKind.NOOP]
+
+    def summary(self):
+        """A stable multi-line human-readable rendering of the plan."""
+        if not self.actions:
+            return "empty plan"
+        lines = []
+        counts = {}
+        for action in self.actions:
+            counts[action.kind] = counts.get(action.kind, 0) + 1
+            lines.append("  " + action.describe())
+        header = ", ".join(
+            "{} {}".format(counts[k], k.value)
+            for k in ActionKind
+            if k in counts
+        )
+        return header + "\n" + "\n".join(lines)
+
+    def __iter__(self):
+        return iter(self.actions)
+
+    def __len__(self):
+        return len(self.actions)
+
+
+@dataclass
+class ApplyResult:
+    """What actually happened when a plan was applied."""
+
+    executed: list = field(default_factory=list)   # [Action]
+    skipped: list = field(default_factory=list)     # [Action] (NOOPs)
+    created_ids: dict = field(default_factory=dict)  # container name -> id
+
+    def add_executed(self, action):
+        self.executed.append(action)
+
+    def add_skipped(self, action):
+        self.skipped.append(action)
+
+
+@dataclass
+class ServiceStatus:
+    """A snapshot of one managed container, as reported by ``ps``."""
+
+    service: str
+    index: int
+    name: str
+    container_id: str
+    state: str
+    config_hash: str
+    up_to_date: bool
