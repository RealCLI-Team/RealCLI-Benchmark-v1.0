index 00000000..ca9f11fa
--- /dev/null
+++ b/docker/orchestration/naming.py
@@ -0,0 +1,60 @@
+"""Deterministic resource names and managed labels.
+
+The orchestrator needs to be able to recognise, on a later run, the resources
+it created on an earlier one.  It does that purely from names and labels -- it
+keeps no state of its own -- so those names and labels have to be derived by a
+single, well-defined convention.  Centralising that convention here keeps the
+planner, the applier and the grader honest: there is exactly one place that
+decides what a managed container is called.
+"""
+
+from __future__ import annotations
+
+LABEL_PREFIX = "com.orchestra"
+
+LABEL_PROJECT = LABEL_PREFIX + ".project"
+LABEL_SERVICE = LABEL_PREFIX + ".service"
+LABEL_NUMBER = LABEL_PREFIX + ".number"
+LABEL_CONFIG_HASH = LABEL_PREFIX + ".config-hash"
+LABEL_NETWORK = LABEL_PREFIX + ".network"
+LABEL_VOLUME = LABEL_PREFIX + ".volume"
+
+
+def container_name(project, service, index):
+    return "{}_{}_{}".format(project, service, index)
+
+
+def network_name(project, network):
+    return "{}_{}".format(project, network)
+
+
+def volume_name(project, volume):
+    return "{}_{}".format(project, volume)
+
+
+def container_labels(project, service, index, config_hash, user_labels=None):
+    labels = dict(user_labels or {})
+    labels[LABEL_PROJECT] = project
+    labels[LABEL_SERVICE] = service
+    labels[LABEL_NUMBER] = str(index)
+    labels[LABEL_CONFIG_HASH] = config_hash
+    return labels
+
+
+def network_labels(project, network, user_labels=None):
+    labels = dict(user_labels or {})
+    labels[LABEL_PROJECT] = project
+    labels[LABEL_NETWORK] = network
+    return labels
+
+
+def volume_labels(project, volume, user_labels=None):
+    labels = dict(user_labels or {})
+    labels[LABEL_PROJECT] = project
+    labels[LABEL_VOLUME] = volume
+    return labels
+
+
+def project_filter(project):
+    """A ``filters`` dict selecting a project's managed resources."""
+    return {"label": "{}={}".format(LABEL_PROJECT, project)}
