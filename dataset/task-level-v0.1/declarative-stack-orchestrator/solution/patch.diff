index 00000000..b0aff643
--- /dev/null
+++ b/docker/orchestration/__init__.py
@@ -0,0 +1,103 @@
+"""Declarative multi-container stack orchestration for docker-py.
+
+This package sits on top of :class:`docker.api.APIClient` and lets you describe
+a set of related containers -- with their networks, volumes and start-up
+dependencies -- as a single declarative document, then reconcile the running
+world towards that description.
+
+The design mirrors the way infrastructure tools work in the large: a *pure*
+planning phase that decides what needs to change, and a separate apply phase
+that carries the plan out.  Because planning never mutates anything, you can
+inspect exactly what a deployment would do before committing to it, and because
+the orchestrator recognises its own resources purely by label, applying the
+same spec twice is a no-op the second time.
+
+Typical use::
+
+    import docker
+    from docker.orchestration import StackDeployer, StackSpec
+
+    api = docker.APIClient()
+    spec = StackSpec.from_dict({
+        "services": {
+            "db": {"image": "postgres:16"},
+            "web": {
+                "image": "nginx:latest",
+                "depends_on": {"db": {"condition": "service_healthy"}},
+                "ports": ["80:8080"],
+            },
+        },
+    })
+    deployer = StackDeployer(api, project_name="demo")
+    plan = deployer.plan(spec)      # inspect first...
+    if not plan.is_noop:
+        deployer.up(spec)           # ...then apply
+"""
+
+from __future__ import annotations
+
+from .deployer import StackDeployer
+from .errors import (
+    CyclicDependencyError,
+    DeploymentError,
+    HealthCheckTimeout,
+    OrchestrationError,
+    SpecError,
+    UnknownDependencyError,
+)
+from .interpolation import (
+    InterpolationError,
+    interpolate,
+    parse_env_file,
+)
+from .loader import (
+    deep_merge,
+    load_stack,
+    merge_documents,
+    select_profiles,
+)
+from .plan import (
+    Action,
+    ActionKind,
+    ApplyResult,
+    Plan,
+    ResourceType,
+    ServiceStatus,
+)
+from .spec import (
+    HealthcheckSpec,
+    MountSpec,
+    NetworkSpec,
+    ServiceSpec,
+    StackSpec,
+    VolumeSpec,
+)
+
+__all__ = [
+    "StackDeployer",
+    "StackSpec",
+    "ServiceSpec",
+    "NetworkSpec",
+    "VolumeSpec",
+    "MountSpec",
+    "HealthcheckSpec",
+    "Plan",
+    "Action",
+    "ActionKind",
+    "ResourceType",
+    "ApplyResult",
+    "ServiceStatus",
+    "OrchestrationError",
+    "SpecError",
+    "UnknownDependencyError",
+    "CyclicDependencyError",
+    "DeploymentError",
+    "HealthCheckTimeout",
+    "InterpolationError",
+    "interpolate",
+    "parse_env_file",
+    "load_stack",
+    "merge_documents",
+    "deep_merge",
+    "select_profiles",
+]
diff --git a/docker/orchestration/deployer.py b/docker/orchestration/deployer.py
new file mode 100644
index 00000000..28bb7940
--- /dev/null
+++ b/docker/orchestration/deployer.py
@@ -0,0 +1,507 @@
+"""Turn a declarative stack spec into Docker Engine API calls.
+
+:class:`StackDeployer` is the heart of the package.  It follows a strict
+plan/apply split:
+
+* :meth:`plan` is a *pure* function -- it reads the current state once and
+  returns a :class:`~docker.orchestration.plan.Plan` describing what it would
+  do, without making a single change.
+* :meth:`up` calls :meth:`plan` and then executes the resulting actions in
+  order, translating each into the appropriate ``APIClient`` calls.
+* :meth:`down` removes everything the project owns, in the reverse of creation
+  order, and :meth:`ps` reports what is currently running.
+
+The class never stores state between calls; the source of truth is always the
+Docker Engine, queried through the managed labels.  That is what makes ``up``
+idempotent: running it twice over an unchanged spec produces an all-NOOP plan
+on the second run.
+"""
+
+from __future__ import annotations
+
+import time
+
+from . import naming
+from .errors import DeploymentError, HealthCheckTimeout
+from .plan import (
+    Action,
+    ActionKind,
+    ApplyResult,
+    Plan,
+    ResourceType,
+    ServiceStatus,
+)
+from .spec import StackSpec
+from .state import CurrentState
+
+
+class StackDeployer:
+    """Deploy and reconcile a declarative stack against a Docker Engine."""
+
+    def __init__(self, api_client, project_name, sleeper=None,
+                 health_attempts=30):
+        self.api = api_client
+        self.project = project_name
+        # Injected so tests (and the health gate) do not sleep in real time.
+        self._sleep = sleeper if sleeper is not None else time.sleep
+        self.health_attempts = health_attempts
+
+    # ------------------------------------------------------------------
+    # Planning (pure)
+    # ------------------------------------------------------------------
+
+    def plan(self, spec):
+        """Return the :class:`Plan` that would reconcile *spec*.
+
+        Reads current state exactly once; performs no mutations.  The action
+        order is: networks to create, volumes to create, containers in
+        dependency order (create/recreate/noop), then orphan containers,
+        networks and volumes to remove.
+        """
+        if not isinstance(spec, StackSpec):
+            spec = StackSpec.from_dict(spec)
+
+        state = CurrentState.observe(self.api, self.project)
+        order = spec.topological_order()
+
+        actions = []
+
+        # 1. Networks that do not yet exist.
+        for net_name in sorted(spec.networks):
+            if net_name not in state.networks:
+                actions.append(Action(
+                    kind=ActionKind.CREATE,
+                    resource_type=ResourceType.NETWORK,
+                    resource_name=naming.network_name(self.project, net_name),
+                    reason="network not present",
+                    detail={"logical": net_name},
+                ))
+
+        # 2. Volumes that do not yet exist.
+        for vol_name in sorted(spec.volumes):
+            if vol_name not in state.volumes:
+                actions.append(Action(
+                    kind=ActionKind.CREATE,
+                    resource_type=ResourceType.VOLUME,
+                    resource_name=naming.volume_name(self.project, vol_name),
+                    reason="volume not present",
+                    detail={"logical": vol_name},
+                ))
+
+        # 3. Containers, in dependency order.
+        desired_keys = set()
+        for service_name in order:
+            service = spec.services[service_name]
+            cfg_hash = service.config_hash()
+            for index in range(1, service.replicas + 1):
+                key = (service_name, index)
+                desired_keys.add(key)
+                cname = naming.container_name(self.project, service_name, index)
+                existing = state.containers.get(key)
+                detail = {
+                    "service": service_name,
+                    "index": index,
+                    "config_hash": cfg_hash,
+                }
+                if existing is None:
+                    actions.append(Action(
+                        kind=ActionKind.CREATE,
+                        resource_type=ResourceType.CONTAINER,
+                        resource_name=cname,
+                        reason="container not present",
+                        detail=detail,
+                    ))
+                elif existing.config_hash != cfg_hash:
+                    actions.append(Action(
+                        kind=ActionKind.RECREATE,
+                        resource_type=ResourceType.CONTAINER,
+                        resource_name=cname,
+                        reason="configuration changed",
+                        detail=dict(detail, old_id=existing.id),
+                    ))
+                else:
+                    actions.append(Action(
+                        kind=ActionKind.NOOP,
+                        resource_type=ResourceType.CONTAINER,
+                        resource_name=cname,
+                        reason="up to date",
+                        detail=dict(detail, id=existing.id),
+                    ))
+
+        # 4. Orphan containers -- managed by us, no longer desired.
+        #    Removed in reverse dependency order so dependents die first.
+        orphan_containers = [
+            mc for key, mc in state.containers.items()
+            if key not in desired_keys
+        ]
+        orphan_containers.sort(
+            key=lambda mc: (order.index(mc.service)
+                            if mc.service in order else -1, mc.index),
+            reverse=True,
+        )
+        for mc in orphan_containers:
+            actions.append(Action(
+                kind=ActionKind.REMOVE,
+                resource_type=ResourceType.CONTAINER,
+                resource_name=mc.name,
+                reason="not in spec",
+                detail={"id": mc.id, "service": mc.service, "index": mc.index},
+            ))
+
+        # 5. Orphan networks and volumes.
+        for logical, mr in sorted(state.networks.items()):
+            if logical not in spec.networks:
+                actions.append(Action(
+                    kind=ActionKind.REMOVE,
+                    resource_type=ResourceType.NETWORK,
+                    resource_name=mr.name,
+                    reason="not in spec",
+                    detail={"id": mr.id, "logical": logical},
+                ))
+        for logical, mr in sorted(state.volumes.items()):
+            if logical not in spec.volumes:
+                actions.append(Action(
+                    kind=ActionKind.REMOVE,
+                    resource_type=ResourceType.VOLUME,
+                    resource_name=mr.name,
+                    reason="not in spec",
+                    detail={"id": mr.id, "logical": logical},
+                ))
+
+        return Plan(actions=actions)
+
+    # ------------------------------------------------------------------
+    # Applying
+    # ------------------------------------------------------------------
+
+    def up(self, spec, wait=False):
+        """Plan and then apply, returning an :class:`ApplyResult`."""
+        if not isinstance(spec, StackSpec):
+            spec = StackSpec.from_dict(spec)
+
+        plan = self.plan(spec)
+        result = ApplyResult()
+
+        for action in plan.actions:
+            if action.kind == ActionKind.NOOP:
+                result.add_skipped(action)
+                continue
+            try:
+                self._apply_action(action, spec, result, wait=wait)
+            except DeploymentError:
+                raise
+            except Exception as exc:  # pragma: no cover - defensive
+                raise DeploymentError(
+                    "failed to apply {}: {}".format(action.describe(), exc),
+                    action=action,
+                    cause=exc,
+                ) from exc
+            result.add_executed(action)
+
+        return result
+
+    def _apply_action(self, action, spec, result, wait):
+        if action.resource_type == ResourceType.NETWORK:
+            if action.kind == ActionKind.CREATE:
+                self._create_network(spec, action.detail["logical"])
+            elif action.kind == ActionKind.REMOVE:
+                self.api.remove_network(action.detail["id"])
+        elif action.resource_type == ResourceType.VOLUME:
+            if action.kind == ActionKind.CREATE:
+                self._create_volume(spec, action.detail["logical"])
+            elif action.kind == ActionKind.REMOVE:
+                self.api.remove_volume(action.detail["id"], force=True)
+        elif action.resource_type == ResourceType.CONTAINER:
+            if action.kind in (ActionKind.CREATE, ActionKind.RECREATE):
+                if action.kind == ActionKind.RECREATE:
+                    old_id = action.detail.get("old_id")
+                    if old_id:
+                        self.api.stop(old_id)
+                        self.api.remove_container(old_id, force=True)
+                cid = self._create_container(spec, action)
+                result.created_ids[action.resource_name] = cid
+                self.api.start(cid)
+                self._gate_on_dependencies(spec, action)
+            elif action.kind == ActionKind.REMOVE:
+                self.api.stop(action.detail["id"])
+                self.api.remove_container(action.detail["id"], force=True)
+
+    def _create_network(self, spec, logical):
+        net = spec.networks[logical]
+        self.api.create_network(
+            name=naming.network_name(self.project, logical),
+            driver=net.driver,
+            options=net.options or None,
+            internal=net.internal,
+            attachable=net.attachable,
+            labels=naming.network_labels(self.project, logical, net.labels),
+        )
+
+    def _create_volume(self, spec, logical):
+        vol = spec.volumes[logical]
+        self.api.create_volume(
+            name=naming.volume_name(self.project, logical),
+            driver=vol.driver,
+            driver_opts=vol.driver_opts or None,
+            labels=naming.volume_labels(self.project, logical, vol.labels),
+        )
+
+    def _create_container(self, spec, action):
+        service = spec.services[action.detail["service"]]
+        index = action.detail["index"]
+        cfg_hash = action.detail["config_hash"]
+        name = action.resource_name
+
+        host_config = self._build_host_config(spec, service)
+        networking_config = self._build_networking_config(spec, service, index)
+
+        labels = naming.container_labels(
+            self.project, service.name, index, cfg_hash, service.labels
+        )
+
+        kwargs = dict(
+            image=service.image,
+            name=name,
+            command=service.command,
+            entrypoint=service.entrypoint,
+            environment=(
+                dict(sorted(service.environment.items()))
+                if service.environment else None
+            ),
+            labels=labels,
+            host_config=host_config,
+            networking_config=networking_config,
+        )
+        if service.user is not None:
+            kwargs["user"] = service.user
+        if service.working_dir is not None:
+            kwargs["working_dir"] = service.working_dir
+        if service.healthcheck is not None:
+            kwargs["healthcheck"] = service.healthcheck.to_payload()
+        if service.ports:
+            kwargs["ports"] = [
+                (p[0], p[2]) for p in service.ports
+            ]
+
+        created = self.api.create_container(**kwargs)
+        # ``create_container`` returns {'Id': ...}; be forgiving about shape.
+        if isinstance(created, dict):
+            return created.get("Id") or created.get("id") or name
+        return created or name
+
+    def _build_host_config(self, spec, service):
+        binds = []
+        for mount in service.mounts:
+            if mount.is_volume and mount.volume is not None:
+                source = naming.volume_name(self.project, mount.volume)
+            else:
+                source = mount.source
+            if source is None:
+                continue
+            suffix = ":ro" if mount.read_only else ":rw"
+            binds.append("{}:{}{}".format(source, mount.target, suffix))
+
+        port_bindings = {}
+        for container_port, host, proto in service.ports:
+            if host is None:
+                continue
+            key = "{}/{}".format(container_port, proto)
+            port_bindings[key] = host
+
+        hc_kwargs = {}
+        if binds:
+            hc_kwargs["binds"] = binds
+        if port_bindings:
+            hc_kwargs["port_bindings"] = port_bindings
+        if service.restart and service.restart != "no":
+            hc_kwargs["restart_policy"] = {"Name": service.restart}
+
+        return self.api.create_host_config(**hc_kwargs)
+
+    def _build_networking_config(self, spec, service, index):
+        endpoints = {}
+        for net_logical in sorted(service.networks):
+            full = naming.network_name(self.project, net_logical)
+            aliases = [service.name]
+            endpoints[full] = self.api.create_endpoint_config(
+                aliases=aliases,
+            )
+        if not endpoints:
+            return None
+        return self.api.create_networking_config(endpoints)
+
+    def _gate_on_dependencies(self, spec, action):
+        """Block until this container's healthy-gated dependencies are up.
+
+        Only dependencies declared with ``condition: service_healthy`` gate;
+        ``service_started`` is satisfied as soon as the dependency's container
+        has been started, which -- because we apply in dependency order -- has
+        already happened by the time we get here.
+        """
+        service = spec.services[action.detail["service"]]
+        for dep, condition in sorted(service.depends_on.items()):
+            if condition != "service_healthy":
+                continue
+            dep_service = spec.services[dep]
+            for dep_index in range(1, dep_service.replicas + 1):
+                dep_name = naming.container_name(self.project, dep, dep_index)
+                self._wait_healthy(dep_name)
+
+    def _wait_healthy(self, container):
+        for attempt in range(self.health_attempts):
+            info = self.api.inspect_container(container)
+            state = (info or {}).get("State", {}) or {}
+            health = state.get("Health", {}) or {}
+            status = health.get("Status")
+            if status == "healthy":
+                return
+            if status is None and state.get("Running"):
+                # No healthcheck defined but the container is running: treat
+                # "running" as good enough rather than spinning forever.
+                return
+            self._sleep(1)
+        raise HealthCheckTimeout(container, self.health_attempts)
+
+    # ------------------------------------------------------------------
+    # Teardown & status
+    # ------------------------------------------------------------------
+
+    def down(self, spec=None):
+        """Remove every resource owned by this project.
+
+        Containers are stopped and removed first (reverse dependency order
+        when a spec is supplied so dependents die before their dependencies),
+        then networks, then volumes.
+        """
+        state = CurrentState.observe(self.api, self.project)
+        result = ApplyResult()
+
+        containers = list(state.containers.values())
+        if spec is not None:
+            if not isinstance(spec, StackSpec):
+                spec = StackSpec.from_dict(spec)
+            order = spec.topological_order()
+            containers.sort(
+                key=lambda mc: (order.index(mc.service)
+                                if mc.service in order else -1, mc.index),
+                reverse=True,
+            )
+        else:
+            containers.sort(key=lambda mc: (mc.service, mc.index), reverse=True)
+
+        for mc in containers:
+            self.api.stop(mc.id)
+            self.api.remove_container(mc.id, force=True)
+            result.add_executed(Action(
+                kind=ActionKind.REMOVE,
+                resource_type=ResourceType.CONTAINER,
+                resource_name=mc.name,
+                reason="down",
+                detail={"id": mc.id},
+            ))
+
+        for logical, mr in sorted(state.networks.items()):
+            self.api.remove_network(mr.id)
+            result.add_executed(Action(
+                kind=ActionKind.REMOVE,
+                resource_type=ResourceType.NETWORK,
+                resource_name=mr.name,
+                reason="down",
+                detail={"id": mr.id},
+            ))
+
+        for logical, mr in sorted(state.volumes.items()):
+            self.api.remove_volume(mr.id, force=True)
+            result.add_executed(Action(
+                kind=ActionKind.REMOVE,
+                resource_type=ResourceType.VOLUME,
+                resource_name=mr.name,
+                reason="down",
+                detail={"id": mr.id},
+            ))
+
+        return result
+
+    def ps(self, spec=None):
+        """Return a :class:`ServiceStatus` per managed container.
+
+        When *spec* is supplied, each status's ``up_to_date`` flag reflects
+        whether the running container's recorded config-hash still matches the
+        hash the spec would produce -- i.e. whether a subsequent ``up`` would
+        leave it alone (``True``) or recreate it (``False``).  Without a spec
+        there is nothing to compare against, so everything is reported
+        up to date.
+        """
+        state = CurrentState.observe(self.api, self.project)
+
+        desired_hashes = {}
+        if spec is not None:
+            if not isinstance(spec, StackSpec):
+                spec = StackSpec.from_dict(spec)
+            for name, service in spec.services.items():
+                desired_hashes[name] = service.config_hash()
+
+        statuses = []
+        for (service, index), mc in sorted(state.containers.items()):
+            if spec is not None:
+                wanted = desired_hashes.get(service)
+                up_to_date = wanted is not None and wanted == mc.config_hash
+            else:
+                up_to_date = True
+            statuses.append(ServiceStatus(
+                service=service,
+                index=index,
+                name=mc.name,
+                container_id=mc.id,
+                state=mc.status,
+                config_hash=mc.config_hash,
+                up_to_date=up_to_date,
+            ))
+        return statuses
+
+    def config(self, spec):
+        """Return the fully-resolved, canonical view of *spec*.
+
+        This is the moral equivalent of ``docker compose config``: it does not
+        touch the Engine at all, it simply reports -- in a stable, ordering
+        independent form -- exactly what the orchestrator understands the
+        stack to be, including the managed names each service's containers
+        would receive and the config-hash that governs recreation.  It is
+        useful both as a debugging aid and as a way to diff two stack
+        documents without deploying either.
+        """
+        if not isinstance(spec, StackSpec):
+            spec = StackSpec.from_dict(spec)
+
+        order = spec.topological_order()
+        services = {}
+        for name in order:
+            service = spec.services[name]
+            cfg_hash = service.config_hash()
+            containers = [
+                naming.container_name(self.project, name, index)
+                for index in range(1, service.replicas + 1)
+            ]
+            services[name] = {
+                "config": service.canonical(),
+                "config_hash": cfg_hash,
+                "containers": containers,
+                "depends_on": dict(sorted(service.depends_on.items())),
+            }
+
+        networks = {
+            name: naming.network_name(self.project, name)
+            for name in sorted(spec.networks)
+        }
+        volumes = {
+            name: naming.volume_name(self.project, name)
+            for name in sorted(spec.volumes)
+        }
+
+        return {
+            "project": self.project,
+            "order": order,
+            "services": services,
+            "networks": networks,
+            "volumes": volumes,
+        }
diff --git a/docker/orchestration/errors.py b/docker/orchestration/errors.py
new file mode 100644
index 00000000..1f327cb7
--- /dev/null
+++ b/docker/orchestration/errors.py
@@ -0,0 +1,83 @@
+"""Exceptions raised by the declarative stack orchestrator.
+
+All orchestration errors derive from :class:`OrchestrationError` so that a
+caller can catch the whole family with a single ``except`` clause while still
+being able to distinguish the individual failure modes when it matters.
+
+The hierarchy is intentionally shallow and explicit -- every distinct thing
+that can go wrong while turning a declarative stack description into a set of
+Docker Engine API calls has its own class, because the difference between (for
+example) "your spec refers to a service that does not exist" and "your spec has
+a dependency cycle" is exactly the sort of thing a user needs to be told
+precisely.
+"""
+
+from __future__ import annotations
+
+
+class OrchestrationError(Exception):
+    """Base class for every error raised by :mod:`docker.orchestration`."""
+
+
+class SpecError(OrchestrationError):
+    """The declarative stack description is malformed or self-inconsistent.
+
+    Raised while parsing/validating a stack mapping into the typed
+    :class:`~docker.orchestration.spec.StackSpec` -- for instance when a
+    service is missing its ``image``, when a port mapping cannot be parsed, or
+    when a mount points at a volume that the stack never declares.
+    """
+
+
+class UnknownDependencyError(SpecError):
+    """A service's ``depends_on`` names a service the stack does not define."""
+
+    def __init__(self, service, dependency):
+        self.service = service
+        self.dependency = dependency
+        super().__init__(
+            "service {!r} depends on unknown service {!r}".format(
+                service, dependency
+            )
+        )
+
+
+class CyclicDependencyError(SpecError):
+    """The ``depends_on`` graph contains a cycle and cannot be ordered."""
+
+    def __init__(self, cycle):
+        # ``cycle`` is a list of service names forming the loop, e.g.
+        # ["web", "api", "web"].
+        self.cycle = list(cycle)
+        super().__init__(
+            "service dependency cycle detected: {}".format(
+                " -> ".join(self.cycle)
+            )
+        )
+
+
+class DeploymentError(OrchestrationError):
+    """Applying a plan against the Docker Engine failed.
+
+    Carries the offending :class:`~docker.orchestration.plan.Action` (when the
+    failure can be attributed to one) and the underlying exception so callers
+    can inspect or re-raise as they see fit.
+    """
+
+    def __init__(self, message, action=None, cause=None):
+        self.action = action
+        self.cause = cause
+        super().__init__(message)
+
+
+class HealthCheckTimeout(DeploymentError):
+    """A dependency never reached the ``healthy`` state within the budget."""
+
+    def __init__(self, container, attempts):
+        self.container = container
+        self.attempts = attempts
+        super().__init__(
+            "container {!r} did not become healthy after {} checks".format(
+                container, attempts
+            )
+        )
