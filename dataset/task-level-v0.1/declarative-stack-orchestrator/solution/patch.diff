+"""Observe the *current* state of a project's managed resources.
+
+The planner needs to know what already exists before it can decide what to
+create, recreate or remove.  This module is the only part of the planning path
+that reads from the Docker Engine, and it does so exclusively through the
+public :class:`docker.api.APIClient` surface -- ``containers``, ``networks``
+and ``volumes`` with a label filter -- so it works against a real daemon and
+against a mocked client in exactly the same way.
+
+Everything is keyed by the managed labels defined in
+:mod:`docker.orchestration.naming`; a resource without the project label is
+simply invisible to the orchestrator, which is what stops it from trampling
+containers it did not create.
+"""
+
+from __future__ import annotations
+
+from . import naming
+
+
+class ManagedContainer:
+    """A lightweight view over one ``docker ps`` entry we manage."""
+
+    __slots__ = ("id", "name", "service", "index", "config_hash", "status",
+                 "labels", "raw")
+
+    def __init__(self, raw):
+        self.raw = raw
+        self.id = raw.get("Id") or raw.get("ID") or ""
+        names = raw.get("Names") or []
+        # The Engine prefixes container names with '/'; strip it so the value
+        # matches what we asked to be created.
+        self.name = (names[0].lstrip("/") if names else raw.get("Name", ""))
+        labels = raw.get("Labels") or {}
+        self.labels = labels
+        self.service = labels.get(naming.LABEL_SERVICE, "")
+        try:
+            self.index = int(labels.get(naming.LABEL_NUMBER, "0"))
+        except (TypeError, ValueError):
+            self.index = 0
+        self.config_hash = labels.get(naming.LABEL_CONFIG_HASH, "")
+        self.status = raw.get("State") or raw.get("Status") or ""
+
+    @property
+    def key(self):
+        return (self.service, self.index)
+
+
+class ManagedResource:
+    """A managed network or volume."""
+
+    __slots__ = ("id", "name", "labels", "logical", "raw")
+
+    def __init__(self, raw, logical_label):
+        self.raw = raw
+        self.id = raw.get("Id") or raw.get("ID") or raw.get("Name", "")
+        self.name = raw.get("Name", "")
+        self.labels = raw.get("Labels") or {}
+        self.logical = self.labels.get(logical_label, "")
+
+
+class CurrentState:
+    """Everything the orchestrator can currently see for one project."""
+
+    def __init__(self, containers, networks, volumes):
+        # containers: {(service, index): ManagedContainer}
+        self.containers = containers
+        # networks/volumes: {logical_name: ManagedResource}
+        self.networks = networks
+        self.volumes = volumes
+
+    @classmethod
+    def observe(cls, api, project):
+        flt = naming.project_filter(project)
+
+        containers = {}
+        for raw in api.containers(all=True, filters=flt):
+            mc = ManagedContainer(raw)
+            if mc.service:
+                containers[mc.key] = mc
+
+        networks = {}
+        for raw in api.networks(filters=flt):
+            mr = ManagedResource(raw, naming.LABEL_NETWORK)
+            if mr.logical:
+                networks[mr.logical] = mr
+
+        volumes = {}
+        raw_volumes = api.volumes(filters=flt)
+        # ``APIClient.volumes`` returns {'Volumes': [...], 'Warnings': ...}.
+        if isinstance(raw_volumes, dict):
+            raw_volume_list = raw_volumes.get("Volumes") or []
+        else:
+            raw_volume_list = raw_volumes or []
+        for raw in raw_volume_list:
+            mr = ManagedResource(raw, naming.LABEL_VOLUME)
+            if mr.logical:
+                volumes[mr.logical] = mr
+
+        return cls(containers, networks, volumes)
