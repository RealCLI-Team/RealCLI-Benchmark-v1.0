+++ b/docker/orchestration/interpolation.py
@@ -0,0 +1,157 @@
+"""Variable interpolation for stack documents.
+
+Real-world declarative stacks are rarely fully static: they carry
+``${VARIABLE}`` references that are resolved against the environment at load
+time, so the same document can describe a dev and a prod deployment.  This
+module implements that substitution with the shell-like semantics people
+expect from compose files, before the document is ever handed to
+:class:`~docker.orchestration.spec.StackSpec`.
+
+Supported forms (mirroring the POSIX ``${...}`` family):
+
+* ``${VAR}`` / ``$VAR``        -- value, or "" (and a warning) if unset
+* ``${VAR:-default}``          -- value if set *and non-empty*, else default
+* ``${VAR-default}``           -- value if set (even if empty), else default
+* ``${VAR:?message}``          -- value if set and non-empty, else raise
+* ``${VAR?message}``           -- value if set, else raise
+* ``$$``                       -- a literal ``$`` (escape)
+
+Interpolation is applied recursively to every string leaf of the mapping;
+keys, numbers, booleans and ``None`` are passed through untouched.
+"""
+
+from __future__ import annotations
+
+import re
+
+from .errors import SpecError
+
+# Matches either an escaped ``$$`` or a ``$NAME`` / ``${...}`` reference.  We
+# capture the two cases separately so the substitution callback can tell an
+# escape from a real reference.
+_PATTERN = re.compile(
+    r"""
+    \$(?:
+        (?P<escaped>\$)                       # $$  -> literal $
+      | (?P<braced>\{                          # ${ ... }
+            (?P<bname>[A-Za-z_][A-Za-z0-9_]*)
+            (?:
+                (?P<op>:?[-?])
+                (?P<arg>[^}]*)
+            )?
+        \})
+      | (?P<named>[A-Za-z_][A-Za-z0-9_]*)      # $NAME
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+class InterpolationError(SpecError):
+    """A ``${VAR:?message}`` reference was required but unset."""
+
+
+def interpolate(value, mapping, path="<stack>"):
+    """Recursively interpolate ``${VAR}`` references in *value*.
+
+    *mapping* is the source of variable values (typically ``os.environ`` or a
+    dict loaded from an env file).  *path* is used only to make error messages
+    point at the offending location.
+    """
+    if isinstance(value, str):
+        return _interpolate_string(value, mapping, path)
+    if isinstance(value, dict):
+        result = {}
+        for key, item in value.items():
+            child = "{}.{}".format(path, key)
+            result[key] = interpolate(item, mapping, child)
+        return result
+    if isinstance(value, (list, tuple)):
+        return [
+            interpolate(item, mapping, "{}[{}]".format(path, i))
+            for i, item in enumerate(value)
+        ]
+    # numbers / bools / None are returned unchanged.
+    return value
+
+
+def _interpolate_string(text, mapping, path):
+    def replace(match):
+        if match.group("escaped"):
+            return "$"
+        if match.group("named"):
+            name = match.group("named")
+            return _lookup(name, None, None, mapping, path)
+        # braced
+        name = match.group("bname")
+        op = match.group("op")
+        arg = match.group("arg")
+        return _lookup(name, op, arg, mapping, path)
+
+    return _PATTERN.sub(replace, text)
+
+
+def _lookup(name, op, arg, mapping, path):
+    present = name in mapping
+    raw = mapping.get(name)
+    value = "" if raw is None else str(raw)
+    non_empty = present and value != ""
+
+    if op is None:
+        if not present:
+            # Unset variables become the empty string, matching compose.
+            return ""
+        return value
+
+    if op == ":-":
+        return value if non_empty else (arg or "")
+    if op == "-":
+        return value if present else (arg or "")
+    if op == ":?":
+        if not non_empty:
+            raise InterpolationError(
+                "{}: required variable {!r} is unset or empty{}".format(
+                    path, name, ": " + arg if arg else ""
+                )
+            )
+        return value
+    if op == "?":
+        if not present:
+            raise InterpolationError(
+                "{}: required variable {!r} is unset{}".format(
+                    path, name, ": " + arg if arg else ""
+                )
+            )
+        return value
+    # Unknown operator: leave the reference verbatim rather than guessing.
+    return "${{{}{}{}}}".format(name, op or "", arg or "")
+
+
+def parse_env_file(text):
+    """Parse ``KEY=value`` lines (an env file) into a dict.
+
+    Blank lines and ``#`` comments are ignored; surrounding single or double
+    quotes on the value are stripped; ``export KEY=value`` is accepted.  This
+    is intentionally small -- it is not a shell -- but it covers the common
+    shape of the ``.env`` files people keep next to their stacks.
+    """
+    result = {}
+    for lineno, raw in enumerate(text.splitlines(), start=1):
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.startswith("export "):
+            line = line[len("export "):].lstrip()
+        if "=" not in line:
+            raise SpecError(
+                "env file line {}: expected KEY=value, got {!r}".format(
+                    lineno, raw
+                )
+            )
+        key, value = line.split("=", 1)
+        key = key.strip()
+        value = value.strip()
+        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
+            value = value[1:-1]
+        result[key] = value
+    return result
