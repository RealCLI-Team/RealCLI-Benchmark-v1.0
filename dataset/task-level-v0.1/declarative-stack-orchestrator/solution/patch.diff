index 00000000..d7468f12
--- /dev/null
+++ b/docker/orchestration/loader.py
@@ -0,0 +1,162 @@
+"""Assemble a single stack document from layered sources.
+
+Deployments in practice are described not by one document but by a base plus
+overrides -- a common ``stack.yml`` plus an environment-specific
+``stack.prod.yml`` -- and by *profiles* that switch optional services on and
+off.  This module turns those layered inputs into the single, fully-resolved
+mapping that :class:`~docker.orchestration.spec.StackSpec` consumes, applying
+three transformations in order:
+
+1. **interpolation** of ``${VAR}`` references (delegated to
+   :mod:`docker.orchestration.interpolation`),
+2. **deep merge** of successive documents, with well-defined rules for how
+   mappings, lists and scalars combine, and
+3. **profile selection**, dropping services whose ``profiles`` are not active.
+
+Keeping this separate from parsing means the merge rules -- which are fiddly
+and easy to get subtly wrong -- live in one auditable place.
+"""
+
+from __future__ import annotations
+
+from .errors import SpecError
+from .interpolation import interpolate
+
+# Keys whose list values are merged by *appending* (with de-duplication)
+# rather than replaced wholesale, because that is what users mean by an
+# override that adds another port or environment entry.
+_APPEND_LIST_KEYS = frozenset(
+    {"ports", "volumes", "environment", "networks", "labels", "expose",
+     "depends_on", "command", "entrypoint"}
+)
+
+# ``command``/``entrypoint`` are conceptually scalars-or-lists; an override
+# should *replace* them, not append.  Keep them out of the append set.
+_REPLACE_LIST_KEYS = frozenset({"command", "entrypoint"})
+
+
+def deep_merge(base, override, path="<stack>"):
+    """Return a new mapping formed by merging *override* onto *base*.
+
+    * two mappings merge key-by-key, recursively;
+    * a list under one of the append-keys extends the base list (order
+      preserved, duplicates dropped); any other list is replaced;
+    * scalars replace;
+    * a ``None`` in the override deletes the key.
+    """
+    if not isinstance(base, dict) or not isinstance(override, dict):
+        return _merge_leaf(base, override, path, key=None)
+
+    result = dict(base)
+    for key, ovr in override.items():
+        child = "{}.{}".format(path, key)
+        if ovr is None:
+            result.pop(key, None)
+            continue
+        if key in result:
+            result[key] = _merge_value(result[key], ovr, child, key)
+        else:
+            result[key] = ovr
+    return result
+
+
+def _merge_value(base, override, path, key):
+    if isinstance(base, dict) and isinstance(override, dict):
+        return deep_merge(base, override, path)
+    if isinstance(base, list) and isinstance(override, list):
+        return _merge_leaf(base, override, path, key)
+    return _merge_leaf(base, override, path, key)
+
+
+def _merge_leaf(base, override, path, key):
+    if (
+        isinstance(base, list)
+        and isinstance(override, list)
+        and key in _APPEND_LIST_KEYS
+        and key not in _REPLACE_LIST_KEYS
+    ):
+        merged = list(base)
+        for item in override:
+            if item not in merged:
+                merged.append(item)
+        return merged
+    # Anything else: the override wins outright.
+    return override
+
+
+def merge_documents(documents):
+    """Deep-merge a sequence of stack mappings left-to-right."""
+    if not documents:
+        raise SpecError("no documents to merge")
+    result = {}
+    for index, doc in enumerate(documents):
+        if not isinstance(doc, dict):
+            raise SpecError(
+                "document {} is not a mapping".format(index)
+            )
+        result = deep_merge(result, doc, "<doc{}>".format(index))
+    return result
+
+
+def select_profiles(document, active_profiles):
+    """Drop services whose profiles are not among *active_profiles*.
+
+    A service with no ``profiles`` key is always kept (it belongs to the
+    implicit "always on" set).  A service listing one or more profiles is kept
+    only if at least one of them is active.  The ``profiles`` key is stripped
+    from the surviving services so it never reaches the spec parser.  Services
+    removed this way are also scrubbed from the remaining services'
+    ``depends_on`` so the result stays internally consistent.
+    """
+    active = set(active_profiles or ())
+    services = document.get("services") or {}
+    kept = {}
+    dropped = set()
+
+    for name, cfg in services.items():
+        cfg = cfg or {}
+        profiles = cfg.get("profiles")
+        if not profiles:
+            keep = True
+        else:
+            keep = bool(active & set(profiles))
+        if keep:
+            trimmed = {k: v for k, v in cfg.items() if k != "profiles"}
+            kept[name] = trimmed
+        else:
+            dropped.add(name)
+
+    if dropped:
+        for cfg in kept.values():
+            deps = cfg.get("depends_on")
+            if isinstance(deps, dict):
+                cfg["depends_on"] = {
+                    d: v for d, v in deps.items() if d not in dropped
+                }
+            elif isinstance(deps, (list, tuple)):
+                cfg["depends_on"] = [d for d in deps if d not in dropped]
+
+    result = dict(document)
+    result["services"] = kept
+    return result
+
+
+def load_stack(documents, environment=None, active_profiles=None):
+    """Full pipeline: interpolate -> merge -> select profiles.
+
+    *documents* is one mapping or a list of mappings (base + overrides).
+    *environment* supplies values for ``${VAR}`` interpolation.  Returns a
+    single fully-resolved mapping ready for ``StackSpec.from_dict``.
+    """
+    if isinstance(documents, dict):
+        documents = [documents]
+
+    env = dict(environment or {})
+    interpolated = [
+        interpolate(doc, env, "<doc{}>".format(i))
+        for i, doc in enumerate(documents)
+    ]
+    merged = merge_documents(interpolated)
+    if active_profiles is not None:
+        merged = select_profiles(merged, active_profiles)
+    return merged
