new file mode 100644
index 00000000..fccb1ad4
--- /dev/null
+++ b/docker/orchestration/spec.py
@@ -0,0 +1,561 @@
+"""Typed, validated description of a declarative container stack.
+
+The orchestrator accepts a plain mapping -- the sort of thing you would get
+from parsing a compose-style YAML/JSON document -- and turns it into the
+dataclasses defined here.  Doing the parsing and validation once, up front,
+means the rest of the package can assume it is working with well-formed data
+and never has to second-guess the shape of a dict.
+
+Nothing in this module talks to Docker; it is pure data manipulation, which is
+also what makes the resulting objects trivial to reason about and to hash.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass, field
+
+from .errors import SpecError, UnknownDependencyError
+
+# ``depends_on`` may be given either as a bare list of service names or as a
+# mapping of ``service -> {condition: ...}``.  These are the conditions we
+# understand; anything else is rejected so a typo cannot silently disable the
+# health gate a user was relying on.
+VALID_CONDITIONS = ("service_started", "service_healthy")
+
+
+def _as_str(value, what):
+    if not isinstance(value, str):
+        raise SpecError("{} must be a string, got {!r}".format(what, value))
+    return value
+
+
+def _parse_ports(raw, service):
+    """Normalise a list of port mappings into ``[(container, host, proto)]``.
+
+    Accepts the common compose spellings:
+
+    * ``"8080"``                 -> container 8080, host auto (None), tcp
+    * ``"8080/udp"``             -> container 8080, host auto, udp
+    * ``"80:8080"``              -> container 8080, host 80, tcp
+    * ``"127.0.0.1:80:8080"``    -> container 8080, host ("127.0.0.1", 80), tcp
+    * ``{"target": 8080, "published": 80, "protocol": "udp"}``
+    """
+    if raw is None:
+        return []
+    if not isinstance(raw, (list, tuple)):
+        raise SpecError(
+            "service {!r}: 'ports' must be a list".format(service)
+        )
+
+    ports = []
+    for entry in raw:
+        if isinstance(entry, dict):
+            if "target" not in entry:
+                raise SpecError(
+                    "service {!r}: port mapping {!r} is missing 'target'".format(
+                        service, entry
+                    )
+                )
+            container_port = int(entry["target"])
+            published = entry.get("published")
+            host = int(published) if published is not None else None
+            proto = str(entry.get("protocol", "tcp")).lower()
+            ports.append((container_port, host, proto))
+            continue
+
+        text = str(entry)
+        proto = "tcp"
+        if "/" in text:
+            text, proto = text.rsplit("/", 1)
+            proto = proto.lower()
+
+        bits = text.split(":")
+        try:
+            if len(bits) == 1:
+                ports.append((int(bits[0]), None, proto))
+            elif len(bits) == 2:
+                ports.append((int(bits[1]), int(bits[0]), proto))
+            elif len(bits) == 3:
+                ports.append((int(bits[2]), (bits[0], int(bits[1])), proto))
+            else:
+                raise ValueError(text)
+        except ValueError as exc:
+            raise SpecError(
+                "service {!r}: cannot parse port mapping {!r}".format(
+                    service, entry
+                )
+            ) from exc
+    return ports
+
+
+def _parse_environment(raw, service):
+    """Normalise environment into a sorted ``{name: value}`` dict.
+
+    Accepts either a list of ``"NAME=value"`` strings or a mapping.  The result
+    is an ordinary dict; callers that need determinism sort by key.
+    """
+    if raw is None:
+        return {}
+    env = {}
+    if isinstance(raw, dict):
+        for key, value in raw.items():
+            env[_as_str(key, "environment key")] = (
+                "" if value is None else str(value)
+            )
+    elif isinstance(raw, (list, tuple)):
+        for item in raw:
+            text = _as_str(item, "environment entry")
+            if "=" in text:
+                name, value = text.split("=", 1)
+            else:
+                name, value = text, ""
+            env[name] = value
+    else:
+        raise SpecError(
+            "service {!r}: 'environment' must be a list or mapping".format(
+                service
+            )
+        )
+    return env
+
+
+def _parse_mounts(raw, service):
+    """Normalise ``volumes`` entries into typed :class:`MountSpec` objects.
+
+    Supports both the short string form ``"name:/path[:ro]"`` and the long
+    mapping form ``{"type": "volume", "source": "name", "target": "/path"}``.
+    A bind mount (host path source, or ``type: bind``) has ``volume=None``;
+    a named-volume mount records the *stack-local* volume name in ``volume``.
+    """
+    if raw is None:
+        return []
+    if not isinstance(raw, (list, tuple)):
+        raise SpecError(
+            "service {!r}: 'volumes' must be a list".format(service)
+        )
+
+    mounts = []
+    for entry in raw:
+        if isinstance(entry, dict):
+            target = entry.get("target")
+            if not target:
+                raise SpecError(
+                    "service {!r}: mount {!r} missing 'target'".format(
+                        service, entry
+                    )
+                )
+            mtype = str(entry.get("type", "volume"))
+            source = entry.get("source")
+            read_only = bool(entry.get("read_only", False))
+            volume = source if mtype == "volume" else None
+            mounts.append(
+                MountSpec(
+                    target=str(target),
+                    source=source,
+                    read_only=read_only,
+                    is_volume=(mtype == "volume"),
+                    volume=volume,
+                )
+            )
+            continue
+
+        text = str(entry)
+        bits = text.split(":")
+        if len(bits) == 1:
+            # An anonymous volume at a path: no source.
+            mounts.append(
+                MountSpec(
+                    target=bits[0],
+                    source=None,
+                    read_only=False,
+                    is_volume=True,
+                    volume=None,
+                )
+            )
+        elif len(bits) in (2, 3):
+            source, target = bits[0], bits[1]
+            read_only = len(bits) == 3 and bits[2] == "ro"
+            # A source that looks like a path is a bind mount; otherwise it is
+            # a named volume that must be declared by the stack.
+            is_volume = not source.startswith(("/", "."))
+            mounts.append(
+                MountSpec(
+                    target=target,
+                    source=source,
+                    read_only=read_only,
+                    is_volume=is_volume,
+                    volume=source if is_volume else None,
+                )
+            )
+        else:
+            raise SpecError(
+                "service {!r}: cannot parse mount {!r}".format(service, entry)
+            )
+    return mounts
+
+
+def _parse_depends_on(raw, service):
+    """Return ``{dependency: condition}`` for a service's ``depends_on``."""
+    if raw is None:
+        return {}
+    result = {}
+    if isinstance(raw, (list, tuple)):
+        for dep in raw:
+            result[_as_str(dep, "depends_on entry")] = "service_started"
+    elif isinstance(raw, dict):
+        for dep, cfg in raw.items():
+            dep = _as_str(dep, "depends_on key")
+            if isinstance(cfg, dict):
+                condition = str(cfg.get("condition", "service_started"))
+            else:
+                condition = "service_started"
+            if condition not in VALID_CONDITIONS:
+                raise SpecError(
+                    "service {!r}: unknown depends_on condition {!r}".format(
+                        service, condition
+                    )
+                )
+            result[dep] = condition
+    else:
+        raise SpecError(
+            "service {!r}: 'depends_on' must be a list or mapping".format(
+                service
+            )
+        )
+    return result
+
+
+@dataclass(frozen=True)
+class MountSpec:
+    """A single mount attached to a service container."""
+
+    target: str
+    source: object  # str | None
+    read_only: bool
+    is_volume: bool
+    volume: object  # str | None  (stack-local volume name)
+
+    def canonical(self):
+        return {
+            "target": self.target,
+            "source": self.source,
+            "read_only": self.read_only,
+            "is_volume": self.is_volume,
+            "volume": self.volume,
+        }
+
+
+@dataclass
+class HealthcheckSpec:
+    """A container healthcheck, mirrored onto the create payload."""
+
+    test: object = None            # list[str] | str | None
+    interval: object = None        # nanoseconds
+    timeout: object = None
+    retries: object = None
+    start_period: object = None
+
+    def to_payload(self):
+        if self.test is None:
+            return None
+        payload = {"Test": self.test}
+        if self.interval is not None:
+            payload["Interval"] = self.interval
+        if self.timeout is not None:
+            payload["Timeout"] = self.timeout
+        if self.retries is not None:
+            payload["Retries"] = self.retries
+        if self.start_period is not None:
+            payload["StartPeriod"] = self.start_period
+        return payload
+
+    def canonical(self):
+        return {
+            "test": self.test,
+            "interval": self.interval,
+            "timeout": self.timeout,
+            "retries": self.retries,
+            "start_period": self.start_period,
+        }
+
+
+@dataclass
+class ServiceSpec:
+    """A single service: what container(s) to run and how."""
+
+    name: str
+    image: str
+    command: object = None                       # list | str | None
+    entrypoint: object = None
+    environment: dict = field(default_factory=dict)
+    ports: list = field(default_factory=list)    # [(container, host, proto)]
+    mounts: list = field(default_factory=list)   # [MountSpec]
+    networks: list = field(default_factory=list) # [network name]
+    depends_on: dict = field(default_factory=dict)
+    labels: dict = field(default_factory=dict)   # user labels only
+    restart: str = "no"
+    replicas: int = 1
+    user: object = None
+    working_dir: object = None
+    healthcheck: object = None                   # HealthcheckSpec | None
+
+    def canonical(self):
+        """Return an ordering-independent, JSON-serialisable view.
+
+        This is the input to the config hash.  It deliberately excludes the
+        service *name* and any orchestrator-managed labels, so that renaming a
+        project or re-deriving managed labels does not, on its own, look like a
+        configuration change.
+        """
+        return {
+            "image": self.image,
+            "command": self.command,
+            "entrypoint": self.entrypoint,
+            "environment": dict(sorted(self.environment.items())),
+            "ports": sorted(
+                [list(p[:2]) + [p[2]] for p in self.ports]
+            ),
+            "mounts": sorted(
+                (m.canonical() for m in self.mounts),
+                key=lambda d: d["target"],
+            ),
+            "networks": sorted(self.networks),
+            "labels": dict(sorted(self.labels.items())),
+            "restart": self.restart,
+            "replicas": self.replicas,
+            "user": self.user,
+            "working_dir": self.working_dir,
+            "healthcheck": (
+                self.healthcheck.canonical() if self.healthcheck else None
+            ),
+        }
+
+    def config_hash(self):
+        """Stable hex digest of the service configuration.
+
+        Two specs that describe the same desired state hash identically
+        regardless of the order keys were written in the source document.
+        """
+        blob = json.dumps(
+            self.canonical(), sort_keys=True, separators=(",", ":")
+        )
+        return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+@dataclass
+class NetworkSpec:
+    name: str
+    driver: object = None
+    options: dict = field(default_factory=dict)
+    internal: bool = False
+    attachable: object = None
+    labels: dict = field(default_factory=dict)
+
+
+@dataclass
+class VolumeSpec:
+    name: str
+    driver: object = None
+    driver_opts: dict = field(default_factory=dict)
+    labels: dict = field(default_factory=dict)
+
+
+@dataclass
+class StackSpec:
+    """A whole stack: services plus the networks and volumes they use."""
+
+    services: dict = field(default_factory=dict)   # name -> ServiceSpec
+    networks: dict = field(default_factory=dict)    # name -> NetworkSpec
+    volumes: dict = field(default_factory=dict)     # name -> VolumeSpec
+
+    # -- construction ----------------------------------------------------
+
+    @classmethod
+    def from_dict(cls, data):
+        if not isinstance(data, dict):
+            raise SpecError("stack description must be a mapping")
+
+        raw_services = data.get("services")
+        if not raw_services or not isinstance(raw_services, dict):
+            raise SpecError("stack must define at least one service")
+
+        networks = {}
+        for name, cfg in (data.get("networks") or {}).items():
+            cfg = cfg or {}
+            networks[name] = NetworkSpec(
+                name=name,
+                driver=cfg.get("driver"),
+                options=dict(cfg.get("options") or {}),
+                internal=bool(cfg.get("internal", False)),
+                attachable=cfg.get("attachable"),
+                labels=dict(cfg.get("labels") or {}),
+            )
+
+        volumes = {}
+        for name, cfg in (data.get("volumes") or {}).items():
+            cfg = cfg or {}
+            volumes[name] = VolumeSpec(
+                name=name,
+                driver=cfg.get("driver"),
+                driver_opts=dict(cfg.get("driver_opts") or {}),
+                labels=dict(cfg.get("labels") or {}),
+            )
+
+        services = {}
+        for name, cfg in raw_services.items():
+            services[name] = cls._parse_service(name, cfg or {})
+
+        spec = cls(services=services, networks=networks, volumes=volumes)
+        spec.validate()
+        return spec
+
+    @staticmethod
+    def _parse_service(name, cfg):
+        if "image" not in cfg:
+            raise SpecError("service {!r} is missing 'image'".format(name))
+
+        replicas = cfg.get("replicas", cfg.get("scale", 1))
+        try:
+            replicas = int(replicas)
+        except (TypeError, ValueError) as exc:
+            raise SpecError(
+                "service {!r}: 'replicas' must be an integer".format(name)
+            ) from exc
+        if replicas < 1:
+            raise SpecError(
+                "service {!r}: 'replicas' must be >= 1".format(name)
+            )
+
+        health = None
+        raw_health = cfg.get("healthcheck")
+        if isinstance(raw_health, dict):
+            health = HealthcheckSpec(
+                test=raw_health.get("test"),
+                interval=raw_health.get("interval"),
+                timeout=raw_health.get("timeout"),
+                retries=raw_health.get("retries"),
+                start_period=raw_health.get("start_period"),
+            )
+
+        return ServiceSpec(
+            name=name,
+            image=_as_str(cfg["image"], "image"),
+            command=cfg.get("command"),
+            entrypoint=cfg.get("entrypoint"),
+            environment=_parse_environment(cfg.get("environment"), name),
+            ports=_parse_ports(cfg.get("ports"), name),
+            mounts=_parse_mounts(cfg.get("volumes"), name),
+            networks=list(cfg.get("networks") or []),
+            depends_on=_parse_depends_on(cfg.get("depends_on"), name),
+            labels=dict(cfg.get("labels") or {}),
+            restart=str(cfg.get("restart", "no")),
+            replicas=replicas,
+            user=cfg.get("user"),
+            working_dir=cfg.get("working_dir"),
+            healthcheck=health,
+        )
+
+    # -- validation ------------------------------------------------------
+
+    def validate(self):
+        """Check cross-references between services, networks and volumes."""
+        for service in self.services.values():
+            for dep in service.depends_on:
+                if dep not in self.services:
+                    raise UnknownDependencyError(service.name, dep)
+            for net in service.networks:
+                if net not in self.networks:
+                    raise SpecError(
+                        "service {!r} attaches to undeclared network "
+                        "{!r}".format(service.name, net)
+                    )
+            for mount in service.mounts:
+                if mount.is_volume and mount.volume is not None:
+                    if mount.volume not in self.volumes:
+                        raise SpecError(
+                            "service {!r} mounts undeclared volume {!r}".format(
+                                service.name, mount.volume
+                            )
+                        )
+        # A service with no explicit network is implicitly attached to the
+        # stack's default network; make sure that default exists so planning
+        # can treat every service uniformly.
+        if any(not s.networks for s in self.services.values()):
+            self.networks.setdefault(
+                "default", NetworkSpec(name="default")
+            )
+            for service in self.services.values():
+                if not service.networks:
+                    service.networks = ["default"]
+
+    # -- dependency ordering --------------------------------------------
+
+    def topological_order(self):
+        """Return service names ordered so dependencies come first.
+
+        Ties (services at the same dependency depth) are broken
+        alphabetically, so the ordering -- and therefore every plan built from
+        it -- is deterministic.
+        """
+        from .errors import CyclicDependencyError
+
+        graph = {name: set(s.depends_on) for name, s in self.services.items()}
+        order = []
+        # Kahn's algorithm with a sorted frontier for determinism.
+        indegree = {n: 0 for n in graph}
+        for deps in graph.values():
+            for dep in deps:
+                indegree[dep] += 1
+        # We want dependencies first, so process nodes whose deps are all
+        # already emitted.  Track satisfied set.
+        emitted = set()
+        remaining = set(graph)
+        while remaining:
+            ready = sorted(
+                n for n in remaining if graph[n] <= emitted
+            )
+            if not ready:
+                # Whatever remains forms at least one cycle; surface a concrete
+                # path through it for the error message.
+                cycle = self._find_cycle(graph, remaining)
+                raise CyclicDependencyError(cycle)
+            for n in ready:
+                order.append(n)
+                emitted.add(n)
+                remaining.discard(n)
+        return order
+
+    @staticmethod
+    def _find_cycle(graph, nodes):
+        """Return one concrete cycle among ``nodes`` for error reporting."""
+        visited = set()
+        stack = []
+        stack_set = set()
+
+        def dfs(node):
+            visited.add(node)
+            stack.append(node)
+            stack_set.add(node)
+            for nxt in sorted(graph.get(node, ())):
+                if nxt not in nodes:
+                    continue
+                if nxt in stack_set:
+                    idx = stack.index(nxt)
+                    return stack[idx:] + [nxt]
+                if nxt not in visited:
+                    found = dfs(nxt)
+                    if found:
+                        return found
+            stack.pop()
+            stack_set.discard(node)
+            return None
+
+        for start in sorted(nodes):
+            if start not in visited:
+                found = dfs(start)
+                if found:
+                    return found
+        # Fallback: should not happen, but never return None to the caller.
+        return sorted(nodes) + [sorted(nodes)[0]]
