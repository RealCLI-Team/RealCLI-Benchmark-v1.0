-// AllowlistKey generates the key for exact allowlist lookup.
-func AllowlistKey(toolName string, args map[string]any) string {
-	if toolName == "bash" {
-		if cmd, ok := args["command"].(string); ok {
-			return fmt.Sprintf("bash:%s", cmd)
-		}
-	}
-	return toolName
-}
