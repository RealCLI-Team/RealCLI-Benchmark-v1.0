+    def test_seek_read(self):
+        self.fs.writebytes("a.bin", b"0123456789")
+        with self.fs.open("a.bin", "rb") as f:
+            f.seek(5)
+            self.assertEqual(f.read(3), b"567")
+
+    def test_structure_visible_in_backing(self):
+        # The directory tree is preserved in the clear on the backing FS.
+        self.fs.makedirs("x/y")
+        self.fs.writetext("x/y/z.txt", "hi")
+        self.assertTrue(self.backing.isdir("x/y"))
+        self.assertEqual(sorted(self.fs.listdir("x")), ["y"])
