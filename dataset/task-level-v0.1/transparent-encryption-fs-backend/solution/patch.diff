@@ -0,0 +1,92 @@
+# coding: utf-8
+"""Tests for the transparent encryption CryptFS backend."""
+
+from __future__ import unicode_literals
+
+import unittest
+
+from fs.cryptfs import CryptFS, DecryptionError
+from fs.memoryfs import MemoryFS
+from fs.test import FSTestCases
+
+
+class TestCryptFSConformance(FSTestCases, unittest.TestCase):
+    """A CryptFS over an empty backing store must behave like a normal FS."""
+
+    def make_fs(self):
+        return CryptFS(MemoryFS(), key="conformance-key")
+
+
+class TestCryptContent(unittest.TestCase):
+    def setUp(self):
+        self.backing = MemoryFS()
+        self.fs = CryptFS(self.backing, key="s3cr3t")
+
+    def test_roundtrip(self):
+        self.fs.writetext("a.txt", "hello world")
+        self.assertEqual(self.fs.readtext("a.txt"), "hello world")
+
+    def test_backing_is_ciphertext(self):
+        payload = "the quick brown fox" * 10
+        self.fs.writetext("a.txt", payload)
+        stored = self.backing.readbytes("a.txt")
+        # Plaintext must not appear in the stored blob.
+        self.assertNotIn(payload.encode("utf-8"), stored)
+        # And the blob carries the crypto header.
+        self.assertTrue(stored.startswith(b"FCR1"))
+
+    def test_logical_size_is_plaintext_length(self):
+        data = b"0123456789"
+        self.fs.writebytes("a.bin", data)
+        self.assertEqual(self.fs.getsize("a.bin"), len(data))
+        # The stored blob is larger (nonce + tag overhead).
+        self.assertGreater(self.backing.getsize("a.bin"), len(data))
+
+    def test_empty_file(self):
+        self.fs.writebytes("empty.bin", b"")
+        self.assertEqual(self.fs.readbytes("empty.bin"), b"")
+        self.assertEqual(self.fs.getsize("empty.bin"), 0)
+
+    def test_wrong_key_fails(self):
+        self.fs.writetext("secret.txt", "classified")
+        other = CryptFS(self.backing, key="wrong-key")
+        with self.assertRaises(DecryptionError):
+            other.readtext("secret.txt")
+
+    def test_tamper_detected(self):
+        self.fs.writebytes("a.bin", b"important data")
+        blob = bytearray(self.backing.readbytes("a.bin"))
+        blob[-1] ^= 0xFF  # flip a bit in the authentication tag
+        self.backing.writebytes("a.bin", bytes(blob))
+        with self.assertRaises(DecryptionError):
+            self.fs.readbytes("a.bin")
+
+    def test_persistence_same_key(self):
+        self.fs.makedirs("d/e")
+        self.fs.writetext("d/e/note.txt", "persist")
+        # Re-open the same backing store with the same key.
+        reopened = CryptFS(self.backing, key="s3cr3t")
+        self.assertEqual(reopened.readtext("d/e/note.txt"), "persist")
+
+    def test_append(self):
+        self.fs.writetext("log.txt", "line1\n")
+        with self.fs.open("log.txt", "a") as f:
+            f.write("line2\n")
+        self.assertEqual(self.fs.readtext("log.txt"), "line1\nline2\n")
