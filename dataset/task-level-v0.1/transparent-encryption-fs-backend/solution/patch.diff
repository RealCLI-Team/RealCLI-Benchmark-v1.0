--- /dev/null
+++ b/fs/opener/cryptfs.py
@@ -0,0 +1,71 @@
+# coding: utf-8
+"""`CryptFS` opener definition.
+"""
+
+from __future__ import absolute_import, print_function, unicode_literals
+
+import typing
+
+from .base import Opener
+from .errors import OpenerError
+from .registry import registry
+
+if typing.TYPE_CHECKING:
+    from typing import Text
+
+    from ..cryptfs import CryptFS  # noqa: F401
+    from .parse import ParseResult
+
+
+@registry.install
+class CryptOpener(Opener):
+    """`CryptFS` opener.
+
+    The encryption key is taken from the URL's user/password component and
+    the resource names the backing filesystem as a nested FS URL.  If no
+    backing store is given, an in-memory one is used (a scratch encrypted
+    filesystem).  The key may also be supplied as a ``key`` query
+    parameter.
+
+    Examples:
+        ``crypt://s3cr3t@osfs:///data``  -- encrypt over /data with key "s3cr3t"
+        ``crypt://s3cr3t@``              -- in-memory encrypted scratch FS
+        ``crypt://?key=s3cr3t``          -- key as a query parameter
+    """
+
+    protocols = ["crypt"]
+
+    def open_fs(
+        self,
+        fs_url,  # type: Text
+        parse_result,  # type: ParseResult
+        writeable,  # type: bool
+        create,  # type: bool
+        cwd,  # type: Text
+    ):
+        # type: (...) -> CryptFS
+        from ..cryptfs import CryptFS
+        from ..memoryfs import MemoryFS
+
+        key = parse_result.username or parse_result.params.get("key")
+        if not key:
+            raise OpenerError(
+                "an encryption key is required, e.g. crypt://<key>@<backing-url>"
+            )
+
+        backing_url = parse_result.resource
+        if backing_url:
+            try:
+                backing_fs = registry.open_fs(
+                    backing_url, writeable=True, create=create, cwd=cwd
+                )
+            except Exception as error:
+                raise OpenerError(
+                    "failed to open backing filesystem {!r}: {}".format(
+                        backing_url, error
+                    )
+                )
+        else:
+            backing_fs = MemoryFS()
+
+        return CryptFS(backing_fs, key=key)
