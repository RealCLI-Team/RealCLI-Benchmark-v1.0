index 0000000..363f2ef
--- /dev/null
+++ b/fs/cryptfs.py
@@ -0,0 +1,508 @@
+# coding: utf-8
+"""A filesystem that transparently encrypts file contents at rest.
+
+`CryptFS` wraps another filesystem (the *backing* store) and encrypts the
+**contents** of every file before they are written, decrypting them again
+on read.  The directory structure -- names, nesting, which paths are files
+and which are directories -- is preserved in the clear, so listing,
+walking, globbing, moving and removing all behave exactly as they do on
+the backing store.  Only the bytes inside files are protected.
+
+This is useful whenever data must live on storage you do not fully trust
+(a shared volume, an object store, a backup target) while still being
+usable through the ordinary PyFilesystem2 interface: callers open, read
+and write files as normal and never handle ciphertext themselves.
+
+Design
+------
+
+Each file is stored on the backing filesystem as a self-describing blob::
+
+    MAGIC (4 bytes) | version (1) | nonce (16) | ciphertext (N) | tag (32)
+
+The ciphertext is the plaintext XORed with a keystream derived from the
+per-file random *nonce* and the filesystem key, in the manner of a
+counter (CTR) mode stream cipher; the keystream blocks are
+``HMAC-SHA256(key, nonce || counter)``.  An authentication *tag* --
+``HMAC-SHA256(key, version || nonce || ciphertext)`` -- is appended so
+that tampering, truncation or an incorrect key are detected on read
+rather than silently returning garbage.
+
+Because the on-disk blob carries a fixed 53 bytes of overhead, the
+logical size a caller sees (through ``getinfo``/``getsize``) is the
+stored size minus that overhead; ``CryptFS`` translates between the two
+so the rest of the library sees only plaintext sizes.
+
+The cipher here relies only on the standard library (``hashlib`` and
+``hmac``).  It is a genuine, integrity-checked stream cipher, but it is
+deliberately simple; production use would prefer a vetted AEAD such as
+AES-GCM from a dedicated crypto library.
+"""
+
+from __future__ import absolute_import, unicode_literals
+
+import typing
+
+import hashlib
+import hmac
+import io
+import os
+import struct
+
+import six
+
+from . import errors
+from .base import FS
+from .enums import ResourceType, Seek
+from .error_tools import unwrap_errors
+from .info import Info
+from .mode import Mode
+from .path import abspath, normpath
+
+if typing.TYPE_CHECKING:
+    from typing import (
+        Any,
+        BinaryIO,
+        Collection,
+        Iterator,
+        List,
+        Optional,
+        Text,
+        Tuple,
+    )
+
+    from .info import RawInfo
+    from .permissions import Permissions
+    from .subfs import SubFS
+
+
+_MAGIC = b"FCR1"
+_VERSION = 1
+_NONCE_LEN = 16
+_TAG_LEN = 32
+_HEADER = struct.Struct(">4sB16s")  # magic, version, nonce
+_HEADER_LEN = _HEADER.size  # 21
+_OVERHEAD = _HEADER_LEN + _TAG_LEN  # 53 bytes per stored file
+_BLOCK = hashlib.sha256().digest_size  # 32, keystream block size
+
+
+class DecryptionError(errors.OperationFailed):
+    """Raised when a stored file cannot be authenticated or decrypted.
+
+    This signals a wrong key, a corrupted blob, or a file on the backing
+    store that was not written by ``CryptFS``.
+    """
+
+
+def _derive_key(key):
+    # type: (typing.Union[Text, bytes]) -> bytes
+    """Normalise the user-supplied key to a fixed-length secret."""
+    if isinstance(key, six.text_type):
+        key = key.encode("utf-8")
+    if not isinstance(key, bytes):
+        raise TypeError("key must be str or bytes")
+    if not key:
+        raise ValueError("key must not be empty")
+    # A single hash pass gives a uniform 32-byte secret regardless of the
+    # length or form of the caller's key.
+    return hashlib.sha256(b"fs.cryptfs.key\x00" + key).digest()
+
+
+def _keystream(key, nonce, length):
+    # type: (bytes, bytes, int) -> bytes
+    """Produce ``length`` bytes of CTR keystream for ``nonce``."""
+    if length <= 0:
+        return b""
+    blocks = -(-length // _BLOCK)  # ceil division
+    prefix = hmac.new(key, nonce, hashlib.sha256)
+    parts = []
+    for counter in range(blocks):
+        block = prefix.copy()
+        block.update(struct.pack(">Q", counter))
+        parts.append(block.digest())
+    return b"".join(parts)[:length]
+
+
+def _xor(data, stream):
+    # type: (bytes, bytes) -> bytes
+    length = len(data)
+    if length == 0:
+        return b""
+    # XOR whole buffers as big integers -- dramatically faster than a
+    # per-byte Python loop for the multi-megabyte files copy() moves.
+    combined = int.from_bytes(data, "big") ^ int.from_bytes(stream[:length], "big")
+    return combined.to_bytes(length, "big")
+
+
+@six.python_2_unicode_compatible
+class _CryptFile(io.RawIOBase):
+    """A plaintext view over an encrypted backing file.
+
+    The whole (decrypted) file is buffered in memory while open; on close
+    -- if it was opened for writing and modified -- the buffer is
+    re-encrypted and flushed back to the backing store as a single blob.
+    """
+
+    def __init__(self, crypt_fs, path, mode, initial):
+        # type: (CryptFS, Text, Text, bytes) -> None
+        super(_CryptFile, self).__init__()
+        self._crypt_fs = crypt_fs
+        self._path = path
+        self._mode = Mode(mode)
+        self._buffer = io.BytesIO()
+        if initial:
+            self._buffer.write(initial)
+        if self._mode.appending:
+            self._buffer.seek(0, io.SEEK_END)
+        else:
+            self._buffer.seek(0)
+        # A freshly created or truncated file is dirty even if never
+        # written to, so that an empty blob is persisted.
+        self._dirty = self._mode.writing and (
+            self._mode.truncate or self._mode.create and not initial
+        )
+
+    def __str__(self):
+        # type: () -> str
+        return "<cryptfile '{}' '{}'>".format(self._path, self._mode)
+
+    @property
+    def mode(self):
+        # type: () -> Text
+        return self._mode.to_platform_bin()
+
+    def readable(self):
+        # type: () -> bool
+        return self._mode.reading
+
+    def writable(self):
+        # type: () -> bool
+        return self._mode.writing
+
+    def seekable(self):
+        # type: () -> bool
+        return True
+
+    def tell(self):
+        # type: () -> int
+        return self._buffer.tell()
+
+    def seek(self, pos, whence=Seek.set):
+        # type: (int, int) -> int
+        return self._buffer.seek(pos, int(whence))
+
+    def read(self, size=-1):
+        # type: (int) -> bytes
+        if not self._mode.reading:
+            raise IOError("File not open for reading")
+        if size is None or size < 0:
+            return self._buffer.read()
+        return self._buffer.read(size)
+
+    def readinto(self, buffer):
+        # type: (bytearray) -> int
+        if not self._mode.reading:
+            raise IOError("File not open for reading")
+        data = self._buffer.read(len(buffer))
+        buffer[: len(data)] = data
+        return len(data)
+
+    def readline(self, size=-1):
+        # type: (int) -> bytes
+        if not self._mode.reading:
+            raise IOError("File not open for reading")
+        return self._buffer.readline(size)
+
+    def readall(self):
+        # type: () -> bytes
+        if not self._mode.reading:
+            raise IOError("File not open for reading")
+        return self._buffer.read()
+
+    def write(self, data):
+        # type: (bytes) -> int
+        if not self._mode.writing:
+            raise IOError("File not open for writing")
+        written = self._buffer.write(data)
+        self._dirty = True
+        return written
+
+    def truncate(self, size=None):
+        # type: (Optional[int]) -> int
+        if not self._mode.writing:
+            raise IOError("File not open for writing")
+        pos = self._buffer.tell()
+        self._buffer.truncate(size)
+        if size is not None:
+            # BytesIO.truncate never grows the buffer; pad with zeros so
+            # the logical size matches the requested size.
+            end = self._buffer.seek(0, io.SEEK_END)
+            if end < size:
+                self._buffer.write(b"\0" * (size - end))
+            self._buffer.seek(pos)
+        self._dirty = True
+        return size if size is not None else pos
+
+    def flush(self):
+        # type: () -> None
+        if self._dirty and not self.closed:
+            self._crypt_fs._store(self._path, self._buffer.getvalue())
+            self._dirty = False
+
+    def close(self):
+        # type: () -> None
+        if not self.closed:
+            try:
+                self.flush()
+            finally:
+                super(_CryptFile, self).close()
+
+
+@six.python_2_unicode_compatible
+class CryptFS(FS):
+    """A filesystem that encrypts the contents of files at rest.
+
+    Arguments:
+        backing_fs (FS): The filesystem that holds the (encrypted) blobs
+            and the directory structure.
+        key (str or bytes): The secret used to encrypt and decrypt file
+            contents.  The same key must be supplied to read back data
+            written by an earlier session.
+        auto_close (bool): If `True` (the default), closing this
+            filesystem also closes ``backing_fs``.
+
+    """
+
+    _meta = {
+        "case_insensitive": False,
+        "invalid_path_chars": "\0",
+        "network": False,
+        "read_only": False,
+        "supports_rename": False,
+        "thread_safe": True,
+        "unicode_paths": True,
+        "virtual": True,
+    }
+
+    def __init__(self, backing_fs, key, auto_close=True):
+        # type: (FS, typing.Union[Text, bytes], bool) -> None
+        super(CryptFS, self).__init__()
+        self._backing = backing_fs
+        self._key = _derive_key(key)
+        self._auto_close = auto_close
+        # Inherit the backing store's own metadata where it is more
+        # specific (e.g. case sensitivity), keeping the crypto-specific
+        # flags above.
+        try:
+            backing_meta = backing_fs.getmeta()
+        except Exception:
+            backing_meta = {}
+        for meta_key in ("case_insensitive", "invalid_path_chars", "unicode_paths"):
+            if meta_key in backing_meta:
+                self._meta[meta_key] = backing_meta[meta_key]
+
+    def __repr__(self):
+        # type: () -> str
+        return "CryptFS({!r})".format(self._backing)
+
+    def __str__(self):
+        # type: () -> str
+        return "<cryptfs {}>".format(self._backing)
+
+    # -- Encryption helpers -----------------------------------------------
+
+    def _encrypt(self, plaintext):
+        # type: (bytes) -> bytes
+        nonce = os.urandom(_NONCE_LEN)
+        keystream = _keystream(self._key, nonce, len(plaintext))
+        ciphertext = _xor(plaintext, keystream)
+        header = _HEADER.pack(_MAGIC, _VERSION, nonce)
+        tag = hmac.new(
+            self._key,
+            struct.pack(">B", _VERSION) + nonce + ciphertext,
+            hashlib.sha256,
+        ).digest()
+        return header + ciphertext + tag
+
+    def _decrypt(self, blob):
+        # type: (bytes) -> bytes
+        if len(blob) < _OVERHEAD:
+            raise DecryptionError("stored blob is too short to be valid")
+        magic, version, nonce = _HEADER.unpack(blob[:_HEADER_LEN])
+        if magic != _MAGIC:
+            raise DecryptionError("stored blob has an unrecognised header")
+        if version != _VERSION:
+            raise DecryptionError("unsupported blob version {}".format(version))
+        ciphertext = blob[_HEADER_LEN:-_TAG_LEN]
+        tag = blob[-_TAG_LEN:]
+        expected = hmac.new(
+            self._key,
+            struct.pack(">B", version) + nonce + ciphertext,
+            hashlib.sha256,
+        ).digest()
+        if not hmac.compare_digest(tag, expected):
+            raise DecryptionError(
+                "authentication failed (wrong key or corrupted data)"
+            )
+        keystream = _keystream(self._key, nonce, len(ciphertext))
+        return _xor(ciphertext, keystream)
+
+    def _logical_size(self, stored_size):
+        # type: (int) -> int
+        """Translate a stored blob size into its plaintext length."""
+        return max(0, stored_size - _OVERHEAD)
+
+    def _store(self, path, plaintext):
+        # type: (Text, bytes) -> None
+        self._backing.writebytes(path, self._encrypt(plaintext))
+
+    def _load(self, path):
+        # type: (Text) -> bytes
+        return self._decrypt(self._backing.readbytes(path))
+
+    # -- Required FS methods (structure delegated, content translated) ----
+
+    def getinfo(self, path, namespaces=None):
+        # type: (Text, Optional[Collection[Text]]) -> Info
+        self.check()
+        namespaces = namespaces or ()
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            raw = dict(self._backing.getinfo(_path, namespaces=namespaces).raw)
+        # Rewrite the reported size to the plaintext length for files.
+        if "details" in raw and not raw.get("basic", {}).get("is_dir", False):
+            details = dict(raw["details"])
+            size = details.get("size")
+            if size is not None:
+                details["size"] = self._logical_size(size)
+            raw["details"] = details
+        if abspath(normpath(path)) == "/" and "basic" in raw:
+            basic = dict(raw["basic"])
+            basic["name"] = ""
+            raw["basic"] = basic
+        return Info(raw)
+
+    def listdir(self, path):
+        # type: (Text) -> List[Text]
+        self.check()
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            return self._backing.listdir(_path)
+
+    def makedir(self, path, permissions=None, recreate=False):
+        # type: (Text, Optional[Permissions], bool) -> SubFS[CryptFS]
+        self.check()
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            self._backing.makedir(_path, permissions=permissions, recreate=recreate)
+        return self.opendir(path)
+
+    def openbin(self, path, mode="r", buffering=-1, **options):
+        # type: (Text, Text, int, **Any) -> BinaryIO
+        self.check()
+        _mode = Mode(mode)
+        _mode.validate_bin()
+        _path = self.validatepath(path)
+
+        with unwrap_errors(path):
+            exists = self._backing.exists(_path)
+            if exists and self._backing.isdir(_path):
+                raise errors.FileExpected(path)
+            if not _mode.create and not exists:
+                raise errors.ResourceNotFound(path)
+            if _mode.exclusive and exists:
+                raise errors.FileExists(path)
+            # A creating open must have an existing parent directory; the
+            # backing store raises the right error (ResourceNotFound) if
+            # not, since we write an empty blob into it straight away.
+            if _mode.create and not exists:
+                self._store(_path, b"")
+
+            initial = b""
+            if exists and not _mode.truncate:
+                initial = self._load(_path)
+        return _CryptFile(self, _path, mode, initial)
+
+    def remove(self, path):
+        # type: (Text) -> None
+        self.check()
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            self._backing.remove(_path)
+
+    def removedir(self, path):
+        # type: (Text) -> None
+        self.check()
+        _path = abspath(normpath(path))
+        if _path == "/":
+            raise errors.RemoveRootError()
+        with unwrap_errors(path):
+            self._backing.removedir(self.validatepath(path))
+
+    def setinfo(self, path, info):
+        # type: (Text, RawInfo) -> None
+        self.check()
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            self._backing.setinfo(_path, info)
+
+    # -- Delegated conveniences -------------------------------------------
+
+    def scandir(self, path, namespaces=None, page=None):
+        # type: (Text, Optional[Collection[Text]], Optional[Tuple[int, int]]) -> Iterator[Info]
+        self.check()
+        _namespaces = namespaces or ()
+        want_size = "details" in _namespaces
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            entries = list(
+                self._backing.scandir(_path, namespaces=namespaces, page=page)
+            )
+        for info in entries:
+            if want_size and not info.is_dir and info.has_namespace("details"):
+                raw = dict(info.raw)
+                details = dict(raw["details"])
+                if details.get("size") is not None:
+                    details["size"] = self._logical_size(details["size"])
+                raw["details"] = details
+                yield Info(raw)
+            else:
+                yield info
+
+    def move(self, src_path, dst_path, overwrite=False, preserve_time=False):
+        # type: (Text, Text, bool, bool) -> None
+        self.check()
+        _src = self.validatepath(src_path)
+        _dst = self.validatepath(dst_path)
+        with unwrap_errors({_src: src_path, _dst: dst_path}):
+            self._backing.move(
+                _src, _dst, overwrite=overwrite, preserve_time=preserve_time
+            )
+
+    def gettype(self, path):
+        # type: (Text) -> ResourceType
+        self.check()
+        _path = self.validatepath(path)
+        with unwrap_errors(path):
+            return self._backing.gettype(_path)
+
+    def isdir(self, path):
+        # type: (Text) -> bool
+        self.check()
+        return self._backing.isdir(self.validatepath(path))
+
+    def isfile(self, path):
+        # type: (Text) -> bool
+        self.check()
+        return self._backing.isfile(self.validatepath(path))
+
+    def exists(self, path):
+        # type: (Text) -> bool
+        self.check()
+        return self._backing.exists(self.validatepath(path))
+
+    def close(self):
+        # type: () -> None
+        if not self._closed and self._auto_close:
+            self._backing.close()
+        super(CryptFS, self).close()
