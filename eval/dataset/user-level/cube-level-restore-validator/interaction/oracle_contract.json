{
  "schema_version": "oracle_contract_v1",
  "source_files": ["instruction.md", "tests/test.sh"],
  "requirements": [
    {
      "id": "req_output_path",
      "verifier_assertion": "solution.py is invoked with --input /app/inputs/data --output /app/result.json and writes to /app/result.json",
      "script_refs": ["slice_cli"],
      "must_include": ["/app/result.json", "--output", "--input"]
    },
    {
      "id": "req_input_directory",
      "verifier_assertion": "--input argument is a directory; every *.json file in it is processed as one case",
      "script_refs": ["slice_input_dir"],
      "must_include": ["*.json", "directory"]
    },
    {
      "id": "req_case_id_field",
      "verifier_assertion": "Level JSON must have case_id field used as the key in the output report",
      "script_refs": ["slice_level_schema"],
      "must_include": ["case_id"]
    },
    {
      "id": "req_cube_field",
      "verifier_assertion": "Level JSON must have cube field containing the facelet state string",
      "script_refs": ["slice_level_schema"],
      "must_include": ["cube"]
    },
    {
      "id": "req_scramble_optional",
      "verifier_assertion": "scramble is an optional array of strings; when present, must be validated",
      "script_refs": ["slice_level_schema"],
      "must_include": ["scramble", "optional"]
    },
    {
      "id": "req_facelet_order",
      "verifier_assertion": "Cube string concatenates faces in order U, R, F, D, L, B for 54 characters total",
      "script_refs": ["slice_facelet_order"],
      "must_include": ["U, R, F, D, L, B", "54"]
    },
    {
      "id": "req_face_indices",
      "verifier_assertion": "Face index ranges: U=0-8, R=9-17, F=18-26, D=27-35, L=36-44, B=45-53",
      "script_refs": ["slice_face_indices"],
      "must_include": ["0-8", "9-17", "36-44", "45-53"]
    },
    {
      "id": "req_solved_state",
      "verifier_assertion": "Solved state is UUUUUUUUURRRRRRRRRFFFFFFFFFDDDDDDDDDLLLLLLLLLBBBBBBBBB",
      "script_refs": ["slice_solved_state"],
      "must_include": ["UUUUUUUUURRRRRRRRRFFFFFFFFFDDDDDDDDDLLLLLLLLLBBBBBBBBB"]
    },
    {
      "id": "req_move_modifiers",
      "verifier_assertion": "No modifier = 90 degrees clockwise; apostrophe = counter-clockwise; 2 = 180 degrees",
      "script_refs": ["slice_move_syntax"],
      "must_include": ["clockwise", "counter-clockwise", "180"]
    },
    {
      "id": "req_illegal_moves",
      "verifier_assertion": "Any token not matching face letter optionally followed by ' or 2 is illegal",
      "script_refs": ["slice_illegal_moves"],
      "must_include": ["illegal"]
    },
    {
      "id": "req_cycles_u",
      "verifier_assertion": "U face quarter-turn cycles: (0,6,8,2)(1,3,7,5)(9,45,36,18)(10,46,37,19)(11,47,38,20)",
      "script_refs": ["slice_cycle_u_r_f"],
      "must_include": ["(0,6,8,2)", "(9,45,36,18)"]
    },
    {
      "id": "req_cycles_r",
      "verifier_assertion": "R face quarter-turn cycles: (2,20,29,51)(5,23,32,48)(8,26,35,45)(9,15,17,11)(10,12,16,14)",
      "script_refs": ["slice_cycle_u_r_f"],
      "must_include": ["(2,20,29,51)", "(9,15,17,11)"]
    },
    {
      "id": "req_cycles_f",
      "verifier_assertion": "F face quarter-turn cycles: (6,44,29,9)(7,41,28,12)(8,38,27,15)(18,24,26,20)(19,21,25,23)",
      "script_refs": ["slice_cycle_u_r_f"],
      "must_include": ["(6,44,29,9)", "(18,24,26,20)"]
    },
    {
      "id": "req_cycles_d",
      "verifier_assertion": "D face quarter-turn cycles: (15,51,42,24)(16,52,43,25)(17,53,44,26)(27,29,35,33)(28,32,34,30)",
      "script_refs": ["slice_cycle_d_l_b"],
      "must_include": ["(15,51,42,24)", "(27,29,35,33)"]
    },
    {
      "id": "req_cycles_l",
      "verifier_assertion": "L face quarter-turn cycles: (0,18,27,53)(3,21,30,50)(6,24,33,47)(36,38,44,42)(37,41,43,39)",
      "script_refs": ["slice_cycle_d_l_b"],
      "must_include": ["(0,18,27,53)", "(36,38,44,42)"]
    },
    {
      "id": "req_cycles_b",
      "verifier_assertion": "B face quarter-turn cycles: (0,42,35,11)(1,39,34,14)(2,36,33,17)(45,47,53,51)(46,50,52,48)",
      "script_refs": ["slice_cycle_d_l_b"],
      "must_include": ["(0,42,35,11)", "(45,47,53,51)"]
    },
    {
      "id": "req_priority_order",
      "verifier_assertion": "Priority rules: malformed cube wins over bad scramble wins over already-solved wins over otherwise-solved",
      "script_refs": ["slice_priority_rules"],
      "must_include": ["malformed", "invalid", "already_solved", "solved"]
    },
    {
      "id": "req_invalid_cube_conditions",
      "verifier_assertion": "Cube malformed if length != 54, char outside {U,R,F,D,L,B}, or any color not exactly 9 times",
      "script_refs": ["slice_invalid_cube"],
      "must_include": ["54", "9 times"]
    },
    {
      "id": "req_invalid_scramble_check",
      "verifier_assertion": "Scramble bad if illegal token OR applying scramble to solved state != cube",
      "script_refs": ["slice_invalid_scramble"],
      "must_include": ["scramble", "solved state"]
    },
    {
      "id": "req_already_solved_output",
      "verifier_assertion": "already_solved status outputs solution=[] and move_count=0",
      "script_refs": ["slice_already_solved", "slice_output_already_solved"],
      "must_include": ["already_solved", "solution", "move_count", "0"]
    },
    {
      "id": "req_canonical_constraint",
      "verifier_assertion": "No two adjacent moves in solution may act on the same face",
      "script_refs": ["slice_canonical"],
      "must_include": ["adjacent", "same face"]
    },
    {
      "id": "req_solved_output_fields",
      "verifier_assertion": "solved status outputs status=solved, solution array, move_count=len(solution)",
      "script_refs": ["slice_output_solved"],
      "must_include": ["solution", "move_count"]
    },
    {
      "id": "req_invalid_no_solution_field",
      "verifier_assertion": "invalid status output must NOT contain solution or move_count fields",
      "script_refs": ["slice_output_invalid"],
      "must_include": ["invalid", "no solution"]
    },
    {
      "id": "req_key_ordering",
      "verifier_assertion": "Top-level case_id keys must appear in ascending lexicographic order",
      "script_refs": ["slice_output_key_order"],
      "must_include": ["ascending", "lexicographic"]
    },
    {
      "id": "req_determinism",
      "verifier_assertion": "Two consecutive runs on the same input must produce byte-for-byte identical output",
      "script_refs": ["slice_determinism"],
      "must_include": ["byte-for-byte identical"]
    }
  ]
}
