{
  "schema_version": "oracle_contract_v1",
  "source_files": ["instruction.md", "tests/test.sh"],
  "requirements": [
    {
      "id": "result_file_exists",
      "verifier_assertion": "result.json must exist at /app/result.json",
      "script_refs": ["slice_cli"],
      "must_include": ["/app/result.json"]
    },
    {
      "id": "solution_cli",
      "verifier_assertion": "Script must be at /app/solution.py with --input and --output arguments",
      "script_refs": ["slice_cli"],
      "must_include": ["/app/solution.py", "--input", "--output"]
    },
    {
      "id": "report_has_summary_results",
      "verifier_assertion": "Report must contain summary and results keys",
      "script_refs": ["slice_output_structure"],
      "must_include": ["summary", "results"]
    },
    {
      "id": "results_sorted_by_id",
      "verifier_assertion": "Results array must be sorted by id ascending",
      "script_refs": ["slice_output_results_order"],
      "must_include": ["sorted by id ascending"]
    },
    {
      "id": "no_duplicate_ids",
      "verifier_assertion": "No duplicate ids in results",
      "script_refs": ["slice_output_structure"],
      "must_include": ["results"]
    },
    {
      "id": "per_record_verdict_match",
      "verifier_assertion": "Each record's verdict must match the reference: valid if reason is OK, invalid otherwise",
      "script_refs": ["slice_verdict_precedence", "slice_rule_ok"],
      "must_include": ["valid", "invalid", "OK"]
    },
    {
      "id": "per_record_reason_match",
      "verifier_assertion": "Each record's reason must match the reference per the 10-rule fixed precedence chain",
      "script_refs": ["slice_verdict_precedence"],
      "must_include": ["MALFORMED", "ALG_NONE", "UNSUPPORTED_ALG", "MISSING_KID", "UNKNOWN_KID", "ALG_MISMATCH", "EXPIRED", "BAD_SIGNATURE", "REPLAY", "OK"]
    },
    {
      "id": "per_record_kid_alg",
      "verifier_assertion": "Each record's kid and alg must match the decoded header values (strings or null if not present/decodable)",
      "script_refs": ["slice_output_kid_alg"],
      "must_include": ["null"]
    },
    {
      "id": "summary_total",
      "verifier_assertion": "summary.total must equal len(results)",
      "script_refs": ["slice_output_structure"],
      "must_include": ["total"]
    },
    {
      "id": "summary_valid_invalid",
      "verifier_assertion": "summary.valid + summary.invalid must equal summary.total",
      "script_refs": ["slice_output_structure"],
      "must_include": ["valid", "invalid"]
    },
    {
      "id": "summary_by_reason",
      "verifier_assertion": "sum(by_reason values) must equal total; by_reason must match reference counts exactly; every reason with count>=1 present, no zero counts",
      "script_refs": ["slice_output_by_reason", "slice_output_structure"],
      "must_include": ["by_reason", "count is at least 1"]
    },
    {
      "id": "ok_hs256_present",
      "verifier_assertion": "At least one token with reason OK must use alg HS256",
      "script_refs": ["slice_rule_ok", "slice_keys_format"],
      "must_include": ["HS256"]
    },
    {
      "id": "ok_hs512_present",
      "verifier_assertion": "At least one token with reason OK must use alg HS512",
      "script_refs": ["slice_rule_ok", "slice_keys_format"],
      "must_include": ["HS512"]
    },
    {
      "id": "replay_t01_ok",
      "verifier_assertion": "Token t01 must be OK (replay winner due to smaller (received_at, id))",
      "script_refs": ["slice_rule_replay", "slice_replay_ordering"],
      "must_include": ["received_at, id"]
    },
    {
      "id": "replay_t03_replay",
      "verifier_assertion": "Token t03 must be REPLAY (same jti as t01 but later in processing order)",
      "script_refs": ["slice_rule_replay", "slice_replay_ordering"],
      "must_include": ["REPLAY", "jti"]
    },
    {
      "id": "t13_missing_iat_ok",
      "verifier_assertion": "Token t13 (missing iat) must be OK — absent iat skips the expiry check",
      "script_refs": ["slice_rule_expired"],
      "must_include": ["iat is absent, skip this check"]
    },
    {
      "id": "t09_expired",
      "verifier_assertion": "Token t09 must be EXPIRED",
      "script_refs": ["slice_rule_expired"],
      "must_include": ["EXPIRED", "tolerance_seconds"]
    },
    {
      "id": "t12_malformed_iat",
      "verifier_assertion": "Token t12 (non-integer iat) must be MALFORMED",
      "script_refs": ["slice_rule_malformed"],
      "must_include": ["iat is present in the payload but is not an integer"]
    },
    {
      "id": "t04_alg_none",
      "verifier_assertion": "Token t04 must be ALG_NONE",
      "script_refs": ["slice_rule_alg_none"],
      "must_include": ["ALG_NONE", "none"]
    },
    {
      "id": "t05_unsupported_alg",
      "verifier_assertion": "Token t05 must be UNSUPPORTED_ALG",
      "script_refs": ["slice_rule_unsupported_alg"],
      "must_include": ["UNSUPPORTED_ALG", "allowed_algs"]
    },
    {
      "id": "t06_missing_kid",
      "verifier_assertion": "Token t06 must be MISSING_KID",
      "script_refs": ["slice_rule_missing_kid"],
      "must_include": ["MISSING_KID", "require_kid"]
    },
    {
      "id": "t07_unknown_kid",
      "verifier_assertion": "Token t07 must be UNKNOWN_KID",
      "script_refs": ["slice_rule_unknown_kid"],
      "must_include": ["UNKNOWN_KID"]
    },
    {
      "id": "t08_alg_mismatch",
      "verifier_assertion": "Token t08 must be ALG_MISMATCH",
      "script_refs": ["slice_rule_alg_mismatch"],
      "must_include": ["ALG_MISMATCH"]
    },
    {
      "id": "t10_bad_signature",
      "verifier_assertion": "Token t10 must be BAD_SIGNATURE",
      "script_refs": ["slice_rule_bad_signature"],
      "must_include": ["BAD_SIGNATURE"]
    },
    {
      "id": "t11_malformed_garbage",
      "verifier_assertion": "Token t11 must be MALFORMED (not valid JWS structure)",
      "script_refs": ["slice_rule_malformed"],
      "must_include": ["MALFORMED", "not exactly 3 non-empty base64url parts"]
    },
    {
      "id": "all_ten_reasons",
      "verifier_assertion": "All 10 reasons (OK, MALFORMED, ALG_NONE, UNSUPPORTED_ALG, MISSING_KID, UNKNOWN_KID, ALG_MISMATCH, EXPIRED, BAD_SIGNATURE, REPLAY) must appear in by_reason",
      "script_refs": ["slice_verdict_precedence", "slice_output_by_reason"],
      "must_include": ["MALFORMED", "ALG_NONE", "UNSUPPORTED_ALG", "MISSING_KID", "UNKNOWN_KID", "ALG_MISMATCH", "EXPIRED", "BAD_SIGNATURE", "REPLAY", "OK"]
    },
    {
      "id": "rerun_determinism",
      "verifier_assertion": "Rerunning solution.py must produce byte-identical output",
      "script_refs": ["slice_output_serialization"],
      "must_include": ["byte-identical"]
    },
    {
      "id": "signing_input_ascii",
      "verifier_assertion": "HMAC is computed over the raw base64url ASCII of header.payload segments joined by a dot",
      "script_refs": ["slice_rule_bad_signature"],
      "must_include": ["raw base64url ASCII of the first two segments joined by a single dot"]
    },
    {
      "id": "constant_time_comparison",
      "verifier_assertion": "Signature comparison must use constant-time comparison",
      "script_refs": ["slice_rule_bad_signature"],
      "must_include": ["constant-time comparison"]
    },
    {
      "id": "alg_none_case_insensitive",
      "verifier_assertion": "ALG_NONE check is case-insensitive on the alg value",
      "script_refs": ["slice_rule_alg_none"],
      "must_include": ["case-insensitive"]
    },
    {
      "id": "json_serialization",
      "verifier_assertion": "Output must use json.dumps(sort_keys=True, indent=2) with trailing newline",
      "script_refs": ["slice_output_serialization"],
      "must_include": ["sort_keys=True, indent=2", "trailing newline"]
    }
  ]
}
