+
+"""Retention-policy sweeper for dupeGuru's ``core``.
+
+A scriptable, offline retention engine layered on dupeGuru's own file model
+(:mod:`core.fs`) and directory-state walk (:mod:`core.directories`). Declarative
+policies decide what to give up -- by age, idle time, size, glob, extension --
+honouring protected/pinned paths, keep-counts and byte budgets, in a chosen
+eviction order. A run produces a **pure plan** you can preview (dry run) before
+you **apply** it; the executor is the only part that touches the filesystem, and
+it refuses protected targets, guards against stale plans, and is idempotent.
+
+Everything a caller needs is re-exported here for
+``from core.sweep import ...``.
+"""
+
+from __future__ import annotations
+
+from .errors import (
+    InvalidPolicyError,
+    InvalidScanRootError,
+    ProtectedPathError,
+    StalePlanError,
+    SweepConfigError,
+    SweepError,
+    SweepExecutionError,
+    UnknownOrderingError,
+    UnknownRuleError,
+)
+from .executor import (
+    ActionOutcome,
+    SweepExecutor,
+    SweepRunReport,
+)
+from .item import SweepItem
+from .loader import (
+    DEFAULT_SETTINGS,
+    load_policy,
+    load_session,
+    load_settings,
+    merge_documents,
+)
+from .ordering import (
+    ORDERINGS,
+    EvictionOrdering,
+    LargestFirst,
+    LeastRecentlyUsed,
+    MostRecentlyUsed,
+    NewestFirst,
+    OldestFirst,
+    SmallestFirst,
+    make_ordering,
+)
+from .plan import SweepAction, SweepPlan, build_plan
+from .policy import ACTION_DELETE, ACTION_TRASH, RetentionPolicy
+from .report import SweepReport
+from .rules import (
+    EVICT,
+    KEEP,
+    AgeRule,
+    ExtensionRule,
+    GlobRule,
+    IdleRule,
+    MatchAllRule,
+    RetentionRule,
+    RuleSet,
+    SizeRule,
+    Verdict,
+    make_rule,
+)
+from .scanner import ScanSpec, SweepScanner
+from .session import SweepSession
+
+__all__ = [
+    # errors
+    "SweepError",
+    "SweepConfigError",
+    "InvalidPolicyError",
+    "UnknownRuleError",
+    "UnknownOrderingError",
+    "InvalidScanRootError",
+    "SweepExecutionError",
+    "ProtectedPathError",
+    "StalePlanError",
+    # item
+    "SweepItem",
+    # scanner
+    "ScanSpec",
+    "SweepScanner",
+    # rules
+    "KEEP",
+    "EVICT",
+    "Verdict",
+    "RetentionRule",
+    "AgeRule",
+    "IdleRule",
+    "SizeRule",
+    "GlobRule",
+    "ExtensionRule",
+    "MatchAllRule",
+    "make_rule",
+    "RuleSet",
+    # ordering
+    "EvictionOrdering",
+    "OldestFirst",
+    "NewestFirst",
+    "LargestFirst",
+    "SmallestFirst",
+    "LeastRecentlyUsed",
+    "MostRecentlyUsed",
+    "ORDERINGS",
+    "make_ordering",
+    # policy
+    "ACTION_DELETE",
+    "ACTION_TRASH",
+    "RetentionPolicy",
+    # plan
+    "SweepAction",
+    "SweepPlan",
+    "build_plan",
+    # executor
+    "ActionOutcome",
+    "SweepRunReport",
+    "SweepExecutor",
+    # session
+    "SweepSession",
+    # loader
+    "DEFAULT_SETTINGS",
+    "merge_documents",
+    "load_settings",
+    "load_policy",
