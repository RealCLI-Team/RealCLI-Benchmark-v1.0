index 00000000..e612817c
--- /dev/null
+++ b/core/sweep/errors.py
@@ -0,0 +1,69 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Exceptions for the retention-policy sweeper.
+
+Configuration problems (an unknown rule kind, a bad ordering name, a missing
+scan root) are kept distinct from execution problems (a file changed under us,
+a protected path targeted for eviction), so a policy can be fully validated
+before a single file is touched.
+"""
+
+
+class SweepError(Exception):
+    """Root of every error raised by :mod:`core.sweep`."""
+
+
+# --- Configuration errors (raised before any filesystem mutation) -------------
+class SweepConfigError(SweepError):
+    """The policy or run was misconfigured. Detectable up-front."""
+
+
+class InvalidPolicyError(SweepConfigError):
+    """A retention policy is malformed (bad rule spec, contradictory budget)."""
+
+
+class UnknownRuleError(SweepConfigError):
+    """A rule was requested by a kind we don't recognise."""
+
+
+class UnknownOrderingError(SweepConfigError):
+    """An eviction ordering was requested by a name we don't recognise."""
+
+
+class InvalidScanRootError(SweepConfigError):
+    """A path handed to the scanner is missing or is not a directory."""
+
+
+# --- Execution errors (raised while applying a plan) --------------------------
+class SweepExecutionError(SweepError):
+    """A sweep action failed while being applied.
+
+    Carries the offending ``action`` and, when relevant, the underlying
+    ``cause`` so a caller can log precisely what went wrong.
+    """
+
+    def __init__(self, message, action=None, cause=None):
+        super().__init__(message)
+        self.action = action
+        self.cause = cause
+
+
+class ProtectedPathError(SweepExecutionError):
+    """An action tried to evict a protected (reference / pinned) path.
+
+    A well-formed plan never contains such an action; hitting one means a
+    hand-crafted or corrupted plan, and it is a hard error.
+    """
+
+
+class StalePlanError(SweepExecutionError):
+    """A target changed on disk since the plan was built.
+
+    Raised at apply time when a file's size / mtime no longer matches the
+    snapshot the plan was computed against, unless the caller opted to ignore
+    staleness.
+    """
diff --git a/core/sweep/executor.py b/core/sweep/executor.py
new file mode 100644
index 00000000..2ad0c839
--- /dev/null
+++ b/core/sweep/executor.py
@@ -0,0 +1,229 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Applying a :class:`~core.sweep.plan.SweepPlan` to the filesystem.
+
+This is the *only* module in :mod:`core.sweep` that mutates anything. Everything
+else -- scanning, rules, ordering, policy, plan -- is read-only or pure. The
+executor enforces the safety contract:
+
+* **Dry run** (the default) performs no I/O and reports exactly what a real run
+  would do.
+* **Protected** targets are a hard error (:class:`ProtectedPathError`): a
+  well-formed plan never contains one, so hitting one means a corrupted or
+  hand-edited plan and we refuse the whole run.
+* **Staleness**: if a target changed on disk since the plan was built, we raise
+  :class:`StalePlanError` -- unless ``ignore_stale`` is set, in which case the
+  stale action is skipped and recorded.
+* **Idempotency**: a target that has already vanished is not an error; it is
+  reported as ``already-gone`` so re-applying a plan converges.
+
+Deletion uses :func:`os.remove`; trashing delegates to an injectable
+``trash_func`` (defaulting to ``send2trash`` when available) so tests can run
+fully offline without a real desktop trash.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from .errors import ProtectedPathError, StalePlanError, SweepExecutionError
+from .policy import ACTION_DELETE, ACTION_TRASH
+
+__all__ = ["ActionOutcome", "SweepExecutor", "SweepRunReport"]
+
+# Outcome codes for a single action.
+OUTCOME_DELETED = "deleted"
+OUTCOME_TRASHED = "trashed"
+OUTCOME_PLANNED = "planned"  # dry-run: would have acted
+OUTCOME_ALREADY_GONE = "already-gone"
+OUTCOME_SKIPPED_STALE = "skipped-stale"
+
+
+def _default_trash(path):
+    """Best-effort desktop-trash a path, falling back to removal offline.
+
+    dupeGuru ships Send2Trash as a dependency; when present we use it. In a
+    headless CI box it may be unusable, so we degrade to :func:`os.remove` --
+    the caller can always inject a strict trash function instead.
+    """
+    try:
+        from send2trash import send2trash  # type: ignore
+
+        send2trash(str(path))
+        return
+    except Exception:
+        # Fall back to a plain removal so offline / headless runs still work.
+        os.remove(str(path))
+
+
+class ActionOutcome:
+    """What happened (or would happen) to one action."""
+
+    __slots__ = ("action", "outcome", "detail")
+
+    def __init__(self, action, outcome, detail=""):
+        self.action = action
+        self.outcome = outcome
+        self.detail = detail
+
+    @property
+    def path(self):
+        return self.action.item.path
+
+    @property
+    def freed_size(self):
+        """Apparent bytes actually freed by this outcome (0 if nothing happened)."""
+        if self.outcome in (OUTCOME_DELETED, OUTCOME_TRASHED):
+            return self.action.item.size
+        return 0
+
+    @property
+    def freed_allocated(self):
+        if self.outcome in (OUTCOME_DELETED, OUTCOME_TRASHED):
+            return self.action.item.allocated_size
+        return 0
+
+    def as_dict(self):
+        return {
+            "path": str(self.action.item.path),
+            "verb": self.action.verb,
+            "outcome": self.outcome,
+            "detail": self.detail,
+        }
+
+    def __repr__(self):
+        return f"<ActionOutcome {self.outcome} {str(self.action.item.path)!r}>"
+
+
+class SweepRunReport:
+    """The result of executing (or dry-running) a plan."""
+
+    def __init__(self, outcomes, dry_run):
+        self.outcomes = list(outcomes)
+        self.dry_run = dry_run
+
+    def of_outcome(self, code):
+        return [o for o in self.outcomes if o.outcome == code]
+
+    @property
+    def acted(self):
+        """Outcomes that actually removed a file (empty on a dry run)."""
+        return [o for o in self.outcomes if o.outcome in (OUTCOME_DELETED, OUTCOME_TRASHED)]
+
+    @property
+    def planned(self):
+        return self.of_outcome(OUTCOME_PLANNED)
+
+    @property
+    def already_gone(self):
+        return self.of_outcome(OUTCOME_ALREADY_GONE)
+
+    @property
+    def skipped_stale(self):
+        return self.of_outcome(OUTCOME_SKIPPED_STALE)
+
+    @property
+    def freed_size(self):
+        return sum(o.freed_size for o in self.outcomes)
+
+    @property
+    def freed_allocated(self):
+        return sum(o.freed_allocated for o in self.outcomes)
+
+    def outcome_counts(self):
+        counts = {}
+        for o in self.outcomes:
+            counts[o.outcome] = counts.get(o.outcome, 0) + 1
+        return counts
+
+    def as_dict(self):
+        return {
+            "dry_run": self.dry_run,
+            "freed_size": self.freed_size,
+            "freed_allocated": self.freed_allocated,
+            "outcome_counts": self.outcome_counts(),
+            "outcomes": [o.as_dict() for o in self.outcomes],
+        }
+
+    def __len__(self):
+        return len(self.outcomes)
+
+    def __iter__(self):
+        return iter(self.outcomes)
+
+    def __repr__(self):
+        kind = "dry-run" if self.dry_run else "apply"
+        return f"<SweepRunReport {kind} {len(self.outcomes)} actions freed={self.freed_allocated}b>"
+
+
+class SweepExecutor:
+    """Applies plans, enforcing the dry-run / protected / stale / idempotent contract."""
+
+    def __init__(self, dry_run=True, ignore_stale=False, trash_func=None, delete_func=None):
+        self.dry_run = dry_run
+        self.ignore_stale = ignore_stale
+        self._trash_func = trash_func if trash_func is not None else _default_trash
+        self._delete_func = delete_func if delete_func is not None else (lambda p: os.remove(str(p)))
+
+    def _validate(self, plan):
+        """Pre-flight: refuse the whole plan if it targets a protected path."""
+        for action in plan.actions:
+            if getattr(action.item, "protected", False):
+                raise ProtectedPathError(
+                    f"plan targets a protected path: {action.item.path}", action=action
+                )
+
+    def _apply_one(self, action):
+        item = action.item
+        path = Path(item.path)
+        # Idempotency: already gone -> converge silently.
+        if not item.exists():
+            return ActionOutcome(action, OUTCOME_ALREADY_GONE)
+        # Staleness: content drifted since planning.
+        if item.is_stale():
+            if not self.ignore_stale:
+                raise StalePlanError(
+                    f"target changed since plan was built: {path}", action=action
+                )
+            return ActionOutcome(action, OUTCOME_SKIPPED_STALE, detail="ignored stale target")
+        if self.dry_run:
+            return ActionOutcome(action, OUTCOME_PLANNED)
+        try:
+            if action.verb == ACTION_TRASH:
+                self._trash_func(path)
+                return ActionOutcome(action, OUTCOME_TRASHED)
+            elif action.verb == ACTION_DELETE:
+                self._delete_func(path)
+                return ActionOutcome(action, OUTCOME_DELETED)
+            else:
+                raise SweepExecutionError(f"unknown action verb {action.verb!r}", action=action)
+        except (ProtectedPathError, StalePlanError, SweepExecutionError):
+            raise
+        except OSError as exc:
+            raise SweepExecutionError(
+                f"failed to {action.verb} {path}: {exc}", action=action, cause=exc
+            )
+
+    def run(self, plan):
+        """Execute (or dry-run) ``plan`` and return a :class:`SweepRunReport`.
+
+        Protected-path validation happens up-front, so a plan that would touch a
+        protected path fails before any file is removed.
+        """
+        self._validate(plan)
+        outcomes = [self._apply_one(action) for action in plan.actions]
+        return SweepRunReport(outcomes, dry_run=self.dry_run)
+
+    def preview(self, plan):
+        """Dry-run ``plan`` regardless of this executor's ``dry_run`` flag."""
+        saved = self.dry_run
+        self.dry_run = True
+        try:
+            return self.run(plan)
+        finally:
+            self.dry_run = saved
diff --git a/core/sweep/item.py b/core/sweep/item.py
new file mode 100644
index 00000000..90d1efd0
--- /dev/null
+++ b/core/sweep/item.py
@@ -0,0 +1,214 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The unit a retention policy acts on: a sweepable item.
+
+A :class:`SweepItem` wraps one file with the facts a retention decision needs --
+its size (both apparent and allocated), its age and idle time, whether it's
+protected -- snapshotted at scan time. It is built from a
+:class:`core.fs.File`, so the sweeper stays layered on dupeGuru's file model
+rather than re-statting paths itself. The snapshot is also what
+staleness-checking compares against at apply time.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from core import fs
+
+# A stat block is 512 bytes by POSIX definition (see the disk analyzer, which
+# uses the same convention). We inline the tiny helper here to avoid a
+# cross-package dependency between two independent add-on packages.
+_STAT_BLOCK_SIZE = 512
+
+
+def _allocated_of(stat_result):
+    st_blocks = getattr(stat_result, "st_blocks", None)
+    if st_blocks is None:
+        return int(getattr(stat_result, "st_size", 0) or 0)
+    return int(st_blocks) * _STAT_BLOCK_SIZE
+
+
+class SweepItem:
+    """One candidate file for retention, with its facts snapshotted.
+
+    ``mtime`` / ``atime`` are snapshotted so age and idle time are computed
+    against a single reference clock shared by the whole run. ``size`` (the
+    apparent length) and ``mtime`` are also the fields staleness-checking
+    watches -- if either changes on disk, the plan built from this snapshot is
+    considered stale.
+    """
+
+    __slots__ = (
+        "path",
+        "size",
+        "allocated_size",
+        "mtime",
+        "atime",
+        "protected",
+        "_ref_time",
+    )
+
+    def __init__(
+        self,
+        path,
+        size,
+        allocated_size,
+        mtime,
+        atime=None,
+        protected=False,
+        ref_time=None,
+    ):
+        self.path = Path(path)
+        self.size = int(size)
+        self.allocated_size = int(allocated_size)
+        self.mtime = float(mtime)
+        self.atime = float(atime) if atime is not None else float(mtime)
+        self.protected = bool(protected)
+        self._ref_time = float(ref_time) if ref_time is not None else None
+
+    # --- Construction ---------------------------------------------------------
+    @classmethod
+    def from_file(cls, file, ref_time=None, protected=None):
+        """Build an item from a :class:`core.fs.File`.
+
+        ``protected`` defaults to the file's ``is_ref`` flag (a reference-folder
+        file), but may be forced by the caller (e.g. a pinned path).
+        """
+        path = Path(file.path)
+        size = int(file.size)
+        mtime = float(file.mtime)
+        atime = mtime
+        allocated = size
+        try:
+            st = path.stat()
+            size = int(st.st_size)
+            allocated = _allocated_of(st)
+            mtime = float(st.st_mtime)
+            atime = float(st.st_atime)
+        except OSError:
+            pass
+        if protected is None:
+            protected = bool(getattr(file, "is_ref", False))
+        return cls(
+            path=path,
+            size=size,
+            allocated_size=allocated,
+            mtime=mtime,
+            atime=atime,
+            protected=protected,
+            ref_time=ref_time,
+        )
+
+    @classmethod
+    def from_path(cls, path, ref_time=None, protected=False):
+        path = Path(path)
+        file = fs.get_file(path)
+        if file is None:
+            st = path.stat()
+            return cls(
+                path=path,
+                size=int(st.st_size),
+                allocated_size=_allocated_of(st),
+                mtime=float(st.st_mtime),
+                atime=float(st.st_atime),
+                protected=protected,
+                ref_time=ref_time,
+            )
+        return cls.from_file(file, ref_time=ref_time, protected=protected)
+
+    def with_ref_time(self, ref_time):
+        return SweepItem(
+            path=self.path,
+            size=self.size,
+            allocated_size=self.allocated_size,
+            mtime=self.mtime,
+            atime=self.atime,
+            protected=self.protected,
+            ref_time=ref_time,
+        )
+
+    # --- Derived facts --------------------------------------------------------
+    @property
+    def name(self):
+        return self.path.name
+
+    @property
+    def extension(self):
+        suffix = self.path.suffix
+        return suffix.lower().lstrip(".") if suffix else ""
+
+    @property
+    def ref_time(self):
+        return self._ref_time
+
+    def age_seconds(self, ref_time=None):
+        """Seconds since last modification, against ``ref_time`` or the anchor."""
+        anchor = ref_time if ref_time is not None else self._ref_time
+        if anchor is None:
+            raise ValueError("age_seconds requires a reference time")
+        return max(0.0, float(anchor) - self.mtime)
+
+    def idle_seconds(self, ref_time=None):
+        """Seconds since last access, against ``ref_time`` or the anchor."""
+        anchor = ref_time if ref_time is not None else self._ref_time
+        if anchor is None:
+            raise ValueError("idle_seconds requires a reference time")
+        return max(0.0, float(anchor) - self.atime)
+
+    # --- Staleness ------------------------------------------------------------
+    def is_stale(self):
+        """True if the file changed (size / mtime) or vanished since the snapshot.
+
+        Used by the executor to refuse acting on a plan whose assumptions no
+        longer hold. A vanished file is *not* stale in the "changed" sense -- it
+        is handled as "already-swept" by the executor -- so this only reports
+        content drift for files that still exist.
+        """
+        try:
+            st = self.path.stat()
+        except OSError:
+            return False
+        if int(st.st_size) != self.size:
+            return True
+        # mtime is a float; compare with a small tolerance for fs granularity.
+        return abs(float(st.st_mtime) - self.mtime) > 1e-6
+
+    def exists(self):
+        try:
+            return self.path.exists()
+        except OSError:
+            return False
+
+    # --- Dict / equality ------------------------------------------------------
+    def as_dict(self):
+        d = {
+            "path": str(self.path),
+            "name": self.name,
+            "size": self.size,
+            "allocated_size": self.allocated_size,
+            "mtime": self.mtime,
+            "atime": self.atime,
+            "protected": self.protected,
+        }
+        if self._ref_time is not None:
+            d["age_seconds"] = self.age_seconds()
+            d["idle_seconds"] = self.idle_seconds()
+        return d
+
+    def __eq__(self, other):
+        if not isinstance(other, SweepItem):
+            return NotImplemented
+        return self.path == other.path
+
+    def __hash__(self):
+        return hash(self.path)
+
+    def __repr__(self):
+        prot = " protected" if self.protected else ""
+        return f"<SweepItem {str(self.path)} {self.size}b{prot}>"
