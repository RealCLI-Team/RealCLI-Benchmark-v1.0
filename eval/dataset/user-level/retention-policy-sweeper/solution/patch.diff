+++ b/core/sweep/loader.py
@@ -0,0 +1,156 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Layered configuration for retention runs.
+
+Real fleets carry retention rules in layered config: a shared *base* plus
+per-machine / per-user *overlays*. :func:`merge_documents` deep-merges those
+documents into one; :func:`load_session` turns the merged document into a ready
+:class:`~core.sweep.session.SweepSession`.
+
+Merge semantics (identical to the reclaim / diskscan loaders so operators learn
+them once):
+
+* later documents override earlier **scalars**;
+* **list**-valued keys in a known set (``roots``, ``include_ext`` ...) are
+  **appended** and de-duplicated, not replaced;
+* a key set explicitly to ``None`` **deletes** it;
+* everything else (nested dicts) merges recursively.
+"""
+
+from __future__ import annotations
+
+from .errors import InvalidPolicyError
+from .ordering import make_ordering
+from .policy import ACTION_TRASH, RetentionPolicy
+from .rules import RuleSet, make_rule
+from .scanner import ScanSpec
+from .session import SweepSession
+
+__all__ = [
+    "DEFAULT_SETTINGS",
+    "merge_documents",
+    "load_settings",
+    "load_policy",
+    "load_session",
+]
+
+# List-valued keys that append across layers rather than replace.
+_APPEND_LIST_KEYS = frozenset(
+    {
+        "roots",
+        "paths",
+        "reference_roots",
+        "references",
+        "excluded_roots",
+        "excludes",
+        "include_ext",
+        "exclude_ext",
+        "include_globs",
+        "exclude_globs",
+        "rules",
+    }
+)
+
+DEFAULT_SETTINGS = {
+    "scan": {},
+    "policy": {
+        "action": ACTION_TRASH,
+        "ordering": "oldest-first",
+        "keep_last": 0,
+        "max_total_bytes": 0,
+        "default_action": "keep",
+        "rules": [],
+    },
+}
+
+
+def _merge_two(base, overlay):
+    """Deep-merge ``overlay`` onto ``base`` returning a new dict."""
+    result = dict(base)
+    for key, value in overlay.items():
+        if value is None:
+            # Explicit deletion.
+            result.pop(key, None)
+            continue
+        if key in _APPEND_LIST_KEYS and isinstance(value, list):
+            existing = result.get(key)
+            if isinstance(existing, list):
+                merged = list(existing)
+                for elem in value:
+                    # De-dupe scalars; always append dicts (rule specs).
+                    if isinstance(elem, (dict, list)):
+                        merged.append(elem)
+                    elif elem not in merged:
+                        merged.append(elem)
+                result[key] = merged
+            else:
+                result[key] = list(value)
+            continue
+        if isinstance(value, dict) and isinstance(result.get(key), dict):
+            result[key] = _merge_two(result[key], value)
+            continue
+        result[key] = value
+    return result
+
+
+def merge_documents(*documents):
+    """Deep-merge any number of config documents left-to-right."""
+    merged = {}
+    for doc in documents:
+        if doc is None:
+            continue
+        if not isinstance(doc, dict):
+            raise InvalidPolicyError(f"config document must be a mapping, got {type(doc).__name__}")
+        merged = _merge_two(merged, doc)
+    return merged
+
+
+def load_settings(*documents):
+    """Merge ``documents`` on top of :data:`DEFAULT_SETTINGS`."""
+    return merge_documents(DEFAULT_SETTINGS, *documents)
+
+
+def _policy_from_settings(policy_settings):
+    """Build a :class:`RetentionPolicy` from the ``policy`` config block."""
+    settings = policy_settings or {}
+    rule_specs = settings.get("rules", [])
+    if rule_specs and not isinstance(rule_specs, list):
+        raise InvalidPolicyError("policy 'rules' must be a list of rule specs")
+    rules = [make_rule(spec) for spec in rule_specs]
+    default_action = settings.get("default_action", "keep")
+    rule_set = RuleSet(rules, default_action=default_action)
+    ordering = make_ordering(settings.get("ordering", "oldest-first"))
+    return RetentionPolicy(
+        name=settings.get("name", "retention"),
+        rule_set=rule_set,
+        ordering=ordering,
+        keep_last=settings.get("keep_last", 0),
+        max_total_bytes=settings.get("max_total_bytes", 0),
+        action=settings.get("action", ACTION_TRASH),
+    )
+
+
+def load_policy(*documents):
+    """Merge documents and build just the :class:`RetentionPolicy`."""
+    settings = load_settings(*documents)
+    return _policy_from_settings(settings.get("policy", {}))
+
+
+def _scan_spec_from_settings(scan_settings):
+    settings = scan_settings or {}
+    roots = settings.get("roots", settings.get("paths", []))
+    if not roots:
+        raise InvalidPolicyError("configuration must specify at least one scan root ('roots')")
+    return ScanSpec.from_dict(settings)
+
+
+def load_session(*documents, clock=None):
+    """Merge documents and build a ready :class:`SweepSession`."""
+    settings = load_settings(*documents)
+    spec = _scan_spec_from_settings(settings.get("scan", {}))
+    policy = _policy_from_settings(settings.get("policy", {}))
+    return SweepSession(spec, policy, clock=clock)
diff --git a/core/sweep/ordering.py b/core/sweep/ordering.py
new file mode 100644
index 00000000..6c9c426b
--- /dev/null
+++ b/core/sweep/ordering.py
@@ -0,0 +1,136 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Eviction orderings.
+
+Once the rules have decided *which* items may be evicted, count- and budget-based
+retention needs to decide *in what order* to give them up: keep the newest N,
+free space by dropping the biggest first, evict least-recently-used first, and
+so on. An ordering is just a deterministic sort key over items -- the item that
+should be evicted **first** sorts **first**.
+
+Every ordering breaks ties on the item's path so the result is stable and does
+not wobble with directory-walk order.
+"""
+
+from __future__ import annotations
+
+from .errors import UnknownOrderingError
+
+__all__ = [
+    "EvictionOrdering",
+    "OldestFirst",
+    "NewestFirst",
+    "LargestFirst",
+    "SmallestFirst",
+    "LeastRecentlyUsed",
+    "MostRecentlyUsed",
+    "ORDERINGS",
+    "make_ordering",
+]
+
+
+class EvictionOrdering:
+    """Base class: sorts items so the *first-to-evict* comes first.
+
+    Subclasses provide :meth:`sort_key`. The path tie-breaker is applied by
+    :meth:`order` so subclasses need only express their primary criterion.
+    """
+
+    name = "ordering"
+
+    def sort_key(self, item):  # pragma: no cover - abstract
+        raise NotImplementedError
+
+    def order(self, items):
+        """Return a new list of ``items`` in eviction order (first = evict first)."""
+        return sorted(items, key=lambda it: (self.sort_key(it), str(it.path)))
+
+    def __repr__(self):
+        return f"<{type(self).__name__} {self.name!r}>"
+
+
+class OldestFirst(EvictionOrdering):
+    """Evict the oldest (largest modification age) first.
+
+    This is the natural ordering for a "keep the most recent N" policy.
+    """
+
+    name = "oldest-first"
+
+    def sort_key(self, item):
+        # Larger age should sort first -> negate.
+        return -item.age_seconds()
+
+
+class NewestFirst(EvictionOrdering):
+    """Evict the newest first (rarely what you want, provided for symmetry)."""
+
+    name = "newest-first"
+
+    def sort_key(self, item):
+        return item.age_seconds()
+
+
+class LargestFirst(EvictionOrdering):
+    """Evict the largest (by allocated size) first -- frees space fastest."""
+
+    name = "largest-first"
+
+    def sort_key(self, item):
+        return -item.allocated_size
+
+
+class SmallestFirst(EvictionOrdering):
+    """Evict the smallest first."""
+
+    name = "smallest-first"
+
+    def sort_key(self, item):
+        return item.allocated_size
+
+
+class LeastRecentlyUsed(EvictionOrdering):
+    """Evict the least-recently-*accessed* first (classic LRU by atime)."""
+
+    name = "lru"
+
+    def sort_key(self, item):
+        # Largest idle time first.
+        return -item.idle_seconds()
+
+
+class MostRecentlyUsed(EvictionOrdering):
+    """Evict the most-recently-accessed first (MRU)."""
+
+    name = "mru"
+
+    def sort_key(self, item):
+        return item.idle_seconds()
+
+
+ORDERINGS = {
+    OldestFirst.name: OldestFirst,
+    NewestFirst.name: NewestFirst,
+    LargestFirst.name: LargestFirst,
+    SmallestFirst.name: SmallestFirst,
+    LeastRecentlyUsed.name: LeastRecentlyUsed,
+    "least-recently-used": LeastRecentlyUsed,
+    MostRecentlyUsed.name: MostRecentlyUsed,
+    "most-recently-used": MostRecentlyUsed,
+}
+
+
+def make_ordering(name):
+    """Resolve an ordering by name (``oldest-first``, ``largest-first``, ``lru`` ...)."""
+    if isinstance(name, EvictionOrdering):
+        return name
+    if name is None:
+        return OldestFirst()
+    cls = ORDERINGS.get(str(name).strip().lower())
+    if cls is None:
+        raise UnknownOrderingError(f"unknown eviction ordering {name!r}")
+    return cls()
diff --git a/core/sweep/plan.py b/core/sweep/plan.py
new file mode 100644
index 00000000..198012b3
--- /dev/null
+++ b/core/sweep/plan.py
@@ -0,0 +1,141 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The sweep plan: an ordered, serialisable list of eviction actions.
+
+A :class:`SweepPlan` is what a policy produces and an executor consumes. It is
+**pure data** -- building or inspecting a plan never touches the filesystem.
+Each :class:`SweepAction` names a target item, the action verb (delete / trash),
+and carries the snapshot needed for staleness-checking at apply time.
+
+Keeping the plan separate from execution is what makes "dry run" honest: the
+same object the executor would run is the one you print and diff.
+"""
+
+from __future__ import annotations
+
+from .policy import ACTION_DELETE, ACTION_TRASH
+
+__all__ = ["SweepAction", "SweepPlan", "build_plan"]
+
+
+class SweepAction:
+    """A single intended eviction."""
+
+    __slots__ = ("item", "verb", "reason")
+
+    def __init__(self, item, verb, reason=""):
+        self.item = item
+        self.verb = verb
+        self.reason = reason
+
+    @property
+    def path(self):
+        return self.item.path
+
+    @property
+    def size(self):
+        return self.item.size
+
+    @property
+    def allocated_size(self):
+        return self.item.allocated_size
+
+    def as_dict(self):
+        return {
+            "path": str(self.item.path),
+            "verb": self.verb,
+            "size": self.item.size,
+            "allocated_size": self.item.allocated_size,
+            "reason": self.reason,
+        }
+
+    def __repr__(self):
+        return f"<SweepAction {self.verb} {str(self.item.path)!r}>"
+
+
+class SweepPlan:
+    """An ordered set of :class:`SweepAction` plus book-keeping."""
+
+    def __init__(self, actions=None, policy_name="retention", root=None):
+        self.actions = list(actions or [])
+        self.policy_name = policy_name
+        self.root = root
+
+    # --- Accounting -----------------------------------------------------------
+    @property
+    def action_count(self):
+        return len(self.actions)
+
+    @property
+    def is_empty(self):
+        return not self.actions
+
+    @property
+    def reclaimable_size(self):
+        """Apparent bytes freed if the plan is fully applied."""
+        return sum(a.size for a in self.actions)
+
+    @property
+    def reclaimable_allocated(self):
+        """Allocated (on-disk) bytes freed if the plan is fully applied."""
+        return sum(a.allocated_size for a in self.actions)
+
+    @property
+    def paths(self):
+        return [str(a.item.path) for a in self.actions]
+
+    def by_verb(self, verb):
+        return [a for a in self.actions if a.verb == verb]
+
+    def verb_counts(self):
+        counts = {}
+        for a in self.actions:
+            counts[a.verb] = counts.get(a.verb, 0) + 1
+        return counts
+
+    # --- Serialisation --------------------------------------------------------
+    def as_dict(self):
+        return {
+            "policy": self.policy_name,
+            "root": str(self.root) if self.root is not None else None,
+            "action_count": self.action_count,
+            "reclaimable_size": self.reclaimable_size,
+            "reclaimable_allocated": self.reclaimable_allocated,
+            "verb_counts": self.verb_counts(),
+            "actions": [a.as_dict() for a in self.actions],
+        }
+
+    def __len__(self):
+        return len(self.actions)
+
+    def __iter__(self):
+        return iter(self.actions)
+
+    def __repr__(self):
+        return (
+            f"<SweepPlan {self.policy_name!r} {self.action_count} actions "
+            f"{self.reclaimable_allocated}b>"
+        )
+
+
+def build_plan(policy, items, root=None):
+    """Turn a policy + items into a :class:`SweepPlan` (pure; no I/O).
+
+    The action verb comes from the policy (``delete`` / ``trash``); the reason
+    is the winning rule's reason as recorded on the item's verdict.
+    """
+    verb = ACTION_DELETE if policy.action == ACTION_DELETE else ACTION_TRASH
+    selected = policy.select(items)
+    # Reasons: classify the selected items so each action carries its "why".
+    reason_by_path = {}
+    for verdict in policy.rule_set.classify_all(selected):
+        reason_by_path[verdict.item.path] = verdict.reason
+    actions = [
+        SweepAction(item, verb, reason=reason_by_path.get(item.path, ""))
+        for item in selected
+    ]
+    return SweepPlan(actions=actions, policy_name=policy.name, root=root)
diff --git a/core/sweep/policy.py b/core/sweep/policy.py
new file mode 100644
index 00000000..cee36450
--- /dev/null
+++ b/core/sweep/policy.py
@@ -0,0 +1,154 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The declarative retention policy: rules + limits + ordering.
+
+A :class:`RetentionPolicy` bundles everything that decides *what to give up*:
+
+* a :class:`~core.sweep.rules.RuleSet` -- the per-item keep/evict votes;
+* an :class:`~core.sweep.ordering.EvictionOrdering` -- the order to sacrifice
+  candidates in;
+* a **keep count** (``keep_last``) -- always retain at least the N best items
+  (the "best" being the ones the ordering evicts *last*);
+* a **budget** -- an upper bound on retained allocated bytes; evict from the
+  ordering until the survivors fit.
+* an **action** -- ``delete`` or ``trash`` -- how survivors of the plan get
+  removed (the policy expresses intent; the executor carries it out).
+
+The policy is *pure data + selection logic*: :meth:`select` turns a list of
+items into the ordered list that should be evicted, honouring protection, rule
+votes, the keep-count and the budget together. It never touches the filesystem.
+"""
+
+from __future__ import annotations
+
+from .errors import InvalidPolicyError
+from .ordering import EvictionOrdering, OldestFirst, make_ordering
+from .rules import EVICT, KEEP, RuleSet
+
+__all__ = ["ACTION_DELETE", "ACTION_TRASH", "RetentionPolicy"]
+
+ACTION_DELETE = "delete"
+ACTION_TRASH = "trash"
+_ACTIONS = (ACTION_DELETE, ACTION_TRASH)
+
+
+class RetentionPolicy:
+    """A named, declarative retention policy."""
+
+    def __init__(
+        self,
+        name="retention",
+        rule_set=None,
+        ordering=None,
+        keep_last=0,
+        max_total_bytes=0,
+        action=ACTION_TRASH,
+    ):
+        self.name = name
+        self.rule_set = rule_set if rule_set is not None else RuleSet()
+        self.ordering = self._coerce_ordering(ordering)
+        self.keep_last = int(keep_last or 0)
+        if self.keep_last < 0:
+            raise InvalidPolicyError("keep_last must not be negative")
+        self.max_total_bytes = int(max_total_bytes or 0)
+        if self.max_total_bytes < 0:
+            raise InvalidPolicyError("max_total_bytes must not be negative")
+        if action not in _ACTIONS:
+            raise InvalidPolicyError(f"unknown action {action!r} (expected 'delete' or 'trash')")
+        self.action = action
+
+    @staticmethod
+    def _coerce_ordering(ordering):
+        if ordering is None:
+            return OldestFirst()
+        if isinstance(ordering, EvictionOrdering):
+            return ordering
+        return make_ordering(ordering)
+
+    @property
+    def has_budget(self):
+        return self.max_total_bytes > 0
+
+    # --- Selection ------------------------------------------------------------
+    def _rule_evictable(self, items):
+        """Items the rule set votes to evict (protected already excluded)."""
+        evictable = []
+        for verdict in self.rule_set.classify_all(items):
+            if verdict.is_evict:
+                evictable.append(verdict.item)
+        return evictable
+
+    def select(self, items):
+        """Return the items to evict, in eviction order.
+
+        Combines, in order:
+
+        1. **Rules** decide the pool of candidates (protected items are never in
+           it).
+        2. **keep_last** removes the N items the ordering would sacrifice *last*
+           from that pool (they are the ones most worth keeping).
+        3. **budget** -- if set, we additionally evict from the *kept* items,
+           worst-first, until retained allocated bytes fit under the budget.
+           Protected items still count toward the retained total but are never
+           themselves evicted.
+        """
+        ordered_candidates = self.ordering.order(self._rule_evictable(items))
+
+        # keep_last: spare the best `keep_last` candidates (evicted last).
+        if self.keep_last and ordered_candidates:
+            if self.keep_last >= len(ordered_candidates):
+                spared = list(ordered_candidates)
+                to_evict = []
+            else:
+                to_evict = ordered_candidates[: len(ordered_candidates) - self.keep_last]
+                spared = ordered_candidates[len(ordered_candidates) - self.keep_last :]
+        else:
+            to_evict = list(ordered_candidates)
+            spared = []
+
+        if not self.has_budget:
+            return to_evict
+
+        # Budget pass: figure out what is being retained if we evict `to_evict`,
+        # then, if that still exceeds the budget, evict more of the *spared*
+        # candidates (worst-first) until it fits.
+        evict_set = {it.path for it in to_evict}
+        retained = [it for it in items if it.path not in evict_set]
+        retained_bytes = sum(it.allocated_size for it in retained)
+
+        if retained_bytes <= self.max_total_bytes:
+            return to_evict
+
+        # Evict additional spared candidates in eviction order until we fit.
+        # `spared` is already the tail of the ordering; iterate it worst-first.
+        extra = []
+        spared_worst_first = self.ordering.order(spared)
+        for it in spared_worst_first:
+            if retained_bytes <= self.max_total_bytes:
+                break
+            extra.append(it)
+            retained_bytes -= it.allocated_size
+        # Preserve overall eviction order: recompute over the union.
+        final = to_evict + extra
+        return self.ordering.order(final)
+
+    def as_dict(self):
+        return {
+            "name": self.name,
+            "action": self.action,
+            "ordering": self.ordering.name,
+            "keep_last": self.keep_last,
+            "max_total_bytes": self.max_total_bytes,
+            "rules": self.rule_set.as_dict(),
+        }
+
+    def __repr__(self):
+        return (
+            f"<RetentionPolicy {self.name!r} action={self.action} "
+            f"ordering={self.ordering.name} keep_last={self.keep_last} "
+            f"budget={self.max_total_bytes}>"
+        )
diff --git a/core/sweep/report.py b/core/sweep/report.py
new file mode 100644
index 00000000..246ee779
--- /dev/null
+++ b/core/sweep/report.py
@@ -0,0 +1,91 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Human- and machine-readable rendering of a plan and its execution.
+
+:class:`SweepReport` bundles a :class:`~core.sweep.plan.SweepPlan` with an
+optional :class:`~core.sweep.executor.SweepRunReport` and knows how to turn the
+pair into a dict, JSON, or a compact text summary -- the kind of thing an
+operator pastes into a ticket.
+"""
+
+from __future__ import annotations
+
+import json
+
+__all__ = ["SweepReport"]
+
+
+def _format_size(num_bytes):
+    """Binary-ladder human size (KiB / MiB ...), matching the disk analyzer."""
+    value = float(num_bytes)
+    for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
+        if abs(value) < 1024.0 or unit == "PiB":
+            if unit == "B":
+                return f"{int(value)} {unit}"
+            return f"{value:.1f} {unit}"
+        value /= 1024.0
+    return f"{value:.1f} PiB"  # pragma: no cover
+
+
+class SweepReport:
+    """A serialisable view over a plan (and, optionally, its run result)."""
+
+    def __init__(self, plan, run=None, policy=None):
+        self.plan = plan
+        self.run = run
+        self.policy = policy
+
+    def as_dict(self, include_actions=True):
+        d = {
+            "policy": self.plan.policy_name,
+            "root": str(self.plan.root) if self.plan.root is not None else None,
+            "action_count": self.plan.action_count,
+            "reclaimable_size": self.plan.reclaimable_size,
+            "reclaimable_allocated": self.plan.reclaimable_allocated,
+            "verb_counts": self.plan.verb_counts(),
+        }
+        if self.policy is not None:
+            d["policy_detail"] = self.policy.as_dict()
+        if include_actions:
+            d["actions"] = [a.as_dict() for a in self.plan.actions]
+        if self.run is not None:
+            d["run"] = self.run.as_dict()
+        return d
+
+    def as_json(self, include_actions=True, indent=2):
+        return json.dumps(self.as_dict(include_actions=include_actions), indent=indent, sort_keys=True)
+
+    def render_text(self):
+        lines = []
+        lines.append(f"Retention policy: {self.plan.policy_name}")
+        if self.plan.root is not None:
+            lines.append(f"Root: {self.plan.root}")
+        lines.append(
+            f"Planned actions: {self.plan.action_count} "
+            f"(reclaim {_format_size(self.plan.reclaimable_allocated)} allocated, "
+            f"{_format_size(self.plan.reclaimable_size)} apparent)"
+        )
+        counts = self.plan.verb_counts()
+        if counts:
+            verb_str = ", ".join(f"{v}: {n}" for v, n in sorted(counts.items()))
+            lines.append(f"  by action -> {verb_str}")
+        if self.run is not None:
+            kind = "DRY RUN" if self.run.dry_run else "APPLIED"
+            lines.append(
+                f"Run [{kind}]: freed {_format_size(self.run.freed_allocated)} allocated"
+            )
+            oc = self.run.outcome_counts()
+            if oc:
+                oc_str = ", ".join(f"{k}: {n}" for k, n in sorted(oc.items()))
+                lines.append(f"  outcomes -> {oc_str}")
+        # A few example targets, biggest first, for a human eyeball.
+        top = sorted(self.plan.actions, key=lambda a: -a.allocated_size)[:10]
+        if top:
+            lines.append("Largest targets:")
+            for a in top:
+                lines.append(f"  {_format_size(a.allocated_size):>10}  {a.verb:<7} {a.item.path}")
+        return "\n".join(lines)
