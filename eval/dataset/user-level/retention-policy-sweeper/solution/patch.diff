index 00000000..39ca4f16
--- /dev/null
+++ b/core/sweep/session.py
@@ -0,0 +1,109 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""The high-level retention session tying scan -> policy -> plan -> apply.
+
+A :class:`SweepSession` is the one object a caller normally holds. It scans once
+(the only read of the disk), builds a plan from the policy, and lets the caller
+**preview** (always a dry run) before **apply** (the real mutation). The scan and
+its reference time are captured once and reused so a preview and the apply that
+follows it act on the *same* snapshot -- the plan you saw is the plan that runs.
+
+The clock is injectable (``clock=lambda: ...``) so tests get a deterministic
+reference time without monkeypatching :mod:`time`.
+"""
+
+from __future__ import annotations
+
+import time
+
+from hscommon.jobprogress import job
+
+from .executor import SweepExecutor
+from .plan import build_plan
+from .policy import RetentionPolicy
+from .scanner import ScanSpec, SweepScanner
+
+__all__ = ["SweepSession"]
+
+
+class SweepSession:
+    """Orchestrates a retention run over a :class:`ScanSpec` and policy."""
+
+    def __init__(self, spec, policy, clock=None):
+        self.spec = spec
+        self.policy = policy if policy is not None else RetentionPolicy()
+        self._clock = clock if clock is not None else time.time
+        self._items = None
+        self._ref_time = None
+        self._plan = None
+
+    # --- Scanning -------------------------------------------------------------
+    def scan(self, force=False, ref_time=None, j=job.nulljob):
+        """Scan the disk once (cached). Returns the list of items."""
+        if self._items is not None and not force:
+            return self._items
+        self._ref_time = float(ref_time) if ref_time is not None else float(self._clock())
+        scanner = SweepScanner(self.spec, ref_time=self._ref_time)
+        self._items = scanner.scan(ref_time=self._ref_time, j=j)
+        self._plan = None  # invalidate any cached plan
+        return self._items
+
+    @property
+    def items(self):
+        if self._items is None:
+            self.scan()
+        return self._items
+
+    @property
+    def ref_time(self):
+        if self._ref_time is None:
+            self.scan()
+        return self._ref_time
+
+    # --- Planning -------------------------------------------------------------
+    def plan(self, force=False):
+        """Build (and cache) the sweep plan for the current scan."""
+        if self._plan is not None and not force:
+            return self._plan
+        items = self.items
+        root = self.spec.roots[0] if self.spec.roots else None
+        self._plan = build_plan(self.policy, items, root=root)
+        return self._plan
+
+    # --- Preview / apply ------------------------------------------------------
+    def preview(self):
+        """Dry-run the current plan; performs no filesystem mutation."""
+        executor = SweepExecutor(dry_run=True)
+        return executor.run(self.plan())
+
+    def apply(self, ignore_stale=False, trash_func=None, delete_func=None):
+        """Execute the current plan for real, returning the run report.
+
+        The plan is built from the cached scan, so callers should
+        :meth:`preview` first if they want to show intent before mutating.
+        """
+        executor = SweepExecutor(
+            dry_run=False,
+            ignore_stale=ignore_stale,
+            trash_func=trash_func,
+            delete_func=delete_func,
+        )
+        return executor.run(self.plan())
+
+    @classmethod
