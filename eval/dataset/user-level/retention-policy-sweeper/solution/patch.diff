@@ -0,0 +1,156 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Walking directories into a flat list of :class:`SweepItem`.
+
+Layers on :class:`core.directories.Directories` (tree walk + normal / reference
+/ excluded folder states) exactly like the reclaim and diskscan scanners, so a
+retention run honours the same folder-state vocabulary. Files in a *reference*
+folder come back ``protected=True`` -- the sweeper will never evict them.
+
+The scanner captures one **reference time** at the start of the walk so every
+age / idle computation in the run shares a single clock.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+from pathlib import Path
+
+from hscommon.jobprogress import job
+
+from core import fs
+from core.directories import Directories, DirectoryState, InvalidPathError
+
+from .errors import InvalidScanRootError
+from .item import SweepItem
+
+__all__ = ["ScanSpec", "SweepScanner"]
+
+
+class ScanSpec:
+    """Declarative description of *what* to scan for a retention run."""
+
+    __slots__ = (
+        "roots",
+        "reference_roots",
+        "excluded_roots",
+        "include_ext",
+        "exclude_ext",
+        "include_globs",
+        "exclude_globs",
+        "min_size",
+        "max_size",
+    )
+
+    def __init__(
+        self,
+        roots,
+        reference_roots=None,
+        excluded_roots=None,
+        include_ext=None,
+        exclude_ext=None,
+        include_globs=None,
+        exclude_globs=None,
+        min_size=0,
+        max_size=0,
+    ):
+        self.roots = [Path(p) for p in roots]
+        self.reference_roots = [Path(p) for p in (reference_roots or [])]
+        self.excluded_roots = [Path(p) for p in (excluded_roots or [])]
+        self.include_ext = {e.lower().lstrip(".") for e in (include_ext or [])}
+        self.exclude_ext = {e.lower().lstrip(".") for e in (exclude_ext or [])}
+        self.include_globs = list(include_globs or [])
+        self.exclude_globs = list(exclude_globs or [])
+        self.min_size = min_size
+        self.max_size = max_size
+
+    @classmethod
+    def from_dict(cls, data):
+        return cls(
+            roots=data.get("roots", data.get("paths", [])),
+            reference_roots=data.get("reference_roots", data.get("references", [])),
+            excluded_roots=data.get("excluded_roots", data.get("excludes", [])),
+            include_ext=data.get("include_ext"),
+            exclude_ext=data.get("exclude_ext"),
+            include_globs=data.get("include_globs"),
+            exclude_globs=data.get("exclude_globs"),
+            min_size=data.get("min_size", 0),
+            max_size=data.get("max_size", 0),
+        )
+
+    def _name_allowed(self, name):
+        ext = Path(name).suffix.lower().lstrip(".")
+        if self.include_ext and ext not in self.include_ext:
+            return False
+        if self.exclude_ext and ext in self.exclude_ext:
+            return False
+        if self.include_globs and not any(fnmatch.fnmatch(name, g) for g in self.include_globs):
+            return False
+        if self.exclude_globs and any(fnmatch.fnmatch(name, g) for g in self.exclude_globs):
+            return False
+        return True
+
+    def _size_allowed(self, size):
+        if self.min_size and size < self.min_size:
+            return False
+        if self.max_size and size > self.max_size:
+            return False
+        return True
+
+
+class SweepScanner:
+    """Collects :class:`SweepItem` for a :class:`ScanSpec`."""
+
+    def __init__(self, spec, ref_time=None):
+        self.spec = spec
+        self._ref_time = ref_time
+
+    def _build_directories(self):
+        dirs = Directories()
+        for root in self.spec.roots:
+            if not root.exists() or not root.is_dir():
+                raise InvalidScanRootError(f"scan root does not exist or is not a directory: {root}")
+            try:
+                dirs.add_path(root)
+            except InvalidPathError:
+                raise InvalidScanRootError(f"invalid scan root: {root}")
+        for ref in self.spec.reference_roots:
+            if not ref.exists() or not ref.is_dir():
+                raise InvalidScanRootError(f"reference root does not exist: {ref}")
+            if ref not in dirs:
+                try:
+                    dirs.add_path(ref)
+                except InvalidPathError:
+                    raise InvalidScanRootError(f"invalid reference root: {ref}")
+            dirs.set_state(ref, DirectoryState.REFERENCE)
+        for exc in self.spec.excluded_roots:
+            dirs.set_state(Path(exc), DirectoryState.EXCLUDED)
+        return dirs
+
+    def scan(self, ref_time=None, j=job.nulljob):
+        """Return the list of :class:`SweepItem` matching the spec.
+
+        Reference-folder files come back with ``protected=True``.
+        """
+        anchor = ref_time if ref_time is not None else self._ref_time
+        dirs = self._build_directories()
+        items = []
+        for file in dirs.get_files(fileclasses=[fs.File], j=j):
+            name = file.path.name
+            if not self.spec._name_allowed(name):
+                continue
+            if not self.spec._size_allowed(file.size):
+                continue
+            items.append(
+                SweepItem.from_file(
+                    file,
+                    ref_time=anchor,
+                    protected=bool(getattr(file, "is_ref", False)) or None,
+                )
+            )
+        items.sort(key=lambda it: str(it.path))
+        return items
