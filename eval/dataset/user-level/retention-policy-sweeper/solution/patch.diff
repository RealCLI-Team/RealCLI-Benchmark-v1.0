index 00000000..3b5ddcc7
--- /dev/null
+++ b/core/sweep/rules.py
@@ -0,0 +1,404 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Declarative retention rules and their precedence.
+
+A retention *rule* looks at one :class:`~core.sweep.item.SweepItem` and, if it
+matches, casts a vote: **keep** it or **evict** it. A :class:`RuleSet` holds an
+ordered list of rules and reduces every item to a single :class:`Verdict`.
+
+Precedence is deliberately **safety-first**:
+
+* An item that is ``protected`` (a reference-folder or pinned file) is *always*
+  kept -- no rule can override that.
+* Among matching rules, the one with the highest ``priority`` wins; ties are
+  broken **in favour of keeping** (a ``keep`` beats an ``evict`` of equal
+  priority), then by declaration order.
+* An item no rule matches falls through to the set's ``default_action`` (which
+  is ``keep`` -- a sweeper that isn't told to evict something leaves it alone).
+
+Count- and budget-based retention ("keep the newest 10", "stay under 5 GiB")
+are *not* per-item predicates, so they live in the ordering / planning layer,
+not here.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+
+from .errors import InvalidPolicyError, UnknownRuleError
+
+__all__ = [
+    "KEEP",
+    "EVICT",
+    "SECONDS_PER_DAY",
+    "Verdict",
+    "RetentionRule",
+    "AgeRule",
+    "IdleRule",
+    "SizeRule",
+    "GlobRule",
+    "ExtensionRule",
+    "MatchAllRule",
+    "make_rule",
+    "RuleSet",
+]
+
+KEEP = "keep"
+EVICT = "evict"
+_ACTIONS = (KEEP, EVICT)
+
+SECONDS_PER_MINUTE = 60.0
+SECONDS_PER_HOUR = 3600.0
+SECONDS_PER_DAY = 86400.0
+SECONDS_PER_WEEK = 7 * SECONDS_PER_DAY
+
+_DURATION_KEYS = {
+    "seconds": 1.0,
+    "minutes": SECONDS_PER_MINUTE,
+    "hours": SECONDS_PER_HOUR,
+    "days": SECONDS_PER_DAY,
+    "weeks": SECONDS_PER_WEEK,
+}
+
+
+def _coerce_action(action):
+    if action not in _ACTIONS:
+        raise InvalidPolicyError(f"unknown rule action {action!r} (expected 'keep' or 'evict')")
+    return action
+
+
+def _duration_from_spec(spec, base_key):
+    """Resolve a duration in seconds from ``<base>_seconds`` / ``_days`` / ... keys.
+
+    Exactly one unit form must be present; e.g. for ``base_key='max_age'`` a spec
+    may carry ``max_age_seconds`` **or** ``max_age_days`` (etc.), not both.
+    """
+    found = []
+    for unit, factor in _DURATION_KEYS.items():
+        key = f"{base_key}_{unit}"
+        if key in spec and spec[key] is not None:
+            found.append((key, float(spec[key]) * factor))
+    if not found:
+        raise InvalidPolicyError(f"rule is missing a duration; expected one of {base_key}_days / _hours / ...")
+    if len(found) > 1:
+        names = ", ".join(k for k, _ in found)
+        raise InvalidPolicyError(f"rule has more than one duration ({names}); give exactly one")
+    seconds = found[0][1]
+    if seconds < 0:
+        raise InvalidPolicyError(f"duration for {base_key} must not be negative")
+    return seconds
+
+
+class Verdict:
+    """The decision for a single item: keep or evict, and why."""
+
+    __slots__ = ("item", "action", "rule", "matched_rules", "reason")
+
+    def __init__(self, item, action, rule=None, matched_rules=None, reason=""):
+        self.item = item
+        self.action = action
+        self.rule = rule
+        self.matched_rules = list(matched_rules or [])
+        self.reason = reason
+
+    @property
+    def is_evict(self):
+        return self.action == EVICT
+
+    @property
+    def is_keep(self):
+        return self.action == KEEP
+
+    def as_dict(self):
+        return {
+            "path": str(self.item.path),
+            "action": self.action,
+            "rule": self.rule.name if self.rule is not None else None,
+            "matched_rules": [r.name for r in self.matched_rules],
+            "reason": self.reason,
+        }
+
+    def __repr__(self):
+        return f"<Verdict {self.action} {self.item.name!r} by {self.rule.name if self.rule else '-'}>"
+
+
+class RetentionRule:
+    """Base class: a named, prioritised predicate over items casting a vote.
+
+    Subclasses implement :meth:`matches`. ``priority`` orders rules when several
+    match the same item (higher wins); ``reason`` is a human string recorded on
+    the verdict.
+    """
+
+    kind = "rule"
+
+    def __init__(self, name, action, priority=0, reason=None):
+        self.name = name
+        self.action = _coerce_action(action)
+        self.priority = int(priority)
+        self.reason = reason if reason is not None else self._default_reason()
+
+    def _default_reason(self):
+        return f"{self.kind} rule {self.name!r}"
+
+    def matches(self, item):  # pragma: no cover - abstract
+        raise NotImplementedError
+
+    def as_dict(self):
+        return {
+            "name": self.name,
+            "kind": self.kind,
+            "action": self.action,
+            "priority": self.priority,
+            "reason": self.reason,
+        }
+
+    def __repr__(self):
+        return f"<{type(self).__name__} {self.name!r} {self.action} p{self.priority}>"
+
+
+class AgeRule(RetentionRule):
+    """Matches items whose *modification age* is at least ``max_age`` seconds."""
+
+    kind = "age"
+
+    def __init__(self, name, action, max_age, priority=0, reason=None):
+        self.max_age = float(max_age)
+        super().__init__(name, action, priority=priority, reason=reason)
+
+    def _default_reason(self):
+        return f"older than {self.max_age:g}s"
+
+    def matches(self, item):
+        return item.age_seconds() >= self.max_age
+
+
+class IdleRule(RetentionRule):
+    """Matches items *idle* (unaccessed) for at least ``max_idle`` seconds."""
+
+    kind = "idle"
+
+    def __init__(self, name, action, max_idle, priority=0, reason=None):
+        self.max_idle = float(max_idle)
+        super().__init__(name, action, priority=priority, reason=reason)
+
+    def _default_reason(self):
+        return f"idle for more than {self.max_idle:g}s"
+
+    def matches(self, item):
+        return item.idle_seconds() >= self.max_idle
+
+
+class SizeRule(RetentionRule):
+    """Matches items whose apparent size falls in ``[min_size, max_size]``.
+
+    Either bound may be ``0`` / unset to leave that side open.
+    """
+
+    kind = "size"
+
+    def __init__(self, name, action, min_size=0, max_size=0, priority=0, reason=None):
+        self.min_size = int(min_size or 0)
+        self.max_size = int(max_size or 0)
+        if self.max_size and self.min_size and self.max_size < self.min_size:
+            raise InvalidPolicyError(f"size rule {name!r}: max_size < min_size")
+        super().__init__(name, action, priority=priority, reason=reason)
+
+    def _default_reason(self):
+        if self.min_size and self.max_size:
+            return f"size in [{self.min_size}, {self.max_size}]"
+        if self.min_size:
+            return f"size >= {self.min_size}"
+        if self.max_size:
+            return f"size <= {self.max_size}"
+        return "any size"
+
+    def matches(self, item):
+        if self.min_size and item.size < self.min_size:
+            return False
+        if self.max_size and item.size > self.max_size:
+            return False
+        return True
+
+
+class GlobRule(RetentionRule):
+    """Matches items whose *name* matches any of the given glob patterns."""
+
+    kind = "glob"
+
+    def __init__(self, name, action, patterns, priority=0, reason=None, match_full_path=False):
+        if isinstance(patterns, str):
+            patterns = [patterns]
+        self.patterns = [str(p) for p in patterns]
+        if not self.patterns:
+            raise InvalidPolicyError(f"glob rule {name!r} has no patterns")
+        self.match_full_path = bool(match_full_path)
+        super().__init__(name, action, priority=priority, reason=reason)
+
+    def _default_reason(self):
+        return "matches " + " | ".join(self.patterns)
+
+    def matches(self, item):
+        target = str(item.path) if self.match_full_path else item.name
+        return any(fnmatch.fnmatch(target, pat) for pat in self.patterns)
+
+
+class ExtensionRule(RetentionRule):
+    """Matches items whose extension is in the configured set."""
+
+    kind = "extension"
+
+    def __init__(self, name, action, extensions, priority=0, reason=None):
+        if isinstance(extensions, str):
+            extensions = [extensions]
+        self.extensions = {e.lower().lstrip(".") for e in extensions}
+        if not self.extensions:
+            raise InvalidPolicyError(f"extension rule {name!r} has no extensions")
+        super().__init__(name, action, priority=priority, reason=reason)
+
+    def _default_reason(self):
+        return "extension in {" + ", ".join(sorted(self.extensions)) + "}"
+
+    def matches(self, item):
+        return item.extension in self.extensions
+
+
+class MatchAllRule(RetentionRule):
+    """Matches every item -- a catch-all, typically a low-priority default."""
+
+    kind = "all"
+
+    def _default_reason(self):
+        return "matches all items"
+
+    def matches(self, item):
+        return True
+
+
+_RULE_KINDS = {
+    "age": AgeRule,
+    "idle": IdleRule,
+    "size": SizeRule,
+    "glob": GlobRule,
+    "extension": ExtensionRule,
+    "all": MatchAllRule,
+}
+
+
+def make_rule(spec):
+    """Build a :class:`RetentionRule` from a plain-dict spec.
+
+    The spec's ``kind`` selects the rule class; remaining keys are the rule's
+    parameters. Unknown kinds raise :class:`UnknownRuleError`; malformed specs
+    raise :class:`InvalidPolicyError`.
+    """
+    if not isinstance(spec, dict):
+        raise InvalidPolicyError(f"rule spec must be a mapping, got {type(spec).__name__}")
+    kind = spec.get("kind")
+    if kind is None:
+        raise InvalidPolicyError("rule spec is missing 'kind'")
+    cls = _RULE_KINDS.get(kind)
+    if cls is None:
+        raise UnknownRuleError(f"unknown rule kind {kind!r}")
+    name = spec.get("name", kind)
+    action = spec.get("action", EVICT)
+    priority = spec.get("priority", 0)
+    reason = spec.get("reason")
+    if cls is AgeRule:
+        return AgeRule(name, action, _duration_from_spec(spec, "max_age"), priority=priority, reason=reason)
+    if cls is IdleRule:
+        return IdleRule(name, action, _duration_from_spec(spec, "max_idle"), priority=priority, reason=reason)
+    if cls is SizeRule:
+        return SizeRule(
+            name,
+            action,
+            min_size=spec.get("min_size", 0),
+            max_size=spec.get("max_size", 0),
+            priority=priority,
+            reason=reason,
+        )
+    if cls is GlobRule:
+        patterns = spec.get("patterns", spec.get("pattern"))
+        if patterns is None:
+            raise InvalidPolicyError(f"glob rule {name!r} needs 'patterns'")
+        return GlobRule(
+            name,
+            action,
+            patterns,
+            priority=priority,
+            reason=reason,
+            match_full_path=spec.get("match_full_path", False),
+        )
+    if cls is ExtensionRule:
+        extensions = spec.get("extensions", spec.get("ext"))
+        if extensions is None:
+            raise InvalidPolicyError(f"extension rule {name!r} needs 'extensions'")
+        return ExtensionRule(name, action, extensions, priority=priority, reason=reason)
+    # MatchAllRule
+    return MatchAllRule(name, action, priority=priority, reason=reason)
+
+
+class RuleSet:
+    """An ordered collection of rules reducing items to verdicts.
+
+    See the module docstring for the precedence contract. ``default_action``
+    applies to items no rule matches (``keep`` unless overridden).
+    """
+
+    def __init__(self, rules=None, default_action=KEEP):
+        self.rules = list(rules or [])
+        self.default_action = _coerce_action(default_action)
+
+    def add(self, rule):
+        self.rules.append(rule)
+        return rule
+
+    @classmethod
+    def from_specs(cls, specs, default_action=KEEP):
+        return cls([make_rule(s) for s in (specs or [])], default_action=default_action)
+
+    def matching_rules(self, item):
+        """All rules that match ``item``, in declaration order."""
+        return [r for r in self.rules if r.matches(item)]
+
+    def classify(self, item):
+        """Reduce ``item`` to a single :class:`Verdict`."""
+        # Hard protection: nothing evicts a protected item.
+        if getattr(item, "protected", False):
+            matched = self.matching_rules(item)
+            return Verdict(item, KEEP, rule=None, matched_rules=matched, reason="protected")
+        matched = self.matching_rules(item)
+        if not matched:
+            return Verdict(item, self.default_action, rule=None, matched_rules=[], reason="default")
+        # Highest priority wins; tie -> keep beats evict; then declaration order.
+        # We sort a copy by a key that encodes those rules, stable on order.
+        def _key(indexed):
+            idx, rule = indexed
+            keep_bias = 0 if rule.action == KEEP else 1  # keep sorts first on ties
+            return (-rule.priority, keep_bias, idx)
+
+        best_idx, best = min(enumerate(matched), key=_key)
+        return Verdict(item, best.action, rule=best, matched_rules=matched, reason=best.reason)
+
+    def classify_all(self, items):
+        return [self.classify(it) for it in items]
+
+    def evictable(self, items):
+        """Items this rule set votes to evict (before count / budget limits)."""
+        return [v.item for v in self.classify_all(items) if v.is_evict]
+
+    def as_dict(self):
+        return {
+            "default_action": self.default_action,
+            "rules": [r.as_dict() for r in self.rules],
+        }
+
+    def __len__(self):
+        return len(self.rules)
+
+    def __iter__(self):
+        return iter(self.rules)
