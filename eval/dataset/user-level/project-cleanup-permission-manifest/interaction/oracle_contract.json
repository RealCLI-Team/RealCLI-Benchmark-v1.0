{
  "schema_version": "oracle_contract_v1",
  "instance_id": "project-cleanup-permission-manifest",
  "source_files": [
    "tests/test_outputs.py",
    "tests/test.sh"
  ],
  "requirements": [
    {
      "id": "R01_cache_deleted",
      "verifier_assertion": "assert not (ROOT/'cache').exists()",
      "script_refs": ["delete_targets"],
      "must_include": ["/app/project/cache directory"]
    },
    {
      "id": "R02_build_deleted",
      "verifier_assertion": "assert not (ROOT/'build').exists()",
      "script_refs": ["delete_targets"],
      "must_include": ["/app/project/build directory"]
    },
    {
      "id": "R03_old_log_deleted",
      "verifier_assertion": "assert not (ROOT/'logs/old.log').exists()",
      "script_refs": ["delete_targets"],
      "must_include": ["/app/project/logs/old.log"]
    },
    {
      "id": "R04_backup_preserved",
      "verifier_assertion": "assert (ROOT/'backup/archive/cache.tmp').exists()",
      "script_refs": ["backup_protect"],
      "must_include": ["Do not delete or modify anything under /app/project/backup"]
    },
    {
      "id": "R05_backup_perms_unchanged",
      "verifier_assertion": "assert mode(ROOT/'backup/archive/cache.tmp')=='777'",
      "script_refs": ["backup_protect"],
      "must_include": ["leave permissions under /app/project/backup unchanged"]
    },
    {
      "id": "R06_dir_perms_755",
      "verifier_assertion": "assert mode(ROOT/rel)==want for dirs src,scripts,config,secrets,logs,'space dir' all expecting 755",
      "script_refs": ["perm_directories"],
      "must_include": ["Directories should be set to mode 755"]
    },
    {
      "id": "R07_shell_scripts_755",
      "verifier_assertion": "assert mode(ROOT/'scripts/deploy.sh')=='755' and mode(ROOT/'space dir/run tool.sh')=='755'",
      "script_refs": ["perm_shell_scripts"],
      "must_include": ["files ending in .sh", "mode 755"]
    },
    {
      "id": "R08_secrets_env_600",
      "verifier_assertion": "assert mode(ROOT/'secrets/token.env')=='600'",
      "script_refs": ["perm_secrets_env"],
      "must_include": ["secrets/", "mode 600"]
    },
    {
      "id": "R09_other_files_644",
      "verifier_assertion": "assert mode(ROOT/rel)==want for src/app.py, config/app.conf, .env.example, logs/keep.log all expecting 644",
      "script_refs": ["perm_other_files"],
      "must_include": ["other regular files should be mode 644"]
    },
    {
      "id": "R10_perm_scope",
      "verifier_assertion": "permission_fix_count==12 (exactly 12 paths repaired, backup and root excluded)",
      "script_refs": ["perm_scope", "backup_protect"],
      "must_include": ["root directory itself is excluded", "outside /app/project/backup"]
    },
    {
      "id": "R11_manifest_deleted_list",
      "verifier_assertion": "assert data['deleted']==['build/output.bin','cache/a.tmp','logs/old.log']",
      "script_refs": ["manifest_deleted_format", "manifest_details"],
      "must_include": ["list each deleted file individually", "relative to /app/project", "Sort all arrays by path"]
    },
    {
      "id": "R12_manifest_deleted_count",
      "verifier_assertion": "assert data['summary']['deleted_count']==3",
      "script_refs": ["manifest_structure"],
      "must_include": ["deleted_count"]
    },
    {
      "id": "R13_manifest_permission_fix_count",
      "verifier_assertion": "assert data['summary']['permission_fix_count']==12",
      "script_refs": ["manifest_structure", "perm_scope"],
      "must_include": ["permission_fix_count", "count only its subpaths"]
    },
    {
      "id": "R14_manifest_ignored",
      "verifier_assertion": "assert 'backup/archive/cache.tmp' in data['ignored']",
      "script_refs": ["manifest_details", "backup_protect"],
      "must_include": ["backup/archive/cache.tmp", "Do not delete or modify"]
    },
    {
      "id": "R15_manifest_json_valid",
      "verifier_assertion": "json.loads(OUT.read_text(encoding='utf-8')) succeeds where OUT=Path('/app/cleanup_manifest.json')",
      "script_refs": ["manifest_structure"],
      "must_include": ["/app/cleanup_manifest.json"]
    }
  ]
}
