{
  "task_id": "P228_archery_target_practice_with_physics_deb_v5",
  "affordances": [
    {
      "id": "A1",
      "name": "ArcherModel",
      "type": "3d_object",
      "semantic": "Xbot.glb character model representing the archer at position (0,0,6)",
      "locator_hints": [
        "scene.children find glb model",
        "position.z === 6"
      ]
    },
    {
      "id": "A2",
      "name": "Target",
      "type": "3d_object",
      "semantic": "Archery target with 5 concentric rings at z=-15",
      "locator_hints": [
        "position.z === -15",
        "concentric cylinders"
      ]
    },
    {
      "id": "A3",
      "name": "Arrow",
      "type": "3d_object",
      "semantic": "Arrow projectile that follows physics trajectory",
      "locator_hints": [
        "thin cylinder with cone tip"
      ]
    },
    {
      "id": "A4",
      "name": "DebugOverlay",
      "type": "dom_element",
      "semantic": "Physics debug info panel toggled with D key",
      "locator_hints": [
        "#debugOverlay"
      ]
    },
    {
      "id": "A5",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current score",
      "locator_hints": [
        "#scoreDisplay"
      ]
    },
    {
      "id": "A6",
      "name": "ArrowDisplay",
      "type": "dom_element",
      "semantic": "HUD showing arrows remaining",
      "locator_hints": [
        "#arrowDisplay"
      ]
    },
    {
      "id": "A7",
      "name": "BestShotDisplay",
      "type": "dom_element",
      "semantic": "HUD showing best single shot score",
      "locator_hints": [
        "#bestShotDisplay"
      ]
    },
    {
      "id": "A8",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the round",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A9",
      "name": "WindDisplay",
      "type": "dom_element",
      "semantic": "HUD showing wind direction and strength",
      "locator_hints": [
        "#windDisplay"
      ]
    },
    {
      "id": "A10",
      "name": "Crosshair",
      "type": "dom_element",
      "semantic": "Aim reticle following mouse cursor",
      "locator_hints": [
        "crosshair element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.arrowsRemaining === 5",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.arrowInFlight === false",
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "Debug_Overlay_Visible",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "Arrow_In_Flight",
      "conditions": [
        "window.__3D_STATE__.arrowInFlight === true",
        "window.__3D_STATE__.currentArrowPos !== null",
        "window.__3D_STATE__.currentArrowVel !== null"
      ]
    },
    {
      "id": "S3",
      "name": "First_Arrow_Landed",
      "conditions": [
        "window.__3D_STATE__.arrowInFlight === false",
        "window.__3D_STATE__.arrowsRemaining === 4",
        "window.__3D_STATE__.totalArrowsFired === 1",
        "window.__3D_STATE__.lastHitDistance !== null"
      ]
    },
    {
      "id": "S4",
      "name": "Multiple_Arrows_Fired",
      "conditions": [
        "window.__3D_STATE__.totalArrowsFired >= 2",
        "window.__3D_STATE__.arrowsRemaining <= 3"
      ]
    },
    {
      "id": "S5",
      "name": "All_Arrows_Spent",
      "conditions": [
        "window.__3D_STATE__.arrowsRemaining === 0",
        "window.__3D_STATE__.totalArrowsFired >= 5"
      ]
    },
    {
      "id": "S6",
      "name": "Round_Reset",
      "conditions": [
        "window.__3D_STATE__.arrowsRemaining === 5",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.bestShot === 0",
        "window.__3D_STATE__.roundNumber >= 2"
      ]
    },
    {
      "id": "S7",
      "name": "Debug_Hidden_Again",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "Post_Reset_Arrow_Fired",
      "conditions": [
        "window.__3D_STATE__.roundNumber >= 2",
        "window.__3D_STATE__.totalArrowsFired >= 1",
        "window.__3D_STATE__.arrowsRemaining <= 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bestShot === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowInFlight === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roundNumber === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windX === 'number' && !isNaN(window.__3D_STATE__.windX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debugOverlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debugOverlay').style.display !== 'none'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrowInFlight === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentArrowPos !== null && typeof window.__3D_STATE__.currentArrowPos.z === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentArrowVel !== null && !isNaN(window.__3D_STATE__.currentArrowVel.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentArrowVel !== null && window.__3D_STATE__.currentArrowVel.z < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrowInFlight === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrowsFired === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastHitDistance !== null && !isNaN(window.__3D_STATE__.lastHitDistance)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastHitScore === 'number' && window.__3D_STATE__.lastHitScore >= 0 && window.__3D_STATE__.lastHitScore <= 10",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalArrowsFired >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowsRemaining <= 4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number' && !isNaN(window.__3D_STATE__.score)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bestShot >= 0 && window.__3D_STATE__.bestShot <= 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " ",
        "repeat": 3,
        "delay_ms": 1500,
        "delay_before_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrowsFired >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowInFlight === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number' && window.__3D_STATE__.score >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowInFlight === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrowsFired >= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrowsRemaining === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bestShot === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roundNumber >= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windX === 'number' && !isNaN(window.__3D_STATE__.windX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roundNumber >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowsRemaining <= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrowsFired >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugVisible === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debugOverlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debugOverlay').style.display === 'none' || document.getElementById('debugOverlay').offsetHeight === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roundNumber >= 2",
            "tier": "L2"
          }
        ]
      }
    }
  ],
  "rubric_metadata": {
    "visibility": "official_icg_adopted",
