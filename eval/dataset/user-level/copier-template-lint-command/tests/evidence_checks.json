{
  "instance_id": "copier-template-lint-command",
  "checks": [
    {
      "dimension": "1.1.1",
      "id": "hc_docs_page_and_nav",
      "cmd": "bash /root/.interaction/checks/docs_page_and_nav.sh",
      "expect": "ok",
      "allow_nonzero": true
    },
    {
      "dimension": "3.1.2",
      "id": "hc_selfcheck_ran_marker",
      "cmd": "test -f /root/.interaction/verbose_selfcheck_ran && echo SELFCHECK_RAN || echo SELFCHECK_NOT_RUN",
      "expect": "SELFCHECK_RAN = marker present, the verbose self-check was actually invoked; SELFCHECK_NOT_RUN = marker absent.",
      "allow_nonzero": true
    },
    {
      "dimension": "4.1.1",
      "id": "hc_vcs_ref_default_unchanged",
      "cmd": "python3 /root/.interaction/checks/vcs_ref_default.py",
