--- /dev/null
+++ b/libcloud/reclaim2/session.py
@@ -0,0 +1,119 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""The reclamation session: collect a fleet, plan, preview, apply.
+
+A :class:`ReclaimSession` is the one object a caller drives end to end. Add raw
+Libcloud resources (from any provider/region), and it distils them to targets,
+builds a plan on demand, and -- through injected action callables -- previews
+(dry-run) or applies that plan. Adding or clearing resources invalidates the
+cached plan so a session never previews a stale picture.
+
+Nothing here is destructive on its own: ``preview()`` is always a dry-run, and
+``apply()`` only does anything when the caller has both wired up action callables
+and explicitly permitted destructive ones.
+"""
+
+from __future__ import annotations
+
+from libcloud.reclaim2.executor import ReclaimExecutor
+from libcloud.reclaim2.planner import ReclaimPlanner
+from libcloud.reclaim2.target import build_targets
+
+__all__ = ["ReclaimSession"]
+
+
+class ReclaimSession:
+    """Stateful driver over a planner, an optional executor, and a fleet."""
+
+    def __init__(self, planner=None, executor=None, as_of=None,
+                 default_provider=None, default_region=None):
+        self.planner = planner or ReclaimPlanner()
+        self.executor = executor
+        self.as_of = as_of
+        self.default_provider = default_provider
+        self.default_region = default_region
+        self._raw = []       # list of (resource, meta)
+        self._targets = None  # cached target list
+        self._plan = None     # cached plan
+
+    # --- Fleet management -----------------------------------------------------
+    def add(self, resource, **meta):
+        self._raw.append((resource, dict(meta)))
+        self._invalidate()
+        return self
+
+    def add_many(self, resources, **meta):
+        for resource in resources:
+            self.add(resource, **meta)
+        return self
+
+    def add_nodes(self, nodes, **meta):
+        return self.add_many(nodes, **dict(meta, kind="node"))
+
+    def add_volumes(self, volumes, **meta):
+        return self.add_many(volumes, **dict(meta, kind="volume"))
+
+    def add_snapshots(self, snapshots, **meta):
+        return self.add_many(snapshots, **dict(meta, kind="snapshot"))
+
+    def add_containers(self, containers, **meta):
+        return self.add_many(containers, **dict(meta, kind="container"))
+
+    def clear(self):
+        self._raw = []
+        self._invalidate()
+        return self
+
+    def _invalidate(self):
+        self._targets = None
+        self._plan = None
+
+    @property
+    def fleet_size(self):
+        return len(self._raw)
+
+    # --- Analysis -------------------------------------------------------------
+    def targets(self, force=False):
+        if self._targets is None or force:
+            self._targets = build_targets(
+                self._raw,
+                as_of=self.as_of,
+                provider=self.default_provider,
+                region=self.default_region,
+            )
+        return self._targets
+
+    def plan(self, force=False):
+        if self._plan is None or force:
+            self._plan = self.planner.plan(self.targets(force=force))
+        return self._plan
+
+    # --- Execution ------------------------------------------------------------
+    def preview(self):
+        """Always a dry-run: report what would happen, invoke nothing."""
+        executor = self.executor or ReclaimExecutor()
+        return executor.execute(self.plan(), dry_run=True)
+
+    def apply(self, allow_destructive=False):
+        """Apply the plan through the wired executor. Requires an executor."""
+        if self.executor is None:
+            raise ValueError("no executor configured; cannot apply a plan")
+        return self.executor.execute(
+            self.plan(), dry_run=False, allow_destructive=allow_destructive
+        )
+
+    def __repr__(self):
+        return "<ReclaimSession fleet=%d>" % (self.fleet_size,)
diff --git a/libcloud/reclaim2/target.py b/libcloud/reclaim2/target.py
new file mode 100644
index 000000000..81d2112d0
--- /dev/null
+++ b/libcloud/reclaim2/target.py
@@ -0,0 +1,386 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""The reclamation target: a resource distilled to what the planner needs.
+
+To decide whether a resource is worth reclaiming, the planner needs a handful of
+facts in a uniform shape regardless of which cloud the resource came from: what
+kind it is, what it costs per hour right now, how old it is, whether it is idle,
+whether the operator pinned it as protected, and enough identity to act on it
+later. A :class:`ReclaimTarget` is that distilled view, built from a Libcloud
+resource plus optional caller-supplied context (an as-of time for age maths, an
+hourly cost, utilisation hints).
+
+Ages are computed against an explicit ``as_of`` reference the caller passes in,
+never against the wall clock -- so a plan built from the same inputs is always
+reproducible.
+"""
+
+from __future__ import annotations
+
+__all__ = ["ResourceKind", "ReclaimTarget", "build_target", "build_targets"]
+
+# Seconds in a day, for age maths.
+_SECONDS_PER_DAY = 86400.0
+
+
+class ResourceKind:
+    NODE = "node"
+    VOLUME = "volume"
+    SNAPSHOT = "snapshot"
+    CONTAINER = "container"
+    IMAGE = "image"
+
+    _ALL = (NODE, VOLUME, SNAPSHOT, CONTAINER, IMAGE)
+
+    @classmethod
+    def is_valid(cls, kind):
+        return kind in cls._ALL
+
+
+# ``extra`` keys that commonly flag a resource as protected / do-not-touch.
+_PROTECT_KEYS = ("protected", "do_not_delete", "keep", "termination_protection")
+# Tag keys that, if truthy, protect a resource.
+_PROTECT_TAGS = ("protected", "do-not-delete", "keep", "pinned")
+# ``extra`` keys that commonly carry an attachment reference for volumes.
+_ATTACH_KEYS = ("attached_to", "instance_id", "attachments")
+# ``extra`` keys that commonly carry a parent-volume reference for snapshots.
+_PARENT_VOLUME_KEYS = ("volume_id", "source_volume", "volume")
+
+
+def _state_to_str(state):
+    if state is None:
+        return "unknown"
+    return str(getattr(state, "value", state)).lower()
+
+
+def _coerce_bool(value):
+    if isinstance(value, str):
+        return value.strip().lower() in ("1", "true", "yes", "on", "protected")
+    return bool(value)
+
+
+def _merge_tags(extra):
+    tags = {}
+    for key in ("metadata", "labels", "tags"):
+        container = extra.get(key)
+        if isinstance(container, dict):
+            for k, v in container.items():
+                tags[str(k)] = "" if v is None else str(v)
+    return tags
+
+
+class ReclaimTarget:
+    """A resource distilled to the facts the planner reasons about."""
+
+    __slots__ = (
+        "kind",
+        "provider",
+        "resource_id",
+        "name",
+        "region",
+        "state",
+        "size",
+        "hourly_cost",
+        "age_days",
+        "idle",
+        "protected",
+        "tags",
+        "extra",
+    )
+
+    def __init__(
+        self,
+        kind,
+        provider,
+        resource_id,
+        name=None,
+        region="unknown",
+        state="unknown",
+        size=0.0,
+        hourly_cost=0.0,
+        age_days=None,
+        idle=False,
+        protected=False,
+        tags=None,
+        extra=None,
+    ):
+        self.kind = kind
+        self.provider = provider
+        self.resource_id = resource_id
+        self.name = name
+        self.region = region
+        self.state = state
+        self.size = float(size or 0.0)
+        self.hourly_cost = float(hourly_cost or 0.0)
+        self.age_days = age_days
+        self.idle = bool(idle)
+        self.protected = bool(protected)
+        self.tags = dict(tags or {})
+        self.extra = dict(extra or {})
+
+    # --- Identity -------------------------------------------------------------
+    @property
+    def identity(self):
+        return (self.provider, self.kind, str(self.resource_id))
+
+    @property
+    def sort_key(self):
+        return (self.kind, self.provider, self.region, str(self.resource_id or ""))
+
+    # --- Convenience ----------------------------------------------------------
+    @property
+    def attachment(self):
+        for key in _ATTACH_KEYS:
+            val = self.extra.get(key)
+            if val:
+                return val
+        return None
+
+    @property
+    def parent_volume(self):
+        for key in _PARENT_VOLUME_KEYS:
+            val = self.extra.get(key)
+            if val is not None:
+                return val
+        return None
+
+    def has_tag(self, key):
+        return key in self.tags
+
+    def tag(self, key, default=None):
+        return self.tags.get(key, default)
+
+    def older_than(self, days):
+        return self.age_days is not None and self.age_days >= days
+
+    def as_dict(self):
+        return {
+            "kind": self.kind,
+            "provider": self.provider,
+            "resource_id": self.resource_id,
+            "name": self.name,
+            "region": self.region,
+            "state": self.state,
+            "size": self.size,
+            "hourly_cost": round(self.hourly_cost, 6),
+            "age_days": self.age_days,
+            "idle": self.idle,
+            "protected": self.protected,
+            "tags": dict(sorted(self.tags.items())),
+        }
+
+    def __eq__(self, other):
+        return isinstance(other, ReclaimTarget) and self.identity == other.identity
+
+    def __hash__(self):
+        return hash(self.identity)
+
+    def __repr__(self):
+        return "<ReclaimTarget %s/%s %s $%.4f/h%s>" % (
+            self.provider, self.kind, self.resource_id, self.hourly_cost,
+            " protected" if self.protected else "",
+        )
+
+
+def _infer_kind(resource):
+    cls = type(resource).__name__.lower()
+    if "snapshot" in cls:
+        return ResourceKind.SNAPSHOT
+    if "volume" in cls:
+        return ResourceKind.VOLUME
+    if "container" in cls:
+        return ResourceKind.CONTAINER
+    if "image" in cls:
+        return ResourceKind.IMAGE
+    if "node" in cls or (hasattr(resource, "state") and hasattr(resource, "public_ips")):
+        return ResourceKind.NODE
+    return None
+
+
+def _created_of(resource, extra):
+    # Libcloud stashes creation time in a few spots depending on the resource.
+    for attr in ("created_at", "created"):
+        val = getattr(resource, attr, None)
+        if val is not None:
+            return val
+    for key in ("created_at", "created", "creation_time", "launch_time"):
+        if key in extra:
+            return extra[key]
+    return None
+
+
+def _age_days(created, as_of):
+    """Compute age in days from ``created`` to ``as_of``.
+
+    Both may be epoch seconds (int/float) or anything exposing ``.timestamp()``.
+    Returns ``None`` when age can't be determined. Never reads the wall clock.
+    """
+    if created is None or as_of is None:
+        return None
+
+    def _epoch(v):
+        if isinstance(v, (int, float)):
+            return float(v)
+        ts = getattr(v, "timestamp", None)
+        if callable(ts):
+            try:
+                return float(ts())
+            except Exception:
+                return None
+        return None
+
+    c = _epoch(created)
+    a = _epoch(as_of)
+    if c is None or a is None:
+        return None
+    return max(0.0, (a - c) / _SECONDS_PER_DAY)
+
+
+def _size_of(resource, kind, extra):
+    if kind == ResourceKind.CONTAINER:
+        total = extra.get("total_bytes")
+        if total is None:
+            total = extra.get("size")
+        try:
+            return float(total or 0.0)
+        except (TypeError, ValueError):
+            return 0.0
+    try:
+        return float(getattr(resource, "size", None) or 0.0)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def _is_protected(extra, tags):
+    for key in _PROTECT_KEYS:
+        if key in extra and _coerce_bool(extra[key]):
+            return True
+    for key in _PROTECT_TAGS:
+        if key in tags and _coerce_bool(tags[key]):
+            return True
+    return False
+
+
+def build_target(
+    resource,
+    provider=None,
+    region=None,
+    kind=None,
+    as_of=None,
+    hourly_cost=None,
+    idle=None,
+    protected=None,
+):
+    """Distil a Libcloud resource into a :class:`ReclaimTarget`.
+
+    ``as_of`` (epoch seconds or a datetime-like) anchors the age computation.
+    ``hourly_cost`` / ``idle`` / ``protected`` let the caller override or supply
+    facts the resource object itself doesn't carry.
+    """
+    from libcloud.reclaim2.errors import ReclaimConfigError
+
+    if resource is None:
+        raise ReclaimConfigError("cannot build a target from None")
+    kind = kind or _infer_kind(resource)
+    if kind is None:
+        raise ReclaimConfigError(
+            "cannot infer resource kind for %r" % (type(resource).__name__,)
+        )
+    if not ResourceKind.is_valid(kind):
+        raise ReclaimConfigError("unknown resource kind %r" % (kind,))
+
+    extra = dict(getattr(resource, "extra", None) or {})
+    tags = _merge_tags(extra)
+
+    prov = provider or extra.get("provider")
+    if not prov:
+        driver = getattr(resource, "driver", None)
+        prov = getattr(driver, "name", None) or "unknown"
+    prov = str(prov)
+
+    reg = region
+    if not reg:
+        for key in ("region", "availability_zone", "zone", "location"):
+            if extra.get(key):
+                reg = str(extra[key])
+                break
+    reg = reg or "unknown"
+
+    rid = getattr(resource, "id", None)
+    if rid is None:
+        rid = getattr(resource, "name", None)
+
+    hc = hourly_cost
+    if hc is None:
+        hc = extra.get("hourly_cost")
+    if hc is None:
+        size = getattr(resource, "size", None)
+        hc = getattr(size, "price", None) if size is not None else None
+    if hc is None:
+        hc = 0.0
+
+    is_idle = idle
+    if is_idle is None:
+        is_idle = _coerce_bool(extra.get("idle", False))
+
+    prot = protected
+    if prot is None:
+        prot = _is_protected(extra, tags)
+
+    created = _created_of(resource, extra)
+    age = _age_days(created, as_of)
+
+    return ReclaimTarget(
+        kind=kind,
+        provider=prov,
+        resource_id=rid,
+        name=getattr(resource, "name", None),
+        region=reg,
+        state=_state_to_str(getattr(resource, "state", None)),
+        size=_size_of(resource, kind, extra),
+        hourly_cost=float(hc),
+        age_days=age,
+        idle=is_idle,
+        protected=prot,
+        tags=tags,
+        extra=extra,
+    )
+
+
+def build_targets(elements, as_of=None, provider=None, region=None):
+    """Build targets from an iterable of resources or ``(resource, meta)`` pairs.
+
+    ``meta`` may carry ``provider`` / ``region`` / ``kind`` / ``hourly_cost`` /
+    ``idle`` / ``protected`` overrides. Output is sorted deterministically.
+    """
+    out = []
+    for element in elements:
+        if isinstance(element, tuple) and len(element) == 2 and isinstance(element[1], dict):
+            resource, meta = element
+        else:
+            resource, meta = element, {}
+        out.append(build_target(
+            resource,
+            provider=meta.get("provider", provider),
+            region=meta.get("region", region),
+            kind=meta.get("kind"),
+            as_of=meta.get("as_of", as_of),
+            hourly_cost=meta.get("hourly_cost"),
+            idle=meta.get("idle"),
+            protected=meta.get("protected"),
+        ))
+    out.sort(key=lambda t: t.sort_key)
+    return out
