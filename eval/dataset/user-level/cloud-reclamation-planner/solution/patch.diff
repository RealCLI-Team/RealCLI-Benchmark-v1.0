+++ b/libcloud/reclaim2/errors.py
@@ -0,0 +1,74 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Exception hierarchy for the reclamation planner.
+
+The important distinction, made explicit here, is between problems that can be
+caught *before* any plan is built or executed -- bad configuration, an unknown
+action verb, a malformed policy -- and problems that surface only while a plan is
+being carried out (a resource the caller pinned as protected being handed to a
+destructive action, or an injected action callable blowing up). Grouping the
+former under :class:`ReclaimConfigError` lets a caller validate input up front and
+fail fast.
+"""
+
+from __future__ import annotations
+
+__all__ = [
+    "ReclaimError",
+    "ReclaimConfigError",
+    "UnknownActionError",
+    "PolicyError",
+    "ProtectedResourceError",
+    "ActionExecutionError",
+]
+
+
+class ReclaimError(Exception):
+    """Root of every error raised by :mod:`libcloud.reclaim2`."""
+
+
+class ReclaimConfigError(ReclaimError):
+    """Invalid configuration or arguments -- detectable before doing any work."""
+
+
+class UnknownActionError(ReclaimConfigError):
+    """An action verb that the planner/executor does not recognise."""
+
+
+class PolicyError(ReclaimConfigError):
+    """A reclamation policy is malformed (bad threshold, bad selector spec, ...)."""
+
+
+class ProtectedResourceError(ReclaimError):
+    """A protected/pinned resource was routed to a destructive action.
+
+    This is a *runtime* guard: the plan should never contain actions on protected
+    resources, so hitting it means something tried to bypass the plan.
+    """
+
+    def __init__(self, message, resource_id=None):
+        super().__init__(message)
+        self.resource_id = resource_id
+
+
+class ActionExecutionError(ReclaimError):
+    """An injected action callable failed while a plan was being applied."""
+
+    def __init__(self, message, action=None, resource_id=None, cause=None):
+        super().__init__(message)
+        self.action = action
+        self.resource_id = resource_id
+        self.cause = cause
diff --git a/libcloud/reclaim2/executor.py b/libcloud/reclaim2/executor.py
new file mode 100644
index 000000000..2ebcf8a63
--- /dev/null
+++ b/libcloud/reclaim2/executor.py
@@ -0,0 +1,239 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Carrying out a plan -- safely, and only through injected callables.
+
+The executor turns a :class:`~libcloud.reclaim2.plan.ReclaimPlan` into
+:class:`ActionResult` outcomes. Crucially it never calls a cloud driver itself:
+the caller injects one Python callable per action verb (``{action: fn}``), and the
+executor invokes those. That keeps the whole package testable offline (inject
+fakes that just record what they were asked to do) and puts the caller in full
+control of what "apply" actually means.
+
+Safety rails:
+
+* **dry-run by default** -- nothing is invoked; every recommendation is reported
+  as ``planned``.
+* **destructive gate** -- destructive actions (destroy/delete) are only invoked
+  when the caller opts in with ``allow_destructive=True``; otherwise they are
+  reported as ``skipped`` with a reason.
+* **protected guard** -- if a recommendation's target is somehow protected, the
+  executor refuses with :class:`ProtectedResourceError` rather than acting.
+* **idempotency** -- a callable may signal "already gone / nothing to do" (by
+  returning a falsey/``"noop"`` sentinel or raising the caller's own
+  already-done marker) and the result is recorded as ``noop`` rather than
+  ``done``; re-running a plan is therefore safe.
+"""
+
+from __future__ import annotations
+
+from libcloud.reclaim2.actions import Action
+from libcloud.reclaim2.errors import (
+    ActionExecutionError,
+    ProtectedResourceError,
+    UnknownActionError,
+)
+from libcloud.reclaim2.money import Money
+
+__all__ = ["Outcome", "ActionResult", "ExecutionReport", "ReclaimExecutor"]
+
+
+class Outcome:
+    PLANNED = "planned"      # dry-run: would have acted
+    DONE = "done"            # action callable ran and changed something
+    NOOP = "noop"            # already in desired state; nothing to do
+    SKIPPED = "skipped"      # deliberately not run (destructive gate, missing fn)
+    FAILED = "failed"        # action callable raised
+
+
+class ActionResult:
+    """The outcome of (attempting) one recommendation."""
+
+    __slots__ = ("recommendation", "outcome", "detail", "error")
+
+    def __init__(self, recommendation, outcome, detail=None, error=None):
+        self.recommendation = recommendation
+        self.outcome = outcome
+        self.detail = detail
+        self.error = error
+
+    @property
+    def action(self):
+        return self.recommendation.action
+
+    @property
+    def resource_id(self):
+        return self.recommendation.resource_id
+
+    @property
+    def realised_savings(self):
+        """Monthly savings actually realised: only DONE outcomes count."""
+        if self.outcome == Outcome.DONE:
+            return self.recommendation.monthly_savings
+        return Money.zero(self.recommendation.monthly_savings.currency)
+
+    def as_dict(self):
+        return {
+            "action": self.action,
+            "resource_id": self.resource_id,
+            "outcome": self.outcome,
+            "detail": self.detail,
+            "error": self.error,
+            "monthly_savings": self.recommendation.monthly_savings.as_dict(),
+        }
+
+    def __repr__(self):
+        return "<ActionResult %s %s -> %s>" % (
+            self.action, self.resource_id, self.outcome,
+        )
+
+
+class ExecutionReport:
+    """The full outcome of executing a plan."""
+
+    def __init__(self, results, dry_run, currency="USD"):
+        self.results = list(results)
+        self.dry_run = dry_run
+        self.currency = currency
+
+    def __len__(self):
+        return len(self.results)
+
+    def __iter__(self):
+        return iter(self.results)
+
+    def by_outcome(self, outcome):
+        return [r for r in self.results if r.outcome == outcome]
+
+    def outcome_counts(self):
+        counts = {}
+        for r in self.results:
+            counts[r.outcome] = counts.get(r.outcome, 0) + 1
+        return counts
+
+    @property
+    def ok(self):
+        return not self.by_outcome(Outcome.FAILED)
+
+    @property
+    def realised_monthly_savings(self):
+        total = Money.zero(self.currency)
+        for r in self.results:
+            total = total + r.realised_savings
+        return total.rounded()
+
+    @property
+    def projected_monthly_savings(self):
+        total = Money.zero(self.currency)
+        for r in self.results:
+            total = total + r.recommendation.monthly_savings
+        return total.rounded()
+
+    def as_dict(self):
+        return {
+            "dry_run": self.dry_run,
+            "ok": self.ok,
+            "count": len(self.results),
+            "outcome_counts": self.outcome_counts(),
+            "realised_monthly_savings": self.realised_monthly_savings.as_dict(),
+            "projected_monthly_savings": self.projected_monthly_savings.as_dict(),
+            "results": [r.as_dict() for r in self.results],
+        }
+
+    def __repr__(self):
+        return "<ExecutionReport dry_run=%s %s>" % (
+            self.dry_run, self.outcome_counts(),
+        )
+
+
+# Sentinels a caller's action callable may return to signal "nothing to do".
+_NOOP_SENTINELS = frozenset({"noop", "already-gone", "not-found", "absent"})
+
+
+class ReclaimExecutor:
+    """Execute a plan through injected per-action callables.
+
+    ``actions`` maps an action verb to ``fn(target, recommendation) -> result``.
+    In dry-run mode the callables are never invoked.
+    """
+
+    def __init__(self, actions=None, allow_destructive=False, dry_run=True):
+        self.actions = dict(actions or {})
+        for verb in self.actions:
+            if not Action.is_valid(verb):
+                raise UnknownActionError("unknown action verb %r" % (verb,))
+        self.allow_destructive = bool(allow_destructive)
+        self.dry_run = bool(dry_run)
+
+    def execute(self, plan, dry_run=None, allow_destructive=None):
+        """Run ``plan`` and return an :class:`ExecutionReport`."""
+        dry = self.dry_run if dry_run is None else bool(dry_run)
+        allow_destr = (
+            self.allow_destructive if allow_destructive is None else bool(allow_destructive)
+        )
+        results = []
+        for rec in plan:
+            results.append(self._execute_one(rec, dry, allow_destr))
+        return ExecutionReport(results, dry_run=dry, currency=plan.currency)
+
+    def _execute_one(self, rec, dry, allow_destr):
+        target = rec.target
+
+        # A protected target must never reach a destructive action.
+        if target.protected and rec.is_destructive:
+            raise ProtectedResourceError(
+                "refusing destructive action %s on protected resource %s" % (
+                    rec.action, target.resource_id),
+                resource_id=target.resource_id,
+            )
+
+        if dry:
+            return ActionResult(rec, Outcome.PLANNED, detail="dry-run")
+
+        if rec.is_destructive and not allow_destr:
+            return ActionResult(
+                rec, Outcome.SKIPPED,
+                detail="destructive action not permitted (allow_destructive=False)",
+            )
+
+        fn = self.actions.get(rec.action)
+        if fn is None:
+            return ActionResult(
+                rec, Outcome.SKIPPED, detail="no callable registered for %s" % rec.action,
+            )
+
+        try:
+            result = fn(target, rec)
+        except Exception as exc:  # noqa: BLE001 - surfaced as a structured result
+            return ActionResult(
+                rec, Outcome.FAILED, detail=str(exc),
+                error=ActionExecutionError(
+                    "action %s failed on %s" % (rec.action, target.resource_id),
+                    action=rec.action, resource_id=target.resource_id, cause=exc,
+                ),
+            )
+
+        # Interpret the callable's return value for idempotency.
+        if isinstance(result, str) and result.lower() in _NOOP_SENTINELS:
+            return ActionResult(rec, Outcome.NOOP, detail=result)
+        if result is False or result is None:
+            # Convention: falsey means "nothing to do" (already reclaimed).
+            return ActionResult(rec, Outcome.NOOP, detail="callable reported no-op")
+        return ActionResult(rec, Outcome.DONE, detail=result if isinstance(result, str) else None)
+
+    def __repr__(self):
+        return "<ReclaimExecutor actions=%s dry_run=%s destructive=%s>" % (
+            sorted(self.actions), self.dry_run, self.allow_destructive,
+        )
diff --git a/libcloud/reclaim2/loader.py b/libcloud/reclaim2/loader.py
new file mode 100644
index 000000000..3ecd8b800
--- /dev/null
+++ b/libcloud/reclaim2/loader.py
@@ -0,0 +1,184 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Layered configuration for the reclamation planner.
+
+A reclamation policy is usually assembled from layers: an organisation baseline
+(keep 3 snapshots, destroy nodes stopped > 30 days), refined per environment (prod
+keeps more snapshots and is more conservative about destroying). :func:`merge_documents`
+folds config dicts left-to-right with predictable semantics (nested dicts merge,
+list-typed keys such as ``enabled_rules`` accumulate and de-dupe, ``None`` deletes,
+else replace), and :func:`load_planner` / :func:`load_session` turn the merged
+settings into live objects.
+
+The set of rules is selectable by name so an environment can switch individual
+policies off without touching code.
+"""
+
+from __future__ import annotations
+
+import copy
+
+from libcloud.reclaim2.errors import PolicyError, ReclaimConfigError
+from libcloud.reclaim2.planner import ReclaimPlanner, RetentionConfig
+from libcloud.reclaim2.rules import (
+    EmptyContainerRule,
+    IdleNodeRule,
+    OldSnapshotRule,
+    RightsizeRule,
+    RuleConfig,
+    StoppedNodeRule,
+    UnattachedVolumeRule,
+)
+from libcloud.reclaim2.session import ReclaimSession
+
+__all__ = [
+    "DEFAULT_SETTINGS",
+    "RULE_REGISTRY",
+    "merge_documents",
+    "load_settings",
+    "load_rule_config",
+    "load_planner",
+    "load_session",
+]
+
+# Keys whose list values accumulate across layers rather than replacing.
+_APPEND_LIST_KEYS = frozenset({"enabled_rules"})
+
+# Rule name -> class.
+RULE_REGISTRY = {
+    StoppedNodeRule.name: StoppedNodeRule,
+    IdleNodeRule.name: IdleNodeRule,
+    UnattachedVolumeRule.name: UnattachedVolumeRule,
+    OldSnapshotRule.name: OldSnapshotRule,
+    EmptyContainerRule.name: EmptyContainerRule,
+    RightsizeRule.name: RightsizeRule,
+}
+
+# Order rules are applied in when a subset is selected.
+_RULE_ORDER = [
+    StoppedNodeRule.name,
+    IdleNodeRule.name,
+    UnattachedVolumeRule.name,
+    OldSnapshotRule.name,
+    EmptyContainerRule.name,
+    RightsizeRule.name,
+]
+
+DEFAULT_SETTINGS = {
+    "currency": "USD",
+    # ``enabled_rules`` is deliberately absent here: when no layer specifies it,
+    # every rule is active (see :func:`_build_rules`). Presetting the full list
+    # would make the append-merge semantics unable to *narrow* to a subset.
+    "thresholds": {
+        "idle_stop_days": 3.0,
+        "stopped_destroy_days": 30.0,
+        "unattached_volume_days": 7.0,
+        "snapshot_max_age_days": 90.0,
+        "empty_container_days": 30.0,
+        "rightsize_utilisation_floor": 0.2,
+        "rightsize_savings_fraction": 0.5,
+    },
+    "retention": {"keep_last": 3},
+}
+
+
+def _merge_two(base, override):
+    if not isinstance(base, dict) or not isinstance(override, dict):
+        return copy.deepcopy(override)
+    result = copy.deepcopy(base)
+    for key, value in override.items():
+        if value is None:
+            result.pop(key, None)
+            continue
+        if key in _APPEND_LIST_KEYS and isinstance(value, list):
+            existing = result.get(key)
+            if not isinstance(existing, list):
+                existing = []
+            merged = list(existing)
+            for element in value:
+                if isinstance(element, (str, int, float, bool)) and element in merged:
+                    continue
+                merged.append(copy.deepcopy(element))
+            result[key] = merged
+        elif isinstance(value, dict) and isinstance(result.get(key), dict):
+            result[key] = _merge_two(result[key], value)
+        else:
+            result[key] = copy.deepcopy(value)
+    return result
+
+
+def merge_documents(*documents):
+    """Left-to-right fold of config documents into one settings dict."""
+    merged = {}
+    for document in documents:
+        if document is None:
+            continue
+        if not isinstance(document, dict):
+            raise ReclaimConfigError(
+                "config document must be a dict, got %r" % (type(document).__name__,)
+            )
+        merged = _merge_two(merged, document)
+    return merged
+
+
+def load_settings(*documents):
+    return merge_documents(DEFAULT_SETTINGS, *documents)
+
+
+def load_rule_config(settings):
+    """Build a :class:`RuleConfig` from merged settings."""
+    thresholds = settings.get("thresholds") or {}
+    if not isinstance(thresholds, dict):
+        raise PolicyError("thresholds must be a mapping")
+    try:
+        return RuleConfig(currency=settings.get("currency", "USD"), **thresholds)
+    except TypeError as exc:
+        raise PolicyError("invalid threshold key: %s" % (exc,))
+
+
+def _build_rules(settings, config):
+    names = settings.get("enabled_rules")
+    if names is None:
+        names = list(_RULE_ORDER)
+    if not isinstance(names, list):
+        raise PolicyError("enabled_rules must be a list of rule names")
+    rules = []
+    for name in _RULE_ORDER:
+        if name in names:
+            rules.append(RULE_REGISTRY[name](config))
+    # Any name not in the registry is a configuration mistake worth surfacing.
+    for name in names:
+        if name not in RULE_REGISTRY:
+            raise PolicyError("unknown rule name %r" % (name,))
+    return rules
+
+
+def load_planner(*documents):
+    """Merge config and build a :class:`ReclaimPlanner`."""
+    settings = load_settings(*documents)
+    config = load_rule_config(settings)
+    rules = _build_rules(settings, config)
+    retention_spec = settings.get("retention") or {}
+    if not isinstance(retention_spec, dict):
+        raise PolicyError("retention must be a mapping")
+    retention = RetentionConfig(keep_last=retention_spec.get("keep_last", 3))
+    return ReclaimPlanner(rules=rules, config=config, retention=retention)
+
+
+def load_session(*documents, executor=None, as_of=None):
+    """End-to-end: merge config, build a planner, return a reclamation session."""
+    planner = load_planner(*documents)
+    return ReclaimSession(planner=planner, executor=executor, as_of=as_of)
diff --git a/libcloud/reclaim2/money.py b/libcloud/reclaim2/money.py
