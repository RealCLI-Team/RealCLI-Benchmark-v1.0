index 000000000..221d15bac
--- /dev/null
+++ b/libcloud/reclaim2/money.py
@@ -0,0 +1,108 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""A small money primitive for expressing projected savings.
+
+Reclamation is all about "how much would we save per month if we did this?", so
+the planner needs to add up per-resource monthly savings, scale hourly rates into
+monthly ones, and render human-readable totals. This is a deliberately tiny,
+currency-safe value type -- adding two amounts in different currencies is refused
+rather than silently mis-summed. The monthly projection uses the industry-standard
+730-hour month (365 x 24 / 12) so an hourly rate maps to a monthly figure that
+matches the way cloud vendors quote their prices.
+"""
+
+from __future__ import annotations
+
+__all__ = ["HOURS_PER_MONTH", "Money", "monthly_from_hourly", "format_money"]
+
+# Industry-standard month length used across cloud pricing pages.
+HOURS_PER_MONTH = 730.0
+
+
+class Money:
+    """An immutable, currency-tagged monetary amount."""
+
+    __slots__ = ("amount", "currency")
+
+    def __init__(self, amount, currency="USD"):
+        self.amount = float(amount)
+        self.currency = currency
+
+    @classmethod
+    def zero(cls, currency="USD"):
+        return cls(0.0, currency)
+
+    def _check(self, other):
+        if not isinstance(other, Money):
+            raise TypeError("can only combine Money with Money, not %r" % (type(other).__name__,))
+        if other.currency != self.currency:
+            raise ValueError(
+                "refusing to combine %s and %s" % (self.currency, other.currency)
+            )
+
+    def __add__(self, other):
+        self._check(other)
+        return Money(self.amount + other.amount, self.currency)
+
+    def __sub__(self, other):
+        self._check(other)
+        return Money(self.amount - other.amount, self.currency)
+
+    def __mul__(self, factor):
+        return Money(self.amount * float(factor), self.currency)
+
+    __rmul__ = __mul__
+
+    def rounded(self, ndigits=2):
+        return Money(round(self.amount, ndigits), self.currency)
+
+    def as_dict(self):
+        return {"amount": round(self.amount, 6), "currency": self.currency}
+
+    def __eq__(self, other):
+        return (
+            isinstance(other, Money)
+            and self.currency == other.currency
+            and abs(self.amount - other.amount) < 1e-9
+        )
+
+    def __lt__(self, other):
+        self._check(other)
+        return self.amount < other.amount
+
+    def __le__(self, other):
+        self._check(other)
+        return self.amount <= other.amount
+
+    def __hash__(self):
+        return hash((round(self.amount, 6), self.currency))
+
+    def __repr__(self):
+        return "<Money %s %.4f>" % (self.currency, self.amount)
+
+
+def monthly_from_hourly(hourly, currency="USD"):
+    """Project an hourly rate into a monthly :class:`Money` amount (730h month)."""
+    return Money(float(hourly) * HOURS_PER_MONTH, currency)
+
+
+def format_money(money):
+    """Render a :class:`Money` as e.g. ``$1,234.56`` (USD) or ``EUR 1,234.56``."""
+    symbol = {"USD": "$", "GBP": "£", "EUR": "€"}.get(money.currency)
+    body = "{:,.2f}".format(money.amount)
+    if symbol:
+        return "%s%s" % (symbol, body)
+    return "%s %s" % (money.currency, body)
diff --git a/libcloud/reclaim2/plan.py b/libcloud/reclaim2/plan.py
new file mode 100644
index 000000000..343a26891
--- /dev/null
+++ b/libcloud/reclaim2/plan.py
@@ -0,0 +1,151 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""The reclamation plan: an ordered, deduplicated set of recommendations.
+
+A :class:`ReclaimPlan` is the planner's output and the executor's input. It holds
+recommendations sorted biggest-saving-first, guarantees at most one action per
+resource (the most valuable wins), exposes rollups (total projected monthly
+savings, savings by action / by provider, destructive vs reversible counts), and
+serialises to dict / JSON / human text. It is pure data: nothing in here reaches
+out to a cloud.
+"""
+
+from __future__ import annotations
+
+import json
+
+from libcloud.reclaim2.actions import action_is_destructive
+from libcloud.reclaim2.money import Money, format_money
+
+__all__ = ["ReclaimPlan"]
+
+
+class ReclaimPlan:
+    """An ordered set of recommendations plus savings rollups."""
+
+    def __init__(self, recommendations, currency="USD", skipped_protected=None):
+        self.currency = currency
+        # At most one recommendation per resource identity: keep the one with the
+        # largest projected saving (ties -> deterministic by sort_key).
+        best = {}
+        for rec in recommendations:
+            ident = rec.target.identity
+            cur = best.get(ident)
+            if cur is None or rec.sort_key < cur.sort_key:
+                best[ident] = rec
+        self.recommendations = sorted(best.values(), key=lambda r: r.sort_key)
+        # Targets that were excluded because they were protected/pinned.
+        self.skipped_protected = list(skipped_protected or [])
+
+    # --- Size -----------------------------------------------------------------
+    def __len__(self):
+        return len(self.recommendations)
+
+    def __iter__(self):
+        return iter(self.recommendations)
+
+    @property
+    def is_empty(self):
+        return not self.recommendations
+
+    # --- Savings rollups ------------------------------------------------------
+    @property
+    def total_monthly_savings(self):
+        total = Money.zero(self.currency)
+        for rec in self.recommendations:
+            total = total + rec.monthly_savings
+        return total.rounded()
+
+    def savings_by_action(self):
+        out = {}
+        for rec in self.recommendations:
+            cur = out.get(rec.action, Money.zero(self.currency))
+            out[rec.action] = cur + rec.monthly_savings
+        return {k: v.rounded() for k, v in out.items()}
+
+    def savings_by_provider(self):
+        out = {}
+        for rec in self.recommendations:
+            key = rec.target.provider
+            cur = out.get(key, Money.zero(self.currency))
+            out[key] = cur + rec.monthly_savings
+        return {k: v.rounded() for k, v in out.items()}
+
+    def count_by_action(self):
+        out = {}
+        for rec in self.recommendations:
+            out[rec.action] = out.get(rec.action, 0) + 1
+        return out
+
+    # --- Risk split -----------------------------------------------------------
+    @property
+    def destructive(self):
+        return [r for r in self.recommendations if r.is_destructive]
+
+    @property
+    def reversible(self):
+        return [r for r in self.recommendations if not r.is_destructive]
+
+    def for_action(self, action):
+        return [r for r in self.recommendations if r.action == action]
+
+    def for_provider(self, provider):
+        return [r for r in self.recommendations if r.target.provider == provider]
+
+    def top(self, n=5):
+        return self.recommendations[:n]
+
+    # --- Serialisation --------------------------------------------------------
+    def as_dict(self):
+        return {
+            "currency": self.currency,
+            "count": len(self.recommendations),
+            "total_monthly_savings": self.total_monthly_savings.as_dict(),
+            "count_by_action": self.count_by_action(),
+            "savings_by_action": {
+                k: v.as_dict() for k, v in sorted(self.savings_by_action().items())
+            },
+            "savings_by_provider": {
+                k: v.as_dict() for k, v in sorted(self.savings_by_provider().items())
+            },
+            "destructive_count": len(self.destructive),
+            "reversible_count": len(self.reversible),
+            "skipped_protected": len(self.skipped_protected),
+            "recommendations": [r.as_dict() for r in self.recommendations],
+        }
+
+    def as_json(self, indent=2):
+        return json.dumps(self.as_dict(), indent=indent, sort_keys=True)
+
+    def render_text(self):
+        lines = []
+        lines.append("Reclamation plan: %d action(s), projected savings %s/month" % (
+            len(self.recommendations), format_money(self.total_monthly_savings)))
+        counts = self.count_by_action()
+        for action in sorted(counts):
+            savings = self.savings_by_action().get(action, Money.zero(self.currency))
+            lines.append("  %-16s %d  (%s/mo)" % (
+                action, counts[action], format_money(savings)))
+        if self.destructive:
+            lines.append("  ! %d destructive action(s) require confirmation" % len(self.destructive))
+        if self.skipped_protected:
+            lines.append("  %d protected resource(s) skipped" % len(self.skipped_protected))
+        return "\n".join(lines)
+
+    def __repr__(self):
+        return "<ReclaimPlan actions=%d savings=%s>" % (
+            len(self.recommendations), self.total_monthly_savings,
+        )
diff --git a/libcloud/reclaim2/planner.py b/libcloud/reclaim2/planner.py
new file mode 100644
index 000000000..ca07e96c8
--- /dev/null
+++ b/libcloud/reclaim2/planner.py
@@ -0,0 +1,131 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""The planner: run rules over a fleet and assemble a reclamation plan.
+
+The :class:`ReclaimPlanner` is the brain. Given a list of
+:class:`~libcloud.reclaim2.target.ReclaimTarget`, it:
+
+* filters out every **protected** target up front (they are recorded as skipped,
+  never recommended for anything),
+* runs each per-resource :class:`~libcloud.reclaim2.rules.Rule`,
+* applies the one genuinely cross-resource policy -- **snapshot retention**: for
+  each parent volume keep the newest ``keep_last`` snapshots and propose deleting
+  the surplus,
+* and folds everything into a deterministic :class:`~libcloud.reclaim2.plan.ReclaimPlan`.
+
+The planner is pure: it reads targets and returns a plan. It never calls a cloud
+API and never mutates a target.
+"""
+
+from __future__ import annotations
+
+from libcloud.reclaim2.actions import Action, Recommendation, savings_for
+from libcloud.reclaim2.plan import ReclaimPlan
+from libcloud.reclaim2.rules import RuleConfig, default_rules
+from libcloud.reclaim2.target import ResourceKind
+
+__all__ = ["RetentionConfig", "ReclaimPlanner"]
+
+
+class RetentionConfig:
+    """How many snapshots to keep per parent volume."""
+
+    __slots__ = ("keep_last",)
+
+    def __init__(self, keep_last=3):
+        self.keep_last = int(keep_last)
+
+    def as_dict(self):
+        return {"keep_last": self.keep_last}
+
+
+class ReclaimPlanner:
+    """Assemble a :class:`ReclaimPlan` from a fleet of targets."""
+
+    def __init__(self, rules=None, config=None, retention=None, currency=None):
+        self.config = config or RuleConfig()
+        if currency:
+            self.config.currency = currency
+        self.rules = rules if rules is not None else default_rules(self.config)
+        self.retention = retention or RetentionConfig()
+
+    # --- Public API -----------------------------------------------------------
+    def plan(self, targets):
+        """Return a :class:`ReclaimPlan` for ``targets``."""
+        targets = list(targets)
+        protected = [t for t in targets if t.protected]
+        active = [t for t in targets if not t.protected]
+
+        context = {"by_identity": {t.identity: t for t in active}}
+        recommendations = []
+
+        # Per-resource rules.
+        for target in active:
+            for rule in self.rules:
+                rec = rule.propose(target, context=context)
+                if rec is not None:
+                    recommendations.append(rec)
+
+        # Cross-resource: snapshot retention per parent volume.
+        recommendations.extend(self._retention_recommendations(active))
+
+        return ReclaimPlan(
+            recommendations,
+            currency=self.config.currency,
+            skipped_protected=protected,
+        )
+
+    # --- Snapshot retention ---------------------------------------------------
+    def _retention_recommendations(self, targets):
+        keep = self.retention.keep_last
+        if keep < 0:
+            return []
+        # Group snapshots by parent volume (skip those with no parent).
+        groups = {}
+        for t in targets:
+            if t.kind != ResourceKind.SNAPSHOT:
+                continue
+            parent = t.parent_volume
+            if parent is None:
+                continue
+            groups.setdefault(str(parent), []).append(t)
+
+        out = []
+        for parent, snaps in groups.items():
+            if len(snaps) <= keep:
+                continue
+            # Newest first: larger age_days == older, so sort ascending by age
+            # keeps the youngest at the front. Unknown age sorts oldest.
+            def _age(s):
+                return s.age_days if s.age_days is not None else float("inf")
+            ordered = sorted(snaps, key=lambda s: (_age(s), s.sort_key))
+            surplus = ordered[keep:]
+            for snap in surplus:
+                savings = savings_for(
+                    Action.DELETE_SNAPSHOT, snap, currency=self.config.currency
+                )
+                out.append(Recommendation(
+                    snap, Action.DELETE_SNAPSHOT,
+                    "surplus snapshot: keeping newest %d for volume %s" % (keep, parent),
+                    savings,
+                    detail={"parent_volume": parent, "keep_last": keep},
+                ))
+        return out
+
+    def __repr__(self):
+        return "<ReclaimPlanner rules=%d keep_last=%d>" % (
+            len(self.rules), self.retention.keep_last,
+        )
diff --git a/libcloud/reclaim2/rules.py b/libcloud/reclaim2/rules.py
new file mode 100644
index 000000000..18ca65f12
--- /dev/null
+++ b/libcloud/reclaim2/rules.py
@@ -0,0 +1,287 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Reclamation rules: the policies that turn a target into a recommendation.
+
+Each rule looks at one :class:`~libcloud.reclaim2.target.ReclaimTarget` and, if it
+applies, proposes one action with a rationale. The rules encode the usual
+cost-hygiene playbook:
+
+* **idle nodes** -- a running node flagged idle for long enough should be stopped;
+  a node already stopped for long enough should be destroyed.
+* **unattached volumes** -- a volume with no attachment, past a grace age, should
+  be deleted.
+* **old / surplus snapshots** -- snapshots older than a max age should be pruned;
+  and, per parent volume, only the newest N are kept.
+* **empty containers** -- a zero-byte bucket past a grace age should be deleted.
+* **rightsizing** -- a node whose utilisation hint sits below a floor should be
+  resized to a cheaper shape, saving a caller-estimated delta.
+
+Rules never mutate anything and never touch a protected target (the planner
+filters those out first, but rules double-check). Thresholds come from a
+:class:`RuleConfig` so the whole policy is data-driven and testable.
+"""
+
+from __future__ import annotations
+
+from libcloud.reclaim2.actions import Action, Recommendation, savings_for
+from libcloud.reclaim2.target import ResourceKind
+
+__all__ = [
+    "RuleConfig",
+    "Rule",
+    "IdleNodeRule",
+    "StoppedNodeRule",
+    "UnattachedVolumeRule",
+    "OldSnapshotRule",
+    "EmptyContainerRule",
+    "RightsizeRule",
+    "default_rules",
+]
+
+
+class RuleConfig:
+    """Tunable thresholds shared by the rules.
+
+    Every field has a conservative default. ``currency`` tags the savings.
+    """
+
+    __slots__ = (
+        "currency",
+        "idle_stop_days",
+        "stopped_destroy_days",
+        "unattached_volume_days",
+        "snapshot_max_age_days",
+        "empty_container_days",
+        "rightsize_utilisation_floor",
+        "rightsize_savings_fraction",
+    )
+
+    def __init__(
+        self,
+        currency="USD",
+        idle_stop_days=3.0,
+        stopped_destroy_days=30.0,
+        unattached_volume_days=7.0,
+        snapshot_max_age_days=90.0,
+        empty_container_days=30.0,
+        rightsize_utilisation_floor=0.2,
+        rightsize_savings_fraction=0.5,
+    ):
+        self.currency = currency
+        self.idle_stop_days = float(idle_stop_days)
+        self.stopped_destroy_days = float(stopped_destroy_days)
+        self.unattached_volume_days = float(unattached_volume_days)
+        self.snapshot_max_age_days = float(snapshot_max_age_days)
+        self.empty_container_days = float(empty_container_days)
+        self.rightsize_utilisation_floor = float(rightsize_utilisation_floor)
+        self.rightsize_savings_fraction = float(rightsize_savings_fraction)
+
+    def as_dict(self):
+        return {
+            "currency": self.currency,
+            "idle_stop_days": self.idle_stop_days,
+            "stopped_destroy_days": self.stopped_destroy_days,
+            "unattached_volume_days": self.unattached_volume_days,
+            "snapshot_max_age_days": self.snapshot_max_age_days,
+            "empty_container_days": self.empty_container_days,
+            "rightsize_utilisation_floor": self.rightsize_utilisation_floor,
+            "rightsize_savings_fraction": self.rightsize_savings_fraction,
+        }
+
+    def __repr__(self):
+        return "<RuleConfig currency=%s>" % (self.currency,)
+
+
+# States that count as "stopped" for the destroy rule.
+_STOPPED_STATES = frozenset({"stopped", "suspended", "paused"})
+_RUNNING_STATES = frozenset({"running", "normal"})
+# Volume states that indicate no attachment.
+_UNATTACHED_STATES = frozenset({"available", "unattached", "detached"})
+
+
+class Rule:
+    """Base class: a named policy that may propose one action for a target.
+
+    ``context`` is a small dict the planner threads through (e.g. the full target
+    list keyed by identity), letting cross-resource rules see their neighbours.
+    """
+
+    name = "rule"
+
+    def __init__(self, config=None):
+        self.config = config or RuleConfig()
+
+    def propose(self, target, context=None):
+        """Return a :class:`Recommendation` or ``None``. Must not mutate anything."""
+        raise NotImplementedError
+
+    def _rec(self, target, action, reason, hourly_saved=None, detail=None):
+        savings = savings_for(
+            action, target, hourly_saved=hourly_saved, currency=self.config.currency
+        )
+        return Recommendation(target, action, reason, savings, detail=detail)
+
+    def __repr__(self):
+        return "<%s>" % (type(self).__name__,)
+
+
+class IdleNodeRule(Rule):
+    """Running-but-idle nodes past ``idle_stop_days`` -> stop them."""
+
+    name = "idle-node"
+
+    def propose(self, target, context=None):
+        if target.kind != ResourceKind.NODE:
+            return None
+        if target.state not in _RUNNING_STATES:
+            return None
+        if not target.idle:
+            return None
+        if not target.older_than(self.config.idle_stop_days):
+            # Age unknown or too young: only act when we can justify it by age.
+            if target.age_days is not None:
+                return None
+        return self._rec(
+            target, Action.STOP_NODE,
+            "node idle for >= %g days" % self.config.idle_stop_days,
+            detail={"idle": True, "age_days": target.age_days},
+        )
+
+
+class StoppedNodeRule(Rule):
+    """Nodes stopped for longer than ``stopped_destroy_days`` -> destroy them."""
+
+    name = "stopped-node"
+
+    def propose(self, target, context=None):
+        if target.kind != ResourceKind.NODE:
+            return None
+        if target.state not in _STOPPED_STATES:
+            return None
+        if not target.older_than(self.config.stopped_destroy_days):
+            return None
+        return self._rec(
+            target, Action.DESTROY_NODE,
+            "node stopped for >= %g days" % self.config.stopped_destroy_days,
+            detail={"age_days": target.age_days},
+        )
+
+
+class UnattachedVolumeRule(Rule):
+    """Unattached volumes past ``unattached_volume_days`` -> delete them."""
+
+    name = "unattached-volume"
+
+    def propose(self, target, context=None):
+        if target.kind != ResourceKind.VOLUME:
+            return None
+        if target.attachment:
+            return None
+        if target.state not in _UNATTACHED_STATES and target.state != "unknown":
+            return None
+        if not target.older_than(self.config.unattached_volume_days):
+            if target.age_days is not None:
+                return None
+        return self._rec(
+            target, Action.DELETE_VOLUME,
+            "volume unattached for >= %g days" % self.config.unattached_volume_days,
+            detail={"size": target.size, "age_days": target.age_days},
+        )
+
+
+class OldSnapshotRule(Rule):
+    """Snapshots older than ``snapshot_max_age_days`` -> prune them."""
+
+    name = "old-snapshot"
+
+    def propose(self, target, context=None):
+        if target.kind != ResourceKind.SNAPSHOT:
+            return None
+        if not target.older_than(self.config.snapshot_max_age_days):
+            return None
+        return self._rec(
+            target, Action.DELETE_SNAPSHOT,
+            "snapshot older than %g days" % self.config.snapshot_max_age_days,
+            detail={"age_days": target.age_days},
+        )
+
+
+class EmptyContainerRule(Rule):
+    """Zero-byte containers past ``empty_container_days`` -> delete them."""
+
+    name = "empty-container"
+
+    def propose(self, target, context=None):
+        if target.kind != ResourceKind.CONTAINER:
+            return None
+        if target.size > 0:
+            return None
+        if target.age_days is not None and not target.older_than(
+            self.config.empty_container_days
+        ):
+            return None
+        return self._rec(
+            target, Action.DELETE_CONTAINER,
+            "container empty for >= %g days" % self.config.empty_container_days,
+            detail={"age_days": target.age_days},
+        )
+
+
+class RightsizeRule(Rule):
+    """Under-utilised nodes -> resize to a cheaper shape.
+
+    Utilisation is read from ``target.extra['utilisation']`` (a 0..1 float). When
+    it sits at or below the floor, we propose a resize projected to save
+    ``rightsize_savings_fraction`` of the current hourly cost.
+    """
+
+    name = "rightsize"
+
+    def propose(self, target, context=None):
+        if target.kind != ResourceKind.NODE:
+            return None
+        if target.state not in _RUNNING_STATES:
+            return None
+        util = target.extra.get("utilisation", target.extra.get("utilization"))
+        if util is None:
+            return None
+        try:
+            util = float(util)
+        except (TypeError, ValueError):
+            return None
+        if util > self.config.rightsize_utilisation_floor:
+            return None
+        hourly_saved = self.config.rightsize_savings_fraction * target.hourly_cost
+        return self._rec(
+            target, Action.RESIZE_NODE,
+            "node utilisation %.2f <= floor %.2f" % (
+                util, self.config.rightsize_utilisation_floor),
+            hourly_saved=hourly_saved,
+            detail={"utilisation": util},
+        )
+
+
+def default_rules(config=None):
+    """The standard rule set, in priority order."""
+    config = config or RuleConfig()
+    return [
+        StoppedNodeRule(config),
+        IdleNodeRule(config),
+        UnattachedVolumeRule(config),
+        OldSnapshotRule(config),
+        EmptyContainerRule(config),
+        RightsizeRule(config),
+    ]
