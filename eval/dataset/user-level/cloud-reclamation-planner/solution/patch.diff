+"""Offline, read-only cloud reclamation planning for Apache Libcloud fleets.
+
+This package layers a *scriptable, offline* reclamation planner on top of
+Libcloud's own resource model. Given a heterogeneous fleet of already-collected
+resources, it distils them into targets, recommends spend-reduction actions (stop
+idle nodes, destroy long-stopped ones, delete unattached volumes, prune old /
+surplus snapshots, delete empty containers, rightsize under-utilised nodes),
+projects the monthly savings, and -- through *injected* action callables -- can
+preview (dry-run) or apply the plan without ever calling a cloud API itself.
+
+Everything a caller needs is re-exported here for ``from libcloud.reclaim2
+import ...``.
+"""
+
+from libcloud.reclaim2.errors import (
+    ReclaimError,
+    ReclaimConfigError,
+    UnknownActionError,
+    PolicyError,
+    ProtectedResourceError,
+    ActionExecutionError,
+)
+from libcloud.reclaim2.money import (
+    HOURS_PER_MONTH,
+    Money,
+    monthly_from_hourly,
+    format_money,
+)
+from libcloud.reclaim2.target import (
+    ResourceKind,
+    ReclaimTarget,
+    build_target,
+    build_targets,
+)
+from libcloud.reclaim2.actions import (
+    Action,
+    ACTION_SAVINGS_FRACTION,
+    action_is_destructive,
+    savings_for,
+    Recommendation,
+)
+from libcloud.reclaim2.rules import (
+    RuleConfig,
+    Rule,
+    IdleNodeRule,
+    StoppedNodeRule,
+    UnattachedVolumeRule,
+    OldSnapshotRule,
+    EmptyContainerRule,
+    RightsizeRule,
+    default_rules,
+)
+from libcloud.reclaim2.plan import ReclaimPlan
+from libcloud.reclaim2.planner import RetentionConfig, ReclaimPlanner
+from libcloud.reclaim2.executor import (
+    Outcome,
+    ActionResult,
+    ExecutionReport,
+    ReclaimExecutor,
+)
+from libcloud.reclaim2.session import ReclaimSession
+from libcloud.reclaim2.loader import (
+    DEFAULT_SETTINGS,
+    RULE_REGISTRY,
+    merge_documents,
+    load_settings,
+    load_rule_config,
+    load_planner,
+    load_session,
+)
+
+__all__ = [
+    # errors
+    "ReclaimError",
+    "ReclaimConfigError",
+    "UnknownActionError",
+    "PolicyError",
+    "ProtectedResourceError",
+    "ActionExecutionError",
+    # money
+    "HOURS_PER_MONTH",
+    "Money",
+    "monthly_from_hourly",
+    "format_money",
+    # target
+    "ResourceKind",
+    "ReclaimTarget",
+    "build_target",
+    "build_targets",
+    # actions
+    "Action",
+    "ACTION_SAVINGS_FRACTION",
+    "action_is_destructive",
+    "savings_for",
+    "Recommendation",
+    # rules
+    "RuleConfig",
+    "Rule",
+    "IdleNodeRule",
+    "StoppedNodeRule",
+    "UnattachedVolumeRule",
+    "OldSnapshotRule",
+    "EmptyContainerRule",
+    "RightsizeRule",
+    "default_rules",
+    # plan
+    "ReclaimPlan",
+    # planner
+    "RetentionConfig",
+    "ReclaimPlanner",
+    # executor
+    "Outcome",
+    "ActionResult",
+    "ExecutionReport",
+    "ReclaimExecutor",
+    # session
+    "ReclaimSession",
+    # loader
+    "DEFAULT_SETTINGS",
+    "RULE_REGISTRY",
+    "merge_documents",
+    "load_settings",
+    "load_rule_config",
+    "load_planner",
+    "load_session",
+]
diff --git a/libcloud/reclaim2/actions.py b/libcloud/reclaim2/actions.py
new file mode 100644
index 000000000..2afc35e90
--- /dev/null
+++ b/libcloud/reclaim2/actions.py
@@ -0,0 +1,156 @@
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.
+# The ASF licenses this file to You under the Apache License, Version 2.0
+# (the "License"); you may not use this file except in compliance with
+# the License.  You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Reclamation actions and the recommendations that carry them.
+
+An action is *what to do* to a resource to save money: stop an idle node, destroy
+one that's been off for weeks, delete an unattached volume, prune an old snapshot,
+or resize an over-provisioned node to a cheaper shape. Each verb has a
+*reversibility* -- stopping and resizing are reversible, destroying and deleting
+are not -- which the executor and reports treat differently.
+
+A :class:`Recommendation` pairs one action with the target it applies to, why it
+was chosen, and how much it is projected to save per month. Recommendations are
+pure data: building one changes nothing.
+"""
+
+from __future__ import annotations
+
+from libcloud.reclaim2.money import Money, monthly_from_hourly
+
+__all__ = [
+    "Action",
+    "ACTION_SAVINGS_FRACTION",
+    "action_is_destructive",
+    "savings_for",
+    "Recommendation",
+]
+
+
+class Action:
+    """The catalogue of reclamation verbs."""
+
+    STOP_NODE = "stop-node"
+    DESTROY_NODE = "destroy-node"
+    DELETE_VOLUME = "delete-volume"
+    DELETE_SNAPSHOT = "delete-snapshot"
+    DELETE_CONTAINER = "delete-container"
+    RESIZE_NODE = "resize-node"
+
+    _ALL = (
+        STOP_NODE,
+        DESTROY_NODE,
+        DELETE_VOLUME,
+        DELETE_SNAPSHOT,
+        DELETE_CONTAINER,
+        RESIZE_NODE,
+    )
+
+    # Verbs that cannot be undone -- treated with extra care by the executor.
+    _DESTRUCTIVE = frozenset({
+        DESTROY_NODE, DELETE_VOLUME, DELETE_SNAPSHOT, DELETE_CONTAINER,
+    })
+
+    @classmethod
+    def is_valid(cls, action):
+        return action in cls._ALL
+
+    @classmethod
+    def all(cls):
+        return cls._ALL
+
+
+def action_is_destructive(action):
+    return action in Action._DESTRUCTIVE
+
+
+# Fraction of a target's current hourly cost that each action is expected to
+# save. Stopping a node removes its compute charge (but leaves disks), so it is
+# less than a full destroy; a resize saves a caller-supplied delta and defaults
+# to nothing here unless an explicit saved amount is given.
+ACTION_SAVINGS_FRACTION = {
+    Action.STOP_NODE: 1.0,          # compute charge eliminated while stopped
+    Action.DESTROY_NODE: 1.0,       # whole node cost gone
+    Action.DELETE_VOLUME: 1.0,      # whole volume cost gone
+    Action.DELETE_SNAPSHOT: 1.0,    # whole snapshot cost gone
+    Action.DELETE_CONTAINER: 1.0,   # whole container cost gone
+    Action.RESIZE_NODE: 0.0,        # savings must be supplied explicitly
+}
+
+
+def savings_for(action, target, hourly_saved=None, currency="USD"):
+    """Projected *monthly* :class:`Money` saved by applying ``action`` to ``target``.
+
+    By default the saving is ``fraction * target.hourly_cost`` projected to a
+    730-hour month. For a resize (or any action where the caller knows better),
+    pass ``hourly_saved`` to override the hourly delta directly.
+    """
+    if hourly_saved is None:
+        fraction = ACTION_SAVINGS_FRACTION.get(action, 0.0)
+        hourly_saved = fraction * target.hourly_cost
+    hourly_saved = max(0.0, float(hourly_saved))
+    return monthly_from_hourly(hourly_saved, currency)
+
+
+class Recommendation:
+    """One proposed action against one target, with rationale and savings."""
+
+    __slots__ = ("target", "action", "reason", "monthly_savings", "detail")
+
+    def __init__(self, target, action, reason, monthly_savings, detail=None):
+        self.target = target
+        self.action = action
+        self.reason = reason
+        self.monthly_savings = monthly_savings
+        self.detail = dict(detail or {})
+
+    @property
+    def resource_id(self):
+        return self.target.resource_id
+
+    @property
+    def is_destructive(self):
+        return action_is_destructive(self.action)
+
+    @property
+    def sort_key(self):
+        # Biggest savings first; ties broken by the target's own order.
+        return (-self.monthly_savings.amount, self.target.sort_key, self.action)
+
+    def as_dict(self):
+        return {
+            "action": self.action,
+            "resource_id": self.resource_id,
+            "provider": self.target.provider,
+            "kind": self.target.kind,
+            "region": self.target.region,
+            "reason": self.reason,
+            "destructive": self.is_destructive,
+            "monthly_savings": self.monthly_savings.as_dict(),
+            "detail": dict(sorted(self.detail.items())),
+        }
+
+    def __eq__(self, other):
+        return isinstance(other, Recommendation) and (
+            self.target.identity, self.action
+        ) == (other.target.identity, other.action)
+
+    def __hash__(self):
+        return hash((self.target.identity, self.action))
+
+    def __repr__(self):
+        return "<Recommendation %s %s save=%s>" % (
+            self.action, self.resource_id, self.monthly_savings,
+        )
