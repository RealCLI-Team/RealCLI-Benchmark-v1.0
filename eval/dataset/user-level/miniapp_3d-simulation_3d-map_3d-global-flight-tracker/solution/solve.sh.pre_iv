#!/usr/bin/env bash
# Oracle: write a minimal valid frontend artifact so the render smoke test in
# tests/test.sh yields reward 1. Calibrates the op run of the non-op/op check.
set -euo pipefail
WORKSPACE="/3D-Global-Flight-Tracker"
mkdir -p "$WORKSPACE"
cat > "$WORKSPACE/index.html" <<'__HTML__'
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Oracle Artifact</title></head>
<body>
  <h1>Oracle render artifact</h1>
  <p>This dummy frontend exists to calibrate the render smoke test.</p>
  <canvas id="c" width="320" height="240"></canvas>
  <script>const ctx=document.getElementById('c').getContext('2d');ctx.fillRect(8,8,64,64);</script>
</body></html>
__HTML__
echo "oracle: wrote $WORKSPACE/index.html"
