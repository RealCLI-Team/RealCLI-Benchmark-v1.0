+def test_button_click_rerun_semantics():
+    script = """
+import streamlit as st
+if st.button("press"):
+    st.write("clicked")
+else:
+    st.write("not clicked")
+"""
+    at = AppTest.from_string(script)
+    at.run()
+    assert at.button[0].value is False
+    assert at.markdown[0].value == "not clicked"
+
+    at.button[0].click().run()
+    # the script observes the click during that run ...
+    assert at.markdown[0].value == "clicked"
+    # ... but the trigger value resets once the run completes
+    assert at.button[0].value is False
+
+    at.run()
+    assert at.markdown[0].value == "not clicked"
