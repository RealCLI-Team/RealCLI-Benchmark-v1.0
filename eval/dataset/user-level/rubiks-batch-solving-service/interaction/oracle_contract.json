{
  "schema_version": "oracle_contract_v1",
  "source_files": ["instruction.md", "tests/test.sh"],
  "requirements": [
    {
      "id": "result_file_exists",
      "verifier_assertion": "result.json must exist at /app/result.json",
      "script_refs": ["opening", "cli_args"],
      "must_include": ["/app/result.json", "--output"],
      "forbidden_anywhere": []
    },
    {
      "id": "results_top_level_key",
      "verifier_assertion": "result.json must have a top-level 'results' key with a list value",
      "script_refs": ["output_toplevel"],
      "must_include": ["results"],
      "forbidden_anywhere": []
    },
    {
      "id": "sorted_by_id_ascending",
      "verifier_assertion": "results list must be sorted by id in ascending lexicographic order",
      "script_refs": ["sorting_rule"],
      "must_include": ["sorted by id", "ascending", "lexicographic"],
      "forbidden_anywhere": []
    },
    {
      "id": "no_duplicate_ids_in_output",
      "verifier_assertion": "no duplicate id may appear more than once in results",
      "script_refs": ["sorting_rule", "duplicate_rule"],
      "must_include": ["exactly once"],
      "forbidden_anywhere": []
    },
    {
      "id": "result_ids_match_input",
      "verifier_assertion": "result ids must match the set of unique input ids exactly",
      "script_refs": ["sorting_rule", "duplicate_rule"],
      "must_include": ["each id"],
      "forbidden_anywhere": []
    },
    {
      "id": "status_already_solved",
      "verifier_assertion": "already_solved records must have moves=[] and move_count=0; state must equal solved string",
      "script_refs": ["already_solved_rule", "solved_state"],
      "must_include": ["already_solved", "empty list", "move_count 0", "UUUUUUUUURRRRRRRRRFFFFFFFFFDDDDDDDDDLLLLLLLLLBBBBBBBBB"],
      "forbidden_anywhere": []
    },
    {
      "id": "status_invalid",
      "verifier_assertion": "invalid records must have moves=null and move_count=0; invalid defined by length!=54, chars outside URFDLB, or color counts!=9",
      "script_refs": ["invalid_rule"],
      "must_include": ["invalid", "null", "move_count=0", "54", "U R F D L B", "9 times"],
      "forbidden_anywhere": []
    },
    {
      "id": "status_solved_moves_valid",
      "verifier_assertion": "solved records must have non-empty moves list of legal tokens, move_count=len(moves)",
      "script_refs": ["solved_rule", "move_tokens"],
      "must_include": ["non-empty", "legal move tokens", "move_count"],
      "forbidden_anywhere": []
    },
    {
      "id": "moves_restore_solved",
      "verifier_assertion": "applying the moves sequence to the input state must produce the solved state",
      "script_refs": ["solved_rule"],
      "must_include": ["restores the solved state"],
      "forbidden_anywhere": []
    },
    {
      "id": "legal_move_tokens_only",
      "verifier_assertion": "every emitted move token must be one of the 18 legal tokens",
      "script_refs": ["move_tokens"],
      "must_include": ["U", "U'", "U2", "R", "R'", "R2", "F", "F'", "F2", "D", "D'", "D2", "L", "L'", "L2", "B", "B'", "B2"],
      "forbidden_anywhere": []
    },
    {
      "id": "fixture_coverage",
      "verifier_assertion": "fixture must exercise at least one solved, one already_solved, and one invalid outcome",
      "script_refs": ["status_values", "already_solved_rule", "invalid_rule", "solved_rule"],
      "must_include": ["solved", "already_solved", "invalid"],
      "forbidden_anywhere": []
    },
    {
      "id": "duplicate_id_collapse",
      "verifier_assertion": "duplicate id (same id on multiple lines) collapses to single invalid record with moves=null, move_count=0",
      "script_refs": ["duplicate_rule"],
      "must_include": ["same id", "conflict", "invalid", "null", "move_count=0"],
      "forbidden_anywhere": []
    },
    {
      "id": "generalization_test",
      "verifier_assertion": "solution.py must correctly solve freshly generated scrambles (seed 4242), not just the shipped data",
      "script_refs": ["opening", "solved_rule", "cli_args"],
      "must_include": ["--input", "--output"],
      "forbidden_anywhere": []
    },
    {
      "id": "near_duplicate_independence",
      "verifier_assertion": "cube-04 and cube-05 must be solved independently (different states, different move sequences)",
      "script_refs": ["solved_rule"],
      "must_include": ["restores the solved state"],
      "forbidden_anywhere": []
    },
    {
      "id": "record_fields_complete",
      "verifier_assertion": "each result record must contain id, status, moves, and move_count fields",
      "script_refs": ["record_fields"],
      "must_include": ["id", "status", "moves", "move_count"],
      "forbidden_anywhere": []
    },
    {
      "id": "cli_interface",
      "verifier_assertion": "solution.py must accept --input and --output command-line arguments",
      "script_refs": ["cli_args"],
      "must_include": ["--input", "--output"],
      "forbidden_anywhere": []
    },
    {
      "id": "facelet_convention",
      "verifier_assertion": "cube states are 54-char strings with face order URFDLB, 9 chars each",
      "script_refs": ["facelet_string"],
      "must_include": ["54", "U R F D L B", "9"],
      "forbidden_anywhere": []
    },
    {
      "id": "move_semantics",
      "verifier_assertion": "move modifiers: no modifier=CW 90, '=CCW 90, 2=180",
      "script_refs": ["move_modifiers"],
      "must_include": ["clockwise", "counter-clockwise", "180"],
      "forbidden_anywhere": []
    }
  ]
}
