+class TestConfiguredVarRecording:
+    """ConfiguredVar records the resolved value of each referenced var into
+    the SchemaYamlVars collector, following cli > project > default
+    precedence."""
+
+    def _make_config(self, project_vars, cli_vars):
+        from types import SimpleNamespace
+
+        class _Vars:
+            def __init__(self, values):
+                self._values = values
+
+            def vars_for(self, lookup, adapter_type):
+                return self._values
+
+        project = SimpleNamespace(project_name="test", vars=_Vars(project_vars))
+        return SimpleNamespace(
+            project_name="test",
+            cli_vars=cli_vars,
+            credentials=SimpleNamespace(type="duckdb"),
+            vars=_Vars(project_vars),
+            load_dependencies=lambda: {"test": project},
+        )
+
+    def _make_var(self, project_vars, cli_vars, schema_yaml_vars):
+        from dbt.context.base import BaseContext
+        from dbt.context.configured import ConfiguredVar
+
+        context = BaseContext(cli_vars)
+        return ConfiguredVar(
+            context, self._make_config(project_vars, cli_vars), "test", schema_yaml_vars
+        )
+
+    def test_records_project_var(self):
+        from dbt.context.configured import SchemaYamlVars
+
+        collector = SchemaYamlVars()
+        var = self._make_var({"a": 1}, {}, collector)
+        assert var("a") == 1
+        assert collector.vars == {"a": 1}
+
+    def test_cli_var_wins_and_is_recorded(self):
+        from dbt.context.configured import SchemaYamlVars
+
+        collector = SchemaYamlVars()
+        var = self._make_var({"a": 1}, {"a": 99}, collector)
+        assert var("a") == 99
+        assert collector.vars == {"a": 99}
+
+    def test_default_is_recorded_for_undefined_var(self):
+        from dbt.context.configured import SchemaYamlVars
+
+        collector = SchemaYamlVars()
+        var = self._make_var({}, {}, collector)
+        assert var("missing", "fallback") == "fallback"
+        assert collector.vars == {"missing": "fallback"}
+
+    def test_missing_var_without_default_raises(self):
+        from dbt.context.configured import SchemaYamlVars
+        from dbt.exceptions import RequiredVarNotFoundError
+
+        collector = SchemaYamlVars()
+        var = self._make_var({}, {}, collector)
+        with pytest.raises(RequiredVarNotFoundError):
+            var("missing")
+        # nothing recorded for an unresolvable var
+        assert collector.vars == {}
+
+    def test_no_collector_no_recording(self):
+        var = self._make_var({"a": 1}, {}, None)
+        # must not raise even though there is no collector attached
+        assert var("a") == 1
+
