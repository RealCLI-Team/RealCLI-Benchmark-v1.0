+    def test_same_vars_is_plain_dict_equality(self, model_node):
+        other = replace(model_node, vars={"a": [1, 2], "b": {"c": "d"}})
+        node = replace(model_node, vars={"b": {"c": "d"}, "a": [1, 2]})
+        assert node.same_vars(other) is True
