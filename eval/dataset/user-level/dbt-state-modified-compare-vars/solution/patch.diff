+class TestParseVarRecording:
+    """ParseVar records the resolved value of each var referenced at parse
+    time onto the node being parsed."""
+
+    def _make_config(self, project_vars, cli_vars):
+        from types import SimpleNamespace
+
+        class _Vars:
+            def __init__(self, values):
+                self._values = values
+
+            def vars_for(self, node, adapter_type):
+                return self._values
+
+        project = SimpleNamespace(project_name="test", vars=_Vars(project_vars))
+        return SimpleNamespace(
+            project_name="test",
+            cli_vars=cli_vars,
+            credentials=SimpleNamespace(type="duckdb"),
+            vars=_Vars(project_vars),
+            load_dependencies=lambda: {"test": project},
+        )
+
+    def _make_parse_var(self, node, project_vars, cli_vars=None):
+        from dbt.context.base import BaseContext
+        from dbt.context.providers import ParseVar
+
+        context = BaseContext(cli_vars or {})
+        return ParseVar(context, self._make_config(project_vars, cli_vars or {}), node)
+
+    def test_records_resolved_value_on_node(self):
+        from types import SimpleNamespace
+
+        node = SimpleNamespace(name="m", package_name="test", vars={})
+        var = self._make_parse_var(node, {"a": 1})
+        assert var("a") == 1
+        assert node.vars == {"a": 1}
+
+    def test_records_default_for_undefined_var(self):
+        from types import SimpleNamespace
+
+        node = SimpleNamespace(name="m", package_name="test", vars={})
+        var = self._make_parse_var(node, {})
+        assert var("missing", "dflt") == "dflt"
+        assert node.vars == {"missing": "dflt"}
+
+    def test_records_none_for_missing_var_at_parse(self):
+        from types import SimpleNamespace
+
+        node = SimpleNamespace(name="m", package_name="test", vars={})
+        var = self._make_parse_var(node, {})
+        # at parse time a missing var without default resolves to None
+        assert var("missing") is None
+        assert node.vars == {"missing": None}
+
+    def test_cli_value_recorded_over_project_value(self):
+        from types import SimpleNamespace
+
+        node = SimpleNamespace(name="m", package_name="test", vars={})
+        var = self._make_parse_var(node, {"a": 1}, {"a": 5})
+        assert var("a") == 5
