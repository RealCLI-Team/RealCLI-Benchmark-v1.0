@@ -0,0 +1,782 @@
+"""Unit tests for var-aware state comparison (state:modified + the
+state_modified_compare_vars behavior flag)."""
+from argparse import Namespace
+from dataclasses import replace
+
+import pytest
+
+from dbt.artifacts.resources import ExposureType, Owner, Quoting, SourceConfig
+from dbt.contracts.files import FileHash, SchemaSourceFile
+from dbt.contracts.graph.nodes import Exposure, ModelNode, SourceDefinition
+from dbt.flags import set_from_args
+from dbt.node_types import NodeType
+from tests.unit.fixtures import model_node as make_model_node
+
+
+@pytest.fixture
+def model_node():
+    return make_model_node()
+
+
+@pytest.fixture
+def args_for_flags() -> Namespace:
+    return Namespace(
+        state_modified_compare_more_unrendered_values=False,
+        state_modified_compare_vars=False,
+    )
+
+
+def enable_compare_vars():
+    set_from_args(
+        Namespace(
+            state_modified_compare_more_unrendered_values=False,
+            state_modified_compare_vars=True,
+        ),
+        {},
+    )
+
+
+def disable_compare_vars():
+    set_from_args(
+        Namespace(
+            state_modified_compare_more_unrendered_values=False,
+            state_modified_compare_vars=False,
+        ),
+        {},
+    )
+
+
+@pytest.fixture
+def source_definition():
+    return SourceDefinition(
+        columns={},
+        database="some_db",
+        description="",
+        fqn=["test", "source", "my_source", "my_source_table"],
+        identifier="my_source_table",
+        loader="stitch",
+        name="my_source_table",
+        original_file_path="/root/models/sources.yml",
+        package_name="test",
+        path="/root/models/sources.yml",
+        quoting=Quoting(),
+        resource_type=NodeType.Source,
+        schema="my_source",
+        source_description="",
+        source_name="my_source",
+        source_meta={},
+        tags=[],
+        config=SourceConfig(),
+        patch_path=None,
+        unrendered_config={},
+        relation_name=None,
+        unique_id="source.test.my_source.my_source_table",
+    )
+
+
+@pytest.fixture
+def exposure():
+    return Exposure(
+        name="my_exposure",
+        resource_type=NodeType.Exposure,
+        type=ExposureType.Notebook,
+        fqn=["test", "exposures", "my_exposure"],
+        unique_id="exposure.test.my_exposure",
+        package_name="test",
+        path="models/something.yml",
+        original_file_path="models/something.yml",
+        description="",
+        owner=Owner(email="test@example.com"),
+    )
+
+
+class TestModelSameVars:
+    def test_same_vars_equal(self, model_node):  # noqa F811
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"a": 1})
+        assert node.same_vars(other) is True
+
+    def test_same_vars_different_value(self, model_node):  # noqa F811
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"a": 2})
+        assert node.same_vars(other) is False
+
+    def test_same_vars_different_keys(self, model_node):  # noqa F811
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"b": 1})
+        assert node.same_vars(other) is False
+
+    def test_same_vars_missing_on_old(self, model_node):  # noqa F811
+        # manifests written before vars were tracked deserialize with {}
+        other = replace(model_node, vars={})
+        node = replace(model_node, vars={"a": 1})
+        assert node.same_vars(other) is False
+
+    def test_same_contents_flag_off_ignores_vars(self, model_node):  # noqa F811
+        disable_compare_vars()
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"a": 2})
+        assert node.same_contents(other, "postgres") is True
+
+    def test_same_contents_flag_on_detects_vars(self, model_node):  # noqa F811
+        enable_compare_vars()
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"a": 2})
+        assert node.same_contents(other, "postgres") is False
+
+    def test_same_contents_flag_on_same_vars(self, model_node):  # noqa F811
+        enable_compare_vars()
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"a": 1})
+        assert node.same_contents(other, "postgres") is True
+
+    def test_same_contents_flag_on_no_vars_anywhere(self, model_node):  # noqa F811
+        enable_compare_vars()
+        other = replace(model_node, vars={})
+        node = replace(model_node, vars={})
+        assert node.same_contents(other, "postgres") is True
+
+
+class TestSourceSameVars:
+    def test_same_vars(self, source_definition):
+        other = replace(source_definition, vars={"a": 1})
+        node = replace(source_definition, vars={"a": 2})
+        assert node.same_vars(other) is False
+        assert node.same_vars(replace(other, vars={"a": 2})) is True
+
+    def test_same_contents_flag_off_ignores_vars(self, source_definition):
+        disable_compare_vars()
+        other = replace(source_definition, vars={"a": 1})
+        node = replace(source_definition, vars={"a": 2})
+        assert node.same_contents(other) is True
+
+    def test_same_contents_flag_on_detects_vars(self, source_definition):
+        enable_compare_vars()
+        other = replace(source_definition, vars={"a": 1})
+        node = replace(source_definition, vars={"a": 2})
+        assert node.same_contents(other) is False
+
+    def test_same_contents_flag_on_same_vars(self, source_definition):
+        enable_compare_vars()
+        other = replace(source_definition, vars={"a": 1})
+        node = replace(source_definition, vars={"a": 1})
+        assert node.same_contents(other) is True
+
+
+class TestExposureSameVars:
+    def test_same_vars(self, exposure):
+        other = replace(exposure, vars={"a": 1})
+        node = replace(exposure, vars={"a": 2})
+        assert node.same_vars(other) is False
+        assert node.same_vars(replace(other, vars={"a": 2})) is True
+
+    def test_same_contents_flag_off_ignores_vars(self, exposure):
+        disable_compare_vars()
+        other = replace(exposure, vars={"a": 1})
+        node = replace(exposure, vars={"a": 2})
+        assert node.same_contents(other) is True
+
+    def test_same_contents_flag_on_detects_vars(self, exposure):
+        enable_compare_vars()
+        other = replace(exposure, vars={"a": 1})
+        node = replace(exposure, vars={"a": 2})
+        assert node.same_contents(other) is False
+
+    def test_same_contents_flag_on_same_vars(self, exposure):
+        enable_compare_vars()
+        other = replace(exposure, vars={"a": 1})
+        node = replace(exposure, vars={"a": 1})
+        assert node.same_contents(other) is True
+
+
+def _schema_file() -> SchemaSourceFile:
+    return SchemaSourceFile(
+        path=_make_file_path(),
+        checksum=FileHash.from_contents(""),
+        project_name="test",
+    )
+
+
+def _make_file_path():
+    from dbt.contracts.files import FilePath
+
+    return FilePath(
+        searched_path="models",
+        relative_path="schema.yml",
+        modification_time=0.0,
+        project_root="/root",
+    )
+
+
+class TestSchemaSourceFileVars:
+    def test_add_and_get_vars(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1, "b": "x"}, "models", "my_model")
+        assert schema_file.get_vars("models", "my_model") == {"a": 1, "b": "x"}
+
+    def test_get_vars_missing_key(self):
+        schema_file = _schema_file()
+        assert schema_file.get_vars("models", "my_model") == {}
+
+    def test_get_vars_missing_name(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1}, "models", "my_model")
+        assert schema_file.get_vars("models", "other_model") == {}
+
+    def test_add_vars_overwrites_on_reparse(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1}, "models", "my_model")
+        schema_file.add_vars({"a": 2}, "models", "my_model")
+        assert schema_file.get_vars("models", "my_model") == {"a": 2}
+
+    def test_add_vars_keys_are_isolated(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1}, "models", "my_model")
+        schema_file.add_vars({"b": 2}, "sources", "my_source")
+        assert schema_file.get_vars("models", "my_model") == {"a": 1}
+        assert schema_file.get_vars("sources", "my_source") == {"b": 2}
+
+    def test_add_vars_copies_input(self):
+        schema_file = _schema_file()
+        recorded = {"a": 1}
+        schema_file.add_vars(recorded, "models", "my_model")
+        recorded["a"] = 999
+        assert schema_file.get_vars("models", "my_model") == {"a": 1}
+
+    def test_delete_from_vars(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1}, "models", "my_model")
+        schema_file.add_vars({"a": 1}, "models", "other_model")
+        schema_file.delete_from_vars("models", "my_model")
+        assert schema_file.get_vars("models", "my_model") == {}
+        assert schema_file.get_vars("models", "other_model") == {"a": 1}
+
+    def test_delete_from_vars_cleans_up_empty_key(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1}, "models", "my_model")
+        schema_file.delete_from_vars("models", "my_model")
+        assert "models" not in schema_file.vars
+
+    def test_delete_from_vars_noop_when_missing(self):
+        schema_file = _schema_file()
+        # must not raise
+        schema_file.delete_from_vars("models", "my_model")
+
+    def test_vars_roundtrip_serialization(self):
+        schema_file = _schema_file()
+        schema_file.add_vars({"a": 1}, "models", "my_model")
