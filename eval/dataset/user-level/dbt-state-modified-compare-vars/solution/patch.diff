+    def _factory(self):
+        from dbt.graph.selector_methods import StateSelectorMethod
+
+        return StateSelectorMethod.check_modified_factory("same_vars")
+
+    def _node(self, vars_value):
+        from unittest.mock import MagicMock
+
+        node = MagicMock()
+        node.same_vars = lambda old: vars_value == old.vars
+        node.vars = vars_value
+        return node
+
+    def test_new_node_is_modified(self):
+        factory = self._factory()
+        assert factory(None, self._node({"a": 1})) is True
+
+    def test_same_vars_is_not_modified(self):
+        factory = self._factory()
+        old = self._node({"a": 1})
+        new = self._node({"a": 1})
+        assert factory(old, new) is False
+
+    def test_different_vars_is_modified(self):
+        factory = self._factory()
+        old = self._node({"a": 1})
+        new = self._node({"a": 2})
+        assert factory(old, new) is True
+
+    def test_resource_without_same_vars_is_skipped(self):
+        factory = self._factory()
+        old = self._node({"a": 1})
+
+        class NoVars:
+            pass
+
+        assert factory(old, NoVars()) is False
