+import pytest
+
+from dbt.tests.util import run_dbt, update_config_file
+from tests.functional.defer_state.test_modified_state import BaseModifiedState
+
+
+class TestCompareVarsFlagOff(BaseModifiedState):
+    """With state_modified_compare_vars disabled (the default), changing the
+    value of a var must not produce any state:modified selection, preserving
+    the legacy behaviour."""
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": False,
+            },
+            "vars": {"my_var": 1},
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "model_with_var.sql": "select {{ var('my_var') }} as id",
+        }
+
+    def test_changed_vars_not_detected(self, project):
+        run_dbt(["run"])
+        self.copy_state()
+
+        # No var change -> no false positive
+        assert not run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+
+        # Modify var (my_var: 1 -> 2) -> still nothing, flag is off
+        update_config_file({"vars": {"my_var": 2}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == []
+
+        # Same for CLI-provided vars
+        assert (
+            run_dbt(
+                ["list", "--vars", '{"my_var": 3}', "-s", "state:modified", "--state", "./state"]
+            )
+            == []
+        )
+
+
+class TestCompareVarsModelBody(BaseModifiedState):
+    """A var referenced from a model's sql body participates in
+    state:modified when the flag is enabled."""
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+            "vars": {"my_var": 1, "unrelated_var": "a"},
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "model_with_var.sql": "select {{ var('my_var') }} as id",
+            "model_without_var.sql": "select 2 as id",
+        }
+
+    def test_changed_vars(self, project):
+        run_dbt(["run"])
+        self.copy_state()
+
+        # No var change -> no false positive
+        assert not run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+
+        # Modify var via dbt_project.yml (my_var: 1 -> 2)
+        update_config_file({"vars": {"my_var": 2, "unrelated_var": "a"}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_with_var"
+        ]
+        # The var change is not a body change, nor an unrendered config change
+        assert not run_dbt(["list", "-s", "state:modified.body", "--state", "./state"])
+        assert not run_dbt(["list", "-s", "state:modified.configs", "--state", "./state"])
+        # The granular state:modified.vars selector picks the model as well
+        assert run_dbt(["list", "-s", "state:modified.vars", "--state", "./state"]) == [
+            "test.model_with_var"
+        ]
+
+        # Reset dbt_project.yml
+        update_config_file({"vars": {"my_var": 1, "unrelated_var": "a"}}, "dbt_project.yml")
+
+        # Modify var via the --vars CLI flag
+        assert not run_dbt(
+            ["list", "--vars", '{"my_var": 1}', "-s", "state:modified", "--state", "./state"]
+        )
+        assert run_dbt(
+            ["list", "--vars", '{"my_var": 2}', "-s", "state:modified", "--state", "./state"]
+        ) == ["test.model_with_var"]
+
+    def test_unrelated_var_change_selects_nothing(self, project):
+        run_dbt(["run"])
+        self.copy_state()
+
+        # Only unrelated_var changes; nothing references it
+        update_config_file({"vars": {"my_var": 1, "unrelated_var": "b"}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == []
+
+
+class TestCompareVarsModelConfig(BaseModifiedState):
+    """A var referenced from an in-file config() call participates in
+    state:modified when the flag is enabled, even though the unrendered
+    config (and therefore state:modified.configs) is unchanged."""
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+            "vars": {"my_materialization": "table"},
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "model_with_config_var.sql": (
+                "{{ config(materialized=var('my_materialization')) }}\nselect 1 as id"
+            ),
+        }
+
+    def test_changed_config_var(self, project):
+        run_dbt(["run"])
+        self.copy_state()
+
+        assert not run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+
+        # Modify var (my_materialization: table -> view)
+        update_config_file({"vars": {"my_materialization": "view"}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_with_config_var"
+        ]
+        assert not run_dbt(["list", "-s", "state:modified.configs", "--state", "./state"])
+
+
+schema_yml_with_vars = """
+version: 2
+
+models:
+  - name: model_patched
+    config:
+      meta:
+        region: "{{ var('region') }}"
+
+exposures:
+  - name: exposure_with_var
+    type: dashboard
+    owner:
+      name: "{{ var('owner_name') }}"
+    depends_on:
+      - ref('model_patched')
+
+sources:
+  - name: source_with_var
+    schema: analytics
+    meta:
+      dataset: "{{ var('dataset') }}"
+    tables:
+      - name: events
+      - name: orders
+"""
+
+
+class TestCompareVarsSchemaYml(BaseModifiedState):
+    """Vars referenced from schema.yml entries (model patches, exposures,
+    sources) participate in state:modified when the flag is enabled."""
+
+    original_vars = {"region": "emea", "owner_name": "alice", "dataset": "raw_v1"}
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+            "vars": dict(self.original_vars),
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "model_patched.sql": "select 1 as id",
+            "schema.yml": schema_yml_with_vars,
+        }
+
+    def reset_vars_and_save_state(self):
+        # restore the original var values so each test starts from a known
+        # baseline regardless of what previous tests left behind
+        update_config_file({"vars": dict(self.original_vars)}, "dbt_project.yml")
+        run_dbt(["run"])
+        self.copy_state()
+
+    def test_model_patch_var(self, project):
+        self.reset_vars_and_save_state()
+
+        assert not run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+
+        new_vars = dict(self.original_vars)
+        new_vars["region"] = "apac"
+        update_config_file({"vars": new_vars}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_patched"
+        ]
+
+    def test_exposure_var(self, project):
+        self.reset_vars_and_save_state()
+
+        new_vars = dict(self.original_vars)
+        new_vars["owner_name"] = "bob"
+        update_config_file({"vars": new_vars}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "exposure:test.exposure_with_var"
+        ]
+
+    def test_source_var(self, project):
+        self.reset_vars_and_save_state()
+
+        new_vars = dict(self.original_vars)
+        new_vars["dataset"] = "raw_v2"
+        update_config_file({"vars": new_vars}, "dbt_project.yml")
+        assert sorted(run_dbt(["list", "-s", "state:modified", "--state", "./state"])) == sorted(
+            [
+                "source:test.source_with_var.events",
+                "source:test.source_with_var.orders",
+            ]
+        )
+
+
+singular_test_with_var_sql = """
+select * from {{ ref('model_a') }} where 1 = {{ var('test_knob', 1) }}
+"""
+
+
+class TestCompareVarsSingularTest(BaseModifiedState):
