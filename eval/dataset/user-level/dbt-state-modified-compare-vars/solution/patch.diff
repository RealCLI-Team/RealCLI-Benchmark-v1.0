+class TestVarsComparisonValueSemantics:
+    """Equality is by resolved value, not by how the value was produced."""
+
+    def test_int_vs_string_is_different(self, model_node):
+        other = replace(model_node, vars={"a": 1})
+        node = replace(model_node, vars={"a": "1"})
+        enable_compare_vars()
+        assert node.same_contents(other, "postgres") is False
