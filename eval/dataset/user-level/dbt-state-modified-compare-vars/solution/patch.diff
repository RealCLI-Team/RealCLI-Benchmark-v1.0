+        new_vars["dataset"] = "raw_v2"
+        update_config_file({"vars": new_vars}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "source:test.gov_src.events"
+        ]
+
+
+class TestCompareVarsDefaultTransitions(BaseModifiedState):
+    """Resolved-value semantics: what matters is the value a var resolves
+    to, not where it is defined. Defining a var with the same value as the
+    in-code default is a no-op; defining it with a different value (or
+    changing an undefined var's resolution from None) is a change."""
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "model_with_default.sql": "select {{ var('maybe_defined', 10) }} as id",
+        }
+
+    def test_define_var_with_default_value_is_noop(self, project):
+        run_dbt(["run"])
+        self.copy_state()
+
+        update_config_file({"vars": {"maybe_defined": 10}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == []
+
+    def test_define_var_with_other_value_is_change(self, project):
+        # make sure the project is back to baseline (no vars defined)
+        update_config_file({"vars": {}}, "dbt_project.yml")
+        run_dbt(["run"])
+        self.copy_state()
+
+        update_config_file({"vars": {"maybe_defined": 20}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_with_default"
+        ]
+
+    def test_remove_var_definition_is_change(self, project):
+        update_config_file({"vars": {"maybe_defined": 20}}, "dbt_project.yml")
+        run_dbt(["run"])
+        self.copy_state()
+
+        update_config_file({"vars": {}}, "dbt_project.yml")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_with_default"
+        ]
+
+
+class TestCompareVarsUnmodifiedComplementSourcesExposures(BaseModifiedState):
+    """The complement selector keeps working for non-model resources:
+    changing a source's var drops it from state:unmodified but leaves the
+    exposure untouched."""
+
+    original_vars = {"dataset": "raw_v1", "owner": "alice"}
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+            "vars": dict(self.original_vars),
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "m_plain.sql": "select 1 as id",
+            "schema.yml": """
+version: 2
+
+sources:
+  - name: gov_src
+    meta:
+      dataset: "{{ var('dataset') }}"
+    tables:
+      - name: events
+
+exposures:
+  - name: gov_exp
+    type: dashboard
+    owner:
+      name: "{{ var('owner') }}"
+    depends_on:
+      - ref('m_plain')
+""",
+        }
+
+    def test_unmodified_complement(self, project):
+        run_dbt(["run"])
+        self.copy_state()
+
+        new_vars = dict(self.original_vars)
+        new_vars["dataset"] = "raw_v2"
+        update_config_file({"vars": new_vars}, "dbt_project.yml")
+
+        modified = run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+        assert modified == ["source:test.gov_src.events"]
+
+        unmodified = run_dbt(["list", "-s", "state:unmodified", "--state", "./state"])
+        assert "exposure:test.gov_exp" in unmodified
+        assert "test.m_plain" in unmodified
+        assert "source:test.gov_src.events" not in unmodified
+
+
+class TestCompareVarsMacroFileRegression(BaseModifiedState):
+    """Recording vars must not weaken the pre-existing change detection:
+    editing a macro's implementation still marks dependents as modified via
+    state:modified.macros, with and without the flag."""
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+            "vars": {"my_var": 1},
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "model_uses_macro.sql": "select {{ my_macro() }} as id",
+        }
+
+    @pytest.fixture(scope="class")
+    def macros(self):
+        return {
+            "my_macro.sql": "{% macro my_macro() %} 1 {% endmacro %}",
+        }
+
+    def test_macro_edit_still_detected(self, project):
+        from dbt.tests.util import write_file
+
+        run_dbt(["run"])
+        self.copy_state()
+
+        assert not run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+
+        # edit the macro implementation, vars untouched
+        write_file("{% macro my_macro() %} 2 {% endmacro %}", "macros", "my_macro.sql")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_uses_macro"
+        ]
+        assert run_dbt(["list", "-s", "state:modified.macros", "--state", "./state"]) == [
+            "test.model_uses_macro"
+        ]
+        # no var changed, so the vars sub-selector stays empty
+        assert not run_dbt(["list", "-s", "state:modified.vars", "--state", "./state"])
+
+    def test_body_edit_still_detected(self, project):
+        from dbt.tests.util import write_file
+
+        run_dbt(["run"])
+        self.copy_state()
+
+        # edit the model body, vars untouched
+        write_file("select {{ my_macro() }} as id, 2 as extra", "models", "model_uses_macro.sql")
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.model_uses_macro"
+        ]
+        assert run_dbt(["list", "-s", "state:modified.body", "--state", "./state"]) == [
+            "test.model_uses_macro"
+        ]
+
+
+class TestCompareVarsGranularVarsSelector(BaseModifiedState):
+    """The state:modified.vars sub-selector isolates var-driven changes from
+    other change kinds, for models as well as sources and exposures."""
+
+    original_vars = {"threshold": 100, "owner": "alice", "dataset": "raw_v1"}
+
+    @pytest.fixture(scope="class")
+    def project_config_update(self):
+        return {
+            "flags": {
+                "state_modified_compare_vars": True,
+            },
+            "vars": dict(self.original_vars),
+        }
+
+    @pytest.fixture(scope="class")
+    def models(self):
+        return {
+            "m_body.sql": "select {{ var('threshold') }} as threshold",
+            "m_plain.sql": "select 3 as id",
+            "schema.yml": """
+version: 2
+
+sources:
+  - name: gov_src
+    meta:
+      dataset: "{{ var('dataset') }}"
+    tables:
+      - name: events
+
+exposures:
+  - name: gov_exp
+    type: dashboard
+    owner:
+      name: "{{ var('owner') }}"
+    depends_on:
+      - ref('m_plain')
+""",
+        }
+
+    def reset_and_baseline(self):
+        update_config_file({"vars": dict(self.original_vars)}, "dbt_project.yml")
+        run_dbt(["run"])
+        self.copy_state()
+
+    def test_vars_selector_across_resource_kinds(self, project):
+        self.reset_and_baseline()
+
+        new_vars = dict(self.original_vars)
+        new_vars["threshold"] = 200
+        new_vars["dataset"] = "raw_v2"
+        new_vars["owner"] = "bob"
+        update_config_file({"vars": new_vars}, "dbt_project.yml")
+
+        assert sorted(run_dbt(["list", "-s", "state:modified.vars", "--state", "./state"])) == [
+            "exposure:test.gov_exp",
+            "source:test.gov_src.events",
+            "test.m_body",
+        ]
+        # m_plain did not reference any changed var
+        assert "test.m_plain" in run_dbt(
+            ["list", "-s", "state:unmodified", "--state", "./state"]
+        )
+
+    def test_vars_selector_ignores_code_changes(self, project):
+        from dbt.tests.util import write_file
+
+        self.reset_and_baseline()
+
+        # a pure code change is not a vars change
+        write_file("select {{ var('threshold') }} as threshold, 99 as extra", "models", "m_body.sql")
+        assert run_dbt(["list", "-s", "state:modified.vars", "--state", "./state"]) == []
+        assert run_dbt(["list", "-s", "state:modified", "--state", "./state"]) == [
+            "test.m_body"
+        ]
