+class TestVarsRecordingDeterminism:
+    """Recording must be deterministic across equivalent parses, otherwise
+    every state comparison would be a false positive."""
+
+    def test_dict_order_does_not_matter_for_equality(self):
+        assert {"a": 1, "b": 2} == {"b": 2, "a": 1}
