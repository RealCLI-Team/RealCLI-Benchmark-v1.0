+        return {
+            "model_with_var.sql": "select {{ var('my_var') }} as id",
+        }
+
+    def test_partial_parse_stability(self, project):
+        run_dbt(["parse"])
+        self.copy_state()
+
+        # warm the partial parse cache with an identical parse
+        run_dbt(["parse"])
+        assert not run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+
+        # a CLI var change invalidates the cache and is detected
+        assert run_dbt(
+            ["list", "--vars", '{"my_var": 2}', "-s", "state:modified", "--state", "./state"]
+        ) == ["test.model_with_var"]
