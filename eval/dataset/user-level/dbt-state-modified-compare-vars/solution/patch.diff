+    def test_old_manifest_without_vars(self, project):
+        import json
+
+        run_dbt(["run"])
+        self.copy_state()
+
+        # simulate a manifest written by an older dbt: strip all recorded vars
+        with open("state/manifest.json") as fp:
+            manifest_dict = json.load(fp)
+        for key in ("nodes", "sources", "exposures", "disabled"):
+            for entry in manifest_dict.get(key, {}).values():
+                if isinstance(entry, dict):
+                    entry.pop("vars", None)
+        with open("state/manifest.json", "w") as fp:
+            json.dump(manifest_dict, fp)
+
+        # must not error; the model referencing a var compares as changed,
+        # the model without vars is still unmodified
+        results = run_dbt(["list", "-s", "state:modified", "--state", "./state"])
+        assert results == ["test.model_with_var"]
