+def test_config_pd_read_excel_kwargs_forwarding():
+    config = ExcelConfig(
+        sheet_name="data",
+        header=2,
+        skiprows=3,
+        nrows=100,
+        na_values=["unknown"],
+        keep_default_na=False,
+        usecols=["a", "b"],
+        engine="openpyxl",
+    )
+    kwargs = config.pd_read_excel_kwargs
+    assert kwargs["sheet_name"] == "data"
+    assert kwargs["header"] == 2
+    assert kwargs["skiprows"] == 3
+    assert kwargs["nrows"] == 100
+    assert kwargs["na_values"] == ["unknown"]
+    assert kwargs["keep_default_na"] is False
+    assert kwargs["usecols"] == ["a", "b"]
+    assert kwargs["engine"] == "openpyxl"
