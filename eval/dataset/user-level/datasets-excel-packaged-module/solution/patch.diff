+from dataclasses import dataclass
+from typing import Any, Callable, Optional, Union
+
+import pandas as pd
+import pyarrow as pa
+
+import datasets
+import datasets.config
+from datasets.builder import Key
+from datasets.features.features import require_storage_cast
+from datasets.table import table_cast
+
+
+logger = datasets.utils.logging.get_logger(__name__)
+
+# Parameters of `pandas.read_excel` that must not be passed explicitly when they
+# are left at their default value, either because they have no default value in
+# the pandas signature or because passing them changes the parsing behaviour.
+_PANDAS_READ_EXCEL_NO_DEFAULT_PARAMETERS = ["names", "converters", "true_values", "false_values", "na_values"]
+
+# Parameters of `pandas.read_excel` that this config forwards when they are set.
+# Keep this list in sync with the signature of `pandas.read_excel` for the
+# supported pandas versions (2.x). Note that we cannot introspect the signature
+# at runtime because `datasets.streaming` monkeypatches `pandas.read_excel`
+# with a generic `(*args, **kwargs)` wrapper.
+_PANDAS_READ_EXCEL_SUPPORTED_PARAMETERS = [
+    "sheet_name",
+    "header",
+    "names",
+    "index_col",
+    "usecols",
+    "skiprows",
+    "nrows",
+    "na_values",
+    "keep_default_na",
+    "na_filter",
+    "converters",
+    "true_values",
+    "false_values",
+    "thousands",
+    "decimal",
+    "comment",
+    "engine",
+]
+
+
+@dataclass
+class ExcelConfig(datasets.BuilderConfig):
+    """BuilderConfig for Excel workbooks.
+
+    The parameters mirror the ones of `pandas.read_excel` so that users can
+    transfer their existing spreadsheet loading code to `datasets` with no
+    semantic change. Unless documented otherwise, every parameter is forwarded
+    verbatim to `pandas.read_excel`.
+    """
+
+    sheet_name: Optional[Union[str, int, list[Union[str, int]]]] = 0
+    """Worksheet(s) to read, by name or 0-based index. Defaults to the first sheet.
+    Like in `pandas.read_excel`, a list of names/indices reads several sheets and
+    `None` reads all of them; the rows of the selected sheets are then concatenated
+    in the order of the selection (workbook order for `None`)."""
+
+    header: Optional[Union[int, list[int]]] = 0
+    """Row (0-indexed) to use for the column names of the parsed worksheet."""
+
+    names: Optional[list[str]] = None
+    """List of column names to use, overriding the ones found in the worksheet."""
+
+    column_names: Optional[list[str]] = None
+    """Deprecated alias of `names`, kept for consistency with the other packaged modules."""
+
+    index_col: Optional[Union[int, str, list[int], list[str]]] = None
+    """Column(s) to use as the row labels of the resulting table."""
+
+    usecols: Optional[Union[str, list[int], list[str], Callable[[str], bool]]] = None
+    """Subset of columns to select from the worksheet."""
+
+    skiprows: Optional[Union[int, list[int], Callable[[int], bool]]] = None
+    """Rows to skip at the beginning of the worksheet."""
+
+    nrows: Optional[int] = None
+    """Number of rows to parse, starting from the first non-skipped data row."""
+
+    na_values: Optional[Any] = None
+    """Additional values to recognize as missing values."""
+
+    keep_default_na: bool = True
+    """Whether to include the default missing value markers when parsing."""
+
+    na_filter: bool = True
+    """Whether to detect missing value markers at all."""
+
+    converters: Optional[dict[Union[int, str], Callable[[Any], Any]]] = None
+    """Functions to apply to the values of specific columns."""
+
+    true_values: Optional[list] = None
+    """Values to recognize as `True`."""
+
+    false_values: Optional[list] = None
+    """Values to recognize as `False`."""
+
+    thousands: Optional[str] = None
+    """Thousands separator for numeric values stored as text."""
+
+    decimal: str = "."
+    """Character to recognize as decimal point for numeric values stored as text."""
+
+    comment: Optional[str] = None
+    """Character indicating that the remainder of a cell should not be parsed."""
+
+    engine: Optional[str] = None
+    """Excel reader engine to use. Defaults to the engine `pandas` picks for the file extension."""
+
+    features: Optional[datasets.Features] = None
+    """Cast the parsed table to these features instead of the inferred ones."""
+
+    chunksize: int = 10_000
+    """Number of rows per yielded batch when generating the dataset (not forwarded to pandas)."""
+
+    def __post_init__(self):
+        super().__post_init__()
+        if self.column_names is not None:
+            self.names = self.column_names
+
+    @property
+    def pd_read_excel_kwargs(self):
+        pd_read_excel_kwargs = {
+            parameter: getattr(self, parameter)
+            for parameter in _PANDAS_READ_EXCEL_SUPPORTED_PARAMETERS
+            if getattr(self, parameter) is not None
+        }
+        # `sheet_name=None` (read all sheets) and `header=None` (no header row) are
+        # both meaningful, they must always be forwarded
+        pd_read_excel_kwargs["sheet_name"] = self.sheet_name
+        pd_read_excel_kwargs["header"] = self.header
+        # Some kwargs must not be passed if they don't have a default value in pandas.
+        for pd_read_excel_parameter in _PANDAS_READ_EXCEL_NO_DEFAULT_PARAMETERS:
+            if pd_read_excel_kwargs.get(pd_read_excel_parameter) == getattr(ExcelConfig(), pd_read_excel_parameter):
+                pd_read_excel_kwargs.pop(pd_read_excel_parameter, None)
+        return pd_read_excel_kwargs
+
+
+class Excel(datasets.ArrowBasedBuilder):
+    """Arrow builder for Excel workbooks (`.xlsx`, `.xlsm`, `.xls` and friends)."""
+
+    BUILDER_CONFIG_CLASS = ExcelConfig
+
+    def _info(self):
+        return datasets.DatasetInfo(features=self.config.features)
+
+    def _split_generators(self, dl_manager):
+        """We handle string, list and dicts in datafiles"""
+        if not self.config.data_files:
+            raise ValueError(f"At least one data file must be specified, but got data_files={self.config.data_files}")
+        # Note: no `extract_on_the_fly` here — `.xlsx`/`.xlsm` workbooks are zip
+        # containers themselves and must be handed to the Excel reader as-is.
+        base_data_files = dl_manager.download(self.config.data_files)
+        splits = []
+        for split_name, files in base_data_files.items():
+            files_iterables = [dl_manager.iter_files(file) for file in files]
+            splits.append(
+                datasets.SplitGenerator(
+                    name=split_name,
+                    gen_kwargs={"files_iterables": files_iterables, "base_files": files},
+                )
+            )
+        return splits
+
+    def _cast_table(self, pa_table: pa.Table) -> pa.Table:
+        if self.config.features is not None:
+            schema = self.config.features.arrow_schema
+            if all(not require_storage_cast(feature) for feature in self.config.features.values()):
+                # cheaper cast
+                pa_table = pa.Table.from_arrays([pa_table[field.name] for field in schema], schema=schema)
+            else:
+                # more expensive cast; allows str <-> int/float or str to Audio for example
+                pa_table = table_cast(pa_table, schema)
+        return pa_table
+
+    def _generate_shards(self, base_files, files_iterables):
+        yield from base_files
+
+    def _read_excel_frames(self, file, dtype) -> list[pd.DataFrame]:
+        """Read a workbook and return the selected sheet(s) as a list of DataFrames.
+
+        A single sheet selection gives a one-element list. When several sheets are
+        selected (`sheet_name` given as a list, or `None` for the whole workbook),
+        `pandas.read_excel` returns an ordered dict of DataFrames and the sheets are
+        returned in selection order (workbook order for `None`).
+        """
+        result = pd.read_excel(file, dtype=dtype, **self.config.pd_read_excel_kwargs)
+        if isinstance(result, dict):
+            return list(result.values())
+        return [result]
+
+    def _generate_tables(self, base_files, files_iterables):
+        schema = self.config.features.arrow_schema if self.config.features else None
+        # dtype allows reading an int column as str for example
+        dtype = (
+            {
+                name: dtype.to_pandas_dtype() if not require_storage_cast(feature) else object
+                for name, dtype, feature in zip(schema.names, schema.types, self.config.features.values())
+            }
+            if schema is not None
+            else None
+        )
+        for shard_idx, files_iterable in enumerate(files_iterables):
+            for file in files_iterable:
+                try:
+                    dataframes = self._read_excel_frames(file, dtype)
+                except ValueError as e:
+                    logger.error(f"Failed to read file '{file}' with error {type(e)}: {e}")
+                    raise
+                batch_idx = 0
+                for df in dataframes:
+                    for start in range(0, max(len(df), 1), self.config.chunksize):
+                        pa_table = pa.Table.from_pandas(df.iloc[start : start + self.config.chunksize])
+                        yield Key(shard_idx, batch_idx), self._cast_table(pa_table)
+                        batch_idx += 1
