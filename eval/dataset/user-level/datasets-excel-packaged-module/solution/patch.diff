diff --git a/src/datasets/io/excel.py b/src/datasets/io/excel.py
new file mode 100644
index 0000000..b354fac
--- /dev/null
+++ b/src/datasets/io/excel.py
@@ -0,0 +1,253 @@
+import multiprocessing
+import os
+import re
+from typing import Any, BinaryIO, Optional, Union
+
+import fsspec
+import pandas as pd
+
+from .. import Dataset, Features, NamedSplit, config
+from ..formatting import query_table
+from ..packaged_modules.excel.excel import Excel
+from ..utils import tqdm as hf_tqdm
+from ..utils.typing import NestedDataStructureLike, PathLike
+from .abc import AbstractDatasetReader
+
+
+class ExcelDatasetReader(AbstractDatasetReader):
+    def __init__(
+        self,
+        path_or_paths: NestedDataStructureLike[PathLike],
+        split: Optional[NamedSplit] = None,
+        features: Optional[Features] = None,
+        cache_dir: str = None,
+        keep_in_memory: bool = False,
+        streaming: bool = False,
+        num_proc: Optional[int] = None,
+        **kwargs,
+    ):
+        super().__init__(
+            path_or_paths,
+            split=split,
+            features=features,
+            cache_dir=cache_dir,
+            keep_in_memory=keep_in_memory,
+            streaming=streaming,
+            num_proc=num_proc,
+            **kwargs,
+        )
+        path_or_paths = path_or_paths if isinstance(path_or_paths, dict) else {self.split: path_or_paths}
+        self.builder = Excel(
+            cache_dir=cache_dir,
+            data_files=path_or_paths,
+            features=features,
+            **kwargs,
+        )
+
+    def read(self):
+        # Build iterable dataset
+        if self.streaming:
+            dataset = self.builder.as_streaming_dataset(split=self.split)
+        # Build regular (map-style) dataset
+        else:
+            download_config = None
+            download_mode = None
+            verification_mode = None
+            base_path = None
+
+            self.builder.download_and_prepare(
+                download_config=download_config,
+                download_mode=download_mode,
+                verification_mode=verification_mode,
+                base_path=base_path,
+                num_proc=self.num_proc,
+            )
+            dataset = self.builder.as_dataset(split=self.split, in_memory=self.keep_in_memory)
+        return dataset
+
+
+# Control characters that are not representable in XML 1.0 and therefore illegal
+# inside xlsx cells (openpyxl raises IllegalCharacterError when it meets one).
+# Horizontal tab, line feed and carriage return are legal and kept as-is.
+_ILLEGAL_XLSX_CHARACTERS = re.compile(r"[\x00-\x08\x0b-\x0c\x0e-\x1f]")
+
+
+def _to_excel_cell(value: Any) -> Any:
+    """Convert a value coming out of a pandas/Arrow batch to something openpyxl can write."""
+    if value is None:
+        return None
+    if isinstance(value, (list, tuple)) or (type(value).__module__ == "numpy" and hasattr(value, "tolist")):
+        # nested values (Sequence features, arrays, ...) have no cell representation;
+        # serialize them like pandas.to_excel does
+        return str(value)
+    # NaN and NaT are the only "not equal to itself" scalars we can get from a DataFrame
+    if isinstance(value, float) and pd.isna(value):
+        return None
+    if value is pd.NaT or (not isinstance(value, (bool, int, float, str, bytes)) and pd.isna(value)):
+        return None
+    if isinstance(value, pd.Timestamp):
+        # naive datetimes are written as-is, timezone-aware ones are converted to naive UTC
+        # because the xlsx format has no notion of time zones
+        if value.tzinfo is not None:
+            return value.tz_convert("UTC").tz_localize(None).to_pydatetime()
+        return value.to_pydatetime()
+    if isinstance(value, str):
+        # strip characters that are illegal in XML 1.0, otherwise saving the workbook fails
+        return _ILLEGAL_XLSX_CHARACTERS.sub("", value)
+    if hasattr(value, "item") and not isinstance(value, (str, bytes)):
+        # convert numpy scalars (np.int64, np.float64, np.bool_, ...) to Python natives
+        return value.item()
+    return value
+
+
+class _WorksheetWriter:
+    """Writes the rows of a [`Dataset`] to an openpyxl write-only worksheet, in batches."""
+
+    def __init__(self, dataset: Dataset, batch_size: int, num_proc: Optional[int]):
+        self.dataset = dataset
+        self.batch_size = batch_size
+        self.num_proc = num_proc
+
+    def _batch_rows(self, offset):
+        batch = query_table(
+            table=self.dataset.data,
+            key=slice(offset, offset + self.batch_size),
+            indices=self.dataset._indices,
+        )
+        df = batch.to_pandas(integer_object_nulls=True)
+        return [[_to_excel_cell(value) for value in row] for row in df.itertuples(index=False, name=None)]
+
+    def write_rows(self, worksheet, header: bool = True) -> int:
+        """Append the dataset rows to `worksheet`. Returns the number of data rows written."""
+        if header:
+            worksheet.append(list(self.dataset.column_names))
+
+        written = 0
+        if self.num_proc is None or self.num_proc == 1:
+            for offset in hf_tqdm(
+                range(0, len(self.dataset), self.batch_size),
+                unit="ba",
+                desc="Creating Excel workbook from Arrow format",
+            ):
+                rows = self._batch_rows(offset)
+                for row in rows:
+                    worksheet.append(row)
+                written += len(rows)
+        else:
+            num_rows, batch_size = len(self.dataset), self.batch_size
+            with multiprocessing.Pool(self.num_proc) as pool:
+                for rows in hf_tqdm(
+                    pool.imap(self._batch_rows, list(range(0, num_rows, batch_size))),
+                    total=(num_rows // batch_size) + 1 if num_rows % batch_size else num_rows // batch_size,
+                    unit="ba",
+                    desc="Creating Excel workbook from Arrow format",
+                ):
+                    for row in rows:
+                        worksheet.append(row)
+                    written += len(rows)
+        return written
+
+
+class ExcelDatasetWriter:
+    def __init__(
+        self,
+        dataset: Dataset,
+        path_or_buf: Union[PathLike, BinaryIO],
+        batch_size: Optional[int] = None,
+        num_proc: Optional[int] = None,
+        storage_options: Optional[dict] = None,
+        **to_excel_kwargs,
+    ):
+        if num_proc is not None and num_proc <= 0:
+            raise ValueError(f"num_proc {num_proc} must be an integer > 0.")
+
+        self.dataset = dataset
+        self.path_or_buf = path_or_buf
+        self.batch_size = batch_size if batch_size else config.DEFAULT_MAX_BATCH_SIZE
+        self.num_proc = num_proc
+        self.storage_options = storage_options or {}
+        self.to_excel_kwargs = to_excel_kwargs
+
+    def write(self) -> int:
+        _ = self.to_excel_kwargs.pop("path_or_buf", None)
+        header = self.to_excel_kwargs.pop("header", True)
+        index = self.to_excel_kwargs.pop("index", False)
+        sheet_name = self.to_excel_kwargs.pop("sheet_name", "Sheet1")
+
+        if index:
+            raise NotImplementedError("Writing the row index to an Excel workbook is not supported.")
+
+        if isinstance(self.path_or_buf, (str, bytes, os.PathLike)):
+            with fsspec.open(self.path_or_buf, "wb", **(self.storage_options or {})) as buffer:
+                written = self._write(file_obj=buffer, header=header, sheet_name=sheet_name, **self.to_excel_kwargs)
+        else:
+            written = self._write(file_obj=self.path_or_buf, header=header, sheet_name=sheet_name, **self.to_excel_kwargs)
+        return written
+
+    def _write(self, file_obj: BinaryIO, header, sheet_name, **to_excel_kwargs) -> int:
+        """Writes the dataset as an Excel workbook to a binary file handle.
+
+        Returns the number of data rows written (the header row is not counted).
+        """
+        from openpyxl import Workbook
+
+        workbook = Workbook(write_only=True)
+        worksheet = workbook.create_sheet(title=sheet_name)
+        writer = _WorksheetWriter(self.dataset, self.batch_size, self.num_proc)
+        written = writer.write_rows(worksheet, header=header)
+        workbook.save(file_obj)
+        return written
+
+
+class ExcelDatasetDictWriter:
+    def __init__(
+        self,
+        dataset_dict,
+        path_or_buf: Union[PathLike, BinaryIO],
+        batch_size: Optional[int] = None,
+        num_proc: Optional[int] = None,
+        storage_options: Optional[dict] = None,
+        **to_excel_kwargs,
+    ):
+        if num_proc is not None and num_proc <= 0:
+            raise ValueError(f"num_proc {num_proc} must be an integer > 0.")
+
+        self.dataset_dict = dataset_dict
+        self.path_or_buf = path_or_buf
+        self.batch_size = batch_size if batch_size else config.DEFAULT_MAX_BATCH_SIZE
+        self.num_proc = num_proc
+        self.storage_options = storage_options or {}
+        self.to_excel_kwargs = to_excel_kwargs
+
+    def write(self) -> dict:
+        _ = self.to_excel_kwargs.pop("path_or_buf", None)
+        header = self.to_excel_kwargs.pop("header", True)
+        index = self.to_excel_kwargs.pop("index", False)
+        _ = self.to_excel_kwargs.pop("sheet_name", None)  # sheets are named after the splits
+
+        if index:
+            raise NotImplementedError("Writing the row index to an Excel workbook is not supported.")
+
+        if isinstance(self.path_or_buf, (str, bytes, os.PathLike)):
+            with fsspec.open(self.path_or_buf, "wb", **(self.storage_options or {})) as buffer:
+                written = self._write(file_obj=buffer, header=header, **self.to_excel_kwargs)
+        else:
+            written = self._write(file_obj=self.path_or_buf, header=header, **self.to_excel_kwargs)
+        return written
+
+    def _write(self, file_obj: BinaryIO, header, **to_excel_kwargs) -> dict:
+        """Writes every split of the dataset dict as one worksheet of a single Excel workbook.
+
+        Each worksheet is named after its split. Returns a dict mapping each split
+        name to its number of data rows written (the header rows are not counted).
+        """
+        from openpyxl import Workbook
+
+        workbook = Workbook(write_only=True)
+        written = {}
+        for split, dataset in self.dataset_dict.items():
+            worksheet = workbook.create_sheet(title=str(split))
+            writer = _WorksheetWriter(dataset, self.batch_size, self.num_proc)
+            written[split] = writer.write_rows(worksheet, header=header)
+        workbook.save(file_obj)
+        return written
