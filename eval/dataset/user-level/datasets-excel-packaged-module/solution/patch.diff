@@ -0,0 +1,726 @@
+import datetime
+import io as stdlib_io
+import os
+
+import fsspec
+import openpyxl
+import pytest
+
+from datasets import Dataset, DatasetDict, Features, IterableDataset, NamedSplit, Value
+from datasets.io.excel import ExcelDatasetReader, ExcelDatasetWriter
+
+from ..utils import assert_arrow_memory_doesnt_increase, assert_arrow_memory_increases
+
+
+def _write_workbook(path, rows, sheet_name=None):
+    workbook = openpyxl.Workbook()
+    worksheet = workbook.active
+    if sheet_name is not None:
+        worksheet.title = sheet_name
+    for row in rows:
+        worksheet.append(row)
+    workbook.save(path)
+    return str(path)
+
+
+@pytest.fixture
+def excel_path(tmp_path):
+    return _write_workbook(
+        tmp_path / "dataset.xlsx",
+        [
+            ["col_1", "col_2", "col_3"],
+            [1, 2, 0.5],
+            [2, 3, 1.5],
+            [3, 4, 2.5],
+            [4, 5, 3.5],
+        ],
+    )
+
+
+@pytest.fixture
+def excel_path_multi_sheet(tmp_path):
+    filename = tmp_path / "multi.xlsx"
+    workbook = openpyxl.Workbook()
+    first = workbook.active
+    first.title = "first"
+    first.append(["a"])
+    first.append([0])
+    second = workbook.create_sheet("second")
+    second.append(["col_1", "col_2", "col_3"])
+    for i in range(4):
+        second.append([i + 1, i + 2, i + 0.5])
+    workbook.save(filename)
+    return str(filename)
+
+
+@pytest.fixture
+def excel_path_with_nulls(tmp_path):
+    return _write_workbook(
+        tmp_path / "with_nulls.xlsx",
+        [
+            ["name", "score"],
+            ["alice", 1.5],
+            ["bob", None],
+            [None, 2.5],
+        ],
+    )
+
+
+def _check_excel_dataset(dataset, expected_features):
+    assert isinstance(dataset, Dataset)
+    assert dataset.num_rows == 4
+    assert dataset.num_columns == 3
+    assert dataset.column_names == ["col_1", "col_2", "col_3"]
+    for feature, expected_dtype in expected_features.items():
+        assert dataset.features[feature].dtype == expected_dtype
+
+
+@pytest.mark.parametrize("keep_in_memory", [False, True])
+def test_dataset_from_excel_keep_in_memory(keep_in_memory, excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    expected_features = {"col_1": "int64", "col_2": "int64", "col_3": "float64"}
+    with assert_arrow_memory_increases() if keep_in_memory else assert_arrow_memory_doesnt_increase():
+        dataset = ExcelDatasetReader(excel_path, cache_dir=cache_dir, keep_in_memory=keep_in_memory).read()
+    _check_excel_dataset(dataset, expected_features)
+
+
+@pytest.mark.parametrize(
+    "features",
+    [
+        None,
+        {"col_1": "string", "col_2": "int64", "col_3": "float64"},
+        {"col_1": "string", "col_2": "string", "col_3": "string"},
+        {"col_1": "int32", "col_2": "int32", "col_3": "float32"},
+    ],
+)
+def test_dataset_from_excel_features(features, excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    default_expected_features = {"col_1": "int64", "col_2": "int64", "col_3": "float64"}
+    expected_features = features.copy() if features else default_expected_features
+    features = (
+        Features({feature: Value(dtype) for feature, dtype in features.items()}) if features is not None else None
+    )
+    dataset = ExcelDatasetReader(excel_path, features=features, cache_dir=cache_dir).read()
+    _check_excel_dataset(dataset, expected_features)
+
+
+@pytest.mark.parametrize("split", [None, NamedSplit("train"), "train", "test"])
+def test_dataset_from_excel_split(split, excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    expected_features = {"col_1": "int64", "col_2": "int64", "col_3": "float64"}
+    dataset = ExcelDatasetReader(excel_path, cache_dir=cache_dir, split=split).read()
+    _check_excel_dataset(dataset, expected_features)
+    assert dataset.split == split if split else "train"
+
+
+@pytest.mark.parametrize("path_type", [str, list])
+def test_dataset_from_excel_path_type(path_type, excel_path, tmp_path):
+    if issubclass(path_type, str):
+        path = excel_path
+    elif issubclass(path_type, list):
+        path = [excel_path]
+    cache_dir = tmp_path / "cache"
+    expected_features = {"col_1": "int64", "col_2": "int64", "col_3": "float64"}
+    dataset = ExcelDatasetReader(path, cache_dir=cache_dir).read()
+    _check_excel_dataset(dataset, expected_features)
+
+
+def test_dataset_from_excel_sheet_name(excel_path_multi_sheet, tmp_path):
+    cache_dir = tmp_path / "cache"
+    dataset = ExcelDatasetReader(excel_path_multi_sheet, cache_dir=cache_dir, sheet_name="second").read()
+    _check_excel_dataset(dataset, {"col_1": "int64", "col_2": "int64", "col_3": "float64"})
+
+
+def test_dataset_from_excel_nulls(excel_path_with_nulls, tmp_path):
+    cache_dir = tmp_path / "cache"
+    dataset = ExcelDatasetReader(excel_path_with_nulls, cache_dir=cache_dir).read()
+    assert dataset[:] == {
+        "name": ["alice", "bob", None],
+        "score": [1.5, None, 2.5],
+    }
+
+
+def test_dataset_from_excel_streaming(excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    dataset = ExcelDatasetReader(excel_path, cache_dir=cache_dir, streaming=True).read()
+    assert isinstance(dataset, IterableDataset)
+    rows = list(dataset)
+    assert len(rows) == 4
+    assert rows[0] == {"col_1": 1, "col_2": 2, "col_3": 0.5}
+
+
+def _check_excel_datasetdict(dataset_dict, expected_features, splits=("train",)):
+    assert isinstance(dataset_dict, DatasetDict)
+    for split in splits:
+        dataset = dataset_dict[split]
+        assert dataset.num_rows == 4
+        assert dataset.num_columns == 3
+        assert dataset.column_names == ["col_1", "col_2", "col_3"]
+        for feature, expected_dtype in expected_features.items():
+            assert dataset.features[feature].dtype == expected_dtype
+
+
+def test_datasetdict_from_excel_splits(excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    expected_features = {"col_1": "int64", "col_2": "int64", "col_3": "float64"}
+    dataset_dict = ExcelDatasetReader(
+        {"train": excel_path, "test": excel_path}, cache_dir=cache_dir
+    ).read()
+    _check_excel_datasetdict(dataset_dict, expected_features, splits=("train", "test"))
+
+
+def _check_excel_file(path, expected_rows, sheet_name="Sheet1", header=True):
+    workbook = openpyxl.load_workbook(path)
+    assert workbook.sheetnames == [sheet_name]
+    worksheet = workbook[sheet_name]
+    rows = [list(row) for row in worksheet.iter_rows(values_only=True)]
+    if header:
+        assert rows[0] == ["col_1", "col_2", "col_3"]
+        rows = rows[1:]
+    assert rows == expected_rows
+
+
+def test_dataset_to_excel(excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    dataset = ExcelDatasetReader(excel_path, cache_dir=cache_dir).read()
+    output = tmp_path / "output.xlsx"
+    written = ExcelDatasetWriter(dataset, output).write()
+    assert written == 4
+    _check_excel_file(output, [[1, 2, 0.5], [2, 3, 1.5], [3, 4, 2.5], [4, 5, 3.5]])
+
+
+def test_dataset_to_excel_batch_size(excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    dataset = ExcelDatasetReader(excel_path, cache_dir=cache_dir).read()
+    output = tmp_path / "output.xlsx"
+    written = ExcelDatasetWriter(dataset, output, batch_size=1).write()
+    assert written == 4
+    _check_excel_file(output, [[1, 2, 0.5], [2, 3, 1.5], [3, 4, 2.5], [4, 5, 3.5]])
+
+
+def test_dataset_to_excel_num_proc(excel_path, tmp_path):
+    cache_dir = tmp_path / "cache"
+    dataset = ExcelDatasetReader(excel_path, cache_dir=cache_dir).read()
+    output = tmp_path / "output.xlsx"
