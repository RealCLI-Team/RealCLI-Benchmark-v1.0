new file mode 100644
index 00000000..f9b47211
--- /dev/null
+++ b/docker/rollout/revision.py
@@ -0,0 +1,176 @@
+"""The description of *what* to run and *how* to roll it out.
+
+A rollout is driven by two pieces of data kept deliberately separate:
+
+* a :class:`Revision` -- the desired container configuration (image, command,
+  environment, ...) plus a content-derived identity so two revisions that
+  describe the same thing compare equal; and
+* an :class:`UpdatePolicy` -- the knobs that govern *how* the transition from
+  the current revision to the new one is carried out (batch size, health
+  gating, rollback behaviour, strategy).
+
+Neither talks to Docker; they are plain, validated data so the controller can
+reason about a rollout before performing it.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass, field
+
+from .analysis import CanaryAnalysis
+from .errors import RevisionError
+
+
+def _validate_positive(value, what):
+    if not isinstance(value, int) or value < 1:
+        raise RevisionError("{} must be an integer >= 1".format(what))
+    return value
+
+
+@dataclass
+class Revision:
+    """An immutable, content-addressed container specification."""
+
+    image: str
+    command: object = None
+    entrypoint: object = None
+    environment: dict = field(default_factory=dict)
+    labels: dict = field(default_factory=dict)
+    ports: list = field(default_factory=list)
+    healthcheck: object = None       # dict payload or None
+    restart: str = "no"
+    user: object = None
+    working_dir: object = None
+
+    @classmethod
+    def from_dict(cls, data):
+        if not isinstance(data, dict):
+            raise RevisionError("revision must be a mapping")
+        if "image" not in data or not data["image"]:
+            raise RevisionError("revision is missing 'image'")
+
+        env = data.get("environment") or {}
+        if isinstance(env, (list, tuple)):
+            parsed = {}
+            for item in env:
+                text = str(item)
+                if "=" in text:
+                    k, v = text.split("=", 1)
+                else:
+                    k, v = text, ""
+                parsed[k] = v
+            env = parsed
+        elif isinstance(env, dict):
+            env = {str(k): ("" if v is None else str(v))
+                   for k, v in env.items()}
+        else:
+            raise RevisionError("'environment' must be a list or mapping")
+
+        return cls(
+            image=str(data["image"]),
+            command=data.get("command"),
+            entrypoint=data.get("entrypoint"),
+            environment=env,
+            labels=dict(data.get("labels") or {}),
+            ports=list(data.get("ports") or []),
+            healthcheck=data.get("healthcheck"),
+            restart=str(data.get("restart", "no")),
+            user=data.get("user"),
+            working_dir=data.get("working_dir"),
+        )
+
+    def canonical(self):
+        return {
+            "image": self.image,
+            "command": self.command,
+            "entrypoint": self.entrypoint,
+            "environment": dict(sorted(self.environment.items())),
+            "labels": dict(sorted(self.labels.items())),
+            "ports": sorted(str(p) for p in self.ports),
+            "healthcheck": self.healthcheck,
+            "restart": self.restart,
+            "user": self.user,
+            "working_dir": self.working_dir,
+        }
+
+    def revision_id(self):
+        """A short, stable content hash identifying this revision.
+
+        Independent of dict ordering, so re-deriving a revision from an
+        equivalent description yields the same id -- which is what lets the
+        controller decide that "the running version already is the target".
+        """
+        blob = json.dumps(
+            self.canonical(), sort_keys=True, separators=(",", ":")
+        )
+        return hashlib.sha256(blob.encode("utf-8")).hexdigest()[:16]
+
+    def __eq__(self, other):
+        return isinstance(other, Revision) and \
+            self.revision_id() == other.revision_id()
+
+    def __hash__(self):
+        return hash(self.revision_id())
+
+
+class Strategy:
+    ROLLING = "rolling"
+    BLUE_GREEN = "blue_green"
+    RECREATE = "recreate"
+    CANARY = "canary"
+
+    ALL = (ROLLING, BLUE_GREEN, RECREATE, CANARY)
+
+
+@dataclass
+class UpdatePolicy:
+    """How to carry out the transition to a new revision."""
+
+    strategy: str = Strategy.ROLLING
+    batch_size: int = 1                 # replicas updated per rolling batch
+    max_unavailable: int = 1            # replicas allowed down at once
+    health_attempts: int = 30           # inspects before giving up on health
+    require_health: bool = True         # gate promotion on healthiness
+    auto_rollback: bool = True          # revert to old revision on failure
+    pause_between_batches: float = 0.0  # seconds (uses injected sleeper)
+    canary_slots: int = 1               # replicas run at canary weight first
+    canary: object = None               # CanaryAnalysis or None
+
+    @classmethod
+    def from_dict(cls, data):
+        data = data or {}
+        strategy = str(data.get("strategy", Strategy.ROLLING))
+        if strategy not in Strategy.ALL:
+            raise RevisionError(
+                "unknown strategy {!r}; expected one of {}".format(
+                    strategy, Strategy.ALL
+                )
+            )
+        canary_spec = data.get("canary")
+        canary = None
+        if canary_spec is not None:
+            canary = canary_spec if isinstance(canary_spec, CanaryAnalysis) \
+                else CanaryAnalysis.from_dict(canary_spec)
+        canary_slots = int(data.get("canary_slots", 1))
+        if canary_slots < 1:
+            raise RevisionError("canary_slots must be >= 1")
+        policy = cls(
+            strategy=strategy,
+            batch_size=_validate_positive(
+                int(data.get("batch_size", 1)), "batch_size"
+            ),
+            max_unavailable=int(data.get("max_unavailable", 1)),
+            health_attempts=_validate_positive(
+                int(data.get("health_attempts", 30)), "health_attempts"
+            ),
+            require_health=bool(data.get("require_health", True)),
+            auto_rollback=bool(data.get("auto_rollback", True)),
+            pause_between_batches=float(data.get("pause_between_batches", 0.0)),
+            canary_slots=canary_slots,
+            canary=canary,
+        )
+        if policy.max_unavailable < 0:
+            raise RevisionError("max_unavailable must be >= 0")
+        return policy
