index 00000000..86a91c71
--- /dev/null
+++ b/docker/rollout/spec.py
@@ -0,0 +1,153 @@
+"""Declarative rollout manifests.
+
+The controller's Python API takes a :class:`~docker.rollout.revision.Revision`
+and an :class:`~docker.rollout.revision.UpdatePolicy` as separate arguments.
+In practice a rollout is usually described *as a document* -- checked into a
+repo, reviewed, applied by CI -- that names the service, the target revision
+and the update policy together.  :class:`RolloutSpec` is that document's
+in-memory form: it validates the manifest, cross-checks it for consistency and
+hands back the objects the controller consumes.
+
+The manifest shape (as a plain dict, e.g. parsed from YAML/JSON)::
+
+    version: 1
+    service: web
+    replicas: 4
+    revision:
+      image: web:2
+      environment: {LOG_LEVEL: info}
+    policy:
+      strategy: canary
+      batch_size: 2
+      canary_slots: 1
+      canary:
+        intervals: 3
+        metrics:
+          - {name: error_rate, threshold: 0.01, comparison: lt}
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .errors import RevisionError
+from .revision import Revision, Strategy, UpdatePolicy
+
+SUPPORTED_VERSIONS = (1,)
+
+_KNOWN_TOP_KEYS = {"version", "service", "replicas", "revision", "policy"}
+
+
+@dataclass
+class RolloutSpec:
+    """A validated, self-consistent rollout manifest."""
+
+    service: str
+    revision: Revision
+    policy: UpdatePolicy
+    replicas: object = None      # int or None (infer from live state)
+    version: int = 1
+
+    @classmethod
+    def from_dict(cls, data):
+        if not isinstance(data, dict):
+            raise RevisionError("rollout spec must be a mapping")
+
+        unknown = set(data) - _KNOWN_TOP_KEYS
+        if unknown:
+            raise RevisionError(
+                "unknown rollout-spec key(s): {}".format(
+                    ", ".join(sorted(unknown))
+                )
+            )
+
+        version = int(data.get("version", 1))
+        if version not in SUPPORTED_VERSIONS:
+            raise RevisionError(
+                "unsupported rollout-spec version {!r}; supported: {}".format(
+                    version, SUPPORTED_VERSIONS
+                )
+            )
+
+        service = data.get("service")
+        if not service or not isinstance(service, str):
+            raise RevisionError("rollout spec requires a 'service' name")
+
+        if "revision" not in data:
+            raise RevisionError("rollout spec requires a 'revision'")
+        revision = Revision.from_dict(data["revision"])
+
+        policy = UpdatePolicy.from_dict(data.get("policy") or {})
+
+        replicas = data.get("replicas")
+        if replicas is not None:
+            replicas = int(replicas)
+            if replicas < 1:
+                raise RevisionError("'replicas' must be >= 1")
+
+        spec = cls(
+            service=service,
+            revision=revision,
+            policy=policy,
+            replicas=replicas,
+            version=version,
+        )
+        spec._cross_validate()
+        return spec
+
+    def _cross_validate(self):
+        """Reject manifests that are individually valid but jointly nonsense."""
+        policy = self.policy
+        # A canary strategy with a canary block but no metrics can never make a
+        # real go/no-go decision -- allow it (it degrades to health-only) but a
+        # canary_slots larger than the fleet is a mistake we can catch here.
+        if self.replicas is not None and policy.canary_slots > self.replicas:
+            raise RevisionError(
+                "canary_slots ({}) exceeds replicas ({})".format(
+                    policy.canary_slots, self.replicas
+                )
+            )
+        if policy.strategy != Strategy.CANARY and policy.canary is not None:
+            raise RevisionError(
+                "a 'canary' analysis block is only valid with "
+                "strategy: canary (got {!r})".format(policy.strategy)
+            )
+        if policy.max_unavailable > 0 and self.replicas is not None \
+                and policy.max_unavailable > self.replicas:
+            raise RevisionError(
+                "max_unavailable ({}) exceeds replicas ({})".format(
+                    policy.max_unavailable, self.replicas
+                )
+            )
+
+    def build_controller(self, api_client, controller_cls=None,
+                         metric_provider=None, sleeper=None):
+        """Instantiate a controller wired to this spec's service/replicas.
+
+        Imported lazily to avoid a circular import between spec and controller.
+        """
+        if controller_cls is None:
+            from .controller import RolloutController as controller_cls
+        return controller_cls(
+            api_client,
+            self.service,
+            replicas=self.replicas,
+            sleeper=sleeper,
+            metric_provider=metric_provider,
+        )
+
+    def as_dict(self):
+        return {
+            "version": self.version,
+            "service": self.service,
+            "replicas": self.replicas,
+            "revision": self.revision.canonical(),
+            "policy": {
+                "strategy": self.policy.strategy,
+                "batch_size": self.policy.batch_size,
+                "max_unavailable": self.policy.max_unavailable,
+                "require_health": self.policy.require_health,
+                "auto_rollback": self.policy.auto_rollback,
+                "canary_slots": self.policy.canary_slots,
+            },
+        }
