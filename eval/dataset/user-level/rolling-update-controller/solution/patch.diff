@@ -0,0 +1,73 @@
+"""Safe rolling / blue-green / recreate updates for docker-py services.
+
+Where :mod:`docker.orchestration` reconciles a whole declarative stack, this
+package focuses on the harder single problem of *changing the version of one
+running service without breaking it*.  It models a service as a set of
+labelled replicas and drives them from a current :class:`Revision` to a target
+one according to an :class:`UpdatePolicy`, health-gating every step and rolling
+back automatically if the new revision fails to come up.
+
+Like the rest of the project it follows a plan/apply split::
+
+    import docker
+    from docker.rollout import RolloutController, Revision, UpdatePolicy
+
+    api = docker.APIClient()
+    ctl = RolloutController(api, "web", replicas=4)
+    plan = ctl.plan(Revision.from_dict({"image": "web:2"}),
+                    UpdatePolicy(strategy="rolling", batch_size=2))
+    if not plan.is_noop:
+        result = ctl.rollout(Revision.from_dict({"image": "web:2"}),
+                             UpdatePolicy(batch_size=2))
+"""
+
+from __future__ import annotations
+
+from .analysis import (
+    AnalysisResult,
+    CanaryAnalysis,
+    Comparison,
+    MetricCheck,
+)
+from .controller import RolloutController
+from .errors import (
+    HealthTimeout,
+    RevisionError,
+    RollbackFailed,
+    RolloutError,
+    RolloutFailed,
+)
+from .history import HistoryEntry, RevisionHistory
+from .plan import (
+    Batch,
+    RolloutPlan,
+    RolloutResult,
+    Step,
+    StepKind,
+)
+from .revision import Revision, Strategy, UpdatePolicy
+from .spec import RolloutSpec
+
+__all__ = [
+    "RolloutSpec",
+    "RolloutController",
+    "Revision",
+    "UpdatePolicy",
+    "Strategy",
+    "RolloutPlan",
+    "RolloutResult",
+    "Batch",
+    "Step",
+    "StepKind",
+    "RolloutError",
+    "RevisionError",
+    "RolloutFailed",
+    "HealthTimeout",
+    "RollbackFailed",
+    "CanaryAnalysis",
+    "AnalysisResult",
+    "MetricCheck",
+    "Comparison",
+    "RevisionHistory",
+    "HistoryEntry",
+]
diff --git a/docker/rollout/analysis.py b/docker/rollout/analysis.py
