index 00000000..91960cbc
--- /dev/null
+++ b/docker/rollout/state.py
@@ -0,0 +1,78 @@
+"""Observe the replicas of a service currently known to the Engine.
+
+Reads exclusively through ``APIClient.containers`` with a label filter, so it
+behaves identically against a real daemon and a test double.  The controller
+uses this to learn the current revision distribution before planning an
+update, and to find what to roll back to if one fails.
+"""
+
+from __future__ import annotations
+
+from . import naming
+
+
+class Replica:
+    """A single managed container of a service."""
+
+    __slots__ = ("id", "name", "service", "slot", "revision", "color",
+                 "status", "labels", "raw")
+
+    def __init__(self, raw):
+        self.raw = raw
+        self.id = raw.get("Id") or raw.get("ID") or ""
+        names = raw.get("Names") or []
+        self.name = names[0].lstrip("/") if names else raw.get("Name", "")
+        labels = raw.get("Labels") or {}
+        self.labels = labels
+        self.service = labels.get(naming.LABEL_SERVICE, "")
+        self.revision = labels.get(naming.LABEL_REVISION, "")
+        self.color = labels.get(naming.LABEL_COLOR, "")
+        try:
+            self.slot = int(labels.get(naming.LABEL_SLOT, "0"))
+        except (TypeError, ValueError):
+            self.slot = 0
+        self.status = raw.get("State") or raw.get("Status") or ""
+
+
+class ServiceState:
+    """The set of replicas currently backing a service."""
+
+    def __init__(self, replicas):
+        self.replicas = replicas  # list[Replica]
+
+    @classmethod
+    def observe(cls, api, service):
+        flt = naming.service_filter(service)
+        replicas = []
+        for raw in api.containers(all=True, filters=flt):
+            rep = Replica(raw)
+            if rep.service == service:
+                replicas.append(rep)
+        replicas.sort(key=lambda r: (r.color, r.slot))
+        return cls(replicas)
+
+    def revisions(self):
+        """The distinct revision ids currently running, in first-seen order."""
+        seen = []
+        for rep in self.replicas:
+            if rep.revision and rep.revision not in seen:
+                seen.append(rep.revision)
+        return seen
+
+    def by_revision(self, revision_id):
+        return [r for r in self.replicas if r.revision == revision_id]
+
+    def by_color(self, color):
+        return [r for r in self.replicas if r.color == color]
+
+    def count(self):
+        return len(self.replicas)
+
+    def dominant_revision(self):
+        """The revision the majority of replicas are on (or None)."""
+        counts = {}
+        for rep in self.replicas:
+            counts[rep.revision] = counts.get(rep.revision, 0) + 1
+        if not counts:
+            return None
+        return max(counts, key=lambda rev: counts[rev])
