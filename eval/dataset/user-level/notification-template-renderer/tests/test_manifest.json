  "featureCases": [
    {
      "group": "primary",
      "input": {
        "channel": "email",
        "locale": "en-US",
        "templates": {
          "en": "Hi {{name}}, total {{total|0}}"
        },
        "data": {
          "name": "Ada <L>",
          "total": "$7"
        }
      },
      "expected": {
        "rendered": "Hi Ada &lt;L&gt;, total $7",
        "missing": [],
        "fallbackLocale": "en"
      }
    },
    {
      "group": "composition",
      "input": {
        "channel": "sms",
        "locale": "fr-FR",
        "templates": {
          "en": "Code {{code}} for {{name|customer}}"
        },
        "data": {
          "code": "123"
        }
      },
      "expected": {
        "rendered": "Code 123 for customer",
        "missing": [],
        "fallbackLocale": "en"
      }
    },
    {
      "group": "state",
      "input": {
        "channel": "email",
        "locale": "en",
        "templates": {
          "en": "{{b}} {{a}} {{b}} {{missing}}"
        },
        "data": {
          "a": "A",
          "b": "B"
        }
      },
      "expected": {
        "rendered": "B A B ",
        "missing": [
          "missing"
        ],
        "fallbackLocale": "en"
      }
    },
    {
      "group": "edge",
      "input": {
        "channel": "push",
        "locale": "",
        "templates": {},
        "data": {}
      },
      "expected": {
        "rendered": "",
        "missing": [],
