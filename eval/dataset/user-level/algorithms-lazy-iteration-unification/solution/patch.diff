+class TestSinglePassSemantics(unittest.TestCase):
+    """Converted APIs return single-pass iterators, never rewindable ones."""
+
+    def assert_single_pass(self, func, args):
+        first_pass = func(*args)
+        drained = list(first_pass)
+        self.assertEqual(list(first_pass), [])
+        # a fresh call produces the full sequence again
+        self.assertEqual(list(func(*args)), drained)
+
+    def test_backtracking_single_pass(self):
+        self.assert_single_pass(subsets, ([1, 2],))
