+"""Golden content table for lazily-converted enumeration APIs.
+
+Each case pins the exact item sequence (content and, where the
+historical order was deterministic, order) that the lazy iterator
+must produce, captured from the pre-conversion implementations.
+"""
+
+from __future__ import annotations
+
+import importlib
+import unittest
+
+
+# (module, function, args, expected, order_matters)
+GOLDEN_CASES = [
+    (
+        'algorithms.backtracking.subsets',
+        'subsets',
+        ([1, 2, 3],),
+        [[1, 2, 3], [1, 2], [1, 3], [1], [2, 3], [2], [3], []],
+        True,
+    ),
+    (
+        'algorithms.backtracking.subsets',
+        'subsets',
+        ([],),
+        [[]],
+        True,
+    ),
+    (
+        'algorithms.backtracking.subsets',
+        'subsets',
+        ([5],),
+        [[5], []],
+        True,
+    ),
+    (
+        'algorithms.backtracking.subsets',
+        'subsets_v2',
+        ([1, 2, 3],),
+        [[], [1], [2], [1, 2], [3], [1, 3], [2, 3], [1, 2, 3]],
+        True,
+    ),
+    (
+        'algorithms.backtracking.subsets_unique',
+        'subsets_unique',
+        ([1, 2, 2],),
+        [[], [1], [1, 2], [1, 2, 2], [2], [2, 2]],
+        False,
+    ),
+    (
+        'algorithms.backtracking.combination_sum',
+        'combination_sum',
+        ([2, 3, 6, 7], 7),
+        [[2, 2, 3], [7]],
+        True,
+    ),
+    (
+        'algorithms.backtracking.combination_sum',
+        'combination_sum',
+        ([2, 3, 5], 8),
+        [[2, 2, 2, 2], [2, 3, 3], [3, 5]],
+        True,
+    ),
+    (
+        'algorithms.backtracking.combination_sum',
+        'combination_sum',
+        ([2], 1),
+        [],
+        True,
+    ),
+    (
