+class IteratorContractMixin:
+    """Shared assertions for the single-pass lazy iterator contract."""
+
+    def assert_lazy_iterator(self, value):
+        self.assertNotIsInstance(value, (list, tuple, set, frozenset, dict, str))
+        self.assertIs(iter(value), value, "expected a single-pass iterator")
+
+    def assert_sequence(self, func, args, expected, kwargs=None):
+        result = func(*args, **(kwargs or {}))
+        self.assert_lazy_iterator(result)
+        self.assertEqual(list(result), list(expected))
+        self.assertEqual(list(result), [], "iterator must be exhausted")
+
+
+class TestSubsetsLazy(IteratorContractMixin, unittest.TestCase):
+    def test_subsets_content_and_order(self):
+        self.assert_sequence(
+            subsets,
+            ([1, 2, 3],),
+            [[1, 2, 3], [1, 2], [1, 3], [1], [2, 3], [2], [3], []],
+        )
+
+    def test_subsets_empty(self):
+        self.assert_sequence(subsets, ([],), [[]])
+
+    def test_subsets_single(self):
+        self.assert_sequence(subsets, ([5],), [[5], []])
+
+    def test_subsets_v2_content_and_order(self):
+        self.assert_sequence(
+            subsets_v2,
+            ([1, 2, 3],),
+            [[], [1], [2], [1, 2], [3], [1, 3], [2, 3], [1, 2, 3]],
+        )
+
+    def test_subsets_unique(self):
+        result = subsets_unique([1, 2, 2])
+        self.assert_lazy_iterator(result)
+        self.assertEqual(
+            sorted(result), [(), (1,), (1, 2), (1, 2, 2), (2,), (2, 2)]
+        )
+
+    def test_bit_subsets(self):
+        result = bit_subsets([1, 2, 3])
+        self.assert_lazy_iterator(result)
+        self.assertEqual(
+            set(result),
+            {(), (1,), (2,), (3,), (1, 2), (1, 3), (2, 3), (1, 2, 3)},
+        )
