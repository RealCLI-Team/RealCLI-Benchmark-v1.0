+class TestGoldenContent(unittest.TestCase):
+    def test_lazy_iterator_and_content(self):
+        for module_name, func_name, args, expected, ordered in GOLDEN_CASES:
+            with self.subTest(api=f"{module_name}.{func_name}"):
+                func = getattr(importlib.import_module(module_name), func_name)
+                result = func(*args)
+                self.assertNotIsInstance(
+                    result, (list, tuple, set, frozenset, dict, str),
+                    "expected a lazy iterator, not a materialized container",
+                )
+                self.assertIs(iter(result), result, 'expected a single-pass iterator')
+                actual = list(result)
+                def canon(items):
+                    normalized = [
+                        tuple(item) if isinstance(item, list) else item
+                        for item in items
+                    ]
+                    return sorted(map(repr, normalized))
+
+                if ordered:
+                    self.assertEqual(
+                        [tuple(item) if isinstance(item, list) else item for item in actual],
+                        [tuple(item) if isinstance(item, list) else item for item in expected],
+                    )
+                else:
+                    self.assertEqual(canon(actual), canon(expected))
+                self.assertEqual(list(result), [], "iterator must be exhausted")
+
+
+if __name__ == "__main__":
+    unittest.main()
