+class TestLazinessProbes(unittest.TestCase):
+    """The first item must be available without computing all results."""
+
+    budget_sec = 10.0
+
+    def assert_first_item_fast(self, func, args):
+        start = time.perf_counter()
+        iterator = func(*args)
+        first = next(iterator)
+        elapsed = time.perf_counter() - start
+        self.assertLess(
+            elapsed,
+            self.budget_sec,
+            f"first item took {elapsed:.2f}s; results must be produced lazily",
+        )
+        return first
+
+    def test_permute_first_item(self):
+        first = self.assert_first_item_fast(permute, (list(range(11)),))
+        self.assertEqual(first, list(range(11)))
+
+    def test_generate_parenthesis_first_item(self):
+        first = self.assert_first_item_fast(generate_parenthesis_v1, (15,))
+        self.assertIsInstance(first, str)
