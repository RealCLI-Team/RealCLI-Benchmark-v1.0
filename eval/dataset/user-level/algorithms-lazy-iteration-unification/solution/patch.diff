+def build_sample_tree():
+    r"""Build the shared sample tree used across traversal tests.
+
+            1
+           / \
+          2   3
+         / \   \
+        4   5   6
+           /
+          7
+    """
+    from algorithms.common.tree_node import TreeNode
+
+    def node(val, left=None, right=None):
+        item = TreeNode(val)
+        item.left = left
+        item.right = right
+        return item
+
+    return node(1, node(2, node(4), node(5, node(7))), node(3, None, node(6)))
+
+
+def build_view_tree():
+    r"""Build the asymmetric tree used for the view functions.
+
+            1
+           / \
+          2   3
+           \ / \
+           4 5  6
+    """
+    from algorithms.common.tree_node import TreeNode
+
+    def node(val, left=None, right=None):
+        item = TreeNode(val)
+        item.left = left
+        item.right = right
+        return item
+
+    return node(1, node(2, None, node(4)), node(3, node(5), node(6)))
