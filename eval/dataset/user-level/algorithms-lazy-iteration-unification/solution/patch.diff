+        )
+
+    def test_queue_variant(self):
+        self.assert_sequence(
+            queue_max_sliding_window, (self.nums, 3), [3, 3, 5, 5, 6, 7]
+        )
+
+    def test_window_of_one(self):
+        for variant in (heap_max_sliding_window, queue_max_sliding_window):
+            self.assert_sequence(variant, ([2, 1, 5], 1), [2, 1, 5])
+
+    def test_unified_edge_semantics(self):
+        for variant in (heap_max_sliding_window, queue_max_sliding_window):
+            # k == len: exactly one window
+            self.assertEqual(list(variant(self.nums, len(self.nums))), [7])
+            # k > len: no complete window
+            self.assertEqual(list(variant(self.nums, len(self.nums) + 1)), [])
+            # empty input
+            self.assertEqual(list(variant([], 3)), [])
+            # invalid k must raise eagerly at call time
+            with self.assertRaises(ValueError):
+                variant(self.nums, 0)
+            with self.assertRaises(ValueError):
+                variant(self.nums, -3)
