+class TestMoreLazinessProbes(unittest.TestCase):
+    """First-item latency must not depend on the total result count."""
+
+    budget_sec = 10.0
+
+    def assert_first_item_fast(self, func, args):
+        start = time.perf_counter()
+        iterator = func(*args)
+        first = next(iterator)
+        elapsed = time.perf_counter() - start
+        self.assertLess(
+            elapsed,
+            self.budget_sec,
+            f"first item took {elapsed:.2f}s; results must be produced lazily",
+        )
+        return first
+
+    def test_permute_recursive_first_item(self):
+        first = self.assert_first_item_fast(permute_recursive, (list(range(10)),))
+        self.assertEqual(first, list(range(10)))
+
+    def test_palindromic_substrings_first_item(self):
+        # 2^19 partitions exist for a 20-char string of 'a's
+        first = self.assert_first_item_fast(palindromic_substrings, ("a" * 20,))
+        self.assertEqual(first, ["a" * 20])
+
+    def test_word_squares_like_enumeration(self):
+        first = self.assert_first_item_fast(subsets_v2, (list(range(20)),))
+        self.assertEqual(first, [])
+
+    def test_abbreviations_first_item(self):
+        # 2^25 abbreviations for a 25-letter word
+        first = self.assert_first_item_fast(generate_abbreviations, ("a" * 25,))
+        self.assertEqual(first, "a" * 25)
+
+    def test_add_operators_first_item(self):
+        first = self.assert_first_item_fast(add_operators, ("1" * 12, 12))
