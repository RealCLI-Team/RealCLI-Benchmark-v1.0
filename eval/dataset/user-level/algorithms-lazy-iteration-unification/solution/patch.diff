+class TestDeepTreeLaziness(unittest.TestCase):
+    """Traversal of a deep tree must reach the first item without
+    walking the whole tree, and results must stream one at a time."""
+
+    budget_sec = 10.0
+
+    @staticmethod
+    def build_left_chain(depth):
+        from algorithms.tree.traversal_inorder import Node
+
+        root = current = Node(0)
+        for value in range(1, depth):
+            current.left = Node(value)
+            current = current.left
+        return root
+
+    def test_inorder_first_item_on_deep_tree(self):
+        root = self.build_left_chain(100_000)
+        start = time.perf_counter()
+        iterator = inorder(root)
+        first = next(iterator)
+        elapsed = time.perf_counter() - start
+        self.assertLess(elapsed, self.budget_sec)
+        self.assertEqual(first, 99_999)
+
+    def test_inorder_streams_incrementally(self):
+        root = self.build_left_chain(1000)
+        iterator = inorder(root)
+        self.assertEqual([next(iterator) for _ in range(5)], [999, 998, 997, 996, 995])
+
+    def test_preorder_streams_incrementally(self):
+        root = self.build_left_chain(1000)
+        iterator = preorder(root)
+        self.assertEqual([next(iterator) for _ in range(3)], [0, 1, 2])
+
+    def test_level_order_first_level_fast(self):
+        root = self.build_left_chain(50_000)
+        start = time.perf_counter()
+        iterator = level_order(root)
+        first = next(iterator)
+        elapsed = time.perf_counter() - start
+        self.assertLess(elapsed, self.budget_sec)
+        self.assertEqual(first, [0])
+
