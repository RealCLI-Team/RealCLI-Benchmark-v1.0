+
+    For more information, try '--help'.
+    ");
+
+    uv_snapshot!(context.auth_login()
+        .arg("https://example.com")
+        .arg("--username")
+        .arg("test")
+        .arg("--password")
+        .arg("test")
+        .env(EnvVars::UV_PREVIEW_FEATURES, "native-auth"), @r"
+    success: true
+    exit_code: 0
+    ----- stdout -----
+
+    ----- stderr -----
