+        mw = make_middleware()
+        store_validators(mw, get_request())
+
+        second = get_request()
+        mw.process_request(second)
+        mw.process_response(second, ok_response(second, etag='"v2"'))
+
+        third = get_request()
+        mw.process_request(third)
+        assert third.headers[b"If-None-Match"] == b'"v2"'
+
+    def test_multiple_urls_full_cycle(self):
