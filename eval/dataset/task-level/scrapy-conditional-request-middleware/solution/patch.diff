diff --git a/tests/test_downloadermiddleware_conditional.py b/tests/test_downloadermiddleware_conditional.py
new file mode 100644
index 0000000..1a6b3ce
--- /dev/null
+++ b/tests/test_downloadermiddleware_conditional.py
@@ -0,0 +1,1836 @@
+"""Tests for the conditional-requests downloader middleware.
+
+The middleware under test is
+:class:`scrapy.downloadermiddlewares.conditional.ConditionalRequestsMiddleware`.
+It implements lightweight incremental re-crawling: it stores the ``ETag`` and
+``Last-Modified`` validators of successful responses and turns later requests
+for the same resource into conditional ones, dropping ``304 Not Modified``
+responses before they reach the spider.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import tempfile
+from typing import TYPE_CHECKING, Any
+
+import pytest
+
+from scrapy.downloadermiddlewares.conditional import (
+    CONDITIONAL_METHODS,
+    META_KEY,
+    ConditionalRequestsMiddleware,
+    _DbmValidatorStore,
+    _MemoryValidatorStore,
+)
+from scrapy.exceptions import IgnoreRequest, NotConfigured
+from scrapy.http import Request, Response, TextResponse
+from scrapy.settings.default_settings import DOWNLOADER_MIDDLEWARES_BASE
+from scrapy.spiders import Spider
+from scrapy.utils.test import get_crawler
+
+if TYPE_CHECKING:
+    from scrapy.crawler import Crawler
+
+
+MW_PATH = "scrapy.downloadermiddlewares.conditional.ConditionalRequestsMiddleware"
+
+ETAG = '"v1-etag"'
+LAST_MODIFIED = "Wed, 21 Oct 2015 07:28:00 GMT"
+WEAK_ETAG = 'W/"weak-etag"'
+
+
+class ConditionalSpider(Spider):
+    """Spider used by the tests that need a named spider instance."""
+
+    name = "condtest"
+
+
+def make_crawler(**settings: Any) -> Crawler:
+    """Return a crawler with the middleware enabled plus *settings*."""
+    base: dict[str, Any] = {"CONDITIONAL_REQUESTS_ENABLED": True}
+    base.update(settings)
+    return get_crawler(ConditionalSpider, base)
+
+
+def make_middleware(crawler: Crawler | None = None, **settings: Any) -> ConditionalRequestsMiddleware:
+    """Return a middleware instance built from a (possibly new) crawler."""
+    if crawler is None:
+        crawler = make_crawler(**settings)
+    return ConditionalRequestsMiddleware.from_crawler(crawler)
+
+
+def get_request(url: str = "http://example.com/", **kwargs: Any) -> Request:
+    """Return a GET request for *url*."""
+    return Request(url, **kwargs)
+
+
+def ok_response(
+    request: Request,
+    etag: str | None = ETAG,
+    last_modified: str | None = LAST_MODIFIED,
+    cache_control: str | None = None,
+    status: int = 200,
+) -> Response:
+    """Return a response for *request* carrying the given validators."""
+    headers: dict[str, str] = {}
+    if etag is not None:
+        headers["ETag"] = etag
+    if last_modified is not None:
+        headers["Last-Modified"] = last_modified
+    if cache_control is not None:
+        headers["Cache-Control"] = cache_control
+    return Response(request.url, status=status, headers=headers, body=b"body", request=request)
+
+
+def store_validators(
+    mw: ConditionalRequestsMiddleware,
+    request: Request,
+    etag: str | None = ETAG,
+    last_modified: str | None = LAST_MODIFIED,
+) -> Response:
+    """Feed a 200 response through the middleware so validators get stored."""
+    response = ok_response(request, etag=etag, last_modified=last_modified)
+    return mw.process_response(request, response)
+
+
+class TestNotConfigured:
+    """The middleware must disable itself unless explicitly enabled."""
+
+    def test_default_settings_disable_middleware(self):
+        """With default settings the middleware raises NotConfigured."""
+        crawler = get_crawler(ConditionalSpider, {})
+        with pytest.raises(NotConfigured):
+            ConditionalRequestsMiddleware.from_crawler(crawler)
+
+    def test_explicit_false_disables_middleware(self):
+        """CONDITIONAL_REQUESTS_ENABLED=False raises NotConfigured."""
+        crawler = get_crawler(ConditionalSpider, {"CONDITIONAL_REQUESTS_ENABLED": False})
+        with pytest.raises(NotConfigured):
+            ConditionalRequestsMiddleware.from_crawler(crawler)
+
+    def test_enabled_builds_middleware(self):
+        """CONDITIONAL_REQUESTS_ENABLED=True builds the middleware."""
+        mw = make_middleware()
