+class TestSignals:
+    """The middleware must hook into the spider open/close signals."""
+
+    @staticmethod
+    def _connected(sig_name: str, mw: ConditionalRequestsMiddleware) -> bool:
+        """Whether the middleware's handler is connected to the signal."""
+        from pydispatch import dispatcher
+
+        expected = f"ConditionalRequestsMiddleware.{sig_name}"
+        for receivers in dispatcher.connections.values():
+            for receiver_list in receivers.values():
+                for receiver_ref in receiver_list:
+                    if expected in repr(receiver_ref):
+                        return True
+        return False
