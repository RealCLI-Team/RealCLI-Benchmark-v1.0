+class TestFullCycle:
+    """End-to-end flows through process_request/process_response."""
+
+    def test_first_fetch_then_conditional_then_304(self):
+        """The canonical incremental flow: store, conditionalize, drop."""
+        crawler = make_crawler()
+        mw = make_middleware(crawler)
+
+        # First crawl: no headers, validators stored.
+        first = get_request()
+        assert mw.process_request(first) is None
+        assert b"If-None-Match" not in first.headers
+        mw.process_response(first, ok_response(first))
+        assert crawler.stats.get_value("conditional_requests/store") == 1
+
+        # Second crawl: conditional headers, 304 dropped.
+        second = get_request()
+        assert mw.process_request(second) is None
+        assert second.headers[b"If-None-Match"] == ETAG.encode()
+        assert crawler.stats.get_value("conditional_requests/conditional") == 1
+        with pytest.raises(IgnoreRequest):
+            mw.process_response(second, Response(second.url, status=304, request=second))
+        assert crawler.stats.get_value("conditional_requests/not_modified") == 1
