+class TestMiddlewareChainIntegration:
+    """The middleware must behave correctly inside the real middleware chain."""
+
+    def _manager(self, crawler: Crawler):
+        from scrapy.core.downloader.middleware import DownloaderMiddlewareManager
+
+        if crawler.spider is None:
+            crawler.spider = ConditionalSpider()
+        return DownloaderMiddlewareManager.from_crawler(crawler)
+
+    def test_chain_passes_fresh_request_to_downloader(self):
+        """A fresh request travels the whole chain to the download function."""
+        import asyncio
+
+        crawler = make_crawler()
+        manager = self._manager(crawler)
+        request = get_request()
+        response = ok_response(request)
+
+        async def download_func(req):
+            assert req is request
+            assert b"If-None-Match" not in req.headers
+            return response
+
+        result = asyncio.run(manager.download_async(download_func, request))
+        assert result is response
+
+    def test_chain_stores_validators_from_response(self):
+        """A 200 with validators is stored when going through the chain."""
+        import asyncio
+
+        crawler = make_crawler()
+        manager = self._manager(crawler)
+        request = get_request()
+
+        async def download_func(req):
+            return ok_response(req)
+
+        asyncio.run(manager.download_async(download_func, request))
+        assert crawler.stats.get_value("conditional_requests/store") == 1
+
+    def test_chain_conditionalizes_second_request(self):
+        """The second identical request gets conditional headers in the chain."""
+        import asyncio
+
+        crawler = make_crawler()
+        manager = self._manager(crawler)
+
+        async def first_download(req):
+            return ok_response(req)
+
+        asyncio.run(manager.download_async(first_download, get_request()))
+        assert crawler.stats.get_value("conditional_requests/store") == 1
+
+        seen: dict[str, bytes] = {}
+
+        async def second_download(req):
+            seen["if_none_match"] = req.headers.get(b"If-None-Match", b"")
+            seen["if_modified_since"] = req.headers.get(b"If-Modified-Since", b"")
+            return Response(req.url, status=304, request=req)
+
+        with pytest.raises(IgnoreRequest):
+            asyncio.run(manager.download_async(second_download, get_request()))
+        assert seen["if_none_match"] == ETAG.encode()
+        assert seen["if_modified_since"] == LAST_MODIFIED.encode()
+        assert crawler.stats.get_value("conditional_requests/conditional") == 1
+        assert crawler.stats.get_value("conditional_requests/not_modified") == 1
+
