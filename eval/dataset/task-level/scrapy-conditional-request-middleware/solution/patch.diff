diff --git a/scrapy/downloadermiddlewares/conditional.py b/scrapy/downloadermiddlewares/conditional.py
new file mode 100644
index 0000000..8c66283
--- /dev/null
+++ b/scrapy/downloadermiddlewares/conditional.py
@@ -0,0 +1,311 @@
+"""
+Conditional Requests downloader middleware.
+
+This middleware implements lightweight incremental re-crawling based on the
+HTTP conditional request mechanism (:rfc:`9110`, section 13). Unlike
+:class:`~scrapy.downloadermiddlewares.httpcache.HttpCacheMiddleware`, it does
+not store response bodies. It only remembers the ``ETag`` and
+``Last-Modified`` validators of previously seen successful responses and, on
+subsequent crawls (optionally across process restarts), turns matching
+requests into conditional ones by adding ``If-None-Match`` and/or
+``If-Modified-Since`` headers. When the origin server answers ``304 Not
+Modified``, the response is dropped before it reaches the spider, so spiders
+do not have to deal with unchanged pages at all.
+"""
+
+from __future__ import annotations
+
+import dbm.dumb
+import json
+import logging
+import os
+import threading
+from typing import TYPE_CHECKING
+
+from scrapy import signals
+from scrapy.exceptions import IgnoreRequest, NotConfigured
+from scrapy.utils.decorators import _warn_spider_arg
+
+if TYPE_CHECKING:
+    # typing.Self requires Python 3.11
+    from typing_extensions import Self
+
+    from scrapy.crawler import Crawler
+    from scrapy.http.request import Request
+    from scrapy.http.response import Response
+    from scrapy.settings import Settings
+    from scrapy.spiders import Spider
+    from scrapy.statscollectors import StatsCollector
+    from scrapy.utils.request import RequestFingerprinterProtocol
+
+
+logger = logging.getLogger(__name__)
+
+#: Request methods that can carry conditional headers and whose responses can
+#: provide validators worth storing.
+CONDITIONAL_METHODS = ("GET", "HEAD")
+
+#: Meta key that spiders can set to ``False`` to opt a single request out of
+#: all conditional-request handling (neither sending conditional headers nor
+#: storing validators from its response).
+META_KEY = "conditional_request"
+
+#: Internal meta key used to remember that this middleware attached
+#: conditional headers to a request, so that a ``304`` response to it can be
+#: safely attributed to this middleware.
+_SENT_META_KEY = "_conditional_request_sent"
+
+
+class _ValidatorStore:
+    """Mapping from request fingerprint to ``ETag``/``Last-Modified`` pairs.
+
+    Two backends are provided:
+
+    * :class:`_MemoryValidatorStore` keeps validators in a plain ``dict`` and
+      therefore only within a single process run.
+    * :class:`_DbmValidatorStore` persists validators in a :mod:`dbm.dumb`
+      database file so that follow-up crawls started later (e.g. a daily
+      incremental job) still benefit from the validators collected before.
+
+    Both backends expose the same minimal interface so the middleware does not
+    need to care which one is active.
+    """
+
+    def get(self, key: str) -> tuple[str | None, str | None] | None:
+        """Return the stored ``(etag, last_modified)`` pair for *key*.
+
+        Either element may be ``None`` when the origin server only sent one of
+        the two validators. ``None`` is returned when nothing was stored.
+        """
+        raise NotImplementedError
+
+    def set(self, key: str, etag: str | None, last_modified: str | None) -> None:
+        """Store the given validators under *key*, replacing any old value."""
+        raise NotImplementedError
+
+    def close(self) -> None:
+        """Flush pending changes and release resources."""
+
+
+class _MemoryValidatorStore(_ValidatorStore):
+    """Process-local validator store backed by a plain dictionary."""
+
+    def __init__(self) -> None:
+        self._data: dict[str, tuple[str | None, str | None]] = {}
+
+    def get(self, key: str) -> tuple[str | None, str | None] | None:
+        return self._data.get(key)
+
+    def set(self, key: str, etag: str | None, last_modified: str | None) -> None:
+        self._data[key] = (etag, last_modified)
+
+    def close(self) -> None:
+        self._data.clear()
+
+
+class _DbmValidatorStore(_ValidatorStore):
+    """Persistent validator store backed by a :mod:`dbm.dumb` database.
+
+    :mod:`dbm.dumb` is used instead of the faster :mod:`dbm.gnu` backend
+    because it is pure Python and therefore always available, regardless of
+    how the running interpreter was built. Validator lookups only happen once
+    per request, so the performance difference is irrelevant in practice.
+    """
+
+    def __init__(self, path: str) -> None:
+        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+        self._db = dbm.dumb.open(path, "c")
+        self._lock = threading.Lock()
+
+    def get(self, key: str) -> tuple[str | None, str | None] | None:
+        with self._lock:
+            raw = self._db.get(key.encode())
+        if raw is None:
+            return None
+        try:
+            data = json.loads(raw.decode())
+        except (ValueError, UnicodeDecodeError):
+            # A corrupt entry must never break a crawl; treat it as a miss.
+            logger.warning(
+                "Ignoring corrupt conditional-request validator entry for key %s",
+                key,
+            )
+            return None
+        return data.get("etag"), data.get("last_modified")
+
+    def set(self, key: str, etag: str | None, last_modified: str | None) -> None:
+        raw = json.dumps({"etag": etag, "last_modified": last_modified}).encode()
+        with self._lock:
+            self._db[key.encode()] = raw
+
+    def close(self) -> None:
+        with self._lock:
+            self._db.close()
+
+
+class ConditionalRequestsMiddleware:
+    """Downloader middleware for conditional (incremental) re-crawling.
+
+    The middleware is part of the default downloader middleware chain, but it
+    only activates when :setting:`CONDITIONAL_REQUESTS_ENABLED` is set to
+    ``True``; otherwise it disables itself through :exc:`NotConfigured`, like
+    other opt-in built-in middlewares do.
+
+    For every outgoing ``GET`` or ``HEAD`` request the middleware looks up the
+    request fingerprint in its validator store. If a previous crawl stored an
+    ``ETag`` and/or a ``Last-Modified`` value for that fingerprint, the
+    corresponding ``If-None-Match`` and/or ``If-Modified-Since`` headers are
+    added to the request, unless the request already carries them (headers set
+    by the spider or by other middlewares are never overwritten).
+
+    When the response comes back:
+
+    * ``304 Not Modified`` answers to requests that this middleware made
+      conditional are dropped by raising :exc:`~scrapy.exceptions.IgnoreRequest`,
+      so unchanged pages never reach the spider callbacks.
+    * ``200 OK`` responses that carry an ``ETag`` and/or a ``Last-Modified``
+      header have those validators stored under the request fingerprint, so
+      that future requests for the same resource can be made conditional.
+      Responses whose ``Cache-Control`` header contains ``no-store`` are not
+      recorded.
+
+    Individual requests can opt out of all of this behavior by setting
+    ``request.meta["conditional_request"] = False``.
+
+    The middleware keeps the following :ref:`stats <topics-stats>`:
+
+    * ``conditional_requests/conditional``: number of requests to which
+      conditional headers were attached.
+    * ``conditional_requests/store``: number of responses whose validators
+      were stored.
+    * ``conditional_requests/not_modified``: number of ``304`` responses that
+      were dropped.
+    """
+
+    def __init__(
+        self,
+        settings: Settings,
+        stats: StatsCollector,
+        fingerprinter: RequestFingerprinterProtocol,
+    ) -> None:
+        if not settings.getbool("CONDITIONAL_REQUESTS_ENABLED"):
+            raise NotConfigured
+        self.stats = stats
+        self.fingerprinter = fingerprinter
+        self._storage_dir: str | None = settings.get("CONDITIONAL_REQUESTS_DIR")
+        self._store: _ValidatorStore = _MemoryValidatorStore()
+        self.crawler: Crawler
+
+    @classmethod
+    def from_crawler(cls, crawler: Crawler) -> Self:
+        o = cls(crawler.settings, crawler.stats, crawler.request_fingerprinter)
+        crawler.signals.connect(o.spider_opened, signal=signals.spider_opened)
+        crawler.signals.connect(o.spider_closed, signal=signals.spider_closed)
+        o.crawler = crawler
+        return o
+
+    def spider_opened(self, spider: Spider) -> None:
+        if self._storage_dir:
+            path = os.path.join(
+                self._storage_dir, f"{spider.name}_conditional_requests"
+            )
+            self._store = _DbmValidatorStore(path)
+
+    def spider_closed(self, spider: Spider) -> None:
+        self._store.close()
+
+    def _fingerprint(self, request: Request) -> str:
+        return self.fingerprinter.fingerprint(request).hex()
+
+    def _get_validators(self, request: Request) -> tuple[str | None, str | None] | None:
+        return self._store.get(self._fingerprint(request))
+
+    def _store_validators(
+        self, request: Request, etag: str | None, last_modified: str | None
+    ) -> None:
+        self._store.set(self._fingerprint(request), etag, last_modified)
+
+    @staticmethod
+    def _eligible(request: Request) -> bool:
+        """Whether conditional handling applies to *request* at all."""
+        if request.meta.get(META_KEY, True) is False:
+            return False
+        return request.method.upper() in CONDITIONAL_METHODS
+
+    @_warn_spider_arg
+    def process_request(
+        self, request: Request, spider: Spider | None = None
+    ) -> Request | Response | None:
+        if not self._eligible(request):
+            return None
+
+        validators = self._get_validators(request)
+        if not validators:
+            return None
+        etag, last_modified = validators
+
+        sent = False
+        # Headers already present on the request (set by the spider or by an
+        # earlier middleware) take precedence and are never overwritten.
+        if etag and b"If-None-Match" not in request.headers:
+            request.headers[b"If-None-Match"] = etag.encode()
+            sent = True
+        if last_modified and b"If-Modified-Since" not in request.headers:
+            request.headers[b"If-Modified-Since"] = last_modified.encode()
+            sent = True
+
+        if sent:
+            request.meta[_SENT_META_KEY] = True
+            self.stats.inc_value("conditional_requests/conditional")
+            logger.debug(
+                "Attached conditional headers to %(request)s",
+                {"request": request},
+                extra={"spider": self.crawler.spider},
+            )
+        return None
+
+    @_warn_spider_arg
+    def process_response(
+        self, request: Request, response: Response, spider: Spider | None = None
+    ) -> Request | Response:
+        if not self._eligible(request):
+            return response
+
+        sent = request.meta.pop(_SENT_META_KEY, False)
+
+        if response.status == 304:
+            if sent:
+                self.stats.inc_value("conditional_requests/not_modified")
+                logger.debug(
+                    "Dropping not-modified response for %(request)s",
+                    {"request": request},
+                    extra={"spider": self.crawler.spider},
+                )
+                raise IgnoreRequest(f"Resource not modified (304): {request}")
+            # A 304 that we did not ask for is passed through untouched.
+            return response
+
+        if response.status != 200:
+            return response
+
+        cache_control = b",".join(response.headers.getlist(b"Cache-Control"))
+        if b"no-store" in cache_control.lower():
+            return response
+
+        etag_header = response.headers.get(b"ETag")
+        last_modified_header = response.headers.get(b"Last-Modified")
+        if etag_header is None and last_modified_header is None:
+            return response
+
+        etag = etag_header.decode() if etag_header is not None else None
+        last_modified = (
+            last_modified_header.decode() if last_modified_header is not None else None
+        )
+        self._store_validators(request, etag, last_modified)
+        self.stats.inc_value("conditional_requests/store")
+        logger.debug(
+            "Stored conditional-request validators for %(request)s",
+            {"request": request},
+            extra={"spider": self.crawler.spider},
+        )
+        return response
