+def run_spider(workdir: str, url: str, cache_dir: str, output_name: str) -> subprocess.CompletedProcess:
+    """Run the spider once with conditional requests enabled."""
+    output_path = os.path.join(workdir, output_name)
+    cmd = [
+        sys.executable,
+        "-c",
+        "from scrapy.cmdline import execute; execute()",
+        "runspider",
+        os.path.join(workdir, "cond_spider.py"),
+        "-a",
+        f"url={url}",
+        "-s",
+        "CONDITIONAL_REQUESTS_ENABLED=True",
+        "-s",
+        f"CONDITIONAL_REQUESTS_DIR={cache_dir}",
+        "-s",
+        "LOG_LEVEL=INFO",
+        "-o",
+        output_path,
+    ]
+    return subprocess.run(
+        cmd,
+        cwd=workdir,
+        capture_output=True,
+        text=True,
+        timeout=180,
+    )
+
+
+def read_items(workdir: str, output_name: str) -> list[dict]:
+    """Read the JSON lines feed produced by a spider run."""
+    output_path = os.path.join(workdir, output_name)
+    if not os.path.exists(output_path):
+        return []
+    with open(output_path) as f:
+        return [json.loads(line) for line in f if line.strip()]
+
+
+class TestConditionalCrawl:
+    """Full crawl-level behavior of the middleware."""
+
+    def test_first_crawl_collects_page(self, server: str, workdir: str):
+        """The first crawl downloads the page and yields an item."""
+        cache_dir = os.path.join(workdir, "cache")
+        result = run_spider(workdir, server, cache_dir, "out1.jsonl")
+        assert result.returncode == 0, result.stdout + result.stderr
+        items = read_items(workdir, "out1.jsonl")
+        assert len(items) == 1
+        assert items[0]["size"] == len(PAGE_BODY)
+
+    def test_first_crawl_sends_no_conditional_headers(self, server: str, workdir: str):
+        """The first crawl has no validators, so no conditional headers."""
+        cache_dir = os.path.join(workdir, "cache")
+        run_spider(workdir, server, cache_dir, "out1.jsonl")
+        assert ConditionalHandler.seen_if_none_match == [None]
+
+    def test_first_crawl_creates_validator_db(self, server: str, workdir: str):
+        """The first crawl persists validators in the storage dir."""
+        cache_dir = os.path.join(workdir, "cache")
+        run_spider(workdir, server, cache_dir, "out1.jsonl")
+        assert any(
+            name.startswith("condspider_conditional_requests")
+            for name in os.listdir(cache_dir)
+        )
+
+    def test_second_crawl_sends_conditional_headers(self, server: str, workdir: str):
+        """The second crawl sends If-None-Match with the stored ETag."""
+        cache_dir = os.path.join(workdir, "cache")
+        run_spider(workdir, server, cache_dir, "out1.jsonl")
+        run_spider(workdir, server, cache_dir, "out2.jsonl")
+        assert ConditionalHandler.seen_if_none_match == [None, ETAG]
+
+    def test_second_crawl_yields_no_items(self, server: str, workdir: str):
+        """The second crawl drops the 304 response and yields nothing."""
+        cache_dir = os.path.join(workdir, "cache")
+        run_spider(workdir, server, cache_dir, "out1.jsonl")
+        result = run_spider(workdir, server, cache_dir, "out2.jsonl")
+        assert result.returncode == 0, result.stdout + result.stderr
+        assert read_items(workdir, "out2.jsonl") == []
+
+    def test_second_crawl_records_stats(self, server: str, workdir: str):
+        """The second crawl reports the documented stats counters."""
+        cache_dir = os.path.join(workdir, "cache")
+        run_spider(workdir, server, cache_dir, "out1.jsonl")
+        result = run_spider(workdir, server, cache_dir, "out2.jsonl")
+        log = result.stdout + result.stderr
+        assert "'conditional_requests/conditional': 1" in log
+        assert "'conditional_requests/not_modified': 1" in log
+
+    def test_runs_without_storage_dir_keep_working(self, server: str, workdir: str):
+        """Without CONDITIONAL_REQUESTS_DIR a single crawl works normally."""
+        output_path = os.path.join(workdir, "out.jsonl")
+        cmd = [
+            sys.executable,
+            "-c",
+            "from scrapy.cmdline import execute; execute()",
+            "runspider",
+            os.path.join(workdir, "cond_spider.py"),
+            "-a",
+            f"url={server}",
+            "-s",
+            "CONDITIONAL_REQUESTS_ENABLED=True",
+            "-o",
+            output_path,
+        ]
+        result = subprocess.run(
+            cmd, cwd=workdir, capture_output=True, text=True, timeout=180
+        )
+        assert result.returncode == 0, result.stdout + result.stderr
+        assert len(read_items(workdir, "out.jsonl")) == 1
+
+    def test_disabled_by_default(self, server: str, workdir: str):
+        """Without the enabling setting no conditional headers are sent."""
+        cache_dir = os.path.join(workdir, "cache")
+        for output_name in ("out1.jsonl", "out2.jsonl"):
+            output_path = os.path.join(workdir, output_name)
+            cmd = [
+                sys.executable,
+                "-c",
+                "from scrapy.cmdline import execute; execute()",
+                "runspider",
+                os.path.join(workdir, "cond_spider.py"),
+                "-a",
+                f"url={server}",
+                "-s",
+                f"CONDITIONAL_REQUESTS_DIR={cache_dir}",
+                "-o",
+                output_path,
+            ]
+            result = subprocess.run(
+                cmd, cwd=workdir, capture_output=True, text=True, timeout=180
+            )
+            assert result.returncode == 0, result.stdout + result.stderr
+        assert ConditionalHandler.seen_if_none_match == [None, None]
