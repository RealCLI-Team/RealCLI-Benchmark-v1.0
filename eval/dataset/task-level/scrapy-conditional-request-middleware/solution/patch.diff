+"""End-to-end tests for the conditional-requests middleware.
+
+These tests run a real spider through ``scrapy runspider`` in a subprocess
+against a local HTTP server that honors ``If-None-Match``. The first crawl
+must collect the page and store its validators; the second crawl, using the
+same :setting:`CONDITIONAL_REQUESTS_DIR`, must send conditional headers and
+drop the resulting ``304 Not Modified`` response before it reaches the
+spider.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+ETAG = '"e2e-etag-v1"'
+LAST_MODIFIED = "Wed, 21 Oct 2015 07:28:00 GMT"
+PAGE_BODY = b"<html><body><h1>hello</h1></body></html>"
+
+SPIDER_CODE = """
+import scrapy
+
+
+class ConditionalSpider(scrapy.Spider):
+    name = "condspider"
+
+    def __init__(self, url, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.start_urls = [url]
+
+    def parse(self, response):
+        yield {"url": response.url, "size": len(response.body)}
+"""
+
+
+class ConditionalHandler(BaseHTTPRequestHandler):
+    """Serve a single page with validators, honoring If-None-Match."""
+
+    seen_if_none_match: list[str | None] = []
+
+    def do_GET(self) -> None:  # noqa: N802
+        inm = self.headers.get("If-None-Match")
+        type(self).seen_if_none_match.append(inm)
+        if inm == ETAG:
+            self.send_response(304)
+            self.send_header("ETag", ETAG)
+            self.end_headers()
+            return
+        self.send_response(200)
+        self.send_header("Content-Type", "text/html")
+        self.send_header("ETag", ETAG)
+        self.send_header("Last-Modified", LAST_MODIFIED)
+        self.end_headers()
+        self.wfile.write(PAGE_BODY)
+
+    def log_message(self, format: str, *args) -> None:  # noqa: A002
+        pass
+
