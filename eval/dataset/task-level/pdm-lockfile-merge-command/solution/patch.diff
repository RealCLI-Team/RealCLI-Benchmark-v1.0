index 0000000..5a1a87d
--- /dev/null
+++ b/src/pdm/cli/commands/merge_lock.py
@@ -0,0 +1,112 @@
+import argparse
+import sys
+from pathlib import Path
+
+import tomlkit
+
+from pdm import termui
+from pdm.cli.commands.base import BaseCommand
+from pdm.exceptions import PdmUsageError
+from pdm.project import Project
+from pdm.project.lockfile.merge import (
+    ConflictStrategy,
+    MergeError,
+    format_conflict_report,
+    format_json_report,
+    merge_lockfiles,
+    render_lock_document,
+)
+
+
+class Command(BaseCommand):
+    """Merge two lockfiles against their common ancestor (three-way merge)"""
+
+    name = "merge-lock"
+    description = (
+        "Perform a three-way merge of PDM lockfiles: given the common ancestor and two "
+        "diverged revisions, produce a merged lockfile without re-resolving dependencies. "
+        "It is primarily meant to resolve version control conflicts on the lockfile, and "
+        "can be wired as a git merge driver."
+    )
+
+    def add_arguments(self, parser: argparse.ArgumentParser) -> None:
+        parser.add_argument("base", help="Path to the common ancestor lockfile")
+        parser.add_argument(
+            "ours",
+            help="Path to 'our' revision of the lockfile (the working copy). "
+            "It is overwritten with the merge result unless --output is given.",
+        )
+        parser.add_argument("theirs", help="Path to 'their' revision of the lockfile (the incoming change)")
+        parser.add_argument(
+            "-o",
+            "--output",
+            help="Write the merged lockfile to this path instead of overwriting OURS",
+        )
+        parser.add_argument(
+            "--on-conflict",
+            choices=[s.value for s in ConflictStrategy],
+            default=ConflictStrategy.FAIL.value,
+            help="How to resolve packages that changed on both sides incompatibly: "
+            "'fail' reports the conflicts and writes nothing (default), 'newer' keeps the higher "
+            "pinned version, 'ours'/'theirs' keep the whole entry from the given side.",
+        )
+        parser.add_argument(
+            "--dry-run",
+            action="store_true",
+            help="Only report whether the lockfiles can be merged, without writing anything. "
+            "Exits with a non-zero code when conflicts remain.",
+        )
+        parser.add_argument(
+            "--json",
+            action="store_true",
+            help="Print a machine readable (JSON) merge report to stdout.",
+        )
+
+    def handle(self, project: Project, options: argparse.Namespace) -> None:
+        ui = project.core.ui
+        base = Path(options.base)
+        ours = Path(options.ours)
+        theirs = Path(options.theirs)
+        output = Path(options.output) if options.output else ours
+        strategy = ConflictStrategy.from_string(options.on_conflict)
+        try:
+            result = merge_lockfiles(base, ours, theirs, strategy)
+        except MergeError as e:
+            raise PdmUsageError(str(e)) from None
+        if options.json:
+            # The JSON report must reach stdout regardless of the UI verbosity.
+            print(format_json_report(result))
+        if result.conflicts:
+            if not options.json:
+                ui.echo(format_conflict_report(result.conflicts), err=True)
+            sys.exit(1)
+        for line in result.change_lines():
+            ui.echo(line, verbosity=termui.Verbosity.DETAIL)
+        if result.resolved:
+            ui.echo(
+                f"[warning]{len(result.resolved)}[/] conflict(s) were resolved "
+                f"with [primary]--on-conflict={strategy.value}[/]: "
+                + ", ".join(sorted({c.package_name for c in result.resolved})),
+                verbosity=termui.Verbosity.NORMAL,
+                err=options.json,
+            )
+        summary = (
+            f"[primary]{len(result.packages)}[/] packages "
+            f"([success]{result.added}[/] added, [error]{result.removed}[/] removed, "
+            f"[warning]{result.updated}[/] updated)"
+        )
+        if options.dry_run:
+            ui.echo(
+                f"Lockfiles can be merged cleanly: {summary}.",
+                verbosity=termui.Verbosity.NORMAL,
+                err=options.json,
+            )
+            return
+        document = render_lock_document(result)
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(tomlkit.dumps(document), encoding="utf-8")
+        ui.echo(
+            f"Merged lockfile written to [success]{output}[/]: {summary}.",
+            verbosity=termui.Verbosity.NORMAL,
+            err=options.json,
+        )
