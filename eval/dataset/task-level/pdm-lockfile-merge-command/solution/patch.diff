+                        "1.0",
+                        requires_python=">=3.9",
+                        dependencies=("b>=1.0",),
+                        files=(file_row("a-1.0.tar.gz", "sha256:aaa"),),
+                    ),
+                    pkg("b", "1.0", files=(file_row("b-1.0.tar.gz", "sha256:bbb"),)),
