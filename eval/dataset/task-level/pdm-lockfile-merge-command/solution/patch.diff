+"""Tests for the ``pdm merge-lock`` three-way lockfile merge command.
+
+The tests build small lockfile documents programmatically, run the CLI
+command against them and assert on the merged result parsed back with
+``tomllib`` -- they never touch the network or a package index.
+"""
+from __future__ import annotations
+
+import pytest
+
+from pdm.compat import tomllib
+from pdm.project.lockfile.merge import (
+    ConflictStrategy,
+    MergeError,
+    PackageEntry,
+    load_lockfile_data,
+    merge_lock_data,
+    render_lock_document,
+)
+
+LOCK_VERSION = "4.5.1"
+
+
+def file_row(file: str, hash: str) -> dict:
+    return {"file": file, "hash": hash}
+
+
+def pkg(
+    name: str,
+    version: str | None = "1.0.0",
+    *,
+    requires_python: str = "",
+    summary: str = "",
+    groups: tuple[str, ...] = ("default",),
+    marker: str | None = None,
+    extras: tuple[str, ...] = (),
+    dependencies: tuple[str, ...] = (),
+    files: tuple[dict, ...] = (),
+    **request,
+) -> dict:
+    """Build a raw lockfile package entry."""
+    entry: dict = {"name": name}
+    if version is not None:
+        entry["version"] = version
+    if extras:
+        entry["extras"] = sorted(extras)
+    if requires_python:
+        entry["requires_python"] = requires_python
+    entry.update({k: v for k, v in request.items() if v not in (None, "", False)})
+    entry["summary"] = summary
+    entry["groups"] = sorted(groups, key=lambda g: (g != "default", g))
+    if marker is not None:
+        entry["marker"] = marker
+    if dependencies:
+        entry["dependencies"] = sorted(dependencies)
+    if files:
+        entry["files"] = list(files)
+    return entry
+
+
+def lock_data(
+    packages: list[dict],
+    *,
+    groups: tuple[str, ...] = ("default",),
+    strategy: tuple[str, ...] = ("inherit_metadata",),
+    targets: tuple[dict, ...] = ({"requires_python": ">=3.9"},),
+    lock_version: str = LOCK_VERSION,
+    content_hash: str = "sha256:base",
+    extra_metadata: dict | None = None,
+) -> dict:
+    """Build a raw lockfile document."""
+    metadata: dict = {
+        "groups": sorted(groups, key=lambda g: (g != "default", g)),
+        "strategy": sorted(strategy),
+        "targets": list(targets),
+        "lock_version": lock_version,
+        "content_hash": content_hash,
+    }
+    if extra_metadata:
+        metadata.update(extra_metadata)
+    return {"metadata": metadata, "package": packages}
+
+
+def write_lock(path, data: dict) -> None:
+    """Serialize a raw lockfile document to disk as TOML."""
+    import tomlkit
+
+    doc = tomlkit.document()
+    doc.append(None, tomlkit.comment("This file is @generated by PDM."))
+    metadata = tomlkit.table()
+    metadata.update(data["metadata"])
+    doc.add("metadata", metadata)
+    aot = tomlkit.aot()
+    for entry in data.get("package", []):
+        table = tomlkit.table()
+        table.update(entry)
+        aot.append(table)
+    doc.add("package", aot)
+    path.write_text(tomlkit.dumps(doc), encoding="utf-8")
+
+
+def read_lock(path) -> dict:
+    with open(path, "rb") as fp:
+        return tomllib.load(fp)
+
+
+def package_map(data: dict) -> dict[str, dict]:
+    return {p["name"]: p for p in data.get("package", [])}
+
+
+def run_merge(pdm, project, base, ours, theirs, *extra, expect=0):
+    out = ours.parent / "merged.lock"
+    result = pdm(
+        ["merge-lock", str(base), str(ours), str(theirs), "-o", str(out), *extra],
+        obj=project,
+    )
+    assert result.exit_code == expect, result.outputs
+    return result, out
+
+
+@pytest.fixture
+def three_locks(tmp_path):
+    """Write base/ours/theirs lockfiles and return their paths."""
+
+    def factory(base_data, ours_data, theirs_data):
+        base = tmp_path / "base.lock"
+        ours = tmp_path / "ours.lock"
+        theirs = tmp_path / "theirs.lock"
+        write_lock(base, base_data)
+        write_lock(ours, ours_data)
+        write_lock(theirs, theirs_data)
+        return base, ours, theirs
+
+    return factory
+
+
+class TestPackageEntry:
+    def test_canonical_equality_ignores_ordering(self):
+        a = PackageEntry.from_mapping(
+            {
+                "name": "Foo",
+                "version": "1.0",
+                "groups": ["dev", "default"],
+                "dependencies": ["b>=1", "a>=2"],
+                "files": [file_row("f1", "h1"), file_row("f2", "h2")],
+            }
+        )
+        b = PackageEntry.from_mapping(
+            {
+                "name": "foo",
+                "version": "1.0",
+                "groups": ["default", "dev"],
+                "dependencies": ["a>=2", "b>=1"],
+                "files": [file_row("f2", "h2"), file_row("f1", "h1")],
+            }
+        )
+        assert a == b
