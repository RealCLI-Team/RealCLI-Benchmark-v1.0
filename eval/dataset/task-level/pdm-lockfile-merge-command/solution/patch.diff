+++ b/src/pdm/project/lockfile/merge.py
@@ -0,0 +1,888 @@
+"""Three-way structural merge for PDM lockfiles.
+
+This module implements a git-style three-way merge for ``pdm.lock`` files.
+Given the lockfile at the common ancestor (``base``) and the two diverged
+revisions (``ours`` and ``theirs``), it produces a merged lockfile without
+contacting any package index, by operating purely on the structure of the
+TOML documents.
+
+Merge semantics
+---------------
+Packages are matched across the three revisions by a *merge key* derived
+from the requirement identity: the normalized package name, the extras, the
+environment marker, the source URL (for non-named requirements) and the
+editable flag.  The pinned version is deliberately *not* part of the key, so
+that version bumps on either side are seen as changes to the same entry.
+
+For every key the three entries (any of which may be missing) are reconciled
+with the classic three-way rules:
+
+* if ``ours == theirs`` (including both missing), the result is that entry;
+* else if the key was added on both sides with different content, it is a
+  conflict;
+* else if ``ours == base``, only ``theirs`` changed and its value wins
+  (including deletion);
+* else if ``theirs == base``, only ``ours`` changed and its value wins;
+* else both sides changed the entry differently and the fields are merged
+  individually: set-like fields (``groups``, ``dependencies``, ``extras``,
+  file hashes) are combined with a three-way set merge, scalar fields
+  (``version``, ``requires_python``, ``summary``, ``marker`` and the request
+  attributes) follow the same three-way rules field by field.  Any field
+  that changed on both sides into different values turns the whole entry
+  into a conflict.
+
+Conflicts are resolved according to the chosen strategy:
+
+``fail``
+    No resolution: the conflicts are reported and no output is produced.
+``ours`` / ``theirs``
+    The whole entry from the given side wins (deletion included).
+``newer``
+    The entry with the higher pinned version wins; a modification always
+    wins over a deletion, and ties (or unparseable versions) are resolved in
+    favor of ``theirs`` -- the incoming change.
+
+The ``[metadata]`` table is merged with the same philosophy: ``groups`` and
+``targets`` are three-way set merges, ``lock_version`` picks the highest
+side on disagreement, ``content_hash`` and ``lock_inputs`` prefer the
+working copy (``ours``) when both sides changed, and the lock ``strategy``
+flags must not diverge in both directions -- otherwise the lockfiles cannot
+be merged safely and an error is raised.
+"""
+from __future__ import annotations
+
+import dataclasses
+import enum
+import json
+from collections.abc import Iterable, Mapping
+from pathlib import Path
+from typing import Any
+
+import tomlkit
+
+from pdm.cli.utils import normalize_name
+from pdm.compat import tomllib
+from pdm.exceptions import PdmException, PdmUsageError
+from pdm.project.lockfile.base import GENERATED_COMMENTS
+from pdm.project.lockfile.pdmlock import PDMLock
+from pdm.utils import parse_version
+
+__all__ = [
+    "ConflictStrategy",
+    "MergeConflict",
+    "MergeResult",
+    "PackageEntry",
+    "format_conflict_report",
+    "format_json_report",
+    "load_lockfile_data",
+    "merge_lock_data",
+    "merge_lockfiles",
+    "render_lock_document",
+]
+
+# Scalar fields that are compared value by value during a field-level merge.
+_SCALAR_FIELDS = ("version", "requires_python", "summary", "marker")
+
+# Set-like fields: merged with a three-way set merge and rendered sorted.
+_SET_FIELDS = ("groups", "dependencies", "extras")
+
+# Attributes describing where the package comes from.  They are scalar for
+# merge purposes but are also used to build the merge key.
+_REQUEST_FIELDS = ("url", "path", "editable", "subdirectory", "git", "hg", "svn", "bzr", "ref", "revision")
+
+# Keys of a raw lockfile entry that are not package attributes and therefore
+# ignored by the merger.
+_IGNORED_FIELDS = ("files", "targets")
+
+
+class MergeError(PdmException):
+    """Raised when the lockfiles cannot be merged at all."""
+
+
+class ConflictStrategy(enum.Enum):
+    """How to resolve entries that changed on both sides incompatibly."""
+
+    FAIL = "fail"
+    NEWER = "newer"
+    OURS = "ours"
+    THEIRS = "theirs"
+
+    @classmethod
+    def from_string(cls, value: str) -> ConflictStrategy:
+        try:
+            return cls(value.lower())
+        except ValueError:
+            raise PdmUsageError(
+                f"Invalid conflict strategy: {value!r}, " f"expected one of: {', '.join(s.value for s in cls)}"
+            ) from None
+
+
+def _canon_json(value: Any) -> str:
+    """Serialize a metadata fragment deterministically for comparison."""
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def _canon_file_row(row: Mapping[str, Any]) -> tuple[tuple[str, str], ...]:
+    """Canonical form of a ``files`` entry: sorted ``(key, value)`` pairs."""
+    return tuple(sorted((str(k), str(v)) for k, v in row.items()))
+
+
+def _file_row_key(row: tuple[tuple[str, str], ...]) -> str:
+    """The identity of a file row: its filename, or its URL for static URLs."""
+    data = dict(row)
+    return data.get("file") or data.get("url") or ""
+
+
+def three_way_set(
+    base: Iterable[Any], ours: Iterable[Any], theirs: Iterable[Any]
+) -> list[Any]:
+    """Classic three-way set merge.
+
+    An element survives when it is kept (or added) by both sides, or added by
+    exactly one side.  A deletion by one side wins over an unchanged element
+    on the other side.
+    """
+    b, o, t = set(base), set(ours), set(theirs)
+    merged = (o & t) | (o - b) | (t - b)
+    return sorted(merged)
+
+
+@dataclasses.dataclass(frozen=True)
+class PackageEntry:
+    """A canonical ``[[package]]`` entry of a PDM lockfile.
+
+    All collection fields are stored in a normalized (sorted, deduplicated)
+    form so that two entries can be compared semantically regardless of the
+    ordering chosen by the writer.
+    """
+
+    name: str
+    version: str | None = None
+    requires_python: str = ""
+    summary: str = ""
+    marker: str | None = None
+    groups: tuple[str, ...] = ()
+    extras: tuple[str, ...] = ()
+    dependencies: tuple[str, ...] = ()
+    files: tuple[tuple[tuple[str, str], ...], ...] = ()
+    request: tuple[tuple[str, Any], ...] = ()
+
+    @classmethod
+    def from_mapping(cls, data: Mapping[str, Any]) -> PackageEntry:
+        """Build a canonical entry from a raw lockfile package table."""
+        try:
+            name = data["name"]
+        except KeyError:
+            raise MergeError(f"Package entry without a name: {data!r}") from None
+        request = tuple(
+            sorted((k, v) for k, v in data.items() if k in _REQUEST_FIELDS and v not in (None, "", False))
+        )
+        files = tuple(
+            sorted(
+                {_canon_file_row(row) for row in data.get("files", [])},
+                key=_file_row_key,
+            )
+        )
+        return cls(
+            name=normalize_name(str(name)),
+            version=str(data["version"]) if data.get("version") is not None else None,
+            requires_python=str(data.get("requires_python") or ""),
+            summary=str(data.get("summary") or ""),
+            marker=str(data["marker"]) if data.get("marker") is not None else None,
+            groups=tuple(sorted({str(g) for g in data.get("groups", [])})),
+            extras=tuple(sorted({str(e) for e in data.get("extras", [])})),
+            dependencies=tuple(sorted({str(d) for d in data.get("dependencies", [])})),
+            files=files,
+            request=request,
+        )
+
+    @property
+    def key(self) -> tuple[str, tuple[str, ...], str, str, bool]:
+        """The merge key identifying the requirement across revisions."""
+        request = dict(self.request)
+        source = str(request.get("url") or request.get("path") or request.get("git") or "")
+        return (
+            normalize_name(self.name),
+            self.extras,
+            self.marker or "",
+            source,
+            bool(request.get("editable", False)),
+        )
+
+    @property
+    def identity(self) -> tuple[str, tuple[str, ...], str, bool]:
+        """The package identity ignoring the environment marker.
+
+        Entries sharing an identity but carrying different markers (split
+        pins for different Python versions/platforms) form a marker group;
+        the group is merged as a unit when both sides restructured it.
+        """
+        key = self.key
+        return (key[0], key[1], key[3], key[4])
+
+    @property
+    def sort_key(self) -> tuple[str, str, str, str]:
+        """Deterministic ordering key used when rendering the lockfile."""
+        return (
+            normalize_name(self.name),
+            ",".join(self.extras),
+            self.version or "",
+            self.marker or "",
+        )
+
+    def describe(self) -> str:
+        """A short human readable description used in conflict reports."""
+        parts = [self.name]
+        if self.extras:
+            parts.append(f"[{','.join(self.extras)}]")
+        if self.version is not None:
+            parts.append(f" {self.version}")
+        if self.marker:
+            parts.append(f"; {self.marker}")
+        return "".join(parts)
+
+    def _field_value(self, field: str) -> Any:
+        return getattr(self, field)
+
+    def merge_fields(self, base: PackageEntry, other: PackageEntry) -> PackageEntry:
+        """Merge this entry with ``other`` field by field against ``base``.
+
+        Both entries are known to differ from ``base`` and from each other.
+        Returns the merged entry, or raises :class:`_FieldConflict` naming the
+        field that cannot be reconciled.
+        """
+        updates: dict[str, Any] = {}
+        for field in _SCALAR_FIELDS:
+            b, o, t = base._field_value(field), self._field_value(field), other._field_value(field)
+            if o == t:
+                updates[field] = o
+            elif o == b:
+                updates[field] = t
+            elif t == b:
+                updates[field] = o
+            else:
+                raise _FieldConflict(field)
+        for field in _SET_FIELDS:
+            updates[field] = tuple(
+                three_way_set(base._field_value(field), self._field_value(field), other._field_value(field))
+            )
+        updates["files"] = _merge_file_rows(base.files, self.files, other.files)
+        updates["request"] = _merge_request(base.request, self.request, other.request)
+        return dataclasses.replace(self, **updates)
+
+
+class _FieldConflict(Exception):
+    """Internal signal carrying the name of the conflicting field."""
+
+    def __init__(self, field: str) -> None:
+        self.field = field
+        super().__init__(field)
+
+
+def _merge_file_rows(
+    base: tuple[tuple[tuple[str, str], ...], ...],
+    ours: tuple[tuple[tuple[str, str], ...], ...],
+    theirs: tuple[tuple[tuple[str, str], ...], ...],
+) -> tuple[tuple[tuple[str, str], ...], ...]:
+    """Merge file hash rows keyed by filename.
+
+    Rows with the same filename on both sides must agree after the three-way
+    reconciliation, otherwise the hashes belong to different artifacts and the
+    entry is in conflict.
+    """
+    result: dict[str, tuple[tuple[str, str], ...]] = {}
+    b = {_file_row_key(row): row for row in base}
+    o = {_file_row_key(row): row for row in ours}
+    t = {_file_row_key(row): row for row in theirs}
+    for name in b | o | t:  # type: ignore[operator]
+        rb, ro, rt = b.get(name), o.get(name), t.get(name)
+        if ro == rt:
+            if ro is not None:
+                result[name] = ro
+        elif ro == rb:
+            if rt is not None:
+                result[name] = rt
+        elif rt == rb:
+            if ro is not None:
+                result[name] = ro
+        else:
+            raise _FieldConflict("files")
+    return tuple(result[name] for name in sorted(result))
+
+
+def _merge_request(
+    base: tuple[tuple[str, Any], ...],
+    ours: tuple[tuple[str, Any], ...],
+    theirs: tuple[tuple[str, Any], ...],
+) -> tuple[tuple[str, Any], ...]:
+    """Three-way merge of the request attributes (url, ref, revision, ...)."""
+    b, o, t = dict(base), dict(ours), dict(theirs)
+    result: dict[str, Any] = {}
+    for key in b.keys() | o.keys() | t.keys():
+        rb, ro, rt = b.get(key), o.get(key), t.get(key)
+        if ro == rt:
+            if ro is not None:
+                result[key] = ro
+        elif ro == rb:
+            if rt is not None:
+                result[key] = rt
+        elif rt == rb:
+            if ro is not None:
+                result[key] = ro
+        else:
+            raise _FieldConflict(key)
+    return tuple(sorted(result.items()))
+
+
+@dataclasses.dataclass(frozen=True)
+class MergeConflict:
+    """A package entry that could not be merged automatically."""
+
+    key: tuple[str, tuple[str, ...], str, str, bool]
+    reason: str
+    field: str | None
+    base: PackageEntry | None
+    ours: PackageEntry | None
+    theirs: PackageEntry | None
+
+    @property
+    def package_name(self) -> str:
+        return self.key[0]
+
+    def describe_sides(self) -> list[str]:
+        """Render the state of each side for the conflict report."""
+
+        def _side(entry: PackageEntry | None) -> str:
+            return entry.describe() if entry is not None else "<removed>"
+
+        return [
+            f"base:   {_side(self.base)}",
+            f"ours:   {_side(self.ours)}",
+            f"theirs: {_side(self.theirs)}",
+        ]
+
+
+@dataclasses.dataclass
+class LockMetadata:
+    """The ``[metadata]`` table of a PDM lockfile, in mergeable form."""
+
+    groups: tuple[str, ...] = ()
+    strategy: frozenset[str] = frozenset()
+    targets: tuple[str, ...] = ()  # canonical JSON blobs
+    lock_version: str = ""
+    content_hash: str = ""
+    lock_inputs: str | None = None  # canonical JSON blob
+
+    @classmethod
+    def from_mapping(cls, data: Mapping[str, Any]) -> LockMetadata:
+        metadata = data.get("metadata", {})
+        strategy = set(metadata.get("strategy", []))
+        # Legacy boolean flags are folded into the strategy set, mirroring
+        # how ``PDMLock.strategy`` interprets them.
+        if metadata.get("static_urls"):
+            strategy.add("static_urls")
+        if metadata.get("cross_platform") is not False and not metadata.get("strategy"):
+            strategy.add("cross_platform")
+        return cls(
+            groups=tuple(sorted({str(g) for g in metadata.get("groups", [])})),
+            strategy=frozenset(strategy),
+            targets=tuple(sorted({_canon_json(t) for t in metadata.get("targets", [])})),
+            lock_version=str(metadata.get("lock_version", "")),
+            content_hash=str(metadata.get("content_hash", "")),
+            lock_inputs=(
+                _canon_json(metadata["lock_inputs"]) if metadata.get("lock_inputs") is not None else None
+            ),
+        )
+
+
+def load_lockfile_data(path: str | Path) -> dict[str, Any]:
+    """Read and validate a PDM lockfile for merging.
+
+    Only the PDM lockfile format is supported; ``pylock.toml`` documents must
+    be converted first.  The lock version must be compatible with this PDM
+    version, i.e. readable according to the same rules used by ``PDMLock``.
+    """
+    path = Path(path)
+    try:
+        with open(path, "rb") as fp:
+            data = tomllib.load(fp)
+    except FileNotFoundError:
+        raise PdmUsageError(f"Lockfile not found: {path}") from None
+    except tomllib.TOMLDecodeError as e:
+        raise PdmUsageError(f"Cannot parse {path} as TOML: {e}") from None
+    metadata = data.get("metadata", {})
+    if not isinstance(metadata, Mapping) or "lock_version" not in metadata:
+        if "lock-version" in data:
+            raise PdmUsageError(
+                f"{path} is a pylock.toml file, only the PDM lockfile format can be merged."
+            )
+        raise PdmUsageError(f"{path} is not a PDM lockfile: missing [metadata] lock_version.")
+    file_version = parse_version(str(metadata["lock_version"]))
+    spec = PDMLock.spec_version
+    if file_version.major != spec.major or file_version.minor > spec.minor:
+        raise PdmUsageError(
+            f"{path} was written by an incompatible PDM version (lock_version {file_version}, "
+            f"supported: {spec}). Please regenerate it with this PDM first."
+        )
+    if not isinstance(data.get("package", []), list):
+        raise PdmUsageError(f"{path} is malformed: [[package]] must be an array of tables.")
+    return data
+
+
+def _pick_by_strategy(
+    strategy: ConflictStrategy,
+    ours: PackageEntry | None,
+    theirs: PackageEntry | None,
+) -> tuple[PackageEntry | None, bool]:
+    """Resolve a whole-entry conflict with the given strategy.
+
+    Returns the winning entry (``None`` for deletion) and whether the
+    strategy could decide at all -- ``FAIL`` never decides.
+    """
+    if strategy is ConflictStrategy.FAIL:
+        return None, False
+    if strategy is ConflictStrategy.OURS:
+        return ours, True
+    if strategy is ConflictStrategy.THEIRS:
+        return theirs, True
+    # NEWER: a modification always wins over a deletion.
+    if ours is None or theirs is None:
+        return (theirs if ours is None else ours), True
+
+    def _version_key(entry: PackageEntry) -> Any:
+        try:
+            return (1, parse_version(entry.version or ""))
+        except Exception:
+            return (0, entry.version or "")
+
+    if _version_key(ours) > _version_key(theirs):
+        return ours, True
+    # Ties and unparseable versions go to the incoming change.
+    return theirs, True
+
+
+def _merge_entry(
+    key: tuple[str, tuple[str, ...], str, str, bool],
+    base: PackageEntry | None,
+    ours: PackageEntry | None,
+    theirs: PackageEntry | None,
+    strategy: ConflictStrategy,
+    conflicts: list[MergeConflict],
+    resolved: list[MergeConflict],
+) -> PackageEntry | None:
+    """Merge a single package entry three-way, honoring the strategy."""
+    if ours == theirs:
+        return ours
+    reason: str
+    field: str | None = None
+    if base is None:
+        if ours is None:  # added by theirs only
+            return theirs
+        if theirs is None:  # added by ours only
+            return ours
+        reason = "added on both sides with different content"
+    elif ours is None or theirs is None:
+        changed = theirs if ours is None else ours
+        if changed == base:  # one side removed it, the other kept it unchanged
+            return None
+        reason = "removed on one side, modified on the other"
+    elif ours == base:
+        return theirs
+    elif theirs == base:
+        return ours
+    else:
+        assert ours is not None and theirs is not None
+        try:
+            return ours.merge_fields(base, theirs)
+        except _FieldConflict as e:
+            reason = f"both sides changed {e.field!r} differently"
+            field = e.field
+    winner, decided = _pick_by_strategy(strategy, ours, theirs)
+    record = MergeConflict(key, reason, field, base, ours, theirs)
+    (resolved if decided else conflicts).append(record)
+    return winner if decided else None
+
+
+def _version_sort_key(entry: PackageEntry) -> Any:
+    try:
+        return (1, parse_version(entry.version or ""))
+    except Exception:
+        return (0, entry.version or "")
+
+
+def _merge_marker_group(
+    identity: tuple[str, tuple[str, ...], str, bool],
+    base: list[PackageEntry],
+    ours: list[PackageEntry],
+    theirs: list[PackageEntry],
+    strategy: ConflictStrategy,
+    conflicts: list[MergeConflict],
+    resolved: list[MergeConflict],
+) -> list[PackageEntry]:
+    """Merge entries sharing one identity but (possibly) different markers.
+
+    When only one side restructured the marker set (added, removed or changed
+    markers) the entries are reconciled key by key; when *both* sides changed
+    the marker structure in different ways the whole group is a conflict and
+    the strategy picks a side.
+    """
+    base_keys = {e.key for e in base}
+    ours_keys = {e.key for e in ours}
+    theirs_keys = {e.key for e in theirs}
+    if ours_keys == theirs_keys or ours_keys == base_keys or theirs_keys == base_keys:
+        # At most one side restructured the group: plain per-key merge.
+        base_by_key = {e.key: e for e in base}
+        ours_by_key = {e.key: e for e in ours}
+        theirs_by_key = {e.key: e for e in theirs}
+        merged: list[PackageEntry] = []
+        for key in sorted(base_keys | ours_keys | theirs_keys):
+            entry = _merge_entry(
+                key,
+                base_by_key.get(key),
+                ours_by_key.get(key),
+                theirs_by_key.get(key),
+                strategy,
+                conflicts,
+                resolved,
+            )
+            if entry is not None:
+                merged.append(entry)
+        return merged
+    # Both sides changed the marker structure differently.
+    representative_key = sorted(base_keys | ours_keys | theirs_keys)[0]
+
+    def _representative(entries: list[PackageEntry]) -> PackageEntry | None:
+        return max(entries, key=_version_sort_key) if entries else None
+
+    if strategy is ConflictStrategy.FAIL:
+        winner_entries: list[PackageEntry] = []
+        decided = False
+    elif strategy is ConflictStrategy.OURS:
+        winner_entries, decided = ours, True
+    elif strategy is ConflictStrategy.THEIRS:
+        winner_entries, decided = theirs, True
+    else:  # NEWER: the side with the highest pin wins; ties go to theirs.
+        ours_best = _version_sort_key(_representative(ours)) if ours else None
+        theirs_best = _version_sort_key(_representative(theirs)) if theirs else None
+        if ours_best is not None and theirs_best is not None and ours_best > theirs_best:
+            winner_entries, decided = ours, True
+        else:
+            winner_entries, decided = theirs, True
+    record = MergeConflict(
+        representative_key,
+        "marker structure changed on both sides",
+        "marker",
+        _representative(base),
+        _representative(ours),
+        _representative(theirs),
+    )
+    (resolved if decided else conflicts).append(record)
+    return winner_entries
+
+
+def _merge_metadata(
+    base: LockMetadata, ours: LockMetadata, theirs: LockMetadata
+) -> LockMetadata:
+    """Merge the ``[metadata]`` tables of the three revisions."""
+    groups = three_way_set(base.groups, ours.groups, theirs.groups)
+    targets = three_way_set(base.targets, ours.targets, theirs.targets)
+    if ours.strategy == theirs.strategy:
+        strategy = ours.strategy
+    elif ours.strategy == base.strategy:
+        strategy = theirs.strategy
+    elif theirs.strategy == base.strategy:
+        strategy = ours.strategy
+    else:
+        raise MergeError(
+            "The lock strategy flags diverged on both sides "
+            f"(ours: {sorted(ours.strategy)}, theirs: {sorted(theirs.strategy)}); "
+            "the lockfiles cannot be merged safely. Re-run `pdm lock` with a single strategy first."
+        )
+    if ours.lock_version == theirs.lock_version:
+        lock_version = ours.lock_version
+    else:
+        lock_version = str(max(parse_version(ours.lock_version), parse_version(theirs.lock_version)))
+    if ours.content_hash == theirs.content_hash or theirs.content_hash == base.content_hash:
+        content_hash = ours.content_hash
+    elif ours.content_hash == base.content_hash:
+        content_hash = theirs.content_hash
+    else:
+        # Both sides regenerated the hash; the working copy wins because the
+        # merged result is written on top of it.
+        content_hash = ours.content_hash
+    if ours.lock_inputs == theirs.lock_inputs or theirs.lock_inputs == base.lock_inputs:
+        lock_inputs = ours.lock_inputs
+    elif ours.lock_inputs == base.lock_inputs:
+        lock_inputs = theirs.lock_inputs
+    else:
+        lock_inputs = ours.lock_inputs
+    return LockMetadata(
+        groups=tuple(groups),
+        strategy=strategy,
+        targets=tuple(targets),
+        lock_version=lock_version,
+        content_hash=content_hash,
+        lock_inputs=lock_inputs,
+    )
+
+
+@dataclasses.dataclass
+class MergeResult:
+    """The outcome of a three-way lockfile merge."""
+
+    packages: list[PackageEntry]
+    metadata: LockMetadata
+    conflicts: list[MergeConflict] = dataclasses.field(default_factory=list)
+    resolved: list[MergeConflict] = dataclasses.field(default_factory=list)
+    added_packages: list[str] = dataclasses.field(default_factory=list)
+    removed_packages: list[str] = dataclasses.field(default_factory=list)
+    updated_packages: list[str] = dataclasses.field(default_factory=list)
+
+    @property
+    def clean(self) -> bool:
+        """Whether the merge completed without unresolved conflicts."""
+        return not self.conflicts
+
+    @property
+    def added(self) -> int:
+        return len(self.added_packages)
+
+    @property
+    def removed(self) -> int:
+        return len(self.removed_packages)
+
+    @property
+    def updated(self) -> int:
+        return len(self.updated_packages)
+
+    def change_lines(self) -> list[str]:
+        """Human readable lines describing every change against the base."""
+        lines = [f"  add {name}" for name in self.added_packages]
+        lines += [f"  remove {name}" for name in self.removed_packages]
+        lines += [f"  update {name}" for name in self.updated_packages]
+        return lines
+
+
+def merge_lock_data(
+    base: Mapping[str, Any],
+    ours: Mapping[str, Any],
+    theirs: Mapping[str, Any],
+    on_conflict: ConflictStrategy = ConflictStrategy.FAIL,
+) -> MergeResult:
+    """Merge three parsed lockfile documents and return the result.
+
+    The function never touches the filesystem or the network; rendering and
+    writing the document is left to :func:`render_lock_document` and the
+    caller.
+    """
+
+    def _index(data: Mapping[str, Any]) -> dict[tuple, PackageEntry]:
+        indexed: dict[tuple, PackageEntry] = {}
+        for raw in data.get("package", []):
+            entry = PackageEntry.from_mapping(raw)
+            if entry.key in indexed:
+                raise MergeError(
+                    f"Duplicate lockfile entry for {entry.describe()!r}; "
+                    "the lockfile is inconsistent, regenerate it with `pdm lock`."
+                )
+            indexed[entry.key] = entry
+        return indexed
+
+    base_entries = _index(base)
+    ours_entries = _index(ours)
+    theirs_entries = _index(theirs)
+    conflicts: list[MergeConflict] = []
+    resolved: list[MergeConflict] = []
+    packages: list[PackageEntry] = []
+
+    def _group_by_identity(entries: dict[tuple, PackageEntry]) -> dict[tuple, list[PackageEntry]]:
+        grouped: dict[tuple, list[PackageEntry]] = {}
+        for entry in entries.values():
+            grouped.setdefault(entry.identity, []).append(entry)
+        return grouped
+
+    base_groups = _group_by_identity(base_entries)
+    ours_groups = _group_by_identity(ours_entries)
+    theirs_groups = _group_by_identity(theirs_entries)
+    for identity in sorted(base_groups.keys() | ours_groups.keys() | theirs_groups.keys()):
+        packages.extend(
+            _merge_marker_group(
+                identity,
+                base_groups.get(identity, []),
+                ours_groups.get(identity, []),
+                theirs_groups.get(identity, []),
+                on_conflict,
+                conflicts,
+                resolved,
+            )
+        )
+    metadata = _merge_metadata(
+        LockMetadata.from_mapping(base),
+        LockMetadata.from_mapping(ours),
+        LockMetadata.from_mapping(theirs),
+    )
+    base_keys = set(base_entries)
+    merged_by_key = {entry.key: entry for entry in packages}
+    added = sorted(merged_by_key[key].describe() for key in set(merged_by_key) - base_keys)
+    removed = sorted(base_entries[key].describe() for key in base_keys - set(merged_by_key))
+    updated = sorted(
+        merged_by_key[key].describe()
+        for key in set(merged_by_key) & base_keys
+        if merged_by_key[key] != base_entries[key]
+    )
+    return MergeResult(
+        packages=packages,
+        metadata=metadata,
+        conflicts=conflicts,
+        resolved=resolved,
+        added_packages=added,
+        removed_packages=removed,
+        updated_packages=updated,
+    )
+
+
+def merge_lockfiles(
+    base_path: str | Path,
+    ours_path: str | Path,
+    theirs_path: str | Path,
+    on_conflict: ConflictStrategy = ConflictStrategy.FAIL,
+) -> MergeResult:
+    """Load three lockfiles from disk and merge them."""
+    return merge_lock_data(
+        load_lockfile_data(base_path),
+        load_lockfile_data(ours_path),
+        load_lockfile_data(theirs_path),
+        on_conflict,
+    )
+
+
+def _group_sort_key(group: str) -> tuple[bool, str]:
+    return group != "default", group
+
+
+def render_lock_document(result: MergeResult) -> tomlkit.TOMLDocument:
+    """Render the merge result as a PDM lockfile TOML document.
+
+    The layout mirrors ``PDMLock.format_lockfile``: generated-file comments,
+    a ``[metadata]`` table and one ``[[package]]`` table per entry sorted by
+    package identity.
+    """
+    from pdm.formats.base import make_array, make_inline_table
+
+    doc = tomlkit.document()
+    for line in GENERATED_COMMENTS:
+        doc.append(None, tomlkit.comment(line))
+    metadata = tomlkit.table()
+    metadata.update(
+        {
+            "groups": sorted(result.metadata.groups, key=_group_sort_key),
+            "strategy": sorted(result.metadata.strategy),
+            "targets": [json.loads(t) for t in result.metadata.targets],
+            "lock_version": result.metadata.lock_version,
+            "content_hash": result.metadata.content_hash,
+        }
+    )
+    if result.metadata.lock_inputs is not None:
+        metadata["lock_inputs"] = json.loads(result.metadata.lock_inputs)
+    doc.add("metadata", metadata)
+    packages = tomlkit.aot()
+    for entry in sorted(result.packages, key=lambda e: e.sort_key):
+        row = tomlkit.table()
+        row.add("name", entry.name)
+        if entry.version is not None:
+            row.add("version", entry.version)
+        if entry.extras:
+            row.add("extras", list(entry.extras))
+        if entry.requires_python:
+            row.add("requires_python", entry.requires_python)
+        for key, value in entry.request:
+            row.add(key, value)
+        row.add("summary", entry.summary)
+        if entry.groups:
+            row.add("groups", sorted(entry.groups, key=_group_sort_key))
+        if entry.marker is not None:
+            row.add("marker", entry.marker)
+        if entry.dependencies:
+            row.add("dependencies", make_array(sorted(entry.dependencies), True))
+        if entry.files:
+            collected = []
+            for file_row in sorted(entry.files, key=_file_row_key):
+                collected.append(make_inline_table(dict(file_row)))
+            row.add("files", make_array(collected, True))
+        packages.append(row)
+    doc.add("package", packages)
+    return doc
+
+
+_CONFLICT_REASONS = {
+    "added on both sides with different content": "added on both sides",
+    "removed on one side, modified on the other": "removed vs modified",
+    "marker structure changed on both sides": "marker structure diverged",
+}
+
+
+def format_conflict_report(conflicts: Iterable[MergeConflict]) -> str:
+    """Render a human readable report of unresolved conflicts."""
+    lines = ["Lockfile merge conflicts:", ""]
+    for conflict in sorted(conflicts, key=lambda c: c.key):
+        reason = _CONFLICT_REASONS.get(conflict.reason, conflict.reason)
+        lines.append(rf"  \[conflict] {conflict.package_name} ({reason})")
+        lines.extend(f"    {line}" for line in conflict.describe_sides())
+        lines.append("")
+    lines.append(
+        "Resolve the conflicts manually or re-run with --on-conflict=newer|ours|theirs "
+        "to pick a side automatically."
+    )
+    return "\n".join(lines)
+
+
+def _conflict_to_dict(conflict: MergeConflict) -> dict[str, Any]:
+    """Serialize a conflict record for the JSON report."""
+
+    def _side(entry: PackageEntry | None) -> dict[str, Any] | None:
+        if entry is None:
+            return None
+        return {
+            "name": entry.name,
+            "version": entry.version,
+            "marker": entry.marker,
+            "groups": list(entry.groups),
+            "dependencies": list(entry.dependencies),
+        }
+
+    return {
+        "package": conflict.package_name,
+        "reason": conflict.reason,
+        "field": conflict.field,
+        "base": _side(conflict.base),
+        "ours": _side(conflict.ours),
+        "theirs": _side(conflict.theirs),
+    }
+
+
+def format_json_report(result: MergeResult) -> str:
+    """Render a machine readable (JSON) merge report.
+
+    The report contains the merge outcome, the list of changes against the
+    base revision and the unresolved as well as the strategy-resolved
+    conflicts, so automation (merge drivers, CI checks) can react without
+    parsing the human output.
+    """
+    report = {
+        "clean": result.clean,
+        "packages": len(result.packages),
+        "changes": {
+            "added": result.added_packages,
+            "removed": result.removed_packages,
+            "updated": result.updated_packages,
+        },
+        "conflicts": [_conflict_to_dict(c) for c in result.conflicts],
+        "resolved": [_conflict_to_dict(c) for c in result.resolved],
+        "metadata": {
+            "groups": list(result.metadata.groups),
+            "strategy": sorted(result.metadata.strategy),
+            "lock_version": result.metadata.lock_version,
+            "content_hash": result.metadata.content_hash,
+        },
+    }
+    return json.dumps(report, indent=2, sort_keys=True)
