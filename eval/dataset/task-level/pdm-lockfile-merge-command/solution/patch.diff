+class TestStrategyEndToEnd:
+    @pytest.mark.parametrize("strategy,expected", [("ours", "1.1"), ("theirs", "1.2"), ("newer", "1.2")])
+    def test_version_conflict_strategies(self, pdm, project, three_locks, strategy, expected):
+        base, ours, theirs = three_locks(
+            lock_data([pkg("a", "1.0")]),
+            lock_data([pkg("a", "1.1")]),
+            lock_data([pkg("a", "1.2")]),
+        )
+        result, out = run_merge(pdm, project, base, ours, theirs, f"--on-conflict={strategy}")
+        assert "resolved" in result.outputs
+        assert package_map(read_lock(out))["a"]["version"] == expected
+
+    def test_newer_keeps_modification_over_removal(self, pdm, project, three_locks):
+        base, ours, theirs = three_locks(
+            lock_data([pkg("a", "1.0"), pkg("b", "1.0")]),
+            lock_data([pkg("a", "1.5"), pkg("b", "1.0")]),
+            lock_data([pkg("b", "1.0")]),
+        )
+        result, out = run_merge(pdm, project, base, ours, theirs, "--on-conflict=newer")
+        assert result.exit_code == 0, result.outputs
+        merged = package_map(read_lock(out))
+        assert merged["a"]["version"] == "1.5"
+
+    def test_ours_applies_removal(self, pdm, project, three_locks):
+        base, ours, theirs = three_locks(
+            lock_data([pkg("a", "1.0"), pkg("b", "1.0")]),
+            lock_data([pkg("b", "1.0")]),  # removed a
+            lock_data([pkg("a", "1.5"), pkg("b", "1.0")]),  # upgraded a
+        )
+        result, out = run_merge(pdm, project, base, ours, theirs, "--on-conflict=ours")
+        assert result.exit_code == 0, result.outputs
+        assert set(package_map(read_lock(out))) == {"b"}
+
+    def test_multiple_conflicts_reported_together(self, pdm, project, three_locks):
+        base, ours, theirs = three_locks(
+            lock_data([pkg("a", "1.0"), pkg("b", "1.0"), pkg("c", "1.0")]),
+            lock_data([pkg("a", "1.1"), pkg("b", "1.1"), pkg("c", "1.0")]),
+            lock_data([pkg("a", "1.2"), pkg("b", "1.2"), pkg("c", "1.0")]),
+        )
+        out = ours.parent / "merged.lock"
+        result = pdm(
+            ["merge-lock", str(base), str(ours), str(theirs), "-o", str(out)],
+            obj=project,
+        )
+        assert result.exit_code != 0
+        assert "a (both sides changed 'version' differently)" in result.stderr
+        assert "b (both sides changed 'version' differently)" in result.stderr
+        assert "c (both sides changed" not in result.stderr
+
