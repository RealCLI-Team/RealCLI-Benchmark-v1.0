+    def restore(self, snapshot: dict[int, Any]) -> None:
+        """Overwrite this session's stateful values from a prior ``snapshot``.
+
+        Each ``(component_id, value)`` pair from ``snapshot`` is deep-copied
+        into the session, replacing whatever value the session previously
+        held for that stateful component. Keys that refer to blocks the
+        current app no longer has are silently skipped, so a snapshot taken
+        against one app version can be replayed against a compatible variant.
