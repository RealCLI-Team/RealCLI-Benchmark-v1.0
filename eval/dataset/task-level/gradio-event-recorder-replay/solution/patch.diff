+class TestIndexContinuity:
+    def test_event_index_continues_across_restarts(self, tmp_path):
+        demo = make_number_app(add)
+        path = tmp_path / "rec.jsonl"
+        rec = EventRecorder(demo, path).start()
+        state = SessionState(demo)
+        for i in range(3):
+            run(demo.process_api(0, [float(i), 0.0], state=state, session_hash="s"))
+        rec.stop()
+        rec.start()
+        for i in range(3, 6):
+            run(demo.process_api(0, [float(i), 0.0], state=state, session_hash="s"))
+        rec.close()
+        events = gr.load_events(path)
+        assert [e["index"] for e in events] == list(range(6))
+        assert [e["outputs"] for e in events] == [[float(i)] for i in range(6)]
