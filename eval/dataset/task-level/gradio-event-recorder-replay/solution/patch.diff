@@ -0,0 +1,998 @@
+"""Record and replay the backend function calls of a Gradio app.
+
+This module implements an event recording and replay mechanism for Blocks apps.
+An :class:`EventRecorder` attached to a :class:`gradio.Blocks` instance captures
+every backend function invocation (api name, inputs, outputs, session hash,
+errors, duration) to a JSONL record file, whether the call comes from the HTTP
+API routes, the queue, or a direct ``Blocks.process_api()`` call.
+:func:`replay_events` then re-executes a record file against a (possibly
+modified) app and reports which events still produce the recorded outputs and
+which ones diverge.
+
+The recorder plugs into ``Blocks`` through the public call-hook registry
+(``add_call_hook`` / ``remove_call_hook``), so it needs no server, no
+browser, and no monkey-patching of gradio internals. It writes each event as
+one canonical (sorted-key, unicode-preserving) JSON line, with a per-line
+integrity checksum that chains back to the header — a record file that is
+edited, reordered, or has a line dropped will fail to load. The record
+file's serialization goes through ``gradio.utils.canonical_json_dumps`` so
+it is stable, byte-for-byte, across runs and diffable.
+
+Typical workflow:
+
+1. Attach an :class:`EventRecorder` to a running app and let real usage (or
+   a scripted session) produce a record file.
+2. After changing the app's code, call :func:`replay_events` with the record
+   file to get a :class:`ReplayReport` describing any behavioral
+   differences.
+
+Guarantees:
+
+* Recording is a thin wrapper around ``Blocks.process_api()``: it works
+  from any transport (HTTP, queue, direct call) and never starts a server.
+* Recording never observes calls made during a ``replay_events()`` run
+  (a per-blocks counter suspends every attached recorder for the duration
+  of a replay).
+* When no recorders and no other call hooks are attached, ``process_api``
+  takes a zero-overhead fast path that does not allocate a context dict.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import copy
+import hashlib
+import json
+import threading
+import time
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, Iterable, Sequence
+
+from gradio.state_holder import SessionState
+from gradio.utils import canonical_json_dumps
+
+if TYPE_CHECKING:
+    from gradio.block_function import BlockFunction
+    from gradio.blocks import Blocks
+
+RECORD_FORMAT_VERSION = 1
+HEADER_RECORD_TYPE = "header"
+EVENT_RECORD_TYPE = "event"
+REDACTED_VALUE = "***"
+
+#: Valid per-event statuses in a replay report.
+STATUS_MATCH = "match"
+STATUS_MISMATCH = "mismatch"
+STATUS_MISSING = "missing"
+STATUS_ERROR = "error"
+
+#: Reserved event field whose value is a checksum chained from the previous
+#: line. It exists on both header and event lines and is what makes a record
+#: file tamper-evident (see ``_next_chain`` / ``read_record``).
+_CHECKSUM_FIELD = "checksum"
+
+__all__ = [
+    "EventRecorder",
+    "ReplayReport",
+    "ReplayResult",
+    "load_events",
+    "read_record",
+    "replay_events",
+]
+
+
+# ----------------------------------------------------------------------
+# helpers
+# ----------------------------------------------------------------------
+
+
+def _json_safe(value: Any) -> Any:
+    """Convert an arbitrary value to a JSON-compatible structure.
+
+    Pydantic models (e.g. the data models produced by components such as
+    ``gr.JSON``) are dumped to plain dicts/lists first. Values that are
+    still not natively JSON serializable afterwards (sets, custom objects)
+    fall back to their string representation. Tuples are normalized to
+    lists. This keeps record files portable and diffable.
+    """
+    model_dump = getattr(value, "model_dump", None)
+    if callable(model_dump):
+        try:
+            return _json_safe(model_dump())
+        except Exception:
+            pass
+    if isinstance(value, dict):
+        return {str(k): _json_safe(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe(v) for v in value]
+    try:
+        json.dumps(value)
+        return value
+    except (TypeError, ValueError):
+        return str(value)
+
+
+def _exception_name(exc: BaseException | str) -> str:
+    """Return the class name of an exception (or pass through a name string)."""
+    if isinstance(exc, str):
+        return exc
+    return type(exc).__name__
+
+
+def _block_label(block: Any) -> str | None:
+    """Return the label of a component, or ``None`` if it has none."""
+    label = getattr(block, "label", None)
+    return label if isinstance(label, str) else None
+
+
+def capture_effective_inputs(
+    block_fn: BlockFunction,
+    raw_inputs: Sequence[Any],
+    state: SessionState | None,
+) -> list[Any]:
+    """Capture the input values the backend function actually sees.
+
+    For regular components this is the raw payload value. For stateful
+    components (``gr.State``) the raw payload is ignored by the runtime and
+    the function receives the current session value instead, so the session
+    value is what gets recorded. When no session is available the
+    component's declared default value is used as a best-effort stand-in.
+    """
+    effective: list[Any] = []
+    for i, block in enumerate(block_fn.inputs):
+        raw = raw_inputs[i] if i < len(raw_inputs) else None
+        if getattr(block, "stateful", False):
+            if isinstance(state, SessionState):
+                value = state[block._id]
+            else:
+                value = getattr(block, "value", None)
+            effective.append(copy.deepcopy(value))
+        else:
+            effective.append(copy.deepcopy(raw))
+    return effective
+
+
+def capture_effective_outputs(
+    block_fn: BlockFunction,
+    data: Sequence[Any],
+    state: SessionState | None,
+) -> list[Any]:
+    """Capture the output values produced by a backend function call.
+
+    For regular components this is the postprocessed payload value. For
+    stateful components (``gr.State``) the payload position holds a
+    placeholder (usually ``None``) and the meaningful value is the new
+    session value, so the new session value is recorded when a session is
+    available.
+    """
+    effective: list[Any] = []
+    for i, block in enumerate(block_fn.outputs):
+        value = data[i] if i < len(data) else None
+        if getattr(block, "stateful", False) and isinstance(state, SessionState):
+            value = state[block._id]
+        effective.append(copy.deepcopy(value))
+    return effective
+
+
+# ----------------------------------------------------------------------
+# integrity chain
+# ----------------------------------------------------------------------
+
+
+def _hash_hex(data: str) -> str:
+    """Return the hex-encoded SHA-256 of ``data`` (as UTF-8 bytes)."""
+    return hashlib.sha256(data.encode("utf-8")).hexdigest()
+
+
+def _seed_chain(header_without_checksum: dict[str, Any]) -> str:
+    """Compute the initial chain value from a header record.
+
+    The header's own ``checksum`` field is the SHA-256 of the canonical JSON
+    of the rest of the header. It seeds the per-event chain below so that
+    the first event is bound to the header, and modifying the header
+    (e.g. downgrading the format version) invalidates every event that
+    follows.
+    """
+    canonical = canonical_json_dumps(header_without_checksum)
+    return _hash_hex(canonical)
+
+
+def _next_chain(prev_chain: str, event_without_checksum: dict[str, Any]) -> str:
+    """Compute the next chain value from the previous chain and an event.
+
+    Each event's ``checksum`` field is the SHA-256 of the previous chain
+    value concatenated with the canonical JSON of the event minus its own
+    checksum. Because ``prev_chain`` is threaded through every line, any
+    change to any prior line — including reordering or dropping one —
+    breaks the chain from that point on.
+    """
+    canonical = canonical_json_dumps(event_without_checksum)
+    return _hash_hex(prev_chain + "\n" + canonical)
+
+
+# ----------------------------------------------------------------------
+# EventRecorder
+# ----------------------------------------------------------------------
+
+
+class EventRecorder:
+    """Records the backend function calls of a Blocks app to a JSONL file.
+
+    The recorder installs itself as a public call hook on the target
+    :class:`gradio.Blocks` when it starts recording, and removes itself
+    when it stops. Calls are captured regardless of whether they arrive
+    through the HTTP API routes, the queue, or a direct
+    ``Blocks.process_api()`` call, and no server or browser is required.
+
+    Each recorded call is written as one JSON line with sorted keys, ending
+    up on disk with the following canonical layout:
+
+    * ``api_name`` — the endpoint name (or the fn_name fallback);
+    * ``checksum`` — chained per-line SHA-256 (integrity, tamper-evident);
+    * ``duration`` — elapsed seconds spent inside the function;
+    * ``error`` — exception class name, or ``None`` on success;
+    * ``fn_name`` — the Python function's name;
+    * ``index`` — per-recorder monotonically increasing event index;
+    * ``inputs`` — captured effective input values (stateful values resolved);
+    * ``outputs`` — captured effective output values (or ``None`` on error);
+    * ``session_hash`` — the caller's session hash (may be ``None``);
+    * ``timestamp`` — POSIX seconds when the event was captured;
+    * ``type`` — always the literal string ``"event"``.
+
+    Example::
+
+        import gradio as gr
+
+        with gr.Blocks() as demo:
+            ...
+
+        with gr.EventRecorder(demo, "usage.jsonl"):
+            # ... drive the app through its API ...
+            pass
+
+        report = gr.replay_events(demo, "usage.jsonl")
+        assert report.ok
+    """
+
+    def __init__(
+        self,
+        blocks: Blocks,
+        record_path: str | Path,
+        include: Sequence[str] | None = None,
+        exclude: Sequence[str] | None = None,
+        redact: Sequence[str] | None = None,
+    ):
+        """
+        Parameters:
+            blocks: the Blocks app whose backend function calls are recorded.
+            record_path: path of the JSONL record file. The file (and its
+                parent directories) is created when recording starts.
+            include: if provided, only events whose api name or function
+                name matches one of these entries are recorded.
+            exclude: events whose api name or function name matches one of
+                these entries are skipped (applied after ``include``).
+            redact: input components whose label exactly matches one of
+                these entries have their recorded input value replaced by
+                ``"***"``.
+        """
+        self.blocks = blocks
+        self._record_path = Path(record_path)
+        self.include = list(include) if include is not None else None
+        self.exclude = list(exclude) if exclude is not None else None
+        self.redact = list(redact) if redact is not None else []
+        self._is_recording = False
+        self._events: list[dict[str, Any]] = []
+        self._lock = threading.Lock()
+        self._file = None
+        # The chain head is updated after every write; its initial value
+        # comes from the header. See ``_write_header_locked``.
+        self._chain: str | None = None
+        # A per-instance private key on the shared hook context — lets us
+        # stash the effective input snapshot captured on the ``before``
+        # phase without racing other recorders on the same blocks.
+        self._ctx_key = f"__event_recorder_{id(self)}__inputs"
+        self._hook_name = f"__event_recorder_{id(self)}"
+
+    # ------------------------------------------------------------------
+    # properties
+    # ------------------------------------------------------------------
+
+    @property
+    def record_path(self) -> Path:
+        """The path of the JSONL record file."""
+        return self._record_path
+
+    @property
+    def is_recording(self) -> bool:
+        """Whether the recorder is currently capturing events."""
+        return self._is_recording
+
+    @property
+    def events(self) -> list[dict[str, Any]]:
+        """A copy of the events recorded so far by this recorder."""
+        with self._lock:
+            return copy.deepcopy(self._events)
+
+    def __repr__(self) -> str:
+        state = "recording" if self._is_recording else "stopped"
+        return (
+            f"EventRecorder(record_path={str(self._record_path)!r}, "
+            f"events={len(self._events)}, {state})"
+        )
+
+    # ------------------------------------------------------------------
+    # recording lifecycle
+    # ------------------------------------------------------------------
+
+    def start(self) -> EventRecorder:
+        """Start recording. Idempotent: repeated calls have no extra effect.
+
+        The record file is created (with a header line) the first time
+        recording starts. Events are appended and flushed immediately so a
+        crashing process does not lose already-recorded events. Starting
+        also registers this recorder in the Blocks call-hook registry, so
+        ``blocks.get_call_hooks()`` will list one entry per active recorder.
+        """
+        with self._lock:
+            if self._is_recording:
+                return self
+            if self._file is None:
+                self._record_path.parent.mkdir(parents=True, exist_ok=True)
+                new_file = not self._record_path.exists()
+                self._file = open(self._record_path, "a", encoding="utf-8")
+                if new_file:
+                    self._write_header_locked()
+                else:
+                    # Resuming into an existing file: seed the chain from
+                    # the last line so subsequent events chain correctly.
+                    self._reseed_chain_locked()
+            self.blocks.add_call_hook(self._hook_name, self._on_event)
+            self._is_recording = True
+        return self
+
+    def stop(self) -> EventRecorder:
+        """Stop recording. Idempotent.
+
+        The recorder deregisters itself from the Blocks call-hook registry
+        but keeps its in-memory events. Calling ``start()`` again resumes
+        with a fresh hook registration and appends to the existing file.
+        """
+        with self._lock:
+            if self._is_recording:
+                self._is_recording = False
+                try:
+                    self.blocks.remove_call_hook(self._hook_name)
+                except Exception:
+                    pass
+            if self._file is not None:
+                try:
+                    self._file.flush()
+                finally:
+                    self._file.close()
+                self._file = None
+        return self
+
+    def close(self) -> None:
+        """Stop recording and detach the recorder from the Blocks instance."""
+        self.stop()
+
+    def __enter__(self) -> EventRecorder:
+        return self.start()
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+    # ------------------------------------------------------------------
+    # internal record writing
+    # ------------------------------------------------------------------
+
+    def _write_header_locked(self) -> None:
+        """Emit the header line and seed the integrity chain from it.
+
+        The header is written in canonical form (sorted keys, unicode
+        preserved) with a ``checksum`` field derived from the rest of the
+        header. That checksum becomes the seed of the per-event chain so
+        modifying header metadata invalidates every event line downstream.
+        """
+        body = {
+            "created_at": datetime.now(timezone.utc).isoformat(),
+            "format_version": RECORD_FORMAT_VERSION,
+            "gradio_version": _gradio_version(),
+            "type": HEADER_RECORD_TYPE,
+        }
+        self._chain = _seed_chain(body)
+        header = dict(body)
+        header[_CHECKSUM_FIELD] = self._chain
+        self._file.write(canonical_json_dumps(header) + "\n")
+        self._file.flush()
+
+    def _reseed_chain_locked(self) -> None:
+        """Restore the chain head when resuming into an existing file."""
+        try:
+            header, events = read_record(self._record_path)
+        except Exception:
+            # Best-effort: on a corrupt file, fall back to re-seeding from
+            # the header alone; a subsequent write may then fail integrity
+            # verification, which is exactly what a caller would want.
+            self._chain = None
+            return
+        if events:
+            self._chain = events[-1].get(_CHECKSUM_FIELD)
+        else:
+            body = {k: v for k, v in header.items() if k != _CHECKSUM_FIELD}
+            self._chain = _seed_chain(body)
+
+    def _should_record(self, block_fn: BlockFunction) -> bool:
+        """Whether a call to this function passes the include/exclude filters."""
+        names = {
+            name
+            for name in (
+                block_fn.api_name if isinstance(block_fn.api_name, str) else None,
+                block_fn.name,
+            )
+            if name
+        }
+        if self.include is not None and not names.intersection(self.include):
+            return False
+        if self.exclude is not None and names.intersection(self.exclude):
+            return False
+        return True
+
+    def _redact_inputs(
+        self, block_fn: BlockFunction, inputs: list[Any]
+    ) -> list[Any]:
+        """Redact input values whose component label matches a redact entry."""
+        if not self.redact:
+            return inputs
+        redacted = list(inputs)
+        for i, block in enumerate(block_fn.inputs):
+            if i >= len(redacted):
+                break
+            label = _block_label(block)
+            if label is not None and label in self.redact:
+                redacted[i] = REDACTED_VALUE
+        return redacted
+
+    def _record(
+        self,
+        block_fn: BlockFunction,
+        effective_inputs: list[Any],
+        data: Sequence[Any] | None,
+        state: SessionState | None,
+        session_hash: str | None,
+        error_name: str | None,
+        duration: float,
+    ) -> dict[str, Any] | None:
+        """Build, store and persist one event record."""
+        if not self.is_recording:
+            return None
+        if error_name is None:
+            outputs = capture_effective_outputs(block_fn, data or [], state)
+        else:
+            outputs = None
+        inputs = self._redact_inputs(block_fn, effective_inputs)
+        with self._lock:
+            if not self._is_recording:
+                return None
+            body = {
+                "api_name": (
+                    block_fn.api_name
+                    if isinstance(block_fn.api_name, str)
+                    else None
+                ),
+                "duration": duration,
+                "error": error_name,
+                "fn_name": block_fn.name,
+                "index": len(self._events),
+                "inputs": _json_safe(inputs),
+                "outputs": _json_safe(outputs),
+                "session_hash": session_hash,
+                "timestamp": time.time(),
+                "type": EVENT_RECORD_TYPE,
+            }
+            prev = self._chain or ""
+            chain = _next_chain(prev, body)
+            self._chain = chain
+            event = dict(body)
+            event[_CHECKSUM_FIELD] = chain
+            self._events.append(event)
+            if self._file is not None:
+                self._file.write(canonical_json_dumps(event) + "\n")
+                self._file.flush()
+        return copy.deepcopy(event)
+
+    # ------------------------------------------------------------------
+    # call-hook adapter
+    # ------------------------------------------------------------------
+
+    def _on_event(self, phase: str, ctx: dict[str, Any]) -> None:
+        """Adapter between the public call-hook protocol and ``_record``.
+
+        On ``"before"`` we snapshot the effective inputs, which is what the
+        function sees *at the start of the call*: state-holding inputs must
+        be captured before the function has a chance to mutate them. On
+        ``"after"`` we build the outputs (or the error name) and persist
+        one event record.
+        """
+        # A replay of the same file must not re-record itself; the
+        # replay machinery increments this counter for the duration of a
+        # ``replay_events()`` call.
+        if getattr(self.blocks, "_event_recording_suspended", 0) > 0:
+            return
+        if not self._is_recording:
+            return
+        block_fn = ctx.get("block_fn")
+        if block_fn is None:
+            return
+        # Continuation calls of generator functions carry an in-progress
+        # iterator; we only record the initial call.
+        if ctx.get("iterator") is not None:
+            return
+        if not self._should_record(block_fn):
+            return
+        state = ctx.get("state")
+        if phase == "before":
+            ctx[self._ctx_key] = capture_effective_inputs(
+                block_fn, ctx.get("inputs") or [], state
+            )
+            return
+        if phase != "after":
+            return
+        effective_inputs = ctx.get(self._ctx_key)
+        if effective_inputs is None:
+            # ``before`` did not fire (e.g. a hook was added mid-call);
+            # fall back to a best-effort snapshot from the raw payload.
+            effective_inputs = capture_effective_inputs(
+                block_fn, ctx.get("inputs") or [], state
+            )
+        error = ctx.get("error")
+        duration = ctx.get("duration") or 0.0
+        if error is None:
+            self._record(
+                block_fn,
+                effective_inputs,
+                ctx.get("outputs") or [],
+                state,
+                ctx.get("session_hash"),
+                error_name=None,
+                duration=duration,
+            )
+        else:
+            self._record(
+                block_fn,
+                effective_inputs,
+                None,
+                state,
+                ctx.get("session_hash"),
+                error_name=_exception_name(error),
+                duration=duration,
+            )
+
+
+def _gradio_version() -> str:
+    """Return the installed gradio version string for the record header."""
+    try:
+        from gradio import utils
+
+        return utils.get_package_version()
+    except Exception:
+        return "unknown"
+
+
+# ----------------------------------------------------------------------
+# record file reading
+# ----------------------------------------------------------------------
+
+
+def read_record(
+    record_path: str | Path,
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    """Read a JSONL record file and return ``(header, events)``.
+
+    Raises:
+        FileNotFoundError: if the record file does not exist.
+        ValueError: if the file is empty, has an invalid or unsupported
+            header, contains a corrupt or malformed event line, or fails
+            the per-line integrity check (chain hash mismatch,
+            reordering, or a dropped line).
+    """
+    path = Path(record_path)
+    if not path.exists():
+        raise FileNotFoundError(f"Record file not found: {path}")
+
+    with open(path, encoding="utf-8") as f:
+        first_line = f.readline()
+        if not first_line.strip():
+            raise ValueError(f"Record file is empty: {path}")
+        try:
+            header = json.loads(first_line)
+        except json.JSONDecodeError as e:
+            raise ValueError(
+                f"Record file {path} has a corrupt header line: {e}"
+            ) from e
+        if not isinstance(header, dict) or header.get("type") != HEADER_RECORD_TYPE:
+            raise ValueError(
+                f"Record file {path} does not start with a valid header record."
+            )
+        if header.get("format_version") != RECORD_FORMAT_VERSION:
+            raise ValueError(
+                f"Unsupported record format version: "
+                f"{header.get('format_version')!r} "
+                f"(expected {RECORD_FORMAT_VERSION})."
+            )
+        stored_header_checksum = header.get(_CHECKSUM_FIELD)
+        if not isinstance(stored_header_checksum, str):
+            raise ValueError(
+                f"Record file {path} header is missing an integrity checksum."
+            )
+        body_only = {k: v for k, v in header.items() if k != _CHECKSUM_FIELD}
+        expected_seed = _seed_chain(body_only)
+        if expected_seed != stored_header_checksum:
+            raise ValueError(
+                f"Record file {path} header failed integrity check "
+                "(checksum mismatch)."
+            )
+        prev_chain = stored_header_checksum
+
+        events: list[dict[str, Any]] = []
+        for lineno, line in enumerate(f, start=2):
+            stripped = line.strip()
+            if not stripped:
+                continue
+            try:
+                record = json.loads(stripped)
+            except json.JSONDecodeError as e:
+                raise ValueError(
+                    f"Record file {path} has a corrupt event at line {lineno}: {e}"
+                ) from e
+            if (
+                not isinstance(record, dict)
+                or record.get("type") != EVENT_RECORD_TYPE
+            ):
+                raise ValueError(
+                    f"Record file {path} has a malformed event at line "
+                    f"{lineno}: missing 'type': 'event'."
+                )
+            checksum = record.get(_CHECKSUM_FIELD)
+            if not isinstance(checksum, str):
+                raise ValueError(
+                    f"Record file {path} event at line {lineno} is missing "
+                    "its integrity checksum."
+                )
+            body_only = {k: v for k, v in record.items() if k != _CHECKSUM_FIELD}
+            expected = _next_chain(prev_chain, body_only)
+            if expected != checksum:
+                raise ValueError(
+                    f"Record file {path} failed integrity check at line "
+                    f"{lineno}: the file has been modified, reordered, or "
+                    "an event was dropped."
+                )
+            prev_chain = checksum
+            events.append(record)
+    return header, events
+
+
+def load_events(record_path: str | Path) -> list[dict[str, Any]]:
+    """Load the recorded events from a JSONL record file (header excluded).
+
+    Raises the same errors as :func:`read_record`.
+    """
+    _, events = read_record(record_path)
+    return events
+
+
+# ----------------------------------------------------------------------
+# replay
+# ----------------------------------------------------------------------
+
+
+@dataclass
+class ReplayResult:
+    """The outcome of replaying a single recorded event.
+
+    Attributes:
+        index: the ``index`` field of the recorded event.
+        api_name: the recorded api name (may be ``None``).
+        fn_name: the recorded function name.
+        status: one of ``"match"``, ``"mismatch"``, ``"missing"`` or
+            ``"error"``.
+        expected: the recorded outputs (list) or recorded exception name
+            (string) for error events; ``None`` when not applicable.
+        actual: the replayed outputs (list) or replayed exception name
+            (string); ``None`` when not applicable.
+        error: additional detail for status ``"error"`` (an unexpected
+            failure of the replay machinery itself), otherwise ``None``.
+    """
+
+    index: int
+    api_name: str | None
+    fn_name: str | None
+    status: str
+    expected: Any = None
+    actual: Any = None
+    error: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a JSON-serializable representation of this result."""
+        return {
+            "index": self.index,
+            "api_name": self.api_name,
+            "fn_name": self.fn_name,
+            "status": self.status,
+            "expected": _json_safe(self.expected),
+            "actual": _json_safe(self.actual),
+            "error": self.error,
+        }
+
+
+@dataclass
+class ReplayReport:
+    """Aggregated outcome of replaying a record file against an app.
+
+    Attributes:
+        results: the per-event replay results, in record order.
+    """
+
+    results: list[ReplayResult] = field(default_factory=list)
+
+    @property
+    def total(self) -> int:
+        """Total number of events replayed."""
+        return len(self.results)
+
+    def _count(self, status: str) -> int:
+        return sum(1 for r in self.results if r.status == status)
+
+    @property
+    def matched(self) -> int:
+        """Number of events whose replayed behavior matches the record."""
+        return self._count(STATUS_MATCH)
+
+    @property
+    def mismatched(self) -> int:
+        """Number of events whose replayed outputs or error differ."""
+        return self._count(STATUS_MISMATCH)
+
+    @property
+    def missing(self) -> int:
+        """Number of events whose function no longer exists in the app."""
+        return self._count(STATUS_MISSING)
+
+    @property
+    def errors(self) -> int:
+        """Number of events that could not be replayed at all."""
+        return self._count(STATUS_ERROR)
+
+    @property
+    def ok(self) -> bool:
+        """True when every recorded event replayed successfully and matched."""
+        return self.total > 0 and self.matched == self.total
+
+    @property
+    def mismatches(self) -> list[ReplayResult]:
+        """All results that did not match (mismatch, missing or error)."""
+        return [r for r in self.results if r.status != STATUS_MATCH]
+
+    def summary(self) -> str:
+        """A one-line human readable summary of the report."""
+        return (
+            f"replayed {self.total} event(s): {self.matched} matched, "
+            f"{self.mismatched} mismatched, {self.missing} missing, "
+            f"{self.errors} error(s)"
+        )
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a JSON-serializable representation of this report."""
+        return {
+            "total": self.total,
+            "matched": self.matched,
+            "mismatched": self.mismatched,
+            "missing": self.missing,
+            "errors": self.errors,
+            "ok": self.ok,
+            "results": [r.to_dict() for r in self.results],
+        }
+
+    def __bool__(self) -> bool:
+        return self.ok
+
+    def assert_ok(self) -> None:
+        """Raise an AssertionError describing the divergences, if any.
+
+        Convenience helper for using replay reports directly as regression
+        checks in a test suite: ``gr.replay_events(demo, path).assert_ok()``.
+        """
+        if self.ok:
+            return
+        lines = [self.summary()]
+        for result in self.mismatches:
+            lines.append(
+                f"  event {result.index} (api_name={result.api_name!r}): "
+                f"{result.status}, expected={result.expected!r}, "
+                f"actual={result.actual!r}"
+            )
+        raise AssertionError("\n".join(lines))
+
+    def __repr__(self) -> str:
+        return f"ReplayReport({self.summary()})"
+
+
+def _find_block_fn(blocks: Blocks, api_name: str | None, fn_name: str | None):
+    """Locate the BlockFunction a recorded event refers to.
+
+    Api names are matched first (they are the stable identifier the record
+    file was written with); the function name is used as a fallback for
+    events that were recorded without an api name, and for records whose
+    api name was renamed but whose function was not.
+    """
+    if api_name is not None:
+        for block_fn in blocks.fns.values():
+            if block_fn.api_name == api_name:
+                return block_fn
+    if fn_name:
+        for block_fn in blocks.fns.values():
+            if block_fn.name == fn_name:
+                return block_fn
+    return None
+
+
+def _event_matches_filter(
+    event: dict[str, Any], api_names: Iterable[str] | None
+) -> bool:
+    """Whether an event passes the replay filter (matches on api or fn name)."""
+    if api_names is None:
+        return True
+    names = {event.get("api_name"), event.get("fn_name")}
+    return bool(names.intersection(api_names))
+
+
+async def _replay_single_event(
+    blocks: Blocks,
+    block_fn: BlockFunction,
+    event: dict[str, Any],
+) -> tuple[Any, str | None]:
+    """Re-execute one recorded event and return ``(effective_outputs, error)``.
+
+    A fresh session is created for the event, the recorded values of
+    stateful inputs are injected into it via
+    :meth:`SessionState.restore`, and the call is run through the same
+    ``process_api()`` pipeline as a real frontend call.
+    """
+    session = SessionState(blocks)
+    inputs = list(event.get("inputs") or [])
+    snapshot: dict[int, Any] = {}
+    for i, block in enumerate(block_fn.inputs):
+        if i >= len(inputs):
+            break
+        if getattr(block, "stateful", False):
+            snapshot[block._id] = copy.deepcopy(inputs[i])
+    if snapshot:
+        session.restore(snapshot)
+    try:
+        output = await blocks.process_api(
+            block_fn=block_fn,
+            inputs=inputs,
+            state=session,
+            session_hash=event.get("session_hash"),
+        )
+    except Exception as e:
+        return None, _exception_name(e)
+    return capture_effective_outputs(block_fn, output["data"], session), None
+
+
+def replay_events(
+    blocks: Blocks,
+    record_path: str | Path,
+    api_names: Sequence[str] | None = None,
+) -> ReplayReport:
+    """Replay a record file against a Blocks app and compare behavior.
+
+    Each recorded event is re-executed through the regular invocation
+    pipeline (no server is started) with a fresh session; the recorded
+    values of stateful inputs are restored before the call using
+    :meth:`SessionState.restore`. Replayed outputs are compared to the
+    recorded outputs with strict (structural) equality; error events are
+    compared by exception class name. Calls made during replay are never
+    captured by attached recorders.
+
+    Parameters:
+        blocks: the app to replay the events against.
+        record_path: path of the JSONL record file produced by
+            :class:`EventRecorder`.
+        api_names: if provided, only events whose api name or function
+            name matches one of these entries are replayed.
+
+    Returns:
+        A :class:`ReplayReport` with one :class:`ReplayResult` per
+        replayed event.
+    """
+    events = load_events(record_path)
+    report = ReplayReport()
+    blocks._event_recording_suspended += 1  # noqa: SLF001
+    try:
+        for event in events:
+            if not _event_matches_filter(event, api_names):
+                continue
+            index = event.get("index", len(report.results))
+            api_name = event.get("api_name")
+            fn_name = event.get("fn_name")
+            block_fn = _find_block_fn(blocks, api_name, fn_name)
+            if block_fn is None:
+                report.results.append(
+                    ReplayResult(
+                        index=index,
+                        api_name=api_name,
+                        fn_name=fn_name,
+                        status=STATUS_MISSING,
+                        expected=event.get("outputs") or event.get("error"),
+                        actual=None,
+                    )
+                )
+                continue
+            try:
+                asyncio.get_running_loop()
+            except RuntimeError:
+                loop_already_running = False
+            else:
+                loop_already_running = True
+            if loop_already_running:
+                report.results.append(
+                    ReplayResult(
+                        index=index,
+                        api_name=api_name,
+                        fn_name=fn_name,
+                        status=STATUS_ERROR,
+                        expected=event.get("outputs") or event.get("error"),
+                        actual=None,
+                        error=(
+                            "RuntimeError: replay_events() cannot be called "
+                            "from a running event loop; call it from "
+                            "synchronous code."
+                        ),
+                    )
+                )
+                continue
+            try:
+                actual_outputs, actual_error = asyncio.run(
+                    _replay_single_event(blocks, block_fn, event)
+                )
+            except Exception as e:
+                report.results.append(
+                    ReplayResult(
+                        index=index,
+                        api_name=api_name,
+                        fn_name=fn_name,
+                        status=STATUS_ERROR,
+                        expected=event.get("outputs") or event.get("error"),
+                        actual=None,
+                        error=f"{_exception_name(e)}: {e}",
+                    )
+                )
+                continue
+            expected_error = event.get("error")
+            if expected_error is not None or actual_error is not None:
+                matched = (
+                    expected_error is not None
+                    and expected_error == actual_error
+                )
+                expected: Any = expected_error
+                actual: Any = actual_error
+            else:
+                expected = _json_safe(event.get("outputs"))
+                actual = _json_safe(actual_outputs)
+                matched = expected == actual
+            report.results.append(
+                ReplayResult(
+                    index=index,
+                    api_name=api_name,
+                    fn_name=fn_name,
+                    status=STATUS_MATCH if matched else STATUS_MISMATCH,
+                    expected=expected,
+                    actual=actual,
+                )
+            )
+    finally:
+        blocks._event_recording_suspended -= 1  # noqa: SLF001
+    return report
