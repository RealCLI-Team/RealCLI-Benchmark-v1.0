+    def snapshot(self) -> dict[int, Any]:
+        """Return a deep copy of every stateful component's session value.
+
+        The result maps a stateful component's block id to a deep copy of the
+        value that this session currently holds for it. Non-stateful
+        components are not represented at all, since their value lives on
