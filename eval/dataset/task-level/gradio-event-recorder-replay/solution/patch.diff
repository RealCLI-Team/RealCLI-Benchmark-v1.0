+def canonical_json_dumps(obj: Any) -> str:
+    """Serialize ``obj`` to JSON in Gradio's canonical form.
+
+    The canonical form is the byte-for-byte-stable representation shared by
+    every part of Gradio that writes JSON meant to be diffed, archived, or
+    included in code review (record files, snapshot dumps, and similar). It
+    guarantees:
+
+    * dictionary keys are sorted alphabetically at every level;
+    * non-ASCII characters are preserved verbatim (``ensure_ascii=False``);
+    * ``NaN``, ``Infinity`` and ``-Infinity`` are rejected — a value that
+      cannot round-trip through strict JSON has no canonical form, so
+      ``ValueError`` is raised;
+    * Python tuples (which have no JSON counterpart) are normalized to lists
+      so that ``(1, 2)`` and ``[1, 2]`` produce the same output.
+    """
+    normalized = _canonical_normalize(obj)
+    try:
+        return json.dumps(
+            normalized,
+            sort_keys=True,
+            ensure_ascii=False,
+            allow_nan=False,
+            separators=(", ", ": "),
+        )
+    except ValueError as e:
+        # json.dumps raises ValueError on NaN/Infinity when allow_nan=False;
+        # re-raise with a message that names the offender for the caller.
+        raise ValueError(
+            f"cannot serialize non-finite float in canonical JSON: {e}"
+        ) from e
+
+
+def _canonical_normalize(obj: Any) -> Any:
+    """Recursively normalize a value so ``canonical_json_dumps`` is stable.
+
+    Tuples become lists, dicts are rebuilt with sorted keys (json.dumps does
+    the sorting on write, but eager rebuilding keeps behavior identical
+    regardless of how the caller pretty-prints), and floats are validated
+    up front so a bad value points to its container path rather than the
+    opaque json.dumps message.
+    """
+    import math
+
+    if isinstance(obj, dict):
+        return {str(k): _canonical_normalize(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [_canonical_normalize(v) for v in obj]
+    if isinstance(obj, float):
+        if math.isnan(obj) or math.isinf(obj):
+            raise ValueError(
+                "canonical_json_dumps: refusing to serialize non-finite float "
+                f"({obj!r})"
+            )
+    return obj
+
+
