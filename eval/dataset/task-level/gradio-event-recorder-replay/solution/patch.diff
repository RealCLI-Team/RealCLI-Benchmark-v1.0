+                response = client.get(
+                    f"/gradio_api/queue/data?session_hash=sess-{i}", timeout=15
+                )
+                for line in response.iter_lines():
+                    if "process_completed" in line:
+                        break
+        rec.close()
+        assert len(rec.events) == n_calls
