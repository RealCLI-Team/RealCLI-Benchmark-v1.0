+    def test_replay_uses_fresh_sessions_per_event(self, tmp_path):
+        # a stateful app where each recorded event started from the default
+        # state: replay must not leak state between events
+        def read_state(st):
+            return st, st
+
+        def make_app():
+            with gr.Blocks() as demo:
+                st = gr.State("initial")
+                out = gr.Textbox(label="out")
+                st_out = gr.State()
+                btn = gr.Button("go")
+                btn.click(read_state, [st], [out, st_out], api_name="read")
+            return demo
+
+        demo = make_app()
+        path = tmp_path / "rec.jsonl"
+        rec = EventRecorder(demo, path).start()
+        state = SessionState(demo)
+        run(demo.process_api(0, [None], state=state, session_hash="a"))
+        run(demo.process_api(0, [None], state=state, session_hash="a"))
+        rec.close()
+        report = gr.replay_events(make_app(), path)
+        assert report.ok
+        for result in report.results:
+            assert result.actual == ["initial", "initial"]
