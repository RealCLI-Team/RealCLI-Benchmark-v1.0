+    def test_two_recorders_separate_indices(self, tmp_path):
+        demo = make_number_app(add)
+        rec1 = EventRecorder(demo, tmp_path / "r1.jsonl").start()
+        rec2 = EventRecorder(demo, tmp_path / "r2.jsonl")
+        state = SessionState(demo)
+        run(demo.process_api(0, [1.0, 2.0], state=state, session_hash="s"))
+        rec2.start()
+        run(demo.process_api(0, [3.0, 4.0], state=state, session_hash="s"))
+        rec1.close()
+        rec2.close()
+        assert [e["index"] for e in rec1.events] == [0, 1]
+        # rec2 only saw the second call, indexed from its own zero
+        assert [e["index"] for e in rec2.events] == [0]
+        assert rec2.events[0]["inputs"] == [3.0, 4.0]
