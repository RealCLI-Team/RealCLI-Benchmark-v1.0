+# ----------------------------------------------------------------------
+# on_chord_part_return no-op guards (regression)
+# ----------------------------------------------------------------------
+
+class test_native_path_guards:
+
+    def test_no_group_on_request_is_noop(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        request = Context({'id': 'whatever', 'group': None,
+                           'chord': dict(c.body)})
+        # must not raise and must not touch anything
+        app.backend.on_chord_part_return(request, states.SUCCESS, 1)
+        assert ERRBACK_CALLS == []
+
+    def test_missing_group_result_reports_error(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        # chord counter initialised but the header group result is gone:
+        # the backend must report a chord error instead of hanging
+        deps = app.GroupResult(c.tasks.id, _header_results(app, c))
+        app.backend.apply_chord((c.tasks.id, deps), c.body)
+        deps.delete()
+        results = _header_results(app, c)
+        # a single part arriving is enough to trigger the error report
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[0]), states.SUCCESS, 1)
+        assert len(ERRBACK_CALLS) == len(c.body.tasks)
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.FAILURE
