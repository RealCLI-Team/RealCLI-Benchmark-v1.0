+# ----------------------------------------------------------------------
+# completed members are never overwritten by failure propagation
+# ----------------------------------------------------------------------
+
+class test_completed_work_survives:
+
+    def test_succeeded_member_keeps_result_on_header_failure(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        # simulate a body member that somehow completed before the chord
+        # failed (e.g. a redelivered chord after partial body execution)
+        app.backend.store_result(_body_task_ids(c)[0], 'already-done',
+                                 states.SUCCESS)
+        app.backend.mark_as_failure(results[0].id, ValueError('x'))
+        for i, res in enumerate(results):
+            state = states.FAILURE if i == 0 else states.SUCCESS
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), state, None)
+        assert app.AsyncResult(_body_task_ids(c)[0]).result == 'already-done'
+        res = app.AsyncResult(_body_task_ids(c)[1])
+        assert res.state == states.FAILURE
+        assert isinstance(res.result, ChordError)
+
+    def test_group_result_failed_even_with_one_success(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        app.backend.store_result(_body_task_ids(c)[0], 'already-done',
+                                 states.SUCCESS)
+        app.backend.mark_as_failure(results[0].id, ValueError('x'))
+        for i, res in enumerate(results):
+            state = states.FAILURE if i == 0 else states.SUCCESS
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), state, None)
+        gres = app.GroupResult(
+            c.body.id,
+            [app.AsyncResult(tid) for tid in _body_task_ids(c)],
+        )
+        assert gres.ready()
+        assert gres.failed()
+        with pytest.raises(ChordError):
+            gres.join(timeout=1, interval=0)
+
