+                app.backend.on_chord_part_return(request, states.SUCCESS, 1)
+        else:
+            unlock = app.tasks['celery.chord_unlock']
+            unlock.apply(
+                args=(c.tasks.id, dict(c.body)),
+                kwargs={'result': [r.as_tuple() for r in results]},
+            )
