+"""Edge-case tests for chord completion and failure semantics.
+
+Covers the native chord-counter path (``on_chord_part_return``) in detail:
+ordering guarantees, partial arrival behaviour, the ``chord_size`` option,
+the group-body *callback* error path (header succeeded but running the body
+failed), and the different errback calling conventions.
+
+Everything runs against the in-memory cache backend; no broker is needed.
+"""
+import pytest
+
+from celery import Celery, chord, group, signature, states
+from celery.app.task import Context
+from celery.exceptions import ChordError
+
+ERRBACK_CALLS = []
+BODY_EXECUTIONS = []
+
+
+def _register_tasks(app):
+    @app.task(name='tests3.record_errback')
+    def record_errback(*args, **kwargs):
+        first = args[0] if args else None
+        ERRBACK_CALLS.append(getattr(first, 'id', first))
+        return True
+
+    @app.task(name='tests3.record_new_style_errback')
+    def record_new_style_errback(request, exc, traceback):
+        ERRBACK_CALLS.append((request, exc, traceback))
+        return True
+
+    @app.task(name='tests3.old_style_errback')
+    def old_style_errback(task_id):
+        ERRBACK_CALLS.append(task_id)
+        return True
+
+    @app.task(name='tests3.add')
+    def add(x, y):
+        return x + y
+
+    @app.task(name='tests3.record_body_execution')
+    def record_body_execution(*args, **kwargs):
+        BODY_EXECUTIONS.append((args, kwargs))
+        return 'body-ran'
+
+    @app.task(name='tests3.explode')
+    def explode(*args, **kwargs):
+        raise RuntimeError('body exploded')
+
+    return {
+        'record_errback': record_errback,
+        'record_new_style_errback': record_new_style_errback,
+        'old_style_errback': old_style_errback,
+        'add': add,
+        'record_body_execution': record_body_execution,
+        'explode': explode,
+    }
+
+
+@pytest.fixture
+def capp():
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+    app = Celery('chord_edge_tests', broker='memory://',
+                 backend='cache+memory://')
+    app.conf.update(
+        task_always_eager=True,
+        task_eager_propagates=True,
+        task_store_eager_result=True,
+        result_serializer='pickle',
+        accept_content=['pickle', 'json'],
+    )
+    tasks = _register_tasks(app)
+    yield app, tasks
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+
+
+def _build_chord(app, tasks, header_size=3, body=None, link_error=True):
+    header = group(
+        [tasks['add'].s(i, i) for i in range(header_size)], app=app,
+    )
+    if body is None:
+        body = group(
+            [tasks['record_body_execution'].s(), tasks['record_body_execution'].s()],
+            app=app,
+        )
+    if link_error:
+        body = body.set(link_error=[tasks['record_errback'].s()])
+    c = chord(header, body, app=app)
+    body_result = c.freeze()
+    return c, body_result
+
+
+def _header_results(app, c):
+    return [app.AsyncResult(t.options['task_id']) for t in c.tasks.tasks]
+
+
+def _body_task_ids(c):
+    return [t.options['task_id'] for t in c.body.tasks]
+
+
+def _chord_request(c, result):
+    return Context({
+        'id': result.id,
+        'group': c.tasks.id,
+        'chord': dict(c.body),
+    })
+
+
+def _setup(app, c):
+    """Save the header group result and initialise the chord counter."""
+    results = _header_results(app, c)
+    deps = app.GroupResult(c.tasks.id, results)
+    app.backend.apply_chord((c.tasks.id, deps), c.body)
+    return results
+
+
+# ----------------------------------------------------------------------
+# native counter path: failure only propagates once all parts returned
+# ----------------------------------------------------------------------
+
+class test_native_path_partial_arrivals:
+
+    def test_no_propagation_before_last_part(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        # the FIRST part fails, but two parts have not returned yet
+        app.backend.mark_as_failure(results[0].id, ValueError('early'))
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[0]), states.FAILURE, None)
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.PENDING
+        assert ERRBACK_CALLS == []
+
+    def test_failure_waits_for_all_parts(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        app.backend.mark_as_failure(results[0].id, ValueError('early'))
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[0]), states.FAILURE, None)
+        app.backend.store_result(results[1].id, 2, states.SUCCESS)
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[1]), states.SUCCESS, 2)
+        # still one part missing: nothing may happen yet
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.PENDING
+        assert ERRBACK_CALLS == []
+        # last part arrives: now the failure must propagate
+        app.backend.store_result(results[2].id, 4, states.SUCCESS)
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[2]), states.SUCCESS, 4)
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.FAILURE
+        assert len(ERRBACK_CALLS) == 2
+
+    def test_failure_arriving_last(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        for i in (0, 1):
+            app.backend.store_result(results[i].id, i * 2, states.SUCCESS)
+            app.backend.on_chord_part_return(
+                _chord_request(c, results[i]), states.SUCCESS, i * 2)
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.PENDING
+        app.backend.mark_as_failure(results[2].id, ValueError('late'))
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[2]), states.FAILURE, None)
+        for tid in _body_task_ids(c):
+            res = app.AsyncResult(tid)
+            assert res.state == states.FAILURE
+            assert isinstance(res.result, ChordError)
+            assert type(res.result.__cause__) is ValueError
+
+    def test_single_task_body_partial_arrivals(self, capp):
+        app, tasks = capp
+        body = tasks['record_body_execution'].s()
+        c, _ = _build_chord(app, tasks, body=body)
+        results = _setup(app, c)
+        app.backend.mark_as_failure(results[0].id, ValueError('x'))
+        app.backend.on_chord_part_return(
+            _chord_request(c, results[0]), states.FAILURE, None)
+        assert app.AsyncResult(c.body.options['task_id']).state == states.PENDING
+        for i in (1, 2):
+            app.backend.store_result(results[i].id, i * 2, states.SUCCESS)
+            app.backend.on_chord_part_return(
+                _chord_request(c, results[i]), states.SUCCESS, i * 2)
+        res = app.AsyncResult(c.body.options['task_id'])
+        assert res.state == states.FAILURE
+        assert isinstance(res.result, ChordError)
+
+
+class test_native_path_success_ordering:
+
+    def test_group_body_receives_header_results_in_order(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks, link_error=False)
+        results = _setup(app, c)
+        # return parts out of order
+        for i in (2, 0, 1):
+            app.backend.store_result(results[i].id, i * 2, states.SUCCESS)
+            app.backend.on_chord_part_return(
+                _chord_request(c, results[i]), states.SUCCESS, i * 2)
+        assert len(BODY_EXECUTIONS) == 2
+        for args, kwargs in BODY_EXECUTIONS:
+            assert args[0] == [0, 2, 4]
+
+    def test_success_does_not_call_errbacks(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        for i, res in enumerate(results):
+            app.backend.store_result(res.id, i * 2, states.SUCCESS)
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), states.SUCCESS, i * 2)
+        assert ERRBACK_CALLS == []
+        assert len(BODY_EXECUTIONS) == 2
+
+
+# ----------------------------------------------------------------------
+# group body callback errors (header fine, body blows up when called)
+# ----------------------------------------------------------------------
+
+class test_group_body_callback_error:
+
+    def _drive(self, app, c):
+        results = _setup(app, c)
+        for i, res in enumerate(results):
+            app.backend.store_result(res.id, i * 2, states.SUCCESS)
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), states.SUCCESS, i * 2)
+
+    def test_unexecuted_members_failed_on_callback_error(self, capp):
+        app, tasks = capp
+        # the exploding member comes first: the second member never runs
+        body = group(
+            [tasks['explode'].s(), tasks['record_body_execution'].s()],
+            app=app,
+        )
+        body = body.set(link_error=[tasks['record_errback'].s()])
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        self._drive(app, c)
+        res = app.AsyncResult(_body_task_ids(c)[1])
+        assert res.state == states.FAILURE
+        assert isinstance(res.result, ChordError)
+        assert 'Callback error' in str(res.result)
+
+    def test_completed_member_keeps_success_on_callback_error(self, capp):
+        app, tasks = capp
+        # the first member completes before the second one explodes:
+        # its stored SUCCESS result must survive (result backend dedup
+        # protection), while the uncompleted members are failed.
+        body = group(
+            [tasks['record_body_execution'].s(), tasks['explode'].s()],
+            app=app,
+        )
+        body = body.set(link_error=[tasks['record_errback'].s()])
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        self._drive(app, c)
+        assert app.AsyncResult(_body_task_ids(c)[0]).state == states.SUCCESS
+        res = app.AsyncResult(_body_task_ids(c)[1])
+        assert res.state == states.FAILURE
+        assert isinstance(res.result, ChordError)
+
+    def test_callback_error_chains_body_exception(self, capp):
+        app, tasks = capp
+        body = group(
+            [tasks['explode'].s(), tasks['record_body_execution'].s()],
+            app=app,
+        )
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        self._drive(app, c)
+        err = app.AsyncResult(_body_task_ids(c)[1]).result
+        assert type(err.__cause__) is RuntimeError
+        assert err.__cause__.args == ('body exploded',)
+
+    def test_callback_error_errbacks_per_member(self, capp):
+        app, tasks = capp
+        body = group(
+            [tasks['explode'].s(), tasks['record_body_execution'].s()],
+            app=app,
+        )
+        body = body.set(link_error=[tasks['record_errback'].s()])
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        self._drive(app, c)
+        assert set(ERRBACK_CALLS) == set(_body_task_ids(c))
+
+
+# ----------------------------------------------------------------------
+# errback calling conventions
+# ----------------------------------------------------------------------
+
+class test_errback_conventions:
+
+    def test_old_style_errback_gets_task_id(self, capp):
+        app, tasks = capp
+        body = group(
+            [tasks['record_body_execution'].s() for _ in range(2)], app=app,
+        )
+        body = body.set(link_error=[tasks['old_style_errback'].s()])
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        results = _setup(app, c)
+        app.backend.mark_as_failure(results[0].id, ValueError('x'))
+        for i, res in enumerate(results):
+            state = states.FAILURE if i == 0 else states.SUCCESS
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), state, None)
+        assert set(ERRBACK_CALLS) == set(_body_task_ids(c))
+        assert all(isinstance(tid, str) for tid in ERRBACK_CALLS)
+
+    def test_new_style_errback_gets_request_exc_tb(self, capp):
+        app, tasks = capp
+        body = group(
+            [tasks['record_body_execution'].s() for _ in range(2)], app=app,
+        )
+        body = body.set(link_error=[tasks['record_new_style_errback'].s()])
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        results = _setup(app, c)
+        app.backend.mark_as_failure(results[1].id, ValueError('x'))
+        for i, res in enumerate(results):
+            state = states.FAILURE if i == 1 else states.SUCCESS
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), state, None)
+        assert len(ERRBACK_CALLS) == 2
+        member_ids = set(_body_task_ids(c))
+        for request, exc, tb in ERRBACK_CALLS:
+            assert request.id in member_ids
+            assert isinstance(exc, ChordError)
+
+    def test_serialized_errback_signature(self, capp):
+        app, tasks = capp
+        body = group(
+            [tasks['record_body_execution'].s() for _ in range(2)], app=app,
