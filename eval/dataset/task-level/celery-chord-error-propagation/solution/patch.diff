diff --git a/docs/userguide/canvas.rst b/docs/userguide/canvas.rst
index a39a2d65f..4fcbec073 100644
--- a/docs/userguide/canvas.rst
+++ b/docs/userguide/canvas.rst
@@ -987,6 +987,48 @@ or errbacks just once if any task in the chord header or body fails.
 This behavior can be manipulated to allow error handling of the chord header using the :ref:`task_allow_error_cb_on_chord_header <task_allow_error_cb_on_chord_header>` flag.
 Enabling this flag will cause the chord header to invoke the errback for the body (default behavior) *and* any task in the chord's header that fails.
 
+.. _chord-group-body-errors:
+
+Group bodies and error propagation
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+When the body of a chord is itself a :class:`~@group`, a header failure is
+propagated to *every* member of that body group:
+
+* each member task's result transitions to the ``FAILURE`` state with the
+  :exc:`~@ChordError` as its result, so consumers waiting on individual
+  member results (or on the body :class:`~@GroupResult`) will never block
+  forever,
+* the errbacks linked to the body are called once per body member, with the
+  request context of that member,
+* the group result itself is marked as failed as well.
+
+This applies uniformly to all result backends, both to backends with native
+chord support (e.g. Redis, cache) and to backends relying on the
+``celery.chord_unlock`` fallback polling task.
+
+.. _chord-error-cause:
+
+Inspecting the original failure
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Whenever a chord fails, the resulting :exc:`~@ChordError` keeps the original
+exception available as ``__cause__`` (standard :keyword:`raise ... from`
+chaining).  This holds for the exception delivered to errbacks as well as for
+the one read back from the result backend, provided the result backend
+serializes results with an exception-capable serializer (e.g. ``pickle``):
+
+.. code-block:: pycon
+
+    >>> result.get(propagate=False)
+    ChordError("Dependency 97de6f3f raised ValueError('something something')")
+    >>> result.result.__cause__
+    ValueError('something something')
+
+If the chord callback itself raised when being executed, the
+:exc:`~@ChordError` message is prefixed with ``Callback error:`` and the
+callback's exception is available as ``__cause__`` in the same way.
+
 .. _chord-important-notes:
 
 Important Notes
diff --git a/t/unit/backends/test_chord_error_propagation.py b/t/unit/backends/test_chord_error_propagation.py
new file mode 100644
index 000000000..f47f3befd
--- /dev/null
+++ b/t/unit/backends/test_chord_error_propagation.py
@@ -0,0 +1,1051 @@
+"""Tests for chord failure propagation semantics.
+
+Covers the behaviour when a chord fails:
+
+* every member of a group body must end up in FAILURE state instead of
+  hanging in PENDING forever,
+* the body errbacks must be called (once per group body member),
+* the :class:`~celery.exceptions.ChordError` must keep the original
+  exception chained as ``__cause__``, even after a round trip through a
+  result backend,
+* single-task and chain bodies keep their historical behaviour,
+* the success path of chords is unchanged.
+
+All tests run against the in-memory cache backend; no broker is required.
+"""
+import pickle
+
+import pytest
+
+from celery import Celery, chord, group, signature, states, uuid
+from celery.app.task import Context
+from celery.backends.base import _chord_error_with_cause, _chord_errback_request
+from celery.exceptions import ChordError
+from celery.result import GroupResult
+
+# ----------------------------------------------------------------------
+# shared in-process recorders: errbacks executed eagerly append here.
+# ----------------------------------------------------------------------
+
+ERRBACK_CALLS = []
+BODY_EXECUTIONS = []
+
+
+def _make_app(**conf):
+    app = Celery(
+        'chord_error_propagation_tests',
+        broker='memory://',
+        backend='cache+memory://',
+    )
+    app.conf.update(
+        task_always_eager=True,
+        task_eager_propagates=True,
+        task_store_eager_result=True,
+        result_serializer='pickle',
+        accept_content=['pickle', 'json'],
+        **conf,
+    )
+    return app
+
+
+def _register_tasks(app):
+    @app.task(name='tests.record_errback')
+    def record_errback(*args, **kwargs):
+        # both old-style (task_id) and new-style (request, exc, tb)
+        # errbacks are normalized to the id of the failed unit
+        first = args[0] if args else None
+        ERRBACK_CALLS.append(getattr(first, 'id', first))
+        return True
+
+    @app.task(name='tests.record_new_style_errback')
+    def record_new_style_errback(request, exc, traceback):
+        ERRBACK_CALLS.append((request, exc, traceback))
+        return True
+
+    @app.task(name='tests.add')
+    def add(x, y):
+        return x + y
+
+    @app.task(name='tests.record_body_execution')
+    def record_body_execution(*args, **kwargs):
+        BODY_EXECUTIONS.append((args, kwargs))
+        return 'body-ran'
+
+    @app.task(name='tests.explode')
+    def explode(*args, **kwargs):
+        raise RuntimeError('body exploded')
+
+    return {
+        'record_errback': record_errback,
+        'record_new_style_errback': record_new_style_errback,
+        'add': add,
+        'record_body_execution': record_body_execution,
+        'explode': explode,
+    }
+
+
+@pytest.fixture
+def capp():
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+    app = _make_app()
+    tasks = _register_tasks(app)
+    yield app, tasks
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+
+
+# ----------------------------------------------------------------------
+# chord builders
+# ----------------------------------------------------------------------
+
+def _build_chord(app, tasks, header_size=3, body=None, link_error=True):
+    """Build and freeze a chord with a header of `add` tasks."""
+    header = group(
+        [tasks['add'].s(i, i) for i in range(header_size)], app=app,
+    )
+    if body is None:
+        body = group(
+            [tasks['record_body_execution'].s(), tasks['record_body_execution'].s()],
+            app=app,
+        )
+    if link_error:
+        body = body.set(link_error=[tasks['record_errback'].s()])
+    c = chord(header, body, app=app)
+    body_result = c.freeze()
+    return c, body_result
+
+
+def _header_results(app, c):
+    return [app.AsyncResult(t.options['task_id']) for t in c.tasks.tasks]
+
+
+def _store_header_results(app, c, failing_index, exc=None):
+    """Persist header results: all succeed except `failing_index`."""
+    backend = app.backend
+    results = _header_results(app, c)
+    for i, res in enumerate(results):
+        if i == failing_index:
+            backend.mark_as_failure(res.id, exc or ValueError('kaboom'))
+        else:
+            backend.store_result(res.id, i * 2, states.SUCCESS)
+    return results
+
+
+# ----------------------------------------------------------------------
+# drivers: the three real-world paths that end in chord_error_from_stack()
+# ----------------------------------------------------------------------
+
+def drive_kv_backend(app, c, failing_index, exc=None):
+    """Simulate a worker calling on_chord_part_return for every header task.
+
+    This is the path taken by backends with native chord counter support
+    (cache, redis-style increment based backends).
+    """
+    backend = app.backend
+    results = _store_header_results(app, c, failing_index, exc=exc)
+    deps = app.GroupResult(c.tasks.id, results)
+    backend.apply_chord((c.tasks.id, deps), c.body)
+    for res in results:
+        request = Context({
+            'id': res.id,
+            'group': c.tasks.id,
+            'chord': dict(c.body),
+        })
+        state = states.FAILURE if res is results[failing_index] else states.SUCCESS
+        backend.on_chord_part_return(request, state, None)
+
+
+def drive_unlock_chord(app, c, failing_index, exc=None):
+    """Simulate the celery.chord_unlock fallback polling task.
+
+    This is the path taken by backends without native chord support:
+    the ``celery.chord_unlock`` task joins the header result and calls the
+    body, or reports the failure when the join propagates.
+    """
+    results = _store_header_results(app, c, failing_index, exc=exc)
+    deps = app.GroupResult(c.tasks.id, results)
+    app.backend.apply_chord((c.tasks.id, deps), c.body)
+    unlock = app.tasks['celery.chord_unlock']
+    unlock.apply(
+        args=(c.tasks.id, dict(c.body)),
+        kwargs={'result': [r.as_tuple() for r in results]},
+    )
+
+
+def drive_direct(app, c, failing_index, exc=None):
+    """Call Backend.chord_error_from_stack directly, as backend internals do.
+
+    Like every production call site, this happens while the original
+    exception is being handled.
+    """
+    exc = exc or ValueError('kaboom')
+    try:
+        raise exc
+    except exc.__class__ as original:
+        app.backend.chord_error_from_stack(
+            signature(c.body, app=app),
+            _chord_error_with_cause(repr(original), original),
+        )
+
+
+ALL_DRIVERS = [drive_kv_backend, drive_unlock_chord, drive_direct]
+WORKER_DRIVERS = [drive_kv_backend, drive_unlock_chord]
+
+
+def _body_task_ids(c):
+    return [t.options['task_id'] for t in c.body.tasks]
+
+
+# ----------------------------------------------------------------------
+# ChordError pickling
+# ----------------------------------------------------------------------
+
+class _CustomChordError(ChordError):
+    """Module-level ChordError subclass used by the pickling tests."""
+
+
+class test_ChordError_pickling:
+
+    def test_cause_survives_pickle_roundtrip(self):
+        err = ChordError('Dependency x raised')
+        cause = ValueError('original failure')
+        err.__cause__ = cause
+        clone = pickle.loads(pickle.dumps(err))
+        assert isinstance(clone, ChordError)
+        assert clone.__cause__ is not None
+        assert type(clone.__cause__) is ValueError
+        assert clone.__cause__.args == cause.args
+
+    def test_args_preserved(self):
+        err = ChordError('some message', 'extra')
+        clone = pickle.loads(pickle.dumps(err))
+        assert clone.args == ('some message', 'extra')
+        assert str(clone) == str(('some message', 'extra'))
+
+    def test_no_cause_roundtrip(self):
+        err = ChordError('plain')
+        clone = pickle.loads(pickle.dumps(err))
+        assert isinstance(clone, ChordError)
+        assert clone.__cause__ is None
+        assert clone.args == ('plain',)
+
+    def test_chained_cause_roundtrip(self):
+        root = KeyError('root')
+        intermediate = ChordError('mid')
