+    def _run_success(self, app, c, driver):
+        results = _store_header_results(app, c, failing_index=-1)
+        deps = app.GroupResult(c.tasks.id, results)
+        app.backend.apply_chord((c.tasks.id, deps), c.body)
+        if driver is drive_kv_backend:
+            for res in results:
+                request = Context({
+                    'id': res.id,
+                    'group': c.tasks.id,
+                    'chord': dict(c.body),
