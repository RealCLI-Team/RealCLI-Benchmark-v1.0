+def _drive_callback_error(app, c):
+    """Header succeeds; body raises when the chord tries to run it."""
+    results = _store_header_results(app, c, failing_index=-1)
+    deps = app.GroupResult(c.tasks.id, results)
+    deps.save(backend=app.backend)
+    unlock = app.tasks['celery.chord_unlock']
+    unlock.apply(
+        args=(c.tasks.id, dict(c.body)),
+        kwargs={'result': [r.as_tuple() for r in results]},
+    )
+
