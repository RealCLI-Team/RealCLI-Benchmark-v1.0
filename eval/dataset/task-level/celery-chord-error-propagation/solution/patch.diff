+        # errback given in its serialized (dict) form, as it would appear
+        # after a message round trip
+        eb = dict(tasks['record_errback'].s())
+        body = body.set(link_error=[eb])
+        c, _ = _build_chord(app, tasks, body=body, link_error=False)
+        results = _setup(app, c)
+        app.backend.mark_as_failure(results[0].id, ValueError('x'))
