+class test_prepare_exception_contracts:
+
+    def test_pickle_roundtrip_keeps_type_and_cause(self, capp):
+        app, tasks = capp
+        err = ChordError('Dependency abc raised ValueError(1)')
+        err.__cause__ = ValueError('original')
+        prepared = app.backend.prepare_exception(err, 'pickle')
+        restored = app.backend.exception_to_python(prepared)
+        assert isinstance(restored, ChordError)
+        assert type(restored.__cause__) is ValueError
+
+    def test_json_roundtrip_keeps_type_name(self, capp):
+        app, tasks = capp
+        err = ChordError('some failure')
+        prepared = app.backend.prepare_exception(err, 'json')
+        assert prepared['exc_type'] == 'ChordError'
+        restored = app.backend.exception_to_python(prepared)
+        assert type(restored).__name__ == 'ChordError'
+        assert 'some failure' in str(restored)
+
+    def test_chord_error_unicode_message(self, capp):
+        app, tasks = capp
+        err = ChordError('依赖任务失败: 数值错误')
+        err.__cause__ = ValueError('原始异常')
+        clone = app.backend.exception_to_python(
+            app.backend.prepare_exception(err, 'pickle'))
+        assert str(clone) == '依赖任务失败: 数值错误'
+        assert type(clone.__cause__) is ValueError
