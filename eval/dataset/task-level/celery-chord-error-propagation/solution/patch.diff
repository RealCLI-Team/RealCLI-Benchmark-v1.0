+        assert gres.ready()
+        assert gres.failed()
+
+
+# ----------------------------------------------------------------------
+# celery.chord_unlock retry semantics
+# ----------------------------------------------------------------------
+
+class test_unlock_chord_retry:
+
+    def test_retries_when_header_not_ready(self, cache_app):
+        app, tasks = cache_app
+        c, _ = _build_chord(app, tasks)
+        results = _header_results(app, c)
