 class ChordError(TaskError):
     """A task part of the chord raised an exception."""
 
+    def __reduce__(self):
+        # BaseException.__reduce__() does not persist ``__cause__``, but for
+        # ChordError the chained original exception is an essential part of
+        # the error: it is the only way for consumers reading the failure
+        # from a result backend to find out what actually went wrong in the
+        # chord header.  Route pickling through a rebuild helper so the
+        # exception chain survives a round trip through the result backend.
+        return (_rebuild_chord_error, (self.__class__, self.args,
+                                       self.__cause__))
+
+
+def _rebuild_chord_error(cls, args, cause):
+    """Rebuild a :class:`ChordError` from its pickled state.
+
+    Reattaches ``__cause__`` since the default exception pickling protocol
+    silently drops it.
+    """
+    exc = cls(*args)
+    if cause is not None:
+        exc.__cause__ = cause
+    return exc
+
 
