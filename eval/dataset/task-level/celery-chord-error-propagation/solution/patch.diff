+# ----------------------------------------------------------------------
+# chord_size option handling
+# ----------------------------------------------------------------------
+
+class test_chord_size_option:
+
+    def _request_with_size(self, c, result, size):
+        req = _chord_request(c, result)
+        req.chord = dict(req.chord)
+        req.chord.setdefault('options', {})
+        req.chord['options'] = dict(req.chord['options'])
+        req.chord['options']['chord_size'] = size
+        req.chord['chord_size'] = size
+        return req
+
+    def test_explicit_chord_size_respected(self, capp):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks, header_size=3)
+        results = _setup(app, c)
+        # claim the chord only has 2 parts: failure after the second one
+        app.backend.store_result(results[0].id, 0, states.SUCCESS)
+        app.backend.on_chord_part_return(
+            self._request_with_size(c, results[0], 2), states.SUCCESS, 0)
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.PENDING
+        app.backend.mark_as_failure(results[1].id, ValueError('x'))
+        app.backend.on_chord_part_return(
+            self._request_with_size(c, results[1], 2), states.FAILURE, None)
+        for tid in _body_task_ids(c):
+            assert app.AsyncResult(tid).state == states.FAILURE
