+# ----------------------------------------------------------------------
+# immutability of header results
+# ----------------------------------------------------------------------
+
+class test_header_result_immutability:
+
+    @pytest.mark.parametrize('failing_index', [0, 1, 2])
+    def test_other_header_results_not_overwritten(self, capp, failing_index):
+        app, tasks = capp
+        c, _ = _build_chord(app, tasks)
+        results = _setup(app, c)
+        for i, res in enumerate(results):
+            if i == failing_index:
+                app.backend.mark_as_failure(res.id, ValueError('x'))
+            else:
+                app.backend.store_result(res.id, i * 2, states.SUCCESS)
+        for i, res in enumerate(results):
+            state = states.FAILURE if i == failing_index else states.SUCCESS
+            app.backend.on_chord_part_return(
+                _chord_request(c, res), state, None)
+        for i, res in enumerate(results):
+            fresh = app.AsyncResult(res.id)
+            if i == failing_index:
+                assert fresh.state == states.FAILURE
+                assert type(fresh.result) is ValueError
+            else:
+                assert fresh.state == states.SUCCESS
+                assert fresh.result == i * 2
+
