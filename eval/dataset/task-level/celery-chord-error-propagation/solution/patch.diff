+"""Backend-level tests for chord failure propagation.
+
+These tests exercise the *fallback* chord completion path used by result
+backends without native chord counter support (database, filesystem, ...):
+the ``celery.chord_unlock`` task joins the header result and either invokes
+the chord body or reports the failure through
+:meth:`~celery.backends.base.Backend.chord_error_from_stack`.
+
+They also cover serializer edge cases (JSON result serialization cannot
+round-trip exception objects) and the retry semantics of the unlock task.
+
+Everything runs locally: the cache backend is in-memory and the filesystem
+backend writes to a temporary directory; no broker is ever contacted.
+"""
+import pickle
+
+import pytest
+
+from celery import Celery, chord, group, signature, states
+from celery.exceptions import ChordError, Retry
+
+ERRBACK_CALLS = []
+BODY_EXECUTIONS = []
+
+
+def _register_tasks(app):
+    @app.task(name='tests2.record_errback')
+    def record_errback(*args, **kwargs):
+        first = args[0] if args else None
+        ERRBACK_CALLS.append(getattr(first, 'id', first))
+        return True
+
+    @app.task(name='tests2.record_new_style_errback')
+    def record_new_style_errback(request, exc, traceback):
+        ERRBACK_CALLS.append((request, exc, traceback))
+        return True
+
+    @app.task(name='tests2.add')
+    def add(x, y):
+        return x + y
+
+    @app.task(name='tests2.record_body_execution')
+    def record_body_execution(*args, **kwargs):
+        BODY_EXECUTIONS.append((args, kwargs))
+        return 'body-ran'
+
+    @app.task(name='tests2.explode')
+    def explode(*args, **kwargs):
+        raise RuntimeError('body exploded')
+
+    return {
+        'record_errback': record_errback,
+        'record_new_style_errback': record_new_style_errback,
+        'add': add,
+        'record_body_execution': record_body_execution,
+        'explode': explode,
+    }
+
+
+def _base_conf(**extra):
+    conf = dict(
+        task_always_eager=True,
+        task_eager_propagates=True,
+        task_store_eager_result=True,
+        accept_content=['pickle', 'json'],
+    )
+    conf.update(extra)
+    return conf
+
+
+@pytest.fixture
+def cache_app():
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+    app = Celery('chord_backend_tests_cache', broker='memory://',
+                 backend='cache+memory://')
+    app.conf.update(_base_conf(result_serializer='pickle'))
+    tasks = _register_tasks(app)
+    yield app, tasks
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+
+
+@pytest.fixture
+def fs_app(tmp_path):
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+    app = Celery('chord_backend_tests_fs', broker='memory://',
+                 backend=f'file://{tmp_path}')
+    app.conf.update(_base_conf(result_serializer='pickle'))
+    tasks = _register_tasks(app)
+    yield app, tasks
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+
+
+@pytest.fixture
+def json_app():
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+    app = Celery('chord_backend_tests_json', broker='memory://',
+                 backend='cache+memory://')
+    app.conf.update(_base_conf(result_serializer='json'))
+    tasks = _register_tasks(app)
+    yield app, tasks
+    ERRBACK_CALLS.clear()
+    BODY_EXECUTIONS.clear()
+
+
+def _build_chord(app, tasks, header_size=3, body=None, link_error=True):
+    header = group(
+        [tasks['add'].s(i, i) for i in range(header_size)], app=app,
+    )
+    if body is None:
+        body = group(
+            [tasks['record_body_execution'].s(), tasks['record_body_execution'].s()],
+            app=app,
+        )
+    if link_error:
+        body = body.set(link_error=[tasks['record_errback'].s()])
+    c = chord(header, body, app=app)
+    body_result = c.freeze()
+    return c, body_result
+
+
+def _header_results(app, c):
+    return [app.AsyncResult(t.options['task_id']) for t in c.tasks.tasks]
+
+
+def _store_header_results(app, c, failing_index, exc=None):
+    backend = app.backend
+    results = _header_results(app, c)
+    for i, res in enumerate(results):
+        if i == failing_index:
+            backend.mark_as_failure(res.id, exc or ValueError('kaboom'))
+        else:
+            backend.store_result(res.id, i * 2, states.SUCCESS)
+    deps = app.GroupResult(c.tasks.id, results)
+    backend.apply_chord((c.tasks.id, deps), c.body)
+    return results
+
+
+def _run_unlock(app, c, failing_index, exc=None):
+    results = _store_header_results(app, c, failing_index, exc=exc)
+    # Backends with native chord counter support need an explicit
+    # celery.chord_unlock run; for the others apply_chord() above has
+    # already triggered the fallback unlock task.
+    if app.backend.implements_incr:
+        unlock = app.tasks['celery.chord_unlock']
+        return unlock.apply(
+            args=(c.tasks.id, dict(c.body)),
+            kwargs={'result': [r.as_tuple() for r in results]},
+        )
+
+
+def _body_task_ids(c):
+    return [t.options['task_id'] for t in c.body.tasks]
+
+
+# ----------------------------------------------------------------------
+# filesystem backend: the non-incr fallback path
+# ----------------------------------------------------------------------
+
+class test_filesystem_backend_failure:
+
+    def test_group_body_members_failed(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        _run_unlock(app, c, failing_index=1)
+        for tid in _body_task_ids(c):
+            res = app.AsyncResult(tid)
+            assert res.state == states.FAILURE
+            assert isinstance(res.result, ChordError)
+
+    def test_group_body_errbacks_per_member(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        _run_unlock(app, c, failing_index=0)
+        assert set(ERRBACK_CALLS) == set(_body_task_ids(c))
+
+    def test_group_body_chord_error_cause(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        _run_unlock(app, c, failing_index=2, exc=IOError('disk gone'))
+        for tid in _body_task_ids(c):
+            err = app.AsyncResult(tid).result
+            assert isinstance(err, ChordError)
+            assert type(err.__cause__) is IOError
+            assert err.__cause__.args == ('disk gone',)
+
+    def test_group_body_result_persisted_on_disk(self, fs_app, tmp_path):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        _run_unlock(app, c, failing_index=0)
+        # results must survive a brand new backend instance (they are files)
+        app2 = Celery('chord_backend_tests_fs2', broker='memory://',
+                      backend=f'file://{tmp_path}')
+        app2.conf.update(_base_conf(result_serializer='pickle'))
+        for tid in _body_task_ids(c):
+            res = app2.AsyncResult(tid)
+            assert res.state == states.FAILURE
+            assert isinstance(res.result, ChordError)
+
+    def test_single_body_failed(self, fs_app):
+        app, tasks = fs_app
+        body = tasks['record_body_execution'].s()
+        c, _ = _build_chord(app, tasks, body=body)
+        _run_unlock(app, c, failing_index=1)
+        res = app.AsyncResult(c.body.options['task_id'])
+        assert res.state == states.FAILURE
+        assert isinstance(res.result, ChordError)
+        assert len(ERRBACK_CALLS) == 1
+
+    def test_body_not_executed_on_failure(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        _run_unlock(app, c, failing_index=0)
+        assert BODY_EXECUTIONS == []
+
+    def test_successful_header_results_kept(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        results = _header_results(app, c)
+        _run_unlock(app, c, failing_index=1)
+        for i, res in enumerate(results):
+            if i == 1:
+                assert res.state == states.FAILURE
+            else:
+                assert res.state == states.SUCCESS
+                assert res.result == i * 2
+
+    def test_group_result_failed(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks)
+        _run_unlock(app, c, failing_index=0)
+        gres = app.GroupResult(
+            c.body.id,
+            [app.AsyncResult(tid) for tid in _body_task_ids(c)],
+        )
+        assert gres.ready()
+        assert gres.failed()
+
+
+class test_filesystem_backend_success:
+
+    def test_group_body_runs_on_success(self, fs_app):
+        app, tasks = fs_app
+        c, _ = _build_chord(app, tasks, link_error=False)
+        _run_unlock(app, c, failing_index=-1)
