index 0000000..072bfac
--- /dev/null
+++ b/tests/test_keyframe_motion.py
@@ -0,0 +1,854 @@
+"""Tests for :class:`moviepy.video.fx.KeyframeMotion`."""
+
+import numpy as np
+import pytest
+
+from moviepy import ColorClip, KeyframeTrack, VideoClip, vfx
+from moviepy.video.fx.KeyframeMotion import KeyframeMotion
+
+
+def quadrant_frame(size=4):
+    """A ``size``x``size`` frame with four colored quadrants.
+
+    TL red, TR green, BL blue, BR yellow.
+    """
+    half = size // 2
+    frame = np.zeros((size, size, 3), dtype=np.uint8)
+    frame[:half, :half] = (255, 0, 0)
+    frame[:half, half:] = (0, 255, 0)
+    frame[half:, :half] = (0, 0, 255)
+    frame[half:, half:] = (255, 255, 0)
+    return frame
+
+
+def static_clip(frame, duration=2.0):
+    frame = np.ascontiguousarray(frame)
+    return VideoClip(frame_function=lambda t: frame.copy(), duration=duration)
+
+
+# ------------------------------------------------------------- effect basics
+
+
+def test_effect_is_registered_in_vfx():
+    assert vfx.KeyframeMotion is KeyframeMotion
+
+
+def test_default_effect_is_identity():
+    frame = quadrant_frame(4)
+    clip = static_clip(frame)
+    out = clip.with_effects([KeyframeMotion()])
+    assert out.size == (4, 4)
+    assert np.array_equal(out.get_frame(0.0), frame)
+    assert np.array_equal(out.get_frame(1.3), frame)
+
+
+def test_output_size_duration_and_fps():
+    clip = static_clip(quadrant_frame(4), duration=3.0).with_fps(12)
+    out = clip.with_effects([KeyframeMotion(canvas_size=(10, 6))])
+    assert out.size == (10, 6)
+    assert out.duration == 3.0
+    assert out.fps == 12
+    assert out.get_frame(1.0).shape == (6, 10, 3)
+
+
+def test_original_clip_is_not_modified():
+    clip = static_clip(quadrant_frame(4))
+    clip.with_effects([KeyframeMotion(rotation=90.0)])
+    assert clip.size == (4, 4)
+    assert np.array_equal(clip.get_frame(0.0), quadrant_frame(4))
+
+
+def test_audio_is_preserved():
+    from moviepy import AudioClip
+
+    audio = AudioClip(
+        frame_function=lambda t: 0 * t, duration=2.0, fps=22050
+    )
+    clip = static_clip(quadrant_frame(4)).with_audio(audio)
+    out = clip.with_effects([KeyframeMotion(scale=2.0)])
+    assert out.audio is not None
+
+
+def test_mask_clips_are_rejected():
+    mask = VideoClip(
+        frame_function=lambda t: np.ones((4, 4)), is_mask=True, duration=1.0
+    )
+    with pytest.raises(ValueError):
+        mask.with_effects([KeyframeMotion()])
+
+
+# ------------------------------------------------------------- validation
+
+
+def test_bad_canvas_size():
+    clip = static_clip(quadrant_frame(4))
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(canvas_size=(0, 4))])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(canvas_size=(4, -2))])
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(canvas_size="big")])
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(canvas_size=(4, "4"))])
+
+
+def test_bad_opacity_values():
+    clip = static_clip(quadrant_frame(4))
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(opacity=1.5)])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(opacity=-0.1)])
+    with pytest.raises(ValueError):
+        clip.with_effects(
+            [KeyframeMotion(opacity=KeyframeTrack([(0.0, 0.5), (1.0, 2.0)]))]
+        )
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(opacity="opaque")])
+    with pytest.raises(ValueError):
+        clip.with_effects(
+            [
+                KeyframeMotion(
+                    opacity=KeyframeTrack([(0.0, (0.5, 0.5)), (1.0, (1.0, 1.0))])
+                )
+            ]
+        )
+
+
+def test_bad_scale_values():
+    clip = static_clip(quadrant_frame(4))
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(scale=0.0)])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(scale=-1.0)])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(scale=(1.0, 0.0))])
+    with pytest.raises(ValueError):
+        clip.with_effects(
+            [KeyframeMotion(scale=KeyframeTrack([(0.0, 1.0), (1.0, -2.0)]))]
+        )
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(scale="zoom")])
+
+
+def test_bad_position_values():
+    clip = static_clip(quadrant_frame(4))
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(position=5.0)])
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(position=(1.0, "x"))])
+    with pytest.raises(ValueError):
+        clip.with_effects(
+            [KeyframeMotion(position=KeyframeTrack([(0.0, 1.0), (1.0, 2.0)]))]
+        )
+
+
+def test_bad_rotation_values():
+    clip = static_clip(quadrant_frame(4))
+    with pytest.raises(TypeError):
+        clip.with_effects([KeyframeMotion(rotation=(0.0, 1.0))])
