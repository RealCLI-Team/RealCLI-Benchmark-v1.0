diff --git a/moviepy/video/fx/KeyframeMotion.py b/moviepy/video/fx/KeyframeMotion.py
new file mode 100644
index 0000000..ded746b
--- /dev/null
+++ b/moviepy/video/fx/KeyframeMotion.py
@@ -0,0 +1,301 @@
+"""Keyframe-driven motion effect: animate scale, rotation, position, opacity."""
+
+import numbers
+from dataclasses import dataclass
+from typing import Optional, Union
+
+import numpy as np
+from PIL import Image
+
+from moviepy.Effect import Effect
+from moviepy.keyframe import KeyframeTrack
+
+
+def _is_number(value):
+    """Return True for real numbers (excluding booleans)."""
+    return isinstance(value, numbers.Real) and not isinstance(value, bool)
+
+
+def _static_scalar_track(value, name, minimum=None, maximum=None):
+    """Build a constant scalar :class:`KeyframeTrack` from a static value."""
+    if not _is_number(value):
+        raise TypeError(
+            f"{name} must be a number, a KeyframeTrack, or None, "
+            f"got {type(value).__name__!r}"
+        )
+    value = float(value)
+    if minimum is not None and value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value!r}")
+    if maximum is not None and value > maximum:
+        raise ValueError(f"{name} must be <= {maximum}, got {value!r}")
+    return KeyframeTrack([(0.0, value)])
+
+
+def _resolve_scalar(value, name, minimum=None, maximum=None):
+    """Resolve a scalar parameter (rotation, opacity) to a track."""
+    if value is None:
+        return None
+    if isinstance(value, KeyframeTrack):
+        if value.is_tuple:
+            raise ValueError(
+                f"{name} requires a scalar keyframe track, "
+                "got a tuple-valued track"
+            )
+        for v in value.values:
+            if minimum is not None and v < minimum:
+                raise ValueError(
+                    f"{name} keyframe values must be >= {minimum}, got {v!r}"
+                )
+            if maximum is not None and v > maximum:
+                raise ValueError(
+                    f"{name} keyframe values must be <= {maximum}, got {v!r}"
+                )
+        return value
+    return _static_scalar_track(value, name, minimum=minimum, maximum=maximum)
+
+
+def _resolve_position(value):
+    """Resolve the ``position`` parameter to a 2-component tuple track."""
+    if value is None:
+        return None
+    if isinstance(value, KeyframeTrack):
+        if not value.is_tuple or len(value.values[0]) != 2:
+            raise ValueError(
+                "position requires a keyframe track of (x, y) pairs"
+            )
+        return value
+    if isinstance(value, (tuple, list)) and len(value) == 2:
+        x, y = value
+        if not (_is_number(x) and _is_number(y)):
+            raise TypeError(
+                f"position components must be numbers, got {value!r}"
+            )
+        return KeyframeTrack([(0.0, (float(x), float(y)))])
+    raise TypeError(
+        "position must be an (x, y) pair, a KeyframeTrack of (x, y) pairs, "
+        f"or None, got {type(value).__name__!r}"
+    )
+
+
+def _resolve_scale(value):
+    """Resolve the ``scale`` parameter to a 2-component tuple track.
+
+    A static number is expanded to a uniform ``(sx, sx)`` scale; a scalar
+    keyframe track is converted to a tuple track doing the same expansion
+    keyframe by keyframe.
+    """
+    if value is None:
+        return None
+    if isinstance(value, KeyframeTrack):
+        if value.is_tuple:
+            if len(value.values[0]) != 2:
+                raise ValueError(
+                    "scale requires a keyframe track of numbers or (sx, sy) pairs"
+                )
+            track = value
+        else:
+            track = KeyframeTrack(
+                [(t, (v, v)) for t, v in zip(value.times, value.values)],
+                easing=value.easing,
+            )
+        for v in track.values:
+            if v[0] <= 0.0 or v[1] <= 0.0:
+                raise ValueError(
+                    f"scale keyframe values must be > 0, got {v!r}"
+                )
+        return track
+    if _is_number(value):
+        scale = float(value)
+        if scale <= 0.0:
+            raise ValueError(f"scale must be > 0, got {scale!r}")
+        return KeyframeTrack([(0.0, (scale, scale))])
+    if isinstance(value, (tuple, list)) and len(value) == 2:
+        sx, sy = value
+        if not (_is_number(sx) and _is_number(sy)):
+            raise TypeError(f"scale components must be numbers, got {value!r}")
+        sx, sy = float(sx), float(sy)
+        if sx <= 0.0 or sy <= 0.0:
+            raise ValueError(f"scale components must be > 0, got {value!r}")
+        return KeyframeTrack([(0.0, (sx, sy))])
+    raise TypeError(
+        "scale must be a number, an (sx, sy) pair, a KeyframeTrack, or None, "
+        f"got {type(value).__name__!r}"
+    )
+
+
+def _paste_centered(canvas, image, center_x, center_y):
+    """Paste ``image`` onto ``canvas`` with the image center at the given point.
+
+    ``canvas`` is modified in place. Parts of the image falling outside the
+    canvas are clipped away.
+    """
+    canvas_h, canvas_w = canvas.shape[:2]
+    image_w, image_h = image.size
+    left = int(round(center_x - image_w / 2.0))
+    top = int(round(center_y - image_h / 2.0))
+
+    # intersection between the image footprint and the canvas
+    dst_left = max(0, left)
+    dst_top = max(0, top)
+    dst_right = min(canvas_w, left + image_w)
+    dst_bottom = min(canvas_h, top + image_h)
+    if dst_right <= dst_left or dst_bottom <= dst_top:
+        return
+
+    src_left = dst_left - left
+    src_top = dst_top - top
+    src_right = src_left + (dst_right - dst_left)
+    src_bottom = src_top + (dst_bottom - dst_top)
+
+    cropped = image.crop((src_left, src_top, src_right, src_bottom))
+    canvas[dst_top:dst_bottom, dst_left:dst_right] = np.array(cropped)
+
+
+@dataclass
+class KeyframeMotion(Effect):
+    """Animate a clip's scale, rotation, position and opacity with keyframes.
+
+    The effect renders the (transformed) frames of the clip onto a black
+    canvas of fixed size, so the resulting clip has a constant size even
+    while the content moves, grows or spins.
+
+    Parameters
+    ----------
+
+    position : tuple or KeyframeTrack, optional
+        Position ``(x, y)`` of the clip's *center* on the canvas, in
+        pixels. Either a static pair or a :class:`KeyframeTrack` of
+        ``(x, y)`` pairs. Defaults to the center of the canvas.
+
+    scale : float or tuple or KeyframeTrack, optional
+        Scaling factor applied to the clip about its own center, before
+        rotation. Either a static number (uniform scale) or ``(sx, sy)``,
+        or a keyframe track of either. All values must be strictly
+        positive. Defaults to ``1.0``.
+
+    rotation : float or KeyframeTrack, optional
+        Rotation angle in degrees, counterclockwise, about the clip's own
+        center. Either a static number or a scalar keyframe track.
+        Defaults to ``0.0``.
+
+    opacity : float or KeyframeTrack, optional
+        Opacity of the clip, between 0 (invisible) and 1 (fully opaque).
+        The clip is blended over the black canvas, so the final pixel
+        values are ``round(pixel * opacity)``. Either a static number or
+        a scalar keyframe track whose values all lie in ``[0, 1]``.
+        Defaults to ``1.0``.
+
+    canvas_size : tuple, optional
+        Size ``(width, height)`` in pixels of the output clip. Defaults to
+        the size of the input clip.
+
+    The transformations are applied in the order: scale, then rotation,
+    then translation; opacity is applied last. Scaling and rotation use
+    bilinear resampling. The output clip keeps the duration, fps, audio
+    and mask of the input clip. Mask clips (``is_mask=True``) are not
+    supported and raise ``ValueError``.
+
+    Examples
+    --------
+
+    .. code:: python
+
+        from moviepy import KeyframeTrack, vfx
+
+        motion = vfx.KeyframeMotion(
+            position=KeyframeTrack([(0, (100, 100)), (2, (500, 300))],
+                                   easing="ease_in_out_cubic"),
+            scale=KeyframeTrack([(0, 0.5), (2, 1.5)]),
+            rotation=KeyframeTrack([(0, 0), (2, 90)]),
+            opacity=KeyframeTrack([(0, 0.0), (1, 1.0)], easing="ease_out_quad"),
+        )
+        animated = clip.with_effects([motion])
+    """
+
+    position: Optional[Union[tuple, KeyframeTrack]] = None
+    scale: Optional[Union[float, tuple, KeyframeTrack]] = None
+    rotation: Optional[Union[float, KeyframeTrack]] = None
+    opacity: Optional[Union[float, KeyframeTrack]] = None
+    canvas_size: Optional[tuple] = None
+
+    def apply(self, clip):
+        """Apply the effect to the clip."""
+        if clip.is_mask:
+            raise ValueError(
+                "KeyframeMotion does not support mask clips (is_mask=True)"
+            )
+
+        canvas_w, canvas_h = self._resolve_canvas_size(clip)
+
+        position_track = _resolve_position(self.position)
+        scale_track = _resolve_scale(self.scale)
+        rotation_track = _resolve_scalar(self.rotation, "rotation")
+        opacity_track = _resolve_scalar(
+            self.opacity, "opacity", minimum=0.0, maximum=1.0
+        )
+
+        def motion_frame(get_frame, t):
+            frame = get_frame(t)
+            if frame.dtype != np.uint8:
+                frame = np.clip(np.rint(frame), 0, 255).astype(np.uint8)
+            image = Image.fromarray(frame)
+
+            sx, sy = (
+                scale_track.value_at(t) if scale_track is not None else (1.0, 1.0)
+            )
+            angle = (
+                rotation_track.value_at(t) if rotation_track is not None else 0.0
+            )
+            opacity = (
+                opacity_track.value_at(t) if opacity_track is not None else 1.0
+            )
+            center_x, center_y = (
+                position_track.value_at(t)
+                if position_track is not None
+                else (canvas_w / 2.0, canvas_h / 2.0)
+            )
+
+            width, height = image.size
+            new_width = max(1, int(round(width * sx)))
+            new_height = max(1, int(round(height * sy)))
+            if (new_width, new_height) != (width, height):
+                image = image.resize(
+                    (new_width, new_height), Image.Resampling.BILINEAR
+                )
+            if angle % 360.0 != 0.0:
+                image = image.rotate(
+                    angle, resample=Image.Resampling.BILINEAR, expand=False
+                )
+
+            canvas = np.zeros((canvas_h, canvas_w, 3), dtype=np.uint8)
+            _paste_centered(canvas, image, center_x, center_y)
+
+            if opacity < 1.0:
+                canvas = np.rint(canvas.astype(np.float64) * opacity).astype(
+                    np.uint8
+                )
+            return canvas
+
+        new_clip = clip.transform(motion_frame, keep_duration=True)
+        new_clip.size = (canvas_w, canvas_h)
+        return new_clip
+
+    def _resolve_canvas_size(self, clip):
+        """Validate and resolve the output canvas size."""
+        if self.canvas_size is None:
+            return clip.size
+        size = self.canvas_size
+        if (
+            not isinstance(size, (tuple, list))
+            or len(size) != 2
+            or not all(_is_number(component) for component in size)
+        ):
+            raise TypeError(
+                f"canvas_size must be a (width, height) pair, got {size!r}"
+            )
+        width, height = int(size[0]), int(size[1])
+        if width <= 0 or height <= 0:
+            raise ValueError(
+                f"canvas_size components must be positive, got {size!r}"
+            )
+        return (width, height)
