+def test_position_clipping_on_each_side():
+    small = np.full((2, 2, 3), 255, dtype=np.uint8)
+    clip = static_clip(small)
+
+    def expected_for(position):
+        expected = np.zeros((4, 4, 3), dtype=np.uint8)
+        cx, cy = position
+        left = int(round(cx - 1.0))
+        top = int(round(cy - 1.0))
+        for y in range(max(0, top), min(4, top + 2)):
+            for x in range(max(0, left), min(4, left + 2)):
+                expected[y, x] = 255
+        return expected
+
+    for position in [(0.0, 2.0), (4.0, 2.0), (2.0, 0.0), (2.0, 4.0)]:
+        out = clip.with_effects(
+            [KeyframeMotion(position=position, canvas_size=(4, 4))]
+        )
+        frame = out.get_frame(0.0)
+        assert np.array_equal(frame, expected_for(position)), (
+            f"position={position}"
+        )
+    # sanity: each edge case leaves exactly one row or column visible
+    assert expected_for((0.0, 2.0))[:, 0].sum() > 0
+    assert not expected_for((0.0, 2.0))[:, 1:].any()
+    assert not expected_for((4.0, 2.0))[:, :3].any()
+    assert not expected_for((2.0, 0.0))[1:, :].any()
+    assert not expected_for((2.0, 4.0))[:3, :].any()
