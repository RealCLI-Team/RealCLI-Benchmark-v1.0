+    clip = static_clip(small, duration=2.0)
+    forward = KeyframeTrack([(0.0, (1.0, 1.0)), (2.0, (5.0, 1.0))])
+    out = clip.with_effects(
+        [KeyframeMotion(position=forward.reversed(), canvas_size=(6, 4))]
+    )
+    # t=0 -> the original end position
+    expected_start = np.zeros((4, 6, 3), dtype=np.uint8)
+    expected_start[0:2, 4:6] = 255
+    assert np.array_equal(out.get_frame(0.0), expected_start)
+    # t=2 -> the original start position
+    expected_end = np.zeros((4, 6, 3), dtype=np.uint8)
+    expected_end[0:2, 0:2] = 255
+    assert np.array_equal(out.get_frame(2.0), expected_end)
+
+
+def test_rescaled_track_grows_motion_range():
+    small = np.full((2, 2, 3), 255, dtype=np.uint8)
+    clip = static_clip(small, duration=2.0)
+    base = KeyframeTrack([(0.0, (1.0, 1.0)), (2.0, (2.0, 1.0))])
+    out = clip.with_effects(
+        [KeyframeMotion(position=base.rescaled(2.0), canvas_size=(8, 4))]
+    )
+    # t=2 -> center (4, 2) -> top-left (3, 1)
+    expected = np.zeros((4, 8, 3), dtype=np.uint8)
+    expected[1:3, 3:5] = 255
+    assert np.array_equal(out.get_frame(2.0), expected)
+
+
+def test_subclip_after_effect():
+    # the effect composes with the standard clip machinery: subclipping
+    # the animated clip shifts the sampled keyframe times
+    clip = ColorClip(size=(2, 2), color=(255, 255, 255), duration=4.0)
+    effect = KeyframeMotion(
+        position=KeyframeTrack([(0.0, (1.0, 1.0)), (4.0, (5.0, 1.0))]),
+        canvas_size=(6, 4),
+    )
+    out = clip.with_effects([effect]).subclipped(2.0, 4.0)
+    assert out.duration == 2.0
+    # subclip t=0 maps to original t=2 -> center (3, 1) -> top-left (2, 0)
+    frame = out.get_frame(0.0)
+    expected = np.zeros((4, 6, 3), dtype=np.uint8)
+    expected[0:2, 2:4] = 255
+    assert np.array_equal(frame, expected)
+
+
+def test_opacity_exact_multiplication_table():
+    # frozen multiplication cases, all exactly representable
+    cases = [
+        ((200, 100, 48), 1.0, (200, 100, 48)),
+        ((200, 100, 48), 0.5, (100, 50, 24)),
+        ((200, 100, 48), 0.25, (50, 25, 12)),
+        ((128, 64, 32), 0.5, (64, 32, 16)),
+        ((255, 255, 255), 0.2, (51, 51, 51)),
+        ((255, 255, 255), 0.0, (0, 0, 0)),
+    ]
+    for color, opacity, expected in cases:
+        clip = ColorClip(size=(2, 2), color=color, duration=1.0)
+        out = clip.with_effects([KeyframeMotion(opacity=opacity)])
+        pixel = tuple(int(v) for v in out.get_frame(0.0)[0, 0])
+        assert pixel == expected, f"color={color} opacity={opacity}"
+
+
+def test_scale_down_animated_intermediate_size():
+    clip = ColorClip(size=(8, 8), color=(200, 30, 60), duration=2.0)
+    track = KeyframeTrack([(0.0, 1.0), (2.0, 0.5)])
+    out = clip.with_effects([KeyframeMotion(scale=track)])
+    # t=1 -> scale 0.75 -> 6x6 block centered on the 8x8 canvas
+    frame = out.get_frame(1.0)
+    assert np.all(frame[1:7, 1:7] == (200, 30, 60))
+    assert not frame[0, :].any()
+    assert not frame[7, :].any()
+    assert not frame[:, 0].any()
+    assert not frame[:, 7].any()
+
+
+def test_default_position_is_canvas_center():
+    # a clip placed on a canvas larger than itself is centered by default
+    small = np.full((2, 2, 3), 255, dtype=np.uint8)
+    clip = static_clip(small)
+    out = clip.with_effects([KeyframeMotion(canvas_size=(6, 4))])
+    frame = out.get_frame(0.0)
+    expected = np.zeros((4, 6, 3), dtype=np.uint8)
+    expected[1:3, 2:4] = 255
+    assert np.array_equal(frame, expected)
+
+
+def test_rotation_90_of_nonsquare_quadrant_frame():
+    # 2x4 (h x w) frame: left half red, right half green
+    frame = np.zeros((2, 4, 3), dtype=np.uint8)
+    frame[:, :2] = (255, 0, 0)
+    frame[:, 2:] = (0, 255, 0)
+    clip = static_clip(frame)
+    out = clip.with_effects([KeyframeMotion(rotation=90.0)])
+    result = out.get_frame(0.0)
+    # rotating the wide bar 90 degrees CCW turns it into a vertical bar
+    # on the 4x2 canvas: the top column comes from the old right half
+    expected = np.zeros((2, 4, 3), dtype=np.uint8)
+    expected[0, 1:3] = (0, 255, 0)
+    expected[1, 1:3] = (255, 0, 0)
+    assert np.array_equal(result, expected)
+
+
+def test_three_tuple_tracks_are_rejected_for_all_parameters():
+    clip = static_clip(quadrant_frame(4))
+    three = KeyframeTrack([(0.0, (1.0, 2.0, 3.0)), (1.0, (4.0, 5.0, 6.0))])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(position=three)])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(scale=three)])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(rotation=three)])
+    with pytest.raises(ValueError):
+        clip.with_effects([KeyframeMotion(opacity=three)])
+
+
+def test_static_arguments_accept_lists_as_pairs():
+    small = np.full((2, 2, 3), 255, dtype=np.uint8)
+    clip = static_clip(small)
+    out = clip.with_effects(
+        [KeyframeMotion(position=[3, 2], scale=[1.0, 1.0], canvas_size=[6, 4])]
+    )
+    frame = out.get_frame(0.0)
+    expected = np.zeros((4, 6, 3), dtype=np.uint8)
+    expected[1:3, 2:4] = 255
+    assert np.array_equal(frame, expected)
+    assert out.size == (6, 4)
+
+
+def test_rotation_track_values_are_unbounded():
+    # rotation angles are not clamped: 450 degrees is the same as 90
+    frame = quadrant_frame(4)
+    out = static_clip(frame).with_effects([KeyframeMotion(rotation=450.0)])
+    assert np.array_equal(out.get_frame(0.0), np.rot90(frame))
+
+
+def test_scale_static_tuple():
+    clip = ColorClip(size=(4, 4), color=(200, 30, 60), duration=1.0)
+    out = clip.with_effects([KeyframeMotion(scale=(0.5, 0.25))])
+    frame = out.get_frame(0.0)
+    # 4x4 -> 2 wide, 1 high, centered on the 4x4 canvas
+    expected = np.zeros((4, 4, 3), dtype=np.uint8)
+    expected[2, 1:3] = (200, 30, 60)
+    assert np.array_equal(frame, expected)
+
+
+def test_mask_and_audio_pass_through_untouched():
+    from moviepy import AudioClip
+
+    clip = static_clip(quadrant_frame(4), duration=2.0)
+    audio = AudioClip(frame_function=lambda t: 0 * t, duration=2.0, fps=8000)
+    mask = VideoClip(
+        frame_function=lambda t: np.ones((4, 4)), is_mask=True, duration=2.0
+    )
+    clip = clip.with_audio(audio).with_mask(mask)
+    out = clip.with_effects([KeyframeMotion(rotation=90.0, opacity=0.5)])
+    assert out.audio is not None
+    assert out.mask is not None
+    assert np.array_equal(out.mask.get_frame(0.0), np.ones((4, 4)))
+
+
+def test_effect_can_be_chained_with_other_effects():
+    clip = ColorClip(size=(4, 4), color=(200, 100, 48), duration=2.0)
+    out = clip.with_effects(
+        [
+            KeyframeMotion(opacity=0.5),
+            vfx.MultiplyColor(0.5),
+        ]
+    )
+    # 200 * 0.5 -> 100, then * 0.5 -> 50
+    assert list(out.get_frame(0.0)[0, 0]) == [50, 25, 12]
+
+
+def test_imageclip_with_duration_is_animatable():
+    from moviepy import ImageClip
+
+    image = ImageClip(quadrant_frame(4), duration=2.0)
+    out = image.with_effects(
+        [KeyframeMotion(rotation=KeyframeTrack([(0.0, 0.0), (2.0, 90.0)]))]
+    )
+    assert np.array_equal(out.get_frame(2.0), np.rot90(quadrant_frame(4)))
+
+
+def test_opacity_with_rescaled_and_reversed_tracks():
+    clip = ColorClip(size=(2, 2), color=(200, 100, 48), duration=2.0)
+    fade_in = KeyframeTrack.ramp(0.5, 1.0, 2.0)
+    fade_out = fade_in.reversed()
+    out = clip.with_effects([KeyframeMotion(opacity=fade_out)])
+    assert list(out.get_frame(0.0)[0, 0]) == [200, 100, 48]
+    assert list(out.get_frame(2.0)[0, 0]) == [100, 50, 24]
+    dimmer = KeyframeMotion(opacity=fade_in.rescaled(0.5))
+    out2 = clip.with_effects([dimmer])
+    assert list(out2.get_frame(0.0)[0, 0]) == [50, 25, 12]
+    assert list(out2.get_frame(2.0)[0, 0]) == [100, 50, 24]
+
+
+def test_position_track_constant_factory():
+    small = np.full((2, 2, 3), 255, dtype=np.uint8)
+    clip = static_clip(small)
+    out = clip.with_effects(
+        [KeyframeMotion(position=KeyframeTrack.constant((3, 2)), canvas_size=(6, 4))]
+    )
+    expected = np.zeros((4, 6, 3), dtype=np.uint8)
+    expected[1:3, 2:4] = 255
+    assert np.array_equal(out.get_frame(0.0), expected)
+    assert np.array_equal(out.get_frame(1.9), expected)
+
+
+def test_rotation_with_ramp_factory():
+    frame = quadrant_frame(4)
+    track = KeyframeTrack.ramp(0.0, 90.0, 1.0)
+    out = static_clip(frame, duration=1.0).with_effects(
+        [KeyframeMotion(rotation=track)]
+    )
+    assert np.array_equal(out.get_frame(1.0), np.rot90(frame))
