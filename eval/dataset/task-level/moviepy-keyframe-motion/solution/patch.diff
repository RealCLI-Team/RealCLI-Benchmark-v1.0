 """Defines the base class for all effects in MoviePy."""
 
 import copy as _copy
+import numbers
 from abc import ABCMeta, abstractmethod
 
 from moviepy.Clip import Clip
@@ -40,3 +41,178 @@ class Effect(metaclass=ABCMeta):
 
         """
         pass
+
+    # ------------------------------------------------------------------
+    # Shared helpers for resolving time-varying effect parameters.
+    #
+    # These are used by effects that historically accepted either a static
+    # value or a ``lambda t: value`` (``Resize``, ``Rotate``,
+    # ``MultiplyColor``, ``VideoClip.with_position``, ``with_opacity`` ...).
+    # They now also accept a :class:`~moviepy.keyframe.KeyframeTrack`.
+    # The behaviour on static values and callables is preserved byte for
+    # byte -- the only new branch is the ``KeyframeTrack`` one.
+    #
+    # The helpers are defined on ``Effect`` so that ``KeyframeMotion`` and
+    # the classical effects share exactly the same resolution logic; users
+    # who write custom effects can call them too.
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _is_number(value):
+        """Return True for real numbers (booleans are rejected)."""
+        return isinstance(value, numbers.Real) and not isinstance(value, bool)
+
+    @classmethod
+    def _resolve_time_varying(
+        cls,
+        value,
+        name,
+        expected="scalar",
+        minimum=None,
+        maximum=None,
+        allow_callable=True,
+    ):
+        """Resolve an effect parameter into a callable ``t -> value``.
+
+        Parameters
+        ----------
+        value
+            The user-supplied parameter. Accepted forms:
+
+            * ``None`` -- returned as-is.
+            * A number (when ``expected in ("scalar", "any")``).
+            * A 2-tuple/list of numbers (when ``expected in ("pair", "any")``).
+            * A :class:`~moviepy.keyframe.KeyframeTrack` matching the
+              expected kind.
+            * Any callable (when ``allow_callable`` is true) -- returned
+              as-is; its output is trusted at render time.
+
+        name
+            Parameter name, used in error messages only.
+
+        expected
+            ``"scalar"`` (a number), ``"pair"`` (an ``(a, b)`` pair), or
+            ``"any"`` (either).
+
+        minimum, maximum
+            Optional bounds enforced on scalar values and on every
+            keyframe of a :class:`KeyframeTrack`. Tuple values are checked
+            componentwise.
+
+        allow_callable
+            When true (the default) a plain callable is accepted and
+            returned untouched. Set to false for parameters that must be
+            a static value or a track (e.g. opacity in
+            :class:`KeyframeMotion`).
+
+        Returns
+        -------
+        callable
+            A function ``t -> resolved value`` (or ``None`` if ``value``
+            was ``None``).
+
+        Raises
+        ------
+        TypeError
+            If the value shape does not match ``expected`` or is not a
+            recognised parameter kind.
+        ValueError
+            If a numeric bound is violated.
+        """
+        # Import here to avoid a circular import at module load time.
+        from moviepy.keyframe import KeyframeTrack
+
+        if value is None:
+            return None
+
+        if isinstance(value, KeyframeTrack):
+            return cls._track_to_callable(
+                value, name, expected=expected, minimum=minimum, maximum=maximum
+            )
+
+        if expected in ("scalar", "any") and cls._is_number(value):
+            v = float(value)
+            cls._check_bounds(v, name, minimum, maximum)
+            return lambda t, _v=v: _v
+
+        if expected in ("pair", "any") and isinstance(value, (tuple, list)):
+            if len(value) != 2:
+                raise TypeError(
+                    f"{name} must be a (x, y) pair, got {value!r}"
+                )
+            a, b = value
+            if not (cls._is_number(a) and cls._is_number(b)):
+                raise TypeError(
+                    f"{name} components must be numbers, got {value!r}"
+                )
+            a, b = float(a), float(b)
+            cls._check_bounds(a, name, minimum, maximum)
+            cls._check_bounds(b, name, minimum, maximum)
+            pair = (a, b)
+            return lambda t, _pair=pair: _pair
+
+        if allow_callable and callable(value):
+            return value
+
+        raise TypeError(
+            f"{name} must be a number, a (x, y) pair, a KeyframeTrack, "
+            f"or a callable (got {type(value).__name__!r})"
+        )
+
+    @classmethod
+    def _track_to_callable(
+        cls, track, name, expected="scalar", minimum=None, maximum=None
+    ):
+        """Convert a :class:`KeyframeTrack` into a ``t -> value`` callable.
+
+        Enforces the shape (``scalar`` or ``pair``) and the numeric
+        bounds on every keyframe value before returning.
+        """
+        # Import here to avoid a circular import at module load time.
+        from moviepy.keyframe import KeyframeTrack
+
+        if not isinstance(track, KeyframeTrack):  # pragma: no cover - defensive
+            raise TypeError(
+                f"{name} must be a KeyframeTrack, got {type(track).__name__!r}"
+            )
+
+        if expected == "scalar":
+            if track.is_tuple:
+                raise TypeError(
+                    f"{name} requires a scalar KeyframeTrack, "
+                    "got a tuple-valued track"
+                )
+            for v in track.values:
+                cls._check_bounds(v, name, minimum, maximum)
+        elif expected == "pair":
+            if not track.is_tuple or len(track.values[0]) != 2:
+                raise ValueError(
+                    f"{name} requires a KeyframeTrack of (x, y) pairs"
+                )
+            for v in track.values:
+                cls._check_bounds(v[0], name, minimum, maximum)
+                cls._check_bounds(v[1], name, minimum, maximum)
+        elif expected == "any":
+            if track.is_tuple:
+                for v in track.values:
+                    for component in v:
+                        cls._check_bounds(component, name, minimum, maximum)
+            else:
+                for v in track.values:
+                    cls._check_bounds(v, name, minimum, maximum)
+        else:  # pragma: no cover - defensive
+            raise ValueError(f"unknown expected kind {expected!r}")
+
+        return track.value_at
+
+    @staticmethod
+    def _check_bounds(value, name, minimum, maximum):
+        """Raise ``ValueError`` if ``value`` is outside ``[minimum, maximum]``."""
+        if minimum is not None and value < minimum:
+            raise ValueError(
+                f"{name} values must be >= {minimum}, got {value!r}"
+            )
+        if maximum is not None and value > maximum:
+            raise ValueError(
+                f"{name} values must be <= {maximum}, got {value!r}"
+            )
