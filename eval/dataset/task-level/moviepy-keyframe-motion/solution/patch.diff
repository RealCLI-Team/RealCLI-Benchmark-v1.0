index 0000000..5b46e47
--- /dev/null
+++ b/moviepy/easing.py
@@ -0,0 +1,341 @@
+"""Easing (interpolation) functions for keyframe animation.
+
+Each easing function maps a normalized progress ``p`` in ``[0, 1]`` to an
+eased progress, also nominally in ``[0, 1]`` (``back``/``elastic`` may
+overshoot). All functions satisfy ``f(0) == 0`` and ``f(1) == 1``, except
+``hold`` which only reaches ``1`` exactly at ``p == 1``.
+
+The functions follow the classic Robert Penner easing equations, matching
+the reference implementations published on https://easings.net.
+
+Use ``get_easing`` to resolve an easing given either a registered name or
+an arbitrary callable.
+"""
+
+import math
+
+
+def linear(p):
+    """No easing: ``f(p) = p``."""
+    return p
+
+
+def hold(p):
+    """Step easing: stays at the start value until the very end.
+
+    ``f(p) = 0`` for every ``p < 1`` and ``f(1) = 1``.
+    """
+    return 0.0 if p < 1.0 else 1.0
+
+
+# ---------------------------------------------------------------------- quad
+
+
+def ease_in_quad(p):
+    """Quadratic ease in: ``f(p) = p ** 2``."""
+    return p * p
+
+
+def ease_out_quad(p):
+    """Quadratic ease out: ``f(p) = 1 - (1 - p) ** 2``."""
+    return 1.0 - (1.0 - p) * (1.0 - p)
+
+
+def ease_in_out_quad(p):
+    """Quadratic ease in/out."""
+    if p < 0.5:
+        return 2.0 * p * p
+    return 1.0 - ((-2.0 * p + 2.0) ** 2) / 2.0
+
+
+# --------------------------------------------------------------------- cubic
+
+
+def ease_in_cubic(p):
+    """Cubic ease in: ``f(p) = p ** 3``."""
+    return p * p * p
+
+
+def ease_out_cubic(p):
+    """Cubic ease out: ``f(p) = 1 - (1 - p) ** 3``."""
+    return 1.0 - (1.0 - p) ** 3
+
+
+def ease_in_out_cubic(p):
+    """Cubic ease in/out."""
+    if p < 0.5:
+        return 4.0 * p * p * p
+    return 1.0 - ((-2.0 * p + 2.0) ** 3) / 2.0
+
+
+# --------------------------------------------------------------------- quart
+
+
+def ease_in_quart(p):
+    """Quartic ease in: ``f(p) = p ** 4``."""
+    return p * p * p * p
+
+
+def ease_out_quart(p):
+    """Quartic ease out: ``f(p) = 1 - (1 - p) ** 4``."""
+    return 1.0 - (1.0 - p) ** 4
+
+
+def ease_in_out_quart(p):
+    """Quartic ease in/out."""
+    if p < 0.5:
+        return 8.0 * p * p * p * p
+    return 1.0 - ((-2.0 * p + 2.0) ** 4) / 2.0
+
+
+# --------------------------------------------------------------------- quint
+
+
+def ease_in_quint(p):
+    """Quintic ease in: ``f(p) = p ** 5``."""
+    return p * p * p * p * p
+
+
+def ease_out_quint(p):
+    """Quintic ease out: ``f(p) = 1 - (1 - p) ** 5``."""
+    return 1.0 - (1.0 - p) ** 5
+
+
+def ease_in_out_quint(p):
+    """Quintic ease in/out."""
+    if p < 0.5:
+        return 16.0 * p * p * p * p * p
+    return 1.0 - ((-2.0 * p + 2.0) ** 5) / 2.0
+
+
+# ---------------------------------------------------------------------- sine
+
+
+def ease_in_sine(p):
+    """Sinusoidal ease in: ``f(p) = 1 - cos(p * pi / 2)``."""
+    return 1.0 - math.cos(p * math.pi / 2.0)
+
+
+def ease_out_sine(p):
+    """Sinusoidal ease out: ``f(p) = sin(p * pi / 2)``."""
+    return math.sin(p * math.pi / 2.0)
+
+
+def ease_in_out_sine(p):
+    """Sinusoidal ease in/out: ``f(p) = -(cos(pi * p) - 1) / 2``."""
+    return -(math.cos(math.pi * p) - 1.0) / 2.0
+
+
+# ---------------------------------------------------------------------- expo
+
+
+def ease_in_expo(p):
+    """Exponential ease in: ``f(p) = 2 ** (10 * p - 10)`` (``0`` at ``p = 0``)."""
+    if p == 0.0:
+        return 0.0
+    return 2.0 ** (10.0 * p - 10.0)
+
+
+def ease_out_expo(p):
+    """Exponential ease out: ``f(p) = 1 - 2 ** (-10 * p)`` (``1`` at ``p = 1``)."""
+    if p == 1.0:
+        return 1.0
+    return 1.0 - 2.0 ** (-10.0 * p)
+
+
+def ease_in_out_expo(p):
+    """Exponential ease in/out."""
+    if p == 0.0:
+        return 0.0
+    if p == 1.0:
+        return 1.0
+    if p < 0.5:
+        return (2.0 ** (20.0 * p - 10.0)) / 2.0
+    return (2.0 - 2.0 ** (-20.0 * p + 10.0)) / 2.0
+
+
+# ---------------------------------------------------------------------- circ
+
+
+def ease_in_circ(p):
+    """Circular ease in: ``f(p) = 1 - sqrt(1 - p ** 2)``."""
+    return 1.0 - math.sqrt(1.0 - p * p)
+
+
+def ease_out_circ(p):
+    """Circular ease out: ``f(p) = sqrt(1 - (p - 1) ** 2)``."""
+    return math.sqrt(1.0 - (p - 1.0) ** 2)
+
+
+def ease_in_out_circ(p):
+    """Circular ease in/out."""
+    if p < 0.5:
+        return (1.0 - math.sqrt(1.0 - (2.0 * p) ** 2)) / 2.0
+    return (math.sqrt(1.0 - (-2.0 * p + 2.0) ** 2) + 1.0) / 2.0
+
+
+# ---------------------------------------------------------------------- back
+
+
+def ease_in_back(p):
+    """Back ease in (slight overshoot backwards before progressing)."""
+    c1 = 1.70158
+    c3 = c1 + 1.0
+    return c3 * p * p * p - c1 * p * p
+
+
+def ease_out_back(p):
+    """Back ease out (overshoots the target before settling)."""
+    c1 = 1.70158
+    c3 = c1 + 1.0
+    return 1.0 + c3 * (p - 1.0) ** 3 + c1 * (p - 1.0) ** 2
+
+
+def ease_in_out_back(p):
+    """Back ease in/out."""
+    c1 = 1.70158
+    c2 = c1 * 1.525
+    if p < 0.5:
+        return ((2.0 * p) ** 2 * ((c2 + 1.0) * 2.0 * p - c2)) / 2.0
+    return ((2.0 * p - 2.0) ** 2 * ((c2 + 1.0) * (2.0 * p - 2.0) + c2) + 2.0) / 2.0
+
+
+# ------------------------------------------------------------------- elastic
+
+
+def ease_in_elastic(p):
+    """Elastic ease in (damped spring start)."""
+    c4 = (2.0 * math.pi) / 3.0
+    if p == 0.0:
+        return 0.0
+    if p == 1.0:
+        return 1.0
+    return -(2.0 ** (10.0 * p - 10.0)) * math.sin((10.0 * p - 10.75) * c4)
+
+
+def ease_out_elastic(p):
+    """Elastic ease out (damped spring settle)."""
+    c4 = (2.0 * math.pi) / 3.0
+    if p == 0.0:
+        return 0.0
+    if p == 1.0:
+        return 1.0
+    return 2.0 ** (-10.0 * p) * math.sin((10.0 * p - 0.75) * c4) + 1.0
+
+
+def ease_in_out_elastic(p):
+    """Elastic ease in/out."""
+    c5 = (2.0 * math.pi) / 4.5
+    if p == 0.0:
+        return 0.0
+    if p == 1.0:
+        return 1.0
+    if p < 0.5:
+        return -(2.0 ** (20.0 * p - 10.0) * math.sin((20.0 * p - 11.125) * c5)) / 2.0
+    return (2.0 ** (-20.0 * p + 10.0) * math.sin((20.0 * p - 11.125) * c5)) / 2.0 + 1.0
+
+
+# ------------------------------------------------------------------- bounce
+
+
+def ease_out_bounce(p):
+    """Bounce ease out (ball dropping and bouncing to rest)."""
+    n1 = 7.5625
+    d1 = 2.75
+    if p < 1.0 / d1:
+        return n1 * p * p
+    if p < 2.0 / d1:
+        p -= 1.5 / d1
+        return n1 * p * p + 0.75
+    if p < 2.5 / d1:
+        p -= 2.25 / d1
+        return n1 * p * p + 0.9375
+    p -= 2.625 / d1
+    return n1 * p * p + 0.984375
+
+
+def ease_in_bounce(p):
+    """Bounce ease in: mirror of :func:`ease_out_bounce`."""
+    return 1.0 - ease_out_bounce(1.0 - p)
+
+
+def ease_in_out_bounce(p):
+    """Bounce ease in/out."""
+    if p < 0.5:
+        return (1.0 - ease_out_bounce(1.0 - 2.0 * p)) / 2.0
+    return (1.0 + ease_out_bounce(2.0 * p - 1.0)) / 2.0
+
+
+# Registry of the built-in easing functions, by name.
+EASINGS = {
+    "linear": linear,
+    "hold": hold,
+    "ease_in_quad": ease_in_quad,
+    "ease_out_quad": ease_out_quad,
+    "ease_in_out_quad": ease_in_out_quad,
+    "ease_in_cubic": ease_in_cubic,
+    "ease_out_cubic": ease_out_cubic,
+    "ease_in_out_cubic": ease_in_out_cubic,
+    "ease_in_quart": ease_in_quart,
+    "ease_out_quart": ease_out_quart,
+    "ease_in_out_quart": ease_in_out_quart,
+    "ease_in_quint": ease_in_quint,
+    "ease_out_quint": ease_out_quint,
+    "ease_in_out_quint": ease_in_out_quint,
+    "ease_in_sine": ease_in_sine,
+    "ease_out_sine": ease_out_sine,
+    "ease_in_out_sine": ease_in_out_sine,
+    "ease_in_expo": ease_in_expo,
+    "ease_out_expo": ease_out_expo,
+    "ease_in_out_expo": ease_in_out_expo,
+    "ease_in_circ": ease_in_circ,
+    "ease_out_circ": ease_out_circ,
+    "ease_in_out_circ": ease_in_out_circ,
+    "ease_in_back": ease_in_back,
+    "ease_out_back": ease_out_back,
+    "ease_in_out_back": ease_in_out_back,
+    "ease_in_elastic": ease_in_elastic,
+    "ease_out_elastic": ease_out_elastic,
+    "ease_in_out_elastic": ease_in_out_elastic,
+    "ease_in_bounce": ease_in_bounce,
+    "ease_out_bounce": ease_out_bounce,
+    "ease_in_out_bounce": ease_in_out_bounce,
+}
+
+
+def get_easing(easing):
+    """Resolve an easing specification to a callable.
+
+    Parameters
+    ----------
+    easing : str or callable
+        Either the name of a registered easing function (see
+        ``EASINGS.keys()``) or an arbitrary callable mapping a progress in
+        ``[0, 1]`` to an eased progress.
+
+    Returns
+    -------
+    callable
+        The resolved easing function.
+
+    Raises
+    ------
+    ValueError
+        If ``easing`` is a string that is not a registered easing name.
+    TypeError
+        If ``easing`` is neither a string nor a callable.
+    """
+    if isinstance(easing, str):
+        try:
+            return EASINGS[easing]
+        except KeyError:
+            raise ValueError(
+                f"Unknown easing name {easing!r}. "
+                f"Available easings: {sorted(EASINGS)}"
+            ) from None
+    if callable(easing):
+        return easing
+    raise TypeError(
+        f"easing must be a registered easing name or a callable, "
+        f"got {type(easing).__name__!r}"
+    )
diff --git a/moviepy/keyframe.py b/moviepy/keyframe.py
