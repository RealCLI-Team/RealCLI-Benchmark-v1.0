+# --------------------------------------------- easing coverage through tracks
+
+
+@pytest.mark.parametrize(
+    "easing_name",
+    sorted(__import__("moviepy.easing", fromlist=["EASINGS"]).EASINGS),
+)
+def test_unit_ramp_matches_easing_at_sample_points(easing_name):
+    """A 0 -> 1 ramp over [0, 1] must sample its easing exactly."""
+    from moviepy.easing import EASINGS
+
+    track = KeyframeTrack([(0.0, 0.0), (1.0, 1.0)], easing=easing_name)
+    func = EASINGS[easing_name]
+    for i in range(11):
+        p = i / 10.0
+        assert track.value_at(p) == pytest.approx(func(p), abs=1e-12)
+
+
+@pytest.mark.parametrize(
+    "easing_name", ["linear", "ease_in_quad", "ease_out_expo", "ease_in_out_back"]
+)
+def test_easing_scales_and_offsets_linearly(easing_name):
+    """a + (b - a) * easing(p) for arbitrary a, b and segment bounds."""
+    from moviepy.easing import EASINGS
+
+    track = KeyframeTrack([(1.0, -4.0), (3.0, 6.0)], easing=easing_name)
+    func = EASINGS[easing_name]
+    for i in range(11):
+        p = i / 10.0
+        assert track.value_at(1.0 + 2.0 * p) == pytest.approx(
+            -4.0 + 10.0 * func(p), abs=1e-9
+        )
+
+
+# ------------------------------------------------------------- numeric types
+
+
+def test_integer_times_and_values_are_accepted():
+    track = KeyframeTrack([(0, 0), (2, 4)])
+    assert track.times == (0.0, 2.0)
+    assert track.value_at(1) == 2.0
+
+
+def test_numpy_scalar_types_are_accepted():
+    np = pytest.importorskip("numpy")
+    track = KeyframeTrack(
+        [(np.float64(0.0), np.int64(1)), (np.float64(1.0), np.float32(2.0))]
+    )
+    assert track.value_at(0.5) == pytest.approx(1.5)
+
+
+def test_numpy_scalar_time_argument():
+    np = pytest.importorskip("numpy")
+    track = KeyframeTrack([(0.0, 0.0), (1.0, 10.0)])
+    assert track.value_at(np.float64(0.5)) == pytest.approx(5.0)
+
+
+def test_value_at_returns_float_not_int():
+    track = KeyframeTrack([(0, 0), (2, 4)])
+    assert isinstance(track.value_at(1), float)
+    assert isinstance(track.times[0], float)
+
+
+def test_tracks_with_many_keyframes():
+    keyframes = [(float(i), float(i * i)) for i in range(20)]
+    track = KeyframeTrack(keyframes)
+    assert len(track) == 20
+    assert track.duration == 19.0
+    assert track.value_at(10.5) == pytest.approx((100.0 + 121.0) / 2.0)
+    for i in range(20):
+        assert track.value_at(float(i)) == float(i * i)
+
+
+def test_track_immutability_of_input_list():
+    keyframes = [[0.0, 1.0], [1.0, 2.0]]
+    track = KeyframeTrack(keyframes)
+    keyframes[0][1] = 999.0
+    keyframes.append((2.0, 3.0))
+    assert track.values == (1.0, 2.0)
+    assert len(track) == 2
+
+
+@pytest.mark.parametrize(
+    "easing_name",
+    sorted(__import__("moviepy.easing", fromlist=["EASINGS"]).EASINGS),
+)
+def test_tuple_ramp_matches_easing_componentwise(easing_name):
+    """Tuple tracks ease every component with the same eased progress."""
+    from moviepy.easing import EASINGS
+
+    track = KeyframeTrack(
+        [(0.0, (0.0, 10.0)), (1.0, (4.0, 50.0))], easing=easing_name
+    )
+    func = EASINGS[easing_name]
+    for i in range(11):
+        p = i / 10.0
+        eased = func(p)
+        assert track.value_at(p) == pytest.approx(
+            (4.0 * eased, 10.0 + 40.0 * eased), abs=1e-9
+        )
