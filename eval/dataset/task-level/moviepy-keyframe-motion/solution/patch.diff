index 0000000..37215bc
--- /dev/null
+++ b/moviepy/keyframe.py
@@ -0,0 +1,293 @@
+"""Keyframe tracks: time-indexed values with eased interpolation.
+
+A :class:`KeyframeTrack` stores an ordered sequence of ``(time, value)``
+keyframes and evaluates values at arbitrary times by interpolating between
+neighbouring keyframes with an easing function (see :mod:`moviepy.easing`).
+
+Values can be plain numbers (scalar tracks) or tuples of numbers of a fixed
+length (tuple tracks, interpolated componentwise), which makes the class
+usable for animating scalars (opacity, rotation, zoom) as well as positions
+or scaling factors.
+"""
+
+import numbers
+
+from moviepy.easing import get_easing
+
+
+def _is_number(value):
+    """Return True for real numbers (excluding booleans)."""
+    return isinstance(value, numbers.Real) and not isinstance(value, bool)
+
+
+def _validate_value(value):
+    """Validate one keyframe value, returning ``(kind, converted)``.
+
+    ``kind`` is ``"scalar"`` for real numbers and ``"tuple"`` for
+    tuples/lists of real numbers. The converted value is a float for
+    scalars and a tuple of floats for tuples.
+    """
+    if _is_number(value):
+        return "scalar", float(value)
+    if isinstance(value, (tuple, list)):
+        if len(value) < 2:
+            raise ValueError(
+                "tuple keyframe values must contain at least two components, "
+                f"got {value!r}"
+            )
+        for component in value:
+            if not _is_number(component):
+                raise TypeError(
+                    "tuple keyframe values must only contain numbers, "
+                    f"got component {component!r}"
+                )
+        return "tuple", tuple(float(component) for component in value)
+    raise TypeError(
+        "keyframe values must be numbers or tuples/lists of numbers, "
+        f"got {type(value).__name__!r}"
+    )
+
+
+class KeyframeTrack:
+    """An ordered sequence of keyframes with eased interpolation.
+
+    Parameters
+    ----------
+
+    keyframes
+        A non-empty sequence of ``(time, value)`` pairs. Times must be
+        non-negative numbers, strictly increasing. Values must all be
+        either real numbers (scalar track) or tuples/lists of real numbers
+        of the same length (tuple track).
+
+    easing
+        The easing used between keyframes: either the name of a registered
+        easing function (see ``moviepy.easing.EASINGS``) or a callable
+        mapping a progress in ``[0, 1]`` to an eased progress. Defaults to
+        ``"linear"``.
+
+    Examples
+    --------
+
+    .. code:: python
+
+        track = KeyframeTrack([(0.0, 0.0), (2.0, 100.0)], easing="ease_in_out_quad")
+        track.value_at(0.0)   # 0.0
+        track.value_at(1.0)   # 50.0
+        track.value_at(5.0)   # 100.0 (clamped to the last keyframe)
+
+    """
+
+    def __init__(self, keyframes, easing="linear"):
+        if isinstance(keyframes, (str, bytes)) or not hasattr(keyframes, "__iter__"):
+            raise TypeError(
+                "keyframes must be a sequence of (time, value) pairs, "
+                f"got {type(keyframes).__name__!r}"
+            )
+        keyframes = list(keyframes)
+        if len(keyframes) == 0:
+            raise ValueError("a keyframe track needs at least one keyframe")
+
+        times = []
+        values = []
+        kind = None
+        tuple_length = None
+        for keyframe in keyframes:
+            try:
+                time, value = keyframe
+            except (TypeError, ValueError):
+                raise TypeError(
+                    "each keyframe must be a (time, value) pair, "
+                    f"got {keyframe!r}"
+                ) from None
+            if not _is_number(time):
+                raise TypeError(
+                    f"keyframe times must be numbers, got {time!r}"
+                )
+            time = float(time)
+            if time < 0.0:
+                raise ValueError(
+                    f"keyframe times must be non-negative, got {time!r}"
+                )
+            if times and time <= times[-1]:
+                raise ValueError(
+                    "keyframe times must be strictly increasing, got "
+                    f"{times[-1]!r} followed by {time!r}"
+                )
+            new_kind, converted = _validate_value(value)
+            if kind is None:
+                kind = new_kind
+                if new_kind == "tuple":
+                    tuple_length = len(converted)
+            elif new_kind != kind:
+                raise ValueError(
+                    "all keyframe values of a track must be of the same kind "
+                    f"(all scalars or all tuples), got {value!r}"
+                )
+            elif new_kind == "tuple" and len(converted) != tuple_length:
+                raise ValueError(
+                    "all tuple keyframe values of a track must have the same "
+                    f"length, expected {tuple_length}, got {len(converted)}"
+                )
+            times.append(time)
+            values.append(converted)
+
+        self._times = tuple(times)
+        self._values = tuple(values)
+        self._kind = kind
+        self._easing = get_easing(easing)
+
+    @classmethod
+    def constant(cls, value):
+        """Build a track holding ``value`` at all times.
+
+        ``value`` follows the same rules as keyframe values (a number or
+        a tuple/list of numbers). The resulting track has a single
+        keyframe at time ``0.0`` and therefore evaluates to ``value`` at
+        any time.
+        """
+        return cls([(0.0, value)])
+
+    @classmethod
+    def ramp(cls, start_value, end_value, duration, easing="linear"):
+        """Build a two-keyframe track going from one value to another.
+
+        The track starts at ``start_value`` at time ``0.0`` and reaches
+        ``end_value`` at time ``duration``, interpolating with the given
+        ``easing``. ``duration`` must be a number strictly greater than
+        zero; ``start_value`` and ``end_value`` follow the same rules as
+        keyframe values and must be of the same kind and shape.
+        """
+        if not _is_number(duration):
+            raise TypeError(
+                f"duration must be a number, got {type(duration).__name__!r}"
+            )
+        duration = float(duration)
+        if duration <= 0.0:
+            raise ValueError(
+                f"duration must be strictly positive, got {duration!r}"
+            )
+        return cls([(0.0, start_value), (duration, end_value)], easing=easing)
+
+    @property
+    def times(self):
+        """The keyframe times, as a tuple of floats."""
+        return self._times
+
+    @property
+    def values(self):
+        """The keyframe values, as a tuple (of floats or tuples of floats)."""
+        return self._values
+
+    @property
+    def easing(self):
+        """The easing function used between keyframes."""
+        return self._easing
+
+    @property
+    def duration(self):
+        """Time of the last keyframe (``0.0`` for single-keyframe tracks)."""
+        return self._times[-1]
+
+    @property
+    def is_tuple(self):
+        """True if the track values are tuples (interpolated componentwise)."""
+        return self._kind == "tuple"
+
+    def __len__(self):
+        return len(self._times)
+
+    def __repr__(self):
+        keyframes = list(zip(self._times, self._values))
+        return f"{type(self).__name__}({keyframes!r})"
+
+    def value_at(self, t):
+        """Evaluate the track at time ``t``.
+
+        Times before the first keyframe evaluate to the first value and
+        times at or after the last keyframe evaluate to the last value
+        (clamping). Between two keyframes the value is interpolated with
+        the track's easing applied to the segment progress; tuple values
+        are interpolated componentwise.
+
+        Scalar tracks return a float, tuple tracks return a tuple of
+        floats.
+        """
+        if not _is_number(t):
+            raise TypeError(f"t must be a number, got {t!r}")
+        t = float(t)
+        if t <= self._times[0]:
+            return self._values[0]
+        if t >= self._times[-1]:
+            return self._values[-1]
+        # find the segment containing t
+        index = 0
+        for index in range(len(self._times) - 1):
+            if self._times[index] <= t < self._times[index + 1]:
+                break
+        t0, t1 = self._times[index], self._times[index + 1]
+        v0, v1 = self._values[index], self._values[index + 1]
+        progress = (t - t0) / (t1 - t0)
+        eased = self._easing(progress)
+        if self._kind == "scalar":
+            return v0 + (v1 - v0) * eased
+        return tuple(
+            component0 + (component1 - component0) * eased
+            for component0, component1 in zip(v0, v1)
+        )
+
+    def rescaled(self, factor):
+        """Return a new track with every value multiplied by ``factor``.
+
+        ``factor`` must be a number; it is applied to scalar values or to
+        every component of tuple values. Times and easing are preserved.
+        The original track is left untouched.
+        """
+        if not _is_number(factor):
+            raise TypeError(f"factor must be a number, got {factor!r}")
+        factor = float(factor)
+        if self._kind == "scalar":
+            values = [v * factor for v in self._values]
+        else:
+            values = [
+                tuple(component * factor for component in v)
+                for v in self._values
+            ]
+        return KeyframeTrack(
+            list(zip(self._times, values)), easing=self._easing
+        )
+
+    def shifted(self, offset):
+        """Return a new track with every keyframe time shifted by ``offset``.
+
+        ``offset`` must be a number. All shifted times must remain
+        non-negative, otherwise ``ValueError`` is raised. Values and
+        easing are preserved. The original track is left untouched.
+        """
+        if not _is_number(offset):
+            raise TypeError(f"offset must be a number, got {offset!r}")
+        offset = float(offset)
+        times = [t + offset for t in self._times]
+        if times[0] < 0.0:
+            raise ValueError(
+                f"shifting by {offset!r} would make keyframe times negative"
+            )
+        return KeyframeTrack(
+            list(zip(times, self._values)), easing=self._easing
+        )
+
+    def reversed(self):
+        """Return a new track playing the same animation backwards in time.
+
+        The new track spans ``[0, duration]``: its first keyframe is the
+        original last value at time ``0`` and its last keyframe is the
+        original first value at time ``duration``. Formally the new track
+        ``r`` satisfies ``r.value_at(t) == self.value_at(duration - t)``
+        for tracks using the ``linear`` easing (other easings are kept
+        as-is, so the easing curve itself is *not* mirrored). The original
+        track is left untouched.
+        """
+        end = self._times[-1]
+        times = [end - t for t in reversed(self._times)]
+        values = list(reversed(self._values))
+        return KeyframeTrack(list(zip(times, values)), easing=self._easing)
