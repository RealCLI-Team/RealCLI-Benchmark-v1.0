diff --git a/tests/test_easing.py b/tests/test_easing.py
new file mode 100644
index 0000000..7067be0
--- /dev/null
+++ b/tests/test_easing.py
@@ -0,0 +1,325 @@
+"""Tests for :mod:`moviepy.easing`."""
+
+import math
+
+import pytest
+
+from moviepy import easing
+from moviepy.easing import EASINGS, get_easing
+
+
+ALL_NAMES = [
+    "linear",
+    "hold",
+    "ease_in_quad",
+    "ease_out_quad",
+    "ease_in_out_quad",
+    "ease_in_cubic",
+    "ease_out_cubic",
+    "ease_in_out_cubic",
+    "ease_in_quart",
+    "ease_out_quart",
+    "ease_in_out_quart",
+    "ease_in_quint",
+    "ease_out_quint",
+    "ease_in_out_quint",
+    "ease_in_sine",
+    "ease_out_sine",
+    "ease_in_out_sine",
+    "ease_in_expo",
+    "ease_out_expo",
+    "ease_in_out_expo",
+    "ease_in_circ",
+    "ease_out_circ",
+    "ease_in_out_circ",
+    "ease_in_back",
+    "ease_out_back",
+    "ease_in_out_back",
+    "ease_in_elastic",
+    "ease_out_elastic",
+    "ease_in_out_elastic",
+    "ease_in_bounce",
+    "ease_out_bounce",
+    "ease_in_out_bounce",
+]
+
+
+def test_registry_contains_all_documented_easings():
+    assert sorted(EASINGS) == sorted(ALL_NAMES)
+
+
+@pytest.mark.parametrize("name", ALL_NAMES)
+def test_registry_functions_are_callable(name):
+    assert callable(EASINGS[name])
+
+
+@pytest.mark.parametrize("name", ALL_NAMES)
+def test_endpoints(name):
+    """Every easing maps 0 -> 0 and 1 -> 1."""
+    func = EASINGS[name]
+    assert func(0.0) == pytest.approx(0.0, abs=1e-12)
+    assert func(1.0) == pytest.approx(1.0, abs=1e-12)
+
+
+@pytest.mark.parametrize("name", ALL_NAMES)
+def test_monotonic_or_bounded_output(name):
+    """Outputs stay within a sane range (back/elastic may overshoot)."""
+    func = EASINGS[name]
+    for i in range(101):
+        value = func(i / 100.0)
+        assert -2.0 < value < 3.0
+
+
+# ------------------------------------------------------------- exact formulas
+
+
+def test_linear():
+    assert easing.linear(0.0) == 0.0
+    assert easing.linear(0.37) == 0.37
+    assert easing.linear(1.0) == 1.0
+
+
+def test_hold():
+    assert easing.hold(0.0) == 0.0
+    assert easing.hold(0.999) == 0.0
+    assert easing.hold(1.0) == 1.0
+
+
+def test_quad_family():
+    assert easing.ease_in_quad(0.5) == pytest.approx(0.25)
+    assert easing.ease_out_quad(0.5) == pytest.approx(0.75)
+    assert easing.ease_in_out_quad(0.25) == pytest.approx(0.125)
+    assert easing.ease_in_out_quad(0.5) == pytest.approx(0.5)
+    assert easing.ease_in_out_quad(0.75) == pytest.approx(0.875)
+
+
+def test_cubic_family():
+    assert easing.ease_in_cubic(0.5) == pytest.approx(0.125)
+    assert easing.ease_out_cubic(0.5) == pytest.approx(0.875)
+    assert easing.ease_in_out_cubic(0.25) == pytest.approx(0.0625)
+    assert easing.ease_in_out_cubic(0.5) == pytest.approx(0.5)
+    assert easing.ease_in_out_cubic(0.75) == pytest.approx(0.9375)
+
+
+def test_quart_family():
+    assert easing.ease_in_quart(0.5) == pytest.approx(0.0625)
+    assert easing.ease_out_quart(0.5) == pytest.approx(0.9375)
+    assert easing.ease_in_out_quart(0.5) == pytest.approx(0.5)
+
+
+def test_quint_family():
+    assert easing.ease_in_quint(0.5) == pytest.approx(0.03125)
+    assert easing.ease_out_quint(0.5) == pytest.approx(0.96875)
+    assert easing.ease_in_out_quint(0.5) == pytest.approx(0.5)
+
+
+def test_sine_family():
+    assert easing.ease_in_sine(1.0) == pytest.approx(1.0)
+    assert easing.ease_out_sine(1.0) == pytest.approx(1.0)
+    assert easing.ease_in_sine(0.5) == pytest.approx(1.0 - math.cos(math.pi / 4.0))
+    assert easing.ease_out_sine(0.5) == pytest.approx(math.sin(math.pi / 4.0))
+    assert easing.ease_in_out_sine(0.5) == pytest.approx(0.5)
+
+
+def test_expo_family():
+    assert easing.ease_in_expo(0.0) == 0.0
+    assert easing.ease_in_expo(0.5) == pytest.approx(2.0 ** -5)
+    assert easing.ease_out_expo(1.0) == 1.0
+    assert easing.ease_out_expo(0.5) == pytest.approx(1.0 - 2.0 ** -5)
+    assert easing.ease_in_out_expo(0.0) == 0.0
+    assert easing.ease_in_out_expo(1.0) == 1.0
+    assert easing.ease_in_out_expo(0.5) == pytest.approx(0.5)
+
+
+def test_circ_family():
+    assert easing.ease_in_circ(0.5) == pytest.approx(1.0 - math.sqrt(0.75))
+    assert easing.ease_out_circ(0.5) == pytest.approx(math.sqrt(0.75))
+    assert easing.ease_in_out_circ(0.5) == pytest.approx(0.5)
+
+
+def test_back_family():
+    c1 = 1.70158
+    c3 = c1 + 1.0
+    assert easing.ease_in_back(0.5) == pytest.approx(c3 * 0.125 - c1 * 0.25)
+    assert easing.ease_out_back(0.5) == pytest.approx(
+        1.0 + c3 * (-0.5) ** 3 + c1 * 0.25
+    )
+    assert easing.ease_in_out_back(0.5) == pytest.approx(0.5)
+    # ease_in_back dips below zero (pull-back before moving forward)
+    assert easing.ease_in_back(0.3) < 0.0
+    # ease_out_back overshoots beyond one
+    assert easing.ease_out_back(0.7) > 1.0
+
+
+def test_elastic_family():
+    assert easing.ease_in_elastic(0.0) == 0.0
+    assert easing.ease_in_elastic(1.0) == 1.0
+    assert easing.ease_out_elastic(0.0) == 0.0
+    assert easing.ease_out_elastic(1.0) == 1.0
+    assert easing.ease_in_out_elastic(0.0) == 0.0
+    assert easing.ease_in_out_elastic(1.0) == 1.0
+    # the elastic out oscillates above 1 before settling
+    assert max(easing.ease_out_elastic(i / 100.0) for i in range(1, 100)) > 1.0
+    # the elastic in oscillates below 0
+    assert min(easing.ease_in_elastic(i / 100.0) for i in range(1, 100)) < 0.0
+
+
+def test_bounce_family():
+    n1 = 7.5625
+    # p in the first bounce segment: n1 * p * p
+    assert easing.ease_out_bounce(0.2) == pytest.approx(n1 * 0.04)
+    # ease_in_bounce is the mirror of ease_out_bounce
+    assert easing.ease_in_bounce(0.3) == pytest.approx(
+        1.0 - easing.ease_out_bounce(0.7)
+    )
+    assert easing.ease_in_out_bounce(0.25) == pytest.approx(
+        (1.0 - easing.ease_out_bounce(0.5)) / 2.0
+    )
+    assert easing.ease_in_out_bounce(0.75) == pytest.approx(
+        (1.0 + easing.ease_out_bounce(0.5)) / 2.0
+    )
+
+
+def test_in_out_symmetry():
+    """ease_in_out variants satisfy f(0.5) == 0.5 and f(p) == 1 - f(1 - p)."""
+    for name in ALL_NAMES:
+        if not name.startswith("ease_in_out_"):
+            continue
+        func = EASINGS[name]
+        assert func(0.5) == pytest.approx(0.5, abs=1e-9)
+        for i in range(1, 20):
+            p = i / 20.0
+            assert func(p) == pytest.approx(1.0 - func(1.0 - p), abs=1e-9)
+
+
+def test_in_out_mirror_of_in():
+    """ease_in_X(p) == 1 - ease_out_X(1 - p) for the polynomial families."""
+    pairs = [
+        ("quad", easing.ease_in_quad, easing.ease_out_quad),
+        ("cubic", easing.ease_in_cubic, easing.ease_out_cubic),
+        ("quart", easing.ease_in_quart, easing.ease_out_quart),
+        ("quint", easing.ease_in_quint, easing.ease_out_quint),
+        ("sine", easing.ease_in_sine, easing.ease_out_sine),
+        ("expo", easing.ease_in_expo, easing.ease_out_expo),
+        ("circ", easing.ease_in_circ, easing.ease_out_circ),
+        ("back", easing.ease_in_back, easing.ease_out_back),
+        ("elastic", easing.ease_in_elastic, easing.ease_out_elastic),
+        ("bounce", easing.ease_in_bounce, easing.ease_out_bounce),
+    ]
+    for _name, ease_in, ease_out in pairs:
+        for i in range(21):
+            p = i / 20.0
+            assert ease_in(p) == pytest.approx(1.0 - ease_out(1.0 - p), abs=1e-9)
+
+
+# ------------------------------------------------------------- get_easing
+
+
+def test_get_easing_by_name():
+    assert get_easing("linear") is easing.linear
+    assert get_easing("ease_out_bounce") is easing.ease_out_bounce
+
+
+def test_get_easing_passthrough_callable():
+    def custom(p):
+        return p * 0.5
+
+    assert get_easing(custom) is custom
+
+
+def test_get_easing_unknown_name():
+    with pytest.raises(ValueError):
+        get_easing("ease_sideways")
+
+
+def test_get_easing_bad_type():
+    with pytest.raises(TypeError):
+        get_easing(42)
+    with pytest.raises(TypeError):
+        get_easing(None)
+
+
+# ------------------------------------------------- frozen regression samples
+
+EASING_SAMPLES = {
+    "ease_in_back": [-0.01431422, -0.04645056, -0.08019954, -0.09935168, -0.0876975, -0.02902752, 0.09286774, 0.29419776, 0.59117202],
