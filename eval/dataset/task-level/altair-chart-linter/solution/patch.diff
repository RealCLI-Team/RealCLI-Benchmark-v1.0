+def lint(chart: Any) -> list[LintIssue]:
+    """Statically check a chart (or spec dictionary) for common problems.
+
+    The chart is *not* rendered and :meth:`to_dict` is never called, so
+    problems that would otherwise raise during serialization or at
+    schema-validation time are surfaced as :class:`LintIssue` objects
+    instead.  All checks are local and deterministic: the data itself is
+    never inspected.
+
+    Parameters
+    ----------
+    chart :
+        Any top-level Altair chart (:class:`Chart`, :class:`LayerChart`,
+        :class:`ConcatChart`, :class:`HConcatChart`, :class:`VConcatChart`,
+        :class:`FacetChart` or :class:`RepeatChart`) or a plain dictionary
+        holding an Altair / Vega-Lite specification.
+
+    Returns
+    -------
+    list of LintIssue
+        The findings, sorted by ``(path, code)``.  An empty list means no
+        rule fired.
+
+    Raises
+    ------
+    TypeError
+        If ``chart`` is neither a chart object nor a dictionary.
+
+    Examples
+    --------
+    A well-formed chart lints clean:
+
+    >>> import altair as alt
+    >>> chart = alt.Chart().mark_point().encode(x="a:Q", y="sum(b):Q")
+    >>> alt.lint(chart)
+    []
+
+    Unknown encoding channel (rule E001):
+
+    >>> spec = {
+    ...     "mark": "point",
+    ...     "encoding": {"colour": {"field": "c", "type": "nominal"}},
+    ... }
+    >>> [i.code for i in alt.lint(spec)]
+    ['E001']
+
+    Unknown mark type (rule E002):
+
+    >>> spec = {
+    ...     "mark": "wibble",
+    ...     "encoding": {"x": {"field": "a", "type": "quantitative"}},
+    ... }
+    >>> [i.code for i in alt.lint(spec)]
+    ['E002']
+
+    Unknown aggregate operation (rule E003):
+
+    >>> spec = {
+    ...     "mark": "bar",
+    ...     "encoding": {
+    ...         "y": {
+    ...             "field": "b",
+    ...             "type": "quantitative",
+    ...             "aggregate": "wibble",
+    ...         }
+    ...     },
+    ... }
+    >>> [i.code for i in alt.lint(spec)]
+    ['E003']
+
+    Duplicate parameter names across the whole tree (rule E012):
+
+    >>> spec = {
+    ...     "params": [{"name": "brush"}],
+    ...     "layer": [
+    ...         {
+    ...             "mark": "point",
+    ...             "params": [{"name": "brush"}],
+    ...             "encoding": {
+    ...                 "x": {"field": "a", "type": "quantitative"}
+    ...             },
+    ...         }
+    ...     ],
+    ... }
+    >>> [(i.code, i.path) for i in alt.lint(spec)]
+    [('E012', 'layer[0].params[0]')]
+
+    Warnings do not raise -- they are reported alongside errors:
+
+    >>> spec = {"mark": "area", "encoding": {"x2": "b:Q"}}
+    >>> [i.code for i in alt.lint(spec) if i.code.startswith("W")]
+    ['W001']
+    """
+    if isinstance(chart, SchemaBase):
+        tree = _lint_materialize(chart)
+    elif isinstance(chart, Mapping):
+        tree = _lint_materialize(chart)
+    else:
+        msg = (
+            "lint() expects an Altair chart object or a specification "
+            f"dictionary, got {type(chart).__name__!r}"
+        )
+        raise TypeError(msg)
+
+    issues: list[LintIssue] = []
+    _lint_walk(tree, "", issues, set())
+    issues.sort(key=lambda issue: (issue.path, issue.code))
+    return issues
+
+
+def _lint_errors_only(chart_or_spec: Any) -> list[LintIssue]:
+    """Return the subset of :func:`lint` findings whose severity is error."""
+    return [
+        issue
+        for issue in lint(chart_or_spec)
+        if issue.severity == _LINT_SEVERITY_ERROR
+    ]
+
+
+def _lint_warnings_only(chart_or_spec: Any) -> list[LintIssue]:
+    """Return the subset of :func:`lint` findings whose severity is warning."""
+    return [
+        issue
+        for issue in lint(chart_or_spec)
+        if issue.severity == _LINT_SEVERITY_WARNING
+    ]
+
+
+def _lint_group_by_code(
+    issues: Sequence[LintIssue],
+) -> dict[str, list[LintIssue]]:
+    """Group :class:`LintIssue` objects by their rule code.
+
+    Useful for tests and for building higher-level tools that want to
+    report findings rule-by-rule; not used by :func:`lint` itself.
+    """
+    grouped: dict[str, list[LintIssue]] = {}
+    for issue in issues:
+        grouped.setdefault(issue.code, []).append(issue)
+    return grouped
+
+
+def _lint_group_by_path(
+    issues: Sequence[LintIssue],
+) -> dict[str, list[LintIssue]]:
+    """Group :class:`LintIssue` objects by their ``path`` attribute.
+
+    Companion to :func:`_lint_group_by_code`.  The insertion order of the
+    outer dictionary follows the first appearance of each path in
+    ``issues``.
+    """
+    grouped: dict[str, list[LintIssue]] = {}
+    for issue in issues:
+        grouped.setdefault(issue.path, []).append(issue)
+    return grouped
+
+
+def _lint_format(issues: Sequence[LintIssue]) -> str:
+    """Format a list of :class:`LintIssue` objects as a human-readable block.
+
+    The result is a newline-joined sequence of ``str(issue)`` lines.  An
+    empty issue list yields the empty string so calling code can safely
+    ``print(_lint_format(chart.lint()))`` on a clean chart.
+    """
+    return "\n".join(str(issue) for issue in issues)
+
+
+def _lint_summary(issues: Sequence[LintIssue]) -> str:
+    """Return a one-line summary counting issues by severity.
+
+    Useful for tooling and for the string form of :class:`LintError`.
+    A clean issue list yields ``"altair.lint: 0 issues"``.
+    """
+    errors = sum(1 for i in issues if i.severity == _LINT_SEVERITY_ERROR)
+    warnings = sum(1 for i in issues if i.severity == _LINT_SEVERITY_WARNING)
+    total = errors + warnings
+    if total == 0:
+        return "altair.lint: 0 issues"
+    parts = [f"{errors} error{'s' if errors != 1 else ''}"]
+    parts.append(f"{warnings} warning{'s' if warnings != 1 else ''}")
+    return f"altair.lint: {total} issue{'s' if total != 1 else ''} "\
+           f"({', '.join(parts)})"
+
