+def _lint_resolve_channel(
+    defn: dict[str, Any],
+) -> tuple[dict[str, Any], str | None]:
+    """Merge a channel definition's shorthand with its explicit properties.
+
+    Returns ``(resolved, error)`` where ``resolved`` is a dictionary of the
+    effective channel properties and ``error`` is a parse-error message (or
+    ``None`` when the shorthand -- if any -- parsed cleanly).
+
+    Explicit properties take precedence over values extracted from the
+    shorthand, mirroring how Altair itself serializes a channel.  A
+    definition that carries both ``shorthand`` and ``field`` is invalid,
+    matching the ``ValueError`` that ``FieldChannelMixin.to_dict`` raises.
+    """
+    resolved = {k: v for k, v in defn.items() if k != "shorthand"}
+    shorthand = defn.get("shorthand")
+    if shorthand is None:
+        return resolved, None
+    if "field" in defn:
+        return (
+            resolved,
+            (
+                f"channel specifies both shorthand={shorthand!r} and "
+                f"field={defn['field']!r}"
+            ),
+        )
+    if not isinstance(shorthand, str):
+        # Non-string shorthands are treated as a raw field reference by
+        # Altair; there is nothing to parse.
+        resolved.setdefault("field", shorthand)
+        return resolved, None
+    try:
+        parsed = utils.parse_shorthand(shorthand, errors="collect")
+    except (ValueError, TypeError) as exc:  # pragma: no cover - safety net
+        return resolved, f"cannot parse shorthand {shorthand!r}: {exc}"
+    parse_error = parsed.pop("__shorthand_error__", None)
+    if parse_error is not None:
+        return resolved, parse_error
+    merged = dict(parsed)
+    merged.update(resolved)
+    return merged, None
+
+
+def _lint_check_channel(
+    name: str,
+    defn: Any,
+    path: str,
+    issues: list[LintIssue],
+) -> None:
+    """Run every per-channel rule against one channel definition."""
+    # List-valued channels (tooltip, detail, order, ...) hold one
+    # definition per entry; check each entry individually.
+    if isinstance(defn, list):
+        for index, item in enumerate(defn):
+            _lint_check_channel(name, item, f"{path}[{index}]", issues)
+        return
+    # Bare strings (common in hand-written spec dicts) are shorthands.
+    if isinstance(defn, str):
+        defn = {"shorthand": defn}
+    if not isinstance(defn, dict):
+        # Numbers/booleans/None have no field semantics to inspect.
+        return
+    # A shorthand given as a list expands to one definition per entry.
+    shorthand = defn.get("shorthand")
+    if isinstance(shorthand, (list, tuple)):
+        rest = {k: v for k, v in defn.items() if k != "shorthand"}
+        for index, item in enumerate(shorthand):
+            _lint_check_channel(
+                name,
+                {**rest, "shorthand": item},
+                f"{path}[{index}]",
+                issues,
+            )
+        return
+
+    resolved, error = _lint_resolve_channel(defn)
+    if error is not None:
+        issues.append(
+            LintIssue("E009", _LINT_SEVERITY_ERROR, path, error)
+        )
+        return
+
+    # Conditional-only definitions (no field/value/datum of their own) are
+    # not inspected; the schema handles the ``condition`` branches.
+    if "condition" in resolved and not any(
+        key in resolved for key in ("field", "value", "datum")
+    ):
+        return
+
+    # Value/datum channels carry no field reference; the field-oriented
+    # rules below do not apply.
+    has_field_ref = "field" in resolved
+    if any(key in resolved for key in _LINT_NON_FIELD_KEYS) and not has_field_ref:
+        return
+
+    aggregate = resolved.get("aggregate")
+    time_unit = resolved.get("timeUnit")
+    field_type = resolved.get("type")
+    scale = resolved.get("scale")
+    stack = resolved.get("stack")
+    sort = resolved.get("sort")
+    bin_ = resolved.get("bin")
+
+    # E003: unknown aggregate operation.
+    if isinstance(aggregate, str) and aggregate not in _LINT_AGGREGATE_OPS:
+        issues.append(
+            LintIssue(
+                "E003",
+                _LINT_SEVERITY_ERROR,
+                path,
+                f"{aggregate!r} is not a valid Vega-Lite aggregate operation",
+            )
+        )
+
+    # E004: unknown time unit.
+    if isinstance(time_unit, str) and time_unit not in _LINT_TIME_UNITS:
+        issues.append(
+            LintIssue(
+                "E004",
+                _LINT_SEVERITY_ERROR,
+                path,
+                f"{time_unit!r} is not a valid Vega-Lite timeUnit",
+            )
+        )
+
+    # E005: unknown measurement type.
+    if isinstance(field_type, str) and field_type not in _LINT_FIELD_TYPES:
+        issues.append(
+            LintIssue(
+                "E005",
+                _LINT_SEVERITY_ERROR,
+                path,
+                (
+                    f"{field_type!r} is not a valid encoding data type "
+                    "(expected one of 'quantitative', 'ordinal', "
+                    "'temporal', 'nominal', 'geojson')"
+                ),
+            )
+        )
+
+    # E006/E007: scale type validity and scale/field-type compatibility.
+    if isinstance(scale, dict):
+        scale_type = scale.get("type")
+        if isinstance(scale_type, str):
+            if scale_type not in _LINT_SCALE_TYPES:
+                issues.append(
+                    LintIssue(
+                        "E006",
+                        _LINT_SEVERITY_ERROR,
+                        path,
+                        f"{scale_type!r} is not a valid Vega-Lite scale type",
+                    )
+                )
+            elif (
+                isinstance(field_type, str) and field_type in _LINT_FIELD_TYPES
+            ):
+                if (
+                    scale_type in _LINT_CONTINUOUS_ONLY_SCALES
+                    and field_type in _LINT_NON_CONTINUOUS_TYPES
+                ):
+                    issues.append(
+                        LintIssue(
+                            "E007",
+                            _LINT_SEVERITY_ERROR,
+                            path,
+                            (
+                                f"scale type {scale_type!r} cannot be "
+                                f"used with a {field_type!r} field"
+                            ),
+                        )
+                    )
+                elif (
+                    scale_type in _LINT_TEMPORAL_ONLY_SCALES
+                    and field_type != "temporal"
+                ):
+                    issues.append(
+                        LintIssue(
+                            "E007",
+                            _LINT_SEVERITY_ERROR,
+                            path,
+                            (
+                                f"scale type {scale_type!r} requires a "
+                                f"'temporal' field, not {field_type!r}"
+                            ),
+                        )
+                    )
+                elif (
+                    scale_type == "sequential"
+                    and field_type in _LINT_NON_SEQUENTIAL_TYPES
+                ):
+                    issues.append(
+                        LintIssue(
+                            "E007",
+                            _LINT_SEVERITY_ERROR,
+                            path,
+                            (
+                                "scale type 'sequential' cannot be used "
+                                f"with a {field_type!r} field"
+                            ),
+                        )
+                    )
+
+    # E008: unknown stack value.
+    if (
+        stack is not None
+        and not isinstance(stack, (dict, list))
+        and stack not in _LINT_STACK_VALUES
+    ):
+        issues.append(
+            LintIssue(
+                "E008",
+                _LINT_SEVERITY_ERROR,
+                path,
+                (
+                    f"{stack!r} is not a valid stack value "
+                    "(expected True, False, 'zero', 'center' or "
+                    "'normalize')"
+                ),
+            )
+        )
+
+    # E013: invalid string bin value.
+    if isinstance(bin_, str) and bin_ != "binned":
+        issues.append(
+            LintIssue(
+                "E013",
+                _LINT_SEVERITY_ERROR,
+                path,
+                (
+                    f"{bin_!r} is not a valid bin value "
+                    "(expected True, False, 'binned' or a bin parameter "
+                    "object)"
+                ),
+            )
+        )
+
+    # E010: aggregate combined with bin.
+    if aggregate is not None and (bin_ is True or isinstance(bin_, dict)):
+        issues.append(
+            LintIssue(
+                "E010",
+                _LINT_SEVERITY_ERROR,
+                path,
+                (
+                    f"channel combines aggregate={aggregate!r} with bin; "
+                    "a field cannot be both aggregated and binned"
+                ),
+            )
+        )
+
+    # E011: unknown sort directive.
+    if isinstance(sort, str) and sort not in _LINT_SORT_STRINGS:
+        issues.append(
+            LintIssue(
+                "E011",
+                _LINT_SEVERITY_ERROR,
+                path,
+                (
+                    f"{sort!r} is not a valid sort directive "
+                    "(expected 'ascending', 'descending', or an encoding "
+                    "channel name with an optional leading '-')"
+                ),
+            )
+        )
+
+    # E014: channel without any data reference.
+    if (
+        not has_field_ref
+        and aggregate != "count"
+        and not any(key in resolved for key in _LINT_NON_FIELD_KEYS)
+    ):
+        issues.append(
+            LintIssue(
+                "E014",
+                _LINT_SEVERITY_ERROR,
+                path,
+                "channel definition has neither 'field', 'value' nor 'datum'",
+            )
+        )
+
+    # W003: field/aggregate channel without an explicit measurement type.
+    if (has_field_ref or aggregate is not None) and "type" not in resolved:
+        issues.append(
+            LintIssue(
+                "W003",
+                _LINT_SEVERITY_WARNING,
+                path,
+                (
+                    "channel has no explicit 'type'; the measurement "
+                    "type will have to be inferred from the data"
+                ),
+            )
+        )
+
+
+def _lint_check_encoding(
+    encoding: Any,
+    chart_path: str,
+    issues: list[LintIssue],
+) -> None:
+    """Run the encoding-block rules (unknown channels, W001 pairs)."""
+    if not isinstance(encoding, dict):
+        return
+    base = _lint_join(chart_path, "encoding")
+    for name, defn in encoding.items():
+        path = _lint_join(base, name)
+        if name not in _LINT_CHANNEL_NAMES:
+            issues.append(
+                LintIssue(
+                    "E001",
+                    _LINT_SEVERITY_ERROR,
+                    path,
+                    f"{name!r} is not a known Vega-Lite encoding channel",
+                )
+            )
+            continue
+        _lint_check_channel(name, defn, path, issues)
+    for secondary, required in _LINT_SECONDARY_CHANNELS.items():
+        if secondary in encoding and required not in encoding:
+            issues.append(
+                LintIssue(
+                    "W001",
+                    _LINT_SEVERITY_WARNING,
+                    _lint_join(base, secondary),
+                    (
+                        f"encoding channel {secondary!r} is used without "
+                        f"its base channel {required!r}"
+                    ),
+                )
+            )
+
+
+def _lint_check_facet(
+    facet: Any,
+    chart_path: str,
+    issues: list[LintIssue],
+) -> None:
+    """Check a ``FacetChart``'s facet mapping (row/column/facet)."""
+    if isinstance(facet, str):
+        facet = {"shorthand": facet}
+    if not isinstance(facet, dict):
+        return
+    if any(key in facet for key in ("row", "column", "facet")):
+        for key in ("row", "column", "facet"):
+            if key in facet:
+                _lint_check_channel(
+                    key,
+                    facet[key],
+                    _lint_join(_lint_join(chart_path, "facet"), key),
+                    issues,
+                )
+    else:
+        _lint_check_channel(
+            "facet",
+            facet,
+            _lint_join(chart_path, "facet"),
+            issues,
+        )
+
+
+def _lint_mark_type(mark: Any) -> Any:
+    """Extract the mark type string from a mark property (dict or scalar)."""
+    if isinstance(mark, dict):
+        return mark.get("type")
+    return mark
+
+
+def _lint_walk(
+    node: Any,
+    path: str,
+    issues: list[LintIssue],
+    seen_params: set[str],
+    has_shared_encoding: bool = False,
+) -> None:
+    """Recursively walk a (materialized) spec tree, applying all rules."""
+    if not isinstance(node, dict):
+        return
+
+    # E012: parameter names must be unique across the entire chart tree.
+    params = node.get("params")
+    if isinstance(params, list):
+        for index, param in enumerate(params):
+            if isinstance(param, dict):
+                name = param.get("name")
+                if isinstance(name, str) and name:
+                    if name in seen_params:
+                        issues.append(
+                            LintIssue(
+                                "E012",
+                                _LINT_SEVERITY_ERROR,
+                                _lint_join(path, f"params[{index}]"),
+                                (
+                                    f"parameter name {name!r} is defined "
+                                    "more than once in this chart"
+                                ),
+                            )
+                        )
+                    else:
+                        seen_params.add(name)
+
+    # Encoding blocks may appear on unit charts *and* (as shared
+    # encodings) on layer charts.
+    own_encoding = node.get("encoding")
+    if "encoding" in node:
+        _lint_check_encoding(own_encoding, path, issues)
+    # A non-empty encoding on a wrapper is inherited by its children, so
+    # those children do not count as "unencoded".
+    shared_below = has_shared_encoding or (
+        isinstance(own_encoding, dict) and bool(own_encoding)
+    )
+
+    # Facet mappings carry channel definitions too.
+    if "facet" in node:
+        _lint_check_facet(node["facet"], path, issues)
+
+    composite = (
+        any(key in node for key in _LINT_COMPOSITE_LIST_KEYS) or "spec" in node
+    )
+
+    if not composite:
+        # Unit chart: the mark must exist and be a known mark type.
+        mark = node.get("mark")
+        mark_type = _lint_mark_type(mark)
+        mark_path = _lint_join(path, "mark")
+        if mark_type is None:
+            issues.append(
+                LintIssue(
+                    "E002",
+                    _LINT_SEVERITY_ERROR,
+                    mark_path,
+                    "unit chart has no mark",
+                )
+            )
+        elif isinstance(mark_type, str) and mark_type not in _LINT_MARK_TYPES:
+            issues.append(
+                LintIssue(
+                    "E002",
+                    _LINT_SEVERITY_ERROR,
+                    mark_path,
+                    f"{mark_type!r} is not a known Vega-Lite mark type",
+                )
+            )
+        # W002: a unit chart with an empty encoding renders nothing
+        # meaningful -- except ``geoshape`` (which draws the data's
+        # geometry) and children that inherit a shared encoding from
+        # their parent.
+        encoding = node.get("encoding")
+        if (
+            mark_type != "geoshape"
+            and not has_shared_encoding
+            and (not isinstance(encoding, dict) or not encoding)
+        ):
+            issues.append(
+                LintIssue(
+                    "W002",
+                    _LINT_SEVERITY_WARNING,
+                    path,
+                    (
+                        "unit chart has an empty encoding; nothing will "
+                        "be drawn from the data"
+                    ),
+                )
+            )
+
+    # Recurse into child views.
+    for key in _LINT_COMPOSITE_LIST_KEYS:
+        children = node.get(key)
+        if isinstance(children, list):
+            for index, child in enumerate(children):
+                _lint_walk(
+                    child,
+                    _lint_join(path, f"{key}[{index}]"),
+                    issues,
+                    seen_params,
+                    shared_below,
+                )
+    spec = node.get("spec")
+    if isinstance(spec, dict):
+        _lint_walk(
+            spec, _lint_join(path, "spec"), issues, seen_params, shared_below
+        )
+
