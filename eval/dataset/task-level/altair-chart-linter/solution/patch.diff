+class TestStrictLintToDict:
+    def test_default_preserves_behavior_on_clean_chart(self):
+        chart = alt.Chart(DATA).mark_point().encode(x="a:Q")
+        assert chart.to_dict()["mark"] == {"type": "point"}
+        assert chart.to_dict(strict_lint=True)["mark"] == {"type": "point"}
+
+    def test_raises_on_e_level(self):
+        chart = alt.Chart(DATA).mark_bar().encode(
+            y=alt.Y("b:Q", aggregate="wibble")
+        )
+        with pytest.raises(LintError) as info:
+            chart.to_dict(strict_lint=True)
+        assert [i.code for i in info.value.issues] == ["E003"]
+        assert isinstance(info.value, ValueError)
+
+    def test_w_level_does_not_raise(self):
+        chart = alt.Chart(DATA).mark_point()  # W002
+        assert chart.to_dict(strict_lint=True)["mark"] == {"type": "point"}
+
+    def test_nested_layer_reports_from_inside(self):
+        chart = alt.layer(
+            alt.Chart(DATA).mark_bar().encode(
+                y=alt.Y("b:Q", aggregate="wibble")
+            )
+        )
+        with pytest.raises(LintError) as info:
+            chart.to_dict(strict_lint=True)
+        assert [(i.code, i.path) for i in info.value.issues] == [
+            ("E003", "layer[0].encoding.y")
+        ]
+
+    def test_multiple_errors_all_reported(self):
+        chart = alt.Chart(DATA).encode(x=alt.X("a:Q", aggregate="wibble"))
+        with pytest.raises(LintError) as info:
+            chart.to_dict(strict_lint=True)
+        codes_seen = {i.code for i in info.value.issues}
+        assert "E002" in codes_seen
+        assert "E003" in codes_seen
