+def _lint_materialize(obj: Any) -> Any:
+    """Recursively convert a chart/schema object into plain Python data.
+
+    ``SchemaBase`` instances are turned into dictionaries built from their
+    stored keywords (``Undefined`` entries are dropped), mappings and
+    sequences are copied recursively, and everything else is passed
+    through unchanged.  The input is never mutated.
+
+    Unlike :meth:`SchemaBase.to_dict`, this function performs *no*
+    validation and *no* shorthand parsing, so malformed constructs survive
+    materialization and can be reported by the lint rules instead of
+    raising.
+    """
+    if isinstance(obj, SchemaBase):
+        return {
+            key: _lint_materialize(value)
+            for key, value in obj._kwds.items()
+            if value is not Undefined
+        }
+    if isinstance(obj, Mapping):
+        return {
+            key: _lint_materialize(value)
+            for key, value in obj.items()
+            if value is not Undefined
+        }
+    if isinstance(obj, (list, tuple)):
+        return [_lint_materialize(item) for item in obj]
+    return obj
+
