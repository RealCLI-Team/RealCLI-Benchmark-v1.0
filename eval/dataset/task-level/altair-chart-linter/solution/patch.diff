+class LintIssue:
+    """A single finding produced by :func:`altair.lint`.
+
+    Attributes
+    ----------
+    code : str
+        Stable rule identifier, e.g. ``"E003"``.  ``E``-prefixed codes are
+        errors, ``W``-prefixed codes are warnings.
+    severity : str
+        Either ``"error"`` or ``"warning"``.
+    path : str
+        Location of the offending node in the (possibly nested) chart,
+        using dotted keys and ``[i]`` indices; the root chart itself is
+        ``""``.  Examples: ``"encoding.x"``, ``"layer[1].encoding.y"``,
+        ``"spec.facet.row"``, ``"params[0]"``.
+    message : str
+        Human-readable description of the problem.  For rules that are
+        triggered by a concrete value (an unknown mark, aggregate, sort,
+        scale type, ...) the offending value is included in the message
+        so callers can find the exact spot without having to re-derive it
+        from the path alone.
+
+    Notes
+    -----
+    :class:`LintIssue` objects are immutable value objects: they support
+    equality and hashing based on their four attributes.  This makes them
+    safe to use as dictionary keys and to compare against a frozen set of
+    expected findings in tests.
+    """
+
+    __slots__ = ("code", "severity", "path", "message")
+
+    def __init__(self, code: str, severity: str, path: str, message: str) -> None:
+        if severity not in (_LINT_SEVERITY_ERROR, _LINT_SEVERITY_WARNING):
+            msg = (
+                f"LintIssue: severity must be 'error' or 'warning', "
+                f"got {severity!r}"
+            )
+            raise ValueError(msg)
+        self.code = code
+        self.severity = severity
+        self.path = path
+        self.message = message
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, LintIssue):
+            return NotImplemented
+        return (
+            self.code,
+            self.severity,
+            self.path,
+            self.message,
+        ) == (other.code, other.severity, other.path, other.message)
+
+    def __hash__(self) -> int:
+        return hash((self.code, self.severity, self.path, self.message))
+
+    def __repr__(self) -> str:
+        return (
+            f"LintIssue(code={self.code!r}, severity={self.severity!r}, "
+            f"path={self.path!r}, message={self.message!r})"
+        )
+
+    def __str__(self) -> str:
+        location = self.path if self.path else "<root>"
+        return f"{self.code} [{self.severity}] {location}: {self.message}"
+
+
+class LintError(ValueError):
+    """Raised by ``to_dict(strict_lint=True)`` when E-level issues are found.
+
+    Subclasses :class:`ValueError` so callers who already have a broad
+    ``except ValueError`` clause (e.g. around ``to_dict`` /
+    ``to_json`` / ``save``) automatically catch it.
+
+    Attributes
+    ----------
+    issues : list of LintIssue
+        The ``E``-level findings that caused this error.  ``W``-level
+        findings never trigger :class:`LintError`.
+    """
+
+    __slots__ = ("issues",)
+
+    def __init__(self, issues: list[LintIssue]) -> None:
+        self.issues = list(issues)
+        header = (
+            f"altair.lint reported {len(self.issues)} error"
+            f"{'s' if len(self.issues) != 1 else ''}:"
+        )
+        body = "\n".join(f"  {issue}" for issue in self.issues)
+        super().__init__(f"{header}\n{body}" if body else header)
+
+    def codes(self) -> list[str]:
+        """Rule codes of the wrapped :class:`LintIssue` objects, in order.
+
+        A small convenience helper for callers who want to check whether
+        a specific code was triggered without having to iterate over the
+        full issue list themselves.
+        """
+        return [issue.code for issue in self.issues]
+
+    def paths(self) -> list[str]:
+        """Paths of the wrapped :class:`LintIssue` objects, in order."""
+        return [issue.path for issue in self.issues]
+
+    def has_code(self, code: str) -> bool:
+        """Return ``True`` if any wrapped issue has the given rule ``code``."""
+        return any(issue.code == code for issue in self.issues)
+
+    def summary(self) -> str:
+        """Return a compact one-line summary of the wrapped issues.
+
+        The first line of :func:`str` on the exception body is the same
+        format, but this method returns just the summary without the
+        per-issue detail lines.
+        """
+        n = len(self.issues)
+        return (
+            f"altair.lint reported {n} error{'s' if n != 1 else ''}"
+        )
+
+
+#: The public rule catalog.  Each entry maps a rule code to a
