+"""In-repo tests for the static chart-specification linter.
+
+These tests exercise the ``altair.lint`` / ``altair.LintIssue`` /
+``altair.LintError`` public surface plus its integration with
+``to_dict`` / ``to_json`` via the ``strict_lint`` keyword.  They are
+independent from the external ``tests/test_outputs.py`` grading suite
+and are meant to be run alongside the rest of the repository's test
+suite so contributors get local feedback while iterating on the
+linter.
+
+Every expectation is frozen inside this file: no value is derived
+from the state of the schema or of the linter's own internals, and
+no test looks at private attributes such as the ``_LINT_*`` set
+tables.
+"""
+
+from __future__ import annotations
+
+import warnings
+
+import pytest
+
+import altair as alt
+from altair import LintError, LintIssue, lint
+from altair.utils.core import SHORTHAND_ERROR_KEY, parse_shorthand
+
+
+DATA = alt.Data(values=[{"a": 1, "b": 2, "c": "x", "d": "2020-01-01"}])
+
+
+def codes(issues):
+    return [issue.code for issue in issues]
+
+
+def paths(issues):
+    return [issue.path for issue in issues]
+
+
+def by_code(issues, code):
+    return [issue for issue in issues if issue.code == code]
+
+
+# ---------------------------------------------------------------------------
+# LintIssue value-object contract
+# ---------------------------------------------------------------------------
+
+
+class TestLintIssue:
+    def test_attributes_frozen(self):
+        issue = LintIssue("E001", "error", "encoding.x", "boom")
+        assert issue.code == "E001"
+        assert issue.severity == "error"
+        assert issue.path == "encoding.x"
+        assert issue.message == "boom"
+
+    def test_invalid_severity_rejected(self):
+        with pytest.raises(ValueError, match="severity"):
+            LintIssue("E001", "fatal", "", "boom")
+
+    def test_equality_is_structural(self):
+        first = LintIssue("E001", "error", "encoding.x", "boom")
+        second = LintIssue("E001", "error", "encoding.x", "boom")
+        other = LintIssue("E002", "error", "encoding.x", "boom")
+        assert first == second
+        assert first != other
+        assert first != "not an issue"
+        assert hash(first) == hash(second)
+
+    def test_str_carries_code_severity_and_path(self):
+        issue = LintIssue("W001", "warning", "layer[0].encoding.x2", "boom")
+        text = str(issue)
+        assert "W001" in text
+        assert "warning" in text
+        assert "layer[0].encoding.x2" in text
+        assert "boom" in text
+
+    def test_str_root_path_has_placeholder(self):
+        issue = LintIssue("W002", "warning", "", "boom")
+        assert "<root>" in str(issue)
+
+    def test_repr_round_trips_attributes(self):
+        issue = LintIssue("E012", "error", "params[1]", "dup")
+        text = repr(issue)
+        assert "E012" in text
+        assert "params[1]" in text
+        assert "dup" in text
+
+
+# ---------------------------------------------------------------------------
+# Input handling & result contract
+# ---------------------------------------------------------------------------
+
+
+class TestInput:
+    def test_chart_object_accepted(self):
+        chart = alt.Chart().mark_point().encode(x="a:Q")
+        assert lint(chart) == []
+
+    def test_method_equivalent_to_function(self):
+        chart = alt.Chart().mark_point().encode(
+            y=alt.Y("b:Q", aggregate="wibble")
+        )
+        assert chart.lint() == lint(chart)
+
+    def test_method_available_on_all_chart_classes(self):
+        unit = alt.Chart(DATA).mark_point().encode(x="a:Q")
+        assert unit.lint() == []
+        assert alt.layer(unit).lint() == []
+        assert alt.concat(unit).lint() == []
+        assert alt.hconcat(unit).lint() == []
+        assert alt.vconcat(unit).lint() == []
+        assert unit.facet("c:N").lint() == []
+        assert unit.repeat(repeat=["a", "b"]).lint() == []
+
+    def test_dict_spec_accepted(self):
+        spec = {
+            "mark": "point",
+            "encoding": {"x": {"field": "a", "type": "quantitative"}},
+        }
+        assert lint(spec) == []
+
+    def test_bare_string_channel_in_dict_spec(self):
+        spec = {"mark": "point", "encoding": {"x": "a:Q"}}
+        assert lint(spec) == []
+
+    def test_input_is_not_mutated(self):
+        chart = alt.Chart().mark_point().encode(
+            y=alt.Y("b:Q", aggregate="wibble")
+        )
+        before = repr(chart)
+        lint(chart)
+        assert repr(chart) == before
+
+    @pytest.mark.parametrize("bad", ["nope", 42, None, ["mark"], 3.14])
+    def test_unsupported_input_raises_type_error(self, bad):
+        with pytest.raises(TypeError, match="lint"):
+            lint(bad)
+
+    def test_result_sorted_by_path_then_code(self):
+        chart = alt.Chart().mark_point().encode(
+            x2="b:Q",
+            y=alt.Y("c:Q", aggregate="wibble"),
+        )
+        issues = lint(chart)
+        keys = [(issue.path, issue.code) for issue in issues]
+        assert keys == sorted(keys)
+
+    def test_every_issue_has_contract_attributes(self):
+        chart = alt.Chart().mark_point().encode(
+            x2="b:Q",
+            y=alt.Y("c:Q", aggregate="wibble"),
+        )
+        for issue in lint(chart):
+            assert isinstance(issue.code, str) and issue.code
+            assert issue.severity in ("error", "warning")
+            assert isinstance(issue.path, str)
+            assert isinstance(issue.message, str) and issue.message
+
+    def test_repeatable_results(self):
+        chart = alt.Chart().mark_point().encode(
+            y=alt.Y("b:Q", aggregate="wibble")
+        )
+        first = lint(chart)
+        second = lint(chart)
+        assert first == second
+
