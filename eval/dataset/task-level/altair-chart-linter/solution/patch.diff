+class TestSideEffects:
+    def test_input_not_mutated(self):
+        chart = alt.Chart(DATA).mark_point().encode(
+            y=alt.Y("b:Q", aggregate="wibble")
+        )
+        before = repr(chart)
+        lint(chart)
+        assert repr(chart) == before
+
+    def test_still_serializable_after_lint(self):
+        chart = alt.Chart(DATA).mark_point().encode(x="a:Q")
+        lint(chart)
+        # This must not raise -- lint must never mutate the chart.
+        chart.to_dict()
+
+    def test_no_warning_emitted_by_lint(self):
+        chart = alt.Chart(DATA).mark_point()  # W002
+        with warnings.catch_warnings():
+            warnings.simplefilter("error")
+            # Even though W002 fires, ``lint()`` returns the issue list
+            # instead of calling ``warnings.warn`` -- otherwise these
+            # would become exceptions here.
+            issues = lint(chart)
+        assert any(i.code == "W002" for i in issues)
