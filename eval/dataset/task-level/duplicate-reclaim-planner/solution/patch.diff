index 00000000..1813b576
--- /dev/null
+++ b/core/reclaim/scanner.py
@@ -0,0 +1,170 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Turning a set of folders into a flat list of candidates.
+
+This wraps :class:`core.directories.Directories` (which already knows how to
+walk trees, honour per-folder *normal / reference / excluded* states, and skip
+dot-folders and excluded names) and produces
+:class:`~core.reclaim.candidate.Candidate` objects for the reclaim planner.
+
+The important pieces it adds on top of :class:`~core.directories.Directories`:
+
+* **reference folders**: a folder marked ``REFERENCE`` yields candidates with
+  ``protected=True``. The planner will never reclaim those -- they anchor their
+  group. This is how a user says "these are my masters, dedupe *against* them
+  but never touch them".
+* **extension / glob filters**: only-these or none-of-these name filters applied
+  as files are collected, so a photo dedupe run doesn't waste time hashing
+  videos.
+* **min / max size gates** at collection time, complementing the grouper's own
+  ``min_size``.
+"""
+
+import fnmatch
+from pathlib import Path
+
+from hscommon.jobprogress import job
+
+from core import fs
+from core.directories import Directories, DirectoryState, InvalidPathError
+from core.reclaim.candidate import Candidate
+from core.reclaim.errors import InvalidScanRootError
+
+__all__ = ["ScanSpec", "CandidateScanner"]
+
+
+class ScanSpec:
+    """Declarative description of *what* to scan.
+
+    :param roots: list of directories to scan (normal state).
+    :param reference_roots: directories whose files are protected.
+    :param excluded_roots: directories to skip entirely.
+    :param include_ext: if given, only files with these extensions
+        (lower-case, no dot) are kept.
+    :param exclude_ext: files with these extensions are dropped.
+    :param include_globs / exclude_globs: fnmatch patterns on the file *name*.
+    :param min_size / max_size: byte gates (``max_size=0`` means no upper bound).
+    """
+
+    __slots__ = (
+        "roots",
+        "reference_roots",
+        "excluded_roots",
+        "include_ext",
+        "exclude_ext",
+        "include_globs",
+        "exclude_globs",
+        "min_size",
+        "max_size",
+    )
+
+    def __init__(
+        self,
+        roots,
+        reference_roots=None,
+        excluded_roots=None,
+        include_ext=None,
+        exclude_ext=None,
+        include_globs=None,
+        exclude_globs=None,
+        min_size=0,
+        max_size=0,
+    ):
+        self.roots = [Path(p) for p in roots]
+        self.reference_roots = [Path(p) for p in (reference_roots or [])]
+        self.excluded_roots = [Path(p) for p in (excluded_roots or [])]
+        self.include_ext = {e.lower().lstrip(".") for e in (include_ext or [])}
+        self.exclude_ext = {e.lower().lstrip(".") for e in (exclude_ext or [])}
+        self.include_globs = list(include_globs or [])
+        self.exclude_globs = list(exclude_globs or [])
+        self.min_size = min_size
+        self.max_size = max_size
+
+    @classmethod
+    def from_dict(cls, data):
+        """Build a :class:`ScanSpec` from a plain dict (e.g. parsed config)."""
+        return cls(
+            roots=data.get("roots", data.get("paths", [])),
+            reference_roots=data.get("reference_roots", data.get("references", [])),
+            excluded_roots=data.get("excluded_roots", data.get("excludes", [])),
+            include_ext=data.get("include_ext"),
+            exclude_ext=data.get("exclude_ext"),
+            include_globs=data.get("include_globs"),
+            exclude_globs=data.get("exclude_globs"),
+            min_size=data.get("min_size", 0),
+            max_size=data.get("max_size", 0),
+        )
+
+    def _name_allowed(self, name):
+        ext = Path(name).suffix.lower().lstrip(".")
+        if self.include_ext and ext not in self.include_ext:
+            return False
+        if self.exclude_ext and ext in self.exclude_ext:
+            return False
+        if self.include_globs and not any(fnmatch.fnmatch(name, g) for g in self.include_globs):
+            return False
+        if self.exclude_globs and any(fnmatch.fnmatch(name, g) for g in self.exclude_globs):
+            return False
+        return True
+
+    def _size_allowed(self, size):
+        if size < self.min_size:
+            return False
+        if self.max_size and size > self.max_size:
+            return False
+        return True
+
+
+class CandidateScanner:
+    """Collects candidates for a :class:`ScanSpec`."""
+
+    def __init__(self, spec):
+        self.spec = spec
+
+    def _build_directories(self):
+        dirs = Directories()
+        for root in self.spec.roots:
+            if not root.exists() or not root.is_dir():
+                raise InvalidScanRootError(f"scan root does not exist or is not a directory: {root}")
+            try:
+                dirs.add_path(root)
+            except InvalidPathError:
+                raise InvalidScanRootError(f"invalid scan root: {root}")
+        # Reference roots must be added too (a root not in the tree is ignored by
+        # Directories) and then marked REFERENCE.
+        for ref in self.spec.reference_roots:
+            if not ref.exists() or not ref.is_dir():
+                raise InvalidScanRootError(f"reference root does not exist: {ref}")
+            if ref not in dirs:
+                try:
+                    dirs.add_path(ref)
+                except InvalidPathError:
+                    raise InvalidScanRootError(f"invalid reference root: {ref}")
+            dirs.set_state(ref, DirectoryState.REFERENCE)
+        for exc in self.spec.excluded_roots:
+            # Excluding a path that isn't under a root is harmless; set the state
+            # regardless so a nested excluded folder is honoured.
+            dirs.set_state(Path(exc), DirectoryState.EXCLUDED)
+        return dirs
+
+    def scan(self, j=job.nulljob):
+        """Return the list of :class:`Candidate` matching the spec.
+
+        Reference-folder files come back with ``protected=True``.
+        """
+        dirs = self._build_directories()
+        candidates = []
+        for file in dirs.get_files(fileclasses=[fs.File], j=j):
+            name = file.path.name
+            if not self.spec._name_allowed(name):
+                continue
+            if not self.spec._size_allowed(file.size):
+                continue
+            candidates.append(Candidate(file, protected=getattr(file, "is_ref", False)))
+        # Deterministic order regardless of directory iteration order.
+        candidates.sort(key=lambda c: str(c.path))
+        return candidates
