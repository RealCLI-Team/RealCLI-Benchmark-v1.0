new file mode 100644
index 00000000..ac7c583f
--- /dev/null
+++ b/core/reclaim/session.py
@@ -0,0 +1,135 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""A one-stop session tying scan -> group -> plan -> execute together.
+
+Most callers don't want to wire the five stages by hand; they want to say
+"dedupe these folders, keep the oldest, and tell me how much I'd save", preview
+it, and then apply it. :class:`ReclaimSession` is that facade. It keeps the
+stages explicit underneath (so power users can still reach in) but offers a
+smooth default path:
+
+    session = ReclaimSession(spec, strategy="oldest", action="delete")
+    result = session.analyze()          # pure: scan + group + plan
+    print(result.plan.summary())
+    report = session.apply()            # mutates, honouring dry_run
+
+The session caches the analysis so ``apply`` uses exactly what was previewed --
+you never plan against one snapshot and act against another by accident.
+"""
+
+from hscommon.jobprogress import job
+
+from core.reclaim.errors import ReclaimConfigError
+from core.reclaim.executor import ReclaimExecutor
+from core.reclaim.grouper import group_identical
+from core.reclaim import identity as identity_mod
+from core.reclaim.plan import DELETE, ReclaimPlanner
+from core.reclaim.scanner import CandidateScanner, ScanSpec
+
+__all__ = ["AnalysisResult", "ReclaimSession"]
+
+
+class AnalysisResult:
+    """Everything the pure phase produced, bundled for inspection."""
+
+    __slots__ = ("candidates", "grouping", "plan")
+
+    def __init__(self, candidates, grouping, plan):
+        self.candidates = candidates
+        self.grouping = grouping
+        self.plan = plan
+
+    @property
+    def scanned_count(self):
+        return len(self.candidates)
+
+    @property
+    def group_count(self):
+        return len(self.grouping.groups)
+
+    @property
+    def duplicate_count(self):
+        return self.grouping.duplicate_count
+
+    @property
+    def reclaimable_bytes(self):
+        # The plan is the authority: it accounts for protected files that keep a
+        # group from being fully collapsed, which the raw grouping does not.
+        return self.plan.reclaimable_bytes
+
+    def summary(self):
+        return {
+            "scanned": self.scanned_count,
+            "groups": self.group_count,
+            "duplicates": self.duplicate_count,
+            "plan": self.plan.summary(),
+        }
+
+
+class ReclaimSession:
+    """High-level orchestration of a reclaim run."""
+
+    def __init__(
+        self,
+        spec,
+        strategy="oldest",
+        action=DELETE,
+        min_size=None,
+        strength=identity_mod.FULL,
+        big_file_size=identity_mod.DEFAULT_BIG_FILE_SIZE,
+    ):
+        if not isinstance(spec, ScanSpec):
+            raise ReclaimConfigError("ReclaimSession needs a ScanSpec")
+        self.spec = spec
+        self.planner = ReclaimPlanner(strategy=strategy, action=action)
+        self.strength = strength
+        self.big_file_size = big_file_size
+        # If the caller didn't override min_size, let the grouper default apply.
+        self.min_size = min_size
+        self._analysis = None
+
+    def analyze(self, j=job.nulljob, force=False):
+        """Run the pure phase (scan -> group -> plan) and cache the result."""
+        if self._analysis is not None and not force:
+            return self._analysis
+        scanner = CandidateScanner(self.spec)
+        candidates = scanner.scan(j=j)
+        group_kwargs = dict(strength=self.strength, big_file_size=self.big_file_size, j=j)
+        if self.min_size is not None:
+            group_kwargs["min_size"] = self.min_size
+        grouping = group_identical(candidates, **group_kwargs)
+        plan = self.planner.build(grouping.groups)
+        self._analysis = AnalysisResult(candidates, grouping, plan)
+        return self._analysis
+
+    @property
+    def analysis(self):
+        if self._analysis is None:
+            return self.analyze()
+        return self._analysis
+
+    def preview(self, j=job.nulljob):
+        """Dry-run the current plan; does not mutate the filesystem."""
+        plan = self.analyze(j=j).plan
+        executor = ReclaimExecutor(dry_run=True)
+        return executor.execute(plan)
+
+    def apply(self, dry_run=False, ignore_stale=False, keep_going=False, trash_func=None, j=job.nulljob):
+        """Execute the plan produced by :meth:`analyze`.
+
+        The plan is (re)built if it hasn't been yet, so ``apply`` alone works;
+        but if you already called :meth:`analyze`/:meth:`preview`, the very same
+        plan is used.
+        """
+        plan = self.analyze(j=j).plan
+        executor = ReclaimExecutor(
+            dry_run=dry_run,
+            ignore_stale=ignore_stale,
+            keep_going=keep_going,
+            trash_func=trash_func,
+        )
+        return executor.execute(plan)
diff --git a/core/reclaim/strategies.py b/core/reclaim/strategies.py
new file mode 100644
index 00000000..ee9780cd
--- /dev/null
+++ b/core/reclaim/strategies.py
@@ -0,0 +1,228 @@
+# Copyright 2016 Hardcoded Software (http://www.hardcoded.net)
+#
+# This software is licensed under the "GPLv3" License as described in the "LICENSE" file,
+# which should be included with this package. The terms are also available at
+# http://www.gnu.org/licenses/gpl-3.0.html
+
+"""Keeper-selection strategies.
+
+When a bunch of files are byte-identical, exactly one of them should be kept and
+the rest reclaimed. *Which* one to keep is a policy decision, and different users
+want different policies:
+
+* keep the **oldest** copy (the original), delete the later copies;
+* keep the **newest** copy;
+* keep the one with the **shortest path** (the copy that lives closest to the
+  root is usually the "real" one, deep copies are usually strays);
+* keep the copy under a **preferred directory** (e.g. an ``Originals`` folder);
+* keep the copy whose **name looks least like a duplicate** ("photo.jpg" over
+  "photo (1).jpg" / "photo copy.jpg").
+
+A strategy is expressed as a *sort key*: we sort the group's candidates and the
+first one wins the "keeper" seat. Strategies compose -- you can rank primarily
+by preferred-directory and break ties by oldest -- via :class:`CompositeStrategy`.
+
+Reference/protected candidates are handled outside the strategy: they are always
+kept and never eligible to be a victim. A strategy only ever chooses among the
+*non-protected* members, and only when a group has no protected member at all.
+"""
+
+import re
+
+from core.reclaim.errors import UnknownStrategyError
+
+__all__ = [
+    "KeeperStrategy",
+    "OldestKeeper",
+    "NewestKeeper",
+    "ShortestPathKeeper",
+    "LongestPathKeeper",
+    "PreferredDirKeeper",
+    "CleanestNameKeeper",
+    "BiggestKeeper",
+    "CompositeStrategy",
+    "make_strategy",
+    "STRATEGY_NAMES",
+]
+
+# Marks a filename as looking like a copy: "foo (1).jpg", "foo copy.jpg",
+# "foo - Copy.jpg", "foo_2.txt". Higher score == more copy-like == less
+# desirable to keep.
+_COPY_MARKERS = [
+    re.compile(r"\bcopy\b", re.IGNORECASE),
+    re.compile(r"\(\d+\)\s*$"),
+    re.compile(r"\[\d+\]\s*$"),
+    re.compile(r"[-_ ]\d+\s*$"),
+]
+
+
+def _copy_score(stem):
+    """How 'copy-like' a filename stem is; 0 means pristine."""
+    score = 0
+    for marker in _COPY_MARKERS:
+        if marker.search(stem):
+            score += 1
+    # A trailing digit is a mild signal even without brackets.
+    if stem.strip()[-1:].isdigit():
+        score += 1
+    return score
+
+
+class KeeperStrategy:
+    """Base class: rank the candidates of a group, best keeper first."""
+
+    name = "base"
+
+    def sort_key(self, candidate):
+        """Return a sort key; the candidate with the smallest key is kept."""
+        raise NotImplementedError()
+
+    def rank(self, candidates):
+        """Return ``candidates`` ordered best-keeper-first.
+
+        The sort is stable, so candidates that tie on the strategy key keep the
+        input order (the caller feeds a deterministically ordered group, so the
+        whole thing is deterministic).
+        """
+        return sorted(candidates, key=self.sort_key)
+
+    def choose_keeper(self, candidates):
+        """Return the single candidate to keep out of ``candidates``."""
+        return self.rank(candidates)[0]
+
+    def __repr__(self):
+        return f"<{type(self).__name__}>"
+
+
+class OldestKeeper(KeeperStrategy):
+    """Keep the earliest-modified copy (the presumed original)."""
+
+    name = "oldest"
+
+    def sort_key(self, candidate):
+        return (candidate.mtime, str(candidate.path))
+
+
+class NewestKeeper(KeeperStrategy):
+    name = "newest"
+
+    def sort_key(self, candidate):
+        return (-candidate.mtime, str(candidate.path))
+
+
+class ShortestPathKeeper(KeeperStrategy):
+    """Keep the copy with the fewest path components, then shortest string."""
+
+    name = "shortest_path"
+
+    def sort_key(self, candidate):
+        return (candidate.depth, len(str(candidate.path)), str(candidate.path))
+
+
+class LongestPathKeeper(KeeperStrategy):
+    name = "longest_path"
+
+    def sort_key(self, candidate):
+        return (-candidate.depth, -len(str(candidate.path)), str(candidate.path))
+
+
+class BiggestKeeper(KeeperStrategy):
+    """Keep the largest file. (For byte-identical dupes sizes match, so this is
+    mostly useful as a tie-break component in a composite.)"""
+
+    name = "biggest"
+
+    def sort_key(self, candidate):
+        return (-candidate.size, str(candidate.path))
+
+
+class CleanestNameKeeper(KeeperStrategy):
+    """Keep the copy whose name looks least like a duplicate."""
+
+    name = "cleanest_name"
+
+    def sort_key(self, candidate):
+        return (_copy_score(candidate.stem), len(candidate.name), str(candidate.path))
+
+
+class PreferredDirKeeper(KeeperStrategy):
+    """Keep the copy that lives under one of the ``preferred`` directories.
+
+    Directories earlier in the list are preferred over later ones. A copy under
+    no preferred directory sorts last. Within the same preference rank we fall
+    back to shortest path so the choice is still deterministic.
+    """
+
+    name = "preferred_dir"
+
+    def __init__(self, preferred):
+        from pathlib import Path
+
+        self.preferred = [Path(p) for p in preferred]
+
+    def _rank_of(self, candidate):
+        for i, pref in enumerate(self.preferred):
+            try:
+                candidate.path.relative_to(pref)
+                return i
+            except ValueError:
+                continue
+        return len(self.preferred)
+
+    def sort_key(self, candidate):
+        return (self._rank_of(candidate), candidate.depth, str(candidate.path))
+
+
+class CompositeStrategy(KeeperStrategy):
+    """Chain several strategies: earlier ones dominate, later ones break ties."""
+
+    name = "composite"
+
+    def __init__(self, strategies):
+        self.strategies = list(strategies)
+        if not self.strategies:
+            raise UnknownStrategyError("composite strategy needs at least one component")
+
+    def sort_key(self, candidate):
+        return tuple(s.sort_key(candidate) for s in self.strategies)
+
+
+# Registry of the no-argument strategies, keyed by their public name.
+_SIMPLE = {
+    OldestKeeper.name: OldestKeeper,
+    NewestKeeper.name: NewestKeeper,
+    ShortestPathKeeper.name: ShortestPathKeeper,
+    LongestPathKeeper.name: LongestPathKeeper,
+    BiggestKeeper.name: BiggestKeeper,
+    CleanestNameKeeper.name: CleanestNameKeeper,
+}
+
+STRATEGY_NAMES = sorted(list(_SIMPLE.keys()) + [PreferredDirKeeper.name])
+
+
+def make_strategy(spec):
+    """Build a :class:`KeeperStrategy` from a flexible ``spec``.
+
+    ``spec`` may be:
+
+    * a :class:`KeeperStrategy` instance (returned as-is);
+    * a string naming a simple strategy (``"oldest"``, ``"shortest_path"`` ...);
+    * a ``("preferred_dir", [paths...])`` tuple;
+    * a list/tuple of any of the above, which becomes a :class:`CompositeStrategy`.
+    """
+    if isinstance(spec, KeeperStrategy):
+        return spec
+    if isinstance(spec, str):
+        try:
+            return _SIMPLE[spec]()
+        except KeyError:
+            raise UnknownStrategyError(
+                f"unknown keeper strategy {spec!r}; known: {', '.join(STRATEGY_NAMES)}"
+            )
+    if isinstance(spec, (list, tuple)):
+        # A ("preferred_dir", [...]) pair is a single parametrised strategy, not
+        # a composite -- disambiguate by the first element being that name.
+        if len(spec) == 2 and spec[0] == PreferredDirKeeper.name:
+            return PreferredDirKeeper(spec[1])
+        return CompositeStrategy([make_strategy(s) for s in spec])
+    raise UnknownStrategyError(f"cannot interpret strategy spec: {spec!r}")
