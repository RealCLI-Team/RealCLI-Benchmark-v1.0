  "featureCases": [
    {
      "group": "primary",
      "input": {
        "request": {
          "method": "GET",
          "headers": {}
        },
        "response": {
          "status": 200,
          "headers": {
            "Cache-Control": "max-age=60"
          }
        }
      },
      "expected": {
        "cacheable": true,
        "freshnessSeconds": 60,
        "reasons": [
          "explicit max-age"
        ]
      }
    },
    {
      "group": "composition",
      "input": {
        "request": {
          "method": "GET",
          "headers": {
            "Authorization": "Bearer x"
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "Cache-Control": "public, max-age=30"
          }
        }
      },
      "expected": {
        "cacheable": true,
        "freshnessSeconds": 30,
        "reasons": [
          "authorization allowed by public",
          "explicit max-age"
        ]
      }
    },
    {
