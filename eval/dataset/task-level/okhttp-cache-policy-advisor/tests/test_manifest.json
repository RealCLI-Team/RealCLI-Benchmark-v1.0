    },
    "domain_modeling": {
      "description": "Implements the feature's main business rules instead of hard-coding the public examples.",
      "boundary": "Measured by primary examples and hidden rule-composition cases."
    },
    "state_and_data": {
      "description": "Handles collections, ordering, aggregation, normalization, and deterministic output.",
      "boundary": "Measured by batch inputs, duplicate handling, summary fields, and stable sorting."
    },
    "edge_cases": {
      "description": "Handles invalid input, empty data, boundary values, and conflict cases deliberately.",
      "boundary": "Measured by validation and boundary fixtures with explicit expected diagnostics."
    },
    "integration_behavior": {
      "description": "Connects the implemented feature to the expected CLI and project build flow.",
      "boundary": "Measured by end-to-end CLI execution against files, Maven compile/test, and JSON parsing."
    },
    "regression_safety": {
      "description": "Preserves existing project behavior and avoids shortcuts that only satisfy visible fixtures.",
      "boundary": "Measured by public tests, hidden data, and static checks for hard-coded fixture outputs."
    },
    "maintainability": {
      "description": "Keeps the implementation local, readable, and free of process/network side effects.",
      "boundary": "Measured by static locality, file-size, and forbidden API checks."
    }
  },
