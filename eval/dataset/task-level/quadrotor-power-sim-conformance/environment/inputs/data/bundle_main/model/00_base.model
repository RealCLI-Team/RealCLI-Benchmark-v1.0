# Baseline flight-power model for the quad-rotor power subsystem.
# Syntax: param <dotted.key> = <number|null> [<unit>]

param battery.capacity         = 6.0     [A*h]
param battery.nominal_voltage  = 22200   [mV]

param load.base_power          = 12.5    [W]      # avionics + payload idle draw
param load.throttle_gain       = 480.0   [W]

param control.step_ms          = 20      [ms]
param control.timeout_ms       = 200     [ms]
param control.horizon_ms       = 4.0     [s]
param control.arm_throttle_max = 0.05    [1]

param thermal.derate_gain      = 3.0     [W]
