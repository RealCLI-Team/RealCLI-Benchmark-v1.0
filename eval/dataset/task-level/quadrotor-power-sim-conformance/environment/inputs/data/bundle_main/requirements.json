{
  "bundle": "bundle_main",
  "requirements": [
    {"id": "REQ-SOC",    "revision": 1, "metric": "soc_end",        "op": ">=", "threshold": 0.30,  "severity": "critical", "applies_to": ["*"]},
    {"id": "REQ-SOC",    "revision": 3, "metric": "soc_end",        "op": ">=", "threshold": 0.20,  "severity": "critical", "applies_to": ["*"]},
    {"id": "REQ-PEAK",   "revision": 2, "metric": "peak_throttle",  "op": "<=", "threshold": 0.55,  "severity": "major",    "applies_to": ["s01_nominal", "s03_noisy"]},
    {"id": "REQ-PEAK",   "revision": 2, "metric": "peak_throttle",  "op": "<=", "threshold": 0.60,  "severity": "major",    "applies_to": ["s01_nominal", "s03_noisy"]},
    {"id": "REQ-FS",     "revision": 1, "metric": "failsafe_steps", "op": "==", "threshold": 0,     "severity": "minor",    "applies_to": ["*"]},
    {"id": "REQ-ENERGY", "revision": 1, "metric": "mean_power_w",   "op": "<=", "threshold": 200.0, "severity": "major",    "applies_to": ["s01_nominal", "s99_absent"]}
  ]
}
