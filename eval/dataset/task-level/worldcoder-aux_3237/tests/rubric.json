      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "cityCount===20",
        "routeCount===30"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cityCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.routeCount === 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.filterContinent === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.filterContinent.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.cityCount) && Number.isInteger(window.__3D_STATE__.routeCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cityCount === 20 && window.__3D_STATE__.routeCount === 30",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.cityCount)",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.routeCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "script",
        "code": "(function(){ var s=document.getElementById('continentFilter'); if(!s)return; var o=s.querySelectorAll('option'); for(var i=0;i<o.length;i++){ if(o[i].value && o[i].value!=='all'){ s.value=o[i].value; break; } } s.dispatchEvent(new Event('change',{bubbles:true})); })()",
        "__note__": "kept: dispatches 'input'/'change' to a real DOM element (portable, not a window key/pointer dispatch)"
      },
      "postconditions": [
        "filterContinent 非 all 且改变"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.filterContinent !== 'all'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterContinent === document.getElementById('continentFilter').value",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterContinent !== before.filterContinent",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cityCount === 20 && window.__3D_STATE__.routeCount === 30",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.cityCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
