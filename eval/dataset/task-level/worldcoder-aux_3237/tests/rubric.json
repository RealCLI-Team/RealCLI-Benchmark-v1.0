      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.filterContinent === 'all'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterContinent !== before.filterContinent",
            "tier": "L2"
