            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
