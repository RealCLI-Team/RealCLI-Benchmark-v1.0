@@ -0,0 +1,63 @@
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+from great_expectations.compatibility import pyspark
+from great_expectations.compatibility.pyspark import functions as F
+from great_expectations.execution_engine import (
+    PandasExecutionEngine,
+    SparkDFExecutionEngine,
+)
+from great_expectations.expectations.metrics.map_metric_provider import (
+    ColumnMapMetricProvider,
+    column_condition_partial,
+)
+
+_UUID_CANONICAL_PATTERN = re.compile(
+    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
+)
+# Position of the version nibble within the canonical 36-character representation
+# (first hexadecimal digit of the third hyphen-separated group).
+_UUID_VERSION_NIBBLE_INDEX = 14
+
+
+def _is_valid_uuid(val: object, uuid_version: Optional[int]) -> bool:
+    """Check whether a value is a canonical RFC 4122 UUID string.
+
+    Only the canonical 8-4-4-4-12 hyphenated hexadecimal representation is
+    accepted (surrounding braces, "urn:uuid:" prefixes and undelimited
+    32-digit hex strings are rejected). Hexadecimal digits may be upper or
+    lower case. When ``uuid_version`` is provided, the version nibble of the
+    UUID must match it exactly.
+    """
+    if not isinstance(val, str):
+        return False
+    if not _UUID_CANONICAL_PATTERN.fullmatch(val):
+        return False
+    if uuid_version is not None:
+        try:
+            version_nibble = int(val[_UUID_VERSION_NIBBLE_INDEX], 16)
+        except (ValueError, IndexError):
+            return False
+        if version_nibble != uuid_version:
+            return False
+    return True
+
+
+class ColumnValuesValidUuid(ColumnMapMetricProvider):
+    condition_metric_name = "column_values.valid_uuid"
+    condition_value_keys = ("uuid_version",)
+
+    @column_condition_partial(engine=PandasExecutionEngine)
+    def _pandas(cls, column, uuid_version=None, **kwargs):
+        return column.map(lambda val: _is_valid_uuid(val, uuid_version))
+
+    @column_condition_partial(engine=SparkDFExecutionEngine)
+    def _spark(cls, column, uuid_version=None, **kwargs):
+        def is_valid_uuid(val):
+            return _is_valid_uuid(val, uuid_version)
+
+        is_valid_uuid_udf = F.udf(is_valid_uuid, pyspark.types.BooleanType())
+
+        return is_valid_uuid_udf(column)
