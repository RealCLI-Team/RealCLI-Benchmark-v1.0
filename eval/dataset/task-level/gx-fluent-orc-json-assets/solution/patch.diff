+from __future__ import annotations
+
+from great_expectations.compatibility import pyspark
+from great_expectations.compatibility.pyspark import functions as F
+from great_expectations.execution_engine import (
+    PandasExecutionEngine,
+    SparkDFExecutionEngine,
+)
+from great_expectations.expectations.metrics.map_metric_provider import (
+    ColumnMapMetricProvider,
+    column_condition_partial,
+)
+
+# PAN lengths permitted by ISO/IEC 7812-1 are up to 19 digits; lengths below
+# 13 are not issued by any major scheme.
+_MIN_PAN_LENGTH = 13
+_MAX_PAN_LENGTH = 19
+
+
+def _luhn_checksum_is_valid(digits: str) -> bool:
+    """Validate a string of decimal digits against the Luhn (mod 10) algorithm."""
+    total = 0
+    for index_from_right, char in enumerate(reversed(digits)):
+        digit = int(char)
+        if index_from_right % 2 == 1:
+            digit *= 2
+            if digit > 9:
+                digit -= 9
+        total += digit
+    return total % 10 == 0
+
+
+def _is_valid_credit_card_number(val: object) -> bool:
+    """Check whether a value is a plausibly valid payment card number (PAN).
+
+    Spaces and hyphens are ignored, so grouped presentations such as
+    "4532 0151 1283 0366" are accepted. After stripping those separators the
+    value must consist solely of decimal digits, be between 13 and 19 digits
+    long (inclusive), and satisfy the Luhn checksum.
+    """
+    if not isinstance(val, str):
+        return False
+    digits = val.replace(" ", "").replace("-", "")
+    if not digits.isdigit():
+        return False
+    if not _MIN_PAN_LENGTH <= len(digits) <= _MAX_PAN_LENGTH:
+        return False
+    return _luhn_checksum_is_valid(digits)
+
+
+class ColumnValuesValidCreditCardNumber(ColumnMapMetricProvider):
+    condition_metric_name = "column_values.valid_credit_card_number"
+
+    @column_condition_partial(engine=PandasExecutionEngine)
+    def _pandas(cls, column, **kwargs):
+        return column.map(_is_valid_credit_card_number)
+
+    @column_condition_partial(engine=SparkDFExecutionEngine)
+    def _spark(cls, column, **kwargs):
+        is_valid_credit_card_number_udf = F.udf(
+            _is_valid_credit_card_number, pyspark.types.BooleanType()
+        )
+
+        return is_valid_credit_card_number_udf(column)
