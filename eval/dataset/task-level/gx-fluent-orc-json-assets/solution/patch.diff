+    "XK": 20,
+}
+
+_IBAN_STRUCTURE_PATTERN = re.compile(r"^[A-Z]{2}[0-9]{2}[A-Z0-9]+$")
+
+
+def _iban_mod97_is_valid(compact_iban: str) -> bool:
+    """Run the ISO 13616 mod-97 check on a normalized (compact, upper-case) IBAN.
+
+    The first four characters are moved to the end, letters are expanded to
+    their numeric equivalents (A=10, ..., Z=35), and the resulting number must
+    leave remainder 1 modulo 97. The remainder is computed incrementally so
+    arbitrarily long expansions never overflow.
+    """
+    rearranged = compact_iban[4:] + compact_iban[:4]
+    remainder = 0
+    for char in rearranged:
+        if char.isalpha():
+            expansion = str(ord(char) - 55)
+        else:
+            expansion = char
+        for digit in expansion:
+            remainder = (remainder * 10 + int(digit)) % 97
+    return remainder == 1
+
+
+def _is_valid_iban(val: object) -> bool:
+    """Check whether a value is a structurally valid IBAN.
+
+    Whitespace (including the customary groups-of-four presentation) and
+    letter case are ignored. The normalized value must match the IBAN
+    structure (two-letter country code, two check digits, then an alphanumeric
+    BBAN), must have exactly the total length mandated by the ISO 13616
+    registry for its country code, and must pass the mod-97 checksum.
+    """
+    if not isinstance(val, str):
+        return False
+    compact = re.sub(r"\s+", "", val).upper()
+    if not _IBAN_STRUCTURE_PATTERN.match(compact):
+        return False
+    expected_length = _IBAN_LENGTHS_BY_COUNTRY.get(compact[:2])
+    if expected_length is None or len(compact) != expected_length:
+        return False
+    return _iban_mod97_is_valid(compact)
+
+
+class ColumnValuesValidIban(ColumnMapMetricProvider):
+    condition_metric_name = "column_values.valid_iban"
+
+    @column_condition_partial(engine=PandasExecutionEngine)
+    def _pandas(cls, column, **kwargs):
+        return column.map(_is_valid_iban)
+
+    @column_condition_partial(engine=SparkDFExecutionEngine)
+    def _spark(cls, column, **kwargs):
+        is_valid_iban_udf = F.udf(_is_valid_iban, pyspark.types.BooleanType())
+
+        return is_valid_iban_udf(column)
