+)
+
+# The value must at least begin with a full calendar date (YYYY-MM-DD). This
+# intentionally rejects compact ("20260115"), week ("2026-W03-4") and ordinal
+# ("2026-015") notations, as well as bare times: the expectation targets
+# calendar dates and datetimes, not the full breadth of ISO 8601.
+_ISO8601_CALENDAR_DATE_PREFIX = re.compile(r"^\d{4}-\d{2}-\d{2}")
+
+
+def _is_valid_iso8601_datetime(val: object) -> bool:
+    """Check whether a value is a valid ISO 8601 calendar date or datetime string.
+
+    Accepted values begin with a calendar date in ``YYYY-MM-DD`` form and may
+    continue with a time component separated by ``T`` (or a space), optional
+    fractional seconds, and an optional UTC offset (``Z`` or ``+/-HH:MM``).
+    The string must be parseable by ``datetime.fromisoformat``; impossible
+    dates (e.g. month 13) and times (e.g. hour 25) are rejected.
+    """
+    if not isinstance(val, str):
+        return False
+    if not _ISO8601_CALENDAR_DATE_PREFIX.match(val):
+        return False
+    try:
+        datetime.fromisoformat(val)
+    except ValueError:
+        return False
+    return True
+
+
+class ColumnValuesValidIso8601Datetime(ColumnMapMetricProvider):
+    condition_metric_name = "column_values.valid_iso8601_datetime"
+
+    @column_condition_partial(engine=PandasExecutionEngine)
+    def _pandas(cls, column, **kwargs):
+        return column.map(_is_valid_iso8601_datetime)
+
+    @column_condition_partial(engine=SparkDFExecutionEngine)
+    def _spark(cls, column, **kwargs):
+        is_valid_iso8601_datetime_udf = F.udf(
+            _is_valid_iso8601_datetime, pyspark.types.BooleanType()
+        )
+
+        return is_valid_iso8601_datetime_udf(column)
