+def _is_json_document(val: object) -> bool:
+    """Return True iff ``val`` is a string that parses as a top-level JSON document.
+
+    A "JSON document" for data governance purposes is a top-level JSON object
+    (``{...}``) or JSON array (``[...]``). Primitive JSON literals — numbers,
+    booleans, ``null`` and bare quoted strings — are technically parseable by
+    :func:`json.loads` but do not represent structured records and are
+    therefore not considered documents. Empty strings, whitespace-only
+    strings, and non-string values are also rejected.
+    """
+    if not isinstance(val, str):
+        return False
+    if not val.strip():
+        return False
+    try:
+        parsed = json.loads(val)
+    except (ValueError, TypeError):
+        return False
+    return isinstance(parsed, (dict, list))
+
+
