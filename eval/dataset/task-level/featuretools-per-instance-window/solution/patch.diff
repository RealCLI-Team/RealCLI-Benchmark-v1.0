+def _validate_training_window_column(cutoff_time, training_window, time_type):
+    """Validate a per-instance training window column on a cutoff time DataFrame.
+
+    If the cutoff time DataFrame contains a column named ``training_window``,
+    each non-null value in that column defines the training window used for the
+    corresponding row, instead of a single global ``training_window``. Null
+    values mean that no training window is applied for that row.
+
+    Returns True if the column is present (after validating its values), and
+    False if the column is not present.
+    """
+    if (
+        not isinstance(cutoff_time, pd.DataFrame)
+        or TRAINING_WINDOW_COLUMN not in cutoff_time.columns
+    ):
+        return False
+
+    if training_window is not None:
+        raise ValueError(
+            "Cannot pass a global training_window value when the cutoff_time "
+            "DataFrame contains a 'training_window' column. Pass per-instance "
+            "windows in the column or a single global window, not both.",
+        )
+
+    for value in cutoff_time[TRAINING_WINDOW_COLUMN]:
+        if value is None or (not isinstance(value, str) and pd.isna(value)):
+            continue
+        if time_type == "numeric":
+            valid = isinstance(
+                value,
+                (int, float, np.integer, np.floating),
+            ) and not isinstance(value, bool)
+            negative = valid and value < 0
+            expected = "a non-negative int or float"
+        else:
+            valid = isinstance(value, (pd.Timedelta, timedelta, np.timedelta64))
+            negative = valid and pd.Timedelta(value) < pd.Timedelta(0)
+            expected = "a non-negative pd.Timedelta or datetime.timedelta"
+        if not valid:
+            raise ValueError(
+                "Invalid value %r in the cutoff_time 'training_window' column: "
+                "values must be %s for this entityset, or null to use all "
+                "data before the cutoff time." % (value, expected),
+            )
+        if negative:
+            raise ValueError(
+                "Invalid value %r in the cutoff_time 'training_window' column: "
+                "training windows cannot be negative." % (value,),
+            )
+
+    return True
+
+
