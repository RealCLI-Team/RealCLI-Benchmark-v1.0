+    # s1 without window: e1, e2 -> 2
+    # s2 (start 01-18) inside (01-17, 01-21]: its events e3(01-19), e4(01-20) -> 2
+    # s4 (start 01-19) inside (01-17, 01-21]: its event e6(01-21) -> 1
+    assert fm["COUNT(events)"].tolist() == [2, 2, 1]
