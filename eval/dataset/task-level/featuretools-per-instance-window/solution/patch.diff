+"""Integration tests for per-instance training windows using the standard
+ecommerce entityset fixtures (``es`` with a datetime time index and
+``int_es`` with an integer time index).
+
+Most assertions here are equivalences against the pre-existing global
+``training_window`` behavior: rows that share a window value must produce
+exactly the same feature values as a separate calculation using that window
+globally, and rows without a window value must match a calculation without
+any window.
+"""
+import pandas as pd
+import pytest
+
+import featuretools as ft
+from featuretools.primitives import Count, Mean, Sum
+
+
+def ecommerce_features(es):
+    count = ft.Feature(
+        es["log"].ww["id"],
+        parent_dataframe_name="sessions",
+        primitive=Count,
+    )
+    total = ft.Feature(
+        es["log"].ww["value"],
+        parent_dataframe_name="sessions",
+        primitive=Sum,
+    )
+    mean = ft.Feature(
+        es["log"].ww["value"],
+        parent_dataframe_name="sessions",
+        primitive=Mean,
+    )
+    return [count, total, mean]
+
+
+def cutoff_for_sessions(es, windows, times=None):
+    session_ids = es["sessions"].ww["id"].tolist()[: len(windows)]
+    if times is None:
+        times = [pd.Timestamp("2011-04-09 10:30:00")] * len(windows)
+    return pd.DataFrame(
+        {
+            "instance_id": session_ids,
+            "time": times,
+            "training_window": windows,
+        },
+    )
+
+
+def assert_windowed_rows_match_global(es, features, cutoff, window, global_window):
+    """Rows of ``cutoff`` whose window column equals ``window`` must match a
+    calculation of the same rows with ``global_window`` as the global
+    training_window (or no window at all if ``global_window`` is None)."""
+    mask = cutoff["training_window"].isna()
+    if window is not None:
+        mask = cutoff["training_window"] == window
+    rows = cutoff[mask][["instance_id", "time"]]
+    expected = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=rows,
+        training_window=global_window,
+    )
+    actual = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=cutoff)
+    actual_rows = actual.loc[actual.index.isin(expected.index)]
+    pd.testing.assert_frame_equal(
+        expected.sort_index(),
+        actual_rows.sort_index(),
+    )
+
+
+def test_ecommerce_per_instance_window_matches_global_per_window(es):
+    features = ecommerce_features(es)
+    cutoff = cutoff_for_sessions(
+        es,
+        [
+            pd.Timedelta("10min"),
+            pd.Timedelta("1h"),
+            pd.Timedelta("1h"),
+            pd.NaT,
+            pd.Timedelta("10min"),
+            pd.NaT,
+        ],
+    )
+    assert_windowed_rows_match_global(
+        es,
+        features,
+        cutoff,
+        pd.Timedelta("10min"),
+        "10 minutes",
+    )
+    assert_windowed_rows_match_global(es, features, cutoff, pd.Timedelta("1h"), "1h")
+    assert_windowed_rows_match_global(es, features, cutoff, None, None)
+
+
+def test_ecommerce_constant_window_column_matches_global(es):
+    features = ecommerce_features(es)
+    base_cutoff = pd.DataFrame(
+        {
+            "instance_id": es["sessions"].ww["id"].tolist()[:6],
+            "time": [pd.Timestamp("2011-04-09 10:30:00")] * 6,
+        },
+    )
+    windowed_cutoff = base_cutoff.copy()
+    windowed_cutoff["training_window"] = [pd.Timedelta("2h")] * 6
+    expected = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=base_cutoff,
+        training_window="2h",
+    )
+    actual = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=windowed_cutoff,
+    )
+    pd.testing.assert_frame_equal(expected, actual)
+
+
+def test_ecommerce_per_instance_window_multiple_times(es):
+    features = ecommerce_features(es)
+    session_ids = es["sessions"].ww["id"].tolist()[:4]
+    cutoff = pd.DataFrame(
+        {
+            "instance_id": session_ids + session_ids,
+            "time": [pd.Timestamp("2011-04-09 10:30:00")] * 4
+            + [pd.Timestamp("2011-04-10 11:00:00")] * 4,
+            "training_window": [pd.Timedelta("1h")] * 4 + [pd.NaT] * 4,
+        },
+    )
+    fm = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=cutoff)
+    assert len(fm) == 8
+    early = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=cutoff.iloc[:4][["instance_id", "time"]],
+        training_window="1h",
+    )
+    late = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=cutoff.iloc[4:][["instance_id", "time"]],
+    )
+    pd.testing.assert_frame_equal(
+        fm.sort_index(),
+        pd.concat([early, late]).sort_index(),
+    )
+
+
+def test_ecommerce_per_instance_window_pass_through(es):
+    features = ecommerce_features(es)
+    cutoff = cutoff_for_sessions(
+        es,
+        [pd.Timedelta("1h"), pd.NaT],
+        times=[pd.Timestamp("2011-04-09 10:30:00")] * 2,
+    )
+    cutoff["session_label"] = ["first", "second"]
+    fm = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=cutoff)
+    assert "training_window" not in fm.columns
+    assert fm["session_label"].tolist() == ["first", "second"]
+
+
+def test_ecommerce_per_instance_window_cutoff_time_in_index(es):
+    features = ecommerce_features(es)
+    cutoff = cutoff_for_sessions(
+        es,
+        [pd.Timedelta("1h"), pd.NaT],
+        times=[pd.Timestamp("2011-04-09 10:30:00")] * 2,
+    )
+    fm = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=cutoff,
+        cutoff_time_in_index=True,
+    )
+    assert fm.index.names == ["id", "time"]
+    assert "training_window" not in fm.columns
+
+
+def test_ecommerce_per_instance_window_chunk_size_invariance(es):
+    features = ecommerce_features(es)
+    cutoff = cutoff_for_sessions(
+        es,
+        [pd.Timedelta("1h"), pd.Timedelta("10min"), pd.NaT, pd.Timedelta("1h")],
+    )
+    full = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=cutoff)
+    for chunk_size in [1, 2, 0.5]:
+        chunked = ft.calculate_feature_matrix(
+            features,
+            entityset=es,
+            cutoff_time=cutoff,
+            chunk_size=chunk_size,
+        )
+        pd.testing.assert_frame_equal(full, chunked)
+
+
+def test_ecommerce_per_instance_window_dfs(es):
+    cutoff = cutoff_for_sessions(
+        es,
+        [pd.Timedelta("1h"), pd.NaT],
+        times=[pd.Timestamp("2011-04-09 10:30:00")] * 2,
+    )
+    fm, _ = ft.dfs(
+        entityset=es,
+        target_dataframe_name="sessions",
+        cutoff_time=cutoff,
+        agg_primitives=["count", "sum", "mean"],
+        trans_primitives=[],
+        max_depth=1,
+    )
+    assert "training_window" not in fm.columns
+    expected_windowed, _ = ft.dfs(
+        entityset=es,
+        target_dataframe_name="sessions",
+        cutoff_time=cutoff.iloc[[0]][["instance_id", "time"]],
+        training_window="1h",
+        agg_primitives=["count", "sum", "mean"],
+        trans_primitives=[],
+        max_depth=1,
+    )
+    expected_full, _ = ft.dfs(
+        entityset=es,
+        target_dataframe_name="sessions",
+        cutoff_time=cutoff.iloc[[1]][["instance_id", "time"]],
+        agg_primitives=["count", "sum", "mean"],
+        trans_primitives=[],
+        max_depth=1,
+    )
+    pd.testing.assert_frame_equal(
+        fm.sort_index(),
+        pd.concat([expected_windowed, expected_full]).sort_index(),
+    )
+
+
+def test_ecommerce_per_instance_window_deep_features(es):
+    """Per-instance windows must also apply to aggregations two hops away."""
+    count = ft.Feature(
+        es["log"].ww["id"],
+        parent_dataframe_name="customers",
+        primitive=Count,
+    )
+    mean = ft.Feature(
+        es["log"].ww["value"],
+        parent_dataframe_name="customers",
+        primitive=Mean,
+    )
+    features = [count, mean]
+    customer_ids = es["customers"].ww["id"].tolist()[:3]
+    base_cutoff = pd.DataFrame(
+        {
+            "instance_id": customer_ids,
+            "time": [pd.Timestamp("2011-04-09 10:30:00")] * 3,
+        },
+    )
+    windowed_cutoff = base_cutoff.copy()
+    windowed_cutoff["training_window"] = [
+        pd.Timedelta("1h"),
+        pd.NaT,
+        pd.Timedelta("10min"),
+    ]
+    fm = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=windowed_cutoff)
+    for idx, global_window in enumerate(["1h", None, "10 minutes"]):
+        expected = ft.calculate_feature_matrix(
+            features,
+            entityset=es,
+            cutoff_time=base_cutoff.iloc[[idx]],
+            training_window=global_window,
+        )
+        pd.testing.assert_frame_equal(fm.iloc[[idx]], expected)
+
+
+def test_ecommerce_per_instance_window_with_global_raises_via_dfs(es):
+    cutoff = cutoff_for_sessions(
+        es,
+        [pd.Timedelta("1h")],
+        times=[pd.Timestamp("2011-04-09 10:30:00")],
+    )
+    error = "Cannot pass a global training_window"
+    with pytest.raises(ValueError, match=error):
+        ft.dfs(
+            entityset=es,
+            target_dataframe_name="sessions",
+            cutoff_time=cutoff,
