+    assert fm["COUNT(events)"].tolist() == [2, 3]
+    # swap the windows around and check the results swap as well
+    cutoff_swapped = make_windowed_cutoff(
+        times=[(1, "2023-01-21"), (2, "2023-01-21")],
+        windows=[pd.NaT, pd.Timedelta("7d")],
+    )
+    fm_swapped = ft.calculate_feature_matrix(
+        features,
+        entityset=es,
+        cutoff_time=cutoff_swapped,
+    )
+    assert fm_swapped["COUNT(events)"].tolist() == [5, 1]
