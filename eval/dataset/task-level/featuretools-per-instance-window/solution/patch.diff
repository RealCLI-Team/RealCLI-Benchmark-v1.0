+def _group_by_time_and_window(group, time_col, window_col):
+    """Split a group of cutoff times sharing one time value by training window.
+
+    Rows that carry a per-instance training window in ``window_col`` are
+    grouped by window value so that each resulting subgroup can be calculated
+    with its own window. Rows with a missing window value are grouped together
+    with a window of ``None``, meaning all data before the cutoff time is used.
+
+    Returns a list of ``((time_last, window), sub_group)`` pairs, compatible
+    with ``_chunk_dataframe_groups``.
+    """
+    time_last = group[time_col].iloc[0]
+    groups = []
+    has_window = group[window_col].notna()
+    if has_window.any():
+        for window, sub_group in group[has_window].groupby(window_col, sort=True):
+            if isinstance(window, np.generic):
+                window = window.item()
+            groups.append(((time_last, window), sub_group))
+    if (~has_window).any():
+        groups.append(((time_last, None), group[~has_window]))
+    return groups
+
+
 def _handle_chunk_size(chunk_size, total_size):
     if chunk_size is not None:
         assert chunk_size > 0, "Chunk size must be greater than 0"
