+def make_multihop_es():
+    """Three-dataframe entityset: customers <- sessions <- events.
+
+    sessions
+        s1: customer 1, start 2023-01-03
+        s2: customer 1, start 2023-01-18
+        s3: customer 2, start 2023-01-06
+        s4: customer 2, start 2023-01-19
+    events
+        e1: s1, 2023-01-04, 10
+        e2: s1, 2023-01-10, 20
+        e3: s2, 2023-01-19, 40
+        e4: s2, 2023-01-20, 80
+        e5: s3, 2023-01-07, 5
+        e6: s4, 2023-01-21, 15
+    """
+    customers = pd.DataFrame({"customer_id": [1, 2]})
+    sessions = pd.DataFrame(
+        {
+            "session_id": ["s1", "s2", "s3", "s4"],
+            "customer_id": [1, 1, 2, 2],
+            "session_start": pd.to_datetime(
+                ["2023-01-03", "2023-01-18", "2023-01-06", "2023-01-19"],
+            ),
+            "end_date": pd.to_datetime(
+                ["2023-01-05", "2023-01-20", "2023-01-08", "2023-01-25"],
+            ),
+            "end_reason": ["done", "timeout", "done", None],
+        },
+    )
+    events = pd.DataFrame(
+        {
+            "event_id": ["e1", "e2", "e3", "e4", "e5", "e6"],
+            "session_id": ["s1", "s1", "s2", "s2", "s3", "s4"],
+            "time": pd.to_datetime(
+                [
+                    "2023-01-04",
+                    "2023-01-10",
+                    "2023-01-19",
+                    "2023-01-20",
+                    "2023-01-07",
+                    "2023-01-21",
+                ],
+            ),
+            "amount": [10.0, 20.0, 40.0, 80.0, 5.0, 15.0],
+        },
+    )
+    es = ft.EntitySet("multihop")
+    es.add_dataframe(customers, dataframe_name="customers", index="customer_id")
+    es.add_dataframe(
+        sessions,
+        dataframe_name="sessions",
+        index="session_id",
+        time_index="session_start",
+    )
+    es.add_dataframe(
+        events,
+        dataframe_name="events",
+        index="event_id",
+        time_index="time",
+    )
+    es.add_relationship("customers", "customer_id", "sessions", "customer_id")
+    es.add_relationship("sessions", "session_id", "events", "session_id")
+    return es
+
+
+def test_per_instance_window_applies_across_multiple_hops():
+    es = make_multihop_es()
+    event_count = ft.Feature(
+        es["events"].ww["event_id"],
+        parent_dataframe_name="customers",
+        primitive=Count,
+    )
+    event_total = ft.Feature(
+        es["events"].ww["amount"],
+        parent_dataframe_name="customers",
+        primitive=Sum,
+    )
+    session_count = ft.Feature(
+        es["sessions"].ww["session_id"],
+        parent_dataframe_name="customers",
+        primitive=Count,
+    )
+    features = [event_count, event_total, session_count]
+    cutoff = make_windowed_cutoff(
+        times=[
+            (1, "2023-01-21"),
+            (1, "2023-01-22"),
+            (2, "2023-01-21"),
+            (2, "2023-01-22"),
+        ],
+        windows=[
+            pd.Timedelta("7d"),
+            pd.Timedelta("15d"),
+            pd.Timedelta("7d"),
+            pd.NaT,
+        ],
+    )
+    fm = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=cutoff)
+
+    # customer 1, window 7d at 01-21 -> (01-14, 01-21]
+    #   events: e3, e4 -> count 2, sum 120; sessions: s2 -> count 1
+    assert fm["COUNT(events)"].iloc[0] == 2
+    assert fm["SUM(events.amount)"].iloc[0] == 120.0
+    assert fm["COUNT(sessions)"].iloc[0] == 1
+    # customer 1, window 15d at 01-22 -> (01-07, 01-22]
+    #   the window filters every dataframe on the path: session s1 (start
+    #   01-03) is filtered out, so its events e1/e2 cannot join through to
+    #   customer 1; events: e3, e4 -> count 2, sum 120; sessions: s2 -> 1
+    assert fm["COUNT(events)"].iloc[1] == 2
