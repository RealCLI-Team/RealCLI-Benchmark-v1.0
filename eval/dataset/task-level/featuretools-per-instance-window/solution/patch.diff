+    )
+    fm = ft.calculate_feature_matrix(features, entityset=es, cutoff_time=cutoff)
+    # rows must come back in the same order as the cutoff DataFrame
+    assert fm["order_marker"].tolist() == [0, 1, 2, 3]
+    # customer 1, 21d at 01-23 -> (01-02, 01-23] -> 4 events
+    # customer 2, 7d at 01-21 -> (01-14, 01-21] -> 1 event
+    # customer 1, 7d at 01-21 -> 2 events
+    # customer 2, no window at 01-23 -> 4 events (01-02, 01-08, 01-15, 01-22)
+    assert fm["COUNT(events)"].tolist() == [4, 1, 2, 4]
