+    )
+    error = "approximate is not supported"
+    with pytest.raises(ValueError, match=error):
+        ft.dfs(
+            entityset=es,
+            target_dataframe_name="sessions",
+            cutoff_time=cutoff,
+            approximate="1h",
+            agg_primitives=["count"],
+            trans_primitives=[],
+        )
+
