@@ -0,0 +1,774 @@
+"""Tests for the ``.cruftignore`` feature.
+
+Unit tests cover the pattern engine in ``cruft._ignore``; integration
+tests exercise ``cruft create`` / ``cruft update`` / ``cruft diff``
+against locally constructed git template repositories, fully offline.
+"""
+
+import json
+import os
+import subprocess
+from pathlib import Path
+from typing import Dict, Optional
+
+import pytest
+
+import cruft
+from cruft import _ignore
+from cruft._ignore import IgnoreRules
+
+GIT_ENV = {
+    "GIT_AUTHOR_NAME": "cruft-test",
+    "GIT_AUTHOR_EMAIL": "cruft-test@example.com",
+    "GIT_COMMITTER_NAME": "cruft-test",
+    "GIT_COMMITTER_EMAIL": "cruft-test@example.com",
+    "GIT_CONFIG_NOSYSTEM": "1",
+    "HOME": os.environ.get("HOME", "/tmp"),
+}
+
+
+def _git(args, cwd):
+    env = dict(os.environ)
+    env.update(GIT_ENV)
+    subprocess.run(["git"] + list(args), cwd=str(cwd), env=env, check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _commit_all(repo_dir: Path, message: str):
+    _git(["add", "-A"], repo_dir)
+    _git(["commit", "-qm", message, "--no-gpg-sign"], repo_dir)
+
+
+def make_template(
+    root: Path,
+    files: Dict[str, str],
+    context: Optional[dict] = None,
+    message: str = "template commit",
+) -> Path:
+    """Create (or extend) a local git cookiecutter template at ``root``.
+
+    ``files`` maps paths relative to the generated project root to file
+    contents; they are written into the ``{{cookiecutter.project_slug}}``
+    directory of the template.  The whole tree is committed.
+    """
+    root = Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+    template_dir = root / "{{cookiecutter.project_slug}}"
+    if not (root / "cookiecutter.json").exists():
+        (root / "cookiecutter.json").write_text(
+            json.dumps(context or {"project_slug": "demo", "author": "Alice"})
+        )
+        _git(["init", "-q", "-b", "main"], root)
+    for relative, content in files.items():
+        path = template_dir / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(content)
+    _commit_all(root, message)
+    return root
+
+
+def head_commit(repo_dir: Path) -> str:
+    env = dict(os.environ)
+    env.update(GIT_ENV)
+    out = subprocess.run(
+        ["git", "rev-parse", "HEAD"], cwd=str(repo_dir), env=env, check=True,
+        stdout=subprocess.PIPE,
+    )
+    return out.stdout.decode().strip()
+
+
+def create_project(template_dir: Path, output_dir: Path) -> Path:
+    return Path(cruft.create(str(template_dir), Path(output_dir), no_input=True))
+
+
+def read_cruft_state(project_dir: Path) -> dict:
+    return json.loads((Path(project_dir) / ".cruft.json").read_text())
+
+
+############################################################
+# Unit tests: pattern parsing and matching                 #
+############################################################
+
+
+class TestPatternSemantics:
+    def test_blank_lines_and_comments_are_ignored(self):
+        rules = IgnoreRules.from_lines(["", "   ", "# a comment"])
+        assert len(rules) == 0
+        assert not rules.match("anything.txt")
+
+    def test_comment_rule_only_at_line_start(self):
+        rules = IgnoreRules.from_lines(["#foo"])
+        assert len(rules) == 0
+
+    def test_escaped_comment_and_negation(self):
+        rules = IgnoreRules.from_lines([r"\#literal", r"\!literal"])
+        assert rules.match("#literal")
+        assert rules.match("!literal")
+
+    def test_simple_basename_matches_at_any_depth(self):
+        rules = IgnoreRules.from_lines(["config.ini"])
+        assert rules.match("config.ini")
+        assert rules.match("a/config.ini")
+        assert rules.match("a/b/c/config.ini")
+        assert not rules.match("config.ini.bak")
+        assert not rules.match("myconfig.ini")
+
+    def test_star_does_not_cross_directories(self):
+        rules = IgnoreRules.from_lines(["*.log"])
+        assert rules.match("x.log")
+        assert rules.match("deep/nested/y.log")
+        assert not rules.match("x.logs")
+        rules2 = IgnoreRules.from_lines(["logs/*.log"])
+        assert rules2.match("logs/x.log")
+        assert not rules2.match("logs/deep/x.log")
+
+    def test_question_mark_matches_single_character(self):
+        rules = IgnoreRules.from_lines(["file?.txt"])
+        assert rules.match("file1.txt")
+        assert rules.match("dir/fileA.txt")
+        assert not rules.match("file10.txt")
+        assert not rules.match("file/.txt")
+
+    def test_character_class(self):
+        rules = IgnoreRules.from_lines(["data[0-9].csv"])
+        assert rules.match("data3.csv")
+        assert not rules.match("datax.csv")
