+class TestEngineAPI:
+    def test_rule_dataclass_fields(self):
+        rules = IgnoreRules.from_lines(["!build/"])
+        rule = rules.rules[0]
+        assert rule.pattern == "build"
+        assert rule.negated is True
+        assert rule.dir_only is True
+        assert rule.anchored is False
+        assert rule.matches("build", is_dir=True)
+        assert not rule.matches("build", is_dir=False)
+
+    def test_anchored_flag_detection(self):
+        rules = IgnoreRules.from_lines(["a/b.txt", "c.txt", "/d.txt", "e/"])
+        anchored = {r.pattern: r.anchored for r in rules.rules}
+        assert anchored == {
+            "a/b.txt": True,
+            "c.txt": False,
+            "d.txt": True,
+            "e": False,
+        }
+
+    def test_match_accepts_path_objects(self, tmp_path):
+        rules = IgnoreRules.from_lines(["*.log"])
+        from pathlib import PurePath
+
+        assert rules.match(PurePath("x/y.log"))
+        assert not rules.match(PurePath("x/y.txt"))
+
+    def test_from_file_with_utf8_bom_tolerated_or_literal(self, tmp_path):
+        # A BOM is part of the first line; this test pins the behavior
+        # that the engine neither crashes nor ignores unrelated files.
+        ignore_file = tmp_path / ".cruftignore"
+        ignore_file.write_bytes("*.log\n".encode("utf-8"))
+        rules = IgnoreRules.from_file(ignore_file)
+        assert rules.match("error.log")
