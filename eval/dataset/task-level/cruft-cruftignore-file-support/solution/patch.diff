+class TestFilterDiffSections:
+    def test_empty_diff(self):
+        filtered, skipped = _ignore.filter_diff("", IgnoreRules.from_lines(["*"]))
+        assert filtered == ""
+        assert skipped == []
+
+    def test_preamble_is_preserved(self):
+        diff = "some preamble line\n" + (
+            "diff --git upstream-template-old/a.txt upstream-template-new/a.txt\n"
+            "--- upstream-template-old/a.txt\n"
+            "+++ upstream-template-new/a.txt\n"
+            "@@ -1 +1 @@\n-x\n+y\n"
+        )
+        filtered, _ = _ignore.filter_diff(diff, IgnoreRules.from_lines(["zzz"]))
+        assert filtered.startswith("some preamble line\n")
+
+    def test_binary_section_is_filtered(self):
+        diff = (
+            "diff --git upstream-template-old/logo.png upstream-template-new/logo.png\n"
+            "index 1111111..2222222 100644\n"
+            "GIT binary patch\n"
+            "literal 3\n"
+            "abc\n"
+        )
+        rules = IgnoreRules.from_lines(["*.png"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        # Without ---/+++ headers there is no path evidence; the section
+        # must be kept rather than silently dropped.
+        assert "GIT binary patch" in filtered
+        assert skipped == []
+
+    def test_mode_change_section_is_filtered_by_header_path(self):
+        diff = (
+            "diff --git upstream-template-old/run.sh upstream-template-new/run.sh\n"
+            "old mode 100644\n"
+            "new mode 100755\n"
+            "--- upstream-template-old/run.sh\n"
+            "+++ upstream-template-new/run.sh\n"
+        )
+        rules = IgnoreRules.from_lines(["*.sh"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        assert filtered == ""
+        assert skipped == ["run.sh"]
+
+    def test_mixed_diff_keeps_only_managed(self):
+        diff = (
+            "diff --git upstream-template-old/skip.txt upstream-template-new/skip.txt\n"
+            "--- upstream-template-old/skip.txt\n"
+            "+++ upstream-template-new/skip.txt\n"
+            "@@ -1 +1 @@\n-a\n+b\n"
+            "diff --git upstream-template-old/keep.txt upstream-template-new/keep.txt\n"
+            "--- upstream-template-old/keep.txt\n"
+            "+++ upstream-template-new/keep.txt\n"
+            "@@ -1 +1 @@\n-c\n+d\n"
+            "diff --git upstream-template-old/skip2.log upstream-template-new/skip2.log\n"
+            "--- upstream-template-old/skip2.log\n"
+            "+++ upstream-template-new/skip2.log\n"
+            "@@ -1 +1 @@\n-e\n+f\n"
+        )
+        rules = IgnoreRules.from_lines(["skip.txt", "*.log"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        assert skipped == ["skip.txt", "skip2.log"]
+        assert "keep.txt" in filtered
+        assert "skip.txt" not in filtered
+        assert "skip2.log" not in filtered
+
+    def test_git_style_prefixes_are_recognized(self):
+        diff = (
+            "diff --git a/src/app.py b/src/app.py\n"
+            "index 1111111..2222222 100644\n"
+            "--- a/src/app.py\n"
+            "+++ b/src/app.py\n"
+            "@@ -1 +1 @@\n-old\n+new\n"
+        )
+        rules = IgnoreRules.from_lines(["src/"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        assert filtered == ""
+        assert skipped == ["src/app.py"]
+
+    def test_skipped_paths_are_sorted_and_unique(self):
+        diff = (
+            "diff --git upstream-template-old/b.log upstream-template-new/b.log\n"
+            "--- upstream-template-old/b.log\n"
+            "+++ upstream-template-new/b.log\n"
+            "@@ -1 +1 @@\n-a\n+b\n"
+            "diff --git upstream-template-old/a.log upstream-template-new/a.log\n"
+            "--- upstream-template-old/a.log\n"
+            "+++ upstream-template-new/a.log\n"
+            "@@ -1 +1 @@\n-a\n+b\n"
+        )
+        rules = IgnoreRules.from_lines(["*.log"])
+        _, skipped = _ignore.filter_diff(diff, rules)
+        assert skipped == ["a.log", "b.log"]
