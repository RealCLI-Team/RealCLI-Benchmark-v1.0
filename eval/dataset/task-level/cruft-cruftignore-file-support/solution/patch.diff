@@ -0,0 +1,361 @@
+"""Support for ``.cruftignore`` files.
+
+A template author may place a ``.cruftignore`` file at the root of the
+generated project (that is, inside the template's top-level directory, so
+that it is rendered like any other template file).  The file declares,
+using ``.gitignore`` style patterns, which project paths cruft must leave
+untouched when propagating template changes:
+
+* ``cruft update`` never creates, modifies or deletes an ignored path.
+  The file on disk always wins, no ``*.rej`` files are produced for
+  ignored paths and no data the user put there is ever overwritten.
+* ``cruft diff`` never reports differences for ignored paths and they do
+  not influence the ``--exit-code`` outcome.
+* ``cruft create`` and ``cruft check`` are not affected; ``create``
+  renders every template file, including ``.cruftignore`` itself.
+
+The rules that apply are always taken from the template rendering being
+compared (for ``update`` the rendering of the new template version, for
+``diff`` the rendering of the checked out template version).  If that
+rendering does not contain a ``.cruftignore`` file, nothing is ignored.
+The ``.cruftignore`` file itself is never ignored and follows the normal
+update rules, so template authors can evolve the rule set over time.
+
+Pattern syntax follows ``.gitignore`` conventions:
+
+* Blank lines and lines starting with ``#`` are ignored.
+* A leading ``!`` negates the pattern (re-includes the path); a literal
+  ``!`` or ``#`` at the start can be escaped with a backslash.
+* A trailing ``/`` makes the pattern match directories only.
+* A pattern containing a ``/`` (other than the trailing one) is anchored
+  to the project root; a leading ``/`` is allowed but not required.
+  A pattern without a ``/`` matches the basename at any depth.
+* ``*`` matches any run of characters except ``/``, ``?`` matches a
+  single character except ``/``, ``[...]`` is a character class and
+  ``**`` matches across directory boundaries.
+* When several patterns match, the last one in the file wins.
+* If a directory is excluded, everything below it stays excluded; it is
+  not possible to re-include a file inside an excluded directory.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+from typing import Iterable, List, Optional, Sequence, Set, Tuple
+
+CRUFTIGNORE_FILENAME = ".cruftignore"
+
+# Prefixes used by cruft's own diff machinery (see
+# ``cruft._commands.utils.diff``) plus the conventional git prefixes, so
+# that ``filter_diff`` can cope with both.
+_DIFF_PREFIXES = ("upstream-template-old/", "upstream-template-new/", "a/", "b/")
+
+
+def _translate_glob(pattern: str) -> str:
+    """Translate the body of a gitignore pattern into a regex string.
+
+    The translation follows gitignore wildcard rules: ``*`` and ``?``
+    never cross a ``/`` boundary, character classes are passed through
+    (with ``!`` rewritten to ``^``) and ``**`` crosses directories.
+    """
+    i = 0
+    n = len(pattern)
+    parts: List[str] = []
+    while i < n:
+        char = pattern[i]
+        if pattern[i : i + 2] == "**":
+            if pattern[i : i + 3] == "**/":
+                # Leading or middle "**/" matches zero or more whole
+                # directories ("**/x" == "x" at any depth, "a/**/b"
+                # matches "a/b" as well as "a/c/d/b").
+                parts.append("(?:.*/)?")
+                i += 3
+            elif i + 2 == n:
+                # Trailing "**" matches everything that follows.
+                parts.append(".*")
+                i += 2
+            else:
+                # A "**" that is neither followed by "/" nor trailing is
+                # not special in gitignore; treat it as a plain "*".
+                parts.append("[^/]*")
+                i += 2
+        elif char == "*":
+            parts.append("[^/]*")
+            i += 1
+        elif char == "?":
+            parts.append("[^/]")
+            i += 1
+        elif char == "[":
+            j = i + 1
+            if j < n and pattern[j] in "!^":
+                j += 1
+            if j < n and pattern[j] == "]":
+                j += 1
+            while j < n and pattern[j] != "]":
+                j += 1
+            if j >= n:
+                # Unterminated class: a literal "[".
+                parts.append(r"\[")
+                i += 1
+            else:
+                inner = pattern[i + 1 : j]
+                if inner.startswith("!"):
+                    inner = "^" + inner[1:]
+                inner = inner.replace("\\", "\\\\")
+                parts.append("[" + inner + "]")
+                i = j + 1
+        else:
+            parts.append(re.escape(char))
+            i += 1
+    return "".join(parts)
+
+
+@dataclass
+class IgnoreRule:
+    """A single parsed ``.cruftignore`` line."""
+
+    pattern: str
+    regex: "re.Pattern[str]"
+    negated: bool
+    dir_only: bool
+    anchored: bool
+
+    def matches(self, path: str, is_dir: bool) -> bool:
+        """Whether this rule matches ``path`` (project relative, POSIX)."""
+        if self.dir_only and not is_dir:
+            return False
+        return bool(self.regex.match(path))
+
+
+def _parse_line(line: str) -> Optional[IgnoreRule]:
+    """Parse one ``.cruftignore`` line, returning ``None`` if it is void."""
+    # Trailing whitespace is not significant (escaped trailing spaces are
+    # an obscure corner we deliberately do not support).
+    line = line.rstrip()
+    if not line or line.startswith("#"):
+        return None
+    negated = False
+    if line.startswith("!"):
+        negated = True
+        line = line[1:]
+    elif line.startswith("\\!") or line.startswith("\\#"):
+        line = line[1:]
+    dir_only = line.endswith("/")
+    if dir_only:
+        line = line[:-1]
+    # A pattern containing a slash (besides a trailing one) is anchored
+    # to the project root; a leading slash only makes that explicit.
+    anchored = "/" in line
+    line = line.lstrip("/")
+    if not line:
+        return None
+    body = _translate_glob(line)
+    if anchored:
+        regex = re.compile("^" + body + "$")
+    else:
+        # No slash: match the basename at any depth.
+        regex = re.compile("(?:^|.*/)" + body + "$")
+    return IgnoreRule(
+        pattern=line, regex=regex, negated=negated, dir_only=dir_only, anchored=anchored
+    )
+
+
+class IgnoreRules:
+    """An ordered set of ``.cruftignore`` rules with gitignore semantics."""
+
+    def __init__(self, rules: Sequence[IgnoreRule]):
+        self.rules: List[IgnoreRule] = list(rules)
+
+    def __bool__(self) -> bool:
+        return bool(self.rules)
+
+    def __len__(self) -> int:
+        return len(self.rules)
+
+    @classmethod
+    def from_lines(cls, lines: Iterable[str]) -> "IgnoreRules":
+        """Build a rule set from the lines of a ``.cruftignore`` file."""
+        parsed = []
+        for line in lines:
+            rule = _parse_line(line)
+            if rule is not None:
+                parsed.append(rule)
+        return cls(parsed)
+
+    @classmethod
+    def from_file(cls, path: Path) -> "IgnoreRules":
+        """Build a rule set from a file; an absent file means no rules."""
+        if not path.is_file():
+            return cls([])
+        return cls.from_lines(path.read_text(encoding="utf-8").splitlines())
+
+    @classmethod
+    def from_render(cls, render_dir: Path) -> "IgnoreRules":
+        """Load the rules shipped by a template rendering, if any."""
+        return cls.from_file(Path(render_dir) / CRUFTIGNORE_FILENAME)
+
+    def _status(self, path: str, is_dir: bool) -> Optional[bool]:
+        """Resolve the ignore status of a single path.
+
+        Returns ``True`` (ignored), ``False`` (explicitly re-included) or
+        ``None`` (no rule matched).  The last matching rule wins.
+        """
+        status: Optional[bool] = None
+        for rule in self.rules:
+            if rule.matches(path, is_dir):
+                status = not rule.negated
+        return status
+
+    def match(self, path: "os.PathLike[str] | str", is_dir: bool = False) -> bool:
+        """Whether ``path`` (relative to the project root) is ignored.
+
+        Every ancestor directory is considered as well: as in gitignore,
+        a path below an excluded directory is excluded and cannot be
+        re-included by a later negation.  The ``.cruftignore`` file at
+        the project root itself is never ignored.
+        """
+        parts = [part for part in PurePosixPath(str(path).replace(os.sep, "/")).parts if part != "/"]
+        if not parts:
+            return False
+        if parts == [CRUFTIGNORE_FILENAME]:
+            return False
+        for depth in range(1, len(parts) + 1):
+            candidate = "/".join(parts[:depth])
+            candidate_is_dir = depth < len(parts) or is_dir
+            status = self._status(candidate, candidate_is_dir)
+            if status and depth < len(parts):
+                # An excluded directory excludes its whole subtree.
+                return True
+            if depth == len(parts):
+                return bool(status)
+        return False
+
+
+def _relative_paths(root: Path) -> Set[str]:
+    """All files below ``root`` as POSIX paths relative to ``root``."""
+    found = set()
+    for dirpath, _dirnames, filenames in os.walk(root):
+        for filename in filenames:
+            full = Path(dirpath) / filename
+            found.add(full.relative_to(root).as_posix())
+    return found
+
+
+def remove_ignored(root: Path, rules: IgnoreRules) -> Set[str]:
+    """Delete every ignored path from the tree at ``root``.
+
+    Returns the set of removed file paths, relative to ``root``.  Used to
+    strip ignored paths from template renderings before they are
+    diffed, so ignored paths never show up in computed changesets.
+    """
+    removed: Set[str] = set()
+    if not rules:
+        return removed
+    for dirpath, dirnames, filenames in os.walk(root, topdown=True):
+        dir_path = Path(dirpath)
+        kept_dirs = []
+        for dirname in dirnames:
+            relative = (dir_path / dirname).relative_to(root).as_posix()
+            if rules.match(relative, is_dir=True):
+                removed.add(relative)
+                # Prune the whole subtree from the walk.
+                for sub in _relative_paths(dir_path / dirname):
+                    removed.add(f"{relative}/{sub}")
+                shutil.rmtree(dir_path / dirname)
+            else:
+                kept_dirs.append(dirname)
+        dirnames[:] = kept_dirs
+        for filename in filenames:
+            full = dir_path / filename
+            relative = full.relative_to(root).as_posix()
+            if rules.match(relative):
+                full.unlink()
+                removed.add(relative)
+    return removed
+
+
+def ignored_changed_paths(old_dir: Path, new_dir: Path, rules: IgnoreRules) -> List[str]:
+    """Ignored paths whose rendering would change between two trees.
+
+    A path counts as changed when it exists in only one of the trees or
+    when its content differs.  The result is sorted for stable output.
+    """
+    if not rules:
+        return []
+    old_paths = _relative_paths(old_dir)
+    new_paths = _relative_paths(new_dir)
+    changed = []
+    for relative in sorted(old_paths | new_paths):
+        if not rules.match(relative):
+            continue
+        old_file = old_dir / relative
+        new_file = new_dir / relative
+        if not old_file.is_file() or not new_file.is_file():
+            changed.append(relative)
+        elif old_file.read_bytes() != new_file.read_bytes():
+            changed.append(relative)
+    return changed
+
+
+def split_diff_sections(diff_text: str) -> List[str]:
+    """Split a unified diff into a preamble plus per-file sections."""
+    sections: List[str] = []
+    current: List[str] = []
+    for line in diff_text.splitlines(keepends=True):
+        if line.startswith("diff --git ") and current:
+            sections.append("".join(current))
+            current = []
+        current.append(line)
+    if current:
+        sections.append("".join(current))
+    return sections
+
+
+def _strip_diff_prefix(path: str) -> Optional[str]:
+    """Normalize a ``---``/``+++`` diff path to a project relative path."""
+    if path == "/dev/null":
+        return None
+    for prefix in _DIFF_PREFIXES:
+        if path.startswith(prefix):
+            return path[len(prefix) :]
+    return path
+
+
+def _section_paths(section: str) -> Tuple[Optional[str], Optional[str]]:
+    """Extract the (old, new) project relative paths of a diff section."""
+    old_path: Optional[str] = None
+    new_path: Optional[str] = None
+    for line in section.splitlines():
+        if line.startswith("--- "):
+            old_path = _strip_diff_prefix(line[4:].strip())
+        elif line.startswith("+++ "):
+            new_path = _strip_diff_prefix(line[4:].strip())
+    return old_path, new_path
+
+
+def filter_diff(diff_text: str, rules: IgnoreRules) -> Tuple[str, List[str]]:
+    """Drop every per-file section of ``diff_text`` that touches only
+    ignored paths.
+
+    Returns the filtered diff together with the sorted list of project
+    relative paths whose sections were dropped.  Sections are dropped
+    only when *all* of their paths are ignored, so a change moving
+    content from an ignored path to a managed one is still applied.  A
+    rule set without rules (or a missing ``.cruftignore``) is a no-op.
+    """
+    if not rules:
+        return diff_text, []
+    kept: List[str] = []
+    skipped: List[str] = []
+    for section in split_diff_sections(diff_text):
+        old_path, new_path = _section_paths(section)
+        paths = [path for path in (old_path, new_path) if path]
+        if paths and all(rules.match(path) for path in paths):
+            skipped.append(new_path or old_path or "")
+        else:
+            kept.append(section)
+    return "".join(kept), sorted(set(skipped))
