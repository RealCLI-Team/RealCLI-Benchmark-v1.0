+        (project / "config.ini").write_text("[app]\nname = demo\n# mine\n")
+        (project / "notes.txt").write_text("user notes\n")
+
+        assert cruft.diff(project, exit_code=True) is False
+
+    def test_diff_output_remains_a_usable_patch(self, template_and_project, capsys):
+        template, project = template_and_project
+        (project / "config.ini").write_text("[app]\nname = demo\n# mine\n")
+        (project / "notes.txt").write_text("user notes\n")
+
+        assert cruft.diff(project) is True
+        out = capsys.readouterr().out
+        # Every file section header must reference a managed path only.
+        for line in out.splitlines():
+            if line.startswith(("--- ", "+++ ", "diff --git")):
+                assert "config.ini" not in line
+                assert "settings" not in line
