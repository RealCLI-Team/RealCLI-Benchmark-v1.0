+"""Edge case tests for the ``.cruftignore`` feature.
+
+These complement ``tests/test_ignore.py`` with pattern engine corner
+cases, diff filtering of unusual patch sections and integration
+scenarios around repeated updates, alternate template layouts and
+binary files.  Everything runs against locally constructed git
+repositories, fully offline.
+"""
+
+import json
+import os
+import subprocess
+from pathlib import Path
+from typing import Dict, Optional
+
+import pytest
+
+import cruft
+from cruft import _ignore
+from cruft._ignore import IgnoreRules
+
+GIT_ENV = {
+    "GIT_AUTHOR_NAME": "cruft-test",
+    "GIT_AUTHOR_EMAIL": "cruft-test@example.com",
+    "GIT_COMMITTER_NAME": "cruft-test",
+    "GIT_COMMITTER_EMAIL": "cruft-test@example.com",
+    "GIT_CONFIG_NOSYSTEM": "1",
+    "HOME": os.environ.get("HOME", "/tmp"),
+}
+
+
+def _git(args, cwd):
+    env = dict(os.environ)
+    env.update(GIT_ENV)
+    subprocess.run(["git"] + list(args), cwd=str(cwd), env=env, check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _commit_all(repo_dir: Path, message: str):
+    _git(["add", "-A"], repo_dir)
+    _git(["commit", "-qm", message, "--no-gpg-sign"], repo_dir)
+
+
+def make_template(
+    root: Path,
+    files: Dict[str, str],
+    context: Optional[dict] = None,
+    message: str = "template commit",
+    inner_dir: str = "{{cookiecutter.project_slug}}",
+) -> Path:
+    """Create (or extend) a local git cookiecutter template at ``root``."""
+    root = Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+    template_dir = root / inner_dir
+    if not (root / "cookiecutter.json").exists():
+        (root / "cookiecutter.json").write_text(
+            json.dumps(context or {"project_slug": "demo", "author": "Alice"})
+        )
+        _git(["init", "-q", "-b", "main"], root)
+    for relative, content in files.items():
+        path = template_dir / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(content)
+    _commit_all(root, message)
+    return root
+
+
+def make_binary_template_file(path: Path, payload: bytes):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(payload)
+
+
+def head_commit(repo_dir: Path) -> str:
+    env = dict(os.environ)
+    env.update(GIT_ENV)
+    out = subprocess.run(
+        ["git", "rev-parse", "HEAD"], cwd=str(repo_dir), env=env, check=True,
+        stdout=subprocess.PIPE,
+    )
+    return out.stdout.decode().strip()
+
+
+def create_project(template_dir: Path, output_dir: Path, **kwargs) -> Path:
+    return Path(cruft.create(str(template_dir), Path(output_dir), no_input=True, **kwargs))
+
+
+def read_cruft_state(project_dir: Path) -> dict:
+    return json.loads((Path(project_dir) / ".cruft.json").read_text())
+
+
+BASE_V1 = {
+    "README.md": "# {{cookiecutter.project_slug}}\nby {{cookiecutter.author}}\n",
+    "config.ini": "[app]\nname = {{cookiecutter.project_slug}}\n",
+    "notes.txt": "first version\n",
+}
+
