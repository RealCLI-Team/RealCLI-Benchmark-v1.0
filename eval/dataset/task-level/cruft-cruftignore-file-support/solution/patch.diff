+class TestTreeOperations:
+    def test_remove_ignored_returns_posix_paths(self, tmp_path):
+        root = tmp_path / "tree"
+        (root / "sub" / "deep").mkdir(parents=True)
+        (root / "sub" / "deep" / "x.log").write_text("x")
+        rules = IgnoreRules.from_lines(["*.log"])
+        removed = _ignore.remove_ignored(root, rules)
+        assert removed == {"sub/deep/x.log"}
+
+    def test_remove_ignored_keeps_negated(self, tmp_path):
+        root = tmp_path / "tree"
+        (root / "logs").mkdir(parents=True)
+        (root / "logs" / "a.log").write_text("a")
+        (root / "logs" / "keep.log").write_text("keep")
+        rules = IgnoreRules.from_lines(["*.log", "!keep.log"])
+        removed = _ignore.remove_ignored(root, rules)
+        assert removed == {"logs/a.log"}
+        assert (root / "logs" / "keep.log").read_text() == "keep"
+
+    def test_ignored_changed_paths_binary_content(self, tmp_path):
+        old = tmp_path / "old"
+        new = tmp_path / "new"
+        old.mkdir()
+        new.mkdir()
+        (old / "blob.bin").write_bytes(b"\x00\x01\x02")
+        (new / "blob.bin").write_bytes(b"\x00\x01\x03")
+        rules = IgnoreRules.from_lines(["*.bin"])
+        assert _ignore.ignored_changed_paths(old, new, rules) == ["blob.bin"]
+        (new / "blob.bin").write_bytes(b"\x00\x01\x02")
+        assert _ignore.ignored_changed_paths(old, new, rules) == []
+
+    def test_ignored_changed_paths_empty_rules(self, tmp_path):
+        old = tmp_path / "old"
+        new = tmp_path / "new"
+        old.mkdir()
+        new.mkdir()
+        (old / "a.txt").write_text("1")
+        (new / "a.txt").write_text("2")
+        assert _ignore.ignored_changed_paths(old, new, IgnoreRules.from_lines([])) == []
+
+    def test_ignored_changed_paths_only_in_one_tree(self, tmp_path):
+        old = tmp_path / "old"
+        new = tmp_path / "new"
+        old.mkdir()
+        new.mkdir()
+        (new / "fresh.log").write_text("new")
