+class TestFilterDiff:
+    SAMPLE_DIFF = (
+        "diff --git upstream-template-old/a.log upstream-template-new/a.log\n"
+        "index 1111111..2222222 100644\n"
+        "--- upstream-template-old/a.log\n"
+        "+++ upstream-template-new/a.log\n"
+        "@@ -1 +1 @@\n"
+        "-old\n"
+        "+new\n"
+        "diff --git upstream-template-old/README.md upstream-template-new/README.md\n"
+        "index 3333333..4444444 100644\n"
+        "--- upstream-template-old/README.md\n"
+        "+++ upstream-template-new/README.md\n"
+        "@@ -1 +1 @@\n"
+        "-old readme\n"
+        "+new readme\n"
+    )
+
+    def test_drops_sections_for_ignored_paths(self):
+        rules = IgnoreRules.from_lines(["*.log"])
+        filtered, skipped = _ignore.filter_diff(self.SAMPLE_DIFF, rules)
+        assert skipped == ["a.log"]
+        assert "a.log" not in filtered
+        assert "README.md" in filtered
+
+    def test_no_rules_is_a_noop(self):
+        rules = IgnoreRules.from_lines([])
+        filtered, skipped = _ignore.filter_diff(self.SAMPLE_DIFF, rules)
+        assert filtered == self.SAMPLE_DIFF
+        assert skipped == []
+
+    def test_new_file_section_uses_plus_path(self):
+        diff = (
+            "diff --git upstream-template-old/added.log upstream-template-new/added.log\n"
+            "new file mode 100644\n"
+            "index 0000000..1111111\n"
+            "--- /dev/null\n"
+            "+++ upstream-template-new/added.log\n"
+            "@@ -0,0 +1 @@\n"
+            "+brand new\n"
+        )
+        rules = IgnoreRules.from_lines(["*.log"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        assert filtered == ""
+        assert skipped == ["added.log"]
+
+    def test_deleted_file_section_uses_minus_path(self):
+        diff = (
+            "diff --git upstream-template-old/gone.log upstream-template-new/gone.log\n"
+            "deleted file mode 100644\n"
+            "index 1111111..0000000\n"
+            "--- upstream-template-old/gone.log\n"
+            "+++ /dev/null\n"
+            "@@ -1 +0,0 @@\n"
+            "-bye\n"
+        )
+        rules = IgnoreRules.from_lines(["*.log"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        assert filtered == ""
+        assert skipped == ["gone.log"]
+
+    def test_section_with_mixed_paths_is_kept(self):
+        # A change moving content from an ignored path to a managed path
+        # must still be applied.
+        diff = (
+            "diff --git upstream-template-old/a.log upstream-template-new/README.md\n"
+            "similarity index 90%\n"
+            "rename from upstream-template-old/a.log\n"
+            "rename to upstream-template-new/README.md\n"
+            "--- upstream-template-old/a.log\n"
+            "+++ upstream-template-new/README.md\n"
+            "@@ -1 +1 @@\n"
+            "-old\n"
+            "+new\n"
+        )
+        rules = IgnoreRules.from_lines(["*.log"])
+        filtered, skipped = _ignore.filter_diff(diff, rules)
+        assert "README.md" in filtered
+        assert skipped == []
+
+    def test_split_diff_sections(self):
+        sections = _ignore.split_diff_sections(self.SAMPLE_DIFF)
+        assert len(sections) == 2
+        assert sections[0].startswith("diff --git")
+        assert "a.log" in sections[0]
+        assert "README.md" in sections[1]
