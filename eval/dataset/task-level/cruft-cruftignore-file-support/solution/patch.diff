+class TestPatternPrecedence:
+    def test_anchored_and_basename_patterns_both_apply(self, tmp_path):
+        files = dict(BASE_V1)
+        files[".cruftignore"] = "seed.txt\n/data/seed.txt\n!data/seed.txt\n"
+        files["seed.txt"] = "root v1\n"
+        files["data/seed.txt"] = "data v1\n"
+        template = make_template(tmp_path / "template", files, message="v1")
+        project = create_project(template, tmp_path / "output")
+        make_template(
+            template,
+            {"seed.txt": "root v2\n", "data/seed.txt": "data v2\n",
+             "notes.txt": "second\n"},
+            message="v2",
+        )
+
+        assert cruft.update(project, skip_apply_ask=True) is True
+        # Root seed.txt is ignored (basename rule), data/seed.txt was
+        # re-included by the trailing negation and got updated.
+        assert (project / "seed.txt").read_text() == "root v1\n"
+        assert (project / "data" / "seed.txt").read_text() == "data v2\n"
+        assert (project / "notes.txt").read_text() == "second\n"
+
+    def test_directory_rule_vs_nested_negation_on_update(self, tmp_path):
+        files = dict(BASE_V1)
+        files[".cruftignore"] = "gen/\n"
+        files["gen/a.py"] = "a v1\n"
+        template = make_template(tmp_path / "template", files, message="v1")
+        project = create_project(template, tmp_path / "output")
+        make_template(
+            template,
+            {"gen/a.py": "a v2\n", "gen/b.py": "b v2\n", "notes.txt": "second\n"},
+            message="v2",
+        )
+
+        assert cruft.update(project, skip_apply_ask=True) is True
+        assert (project / "gen" / "a.py").read_text() == "a v1\n"
+        assert not (project / "gen" / "b.py").exists()
+        assert (project / "notes.txt").read_text() == "second\n"
