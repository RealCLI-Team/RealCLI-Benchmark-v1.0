+class TestRepeatedUpdates:
+    def test_two_consecutive_updates_keep_ignored_files(self, tmp_path):
+        files = dict(BASE_V1)
+        files[".cruftignore"] = "config.ini\n"
+        template = make_template(tmp_path / "template", files, message="v1")
+        project = create_project(template, tmp_path / "output")
+        (project / "config.ini").write_text("[app]\nname = demo\n# mine\n")
+
+        make_template(
+            template,
+            {"config.ini": "[app]\nname = {{cookiecutter.project_slug}}\nv2\n",
+             "notes.txt": "second version\n"},
+            message="v2",
+        )
+        assert cruft.update(project, skip_apply_ask=True) is True
+        assert (project / "config.ini").read_text() == "[app]\nname = demo\n# mine\n"
+        assert (project / "notes.txt").read_text() == "second version\n"
+
+        make_template(
+            template,
+            {"config.ini": "[app]\nname = {{cookiecutter.project_slug}}\nv3\n",
+             "notes.txt": "third version\n"},
+            message="v3",
+        )
+        assert cruft.update(project, skip_apply_ask=True) is True
+        assert (project / "config.ini").read_text() == "[app]\nname = demo\n# mine\n"
+        assert (project / "notes.txt").read_text() == "third version\n"
+        assert read_cruft_state(project)["commit"] == head_commit(template)
+
+    def test_update_is_stable_when_run_again(self, tmp_path):
+        files = dict(BASE_V1)
+        files[".cruftignore"] = "config.ini\n"
+        template = make_template(tmp_path / "template", files, message="v1")
+        project = create_project(template, tmp_path / "output")
+        (project / "config.ini").write_text("[app]\nname = demo\n# mine\n")
+        make_template(
+            template, {"config.ini": "[app]\nname = {{cookiecutter.project_slug}}\nv2\n"},
+            message="v2",
+        )
+        assert cruft.update(project, skip_apply_ask=True) is True
+        snapshot = {
+            p.relative_to(project).as_posix(): p.read_bytes()
+            for p in sorted(project.rglob("*"))
+            if p.is_file()
+        }
+        # A second update is a no-op that must not touch anything.
+        assert cruft.update(project, skip_apply_ask=True) is True
+        snapshot2 = {
+            p.relative_to(project).as_posix(): p.read_bytes()
+            for p in sorted(project.rglob("*"))
+            if p.is_file()
+        }
+        assert snapshot == snapshot2
+
