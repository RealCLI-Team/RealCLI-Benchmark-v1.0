+############################################################
+# Pattern engine corner cases                              #
+############################################################
+
+
+class TestPatternEngineCornerCases:
+    def test_dotfile_patterns(self):
+        rules = IgnoreRules.from_lines([".*"])
+        assert rules.match(".env")
+        assert rules.match("config/.env")
+        assert not rules.match(".cruftignore")
+        assert not rules.match("visible.txt")
+
+    def test_pattern_matching_directory_and_file_alike(self):
+        # Without a trailing slash a pattern matches files *and* dirs.
+        rules = IgnoreRules.from_lines(["target"])
+        assert rules.match("target", is_dir=True)
+        assert rules.match("target", is_dir=False)
+        assert rules.match("a/target/out.bin")
+
+    def test_multiple_slashes_anchor_at_root(self):
+        rules = IgnoreRules.from_lines(["a/b/c.txt"])
+        assert rules.match("a/b/c.txt")
+        assert not rules.match("x/a/b/c.txt")
+        assert not rules.match("a/b/d.txt")
+
+    def test_star_star_between_segments(self):
+        rules = IgnoreRules.from_lines(["a/**/b/**/c.txt"])
+        assert rules.match("a/b/c.txt")
+        assert rules.match("a/x/b/y/c.txt")
+        assert rules.match("a/x/y/b/z/w/c.txt")
+        assert not rules.match("a/x/c.txt")
+
+    def test_class_with_range_and_literal(self):
+        rules = IgnoreRules.from_lines(["log[0-9][ab].txt"])
+        assert rules.match("log3a.txt")
+        assert rules.match("log9b.txt")
+        assert not rules.match("log3c.txt")
+        assert not rules.match("log30a.txt")
+
+    def test_unterminated_class_is_literal_bracket(self):
+        rules = IgnoreRules.from_lines(["weird[.txt"])
+        assert rules.match("weird[.txt")
+        assert not rules.match("weirdx.txt")
+
+    def test_escaped_negation_and_hash(self):
+        rules = IgnoreRules.from_lines([r"\!important.txt", r"\#hash.txt"])
+        assert rules.match("!important.txt")
+        assert rules.match("#hash.txt")
+        assert not rules.match("important.txt")
+
+    def test_negation_without_match_has_no_effect(self):
+        rules = IgnoreRules.from_lines(["!nothing.txt"])
+        assert not rules.match("nothing.txt")
+        assert not rules.match("other.txt")
+
+    def test_double_negation_chain(self):
+        rules = IgnoreRules.from_lines(
+            ["*.log", "!keep.log", "keep.log", "!keep.log"]
+        )
+        assert not rules.match("keep.log")
+        assert rules.match("error.log")
+
+    def test_rooted_negation(self):
+        rules = IgnoreRules.from_lines(["*.md", "!/README.md"])
+        assert not rules.match("README.md")
+        assert rules.match("docs/README.md")
+        assert rules.match("guide.md")
+
+    def test_directory_pattern_with_negated_child_still_excluded(self):
+        rules = IgnoreRules.from_lines(["logs/", "!logs/today.log"])
+        assert rules.match("logs/today.log")
+        assert rules.match("logs", is_dir=True)
+
+    def test_globstar_alone_matches_everything_below(self):
+        rules = IgnoreRules.from_lines(["data/**"])
+        assert rules.match("data/x")
+        assert rules.match("data/x/y/z")
+        assert not rules.match("data", is_dir=True)
+
+    def test_paths_with_spaces(self):
+        rules = IgnoreRules.from_lines(["my folder/", "with space.txt"])
+        assert rules.match("my folder/a.txt")
+        assert rules.match("with space.txt")
+        assert rules.match("deep/with space.txt")
+
+    def test_deeply_nested_basename_match(self):
+        rules = IgnoreRules.from_lines(["Thumbs.db"])
+        assert rules.match("a/b/c/d/e/f/Thumbs.db")
+        assert not rules.match("a/b/c/d/e/f/Thumbs.db.bak")
+
+    def test_leading_slash_on_directory_pattern(self):
+        rules = IgnoreRules.from_lines(["/cache/"])
+        assert rules.match("cache/x.bin")
+        assert not rules.match("src/cache/x.bin")
+
+    def test_match_empty_path_is_false(self):
+        rules = IgnoreRules.from_lines(["*", "**"])
+        assert not rules.match("")
+        assert not rules.match("/")
+
+    def test_rules_are_ordered(self):
+        rules = IgnoreRules.from_lines(["b.txt", "a.txt", "c.txt"])
+        assert [r.pattern for r in rules.rules] == ["b.txt", "a.txt", "c.txt"]
+
+    def test_crlf_lines_are_tolerated(self):
+        rules = IgnoreRules.from_lines(["*.log\r", "!keep.log\r"])
+        assert rules.match("x.log")
+        assert not rules.match("keep.log")
+
+    def test_only_slash_pattern_is_void(self):
+        rules = IgnoreRules.from_lines(["/"])
+        assert len(rules) == 0
+
+    def test_dir_only_pattern_does_not_match_file(self):
+        rules = IgnoreRules.from_lines(["node_modules/"])
+        assert not rules.match("node_modules", is_dir=False)
+        assert rules.match("node_modules", is_dir=True)
+
+    def test_repr_of_empty_and_nonempty(self):
+        empty = IgnoreRules.from_lines([])
+        full = IgnoreRules.from_lines(["x"])
+        assert bool(empty) is False
+        assert bool(full) is True
+        assert len(full) == 1
+
