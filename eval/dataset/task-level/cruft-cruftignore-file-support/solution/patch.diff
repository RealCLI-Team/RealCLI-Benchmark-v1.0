+    def test_diff_output_is_applyable_patch(self, tmp_path):
+        import shutil
+        import subprocess as sp
+
+        files = dict(BASE_V1)
+        files[".cruftignore"] = "config.ini\n"
+        template = make_template(tmp_path / "template", files, message="v1")
+        project = create_project(template, tmp_path / "output")
+        (project / "notes.txt").write_text("user notes\n")
+        (project / "config.ini").write_text("[app]\nname = demo\n# mine\n")
+
+        # Capture the diff in patch form (non-TTY output is sanitized).
+        from typer.testing import CliRunner
+
+        from cruft._cli import app
+
+        runner = CliRunner()
+        result = runner.invoke(app, ["diff", "--project-dir", str(project)])
+        assert result.exit_code == 0
+        patch_text = result.stdout
+        assert "notes.txt" in patch_text
+        assert "config.ini" not in patch_text
+
+        # The emitted patch applies cleanly on top of a fresh copy of the
+        # project and reproduces the template rendering for managed files.
+        replica = tmp_path / "replica"
+        shutil.copytree(project, replica)
+        normalized = patch_text.replace("upstream-template-old/", "").replace(
+            "upstream-template-new/", ""
+        )
+        apply_proc = sp.run(
+            ["git", "apply", "-p0"],
+            input=normalized.encode(),
+            cwd=str(replica),
+            stdout=sp.PIPE,
+            stderr=sp.PIPE,
+        )
+        assert apply_proc.returncode == 0, apply_proc.stderr.decode()
+        assert (replica / "notes.txt").read_text() == "first version\n"
