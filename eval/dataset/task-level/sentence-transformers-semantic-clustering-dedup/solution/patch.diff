+    def test_homogeneity_completeness_average_matches_v_measure(self):
+        labels_true = [0, 0, 0, 1, 1, 1, 2, 2, 2, 2]
+        labels_pred = [0, 0, 1, 1, 1, 2, 2, 2, 3, 3]
+        h = homogeneity_score(labels_true, labels_pred)
+        c = completeness_score(labels_true, labels_pred)
