+from __future__ import annotations
+
+import csv
+import os
+
+import numpy as np
+import pytest
+
+from sentence_transformers.sentence_transformer.evaluation import ClusteringEvaluator
+
+
+class StubModel:
+    """A minimal stand-in for SentenceTransformer: returns fixed embeddings."""
+
+    def __init__(self, embeddings):
+        self.embeddings = np.asarray(embeddings, dtype=np.float64)
+        self.encode_calls = []
+
+    def encode(self, sentences, batch_size=32, show_progress_bar=False, convert_to_numpy=True, **kwargs):
+        self.encode_calls.append(
+            {
+                "sentences": list(sentences),
+                "batch_size": batch_size,
+                "show_progress_bar": show_progress_bar,
+                "convert_to_numpy": convert_to_numpy,
+            }
+        )
+        return self.embeddings[: len(sentences)]
+
+    class _ModelCardData:
+        def set_evaluation_metrics(self, evaluator, metrics, epoch, step):
+            pass
+
+    model_card_data = _ModelCardData()
+
+
+# Two tight groups along orthogonal directions: labels match the groups exactly
+SENTENCES = ["a1", "a2", "a3", "b1", "b2", "b3"]
+LABELS = ["fruit", "fruit", "fruit", "animal", "animal", "animal"]
+EMBEDDINGS = [
+    [1.0, 0.0],
+    [1.0, 0.05],
+    [0.95, 0.0],
+    [0.0, 1.0],
+    [0.05, 1.0],
+    [0.0, 0.95],
+]
+# Same sentences, but the embeddings of "a3" and "b3" are swapped: the clustering
+# no longer matches the labels perfectly
+MIXED_EMBEDDINGS = [
+    [1.0, 0.0],
+    [1.0, 0.05],
+    [0.0, 0.95],
+    [0.0, 1.0],
+    [0.05, 1.0],
+    [0.95, 0.0],
+]
+
+
