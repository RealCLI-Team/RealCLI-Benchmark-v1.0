+
+def adjusted_rand_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the adjusted Rand index (ARI) between gold labels and a clustering, following
+    ``sklearn.metrics.adjusted_rand_score``. The ARI is corrected-for-chance: random partitions score
+    close to 0 and identical partitions score 1.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The ARI in ``[-1, 1]``.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    total = table.sum()
+
+    def comb2(values: np.ndarray) -> float:
+        return float((values * (values - 1) / 2.0).sum())
+
+    sum_cells = comb2(table.ravel())
+    sum_rows = comb2(table.sum(axis=1))
+    sum_cols = comb2(table.sum(axis=0))
+    total_pairs = total * (total - 1) / 2.0
+
+    if total_pairs == 0:
+        return 1.0
+
+    expected = sum_rows * sum_cols / total_pairs
+    maximum = (sum_rows + sum_cols) / 2.0
+    denominator = maximum - expected
+    if denominator == 0:
+        return 1.0 if sum_cells == maximum else 0.0
+    return float((sum_cells - expected) / denominator)
+
+
+def cluster_accuracy_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the clustering accuracy: the fraction of samples correctly assigned after matching every
+    predicted cluster to at most one gold label with an optimal (Hungarian) assignment.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The accuracy in ``[0, 1]``.
+    """
+    from scipy.optimize import linear_sum_assignment
+
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    row_ind, col_ind = linear_sum_assignment(-table)
+    correct = table[row_ind, col_ind].sum()
+    return float(correct / table.sum())
+
+
+def homogeneity_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the homogeneity of a clustering: every predicted cluster should contain only members of a
+    single gold class. Follows ``sklearn.metrics.homogeneity_score``.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The homogeneity in ``[0, 1]``.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    total = table.sum()
+    entropy_true = _entropy(table.sum(axis=1), total)
+    if entropy_true == 0.0:
+        return 1.0
+
+    col_totals = table.sum(axis=0)
+    h_true_given_pred = 0.0
+    for row in range(table.shape[0]):
+        for col in range(table.shape[1]):
+            count = table[row, col]
+            if count == 0:
+                continue
+            h_true_given_pred -= count / total * math.log(count / col_totals[col])
+    return float(1.0 - h_true_given_pred / entropy_true)
+
+
+def completeness_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the completeness of a clustering: all members of a gold class should be assigned to the
+    same predicted cluster. Follows ``sklearn.metrics.completeness_score``.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The completeness in ``[0, 1]``.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    total = table.sum()
+    entropy_pred = _entropy(table.sum(axis=0), total)
+    if entropy_pred == 0.0:
+        return 1.0
+
+    row_totals = table.sum(axis=1)
+    h_pred_given_true = 0.0
+    for row in range(table.shape[0]):
+        for col in range(table.shape[1]):
+            count = table[row, col]
+            if count == 0:
+                continue
+            h_pred_given_true -= count / total * math.log(count / row_totals[row])
+    return float(1.0 - h_pred_given_true / entropy_pred)
