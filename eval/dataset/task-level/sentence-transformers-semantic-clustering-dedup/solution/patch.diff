+
+def fowlkes_mallows_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the Fowlkes-Mallows index between gold labels and a clustering: the geometric mean of the
+    pairwise precision and recall over sample pairs. Follows
+    ``sklearn.metrics.fowlkes_mallows_score``.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The Fowlkes-Mallows index in ``[0, 1]``.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+
+    def comb2(values: np.ndarray) -> float:
+        return float((values * (values - 1) / 2.0).sum())
+
+    tp = comb2(table.ravel())
+    tp_plus_fn = comb2(table.sum(axis=1))  # pairs in the same gold class
+    tp_plus_fp = comb2(table.sum(axis=0))  # pairs in the same predicted cluster
+    if tp_plus_fn == 0.0 or tp_plus_fp == 0.0:
+        return 0.0
+    return float(tp / math.sqrt(tp_plus_fn * tp_plus_fp))
+
+
+def purity_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the purity of a clustering: for every predicted cluster, count the members of its
+    majority gold class, then divide by the total number of samples.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The purity in ``[0, 1]``.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    return float(table.max(axis=0).sum() / table.sum())
+
+
+def select_representatives(
+    embeddings: ArrayLike,
+    clustering: ClusteringResult,
+    top_k: int = 1,
+) -> dict[int, list[int]]:
+    """
+    Select the ``top_k`` most representative members of every cluster: the members closest to the
+    cluster centroid (the arithmetic mean of the cluster's embeddings) in Euclidean distance. Ties
+    are broken by the lowest input index, so the output is deterministic.
+
+    Args:
+        embeddings: The 2D matrix of embeddings that was clustered.
+        clustering (ClusteringResult): A clustering of those embeddings.
+        top_k (int, optional): How many representatives to select per cluster. Must be at least 1;
+            selecting more representatives than a cluster has members returns the whole cluster.
+
+    Returns:
+        Dict[int, List[int]]: Maps every cluster id to the indices of its representatives, ordered
+        by increasing distance to the centroid.
+
+    Raises:
+        ValueError: If ``top_k`` is smaller than 1 or the number of labels does not match the number
+            of embeddings.
+
+    Example:
+        ::
+
+            from sentence_transformers.util import kmeans_clustering, select_representatives
+
+            clustering = kmeans_clustering(embeddings, num_clusters=10)
+            representatives = select_representatives(embeddings, clustering, top_k=3)
+            for cluster_id, indices in representatives.items():
+                print(cluster_id, [corpus[i] for i in indices])
+    """
+    if top_k < 1:
+        raise ValueError(f"top_k must be at least 1, got {top_k}")
+    matrix = _to_float64_tensor(embeddings)
+    if matrix.shape[0] != len(clustering.labels):
+        raise ValueError(
+            f"Got {matrix.shape[0]} embeddings but {len(clustering.labels)} cluster labels"
+        )
+
+    representatives: dict[int, list[int]] = {}
+    for cluster_id, indices in clustering.clusters.items():
+        members = matrix[indices]
+        centroid = members.mean(dim=0, keepdim=True)
+        distances = (members - centroid).norm(dim=1)
+        order = sorted(range(len(indices)), key=lambda pos: (float(distances[pos]), indices[pos]))
+        selected = [indices[pos] for pos in order[:top_k]]
+        representatives[cluster_id] = selected
+    return representatives
