+    def test_cosine_metric_on_directions(self):
+        # Points on three rays; cosine clustering groups by direction, not magnitude
+        embeddings = [
+            [1.0, 0.0],
+            [2.0, 0.0],
+            [0.5, 0.0],
+            [0.0, 1.0],
+            [0.0, 3.0],
+        ]
+        result = agglomerative_clustering(embeddings, num_clusters=2, metric="cosine")
+        assert as_partition(result) == {frozenset({0, 1, 2}), frozenset({3, 4})}
