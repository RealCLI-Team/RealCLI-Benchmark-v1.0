+"""Semantic clustering and deduplication utilities.
+
+This module groups the embedding-based clustering helpers of Sentence Transformers:
+
+- :func:`kmeans_clustering` and :func:`agglomerative_clustering` partition a set of embeddings into
+  clusters. Both are fully deterministic: identical inputs always produce identical clusters.
+- :func:`semantic_deduplication` finds (near-)duplicate embeddings via a cosine-similarity
+  threshold and transitive grouping.
+- :func:`select_representatives` extracts the most typical members of every cluster.
+- The metric functions (:func:`v_measure_score`, :func:`homogeneity_score`,
+  :func:`completeness_score`, :func:`normalized_mutual_info_score`, :func:`adjusted_rand_score`,
+  :func:`fowlkes_mallows_score`, :func:`purity_score`, :func:`cluster_accuracy_score`) score a
+  clustering against gold labels.
+
+All functions accept embeddings as a 2D torch tensor, numpy array, or nested Python lists, and all
+results follow the conventions of :class:`ClusteringResult` and :class:`DeduplicationResult`.
+"""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any, Literal
+
+import numpy as np
+import torch
+
+__all__ = [
+    "ClusteringResult",
+    "CommunityDetectionResult",
+    "DeduplicationResult",
+    "kmeans_clustering",
+    "agglomerative_clustering",
+    "semantic_deduplication",
+    "v_measure_score",
+    "normalized_mutual_info_score",
+    "adjusted_rand_score",
+    "cluster_accuracy_score",
+    "homogeneity_score",
+    "completeness_score",
+    "fowlkes_mallows_score",
+    "purity_score",
+    "select_representatives",
+]
+
+ArrayLike = Any
+
+
+def _to_float64_tensor(embeddings: ArrayLike) -> torch.Tensor:
+    """Convert torch/numpy/list embeddings to a 2D float64 CPU tensor."""
+    if isinstance(embeddings, torch.Tensor):
+        tensor = embeddings.detach().to(dtype=torch.float64, device="cpu")
+    elif isinstance(embeddings, np.ndarray):
+        tensor = torch.from_numpy(np.asarray(embeddings)).to(dtype=torch.float64)
+    else:
+        tensor = torch.tensor(np.asarray(embeddings), dtype=torch.float64)
+    if tensor.ndim == 1:
+        tensor = tensor.unsqueeze(0)
+    if tensor.ndim != 2:
+        raise ValueError(f"Embeddings must be a 2D matrix, got shape {tuple(tensor.shape)}")
+    return tensor
+
+
+@dataclass
+class ClusteringResult:
+    """
+    The result of a clustering run over a set of embeddings.
+
+    Attributes:
+        labels (List[int]): The cluster id of every input embedding, in input order. Cluster ids are
+            contiguous integers starting at 0 and are ordered by the smallest member index of each
+            cluster, i.e. the cluster that contains index 0 is always cluster 0, the cluster with the
+            next-smallest first member is cluster 1, and so on.
+    """
+
+    labels: list[int]
+
+    @property
+    def num_clusters(self) -> int:
+        """The number of distinct clusters."""
+        return len(set(self.labels)) if self.labels else 0
+
+    @property
+    def clusters(self) -> dict[int, list[int]]:
+        """A mapping from cluster id to the sorted list of member indices."""
+        clusters: dict[int, list[int]] = {}
+        for idx, label in enumerate(self.labels):
+            clusters.setdefault(label, []).append(idx)
+        return clusters
+
+    @property
+    def cluster_sizes(self) -> dict[int, int]:
+        """A mapping from cluster id to the number of members in that cluster."""
+        return {cluster_id: len(indices) for cluster_id, indices in self.clusters.items()}
+
+    def cluster_indices(self, cluster_id: int) -> list[int]:
+        """Return the sorted member indices of one cluster. Raises KeyError for unknown ids."""
+        return self.clusters[cluster_id]
+
+    def largest_clusters(self, n: int = 10) -> list[tuple[int, list[int]]]:
+        """
+        Return the ``n`` largest clusters as ``(cluster_id, member_indices)`` tuples, ordered by
+        descending size. Ties are broken by ascending cluster id.
+        """
+        clusters = sorted(self.clusters.items(), key=lambda item: (-len(item[1]), item[0]))
+        return clusters[:n]
+
+    def smallest_clusters(self, n: int = 10) -> list[tuple[int, list[int]]]:
+        """
+        Return the ``n`` smallest clusters as ``(cluster_id, member_indices)`` tuples, ordered by
+        ascending size. Ties are broken by ascending cluster id.
+        """
+        clusters = sorted(self.clusters.items(), key=lambda item: (len(item[1]), item[0]))
+        return clusters[:n]
+
+    def partition_equals(self, other: "ClusteringResult") -> bool:
+        """
+        Check whether two results describe the same partition of the inputs, ignoring the concrete
+        cluster ids. Two clusterings are equal if they group exactly the same indices together.
+        """
+        if len(self.labels) != len(other.labels):
+            return False
+        mapping: dict[int, int] = {}
+        used: set[int] = set()
+        for a, b in zip(self.labels, other.labels):
+            if a in mapping:
+                if mapping[a] != b:
+                    return False
+            else:
+                if b in used:
+                    return False
+                mapping[a] = b
+                used.add(b)
+        return True
+
+    def __len__(self) -> int:
+        return len(self.labels)
+
+
+@dataclass
+class CommunityDetectionResult:
+    """
+    Structured result of :func:`~sentence_transformers.util.community_detection`.
+
+    ``community_detection`` traditionally returns a ``list[list[int]]`` where each inner list is a
+    community whose first element is the central point. When called with ``return_result=True`` it
+    returns an instance of this class instead, exposing the same information via named attributes so
+    downstream code does not have to remember the list-of-lists convention.
+
+    Attributes:
+        communities (List[List[int]]): The communities in the same shape and order as the legacy
+            list-of-lists return: descending community size, ties broken by ascending central index.
+            Each inner list has the central point as its first element followed by the remaining
+            members ordered by decreasing similarity to the central point (ties broken by ascending
+            index).
+        central_indices (List[int]): ``[community[0] for community in communities]``, extracted for
+            convenience. Same length as ``communities``.
+        unclustered_indices (List[int]): Sorted list of embedding indices that ended up in no
+            community. This includes all-zero embeddings, embeddings without enough neighbors, and
+            embeddings that lost to a larger overlapping community. Never overlaps with any
+            community.
+        num_embeddings (int): The total number of input embeddings the result was computed from.
+    """
+
+    communities: list[list[int]]
+    central_indices: list[int]
+    unclustered_indices: list[int]
+    num_embeddings: int
+
+    @property
+    def num_communities(self) -> int:
+        """Number of detected communities."""
+        return len(self.communities)
+
+    @property
+    def sizes(self) -> list[int]:
+        """Sizes of the detected communities, in the same order as :attr:`communities`."""
+        return [len(community) for community in self.communities]
+
+    @property
+    def labels(self) -> list[int]:
+        """
+        Per-embedding community id: ``labels[i]`` is the index of the community containing
+        embedding ``i``, or ``-1`` if the embedding is in :attr:`unclustered_indices`.
+
+        Community ids are contiguous integers starting at 0 in the same order as
+        :attr:`communities` (i.e. by decreasing community size, ties broken by ascending central
+        index). This numbering scheme is intentionally different from
+        :class:`ClusteringResult`'s "first-member-index" numbering because community detection is
+        primarily size-driven, and reordering by first-member would obscure the "largest first"
+        semantic.
+        """
+        labels = [-1] * self.num_embeddings
+        for community_id, members in enumerate(self.communities):
+            for member in members:
+                labels[member] = community_id
+        return labels
+
+    def as_clustering_result(self) -> "ClusteringResult":
+        """
+        Convert this community-detection result into a
+        :class:`~sentence_transformers.util.clustering.ClusteringResult`, so it can be fed to
+        :func:`select_representatives` or any of the metric helpers.
+
+        Unclustered indices are collected into their own cluster after all detected communities;
+        that cluster gets the id ``num_communities`` (i.e. one past the highest community id). If
+        every embedding was clustered the "unclustered" bucket is omitted and the result is a
+        proper k-way partition of ``range(num_embeddings)``.
+        """
+        labels = [-1] * self.num_embeddings
+        for community_id, members in enumerate(self.communities):
+            for member in members:
+                labels[member] = community_id
+        if self.unclustered_indices:
+            outlier_label = self.num_communities
+            for idx in self.unclustered_indices:
+                labels[idx] = outlier_label
+        # If any label is still -1 (should not happen given the invariants), promote it to outliers.
+        outlier_label = self.num_communities
+        for idx, label in enumerate(labels):
+            if label == -1:
+                labels[idx] = outlier_label
+        return ClusteringResult(labels=labels)
+
+
+@dataclass
+class DeduplicationResult:
+    """
+    The result of :func:`semantic_deduplication`.
+
+    Attributes:
+        keep_indices (List[int]): Sorted indices of the embeddings to keep: exactly one representative
+            per duplicate group (the lowest index of the group) plus all singletons.
+        remove_indices (List[int]): Sorted indices of the embeddings that are duplicates of an earlier
+            embedding and should be dropped.
+        duplicate_of (Dict[int, int]): Maps every removed index to the kept representative it is a
+            duplicate of.
+        groups (List[List[int]]): All duplicate groups of size >= 2. Each group is sorted ascending and
+            starts with the kept representative; groups are ordered by their representative index.
+    """
+
+    keep_indices: list[int]
+    remove_indices: list[int]
+    duplicate_of: dict[int, int]
+    groups: list[list[int]] = field(default_factory=list)
+
+    @property
+    def num_duplicates(self) -> int:
+        """The number of embeddings flagged as duplicates."""
+        return len(self.remove_indices)
+
+    @property
+    def num_kept(self) -> int:
+        """The number of embeddings kept after deduplication."""
+        return len(self.keep_indices)
+
+    def apply(self, items: Sequence) -> list:
+        """
+        Apply the deduplication to any sequence aligned with the embeddings (e.g. the original
+        sentences) and return the items that are kept, in their original order.
+        """
+        return [items[idx] for idx in self.keep_indices]
+
+
+def _normalize_rows(matrix: torch.Tensor) -> torch.Tensor:
+    """L2-normalize the rows of a matrix; zero rows stay zero."""
+    norms = matrix.norm(dim=1, keepdim=True)
+    return torch.where(norms > 0, matrix / norms.clamp_min(1e-300), matrix)
+
+
+def _pairwise_cosine_similarity(matrix: torch.Tensor) -> torch.Tensor:
+    normalized = _normalize_rows(matrix)
+    sim = normalized @ normalized.T
+    return sim.clamp(-1.0, 1.0)
+
+
+def _pairwise_distance(matrix: torch.Tensor, metric: str) -> torch.Tensor:
+    if metric == "cosine":
+        return 1.0 - _pairwise_cosine_similarity(matrix)
+    if metric == "euclidean":
+        sq_norms = (matrix * matrix).sum(dim=1)
+        dist_sq = sq_norms.unsqueeze(1) + sq_norms.unsqueeze(0) - 2.0 * (matrix @ matrix.T)
+        return dist_sq.clamp_min(0.0).sqrt()
+    raise ValueError(f"Unsupported metric {metric!r}; expected 'cosine' or 'euclidean'")
+
+
+def _relabel_by_first_member(labels: Sequence[int]) -> list[int]:
+    """Relabel cluster ids so they are 0..k-1 ordered by the smallest member index of each cluster."""
+    first_member: dict[int, int] = {}
+    for idx, label in enumerate(labels):
+        if label not in first_member:
+            first_member[label] = idx
+    ordered = sorted(first_member, key=lambda label: first_member[label])
+    remap = {label: new_id for new_id, label in enumerate(ordered)}
+    return [remap[label] for label in labels]
+
+
+def kmeans_clustering(
+    embeddings: ArrayLike,
+    num_clusters: int,
+    seed: int = 22,
+    max_iter: int = 100,
+    tol: float = 1e-6,
+) -> ClusteringResult:
+    """
+    Cluster embeddings with a deterministic k-means that uses k-means++ initialization seeded by
+    ``seed``. Identical inputs and parameters always produce identical outputs, independent of the
+    number of CPU threads.
+
+    The algorithm minimizes the within-cluster sum of squared Euclidean distances. For normalized
+    embeddings this is (up to a monotone transformation) equivalent to maximizing within-cluster
+    cosine similarity.
+
+    Args:
+        embeddings: A 2D matrix of embeddings (torch tensor, numpy array, or nested lists).
+        num_clusters (int): The number of clusters ``k``. Must satisfy ``1 <= k <= n_embeddings``.
+        seed (int, optional): Seed for the k-means++ initialization. Defaults to 22.
+        max_iter (int, optional): Maximum number of Lloyd iterations. Defaults to 100.
+        tol (float, optional): Convergence tolerance on the largest centroid shift between two
+            iterations. Defaults to 1e-6.
+
+    Returns:
+        ClusteringResult: The clustering result; ``result.labels[i]`` is the cluster id of
+        ``embeddings[i]``.
+
+    Raises:
+        ValueError: If ``num_clusters`` is not in ``[1, n_embeddings]``.
+
+    Example:
+        ::
+
+            from sentence_transformers import SentenceTransformer
+            from sentence_transformers.util import kmeans_clustering
+
+            model = SentenceTransformer("all-MiniLM-L6-v2")
+            embeddings = model.encode(corpus)
+            result = kmeans_clustering(embeddings, num_clusters=5)
+            for cluster_id, indices in result.largest_clusters(3):
+                print(cluster_id, [corpus[i] for i in indices])
+    """
+    matrix = _to_float64_tensor(embeddings)
+    n_embeddings = matrix.shape[0]
+    if not isinstance(num_clusters, int) or isinstance(num_clusters, bool):
+        raise ValueError(f"num_clusters must be an int, got {type(num_clusters).__name__}")
+    if num_clusters < 1 or num_clusters > n_embeddings:
+        raise ValueError(
+            f"num_clusters must be between 1 and the number of embeddings ({n_embeddings}), got {num_clusters}"
+        )
+
+    if num_clusters == n_embeddings:
+        return ClusteringResult(labels=list(range(n_embeddings)))
+    if num_clusters == 1:
+        return ClusteringResult(labels=[0] * n_embeddings)
+
+    generator = torch.Generator().manual_seed(seed)
+
+    # k-means++ initialization
+    center_indices = [int(torch.randint(n_embeddings, (1,), generator=generator).item())]
+    min_dist_sq = ((matrix - matrix[center_indices[0]]) ** 2).sum(dim=1)
+    for _ in range(1, num_clusters):
+        total = float(min_dist_sq.sum())
+        if total <= 0:
+            # All remaining points coincide with chosen centers: pick uniformly at random
+            next_index = int(torch.randint(n_embeddings, (1,), generator=generator).item())
+        else:
+            probs = min_dist_sq / total
+            next_index = int(torch.multinomial(probs, 1, generator=generator).item())
+        center_indices.append(next_index)
+        dist_sq = ((matrix - matrix[next_index]) ** 2).sum(dim=1)
+        min_dist_sq = torch.minimum(min_dist_sq, dist_sq)
+
+    centers = matrix[center_indices].clone()
+
+    labels = torch.zeros(n_embeddings, dtype=torch.long)
+    for _ in range(max_iter):
+        distances = torch.cdist(matrix, centers)  # (n, k), deterministic on CPU
+        new_labels = distances.argmin(dim=1)  # torch.argmin breaks ties by lowest index
+
+        new_centers = centers.clone()
+        for cluster_id in range(num_clusters):
+            members = new_labels == cluster_id
+            if members.any():
+                new_centers[cluster_id] = matrix[members].mean(dim=0)
+            else:
+                # Reinitialize an empty cluster at the point that is currently worst explained
+                worst_index = int(
+                    distances.gather(1, new_labels.unsqueeze(1)).squeeze(1).argmax().item()
+                )
+                new_centers[cluster_id] = matrix[worst_index]
+
+        shift = (new_centers - centers).norm(dim=1).max()
+        centers = new_centers
+        labels = new_labels
+        if shift < tol:
+            break
+
+    return ClusteringResult(labels=_relabel_by_first_member(labels.tolist()))
+
+
+def agglomerative_clustering(
+    embeddings: ArrayLike,
+    num_clusters: int | None = None,
+    threshold: float | None = None,
+    linkage: Literal["single", "complete", "average"] = "average",
+    metric: Literal["cosine", "euclidean"] = "cosine",
+) -> ClusteringResult:
+    """
+    Cluster embeddings with deterministic (bottom-up) agglomerative hierarchical clustering.
+
+    Every embedding starts as its own cluster; the two closest clusters are merged greedily until
+    either exactly ``num_clusters`` clusters remain or the closest pair of clusters is farther apart
+    than ``threshold``. When several pairs are equally close, the pair with the lowest cluster indices
+    is merged first, so the output is fully deterministic.
+
+    Args:
+        embeddings: A 2D matrix of embeddings (torch tensor, numpy array, or nested lists).
+        num_clusters (Optional[int]): Stop when this many clusters remain. Exactly one of
+            ``num_clusters`` and ``threshold`` must be given.
+        threshold (Optional[float]): Stop when the smallest distance between two clusters exceeds this
+            value. For ``metric="cosine"`` this is a cosine *distance* (``1 - cosine_similarity``), so
+            e.g. ``threshold=0.25`` merges clusters down to a cosine similarity of 0.75.
+        linkage (str): How the distance between two clusters is computed from the pairwise distances
+            of their members: ``"single"`` (minimum), ``"complete"`` (maximum), or ``"average"``
+            (mean). Defaults to ``"average"``.
+        metric (str): The pairwise distance metric: ``"cosine"`` or ``"euclidean"``. Defaults to
+            ``"cosine"``.
+
+    Returns:
+        ClusteringResult: The clustering result; ``result.labels[i]`` is the cluster id of
+        ``embeddings[i]``.
+
+    Raises:
+        ValueError: If both or neither of ``num_clusters`` and ``threshold`` are given, if
+            ``num_clusters`` is out of range, if ``threshold`` is negative, or if ``linkage`` or
+            ``metric`` are unsupported.
+
+    Example:
+        ::
+
+            from sentence_transformers.util import agglomerative_clustering
+
+            result = agglomerative_clustering(embeddings, threshold=0.3, linkage="average")
+            print(result.num_clusters, result.cluster_sizes)
+    """
+    if (num_clusters is None) == (threshold is None):
+        raise ValueError("Exactly one of num_clusters and threshold must be provided")
+    if linkage not in ("single", "complete", "average"):
+        raise ValueError(f"Unsupported linkage {linkage!r}; expected 'single', 'complete', or 'average'")
+    if metric not in ("cosine", "euclidean"):
+        raise ValueError(f"Unsupported metric {metric!r}; expected 'cosine' or 'euclidean'")
+
+    matrix = _to_float64_tensor(embeddings)
+    n_embeddings = matrix.shape[0]
+
+    if num_clusters is not None:
+        if not isinstance(num_clusters, int) or isinstance(num_clusters, bool):
+            raise ValueError(f"num_clusters must be an int, got {type(num_clusters).__name__}")
+        if num_clusters < 1 or num_clusters > n_embeddings:
+            raise ValueError(
+                f"num_clusters must be between 1 and the number of embeddings ({n_embeddings}), got {num_clusters}"
+            )
+    if threshold is not None and threshold < 0:
+        raise ValueError(f"threshold must be non-negative, got {threshold}")
+
+    point_dist = _pairwise_distance(matrix, metric).numpy()
+
+    # clusters[cluster_idx] = sorted list of member point indices
+    clusters: list[list[int]] = [[i] for i in range(n_embeddings)]
+    # dist[i, j] = current distance between cluster i and cluster j (i != j)
+    dist = point_dist.copy()
+
+    def cluster_distance(members_a: list[int], members_b: list[int]) -> float:
+        pairwise = point_dist[np.ix_(members_a, members_b)]
+        if linkage == "single":
+            return float(pairwise.min())
+        if linkage == "complete":
+            return float(pairwise.max())
+        return float(pairwise.mean())
+
+    while len(clusters) > 1:
+        if num_clusters is not None and len(clusters) <= num_clusters:
+            break
+
+        n_clusters = len(clusters)
+        # Find the closest pair; ties are broken by lowest (i, j) in row-major order
+        best_pair: tuple[int, int] | None = None
+        best_value = math.inf
+        for i in range(n_clusters):
+            for j in range(i + 1, n_clusters):
+                value = dist[i, j]
+                if value < best_value - 1e-15:
+                    best_value = value
+                    best_pair = (i, j)
+        if best_pair is None:
+            break
+        if threshold is not None and best_value > threshold:
+            break
+
+        i, j = best_pair
+        clusters[i] = sorted(clusters[i] + clusters[j])
+        del clusters[j]
+
+        # Recompute distances from the merged cluster to all remaining clusters
+        dist = np.delete(np.delete(dist, j, axis=0), j, axis=1)
+        for other in range(len(clusters)):
+            if other == i:
+                continue
+            value = cluster_distance(clusters[i], clusters[other])
+            dist[i, other] = value
+            dist[other, i] = value
+
+    labels = [0] * n_embeddings
+    for cluster_id, members in enumerate(clusters):
+        for member in members:
+            labels[member] = cluster_id
+    return ClusteringResult(labels=_relabel_by_first_member(labels))
+
+
+def semantic_deduplication(
+    embeddings: ArrayLike,
+    threshold: float = 0.9,
+) -> DeduplicationResult:
+    """
+    Find semantically (near-)duplicate embeddings: two embeddings are considered duplicates when
+    their cosine similarity is greater than or equal to ``threshold``.
+
+    Duplicates are resolved transitively (union-find): if A matches B and B matches C, all three form
+    one duplicate group even if A and C are below the threshold. From every group the embedding with
+    the lowest input index is kept as the representative; all other members are flagged for removal.
+
+    Args:
+        embeddings: A 2D matrix of embeddings (torch tensor, numpy array, or nested lists).
+        threshold (float, optional): Cosine similarity threshold in ``[-1, 1]`` above which two
+            embeddings count as duplicates. Defaults to 0.9.
+
+    Returns:
+        DeduplicationResult: The kept/removed indices, the duplicate mapping, and the duplicate
+        groups. Use ``result.apply(sentences)`` to directly deduplicate an aligned sequence.
+
+    Raises:
+        ValueError: If ``threshold`` is not in ``[-1, 1]``.
+
+    Example:
+        ::
+
+            from sentence_transformers.util import semantic_deduplication
+
+            result = semantic_deduplication(embeddings, threshold=0.85)
+            unique_sentences = result.apply(sentences)
+            for removed, kept in result.duplicate_of.items():
+                print(f"{sentences[removed]!r} duplicates {sentences[kept]!r}")
+    """
+    if threshold < -1.0 or threshold > 1.0:
+        raise ValueError(f"threshold must be in [-1, 1], got {threshold}")
+
+    matrix = _to_float64_tensor(embeddings)
+    n_embeddings = matrix.shape[0]
+    if n_embeddings == 0:
+        return DeduplicationResult(keep_indices=[], remove_indices=[], duplicate_of={}, groups=[])
+
+    sim = _pairwise_cosine_similarity(matrix).numpy()
+
+    parent = list(range(n_embeddings))
+
+    def find(x: int) -> int:
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+
+    def union(a: int, b: int) -> None:
+        ra, rb = find(a), find(b)
+        if ra == rb:
+            return
+        # Attach the larger root under the smaller one: representative = lowest index
+        if ra < rb:
+            parent[rb] = ra
+        else:
+            parent[ra] = rb
+
+    for i in range(n_embeddings):
+        row = sim[i]
+        for j in range(i + 1, n_embeddings):
+            if row[j] >= threshold:
+                union(i, j)
+
+    components: dict[int, list[int]] = {}
+    for idx in range(n_embeddings):
+        components.setdefault(find(idx), []).append(idx)
+
+    keep_indices: list[int] = []
+    remove_indices: list[int] = []
+    duplicate_of: dict[int, int] = {}
+    groups: list[list[int]] = []
+    for root in sorted(components):
+        members = sorted(components[root])
+        representative = members[0]
+        keep_indices.append(representative)
+        if len(members) >= 2:
+            groups.append(members)
+        for member in members[1:]:
+            remove_indices.append(member)
+            duplicate_of[member] = representative
+
+    return DeduplicationResult(
+        keep_indices=keep_indices,
+        remove_indices=sorted(remove_indices),
+        duplicate_of=duplicate_of,
+        groups=groups,
+    )
+
+
+def _contingency_table(labels_true: Sequence[int], labels_pred: Sequence[int]) -> np.ndarray:
+    """Build the contingency matrix: rows = true labels, columns = predicted clusters."""
+    true_ids = {label: idx for idx, label in enumerate(sorted(set(labels_true), key=repr))}
+    pred_ids = {label: idx for idx, label in enumerate(sorted(set(labels_pred), key=repr))}
+    table = np.zeros((len(true_ids), len(pred_ids)), dtype=np.int64)
+    for t, p in zip(labels_true, labels_pred):
+        table[true_ids[t], pred_ids[p]] += 1
+    return table
+
+
+def _entropy(counts: np.ndarray, total: float) -> float:
+    probs = counts[counts > 0] / total
+    return float(-(probs * np.log(probs)).sum())
+
+
+def v_measure_score(labels_true: Sequence[int], labels_pred: Sequence[int], beta: float = 1.0) -> float:
+    """
+    Compute the V-measure (harmonic mean of homogeneity and completeness) between gold labels and a
+    clustering, following the conventions of ``sklearn.metrics.v_measure_score``.
+
+    Homogeneity: every predicted cluster contains only members of a single gold class.
+    Completeness: all members of a gold class are assigned to the same predicted cluster.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+        beta (float, optional): Weight of homogeneity vs. completeness. Defaults to 1.0.
+
+    Returns:
+        float: The V-measure in ``[0, 1]``; 1.0 means the clustering matches the gold labels exactly.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+    if beta < 0:
+        raise ValueError(f"beta must be non-negative, got {beta}")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    total = table.sum()
+
+    entropy_true = _entropy(table.sum(axis=1), total)
+    entropy_pred = _entropy(table.sum(axis=0), total)
+
+    # Conditional entropies from the contingency table
+    row_totals = table.sum(axis=1)
+    col_totals = table.sum(axis=0)
+    h_true_given_pred = 0.0
+    h_pred_given_true = 0.0
+    for row in range(table.shape[0]):
+        for col in range(table.shape[1]):
+            count = table[row, col]
+            if count == 0:
+                continue
+            h_true_given_pred -= count / total * math.log(count / col_totals[col])
+            h_pred_given_true -= count / total * math.log(count / row_totals[row])
+
+    homogeneity = 1.0 if entropy_true == 0.0 else 1.0 - h_true_given_pred / entropy_true
+    completeness = 1.0 if entropy_pred == 0.0 else 1.0 - h_pred_given_true / entropy_pred
+
+    if homogeneity + completeness == 0.0:
+        return 0.0
+    return float((1 + beta) * homogeneity * completeness / (beta * homogeneity + completeness))
+
+
+def normalized_mutual_info_score(labels_true: Sequence[int], labels_pred: Sequence[int]) -> float:
+    """
+    Compute the normalized mutual information (NMI) between gold labels and a clustering using the
+    arithmetic mean of the two entropies as the normalizer, following
+    ``sklearn.metrics.normalized_mutual_info_score`` with ``average_method="arithmetic"``.
+
+    Args:
+        labels_true: The gold label of every sample.
+        labels_pred: The predicted cluster id of every sample.
+
+    Returns:
+        float: The NMI in ``[0, 1]``; 1.0 means the clustering matches the gold labels exactly.
+    """
+    labels_true = list(labels_true)
+    labels_pred = list(labels_pred)
+    if len(labels_true) != len(labels_pred):
+        raise ValueError("labels_true and labels_pred must have the same length")
+    if len(labels_true) == 0:
+        raise ValueError("labels must not be empty")
+
+    table = _contingency_table(labels_true, labels_pred).astype(np.float64)
+    total = table.sum()
+
+    entropy_true = _entropy(table.sum(axis=1), total)
+    entropy_pred = _entropy(table.sum(axis=0), total)
+
+    if entropy_true == 0.0 and entropy_pred == 0.0:
+        return 1.0
+
+    # Mutual information from the joint distribution
+    row_totals = table.sum(axis=1)
+    col_totals = table.sum(axis=0)
+    mutual_info = 0.0
+    for row in range(table.shape[0]):
+        for col in range(table.shape[1]):
+            count = table[row, col]
+            if count == 0:
+                continue
+            mutual_info += count / total * math.log(count * total / (row_totals[row] * col_totals[col]))
+
+    normalizer = (entropy_true + entropy_pred) / 2.0
+    if normalizer == 0.0:
+        return 1.0
+    return float(mutual_info / normalizer)
