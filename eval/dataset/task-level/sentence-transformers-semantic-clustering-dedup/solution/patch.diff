@@ -0,0 +1,203 @@
+from __future__ import annotations
+
+import csv
+import logging
+import os
+from typing import TYPE_CHECKING, Literal
+
+from sentence_transformers.base.evaluation.evaluator import BaseEvaluator
+from sentence_transformers.util.clustering import (
+    adjusted_rand_score,
+    agglomerative_clustering,
+    cluster_accuracy_score,
+    kmeans_clustering,
+    normalized_mutual_info_score,
+    v_measure_score,
+)
+
+if TYPE_CHECKING:
+    from sentence_transformers.sentence_transformer.model import SentenceTransformer
+
+logger = logging.getLogger(__name__)
+
+
+class ClusteringEvaluator(BaseEvaluator):
+    """
+    Evaluate a model by clustering the embeddings of ``sentences`` and comparing the clusters against
+    gold ``labels``.
+
+    The evaluator encodes the sentences with the model, clusters the embeddings with either
+    :func:`~sentence_transformers.util.kmeans_clustering` or
+    :func:`~sentence_transformers.util.agglomerative_clustering`, and reports four metrics:
+
+    - ``v_measure``: the V-measure (harmonic mean of homogeneity and completeness);
+    - ``adjusted_rand``: the adjusted Rand index;
+    - ``normalized_mutual_info``: the normalized mutual information (arithmetic average);
+    - ``accuracy``: the clustering accuracy under an optimal (Hungarian) cluster-to-label matching.
+
+    The returned score dictionary uses ``v_measure`` as the primary metric: it is exposed via
+    ``primary_metric`` (prefixed with ``name`` if one is given) and used for model selection.
+
+    Args:
+        sentences (List[str]): The sentences to cluster.
+        labels (List): The gold label of every sentence. Labels may be of any hashable type.
+        algorithm (str, optional): The clustering algorithm: ``"kmeans"`` or ``"agglomerative"``.
+            Defaults to ``"kmeans"``.
+        num_clusters (Optional[int], optional): The number of clusters. Defaults to the number of
+            distinct gold labels.
+        threshold (Optional[float], optional): Only for ``algorithm="agglomerative"``: stop merging
+            when the closest pair of clusters exceeds this cosine distance. Mutually exclusive with
+            ``num_clusters``.
+        linkage (str, optional): Only for ``algorithm="agglomerative"``: the cluster linkage
+            (``"single"``, ``"complete"``, or ``"average"``). Defaults to ``"average"``.
+        seed (int, optional): Only for ``algorithm="kmeans"``: the seed of the k-means++
+            initialization. Defaults to 22.
+        batch_size (int, optional): The batch size used for encoding. Defaults to 32.
+        name (str, optional): The name of the evaluator, used as prefix for the metrics and in the
+            CSV file name. Defaults to "".
+        show_progress_bar (bool, optional): Whether to show a progress bar during encoding.
+            Defaults to False.
+        write_csv (bool, optional): Whether to append the evaluation results to a CSV file in
+            ``output_path``. Defaults to True.
+
+    Example:
+        ::
+
+            from sentence_transformers import SentenceTransformer
+            from sentence_transformers.evaluation import ClusteringEvaluator
+
+            model = SentenceTransformer("all-MiniLM-L6-v2")
+            evaluator = ClusteringEvaluator(
+                sentences=["apple", "banana", "dog", "cat"],
+                labels=["fruit", "fruit", "animal", "animal"],
+                name="toy_dev",
+            )
+            results = evaluator(model)
+            print(evaluator.primary_metric)
+            # => "toy_dev_v_measure"
+            print(results[evaluator.primary_metric])
+            # => 1.0
+    """
+
+    def __init__(
+        self,
+        sentences: list[str],
+        labels: list,
+        algorithm: Literal["kmeans", "agglomerative"] = "kmeans",
+        num_clusters: int | None = None,
+        threshold: float | None = None,
+        linkage: Literal["single", "complete", "average"] = "average",
+        seed: int = 22,
+        batch_size: int = 32,
+        name: str = "",
+        show_progress_bar: bool = False,
+        write_csv: bool = True,
+    ):
+        super().__init__()
+        if len(sentences) != len(labels):
+            raise ValueError(
+                f"sentences and labels must have the same length, got {len(sentences)} and {len(labels)}"
+            )
+        if algorithm not in ("kmeans", "agglomerative"):
+            raise ValueError(f"Unsupported algorithm {algorithm!r}; expected 'kmeans' or 'agglomerative'")
+        if algorithm == "kmeans" and threshold is not None:
+            raise ValueError("threshold is only supported for algorithm='agglomerative'")
+
+        self.sentences = sentences
+        self.labels = list(labels)
+        self.algorithm = algorithm
+        self.num_clusters = num_clusters if num_clusters is not None else len(set(self.labels))
+        self.threshold = threshold
+        self.linkage = linkage
+        self.seed = seed
+        self.batch_size = batch_size
+        self.name = name
+        self.show_progress_bar = show_progress_bar
+        self.write_csv = write_csv
+
+        self.csv_file = "clustering_evaluation" + ("_" + name if name else "") + "_results.csv"
+        self.csv_headers = ["epoch", "steps", "v_measure", "adjusted_rand", "normalized_mutual_info", "accuracy"]
+        self.primary_metric = "v_measure"
+
+    @classmethod
+    def from_input_examples(cls, examples, **kwargs):
+        sentences = [example.texts[0] for example in examples]
+        labels = [example.label for example in examples]
+        return cls(sentences, labels, **kwargs)
+
+    def cluster_embeddings(self, embeddings):
+        """Cluster a matrix of embeddings according to the evaluator configuration."""
+        if self.algorithm == "kmeans":
+            return kmeans_clustering(embeddings, num_clusters=self.num_clusters, seed=self.seed)
+        return agglomerative_clustering(
+            embeddings,
+            num_clusters=self.num_clusters if self.threshold is None else None,
+            threshold=self.threshold,
+            linkage=self.linkage,
+        )
+
+    def __call__(
+        self, model: SentenceTransformer, output_path: str | None = None, epoch: int = -1, steps: int = -1
+    ) -> dict[str, float]:
+        if epoch != -1:
+            if steps == -1:
+                out_txt = f" after epoch {epoch}"
+            else:
+                out_txt = f" in epoch {epoch} after {steps} steps"
+        else:
+            out_txt = ""
+        logger.info(f"ClusteringEvaluator: Evaluating the model on the {self.name} dataset{out_txt}:")
+
+        embeddings = model.encode(
+            self.sentences,
+            batch_size=self.batch_size,
+            show_progress_bar=self.show_progress_bar,
+            convert_to_numpy=True,
+        )
+
+        clustering = self.cluster_embeddings(embeddings)
+        predicted = clustering.labels
+
+        metrics = {
+            "v_measure": v_measure_score(self.labels, predicted),
+            "adjusted_rand": adjusted_rand_score(self.labels, predicted),
+            "normalized_mutual_info": normalized_mutual_info_score(self.labels, predicted),
+            "accuracy": cluster_accuracy_score(self.labels, predicted),
+        }
+        logger.info(
+            "V-Measure: {:.4f}\tAdjusted Rand: {:.4f}\tNMI: {:.4f}\tAccuracy: {:.4f}".format(
+                metrics["v_measure"], metrics["adjusted_rand"], metrics["normalized_mutual_info"], metrics["accuracy"]
+            )
+        )
+
+        if output_path is not None and self.write_csv:
+            os.makedirs(output_path, exist_ok=True)
+            csv_path = os.path.join(output_path, self.csv_file)
+            output_file_exists = os.path.isfile(csv_path)
+            with open(csv_path, newline="", mode="a" if output_file_exists else "w", encoding="utf-8") as f:
+                writer = csv.writer(f)
+                if not output_file_exists:
+                    writer.writerow(self.csv_headers)
+                writer.writerow(
+                    [
+                        epoch,
+                        steps,
+                        metrics["v_measure"],
+                        metrics["adjusted_rand"],
+                        metrics["normalized_mutual_info"],
+                        metrics["accuracy"],
+                    ]
+                )
+
+        metrics = self.prefix_name_to_metrics(metrics, self.name)
+        self.store_metrics_in_model_card_data(model=model, metrics=metrics, epoch=epoch, step=steps)
+        return metrics
+
+    def get_config_dict(self) -> dict:
+        return {
+            "algorithm": self.algorithm,
+            "num_clusters": self.num_clusters,
+            "threshold": self.threshold,
+            "linkage": self.linkage,
+            "seed": self.seed,
+        }
