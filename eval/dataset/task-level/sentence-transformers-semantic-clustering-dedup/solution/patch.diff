+from __future__ import annotations
+
+import numpy as np
+import pytest
+import torch
+
+from sentence_transformers.util import (
+    ClusteringResult,
+    DeduplicationResult,
+    adjusted_rand_score,
+    agglomerative_clustering,
+    cluster_accuracy_score,
+    completeness_score,
+    fowlkes_mallows_score,
+    homogeneity_score,
+    kmeans_clustering,
+    normalized_mutual_info_score,
+    purity_score,
+    select_representatives,
+    semantic_deduplication,
+    v_measure_score,
+)
+
+# Three well-separated blobs of 2D points, 4 points each; separated under both
+# cosine and Euclidean distance (no zero vectors)
+BLOB_POINTS = [
+    [1.0, 0.0],
+    [1.0, 0.05],
+    [0.95, 0.0],
+    [0.95, 0.05],
+    [0.0, 1.0],
+    [0.05, 1.0],
+    [0.0, 0.95],
+    [0.05, 0.95],
+    [-1.0, 0.0],
+    [-1.0, 0.05],
+    [-0.95, 0.0],
+    [-0.95, 0.05],
+]
+BLOB_PARTITION = {frozenset({0, 1, 2, 3}), frozenset({4, 5, 6, 7}), frozenset({8, 9, 10, 11})}
+
+# 1D chain where single and complete linkage disagree
+CHAIN_POINTS = [[0.0], [0.9], [2.0], [2.9], [4.1]]
+
+
+def as_partition(result: ClusteringResult) -> set[frozenset[int]]:
+    return {frozenset(indices) for indices in result.clusters.values()}
+
+
+class TestKMeansClustering:
+    @pytest.mark.parametrize(
+        "embeddings",
+        [
+            BLOB_POINTS,
+            np.array(BLOB_POINTS),
+            torch.tensor(BLOB_POINTS),
+            torch.tensor(BLOB_POINTS, dtype=torch.float32),
+        ],
+    )
+    def test_recovers_blobs_for_all_input_types(self, embeddings):
+        result = kmeans_clustering(embeddings, num_clusters=3, seed=22)
+        assert as_partition(result) == BLOB_PARTITION
+
+    def test_is_deterministic(self):
+        first = kmeans_clustering(BLOB_POINTS, num_clusters=3, seed=7)
+        second = kmeans_clustering(BLOB_POINTS, num_clusters=3, seed=7)
+        assert first.labels == second.labels
+
+    def test_seed_changes_initialization_but_not_partition_on_easy_data(self):
+        for seed in (0, 1, 13, 99):
+            result = kmeans_clustering(BLOB_POINTS, num_clusters=3, seed=seed)
+            assert as_partition(result) == BLOB_PARTITION
+
+    def test_labels_are_ordered_by_first_member(self):
+        result = kmeans_clustering(BLOB_POINTS, num_clusters=3)
+        assert result.labels[0] == 0
+        # Cluster ids are contiguous 0..k-1
+        assert sorted(set(result.labels)) == [0, 1, 2]
+        # First occurrences appear in increasing cluster-id order
+        first_occurrence = {}
+        for idx, label in enumerate(result.labels):
+            first_occurrence.setdefault(label, idx)
+        assert [first_occurrence[label] for label in sorted(first_occurrence)] == sorted(
+            first_occurrence.values()
+        )
+
+    def test_num_clusters_equals_n_embeddings(self):
+        result = kmeans_clustering(BLOB_POINTS, num_clusters=len(BLOB_POINTS))
+        assert result.num_clusters == len(BLOB_POINTS)
+        assert result.labels == list(range(len(BLOB_POINTS)))
+
+    def test_num_clusters_one(self):
+        result = kmeans_clustering(BLOB_POINTS, num_clusters=1)
+        assert result.labels == [0] * len(BLOB_POINTS)
+
+    @pytest.mark.parametrize("num_clusters", [0, -1, len(BLOB_POINTS) + 1, 100])
+    def test_invalid_num_clusters_raises(self, num_clusters):
+        with pytest.raises(ValueError):
+            kmeans_clustering(BLOB_POINTS, num_clusters=num_clusters)
+
+    def test_non_integer_num_clusters_raises(self):
+        with pytest.raises(ValueError):
+            kmeans_clustering(BLOB_POINTS, num_clusters=2.5)
+
+    def test_cluster_sizes_sum_to_n(self):
+        result = kmeans_clustering(BLOB_POINTS, num_clusters=3)
+        assert sum(result.cluster_sizes.values()) == len(BLOB_POINTS)
+
+    def test_largest_and_smallest_clusters(self):
+        result = kmeans_clustering(BLOB_POINTS, num_clusters=3)
+        largest = result.largest_clusters(2)
+        assert len(largest) == 2
+        assert len(largest[0][1]) >= len(largest[1][1])
+        smallest = result.smallest_clusters(1)
+        assert len(smallest) == 1
+
+    def test_partition_equals(self):
+        first = kmeans_clustering(BLOB_POINTS, num_clusters=3, seed=1)
+        second = kmeans_clustering(BLOB_POINTS, num_clusters=3, seed=2)
+        assert first.partition_equals(second)
+        other = ClusteringResult(labels=[0] * 6 + [1] * 6)
+        assert not first.partition_equals(other)
+
+    def test_duplicate_points_do_not_crash(self):
+        embeddings = [[1.0, 0.0]] * 5 + [[0.0, 1.0]] * 5
+        result = kmeans_clustering(embeddings, num_clusters=2, seed=3)
+        assert as_partition(result) == {frozenset(range(5)), frozenset(range(5, 10))}
+
+
+class TestAgglomerativeClustering:
+    def test_requires_exactly_one_stopping_criterion(self):
+        with pytest.raises(ValueError):
+            agglomerative_clustering(BLOB_POINTS)
+        with pytest.raises(ValueError):
