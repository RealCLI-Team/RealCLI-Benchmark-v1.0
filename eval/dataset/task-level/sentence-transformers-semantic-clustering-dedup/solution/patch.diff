+class TestMetricEdgeCases:
+    def test_v_measure_beta_zero_is_completeness(self):
+        labels_true = [0, 0, 1, 1]
+        labels_pred = [0, 1, 0, 1]
+        assert v_measure_score(labels_true, labels_pred, beta=0.0) == pytest.approx(
+            completeness_score(labels_true, labels_pred)
+        )
+
+    def test_negative_beta_raises(self):
+        with pytest.raises(ValueError):
+            v_measure_score([0, 1], [0, 1], beta=-1.0)
+
+    def test_ari_can_be_negative(self):
+        labels_true = [0, 0, 0, 0, 1, 1, 1, 1]
+        labels_pred = [0, 1, 2, 3, 0, 1, 2, 3]
+        assert adjusted_rand_score(labels_true, labels_pred) < 0.0
+
+    def test_nmi_partial_agreement(self):
+        labels_true = [0, 0, 1, 1]
+        labels_pred = [0, 0, 0, 1]
+        value = normalized_mutual_info_score(labels_true, labels_pred)
+        assert 0.0 < value < 1.0
+
+    def test_accuracy_with_more_clusters_than_classes(self):
+        labels_true = [0, 0, 0, 1, 1, 1]
+        labels_pred = [0, 1, 2, 3, 4, 5]
+        # Each gold class can only be matched to a single cluster, so with all-singleton
+        # clusters only 2 of the 6 samples are covered by the optimal assignment
+        assert cluster_accuracy_score(labels_true, labels_pred) == pytest.approx(2 / 6)
+
+    def test_string_and_mixed_label_types(self):
+        labels_true = ["cat", "cat", "dog", "dog"]
+        labels_pred = [1, 1, 0, 0]
+        assert v_measure_score(labels_true, labels_pred) == pytest.approx(1.0)
+        assert cluster_accuracy_score(labels_true, labels_pred) == pytest.approx(1.0)
