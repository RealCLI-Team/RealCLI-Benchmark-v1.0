+        assert result.keep_indices == list(range(10))
+        assert result.num_duplicates == 10
+        assert result.apply(list(range(20))) == list(range(10))
+
+    def test_apply_on_numpy_array(self):
+        items = np.array(["a", "b", "c"])
+        embeddings = [[1.0, 0.0], [1.0, 0.0], [0.0, 1.0]]
+        result = semantic_deduplication(embeddings, threshold=0.99)
+        kept = result.apply(items)
+        assert list(kept) == ["a", "c"]
